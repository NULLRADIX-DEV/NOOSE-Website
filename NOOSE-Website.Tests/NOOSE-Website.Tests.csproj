<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>NOOSE_Website.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Coverage uses the built-in Microsoft Code Coverage engine; coverlet is not referenced
         because its Mono.Cecil cannot instrument .NET 10 assemblies. See README.md. -->
    <!-- EF Core 9 line to match Pomelo 9 / EF 9 in the web project -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.20" />
    <!-- EF Core Sqlite 9 brings SQLitePCLRaw 2.1.x, whose bundled SQLite has a high advisory (GHSA-2m69-gcr7-jv3q) -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NOOSE-Website\NOOSE-Website.csproj" />
  </ItemGroup>

</Project>
