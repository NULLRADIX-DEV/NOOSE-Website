<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["NOOSE-Website.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <HeadOutlet @rendermode="@PageRenderMode" />
</head>

<body>
    <Routes @rendermode="@PageRenderMode" />
    <ReconnectModal />
    @* host-level so print/portal layouts surface circuit failures too *@
    <div id="blazor-error-ui" data-nosnippet>
        Ein unerwarteter Fehler ist aufgetreten.
        @* not href=".": with <base href="/"> that resolves to the landing page instead of reloading *@
        <a href="#" onclick="location.reload();return false;" class="reload">Neu laden</a>
        <span class="dismiss">🗙</span>
    </div>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script>
        // Update the address bar without a Blazor navigation (no LocationChanged → no re-render).
        window.nooseReplaceState = function (url) { history.replaceState(history.state, '', url); };

        // Drop every unsaved editor draft on sign-out. They hold the full text in the clear, classified
        // documents included, and the housekeeping sweep inside richtext.js only runs when an editor is
        // opened - so on a shared station nothing would ever remove them. Inline rather than in a module:
        // the logout form is a plain post on a statically rendered page.
        window.nooseEntwuerfeLoeschen = function () {
            // this page only: its flush on the way out must not write into the database being deleted
            window.nooseEntwuerfeGesperrt = true;
            try { indexedDB.deleteDatabase('noose-rte'); } catch (e) { /* ignore */ }
            return true;
        };
    </script>
</body>

</html>

@code {
    // every page runs Interactive Server unless [ExcludeFromInteractiveRouting] marks it static
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
