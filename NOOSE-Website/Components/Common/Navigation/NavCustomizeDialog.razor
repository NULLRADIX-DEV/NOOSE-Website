@* Per-account navigation customizer: hide/show, drag-reorder, favorites, saved views, start page. *@
@using NOOSE_Website.Navigation
@using NOOSE_Website.Models.Navigation
@inject INavPreferencesService NavPrefs
@inject IPartnerVisibilityPolicyService PartnerPolicy
@inject IPartnerAgencyProfileService PartnerProfiles
@inject IAuthorizationService Authorization
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (_load)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="mt-1">
                <MudTabPanel Text="Menü" Icon="@Icons.Material.Filled.Reorder">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                        Blende nicht genutzte Einträge mit dem Auge aus, ziehe Einträge in deine Wunsch-Reihenfolge
                        und markiere häufig genutzte mit dem Stern als Favorit.
                    </MudText>
                    @* zones mirror the drawer's areas, so a drag lands where the entry actually shows up *@
                    <MudDropContainer T="NavEntry" @ref="_menuContainer" Items="_menuItems"
                                      ItemsSelector="@((item, zone) => item.Area.ToString() == zone)"
                                      CanDrop="@((item, zone) => item.Area.ToString() == zone)"
                                      ItemDropped="OnMenuDropAsync">
                        <ChildContent>
                            @foreach (var area in _zones)
                            {
                                @MenuZone(area)
                            }
                        </ChildContent>
                        <ItemRenderer>
                            <MudPaper Class="d-flex align-center pa-2 mb-1" Elevation="1" Style="@(IsHidden(context) ? "opacity:.45;" : null)">
                                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Class="mr-2 mud-text-secondary" Size="Size.Small" />
                                <MudIcon Icon="@context.Icon" Class="mr-2" Size="Size.Small" />
                                <div class="d-flex flex-column">
                                    <MudText Typo="Typo.body2">@context.Label</MudText>
                                    @if (!string.IsNullOrWhiteSpace(context.Description))
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.Description</MudText>
                                    }
                                </div>
                                <MudSpacer />
                                <MudIconButton Icon="@(IsFavorite(context) ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder)"
                                               Color="@(IsFavorite(context) ? Color.Warning : Color.Default)" Size="Size.Small"
                                               OnClick="@(() => ToggleFavoriteAsync(context))" aria-label="Als Favorit markieren" />
                                <MudIconButton Icon="@(IsHidden(context) ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                               Size="Size.Small" OnClick="@(() => ToggleHiddenAsync(context))" aria-label="Ein- oder ausblenden" />
                            </MudPaper>
                        </ItemRenderer>
                    </MudDropContainer>
                </MudTabPanel>

                <MudTabPanel Text="Favoriten" Icon="@Icons.Material.Filled.Star">
                    @if (_favItems.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            Noch keine Favoriten. Markiere Einträge im Tab „Menü" mit dem Stern oder hefte eine Akte direkt an.
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">Ziehe Favoriten in die gewünschte Reihenfolge.</MudText>
                        <MudDropContainer T="NavFavorite" @ref="_favContainer" Items="_favItems"
                                          ItemsSelector="@((item, zone) => true)" ItemDropped="OnFavoriteDropAsync">
                            <ChildContent>
                                <MudDropZone T="NavFavorite" Identifier="favorites" AllowReorder="true" Class="pa-1" />
                            </ChildContent>
                            <ItemRenderer>
                                <MudPaper Class="d-flex align-center pa-2 mb-1" Elevation="1">
                                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Class="mr-2 mud-text-secondary" Size="Size.Small" />
                                    <MudIcon Icon="@context.Icon" Class="mr-2" Size="Size.Small" />
                                    <MudText Typo="Typo.body2">@context.Label</MudText>
                                    <MudSpacer />
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                   OnClick="@(() => RemoveFavoriteAsync(context))" aria-label="Favorit entfernen" />
                                </MudPaper>
                            </ItemRenderer>
                        </MudDropContainer>
                    }
                </MudTabPanel>

                @* the demo visitors share one account; they get no views, so the tab would only explain a missing button *@
                @if (!_user.IsDemo())
                {
                    <MudTabPanel Text="Ansichten" Icon="@Icons.Material.Filled.BookmarkBorder">
                        @if (_prefs.SavedViews.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                Noch keine Ansichten. Stell auf einer Liste Filter ein und wähle oben rechts
                                <i>Ansichten</i> → <i>Diese Ansicht merken</i>.
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                                Gemerkte Listen mit ihren Filtern. Sie stehen im Menü unter den Favoriten und im Schnellzugriff.
                            </MudText>
                            @foreach (var view in _prefs.SavedViews)
                            {
                                <MudPaper Class="d-flex align-center pa-2 mb-1" Elevation="1">
                                    <MudIcon Icon="@view.Icon" Class="mr-2" Size="Size.Small" />
                                    <MudText Typo="Typo.body2">@view.Label</MudText>
                                    @if (NavCatalog.ByRoute(view.Route) is { } list)
                                    {
                                        <MudText Typo="Typo.caption" Class="ml-2 mud-text-secondary">@list.Label</MudText>
                                    }
                                    <MudSpacer />
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                   OnClick="@(() => RemoveViewAsync(view))" aria-label="Ansicht entfernen" />
                                </MudPaper>
                            }
                        }
                    </MudTabPanel>
                }

                <MudTabPanel Text="Startseite" Icon="@Icons.Material.Filled.Home">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">Welche Seite soll nach dem Login zuerst geöffnet werden?</MudText>
                    <MudSelect T="string" Value="@(_prefs.StartRoute ?? "/dashboard")" ValueChanged="OnStartRouteChangedAsync"
                               Label="Startseite" Dense="true" Variant="Variant.Outlined" Style="max-width:360px;">
                        <MudSelectItem T="string" Value="@("/dashboard")">Dashboard (Standard)</MudSelectItem>
                        @foreach (var e in _startOptions)
                        {
                            <MudSelectItem T="string" Value="@e.Route">@e.Label</MudSelectItem>
                        }
                    </MudSelect>
                </MudTabPanel>

                <MudTabPanel Text="Lesen" Icon="@Icons.Material.Filled.MenuBook">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                        Fachwörter aus dem Glossar bekommen in Texten eine gepunktete Linie. Fährst du mit der Maus
                        darüber, erscheint die Erklärung in einem Satz. Jeder Begriff nur beim ersten Vorkommen.
                    </MudText>
                    <MudSwitch T="bool" Value="_prefs.GlossarBlasen" ValueChanged="OnGlossarBlasenChangedAsync"
                               Color="Color.Primary" Label="Fachwörter erklären" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                        Wirkt auf Seiten, die du danach öffnest.
                    </MudText>
                </MudTabPanel>
            </MudTabs>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Schließen</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;
    private bool _isPartner;
    private string _agentId = string.Empty;
    private ClaimsPrincipal _user = default!;
    private NavPreferences _prefs = new();
    private IReadOnlySet<string>? _allowedPartnerTypes;
    private PartnerFeature _partnerFeatures;
    private readonly Dictionary<string, bool> _policyOk = new(StringComparer.Ordinal);
    private List<NavArea> _zones = new();
    private List<NavEntry> _menuItems = new();
    private List<NavFavorite> _favItems = new();
    private List<NavEntry> _startOptions = new();
    private MudDropContainer<NavEntry>? _menuContainer;
    private MudDropContainer<NavFavorite>? _favContainer;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _user = (await AuthStateTask).User;
            _agentId = _user.GetAgentId() ?? string.Empty;
            _isPartner = _user.IsPartner();
            if (_isPartner)
            {
                _allowedPartnerTypes = await PartnerPolicy.GetAllowedTypesAsync(_user);
                _partnerFeatures = await PartnerProfiles.GetFeaturesAsync(_user);
            }
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            // surface instead of killing the circuit
            Snackbar.Add($"Navigation konnte nicht geladen werden: {ex.Message}", Severity.Error);
        }
        finally
        {
            _load = false;
        }
    }

    private async Task ReloadAsync()
    {
        _prefs = await NavPrefs.GetAsync(_agentId);

        if (_isPartner)
        {
            _menuItems = NavPersonalization.Ordered(NavCatalog.PartnerRecordEntries(_allowedPartnerTypes, _partnerFeatures), _prefs).ToList();
            _zones = [NavArea.Partner];
            _startOptions = NavCatalog.PartnerRecordEntries(_allowedPartnerTypes, _partnerFeatures).ToList();
        }
        else
        {
            // same per-policy snapshot the drawer takes, so the customizer never offers a hidden entry
            foreach (var policy in NavAreaCatalog.DistinctPolicies)
            {
                _policyOk[policy] = (await Authorization.AuthorizeAsync(_user, policy)).Succeeded;
            }
            _zones = new List<NavArea> { NavArea.Primary }
                .Concat(NavAreaCatalog.Areas)
                .Where(a => Permitted(a).Any())
                .ToList();
            _menuItems = _zones.SelectMany(a => NavPersonalization.Ordered(Permitted(a), _prefs)).ToList();
            _startOptions = _zones.SelectMany(Permitted).ToList();
        }

        _favItems = _prefs.Favorites.ToList();
        _menuContainer?.Refresh();
        _favContainer?.Refresh();
    }

    private IEnumerable<NavEntry> Permitted(NavArea area)
        => NavAreaCatalog.Entries(area).Where(e => _policyOk.GetValueOrDefault(NavSectionPolicy.For(e.Section)));

    private RenderFragment MenuZone(NavArea area) =>@<div class="mb-2">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@NavAreaCatalog.Name(area)</MudText>
        <MudDropZone T="NavEntry" Identifier="@area.ToString()" AllowReorder="true" Class="pa-1" />
    </div>;

    private bool IsFavorite(NavEntry e) => _prefs.Favorites.Any(f => f.Kind == "page" && f.Key == e.Key);
    private bool IsHidden(NavEntry e) => _prefs.HiddenKeys.Contains(e.Key);

    private Task ToggleFavoriteAsync(NavEntry e)
        => RunAsync(() => NavPrefs.ToggleFavoriteAsync(_agentId,
            new NavFavorite("page", e.Key, null, null, e.Label, e.Route, e.Icon)));

    private Task ToggleHiddenAsync(NavEntry e)
        => RunAsync(() => NavPrefs.SetHiddenAsync(_agentId, e.Key, !IsHidden(e)));

    private Task RemoveFavoriteAsync(NavFavorite f)
        => RunAsync(() => NavPrefs.ToggleFavoriteAsync(_agentId, f));

    // the one place a view can still be removed once its list is out of reach
    private Task RemoveViewAsync(SavedView view)
        => RunAsync(() => NavPrefs.RemoveViewAsync(_agentId, view.Id));

    private Task OnGlossarBlasenChangedAsync(bool enabled)
        => RunAsync(() => NavPrefs.SetGlossarBlasenAsync(_agentId, enabled));

    private Task OnStartRouteChangedAsync(string route)
        => RunAsync(() => NavPrefs.SetStartRouteAsync(_agentId, route == "/dashboard" ? null : route));

    private async Task OnMenuDropAsync(MudItemDropInfo<NavEntry> info)
    {
        if (info.Item is not { } item)
        {
            return;
        }
        var areaItems = _menuItems.Where(e => e.Area == item.Area).ToList();
        areaItems.Remove(item);
        areaItems.Insert(Math.Clamp(info.IndexInZone, 0, areaItems.Count), item);

        var ordered = new List<string>();
        foreach (var area in _zones)
        {
            var items = area == item.Area ? areaItems : _menuItems.Where(e => e.Area == area).ToList();
            ordered.AddRange(items.Select(e => e.Key));
        }
        await RunAsync(() => NavPrefs.SetOrderAsync(_agentId, ordered));
    }

    private async Task OnFavoriteDropAsync(MudItemDropInfo<NavFavorite> info)
    {
        if (info.Item is not { } item)
        {
            return;
        }
        var ordered = _favItems.ToList();
        ordered.Remove(item);
        ordered.Insert(Math.Clamp(info.IndexInZone, 0, ordered.Count), item);
        await RunAsync(() => NavPrefs.ReorderFavoritesAsync(_agentId, ordered.Select(INavPreferencesService.FavoriteId).ToList()));
    }

    // run a persist op, reload, surface errors
    private async Task RunAsync(Func<Task> op)
    {
        try
        {
            await op();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void Close() => MudDialog.Close();

    public static Task ShowAsync(IDialogService dialog)
        => dialog.ShowAsync<NavCustomizeDialog>("Navigation anpassen",
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
}
