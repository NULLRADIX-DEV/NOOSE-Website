@* Quick capture from the top bar: a new record, a note on an existing one, or a deployment. *@
@using NOOSE_Website.Services.Search
@inject IPersonService PersonService
@inject IFactionService FactionService
@inject IPersonGroupService GroupService
@inject IPartyService PartyService
@inject IOperationService OperationService
@inject ICaseService CaseService
@inject ITaskforceService TaskforceService
@inject IJobService JobService
@inject ICommentService CommentService
@inject IProfileSuggestionService SuggestionService
@inject ILinkService LinkService
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudDialog>
    <DialogContent>
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-4" Class="noose-reiter-handy"
                 ActivePanelIndex="_tab" ActivePanelIndexChanged="TabChangedAsync">

            <MudTabPanel Text="Neue Akte" Icon="@Icons.Material.Filled.NoteAdd">
                <MudStack Spacing="3">
                    <MudSelect T="string" Label="Aktentyp" @bind-Value="_type" Variant="Variant.Outlined" Dense="true">
                        @foreach (var option in _types)
                        {
                            <MudSelectItem T="string" Value="@option.Value">@option.Display</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField @bind-Value="_designation" Label="@DesignationLabel" Variant="Variant.Outlined"
                                  Immediate="true" AutoFocus="true" OnKeyDown="KeyPressed"
                                  HelperText="Es wird nur das Pflichtfeld erfasst – alle Details lassen sich danach in der Akte ergänzen." />
                </MudStack>
            </MudTabPanel>

            <MudTabPanel Text="Vermerk" Icon="@Icons.Material.Filled.Comment">
                <MudStack Spacing="3">
                    <QuickRecordPicker Allowed="QuickCapture.CommentTargets" @bind-Value="_noteTarget"
                                       Label="Akte" Placeholder="Akte suchen …" Disabled="@NoteTargetLocked"
                                       HelperText="@NoteTargetHelper" />
                    @* one draft per record: a pasted picture belongs to its record, and so does an unsaved note *@
                    <MentionInput @ref="_noteInput" @bind-Text="_noteText" Lines="4" Placeholder="@NotePlaceholder"
                                  Disabled="@(_noteTarget is null)" OnSubmit="NoteAsync"
                                  ImageOwnerType="@(_noteTarget?.Category)" ImageOwnerId="@(_noteTarget?.TargetId)"
                                  DraftKey="@NoteDraftKey" />
                </MudStack>
            </MudTabPanel>

            <MudTabPanel Text="Einsatz" Icon="@Icons.Material.Filled.Radar">
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="_activityTitle" Label="Titel" Variant="Variant.Outlined"
                                  Immediate="true" MaxLength="200" Placeholder="z. B. Bankraub – Bloc13" />
                    @* type, date and time side by side; below 600px each takes its own line *@
                    <MudStack Row="true" Spacing="2" Class="noose-eintrag">
                        <MudAutocomplete T="string" @bind-Value="_activityKind" Label="Typ" Variant="Variant.Outlined"
                                         SearchFunc="SearchKinds" CoerceValue="true" Clearable="true"
                                         MinCharacters="0" Immediate="true" Class="flex-grow-1 noose-breite-frei" />
                        <MudDatePicker @bind-Date="_activityDate" Label="Datum" Variant="Variant.Outlined" Class="noose-breite-frei" />
                        <MudTimePicker @bind-Time="_activityTime" Label="Uhrzeit" Variant="Variant.Outlined" AmPm="false" Class="noose-breite-frei" />
                    </MudStack>
                    <QuickRecordPicker Allowed="QuickCapture.ActivityTargets" @bind-Value="_activityOrg"
                                       Label="Fraktion oder Gruppe (optional)" Placeholder="Suchen …"
                                       HelperText="Verknüpft den Einsatz als Beteiligte; bei einer Fraktion zählt er für Score und Aktualität." />
                    <MudSwitch T="bool" @bind-Value="_running" Color="Color.Primary" Label="@RunningLabel" />
                    <MentionInput @ref="_activityInput" @bind-Text="_activityText" Lines="3" Placeholder="@ActivityPlaceholder"
                                  DraftKey="schnellerfassung:einsatz" />
                    <MudLink Typo="Typo.caption" OnClick="LongFormAsync">
                        Ausführlich erfassen – mit Beteiligten, Legitimation und Beweismitteln
                    </MudLink>
                </MudStack>
            </MudTabPanel>

        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync"
                   Disabled="@(_busy || !CanSubmit)">
            @SubmitLabel
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private record TypeOption(string Value, string Display);
    private static readonly TypeOption[] _types =
    {
        new(nameof(Person), "Person"),
        new(nameof(Faction), "Fraktion"),
        new(nameof(PersonGroup), "Personengruppe"),
        new(nameof(Party), "Partei"),
        new(nameof(Operation), "Operation"),
        new(nameof(Case), "Vorgang"),
        new(nameof(Taskforce), "Taskforce"),
        new(nameof(Job), "Aufgabe"),
    };

    private const int NoteTab = 1;
    private const int ActivityTab = 2;

    private const string NotePlaceholder = "Was ist festzuhalten? (Verlinken per @, Strg+Enter speichert)";
    private const string ActivityPlaceholder = "Sachverhalt in ein paar Sätzen (optional, Verlinken per @)";

    private int _tab;
    private bool _busy;

    private string _type = nameof(Person);
    private string _designation = string.Empty;

    private QuickHit? _noteTarget;
    private string _noteText = string.Empty;

    private string? NoteDraftKey => _noteTarget is { } t ? $"schnellerfassung:vermerk:{t.Category}:{t.TargetId}" : null;

    private string _activityTitle = string.Empty;
    private string? _activityKind;
    private DateTime? _activityDate;
    private TimeSpan? _activityTime;
    private string _activityText = string.Empty;
    private MentionInput? _noteInput;
    private MentionInput? _activityInput;
    private QuickHit? _activityOrg;
    private List<string> _kinds = new();
    private bool _kindsLoaded;
    private bool _running;

    private string RunningLabel => _running
        ? "Läuft noch – danach das Einsatztagebuch öffnen"
        : "Ist vorbei – als abgeschlossen festhalten";

    private string DesignationLabel => _type is nameof(Operation) or nameof(Case) or nameof(Job) ? "Titel" : "Name";

    /// <summary>A pasted picture already hangs on the picked record, so the target must stay put.</summary>
    private bool NoteTargetLocked => QuickCapture.HoldsImage(_noteText);

    private string NoteTargetHelper => NoteTargetLocked
        ? "Das eingefügte Bild hängt an dieser Akte – die Auswahl lässt sich jetzt nicht mehr wechseln."
        : "Erst die Akte wählen, dann schreiben.";

    private bool CanSubmit => _tab switch
    {
        NoteTab => _noteTarget is not null && !string.IsNullOrWhiteSpace(_noteText),
        ActivityTab => !string.IsNullOrWhiteSpace(_activityTitle) && _activityDate is not null,
        _ => !string.IsNullOrWhiteSpace(_designation),
    };

    private string SubmitLabel => _tab switch
    {
        NoteTab => _busy ? "Wird gespeichert…" : "Vermerk speichern",
        ActivityTab => _busy ? "Wird gespeichert…" : _running ? "Einsatz starten" : "Einsatz festhalten",
        _ => _busy ? "Wird angelegt…" : "Anlegen",
    };

    protected override void OnInitialized()
    {
        // the usual case is "what I just did", so the clock starts on now
        var now = DateTime.Now;
        _activityDate = now.Date;
        _activityTime = now.TimeOfDay;
    }

    private async Task TabChangedAsync(int index)
    {
        _tab = index;
        // the types cost a query, so the two other tabs never pay for them
        if (index == ActivityTab && !_kindsLoaded)
        {
            _kindsLoaded = true;
            try
            {
                var types = await SuggestionService.GetAsync(SuggestionType.OperationType);
                var kinds = await SuggestionService.GetActivityKindsAsync();
                _kinds = OperationTypeSuggestions.Merge(types, kinds.Select(k => k.Value));
            }
            catch (Exception)
            {
                /* best effort: the field stays free text */
            }
        }
    }

    private Task<IEnumerable<string>> SearchKinds(string value, CancellationToken token)
    {
        var v = value?.Trim() ?? string.Empty;
        IEnumerable<string> hit = string.IsNullOrWhiteSpace(v)
            ? _kinds
            : _kinds.Where(a => a.Contains(v, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(hit);
    }

    private void Cancel() => MudDialog.Cancel();

    private Task KeyPressed(KeyboardEventArgs e)
        => e.Key == "Enter" && !_busy && CanSubmit ? SubmitAsync() : Task.CompletedTask;

    private Task SubmitAsync() => _tab switch
    {
        NoteTab => NoteAsync(),
        ActivityTab => ActivityAsync(),
        _ => CreateAsync(),
    };

    private async Task NoteAsync()
    {
        if (_busy || _noteTarget is not { } target || string.IsNullOrWhiteSpace(_noteText))
        {
            return;
        }

        _busy = true;
        var user = (await AuthStateTask).User;
        try
        {
            await CommentService.CreateAsync(target.Category, target.TargetId, _noteText, user);
            if (_noteInput is not null)
            {
                await _noteInput.MarkSavedAsync();
            }
            // The text stays in the field when another record is picked, so a record it was written under first
            // still holds it as a draft - and would later offer a note that is already posted here.
            foreach (var key in (_noteInput?.DraftKeysWritten ?? []).Where(k => k != NoteDraftKey).ToList())
            {
                await TextDraft.DiscardAsync(JS, user.GetAgentId(), key);
            }
            // deliberately no navigation: keeping the page the agent was on is the whole point
            Snackbar.Add($"Vermerk an „{target.Name}“ gespeichert.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ActivityAsync()
    {
        var title = _activityTitle.Trim();
        if (_busy || string.IsNullOrWhiteSpace(title) || _activityDate is null)
        {
            return;
        }

        _busy = true;
        var user = (await AuthStateTask).User;
        try
        {
            var input = new OperationInput
            {
                Title = title,
                Type = string.IsNullOrWhiteSpace(_activityKind) ? null : _activityKind.Trim(),
                Status = _running ? OperationStatus.Running : OperationStatus.Completed,
                // combine date+time as local; the service converts to UTC
                Start = _activityDate.Value.Date + (_activityTime ?? TimeSpan.Zero),
                Expiry = string.IsNullOrWhiteSpace(_activityText) ? null : _activityText,
            };
            var operation = await OperationService.CreateAsync(input, user);
            if (_activityOrg is { } org)
            {
                try
                {
                    await LinkService.CreateAsync(nameof(Operation), operation.Id, org.Category, org.TargetId, null, user,
                        allowedTargetTypes: NOOSE_Website.Services.LinkService.InvolvedTypes);
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Verknüpfung mit „{org.Name}“ nicht gespeichert: {ex.Message}", Severity.Warning);
                }
            }
            if (_activityInput is not null)
            {
                await _activityInput.MarkSavedAsync();
            }
            MudDialog.Close(DialogResult.Ok(true));
            if (_running)
            {
                Snackbar.Add($"Einsatz {operation.CaseNumber} läuft – führe jetzt das Einsatztagebuch.", Severity.Success);
                Nav.NavigateTo($"/operationen/{operation.Id}?tab=einsatztagebuch");
            }
            else
            {
                Snackbar.Add($"Einsatz {operation.CaseNumber} festgehalten.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Hands over to the full editor, carrying the organisation the agent already picked.</summary>
    private async Task LongFormAsync()
    {
        // the full editor takes the organisation and nothing else, so ask before the typed text is gone
        if (!string.IsNullOrWhiteSpace(_activityTitle) || !string.IsNullOrWhiteSpace(_activityText)
            || !string.IsNullOrWhiteSpace(_activityKind))
        {
            var ok = await ConfirmDialog.ShowAsync(DialogService, "Ausführlich erfassen?",
                "Titel, Typ und Text nimmt das ausführliche Formular nicht mit – nur die gewählte Organisation.",
                "Zum Formular", Color.Warning);
            if (!ok)
            {
                return;
            }
        }

        var target = _activityOrg switch
        {
            { Category: nameof(Faction) } f => $"/operationen/neu?fraktion={f.TargetId}",
            { Category: nameof(PersonGroup) } g => $"/operationen/neu?personengruppe={g.TargetId}",
            _ => "/operationen/neu",
        };
        MudDialog.Close(DialogResult.Ok(true));
        Nav.NavigateTo(target);
    }

    private async Task CreateAsync()
    {
        var designation = _designation.Trim();
        if (string.IsNullOrWhiteSpace(designation))
        {
            return;
        }

        _busy = true;
        var user = (await AuthStateTask).User;
        try
        {
            string target;
            switch (_type)
            {
                case nameof(Faction):
                    var faction = await FactionService.CreateAsync(new FactionInput { Name = designation }, user);
                    target = $"/fraktionen/{faction.Id}";
                    break;
                case nameof(PersonGroup):
                    var group = await GroupService.CreateAsync(new PersonGroupInput { Name = designation }, user);
                    target = $"/personengruppen/{group.Id}";
                    break;
                case nameof(Party):
                    var party = await PartyService.CreateAsync(new PartyInput { Name = designation }, user);
                    target = $"/parteien/{party.Id}";
                    break;
                case nameof(Operation):
                    var operation = await OperationService.CreateAsync(new OperationInput { Title = designation }, user);
                    target = $"/operationen/{operation.Id}";
                    break;
                case nameof(Case):
                    var @case = await CaseService.CreateAsync(new CaseInput { Title = designation }, user);
                    target = $"/vorgaenge/{@case.Id}";
                    break;
                case nameof(Taskforce):
                    var taskforce = await TaskforceService.CreateAsync(new TaskforceInput { Name = designation }, user);
                    target = $"/taskforces/{taskforce.Id}";
                    break;
                case nameof(Job):
                    var job = await JobService.CreateAsync(new JobInput { Title = designation }, Array.Empty<string>(), user);
                    target = $"/aufgaben/{job.Id}";
                    break;
                default:
                    var person = await PersonService.CreateAsync(new PersonInput { Name = designation }, user);
                    target = $"/personen/{person.Id}";
                    break;
            }

            Snackbar.Add("Akte angelegt – Details können jetzt ergänzt werden.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
            Nav.NavigateTo(target);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Opens the quick-capture dialog.</summary>
    public static Task ShowAsync(IDialogService dialog)
        => dialog.ShowAsync<QuickAddDialog>("Schnellerfassung",
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
}
