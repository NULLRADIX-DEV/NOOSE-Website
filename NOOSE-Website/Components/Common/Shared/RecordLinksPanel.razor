@* Links from any record to any other record via the generic linking engine. *@
@inject ILinkService LinkService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.subtitle1">Verknüpfte Akten (@_list.Count)</MudText>
        @if (_mayWrite)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddLink" OnClick="AddAsync">
                Akte verknüpfen
            </MudButton>
        }
    </MudStack>

    @if (_load)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_list.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Noch nichts verknüpft. Verknüpfe Personen, Fraktionen, Vorgänge, Dokumente, Taskforces – alles Interne.
        </MudText>
    }
    else
    {
        @foreach (var group in _grouped)
        {
            <div>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                    <MudIcon Icon="@TypeIcon(group.Key)" Color="Color.Primary" Size="Size.Small" />
                    <MudText Typo="Typo.subtitle2">@TypeDisplay(group.Key) (@group.Count())</MudText>
                </MudStack>
                @foreach (var v in group)
                {
                    <MudPaper Class="pa-3 mb-2" Elevation="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                                @if (v.Href is not null)
                                {
                                    <MudLink Href="@v.Href" Typo="Typo.body2"><b>@v.OtherDesignation</b></MudLink>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2"><b>@v.OtherDesignation</b></MudText>
                                }
                                @if (!string.IsNullOrWhiteSpace(v.Label))
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">@v.Label</MudChip>
                                }
                            </MudStack>
                            @if (_mayWrite)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                               OnClick="@(() => RemoveAsync(v))" aria-label="Verknüpfung entfernen" />
                            }
                        </MudStack>
                    </MudPaper>
                }
            </div>
        }
    }
</MudStack>

@code {
    [Parameter, EditorRequired] public string EntityType { get; set; } = default!;
    [Parameter, EditorRequired] public string EntityId { get; set; } = default!;
    [Parameter, EditorRequired] public ClaimsPrincipal User { get; set; } = default!;

    private bool _load = true;
    private bool _mayWrite;
    private List<LinkDisplay> _list = new();

    private static readonly string[] _order =
    {
        nameof(Person), nameof(PersonDoc), nameof(Observation), nameof(Operation), nameof(Case),
        nameof(Taskforce), nameof(Faction), nameof(PersonGroup), nameof(Party),
        nameof(Document), nameof(Law), nameof(Agent), nameof(Job), nameof(Bewerbung),
        nameof(Meeting), nameof(MeetingAgendaItem), nameof(Hinweis), nameof(Ticket), nameof(Presentation),
    };

    private IEnumerable<IGrouping<string, LinkDisplay>> _grouped =>
        _list.GroupBy(v => v.OtherType)
              .OrderBy(g => Array.IndexOf(_order, g.Key) is var i && i >= 0 ? i : int.MaxValue)
              .ThenBy(g => g.Key);

    protected override async Task OnInitializedAsync()
    {
        _mayWrite = User.MayWrite();
        await LoadAsync();
    }

    /// <summary>Reloads the list from outside.</summary>
    /// <remarks>
    /// For a page that creates links through its own buttons rather than through this panel — the tip file does,
    /// with its takeover actions. Without it the new link only appears on the next page load.
    /// </remarks>
    public async Task RefreshAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _load = true;
        var all = await LinkService.GetForRecordAsync(EntityType, EntityId, ViewerScope.From(User), LinkKind.Default);
        _list = all.Where(v => !v.Automatic).ToList();
        _load = false;
    }

    private async Task AddAsync()
    {
        // neither the record itself nor what is already linked
        var choice = await LinkDialog.ShowAsync(DialogService, User.IsLeadership(),
            excluded: LinkDialog.Exclusions(_list, EntityType, EntityId));
        if (choice is null)
        {
            return;
        }
        try
        {
            await LinkService.CreateAsync(EntityType, EntityId, choice.TargetType, choice.TargetId, choice.Label, User, LinkKind.Default);
            Snackbar.Add("Akte verknüpft.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RemoveAsync(LinkDisplay v)
    {
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Verknüpfung entfernen?",
            $"„{v.OtherDesignation}“ wird entfernt.", "Entfernen");
        if (!ok)
        {
            return;
        }
        await LinkService.RemoveAsync(v.LinkId, User);
        Snackbar.Add("Verknüpfung entfernt.", Severity.Success);
        await LoadAsync();
    }

    private static string TypeDisplay(string type) => RecordTypeDisplay.Plural(type);

    private static string TypeIcon(string type) => RecordTypeDisplay.Icon(type);
}
