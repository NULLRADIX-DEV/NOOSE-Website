@* Unified record timeline: audit plus domain events, newest first, with category filter. Read-only. *@
@using NOOSE_Website.Models.Timeline
@inject ITimelineService TimelineService

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_all.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">Kein Verlauf vorhanden.</MudText>
}
else
{
    <MudStack Spacing="3">
        <MudStack Row="true" Spacing="1" Class="flex-wrap" AlignItems="AlignItems.Center">
            @if (_newCount > 0)
            {
                <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.FiberNew"
                         Variant="@(_onlyNew ? Variant.Filled : Variant.Outlined)"
                         Color="Color.Warning" OnClick="@(() => _onlyNew = !_onlyNew)">
                    Neu (@_newCount)
                </MudChip>
            }
            @foreach (var k in _exists)
            {
                <MudChip T="string" Size="Size.Small"
                         Variant="@(_active.Contains(k) ? Variant.Filled : Variant.Outlined)"
                         Color="@Colour(k)" OnClick="@(() => Toggle(k))">
                    @Name(k) (@_counter[k])
                </MudChip>
            }
        </MudStack>

        @{
            var filtered = Filtered().ToList();
        }
        @if (filtered.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Keine Ereignisse für die gewählten Kategorien.</MudText>
        }
        else
        {
            <MudTimeline TimelinePosition="TimelinePosition.Start">
                @foreach (var e in filtered)
                {
                    <MudTimelineItem Color="@Colour(e.Category)" Size="Size.Small">
                        <MudStack Spacing="1">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="noose-eintrag">
                                <MudIcon Icon="@Symbol(e.Category)" Size="Size.Small" Color="@Colour(e.Category)" />
                                @if (!string.IsNullOrEmpty(e.Href))
                                {
                                    <MudLink Href="@e.Href" Typo="Typo.body1"><b>@e.Title</b></MudLink>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body1"><b>@e.Title</b></MudText>
                                }
                                @if (IsNew(e))
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                             Class="ma-0">Neu</MudChip>
                                }
                            </MudStack>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @e.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @(e.ActorName ?? "System")
                            </MudText>
                            @if (!string.IsNullOrWhiteSpace(e.Detail))
                            {
                                <MudText Typo="Typo.body2" Style="white-space:pre-wrap;">@e.Detail</MudText>
                            }
                            @if (e.Changes is { Count: > 0 } changes)
                            {
                                <MudStack Spacing="0" Class="mt-1">
                                    @foreach (var a in changes)
                                    {
                                        <MudText Typo="Typo.caption">
                                            <b>@a.Field:</b> <span class="mud-text-secondary">@a.Alt → @a.New</span>
                                        </MudText>
                                    }
                                </MudStack>
                            }
                        </MudStack>
                    </MudTimelineItem>
                }
            </MudTimeline>
        }
    </MudStack>
}

@code {
    [Parameter, EditorRequired] public string EntityType { get; set; } = default!;
    [Parameter, EditorRequired] public string EntityId { get; set; } = default!;
    [Parameter, EditorRequired] public ClaimsPrincipal User { get; set; } = default!;

    /// <summary>Last view of the viewer's previous visit; entries entered after it by others read "Neu".</summary>
    [Parameter] public DateTime? NewSince { get; set; }

    private bool _load = true;
    private IReadOnlyList<TimelineEntry> _all = Array.Empty<TimelineEntry>();
    private List<TimelineCategory> _exists = new();
    private readonly HashSet<TimelineCategory> _active = new();
    private Dictionary<TimelineCategory, int> _counter = new();
    private string? _meId;
    private int _newCount;
    private bool _onlyNew;

    protected override async Task OnInitializedAsync()
    {
        _meId = User.GetAgentId();
        _all = await TimelineService.GetTimelineAsync(EntityType, EntityId, User);
        _exists = _all.Select(e => e.Category).Distinct().OrderBy(k => (int)k).ToList();
        _counter = _all.GroupBy(e => e.Category).ToDictionary(g => g.Key, g => g.Count());
        _active.Clear();
        foreach (var k in _exists)
        {
            _active.Add(k);
        }
        _load = false;
        CountNew();
    }

    // the page may learn the visit only after this panel exists
    protected override void OnParametersSet() => CountNew();

    private void CountNew()
    {
        _newCount = _all.Count(IsNew);
        if (_newCount == 0)
        {
            _onlyNew = false;
        }
    }

    private bool IsNew(TimelineEntry e) => RecordVisits.IsNew(e, NewSince, _meId);

    private IEnumerable<TimelineEntry> Filtered()
        => _all.Where(e => _active.Contains(e.Category) && (!_onlyNew || IsNew(e)));

    private void Toggle(TimelineCategory k)
    {
        if (!_active.Remove(k))
        {
            _active.Add(k);
        }
    }

    private static string Name(TimelineCategory k) => TimelineCategoryDisplay.Name(k);

    private static Color Colour(TimelineCategory k) => TimelineCategoryDisplay.Colour(k);

    private static string Symbol(TimelineCategory k) => TimelineCategoryDisplay.Symbol(k);
}
