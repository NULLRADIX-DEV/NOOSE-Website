@inject IAgentManagementService AgentService
@inject IAbsenceService AbsenceService

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3" Style="min-width:380px;" Class="noose-min-breite-frei">
            @* the sign-offs are read for the due date, so moving it has to move them too *@
            <MudDatePicker @bind-Date="_due" @bind-Date:after="ReloadAbsencesAsync" Label="Fällig am" Editable="true"
                           Variant="Variant.Outlined" DateFormat="dd.MM.yyyy"
                           Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Event" />

            <MentionInput @bind-Text="_note" Label="Notiz (optional)" Lines="3" MaxLength="500"
                          HelperText="@($"Worum geht es bei dieser Wiedervorlage? {MentionInput.Hint}")" />

            <MudAutocomplete T="Agent" Label="Zuständig (optional)" @bind-Value="_agent"
                             SearchFunc="@SearchAgents" ToStringFunc="@(a => a is null ? string.Empty : a.Codename)"
                             Variant="Variant.Outlined" Clearable="true" CoerceText="false" CoerceValue="false"
                             ResetValueOnEmptyText="true" MinCharacters="0" Immediate="true"
                             Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.ManageAccounts"
                             HelperText="Leer = du selbst. Zuständiger und Follower der Akte werden bei Fälligkeit erinnert.">
                <ItemTemplate Context="a">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Color="Color.Primary" />
                        <MudText Typo="Typo.body2">@a.Codename</MudText>
                        @if (MayRealName && !string.IsNullOrWhiteSpace(a.RealName))
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">(@a.RealName)</MudText>
                        }
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@DivisionRules.RankName(a)</MudText>
                        @if (AbsenceHint.For(_absent, a.Id, _reference) is { Length: > 0 } hint)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">· @hint</MudText>
                        }
                    </MudStack>
                </ItemTemplate>
            </MudAutocomplete>
            @* a hint you lose by picking the entry is a hint nobody acted on *@
            @if (SelectedAbsenceNote() is { Length: > 0 } note)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true">@note</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@(_due is null)">Speichern</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public DateTime? DueAt { get; set; }
    [Parameter] public string? Note { get; set; }
    [Parameter] public string? ResponsibleAgentId { get; set; }

    /// <summary>Whether the viewer may see real names.</summary>
    [Parameter] public bool MayRealName { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private DateTime? _due;
    private string _note = string.Empty;
    private Agent? _agent;
    private List<Agent> _all = new();
    private IReadOnlyDictionary<string, DateOnly> _absent = new Dictionary<string, DateOnly>();
    private DateOnly _reference = DateOnly.FromDateTime(DateTime.Now);

    protected override async Task OnInitializedAsync()
    {
        _due = (DueAt ?? DateTime.UtcNow.AddDays(1)).ToLocalTime().Date;
        _note = Note ?? string.Empty;
        await ReloadAbsencesAsync();

        // TeamLeads and partners are never selectable
        _all = await AgentService.GetSelectableAsync();
        if (!string.IsNullOrEmpty(ResponsibleAgentId))
        {
            // a stored responsible who is no longer selectable must still round-trip; without the
            // fallback the value saves back as null and the server reassigns it to the editing agent.
            // Resolved outside _all on purpose, so nobody can newly pick them.
            _agent = _all.FirstOrDefault(a => a.Id == ResponsibleAgentId)
                ?? await AgentService.FindAsync(ResponsibleAgentId);
        }
    }

    /// <summary>Reads the sign-offs for the due date, which is always set in this dialog.</summary>
    private async Task ReloadAbsencesAsync()
    {
        _reference = _due is { } due
            ? DateOnly.FromDateTime(due)
            : DateOnly.FromDateTime(DateTime.Now);
        try
        {
            var user = (await AuthStateTask).User;
            _absent = await AbsenceService.GetAbsentOnAsync(_reference, user);
        }
        catch (Exception)
        {
            // a hint is never worth the dialog; without it the picker simply says nothing
            _absent = new Dictionary<string, DateOnly>();
        }
    }

    private string SelectedAbsenceNote()
        => _agent is null
            ? string.Empty
            : AbsenceHint.Selected(_absent, [(_agent.Id, _agent.Codename)], _reference);

    private Task<IEnumerable<Agent>> SearchAgents(string value, CancellationToken token)
    {
        var search = value.Trim();
        IEnumerable<Agent> hit = string.IsNullOrWhiteSpace(value)
            ? _all
            : _all.Where(a => a.Codename.Contains(search, StringComparison.OrdinalIgnoreCase)
                            || (MayRealName && (a.RealName ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase)));
        return Task.FromResult(hit);
    }

    private void Save()
    {
        if (_due is null)
        {
            return;
        }
        MudDialog.Close(DialogResult.Ok(new FollowupInput(_due.Value, _note, _agent?.Id)));
    }

    private void Cancel() => MudDialog.Cancel();

    /// <summary>Shows the dialog; returns the input or null on cancel.</summary>
    public static async Task<FollowupInput?> ShowAsync(IDialogService dialog, bool mayRealName,
        string title = "Wiedervorlage planen", DateTime? dueAt = null, string? note = null, string? responsibleAgentId = null)
    {
        var parameters = new DialogParameters<FollowupDialog>
        {
            { x => x.MayRealName, mayRealName },
            { x => x.DueAt, dueAt },
            { x => x.Note, note },
            { x => x.ResponsibleAgentId, responsibleAgentId },
        };
        var reference = await dialog.ShowAsync<FollowupDialog>(title, parameters);
        var result = await reference.Result;
        return result is { Canceled: false, Data: FollowupInput input } ? input : null;
    }
}
