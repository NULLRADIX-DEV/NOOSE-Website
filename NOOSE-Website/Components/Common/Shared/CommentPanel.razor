@inject ICommentService CommentService
@inject IMentionService MentionService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPartnerShareService PartnerShareService

<MudStack Spacing="3">
    <MudText Typo="Typo.subtitle1">Kommentare (@_entries.Count)</MudText>

    @if (_mayWrite)
    {
        <MudStack Spacing="2">
            <MentionInput @ref="_newInput" @bind-Text="_newText" Placeholder="@Placeholder" OnSubmit="AddAsync"
                          ImageOwnerType="@EntityType" ImageOwnerId="@EntityId"
                          DraftKey='@($"vermerk:neu:{EntityType}:{EntityId}")' />
            <MudStack Row="true" Justify="Justify.FlexEnd">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send"
                           OnClick="AddAsync" Disabled="@(_saves || string.IsNullOrWhiteSpace(_newText))">
                    Kommentieren
                </MudButton>
            </MudStack>
        </MudStack>
    }

    @if (_load)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_entries.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Noch keine Kommentare.</MudText>
    }
    else
    {
        @foreach (var e in _entries)
        {
            <MudPaper Class="pa-3" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="noose-eintrag">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="noose-eintrag noose-eintrag-titel">
                        <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Size="Size.Small" Color="Color.Default" />
                        <MudText Typo="Typo.body2"><b>@(string.IsNullOrWhiteSpace(e.K.AuthorName) ? "Unbekannt" : e.K.AuthorName)</b></MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            · @e.K.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </MudText>
                        @if (e.K.ModifiedAt is not null)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">· bearbeitet</MudText>
                        }
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0" Class="noose-mobil-aus">
                        <PartnerChildShareButton Show="_canShareChildren" ChildType="@nameof(Comment)" ChildId="@e.K.Id" />
                        @if (_mayWrite && MayEdit(e.K) && _editingId != e.K.Id)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Default" Size="Size.Small"
                                           OnClick="@(() => BeginEdit(e.K))" aria-label="Kommentar bearbeiten" />
                        }
                        @if (_mayWrite && MayDelete(e.K))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => DeleteAsync(e.K))" aria-label="Kommentar löschen" />
                        }
                    </MudStack>
                    @* the same actions behind the same checks, as a ⋮ menu below 600px *@
                    @if (_canShareChildren || (_mayWrite && MayEdit(e.K) && _editingId != e.K.Id) || (_mayWrite && MayDelete(e.K)))
                    {
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" Class="noose-nur-handy"
                                 AriaLabel="Aktionen" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                            <PartnerChildShareButton Show="_canShareChildren" ChildType="@nameof(Comment)" ChildId="@e.K.Id" AsMenuItem="true" />
                            @if (_mayWrite && MayEdit(e.K) && _editingId != e.K.Id)
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => BeginEdit(e.K))">Bearbeiten</MudMenuItem>
                            }
                            @if (_mayWrite && MayDelete(e.K))
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error"
                                             OnClick="@(() => DeleteAsync(e.K))">Löschen</MudMenuItem>
                            }
                        </MudMenu>
                    }
                </MudStack>
                @if (_editingId == e.K.Id)
                {
                    <div class="mt-1">
                        <MentionInput @ref="_editInput" @bind-Text="_editText" Lines="3" AutoFocus="true"
                                      Placeholder="@PlaceholderEdit" OnSubmit="SaveEditAsync"
                                      ImageOwnerType="@EntityType" ImageOwnerId="@EntityId"
                                      DraftKey='@($"vermerk:{e.K.Id}")' />
                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1" Class="mt-1">
                            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                       OnClick="CancelEdit">Abbrechen</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Check" OnClick="SaveEditAsync"
                                       Disabled="@(_editSaving || string.IsNullOrWhiteSpace(_editText))">Speichern</MudButton>
                        </MudStack>
                    </div>
                }
                else
                {
                    <div class="mt-1">
                        <MentionText Segments="e.Segments" />
                    </div>
                }
            </MudPaper>
        }
    }
</MudStack>

@code {
    [Parameter, EditorRequired] public string EntityType { get; set; } = default!;
    [Parameter, EditorRequired] public string EntityId { get; set; } = default!;
    [Parameter, EditorRequired] public ClaimsPrincipal User { get; set; } = default!;

    private const string Placeholder = "Vermerk hinzufügen … (Verlinken per @, Strg+Enter sendet)";
    private const string PlaceholderEdit = "Vermerk bearbeiten … (Verlinken per @, Strg+Enter speichert)";
    private bool _load = true;
    private bool _saves;
    private bool _isLeadership;
    private bool _mayClassifiedRead;
    private bool _mayRealName;
    private bool _mayWrite;
    private bool _canShareChildren;
    private string _newText = string.Empty;
    private MentionInput? _newInput;
    private MentionInput? _editInput;
    private string? _editingId;
    private string _editText = string.Empty;
    private bool _editSaving;
    private List<Entry> _entries = new();

    private sealed record Entry(Comment K, IReadOnlyList<MentionSegment> Segments);

    protected override async Task OnInitializedAsync()
    {
        _isLeadership = User.IsLeadership();
        _mayClassifiedRead = User.MayClassifiedRead();
        _mayRealName = User.MayRealNameSee();
        _mayWrite = User.MayWrite();
        // leadership: per-item release only matters when the record is shell-released
        if (_isLeadership)
        {
            _canShareChildren = (await PartnerShareService.GetForRecordAsync(EntityType, EntityId))
                .Any(s => s.Released && !s.IncludesChildren);
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _load = true;
        var comments = await CommentService.GetForRecordAsync(EntityType, EntityId, ViewerScope.From(User));
        // resolve all comment mentions in one batch
        var segments = await MentionService.ResolveManyAsync(
            comments.Select(k => (string?)k.Text).ToList(), _mayClassifiedRead, User.GetAgentId(),
            partnerAgency: User.GetPartnerAgency());
        _entries = comments.Select((k, i) => new Entry(k, segments[i])).ToList();
        _load = false;
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(_newText))
        {
            return;
        }
        _saves = true;
        try
        {
            await CommentService.CreateAsync(EntityType, EntityId, _newText, User);
            if (_newInput is not null)
            {
                await _newInput.MarkSavedAsync();
            }
            _newText = string.Empty;
            Snackbar.Add("Kommentar gespeichert.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saves = false;
        }
    }

    private void BeginEdit(Comment comment)
    {
        _editingId = comment.Id; // one edit at a time
        _editText = comment.Text;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _editText = string.Empty;
    }

    private async Task SaveEditAsync()
    {
        if (_editSaving || _editingId is null || string.IsNullOrWhiteSpace(_editText))
        {
            return;
        }
        _editSaving = true;
        try
        {
            await CommentService.EditAsync(_editingId, _editText, User);
            // before the field goes: its teardown would otherwise write the saved text back as a draft
            if (_editInput is not null)
            {
                await _editInput.MarkSavedAsync();
            }
            _editingId = null;
            _editText = string.Empty;
            Snackbar.Add("Kommentar gespeichert.", Severity.Success);
            await LoadAsync(); // re-resolves the mentions in the new text
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _editSaving = false;
        }
    }

    private async Task DeleteAsync(Comment comment)
    {
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Kommentar löschen?",
            "Der Kommentar wird in den Papierkorb verschoben.");
        if (!ok)
        {
            return;
        }
        await CommentService.DeleteAsync(comment.Id, User);
        Snackbar.Add("Kommentar gelöscht.", Severity.Success);
        await LoadAsync();
    }

    private bool MayDelete(Comment k)
        => _isLeadership || (k.CreatedById is not null && k.CreatedById == User.GetAgentId());

    // author only: leadership may remove a foreign comment, never restate it
    private bool MayEdit(Comment k)
        => k.CreatedById is not null && k.CreatedById == User.GetAgentId();
}
