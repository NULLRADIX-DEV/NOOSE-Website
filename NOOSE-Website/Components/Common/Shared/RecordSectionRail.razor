@* Vertical, grouped section rail for record detail pages; keeps the active section in the ?tab= query. *@
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IScrollManager Scroll

@* instantiates the RecordSection children so they can register; they render no markup of their own *@
<CascadingValue Value="this" IsFixed="true">
    @ChildContent
</CascadingValue>

@if (HideRailWhenSingle && _sections.Count <= 1)
{
    @* a 15rem rail holding one button is just a stripe; give the section the full width instead *@
    @Active?.ChildContent
}
else
{
@* Below 960px the rail is a bar pinned under the app bar: the current section, and a menu to switch, reachable
   anywhere down a long section. From 960px up both stay hidden and the rail stands beside the content as before.
   The anchor in front of the bar is where a switch scrolls to, so the new section starts at its top. *@
<div id="@_anchorId" class="record-rail-anker noose-nur-schmal"></div>
<MudPaper Elevation="2" Class="record-rail-leiste noose-nur-schmal">
    <MudMenu FullWidth="true" RelativeWidth="DropdownWidth.Relative" MaxHeight="420" Dense="true"
             AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" AriaLabel="Abschnitt wechseln">
        <ActivatorContent>
            <MudButton FullWidth="true" Variant="Variant.Text" Class="record-rail-leiste-knopf"
                       StartIcon="@Active?.Icon" EndIcon="@Icons.Material.Filled.UnfoldMore">
                <span class="record-rail-leiste-titel">@Active?.Label</span>
            </MudButton>
        </ActivatorContent>
        <ChildContent>
            @foreach (var group in Grouped())
            {
                @if (!string.IsNullOrWhiteSpace(group.Key))
                {
                    <MudText Typo="Typo.overline" Class="px-4 pt-2 mud-text-secondary d-block">@group.Key</MudText>
                }
                @foreach (var entry in group)
                {
                    <MudMenuItem Icon="@entry.Icon" OnClick="@(() => SwitchAsync(entry.Slug))"
                                 Class="@(IsActive(entry) ? "record-rail-leiste-aktiv" : null)"
                                 aria-current="@(IsActive(entry) ? "true" : null)">
                        @entry.Label
                        @if (entry.Badge is > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ml-2 my-0">@entry.Badge</MudChip>
                        }
                    </MudMenuItem>
                }
            }
        </ChildContent>
    </MudMenu>
</MudPaper>
<MudPaper Elevation="2" Class="d-flex flex-column flex-md-row record-rail-shell">
    <nav class="record-rail noose-schmal-aus" aria-label="Abschnitte">
        @foreach (var group in Grouped())
        {
            @if (!string.IsNullOrWhiteSpace(group.Key))
            {
                <MudText Typo="Typo.overline" Class="px-4 pt-3 pb-1 mud-text-secondary d-block">@group.Key</MudText>
            }
            @foreach (var entry in group)
            {
                <MudButton FullWidth="true"
                           Variant="@(IsActive(entry) ? Variant.Filled : Variant.Text)"
                           Color="@(IsActive(entry) ? Color.Primary : Color.Default)"
                           StartIcon="@entry.Icon"
                           OnClick="@(() => ActivateAsync(entry.Slug))"
                           aria-current="@(IsActive(entry) ? "true" : null)">
                    @if (entry.Badge is > 0)
                    {
                        <MudBadge Content="@entry.Badge" Color="Color.Primary" Overlap="false">@entry.Label</MudBadge>
                    }
                    else
                    {
                        @entry.Label
                    }
                </MudButton>
            }
        }
    </nav>
    @* keyed: a new element per section, so the pane starts at the top instead of
       inheriting the previous section's scroll offset *@
    <div class="flex-grow-1 pa-4 record-rail-content" @key="Active?.Slug">
        @Active?.ChildContent
    </div>
</MudPaper>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Render the lone remaining section without the rail; for pages whose others are gated away.</summary>
    [Parameter] public bool HideRailWhenSingle { get; set; }

    private readonly List<RecordSection> _sections = [];
    private readonly string _anchorId = $"abschnitt-{Guid.NewGuid():N}";
    private string? _activeSlug;
    private bool _redraw;

    private RecordSection? Active
        => _sections.FirstOrDefault(s => s.Slug == _activeSlug) ?? _sections.FirstOrDefault();

    private bool IsActive(RecordSection section) => ReferenceEquals(section, Active);

    protected override void OnInitialized()
    {
        _activeSlug = QueryState.Read(Nav, "tab");
        Nav.LocationChanged += OnLocationChanged;
    }

    // browser back/forward and record-to-record navigation both land here; clicking a
    // section uses replaceState instead, which does not raise this event
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => _ = InvokeAsync(() =>
        {
            _activeSlug = QueryState.Read(Nav, "tab");
            StateHasChanged();
        });

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    internal void Register(RecordSection section)
    {
        if (!_sections.Contains(section))
        {
            _sections.Add(section);
            _redraw = true;
        }
    }

    internal void Unregister(RecordSection section)
    {
        if (_sections.Remove(section))
        {
            _redraw = true;
        }
    }

    // a section's badge changed while the rail was rendering it
    internal void Redraw() => _redraw = true;

    // children register and update while this component is already rendering, so redraw once they are all in
    protected override void OnAfterRender(bool firstRender)
    {
        if (_redraw)
        {
            _redraw = false;
            StateHasChanged();
        }
    }

    // declaration order decides both group order and the order within a group
    private IEnumerable<IGrouping<string, RecordSection>> Grouped()
        => _sections.GroupBy(s => s.Group ?? string.Empty);

    private async Task ActivateAsync(string slug)
    {
        _activeSlug = slug;
        await QueryState.WriteAsync(JS, Nav, ("tab", slug));
    }

    // the bar is only on screen below 960px, where a long section leaves the reader far down the page
    private async Task SwitchAsync(string slug)
    {
        await ActivateAsync(slug);
        await Scroll.ScrollIntoViewAsync($"#{_anchorId}", ScrollBehavior.Auto);
    }
}
