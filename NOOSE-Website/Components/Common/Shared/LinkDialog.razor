    private async Task TypeSwitchedAsync()
    {
        _person = null; _faction = null; _group = null; _party = null; _operation = null; _taskforce = null;
        _case = null; _job = null; _agent = null; _doc = null; _observation = null; _law = null; _document = null;
        _bewerbung = null; _meeting = null; _tip = null; _ticket = null; _presentation = null;
        if (_targetType == nameof(Agent) && _allAgents is null)
        {
            // TeamLeads are never selectable
            _allAgents = await AgentService.GetSelectableAsync();
        }
        if (_targetType == nameof(PersonDoc) && _allDocs is null)
        {
            _allDocs = await DocService.GetAllAsync(IsLeadership);
        }
        if (_targetType == nameof(Observation) && _allObservations is null)
        {
            _allObservations = await ObservationService.GetAllAsync(IsLeadership);
        }
        if (_targetType == nameof(Bewerbung) && _allBewerbungen is null && _user is not null)
        {
            _allBewerbungen = await BewerbungService.ListAsync(_user);
        }
        if (_targetType == nameof(Presentation) && _allPresentations is null && _user is not null)
        {
            _allPresentations = await PresentationService.GetListAsync(_user);
        }
    }

    // callers hand in the already-linked ids, the picker must not offer them again
    private IEnumerable<T> Allowed<T>(string type, IEnumerable<T> hits, Func<T, string> id)
    {
        if (Excluded is null || !Excluded.TryGetValue(type, out var blocked) || blocked.Count == 0)
        {
            return hits;
        }
        return hits.Where(x => !blocked.Contains(id(x)));
    }

    private async Task<IEnumerable<Person>> SearchPeople(string value, CancellationToken token)
    {
        var hit = await PersonService.SearchAsync(value, IsLeadership, 20, token);
        return Allowed(nameof(Person), hit, p => p.Id);
    }

