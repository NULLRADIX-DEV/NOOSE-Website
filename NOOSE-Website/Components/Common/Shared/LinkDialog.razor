    };

    private void Save()
    {
        var id = CurrentTargetId;
        if (id is null)
        {
            return;
        }
        MudDialog.Close(DialogResult.Ok(new LinkInput { TargetType = _targetType, TargetId = id, Label = _label, Display = CurrentDisplay }));
    }

    private void Cancel() => MudDialog.Cancel();

    /// <summary>Shows the dialog; returns the input or null on cancel.</summary>
    public static async Task<LinkInput?> ShowAsync(IDialogService dialog, bool isLeadership, string? sourceType = null,
        IReadOnlyList<string>? allowedTypes = null, IReadOnlyDictionary<string, IReadOnlyList<string>>? excluded = null,
        string designation = "Verknüpfung", string labelCaption = "Bezeichnung (optional)",
        string labelPlaceholder = "z. B. siehe auch / Quelle für", string? initialType = null)
    {
        var parameters = new DialogParameters<LinkDialog>
        {
            { x => x.IsLeadership, isLeadership },
            { x => x.SourceType, sourceType },
            { x => x.AllowedTypes, allowedTypes },
            { x => x.Excluded, excluded },
            { x => x.LabelCaption, labelCaption },
            { x => x.LabelPlaceholder, labelPlaceholder },
            { x => x.InitialType, initialType },
        };
        var reference = await dialog.ShowAsync<LinkDialog>($"{designation} hinzufügen", parameters);
        var result = await reference.Result;
        return result is { Canceled: false, Data: LinkInput e } ? e : null;
    }

    /// <summary>Builds the exclusion map from an existing link list; self is blocked as its own type.</summary>
    public static Dictionary<string, IReadOnlyList<string>> Exclusions(IReadOnlyList<LinkDisplay>? links = null,
        string? selfType = null, string? selfId = null)
    {
        var map = (links ?? Array.Empty<LinkDisplay>())
            .GroupBy(v => v.OtherType, StringComparer.Ordinal)
            .ToDictionary(g => g.Key, g => (IReadOnlyList<string>)g.Select(v => v.OtherId).Distinct().ToList(), StringComparer.Ordinal);
        if (selfType is not null && selfId is not null)
        {
            var own = map.TryGetValue(selfType, out var existing) ? existing : Array.Empty<string>();
            map[selfType] = own.Contains(selfId) ? own : [.. own, selfId];
        }
        return map;
    }
