    // the picker shows the subject, the link never does: only the case number identifies a ticket outward
    private static string TipText(TipPickRow? h) => h is null ? string.Empty : $"Bürgerhinweis {h.CaseNumber}";

    private static string TicketText(TicketPickRow? t) => t is null ? string.Empty : $"Bürger-Ticket {t.CaseNumber}";

    private Task<IEnumerable<Bewerbung>> SearchBewerbungen(string value, CancellationToken token)
    {
        var all = (IEnumerable<Bewerbung>?)_allBewerbungen ?? Array.Empty<Bewerbung>();
        var s = value?.Trim();
        if (!string.IsNullOrWhiteSpace(s))
        {
            all = all.Where(b => b.Name.Contains(s, StringComparison.OrdinalIgnoreCase)
                                || b.CaseNumber.Contains(s, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(Allowed(nameof(Bewerbung), all, b => b.Id));
    }

    private Task<IEnumerable<PresentationListItem>> SearchPresentations(string value, CancellationToken token)
    {
        var all = (IEnumerable<PresentationListItem>?)_allPresentations ?? Array.Empty<PresentationListItem>();
        var s = value?.Trim();
        if (!string.IsNullOrWhiteSpace(s))
        {
            all = all.Where(p => p.Title.Contains(s, StringComparison.OrdinalIgnoreCase)
                                || (p.Description ?? string.Empty).Contains(s, StringComparison.OrdinalIgnoreCase)
                                || p.OwnerCodename.Contains(s, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(Allowed(nameof(Presentation), all, p => p.Id).Take(20));
    }

    private Task<IEnumerable<Agent>> SearchAgents(string value, CancellationToken token)
    {
        var all = (IEnumerable<Agent>?)_allAgents ?? Array.Empty<Agent>();
        var s = value?.Trim();
        if (!string.IsNullOrWhiteSpace(s))
        {
            all = all.Where(a => a.Codename.Contains(s, StringComparison.OrdinalIgnoreCase)
                                || (IsLeadership && (a.RealName ?? string.Empty).Contains(s, StringComparison.OrdinalIgnoreCase)));
        }
        return Task.FromResult(Allowed(nameof(Agent), all, a => a.Id));
    }

    private Task<IEnumerable<PersonDocDisplay>> SearchDocs(string value, CancellationToken token)
    {
