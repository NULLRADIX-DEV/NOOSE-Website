@* Google sign-in for the import: a button that opens Google's sign-in window and file picker in the browser. Only the
   chosen file's id, its name and a short-lived token come back; the import service reads the file with the token once.
   Renders nothing while the GoogleDrive section is not configured. *@
@using Microsoft.Extensions.Options
@using NOOSE_Website.Services.Import
@implements IAsyncDisposable
@inject IOptions<GoogleDriveOptions> DriveOptions
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject ILogger<GoogleDrivePicker> Logger

@if (DriveOptions.Value.IsConfigured)
{
    @* the click is taken in the browser (js/google-drive.js): the sign-in window may only open straight from it *@
    <span @ref="_host" class="google-drive-picker">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Custom.Brands.Google" Disabled="Disabled">@Label</MudButton>
    </span>
}

@code {
    private const string ModulePath = "./js/google-drive.js?v=1";

    [Parameter, EditorRequired] public GoogleFileKind Kind { get; set; }

    /// <summary>Limits the Picker to this file: a refresh reads the file the import came from.</summary>
    [Parameter] public string? FileId { get; set; }

    [Parameter] public string Label { get; set; } = "Bei Google anmelden und wählen";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<GoogleDriveChoice> OnPicked { get; set; }

    private ElementReference _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<GoogleDrivePicker>? _self;
    private string? _bound;
    private bool _binding;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var options = DriveOptions.Value;
        var key = $"{Kind}|{FileId}";
        // renders do not wait for each other: one binding at a time, and none after the dialog is gone
        if (!options.IsConfigured || _bound == key || _binding || _disposed)
        {
            return;
        }
        _binding = true;
        try
        {
            if (_module is null)
            {
                var module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
                if (_disposed)
                {
                    await module.DisposeAsync();
                    return;
                }
                _module = module;
            }
            _self ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("verbinden", _host, _self, new
            {
                clientId = options.ClientId,
                apiKey = options.ApiKey,
                appId = options.AppId,
                kind = Kind == GoogleFileKind.Presentation ? "presentation" : "document",
                fileId = FileId,
                title = Kind == GoogleFileKind.Presentation ? "Präsentation wählen" : "Dokument wählen",
            });
            _bound = key;
        }
        catch (JSDisconnectedException)
        {
            /* the circuit is gone */
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Binding the Google sign-in button failed.");
        }
        finally
        {
            _binding = false;
        }
    }

    [JSInvokable]
    public Task Gewaehlt(string fileId, string name, string accessToken)
        => OnPicked.InvokeAsync(new GoogleDriveChoice(new GoogleDrivePick(fileId ?? string.Empty, accessToken ?? string.Empty),
            Shorten(name)));

    [JSInvokable]
    public void Meldung(string message) => Snackbar.Add(Shorten(message), Severity.Warning);

    private static string Shorten(string? text)
        => text is null ? string.Empty : text.Length > 200 ? text[..200] : text;

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("trennen", _host);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                /* the circuit is gone */
            }
            catch (JSException ex)
            {
                // the dialog sits outside the page's error boundary
                Logger.LogDebug(ex, "Releasing the Google sign-in button failed.");
            }
        }
        _self?.Dispose();
    }
}
