@* One section of a record detail page; renders nothing itself — the rail renders the active section's content. *@
@implements IDisposable

@code {
    [CascadingParameter] private RecordSectionRail? Rail { get; set; }

    /// <summary>Stable key used in the ?tab= query and in PartnerTabCatalog.</summary>
    [Parameter, EditorRequired] public string Slug { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Icon { get; set; }

    /// <summary>Caption this section is filed under in the rail; sections sharing a caption stay together.</summary>
    [Parameter] public string? Group { get; set; }

    /// <summary>Count shown beside the label, e.g. unread messages; nothing below one.</summary>
    [Parameter] public int? Badge { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private int? _shownBadge;
    private string _shownSlug = string.Empty;
    private string _shownLabel = string.Empty;

    protected override void OnInitialized()
    {
        _shownBadge = Badge;
        _shownSlug = Slug;
        _shownLabel = Label;
        Rail?.Register(this);
    }

    // the rail draws badge, slug and label, so it has to hear about a change (sections renamed or reordered)
    protected override void OnParametersSet()
    {
        if (_shownBadge != Badge || _shownSlug != Slug || _shownLabel != Label)
        {
            _shownBadge = Badge;
            _shownSlug = Slug;
            _shownLabel = Label;
            Rail?.Redraw();
        }
    }

    public void Dispose() => Rail?.Unregister(this);
}
