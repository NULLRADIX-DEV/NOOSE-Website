@* Type-to-confirm challenge: a random word that cannot be selected or copied. *@
<MudStack Spacing="3">
    <MudText Typo="Typo.body2" Class="mud-text-secondary">@Prompt</MudText>
    <div class="challenge-word">
        @foreach (var ch in _challenge)
        {
            <span class="challenge-letter" data-c="@ch"></span>
        }
    </div>
    <MudTextField @bind-Value="_typed" @bind-Value:after="MatchCheck" Immediate="true" Label="@Label"
                  Variant="Variant.Outlined" autocomplete="off" spellcheck="false" />
</MudStack>

<style>
    .challenge-word { display:flex; gap:.4rem; font-size:2rem; font-weight:700; letter-spacing:.25rem;
                      background:rgba(255,255,255,.05); padding:.75rem 1rem; border-radius:.5rem;
                      user-select:none; -webkit-user-select:none; }
    .challenge-letter { pointer-events:none; }
    .challenge-letter::before { content:attr(data-c); }
    @@media screen and (max-width: 599.98px) {
        .challenge-word { font-size:clamp(1.25rem, 8vw, 2rem); gap:.2rem; letter-spacing:.1rem; padding:.5rem .75rem; }
    }
</style>

@code {
    /// <summary>Number of letters to generate.</summary>
    [Parameter] public int Length { get; set; } = 6;

    [Parameter] public string Prompt { get; set; } = "Tippe das folgende Wort ab (es lässt sich nicht kopieren):";
    [Parameter] public string Label { get; set; } = "Wort eingeben";

    /// <summary>Raised whenever the typed input starts or stops matching.</summary>
    [Parameter] public EventCallback<bool> MatchedChanged { get; set; }

    // generated once in OnInitialized; the field re-renders on every keystroke
    private string _challenge = string.Empty;
    private string _typed = string.Empty;
    private bool _matched;

    protected override void OnInitialized() => _challenge = ChallengeWord.Generate(Length);

    private async Task MatchCheck()
    {
        var matched = ChallengeWord.Matches(_typed, _challenge);
        if (matched == _matched)
        {
            return;
        }
        _matched = matched;
        await MatchedChanged.InvokeAsync(matched);
    }
}
