@* Ranked hazard list used for both factions and people on the dashboard. *@
@using NOOSE_Website.Models.Dashboard
@using NOOSE_Website.Theme
@inject NavigationManager Nav

@if (Items.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">@EmptyText</MudText>
}
else
{
    <div class="dashboard-fraktionsliste">
        <MudList T="string" Dense="true">
            @foreach (var item in Items)
            {
                <MudListItem T="string" OnClick="@(() => Open(item.Href))" Style="cursor:pointer;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="noose-eintrag-titel">
                            <span style="@Dot(item.Level)"></span>
                            <div>
                                <MudText Typo="Typo.body2"><b>@item.Name</b></MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@item.CaseNumber</MudText>
                            </div>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudTooltip Text="@ThreatTrendText.Hint(TrendOf(item))">
                                <ThreatSparkline Values="TrendOf(item)" Width="48" />
                            </MudTooltip>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@HazardLevelLogic.Name(item.Level)</MudText>
                        </MudStack>
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    </div>
}

@code {
    [Parameter] public IReadOnlyList<DashboardFactionHazard> Items { get; set; } = [];
    [Parameter] public string EmptyText { get; set; } = "Noch keine Einträge.";

    /// <summary>Score history per record id; an id without an entry simply shows no curve.</summary>
    [Parameter] public IReadOnlyDictionary<string, IReadOnlyList<int>> Trends { get; set; }
        = new Dictionary<string, IReadOnlyList<int>>();

    private IReadOnlyList<int> TrendOf(DashboardFactionHazard item)
        => Trends.TryGetValue(item.Id, out var trend) ? trend : [];

    private static string Dot(HazardLevel level)
        => $"display:inline-block;width:12px;height:12px;border-radius:50%;background:{ChartPalette.ForHazard(level)};flex:none;";

    private void Open(string? href)
    {
        if (!string.IsNullOrEmpty(href))
        {
            Nav.NavigateTo(href);
        }
    }
}
