@using System.Security.Claims
@using NOOSE_Website.Authorization
@using NOOSE_Website.Models.Llm
@using NOOSE_Website.Services
@inject IDossierSummaryService Dossier
@inject ISnackbar Snackbar

@if (_canGenerate)
{
    @* one place for all eight detail pages; the chat resolves the record against the asker's own scope again *@
    <div class="d-flex justify-end mb-2">
        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Forum" Href="@ChatHref">
            FIBI zu dieser Akte fragen
        </MudButton>
    </div>
}

@if (!_loaded)
{
    <div class="d-flex justify-center pa-6">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
    </div>
}
else if (_view is null)
{
    <EmptyState Icon="@Icons.Material.Filled.AutoAwesome" Text="Kein Zugriff auf diese Akte." />
}
else if (!_view.Exists)
{
    @if (!_view.Configured)
    {
        <EmptyState Icon="@Icons.Material.Filled.AutoAwesome"
                    Text="FIBI ist nicht konfiguriert. Ein Admin muss Endpoint, Modell und Schlüssel hinterlegen." />
    }
    else
    {
        <MudPaper Class="pa-6 d-flex flex-column align-center" Elevation="0" Style="gap:12px;">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.body2" Class="mud-text-secondary" Align="Align.Center">
                Für diese Akte wurde noch kein FIBI-Kurzbrief erstellt.
            </MudText>
            @if (_canGenerate)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoAwesome"
                           OnClick="() => GenerateAsync(false)" Disabled="_busy">Kurzbrief erstellen</MudButton>
            }
        </MudPaper>
    }
}
else if (_view.Brief is { } brief)
{
    <MudStack Spacing="3">
        @if (_busy)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }

        @if (_view.IsStale)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="d-flex align-center"
                      Icon="@Icons.Material.Filled.Update">
                <div class="d-flex align-center justify-space-between" style="width:100%;gap:12px;">
                    <span>Die Akte wurde seit dem letzten Kurzbrief geändert.</span>
                    @if (_canGenerate)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning"
                                   OnClick="() => GenerateAsync(true)" Disabled="_busy">Neu generieren</MudButton>
                    }
                </div>
            </MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(brief.Tldr))
        {
            <MudPaper Elevation="0" Class="pa-4 ki-brief-tldr">
                <MudText Typo="Typo.overline" Color="Color.Primary">TL;DR</MudText>
                <MudText Typo="Typo.body1">@brief.Tldr</MudText>
            </MudPaper>
        }

        <MudPaper Elevation="0" Class="pa-3 d-flex align-center ki-brief-risk" Style="gap:12px;">
            <MudIcon Icon="@Icons.Material.Filled.Shield" Color="@RiskColour(brief.Risiko.Level)" />
            <div>
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Risiko-Einschätzung</MudText>
                <MudText Typo="Typo.subtitle2" Color="@RiskColour(brief.Risiko.Level)">@RiskName(brief.Risiko.Level)</MudText>
                @if (!string.IsNullOrWhiteSpace(brief.Risiko.Begruendung))
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@brief.Risiko.Begruendung</MudText>
                }
            </div>
        </MudPaper>

        @if (brief.Kernpunkte.Count > 0)
        {
            <div>
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Kernpunkte</MudText>
                <MudList T="string" Dense="true" Class="ki-brief-list">
                    @foreach (var point in brief.Kernpunkte)
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Filled.ChevronRight" Text="@point" />
                    }
                </MudList>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(brief.EinstufungBewertung))
        {
            <div>
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Einstufung</MudText>
                <MudText Typo="Typo.body2">@brief.EinstufungBewertung</MudText>
            </div>
        }

        @if (brief.Verbindungen.Count > 0)
        {
            <div>
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Verbindungen</MudText>
                <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="ki-brief-table">
                    <tbody>
                        @foreach (var link in brief.Verbindungen)
                        {
                            <tr>
                                <td style="width:34%;"><strong>@link.Wer</strong></td>
                                <td style="width:22%;">
                                    @if (!string.IsNullOrWhiteSpace(link.Art))
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">@link.Art</MudChip>
                                    }
                                </td>
                                <td class="mud-text-secondary">@link.Relevanz</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }

        @if (brief.Verlauf.Count > 0)
        {
            <div>
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Verlauf</MudText>
                <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="ki-brief-table">
                    <tbody>
                        @foreach (var step in brief.Verlauf)
                        {
                            <tr>
                                <td style="width:22%;white-space:nowrap;" class="mud-text-secondary ki-brief-wann">
                                    @(string.IsNullOrWhiteSpace(step.Wann) ? "—" : step.Wann)
                                </td>
                                <td>@step.Was</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }

        @if (brief.OffenePunkte.Count > 0)
        {
            <div>
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Offene Punkte</MudText>
                <MudList T="string" Dense="true" Class="ki-brief-list">
                    @foreach (var open in brief.OffenePunkte)
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Filled.HelpOutline" IconColor="Color.Warning" Text="@open" />
                    }
                </MudList>
            </div>
        }

        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-1">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                FIBI · KI-generiert, ungeprüft
                @if (_view.GeneratedAt is { } g)
                {
                    <text> · erstellt @g.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</text>
                }
            </MudText>
            @if (_canGenerate && !_view.IsStale)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="() => GenerateAsync(true)" Disabled="_busy">Neu generieren</MudButton>
            }
        </MudStack>
    </MudStack>
}

@code {
    [Parameter, EditorRequired] public string EntityType { get; set; } = default!;
    [Parameter, EditorRequired] public string EntityId { get; set; } = default!;
    [Parameter] public ClaimsPrincipal? User { get; set; }

    private DossierSummaryView? _view;
    private bool _loaded;
    private bool _busy;
    private string? _loadedKey;

    private bool _canGenerate =>
        _view?.Configured == true && User is { } u && !u.IsPartner() && !u.IsDemo() && !u.IsOnlyReader();

    private string ChatHref => $"/ki-assistent?akte={Uri.EscapeDataString($"{EntityType}:{EntityId}")}";

    private static Color RiskColour(BriefRiskLevel level) => level switch
    {
        BriefRiskLevel.Niedrig => Color.Success,
        BriefRiskLevel.Hoch => Color.Error,
        _ => Color.Warning,
    };

    private static string RiskName(BriefRiskLevel level) => level switch
    {
        BriefRiskLevel.Niedrig => "Niedrig",
        BriefRiskLevel.Hoch => "Hoch",
        _ => "Mittel",
    };

    protected override async Task OnParametersSetAsync()
    {
        var key = EntityType + "|" + EntityId;
        if (key == _loadedKey || string.IsNullOrEmpty(EntityId) || User is null)
        {
            return;
        }
        _loadedKey = key;
        _loaded = false;
        try
        {
            _view = await Dossier.GetAsync(EntityType, EntityId, User);
        }
        catch (Exception ex)
        {
            Snackbar.Add(NooseiErrors.Describe(ex), Severity.Error);
        }
        finally
        {
            _loaded = true;
        }
    }

    private async Task GenerateAsync(bool force)
    {
        if (_busy || User is null)
        {
            return;
        }
        _busy = true;
        try
        {
            _view = await Dossier.GenerateAsync(EntityType, EntityId, User, force);
        }
        catch (Exception ex)
        {
            Snackbar.Add(NooseiErrors.Describe(ex), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
