@* Picks the agent an open follow-up moves to; the service checks the pick again. *@
@inject IAgentManagementService AgentService
@inject IAbsenceService AbsenceService

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3" Style="min-width:380px;">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Der neue Zuständige bekommt eine Benachrichtigung. Er muss die Akte sehen dürfen.
            </MudText>
            <MudAutocomplete T="Agent" Label="Neuer Zuständiger" @bind-Value="_agent"
                             SearchFunc="@SearchAgents" ToStringFunc="@(a => a is null ? string.Empty : a.Codename)"
                             Variant="Variant.Outlined" Clearable="true" CoerceText="false" CoerceValue="false"
                             ResetValueOnEmptyText="true" MinCharacters="0" Immediate="true"
                             Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.ManageAccounts">
                <ItemTemplate Context="a">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Color="Color.Primary" />
                        <MudText Typo="Typo.body2">@a.Codename</MudText>
                        @if (MayRealName && !string.IsNullOrWhiteSpace(a.RealName))
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">(@a.RealName)</MudText>
                        }
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@RankDisplay.Name(a.Rank)</MudText>
                        @if (AbsenceHint.For(_absent, a.Id, _today) is { Length: > 0 } hint)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">· @hint</MudText>
                        }
                    </MudStack>
                </ItemTemplate>
            </MudAutocomplete>
            @if (SelectedAbsenceNote() is { Length: > 0 } note)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true">@note</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@(_agent is null)">Umhängen</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    /// <summary>The current responsible; left out of the offer.</summary>
    [Parameter] public string? CurrentAgentId { get; set; }

    /// <summary>Whether the viewer may see real names.</summary>
    [Parameter] public bool MayRealName { get; set; }

    private Agent? _agent;
    private List<Agent> _all = new();
    private IReadOnlyDictionary<string, DateOnly> _absent = new Dictionary<string, DateOnly>();
    private readonly DateOnly _today = MeetingTime.Day(DateTime.UtcNow);

    protected override async Task OnInitializedAsync()
    {
        _all = (await AgentService.GetSelectableAsync()).Where(a => a.Id != CurrentAgentId).ToList();
        try
        {
            _absent = await AbsenceService.GetAbsentOnAsync(_today, (await AuthStateTask).User);
        }
        catch (Exception)
        {
            // hint only
            _absent = new Dictionary<string, DateOnly>();
        }
    }

    private string SelectedAbsenceNote()
        => _agent is null
            ? string.Empty
            : AbsenceHint.Selected(_absent, [(_agent.Id, _agent.Codename)], _today);

    private Task<IEnumerable<Agent>> SearchAgents(string value, CancellationToken token)
    {
        var search = value.Trim();
        IEnumerable<Agent> hit = string.IsNullOrWhiteSpace(value)
            ? _all
            : _all.Where(a => a.Codename.Contains(search, StringComparison.OrdinalIgnoreCase)
                            || (MayRealName && (a.RealName ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase)));
        return Task.FromResult(hit);
    }

    private void Save()
    {
        if (_agent is not null)
        {
            MudDialog.Close(DialogResult.Ok(_agent.Id));
        }
    }

    private void Cancel() => MudDialog.Cancel();

    /// <summary>Shows the dialog; returns the picked agent id or null on cancel.</summary>
    public static async Task<string?> ShowAsync(IDialogService dialog, string? currentAgentId, bool mayRealName)
    {
        var parameters = new DialogParameters<FollowupReassignDialog>
        {
            { x => x.CurrentAgentId, currentAgentId },
            { x => x.MayRealName, mayRealName },
        };
        var reference = await dialog.ShowAsync<FollowupReassignDialog>("Wiedervorlage umhängen", parameters);
        var result = await reference.Result;
        return result is { Canceled: false, Data: string id } ? id : null;
    }
}
