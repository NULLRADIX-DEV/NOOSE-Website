@* Renders a statistics report as print-friendly tables. *@
@* Every member is treated as nullable: archived snapshots predate later members, and System.Text.Json *@
@* hands a missing constructor parameter null rather than an empty list. *@
@using NOOSE_Website.Models.Dashboard
@using NOOSE_Website.Models.Statistics

@if (Report is { } r)
{
    @if (r.Metrics is { } metrics)
    {
        <section>
            <h2>Kennzahlen</h2>
            <table class="druck-felder">
                <tbody>
                    <tr><th>Personen-Akten</th><td>@metrics.People</td></tr>
                    <tr><th>Organisationen (Fraktionen, Gruppen, Parteien)</th><td>@metrics.FactionsAndGroups</td></tr>
                    <tr><th>Operationen</th><td>@metrics.Operations</td></tr>
                    <tr><th>Offene Vorgänge</th><td>@metrics.OpenCases</td></tr>
                    @if (!ForPartner)
                    {
                        <tr><th>Offene Anträge</th><td>@metrics.OpenRequests</td></tr>
                        <tr><th>Veraltete Akten</th><td>@metrics.StaleRecords</td></tr>
                    }
                </tbody>
            </table>
        </section>
    }

    @DistributionTable("Personen nach Einstufung", r.PeopleByClassification)
    @DistributionTable("Personen nach Gefährdung", r.PeopleByHazard)
    @DistributionTable("Personen nach Lebensstatus", r.PeopleByLifeStatus)
    @DistributionTable("Fraktionen nach Gefährdung", r.FactionsByHazard)
    @if (!ForPartner)
    {
        @DistributionTable("Maßnahme-Ausgänge", r.MeasureOutcomes)
    }
    @DistributionTable("Vorgänge nach Status", r.CasesByStatus)

    @if (r.TimeSeries is { Count: > 0 } months)
    {
        <section>
            <h2>Verlauf der letzten 12 Monate</h2>
            <table class="druck-tabelle">
                <thead>
                    <tr><th>Monat</th>@if (!ForPartner) { <th>Maßnahmen</th> }<th>Neuzugänge</th></tr>
                </thead>
                <tbody>
                    @foreach (var m in months)
                    {
                        <tr><td>@m.Label</td>@if (!ForPartner) { <td>@m.Measures</td> }<td>@m.NewEntries</td></tr>
                    }
                </tbody>
            </table>
        </section>
    }

    @if (!ForPartner)
    {
        @TopTable("Gefährlichste Personen", r.TopPeople)
    }
    @TopTable("Gefährlichste Fraktionen", r.TopFactions)
}

@code {
    [Parameter, EditorRequired] public StatisticsReport? Report { get; set; }

    /// <summary>Hides internal workload, measures and named people; the data is redacted already, this keeps the layout honest.</summary>
    [Parameter] public bool ForPartner { get; set; }

    private RenderFragment DistributionTable(string title, IReadOnlyList<DistributionSegment>? segments) =>@<section>
        <h2>@title</h2>
        <table class="druck-tabelle">
            <thead>
                <tr><th>Kategorie</th><th>Anzahl</th></tr>
            </thead>
            <tbody>
                @foreach (var s in segments ?? [])
                {
                    <tr><td>@s.Designation</td><td>@s.Count</td></tr>
                }
            </tbody>
        </table>
    </section>;

    private RenderFragment TopTable(string title, IReadOnlyList<StatisticsTopEntry>? rows) =>@<section>
        @{ var entries = rows ?? []; }
        <h2>@title</h2>
        @if (entries.Count == 0)
        {
            <p>Noch keine bewerteten Akten.</p>
        }
        else
        {
            <table class="druck-tabelle">
                <thead>
                    <tr><th>#</th><th>Name</th><th>Aktenzeichen</th><th>Score</th><th>Stufe</th></tr>
                </thead>
                <tbody>
                    @{ var rank = 0; }
                    @foreach (var e in entries)
                    {
                        rank++;
                        <tr>
                            <td>@rank</td>
                            <td>@e.Name</td>
                            <td>@e.CaseNumber</td>
                            <td>@e.Score</td>
                            <td>@HazardLevelLogic.Name(e.Level)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>;
}
