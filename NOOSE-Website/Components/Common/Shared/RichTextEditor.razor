@* Reusable Quill WYSIWYG editor; read final HTML via GetHtmlAsync. All JS interop is guarded so a JS error never kills the circuit. *@
@using System.Security.Claims
@using System.Text.RegularExpressions
@using NOOSE_Website.Authorization
@using NOOSE_Website.Models.Llm
@inject IJSRuntime JS
@inject ITextSnippetService Snippets
@inject IPlaceholderService Placeholders
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject ITextAssistService TextAssist
@inject IMentionService MentionService
@inject Microsoft.Extensions.Logging.ILogger<RichTextEditor> Logger
@implements IAsyncDisposable

@if (_loadError)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-2">
        Der Editor konnte nicht geladen werden. Bitte die Seite mit Strg+F5 neu laden –
        besteht das Problem weiter, wende dich an die FIB-Administration.
    </MudAlert>
}
@* relative: the mention picker is placed at the caret, in coordinates JS measures against this wrapper *@
<div style="position:relative;">
    <div @ref="_element" class="noose-rte"></div>
    @if (_mentionsOpen && _candidates.Count > 0)
    {
        <MentionPicker Candidates="_candidates" ActiveIndex="_active" OnPick="InsertMentionAsync"
                       Style="@($"position:absolute;z-index:10;min-width:280px;max-width:420px;top:{_mentionTop}px;left:{_mentionLeft}px;")" />
    }
</div>
@if (_draftFound is { } draftZeit)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
            <MudText Typo="Typo.body2">
                Nicht gespeicherter Entwurf vom @DateTimeOffset.FromUnixTimeMilliseconds(draftZeit).ToLocalTime().ToString("g") gefunden.
            </MudText>
            <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" OnClick="RestoreDraftAsync">Wiederherstellen</MudButton>
            <MudButton Size="Size.Small" Color="Color.Default" OnClick="DiscardDraftAsync">Verwerfen</MudButton>
        </MudStack>
    </MudAlert>
}
@if (!Compact && _ready)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-1 flex-wrap">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            @_wordCount.ToString("N0") Wörter · @_charCount.ToString("N0") Zeichen
        </MudText>
        @if (_headings.Count > 0)
        {
            <MudMenu Label="@($"Gliederung ({_headings.Count})")" Variant="Variant.Text" Size="Size.Small"
                     StartIcon="@Icons.Material.Filled.Toc">
                @for (var i = 0; i < _headings.Count; i++)
                {
                    var idx = i;
                    var entry = _headings[i];
                    <MudMenuItem OnClick="@(() => JumpAsync(idx))" Style="@($"padding-left:{8 + (entry.Level - 1) * 14}px;")">
                        @entry.Text
                    </MudMenuItem>
                }
            </MudMenu>
        }
        @if (_draftSavedAt is { } draftZeit)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Entwurf gesichert @draftZeit.ToString("HH:mm")
            </MudText>
        }
    </MudStack>
}
@if (_aiBusy)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-1" />
}
else if (_lastCost is { } cost)
{
    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
        FIBI · letzte Aktion: @cost.ToString("N0") Token
        @if (_lastDiscarded)
        {
            @* discarding does not refund, so say why the counter moved without the text changing *@
            <text> (verworfen)</text>
        }
        @if (_lastQuota is { } quota)
        {
            <text> · Restkontingent: @quota.Remaining.ToString("N0")</text>
        }
    </MudText>
}

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Leaner toolbar and no status bar; for narrow surfaces like the applicant chat.</summary>
    [Parameter] public bool Compact { get; set; }

    /// <summary>Scope for the browser-local draft, e.g. "document:{id}"; null switches recovery off.</summary>
    /// <remarks>The component prefixes the agent id, so two agents on one device never see each other's drafts.</remarks>
    [Parameter] public string? DraftKey { get; set; }

    /// <summary>Optional CSS min-height for the editor area (e.g. "360px"); default keeps Quill's own height.</summary>
    [Parameter] public string? MinHeight { get; set; }

    /// <summary>Enables the NOOSEI toolbar tools and tells the assistant what kind of text this is.
    /// Null keeps them hidden — opt-in on purpose, so a new editor surface is never exposed by accident.</summary>
    [Parameter] public TextAssistContext? Ai { get; set; }

    /// <summary>One-line subject appended to the compose prompt, e.g. the record's title.</summary>
    [Parameter] public string? AiSubject { get; set; }

    /// <summary>Enables the @-mention picker. Opt-in like <see cref="Ai"/>: an applicant-visible editor must
    /// never offer it, or internal record names surface in the applicant portal.</summary>
    [Parameter] public bool Mentions { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<RichTextEditor>? _ref;
    private bool _ready;
    private bool _loadError;
    private bool _disposed;
    private bool _aiBusy;
    private long? _lastCost;
    private LlmQuotaStatus? _lastQuota;
    private bool _lastDiscarded;

    /// <summary>Records what a generation cost the moment it returns, not when it is accepted.</summary>
    /// <remarks>Discarding, pressing Escape or generating a second time all spend the quota just the same. Booking
    /// only on "übernehmen" left the counter showing an older, accepted turn — a number that was simply wrong.</remarks>
    private void RecordSpend(TextAssistResult result)
    {
        _lastCost = result.QuotaTokens;
        _lastQuota = result.Quota;
        _lastDiscarded = true;
    }
    private ClaimsPrincipal? _user;

    private bool AiEnabled =>
        Ai is not null && TextAssist.IsAvailable && _user is { } u
        && !u.IsPartner() && !u.IsDemo() && u.MayWrite();

    // partners post plain text: the picker is unscoped, same rule as MentionInput
    private bool MentionsEnabled => Mentions && _user is { } u && !u.IsPartner();

    private bool _mentionsOpen;
    private int _active;
    private int _mentionStart;
    private int _mentionLength;
    private int _mentionTop;
    private int _mentionLeft;
    private List<MentionHit> _candidates = new();

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            _user = (await AuthStateTask).User;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }
        try
        {
            // ?v= cache-buster: bump it on every richtext.js change (dynamic imports bypass asset fingerprinting)
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/richtext.js?v=22");
            _ref = DotNetObjectReference.Create(this);
            // the editor types a caption line; the stored row carries figure/figcaption
            Value = RichTextFigure.ToEditor(Value);
            await _module.InvokeVoidAsync("initRichText", _element, _ref, Value ?? string.Empty, MinHeight,
                AiEnabled, MentionsEnabled, await LabelsAsync(Value), Compact, DraftScope, HtmlCleanup.Profile,
                await SnippetsAsync());
            _ready = true;
            Analyze(Value);
        }
        catch (JSDisconnectedException)
        {
            /* ignore */
        }
        catch (Exception ex)
        {
            // never let OnAfterRenderAsync kill the circuit
            Logger.LogWarning(ex, "WYSIWYG-Editor konnte nicht initialisiert werden (JS-Interop).");
            _loadError = true;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnHtmlChanged(string html)
    {
        Value = html;
        Analyze(html);
        // JSInvokable does not re-render on its own; without this the counters freeze
        StateHasChanged();
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(html);
        }
    }

    private bool _imageDialogOpen;

    /// <summary>Builds the table of contents from the headings the editor reported; the ids come from save.</summary>
    [JSInvokable]
    public Task<string> OnTocRequested(List<TocEntry> entries)
        => Task.FromResult(RichTextAnchors.BuildToc(entries ?? []));

    /// <summary>Name and preview of the agent's own snippets; the menu filters on them client-side.</summary>
    /// <remarks>
    /// Handed over once at start, like the sanitizer lists: the slash menu is deliberately a client-side table,
    /// and a round trip per keystroke would put the network on the typing path. Only picking one asks .NET.
    /// </remarks>
    private async Task<List<SnippetEntry>> SnippetsAsync()
    {
        if (Compact || _user is null)
        {
            return [];
        }
        try
        {
            var mine = await Snippets.GetMineAsync(_user);
            return mine.Select(s => new SnippetEntry(s.Id, s.Name, SnippetTrigger.Preview(s.Text))).ToList();
        }
        catch (Exception)
        {
            // the editor is worth more than the convenience
            return [];
        }
    }

    /// <summary>The picked snippet, placeholders resolved and turned into paragraphs.</summary>
    [JSInvokable]
    public async Task<string> OnSnippetRequested(string id)
    {
        if (_user is null || string.IsNullOrWhiteSpace(id))
        {
            return string.Empty;
        }
        var snippet = (await Snippets.GetMineAsync(_user)).FirstOrDefault(s => s.Id == id);
        if (snippet is null)
        {
            return string.Empty;
        }
        // no record context here: this editor never learns which record it sits on, so {{Name}} stays raw
        var text = await Placeholders.ApplyPlainAsync(snippet.Text, null, null, _user);
        return HtmlCleanup.FromPlain(text);
    }

    /// <param name="Vorschau">German on purpose: the JS side reads this field by name.</param>
    public sealed record SnippetEntry(string Id, string Name, string Vorschau);

    /// <summary>Opens the picture format dialog after a click on an image; JS reports the current values.</summary>
    [JSInvokable]
    public async Task OnImageClicked(int index, string alt, string width, string alignment, string caption)
    {
        if (_imageDialogOpen || _module is null)
        {
            return;
        }
        _imageDialogOpen = true;
        try
        {
            var parameters = new DialogParameters<ImageFormatDialog>
            {
                { x => x.Alt, alt },
                { x => x.Width, width },
                { x => x.Alignment, alignment },
                { x => x.Caption, caption },
            };
            var dialog = await Dialogs.ShowAsync<ImageFormatDialog>("Bild formatieren", parameters);
            var result = await dialog.Result;
            if (result is { Canceled: false, Data: ImageFormatResult format })
            {
                await _module.InvokeVoidAsync("setBildOptionen", _element, index, format);
            }
        }
        catch (JSDisconnectedException)
        {
            /* ignore */
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "WYSIWYG-Editor: Bild-Dialog fehlgeschlagen (JS-Interop).");
        }
        finally
        {
            _imageDialogOpen = false;
        }
    }

    private sealed record Heading(int Level, string Text);

    private static readonly Regex HeadingRegex = new("<h([1-3])\\b[^>]*>(.*?)</h\\1>",
        RegexOptions.IgnoreCase | RegexOptions.Singleline | RegexOptions.Compiled);

    private int _wordCount;
    private int _charCount;
    private List<Heading> _headings = new();

    /// <summary>Feeds the status bar: word and character count plus the heading outline.</summary>
    private void Analyze(string? html)
    {
        var source = html ?? string.Empty;
        var text = HtmlCleanup.PlainText(source);
        _charCount = text.Length;
        _wordCount = text.Length == 0 ? 0 : text.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;
        var headings = new List<Heading>();
        foreach (Match match in HeadingRegex.Matches(source))
        {
            var label = HtmlCleanup.PlainText(match.Groups[2].Value);
            if (label.Length > 0)
            {
                headings.Add(new Heading(int.Parse(match.Groups[1].Value), label));
            }
        }
        _headings = headings;
    }

    /// <summary>Moves the caret to the nth heading and scrolls it into view.</summary>
    private async Task JumpAsync(int index)
    {
        if (_module is null)
        {
            return;
        }
        try
        {
            await _module.InvokeVoidAsync("springeZuUeberschrift", _element, index);
        }
        catch (JSDisconnectedException)
        {
            /* ignore */
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "WYSIWYG-Editor: Sprung zur Überschrift fehlgeschlagen (JS-Interop).");
        }
    }

    private long? _draftFound;

    /// <summary>Agent-bound draft scope; without one the browser keeps nothing.</summary>
    // nobody who cannot save keeps a draft: it would be offered on every visit and never go away
    private string? DraftScope =>
        !Compact && !string.IsNullOrWhiteSpace(DraftKey) && _user is { } user && user.MayContribute()
            && user.GetAgentId() is { Length: > 0 } me
            ? me + ":" + DraftKey
            : null;

    /// <summary>Drops a draft by key, for a caller that stores the row AFTER the editor is gone.</summary>
    /// <remarks>
    /// A dialog closes on Save and its caller persists afterwards, so <see cref="MarkSavedAsync"/> is unreachable
    /// at the only moment it would be correct. Calling it inside the dialog instead would delete the draft even
    /// when the write then fails — the one case the draft exists for. Call this after the write succeeded.
    /// Failures are swallowed: a lingering draft is a nuisance, a broken save path is not.
    /// </remarks>
    public static async Task DiscardDraftAsync(IJSRuntime js, string? agentId, string? draftKey)
    {
        if (string.IsNullOrWhiteSpace(agentId) || string.IsNullOrWhiteSpace(draftKey))
        {
            return;
        }
        try
        {
            await using var module = await js.InvokeAsync<IJSObjectReference>("import", "./js/richtext.js?v=22");
            await module.InvokeVoidAsync("entwurfVerwerfenNachSchluessel", agentId + ":" + draftKey);
        }
        catch (JSDisconnectedException)
        {
            /* ignore */
        }
        catch (Exception)
        {
            /* best effort */
        }
    }

    /// <summary>Called from JS when a browser-local draft for this field exists, and with 0 once typing answered it.</summary>
    [JSInvokable]
    public Task OnDraftFound(long zeit)
    {
        if (_disposed || DraftScope is null)
        {
            return Task.CompletedTask;
        }
        _draftFound = zeit > 0 ? zeit : null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private DateTime? _draftSavedAt;

    /// <summary>Called from JS after the draft was written (0 when it was dropped again).</summary>
    [JSInvokable]
    public Task OnDraftSaved(long zeit)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }
        _draftSavedAt = zeit > 0 ? DateTimeOffset.FromUnixTimeMilliseconds(zeit).LocalDateTime : null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Wired by pages that have a save button; Ctrl+S calls it.</summary>
    [Parameter]
    public EventCallback OnSaveRequested { get; set; }

    /// <summary>Ctrl+S in the editor; the page decides what saving means.</summary>
    [JSInvokable]
    public Task OnSaveShortcut() => OnSaveRequested.HasDelegate ? OnSaveRequested.InvokeAsync() : Task.CompletedTask;

    private async Task RestoreDraftAsync()
    {
        _draftFound = null;
        if (_module is null)
        {
            return;
        }
        try
        {
            var fresh = await _module.InvokeAsync<string?>("entwurfAnwenden", _element);
            if (fresh is not null)
            {
                Value = fresh;
                if (ValueChanged.HasDelegate)
                {
                    await ValueChanged.InvokeAsync(fresh);
                }
            }
        }
        catch (JSDisconnectedException) { /* ignore */ }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "WYSIWYG-Editor: Entwurf konnte nicht wiederhergestellt werden (JS-Interop).");
        }
    }

    private async Task DiscardDraftAsync()
    {
        _draftFound = null;
        if (_module is null)
        {
            return;
        }
        try
        {
            await _module.InvokeVoidAsync("entwurfVerwerfen", _element);
        }
        catch (JSDisconnectedException) { /* ignore */ }
        catch (Exception)
        {
            /* best effort */
        }
    }

    /// <summary>Call after a successful save so the browser drops the draft; safe to call always.</summary>
    public async Task MarkSavedAsync()
    {
        _draftFound = null;
        _draftSavedAt = null;
        StateHasChanged();
        if (_module is null || !_ready)
        {
            return;
        }
        try
        {
            await _module.InvokeVoidAsync("entwurfAlsGespeichertMarkieren", _element);
        }
        catch (JSDisconnectedException) { /* ignore */ }
        catch (Exception)
        {
            /* best effort */
        }
    }

    /// <summary>Chip labels for the tokens in <paramref name="html"/>; a token the viewer may not resolve is left out
    /// on purpose, so it stays literal text in the editor instead of gaining a name it should not carry.</summary>
    private async Task<IReadOnlyDictionary<string, string>> LabelsAsync(string? html)
    {
        if (!MentionsEnabled || _user is null)
        {
            return new Dictionary<string, string>();
        }
        return await MentionService.HtmlLabelsAsync(html, _user.MayClassifiedRead(), _user.GetAgentId());
    }

    [JSInvokable]
    public async Task OnMentionQuery(string? query, int start, int length, int top, int left)
    {
        if (_disposed || !MentionsEnabled || _user is null)
        {
            return;
        }
        if (string.IsNullOrEmpty(query))
        {
            await CloseMentionsAsync();
            return;
        }
        _candidates = await MentionService.CandidatesAsync(query, _user);
        _mentionStart = start;
        _mentionLength = length;
        _mentionTop = top;
        _mentionLeft = left;
        _active = 0;
        await SetMentionsOpenAsync(_candidates.Count > 0);
    }

    [JSInvokable]
    public async Task OnMentionKey(string key)
    {
        if (_disposed || !_mentionsOpen || _candidates.Count == 0)
        {
            return;
        }
        switch (key)
        {
            case "ArrowDown":
                _active = (_active + 1) % _candidates.Count;
                break;
            case "ArrowUp":
                _active = (_active - 1 + _candidates.Count) % _candidates.Count;
                break;
            case "Enter":
            case "Tab":
                await InsertMentionAsync(_candidates[_active]);
                return;
            default:
                await CloseMentionsAsync();
                return;
        }
        StateHasChanged();
    }

    private async Task InsertMentionAsync(MentionHit hit)
    {
        var token = MentionParser.Token(hit.Type, hit.Id);
        await SetMentionsOpenAsync(false);
        if (_module is null)
        {
            return;
        }
        try
        {
            // the token, not the display name, is what gets stored — the chip is only what the writer sees
            var fresh = await _module.InvokeAsync<string?>("erwaehnungEinfuegen", _element,
                _mentionStart, _mentionLength, $"{hit.Type}:{hit.Id}", hit.Display);
            if (fresh is null)
            {
                return;
            }
            Value = fresh;
            if (ValueChanged.HasDelegate)
            {
                await ValueChanged.InvokeAsync(fresh);
            }
        }
        catch (JSDisconnectedException) { /* ignore */ }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "WYSIWYG-Editor: Erwähnung konnte nicht eingefügt werden (JS-Interop). Token: {Token}", token);
        }
    }

    private Task CloseMentionsAsync() => SetMentionsOpenAsync(false);

    private async Task SetMentionsOpenAsync(bool open)
    {
        var changed = _mentionsOpen != open;
        _mentionsOpen = open;
        if (!open)
        {
            _candidates = new();
            _active = 0;
        }
        if (changed && _module is not null)
        {
            // the editor only claims the arrow keys while the picker is up
            try
            {
                await _module.InvokeVoidAsync("setzeErwaehnungOffen", _element, open);
            }
            catch (JSDisconnectedException) { /* ignore */ }
            catch (Exception) { /* best effort */ }
        }
        StateHasChanged();
    }

    [JSInvokable]
    public Task OnAiTooLarge()
    {
        Snackbar.Add("Der Text ist zu groß für FIBI. Markiere den Abschnitt, den FIBI bearbeiten soll.", Severity.Warning);
        return ClearBusyAsync();
    }

    [JSInvokable]
    public async Task OnAiRequested(string mode, string html, int index, int length, int docLength)
    {
        if (_disposed || _user is null || Ai is null)
        {
            await ClearBusyAsync();
            return;
        }

        _aiBusy = true;
        StateHasChanged();
        try
        {
            var request = new NooseiRequest(
                mode == "schreiben" ? NooseiMode.Compose : NooseiMode.Correct,
                html,
                Ai.Value,
                _user,
                HasSelection: index >= 0,
                Subject: AiSubject,
                SurroundingText: mode == "schreiben" ? html : null);

            var choice = await NooseiDialog.ShowAsync(Dialogs, request,
                EventCallback.Factory.Create<TextAssistResult>(this, RecordSpend));
            if (choice is null || _disposed || _module is null)
            {
                return;
            }

            // compose without replacing keeps the selection: insert at its end instead of overwriting it
            var target = choice.InsertAtCaret && index >= 0 ? index + length : index;
            var replace = choice.InsertAtCaret ? 0 : length;

            var fresh = await _module.InvokeAsync<string?>(
                "applyAiResult", _element, target, replace, choice.Html, docLength);
            if (fresh is null)
            {
                Snackbar.Add("Der Text wurde zwischenzeitlich geändert – FIBI-Ergebnis nicht übernommen.", Severity.Warning);
                return;
            }
            // only here is the text really in the document; accepting it and losing it to a concurrent edit
            // are the same outcome for the reader, and both still cost the same tokens
            _lastDiscarded = false;
            Value = fresh;
            if (ValueChanged.HasDelegate)
            {
                await ValueChanged.InvokeAsync(fresh);
            }
        }
        catch (JSDisconnectedException) { /* ignore */ }
        catch (ObjectDisposedException) { /* ignore */ }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "FIBI: Aktion im Editor fehlgeschlagen.");
            Snackbar.Add(NooseiErrors.Describe(ex), Severity.Error);
        }
        finally
        {
            await ClearBusyAsync();
        }
    }

    private async Task ClearBusyAsync()
    {
        _aiBusy = false;
        try
        {
            if (!_disposed && _module is not null)
            {
                await _module.InvokeVoidAsync("setAiBusy", _element, false);
            }
        }
        catch (JSDisconnectedException) { /* ignore */ }
        catch (Exception) { /* best effort */ }
        StateHasChanged();
    }

    /// <summary>Sets the editor content; no-op on JS errors.</summary>
    public async Task SetHtmlAsync(string html)
    {
        if (_module is null || !_ready)
        {
            return;
        }
        try
        {
            var editorHtml = RichTextFigure.ToEditor(html);
            await _module.InvokeVoidAsync("setHtml", _element, editorHtml, await LabelsAsync(editorHtml));
            Value = editorHtml;
            Analyze(Value);
        }
        catch (JSDisconnectedException)
        {
            /* ignore */
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "WYSIWYG-Editor: SetHtml fehlgeschlagen (JS-Interop).");
        }
    }

    /// <summary>Reads the current HTML fresh from the editor; falls back to last known value on JS errors.</summary>
    public async Task<string> GetHtmlAsync()
    {
        if (_module is not null && _ready)
        {
            try
            {
                Value = await _module.InvokeAsync<string>("getHtml", _element);
            }
            catch (JSDisconnectedException)
            {
                /* ignore */
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "WYSIWYG-Editor: GetHtml fehlgeschlagen (JS-Interop) – letzter bekannter Stand wird verwendet.");
            }
        }
        return Value ?? string.Empty;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("destroyRichText", _element);
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            /* ignore */
        }
        catch (Exception)
        {
            /* best effort */
        }
        _ref?.Dispose();
    }
}
