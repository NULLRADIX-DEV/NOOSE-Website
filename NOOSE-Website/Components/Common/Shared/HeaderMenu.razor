@* The ⋮ menu of a page header below 960px: the secondary actions the wide header shows as buttons, as menu entries.
   Hidden from 960px up (noose-nur-schmal), where those buttons stand in the row themselves.
   An interactive page gets a MudMenu, already during prerender, so the first paint shows the same button the circuit
   later drives. A statically rendered page (no render mode, [ExcludeFromInteractiveRouting]) has no circuit to open a
   MudMenu, so it gets a native <details>/<summary> that opens without any script. *@

@if (AssignedRenderMode is not null)
{
    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Default" AriaLabel="Weitere Aktionen"
             Class="noose-nur-schmal noose-kopfmenue-knopf" Dense="true"
             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
        @ChildContent
    </MudMenu>
}
else
{
    <details class="noose-nur-schmal noose-kopfmenue">
        <summary aria-label="Weitere Aktionen" title="Weitere Aktionen">⋮</summary>
        <div class="noose-kopfmenue-liste mud-paper mud-elevation-8">
            @ChildContent
        </div>
    </details>
}

@code {
    /// <summary>The menu entries: <c>MudMenuItem</c>s, the header buttons with <c>AsMenuItem</c>, dividers.</summary>
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
}
