<MudDialog>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(Text))
        {
            <MudText Typo="Typo.body2" Class="mb-3">@Text</MudText>
        }
        @if (Mentions)
        {
            <MentionInput @bind-Text="_reason" Label="@Label" Lines="2" HelperText="@MentionInput.Hint"
                          AutoFocus="true" Required="@MandatoryReason"
                          RequiredError="Bitte eine Begründung angeben." />
        }
        else
        {
            <MudTextField @bind-Value="_reason" Label="@Label" Lines="@Lines" Variant="Variant.Outlined"
                          AutoFocus="true" Immediate="true" MaxLength="@(MaxLength ?? 524288)" Counter="@MaxLength"
                          Required="@MandatoryReason" RequiredError="Bitte eine Begründung angeben." />
        }
        @if (_error)
        {
            <MudText Typo="Typo.caption" Color="Color.Error">Bitte eine Begründung angeben.</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Color="@Colour" Variant="Variant.Filled" OnClick="Confirm">@ConfirmText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Title { get; set; } = "Bestätigen";
    [Parameter] public string? Text { get; set; }
    [Parameter] public string Label { get; set; } = "Begründung";
    [Parameter] public string ConfirmText { get; set; } = "Bestätigen";
    [Parameter] public bool MandatoryReason { get; set; }
    [Parameter] public Color Colour { get; set; } = Color.Primary;

    /// <summary>Opt-in @-picker; off where the text is shown to the person being acted on (e.g. a block reason).</summary>
    [Parameter] public bool Mentions { get; set; }

    /// <summary>Starting value. What makes this usable for editing something that already has one — renaming with an
    /// empty box invites overwriting a title the owner only wanted to correct.</summary>
    [Parameter] public string? Preset { get; set; }

    /// <summary>One line for a name, two for a reason.</summary>
    [Parameter] public int Lines { get; set; } = 2;

    /// <summary>Cap matching the service, so a long reason is not typed for nothing.</summary>
    [Parameter] public int? MaxLength { get; set; }

    private string _reason = string.Empty;
    private bool _error;

    protected override void OnInitialized() => _reason = Preset ?? string.Empty;

    private void Confirm()
    {
        if (MandatoryReason && string.IsNullOrWhiteSpace(_reason))
        {
            _error = true;
            return;
        }
        MudDialog.Close(DialogResult.Ok(_reason.Trim()));
    }

    private void Cancel() => MudDialog.Cancel();

    /// <summary>Shows the dialog; returns the reason or null on cancel.</summary>
    public static async Task<string?> ShowAsync(IDialogService dialog, string title, string? text,
        string confirmText = "Bestätigen", string label = "Begründung", bool mandatoryReason = false,
        Color colour = Color.Primary, bool mentions = false, string? preset = null, int lines = 2, int? maxLength = null)
    {
        var parameters = new DialogParameters<ReasonDialog>
        {
            { x => x.Title, title },
            { x => x.Text, text },
            { x => x.Label, label },
            { x => x.ConfirmText, confirmText },
            { x => x.MandatoryReason, mandatoryReason },
            { x => x.Colour, colour },
            { x => x.Mentions, mentions },
            { x => x.Preset, preset },
            { x => x.Lines, lines },
            { x => x.MaxLength, maxLength },
        };
        var reference = await dialog.ShowAsync<ReasonDialog>(title, parameters);
        var result = await reference.Result;
        return result is { Canceled: false, Data: string reason } ? reason : null;
    }
}
