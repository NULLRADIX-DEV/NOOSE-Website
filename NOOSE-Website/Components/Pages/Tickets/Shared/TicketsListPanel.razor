@using NOOSE_Website.Models.Navigation
@inject ITicketService Tickets
@inject TicketBroadcaster Broadcaster
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@implements IDisposable

<MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-4 noose-filterleiste">
    <MudTextField T="string" @bind-Value="_search" Label="Suche" Placeholder="Aktenzeichen, Betreff oder Name"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search" DebounceInterval="300"
                  OnDebounceIntervalElapsed="ReloadAsync" Style="max-width:340px;" Class="noose-filter-feld" />
    @* phones: the filters fold behind "Filter (n)"; from 600px up the button is gone and they stand as before *@
    <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.FilterList"
               Class="noose-nur-handy" OnClick="@(() => _filtersOpen = !_filtersOpen)">Filter (@ActiveFilters)</MudButton>
    <MobileColumnPicker ListKey="tickets" Columns="PhoneColumns" Defaults="PhoneDefaults"
                        VisibleChanged="@(v => _phoneColumns = v)" />
    <div class="@($"d-contents{(_filtersOpen ? "" : " noose-filter-zu")}")">
        <MudSelect T="TicketKategorie?" @bind-Value="_category" Label="Kategorie" Clearable="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:220px;" Class="noose-filter-feld"
                   ToStringFunc="@(c => c is { } v ? TicketKategorieDisplay.Name(v) : "Alle")"
                   @bind-Value:after="ReloadAsync">
            @foreach (var option in TicketKategorieDisplay.All)
            {
                <MudSelectItem T="TicketKategorie?" Value="@option">@TicketKategorieDisplay.Name(option)</MudSelectItem>
            }
        </MudSelect>
        <MudSwitch T="bool" @bind-Value="_onlyMine" Color="Color.Primary" Label="Nur meine"
                   @bind-Value:after="ReloadAsync" />
        <MudSwitch T="bool" @bind-Value="_byPriority" Color="Color.Primary" Label="Nach Priorität"
                   @bind-Value:after="ReloadAsync" />
    </div>
</MudStack>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_rows.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Filled.Forum" Title="Keine Tickets"
                Text="In dieser Ansicht liegt derzeit nichts vor." />
}
else
{
    @* Breakpoint.None: a table at every width; a phone shows the columns the agent picked instead of stacking nine
       columns into cards *@
    <MudTable Items="_rows" Hover="true" Dense="true" Style="cursor:pointer;" Breakpoint="Breakpoint.None"
              OnRowClick="@((TableRowClickEventArgs<TicketRow> e) => Open(e.Item))">
        <HeaderContent>
            <MudTh Class="@Col("aktenzeichen")">Aktenzeichen</MudTh>
            <MudTh Class="@Col("betreff")">Betreff</MudTh>
            <MudTh Class="@Col("buerger")">Bürger</MudTh>
            <MudTh Class="@Col("kategorie")">Kategorie</MudTh>
            <MudTh Class="@Col("status")">Status</MudTh>
            <MudTh Class="@Col("bearbeiter")">Bearbeiter</MudTh>
            <MudTh Class="@Col("prioritaet")">Priorität</MudTh>
            <MudTh Class="@Col("wartet")">Wartet seit</MudTh>
            <MudTh Class="@Col("aktivitaet")">Letzte Aktivität</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Aktenzeichen" Class="@Col("aktenzeichen")">
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    @context.CaseNumber
                    @if (context.AwaitingAnswer)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.MarkEmailUnread" Size="Size.Small" Color="Color.Warning" />
                    }
                    @if (context.UnreadCount > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning">
                            @context.UnreadCount neu
                        </MudChip>
                    }
                </MudStack>
            </MudTd>
            <MudTd DataLabel="Betreff" Class="@Col("betreff")">@context.Subject</MudTd>
            <MudTd DataLabel="Bürger" Class="@Col("buerger")">@context.CitizenName</MudTd>
            <MudTd DataLabel="Kategorie" Class="@Col("kategorie")">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">
                    @TicketKategorieDisplay.Name(context.Category)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Status" Class="@Col("status")">
                <MudChip T="string" Size="Size.Small" Color="@StatusColour(context.Status)">
                    @TicketStatusDisplay.Name(context.Status)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Bearbeiter" Class="@Col("bearbeiter")">@(string.IsNullOrWhiteSpace(context.HandlerCodename) ? "—" : context.HandlerCodename)</MudTd>
            <MudTd DataLabel="Priorität" Class="@Col("prioritaet")">
                <MudTooltip Text="@(context.PriorityIsManual
                                    ? "Von Hand gesetzt; die automatische Reihenfolge greift hier nicht."
                                    : "Automatisch aus Kategorie, Wartezeit und Vertrauen des Kontos.")">
                    <MudChip T="string" Size="Size.Small"
                             Variant="@(context.PriorityIsManual ? Variant.Filled : Variant.Outlined)"
                             Color="@PriorityColour(context.Priority)">
                        @context.Priority
                    </MudChip>
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="Wartet seit" Class="@Col("wartet")">
                @{
                    var reaction = TicketRules.Reaction(context.Status, context.WaitingSince, DateTime.UtcNow);
                }
                @if (reaction == TicketReaction.Keine)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">—</MudText>
                }
                else
                {
                    <MudTooltip Text="@($"Unbeantwortet seit {context.WaitingSince!.Value.ToLocalTime():dd.MM.yyyy HH:mm}")">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                 Color="@ReactionColour(reaction)">
                            @TicketReactionDisplay.Name(reaction) · @Waited(context.WaitingSince!.Value)
                        </MudChip>
                    </MudTooltip>
                }
            </MudTd>
            <MudTd DataLabel="Letzte Aktivität" Class="@Col("aktivitaet")">@context.LastActivityAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Parameter]
    [EditorRequired]
    public TicketInboxScope Scope { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private ClaimsPrincipal _user = default!;
    private IReadOnlyList<TicketRow> _rows = Array.Empty<TicketRow>();
    private string? _search;
    private TicketKategorie? _category;
    private bool _onlyMine;
    private bool _byPriority;
    private bool _load = true;
    private bool _filtersOpen;

    private int ActiveFilters => (_category is null ? 0 : 1) + (_onlyMine ? 1 : 0) + (_byPriority ? 1 : 0);

    /// <summary>The table's columns for the phone column picker, in table order.</summary>
    private static readonly IReadOnlyList<(string Key, string Label)> PhoneColumns =
    [
        ("aktenzeichen", "Aktenzeichen"), ("betreff", "Betreff"), ("buerger", "Bürger"), ("kategorie", "Kategorie"),
        ("status", "Status"), ("bearbeiter", "Bearbeiter"), ("prioritaet", "Priorität"), ("wartet", "Wartet seit"),
        ("aktivitaet", "Letzte Aktivität"),
    ];

    /// <summary>What a phone shows until the agent chooses: the subject and the status.</summary>
    private static readonly IReadOnlyList<string> PhoneDefaults = ["betreff", "status"];

    private IReadOnlySet<string> _phoneColumns = MobileColumnSet.Resolve(PhoneColumns.Select(c => c.Key).ToList(), PhoneDefaults, null);

    // below 600px only; from 600px up every column shows, as before
    private string Col(string key) => MobileColumnSet.ClassFor(_phoneColumns, key);

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        Broadcaster.Modified += OnModified;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _load = true;
        try
        {
            _rows = await Tickets.GetInboxAsync(Scope, _search, _onlyMine, _user, _category, _byPriority);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _load = false;
        }
    }

    private void Open(TicketRow? row)
    {
        if (row is not null)
        {
            Nav.NavigateTo($"/tickets/{row.Id}");
        }
    }

    private void OnModified(string ticketId, string caseNumber, TicketMessageAudience? audience)
        => InvokeAsync(async () => { await ReloadAsync(); StateHasChanged(); });

    public void Dispose() => Broadcaster.Modified -= OnModified;

    /// <summary>Bands of the computed range, so the colour means the same thing on every tab.</summary>
    private static Color PriorityColour(int priority) => priority switch
    {
        >= 60 => Color.Error,
        >= 30 => Color.Warning,
        >= 12 => Color.Info,
        _ => Color.Default,
    };

    private static Color ReactionColour(TicketReaction reaction) => reaction switch
    {
        TicketReaction.Ueberfaellig => Color.Error,
        TicketReaction.Faellig => Color.Warning,
        TicketReaction.Frisch => Color.Info,
        _ => Color.Default,
    };

    /// <summary>Coarse age of an unanswered line: minutes, then hours, then days.</summary>
    private static string Waited(DateTime sinceUtc)
    {
        var waited = DateTime.UtcNow - sinceUtc;
        if (waited < TimeSpan.FromHours(1))
        {
            return $"{Math.Max(1, (int)waited.TotalMinutes)} min";
        }
        return waited < TimeSpan.FromDays(1) ? $"{(int)waited.TotalHours} h" : $"{(int)waited.TotalDays} d";
    }

    private static Color StatusColour(TicketStatus status) => status switch
    {
        TicketStatus.Offen => Color.Info,
        TicketStatus.InBearbeitung => Color.Primary,
        TicketStatus.WartetAufBuerger => Color.Warning,
        TicketStatus.Geschlossen => Color.Default,
        _ => Color.Default,
    };
}
