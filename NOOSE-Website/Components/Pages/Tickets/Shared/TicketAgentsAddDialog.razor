@* Picks several agents for one ticket at once, singly or by direction (CID, CTD, HRT, Administration Division). *@
@inject IAgentManagementService AgentService

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3" Style="min-width:420px;" Class="noose-min-breite-frei">
            <MudAutocomplete T="Agent" @ref="_auto" Label="Agent suchen" Value="_selected" AutoFocus="true"
                             ValueChanged="PickAsync" SearchFunc="@SearchAgents"
                             ToStringFunc="@(a => a is null ? string.Empty : a.Codename)"
                             Variant="Variant.Outlined" Clearable="true" CoerceText="false" CoerceValue="false"
                             ResetValueOnEmptyText="true" MinCharacters="0" Immediate="true"
                             Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.ManageAccounts"
                             HelperText="Mehrfach wählbar: jeder Treffer wandert in die Liste unten.">
                <ItemTemplate Context="a">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@(a.PartnerAgency is null ? Icons.Material.Filled.Person : Icons.Material.Filled.Handshake)"
                                 Size="Size.Small" Color="@(a.PartnerAgency is null ? Color.Primary : Color.Info)" />
                        <MudText Typo="Typo.body2">@a.Codename</MudText>
                        @if (MayRealName && !string.IsNullOrWhiteSpace(a.RealName))
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">(@a.RealName)</MudText>
                        }
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@(a.PartnerAgency is { } ag ? PartnerRankDisplay.Full(ag, a.PartnerRank) : DivisionRules.RankName(a))</MudText>
                        @if (Direction(a) is { } unit)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary">@unit</MudChip>
                        }
                    </MudStack>
                </ItemTemplate>
            </MudAutocomplete>

            <MudStack Spacing="1">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Ganze Direktion übernehmen</MudText>
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                    @foreach (var division in DivisionDisplay.All)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.Groups" Disabled="@(DivisionOpen(division).Count == 0)"
                                   OnClick="@(() => PickMany(DivisionOpen(division)))">@DivisionDisplay.Short(division) (@DivisionOpen(division).Count)</MudButton>
                    }
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Groups" Disabled="@(AdministrationOpen.Count == 0)"
                               OnClick="@(() => PickMany(AdministrationOpen))">@DepartmentRules.ColumnLabel (@AdministrationOpen.Count)</MudButton>
                </MudStack>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Die Zahl ist der Stand von jetzt: beteiligt werden die Agents, die gerade in der Direktion sind.
                </MudText>
            </MudStack>

            <MudDivider />

            @if (_picked.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Noch niemand gewählt.</MudText>
            }
            else
            {
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                    @foreach (var a in _picked)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                 Icon="@Icons.Material.Filled.Person" OnClose="@(() => Drop(a))">@a.Codename</MudChip>
                    }
                </MudStack>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@(_picked.Count == 0)">
            @(_picked.Count <= 1 ? "Beteiligen" : $"{_picked.Count} beteiligen")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Agents already on the ticket; they are neither offered nor counted into a direction.</summary>
    [Parameter] public IReadOnlyList<string> ExclusionAgentIds { get; set; } = Array.Empty<string>();

    /// <summary>Only real-name viewers may search/see it, else search would leak the secret field.</summary>
    [Parameter] public bool MayRealName { get; set; }

    private MudAutocomplete<Agent> _auto = default!;
    private readonly List<Agent> _picked = [];
    private List<Agent> _all = [];
    private Agent? _selected;

    /// <summary>Agents seated in the division (the Board is a seat of its own) and not yet picked.</summary>
    private List<Agent> DivisionOpen(Division division) => Open(a => DivisionRules.IsMember(a, division));

    private List<Agent> AdministrationOpen => Open(a => a.IsHRB);

    protected override async Task OnInitializedAsync()
    {
        // AgentSelection decides who may be offered; the service checks the same predicate on the write
        var selectable = await AgentService.GetSelectableAsync();
        _all = selectable.Where(a => !ExclusionAgentIds.Contains(a.Id)).ToList();
    }

    private List<Agent> Open(Func<Agent, bool> unit)
        => _all.Where(unit).Where(a => _picked.All(p => p.Id != a.Id)).ToList();

    /// <summary>Division (or Board) and the Administration flag, as the buttons above group them.</summary>
    private static string? Direction(Agent a)
    {
        var unit = DivisionRules.Of(a);
        var parts = new List<string>();
        if (!unit.IsNone)
        {
            parts.Add(DivisionRules.Label(unit));
        }
        if (a.IsHRB)
        {
            parts.Add(DepartmentRules.ColumnLabel);
        }
        return parts.Count == 0 ? null : string.Join(" · ", parts);
    }

    private Task<IEnumerable<Agent>> SearchAgents(string value, CancellationToken token)
    {
        var search = value.Trim();
        var open = _all.Where(a => _picked.All(p => p.Id != a.Id));
        IEnumerable<Agent> hit = string.IsNullOrWhiteSpace(search)
            ? open
            : open.Where(a => a.Codename.Contains(search, StringComparison.OrdinalIgnoreCase)
                            || (MayRealName && (a.RealName ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase)));
        return Task.FromResult(hit);
    }

    private async Task PickAsync(Agent? agent)
    {
        // the clear below comes back through here as null; returning ends the round trip instead of looping
        if (agent is null)
        {
            _selected = null;
            return;
        }
        if (_picked.All(p => p.Id != agent.Id))
        {
            _picked.Add(agent);
        }
        _selected = null;
        // the box goes empty again, or the next name cannot be typed over the last pick
        await _auto.ClearAsync();
    }

    private void PickMany(IReadOnlyList<Agent> agents) => _picked.AddRange(agents);

    private void Drop(Agent agent) => _picked.RemoveAll(p => p.Id == agent.Id);

    private void Save() => MudDialog.Close(DialogResult.Ok(_picked.Select(a => a.Id).ToList()));

    private void Cancel() => MudDialog.Cancel();

    /// <summary>Shows the dialog; returns the chosen agent ids or null on cancel.</summary>
    public static async Task<List<string>?> ShowAsync(IDialogService dialog, IReadOnlyList<string> exclusionAgentIds,
        bool mayRealName)
    {
        var parameters = new DialogParameters<TicketAgentsAddDialog>
        {
            { x => x.ExclusionAgentIds, exclusionAgentIds },
            { x => x.MayRealName, mayRealName },
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var reference = await dialog.ShowAsync<TicketAgentsAddDialog>("Agents beteiligen", parameters, options);
        var result = await reference.Result;
        return result is { Canceled: false, Data: List<string> ids } && ids.Count > 0 ? ids : null;
    }
}
