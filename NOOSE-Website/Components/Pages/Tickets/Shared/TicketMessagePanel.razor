@inject ITicketService Tickets
@inject IPublicTemplateService Templates
@inject IMentionService MentionService
@inject ITicketAttachmentStorageService AttachmentStore
@inject ICitizenAssistService Assist
@inject TicketBroadcaster Broadcaster
@inject ISnackbar Snackbar
@implements IDisposable

@* one component, two threads. The citizen-facing rows carry no author at all, so nothing has to be hidden here *@
<MudPaper Outlined="true" Class="pa-4">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@(IsInternal ? Icons.Material.Filled.Lock : Icons.Material.Filled.Forum)"
                     Color="@(IsInternal ? Color.Warning : Color.Primary)" Size="Size.Small" />
            <MudText Typo="Typo.h6">@(IsInternal ? "Interne Notizen" : "Schriftwechsel mit dem Bürger")</MudText>
        </MudStack>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            @(IsInternal
                ? $"Nur für die Führungsebene sichtbar. {MentionInput.Hint}"
                : $"Der Bürger sieht diese Zeilen als Nachricht von „{TicketRules.AgencySender}“ — nie mit Codename.")
        </MudText>

        @if (_load)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_messages.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Noch keine Nachricht.</MudText>
        }
        else
        {
            <MudStack Spacing="2" Style="max-height:420px;overflow-y:auto;">
                @foreach (var message in _messages)
                {
                    <MudPaper Outlined="true" Class="pa-3"
                              Style="@(message.FromCitizen ? "margin-right:12%;" : "margin-left:12%;")">
                        <MudStack Spacing="1">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudText Typo="Typo.caption" Color="@(message.FromCitizen ? Color.Default : Color.Primary)">
                                    @Author(message) · @message.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </MudText>
                                @if (message.EditedAt is not null)
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">· bearbeitet</MudText>
                                }
                                @if (CanEdit(message))
                                {
                                    <MudTooltip Text="Bearbeiten">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                       Color="Color.Default" aria-label="Bearbeiten"
                                                       OnClick="@(() => BeginEdit(message))" />
                                    </MudTooltip>
                                }
                            </MudStack>
                            @if (_editingId == message.Id)
                            {
                                @* plain text on purpose: the citizen thread has no sanitizer, line breaks are the formatting *@
                                @if (IsInternal)
                                {
                                    <MentionInput @bind-Text="_editText" Lines="3" AutoFocus="true"
                                                  MaxLength="@TicketRules.MaxMessageLength" Label="Notiz" />
                                }
                                else
                                {
                                    @* plain text on purpose: the citizen thread has no sanitizer, line breaks are the formatting *@
                                    <MudTextField @bind-Value="_editText" Lines="3" Variant="Variant.Outlined"
                                                  MaxLength="@TicketRules.MaxMessageLength" AutoFocus="true"
                                                  Label="Antwort an den Bürger" />
                                }
                                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                                    <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                               OnClick="CancelEdit">Abbrechen</MudButton>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Check" OnClick="SaveEditAsync"
                                               Disabled="@(_editSaving || string.IsNullOrWhiteSpace(_editText))">
                                        Speichern
                                    </MudButton>
                                </MudStack>
                            }
                            else if (IsInternal)
                            {
                                @* tokens resolve only here; the citizen thread refuses them at the service *@
                                <MudText Typo="Typo.body2" Style="white-space:pre-wrap;" HtmlTag="div">
                                    <MentionText Segments="@SegmentsFor(message)" />
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Style="white-space:pre-wrap;">@message.Text</MudText>
                            }
                            @if (message.HasAttachment)
                            {
                                @* the desk addresses the file by row id; the citizen's own view uses its position *@
                                <MudButton Href="@($"/dateien/tickets/{message.Id}?inline=true")" Target="_blank"
                                           Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Image">
                                    @(message.AttachmentName ?? "Anhang")
                                </MudButton>
                            }
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        }

        @* a closed ticket takes no new message, but an old one of your own stays correctable *@
        @if (CanWrite && !Closed)
        {
            @if (IsInternal)
            {
                @* the @-picker only, deliberately without the pasted-image opt-in: a text image is gated through
                   RecordsReference, which resolves a ticket as classified, so a participant below the desk could
                   paste a picture they then cannot see. The attachment below is gated by TicketVisibility and is
                   the right path for a screenshot here *@
                <MentionInput @ref="_noteInput" @bind-Text="_draft" Label="Notiz" Lines="3"
                              MaxLength="@TicketRules.MaxMessageLength" DraftKey="@ComposerDraftKey" />
            }
            else
            {
                <TextDraft @ref="_replyDraft" DraftKey="@ComposerDraftKey" OnRestore="@(t => _draft = t)">
                    <MudTextField @bind-Value="_draft" Label="Antwort an den Bürger"
                                  Lines="3" Variant="Variant.Outlined" MaxLength="@TicketRules.MaxMessageLength" />
                </TextDraft>
            }
            <ImageAttachmentPicker @bind-Picked="_attachment" MaxBytes="@AttachmentStore.MaxBytes"
                                   Disabled="_busy" />
            @if (_suggestCost is { } cost)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    NOOSEI-Entwurf: @cost.ToString("N0") Token
                    @if (_suggestQuota is { } quota)
                    {
                        <text> · Restkontingent: @quota.Remaining.ToString("N0")</text>
                    }
                </MudText>
            }
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudButton OnClick="SendAsync" Disabled="_busy" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Send">
                    @(IsInternal ? "Notiz speichern" : "Senden")
                </MudButton>
                @* same rule as the template menu: it fills the field, the agent sends *@
                @if (!IsInternal && Assist.IsAvailable)
                {
                    <MudButton OnClick="SuggestAsync" Disabled="_busy" Variant="Variant.Outlined"
                               Color="Color.Secondary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.AutoAwesome">NOOSEI-Entwurf</MudButton>
                }
                @* the template only fills the field; sending stays a deliberate act *@
                @if (_templates.Count > 0)
                {
                    <MudMenu Label="Vorlage" Variant="Variant.Outlined" Size="Size.Small"
                             EndIcon="@Icons.Material.Filled.ArrowDropDown">
                        @foreach (var template in _templates)
                        {
                            <MudMenuItem OnClick="@(() => Apply(template))">@template.Title</MudMenuItem>
                        }
                    </MudMenu>
                }
            </MudStack>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    [EditorRequired]
    public string TicketId { get; set; } = string.Empty;

    [Parameter]
    [EditorRequired]
    public ClaimsPrincipal User { get; set; } = default!;

    [Parameter]
    [EditorRequired]
    public TicketMessageAudience Audience { get; set; }

    [Parameter]
    public bool CanWrite { get; set; }

    /// <summary>Closes the composer only; a handler still corrects his own lines on a finished ticket.</summary>
    [Parameter]
    public bool Closed { get; set; }

    /// <summary>Fills the AKTENZEICHEN token of a picked template.</summary>
    [Parameter]
    public string? CaseNumber { get; set; }

    /// <summary>Fills the BUERGER token and names the citizen rows; a ticket always has a name behind it.</summary>
    [Parameter]
    public string? CitizenName { get; set; }

    private IReadOnlyList<TicketMessageRow> _messages = Array.Empty<TicketMessageRow>();
    private IReadOnlyList<PublicTemplateRow> _templates = Array.Empty<PublicTemplateRow>();
    private bool _templatesLoaded;
    private string _draft = string.Empty;
    private MentionInput? _noteInput;
    private TextDraft? _replyDraft;

    // a ticket shows the internal thread and the citizen thread side by side: one draft each
    private string ComposerDraftKey => $"ticket:{TicketId}:{(IsInternal ? "notiz" : "antwort")}";
    private ImageAttachmentPicker.PickedImage? _attachment;
    private long? _suggestCost;
    private LlmQuotaStatus? _suggestQuota;
    private bool _load = true;
    private bool _busy;
    private string? _loadedId;
    private string? _editingId;
    private string _editText = string.Empty;
    private bool _editSaving;

    private Dictionary<string, IReadOnlyList<MentionSegment>> _segments = new(StringComparer.Ordinal);

    private bool IsInternal => Audience == TicketMessageAudience.Intern;

    /// <summary>Resolved segments of one internal line; plain text until the batch has run.</summary>
    private IReadOnlyList<MentionSegment> SegmentsFor(TicketMessageRow message)
        => _segments.TryGetValue(message.Id, out var found)
            ? found
            : [new MentionSegment(false, message.Text)];

    protected override void OnInitialized() => Broadcaster.Modified += OnModified;

    protected override async Task OnParametersSetAsync()
    {
        // before the id guard: its own flag makes the load a one-shot anyway, and a reopened ticket has to
        // find its templates without the guard skipping them for the life of the component
        await LoadTemplatesAsync();
        if (_loadedId == TicketId)
        {
            return;
        }
        _loadedId = TicketId;
        await LoadAsync();
    }

    private async Task LoadTemplatesAsync()
    {
        // tied to the composer that uses them, Closed included: a closed ticket needs no template menu
        if (_templatesLoaded || IsInternal || !CanWrite || Closed)
        {
            return;
        }
        _templatesLoaded = true;
        // best effort: a missing template list must never cost the thread
        try { _templates = await Templates.GetActiveAsync(PublicTemplateKind.TicketAntwort); }
        catch { /* ignore */ }
    }

    private void Apply(PublicTemplateRow template)
        => _draft = PublicTemplateRenderer.Render(template.Text, new PublicTemplateContext(CitizenName, CaseNumber));

    private async Task LoadAsync()
    {
        _load = true;
        try
        {
            _messages = await Tickets.GetMessagesAsync(TicketId, Audience, User);
            if (IsInternal)
            {
                // one batch for the whole thread, like the comment panel: one round trip instead of one per line
                var resolved = await MentionService.ResolveManyAsync(
                    _messages.Select(m => (string?)m.Text).ToList(), User.MayClassifiedRead(), User.GetAgentId(),
                    partnerAgency: User.GetPartnerAgency());
                _segments = _messages
                    .Select((m, i) => (m.Id, Segments: resolved[i]))
                    .ToDictionary(x => x.Id, x => x.Segments, StringComparer.Ordinal);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _load = false;
        }
    }

    /// <summary>Fills the composer with a NOOSEI draft; sending it stays the agent's own act.</summary>
    private async Task SuggestAsync()
    {
        _busy = true;
        // cleared first: a refusal leaves the toast and nothing else, where the previous run's remaining
        // quota would otherwise still stand there as if it were current
        _suggestCost = null;
        _suggestQuota = null;
        try
        {
            var suggestion = await Assist.SuggestTicketReplyAsync(TicketId, User);
            _draft = suggestion.Text;
            _suggestCost = suggestion.QuotaTokens;
            _suggestQuota = suggestion.Quota;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    // the composer that just sent; whichever of the two is on screen
    private async Task ComposerSavedAsync()
    {
        if (_noteInput is not null)
        {
            await _noteInput.MarkSavedAsync();
        }
        if (_replyDraft is not null)
        {
            await _replyDraft.MarkSavedAsync();
        }
    }

    private async Task SendAsync()
    {
        _busy = true;
        try
        {
            // a fresh stream per send: the service reads it once, and a retry after an error needs its own
            var upload = _attachment is { } picked
                ? new TicketAttachmentUpload(new MemoryStream(picked.Content), picked.ContentType,
                    picked.OriginalName, picked.Size)
                : null;
            if (IsInternal)
            {
                await Tickets.PostInternalNoteAsync(TicketId, _draft, User, upload);
            }
            else
            {
                await Tickets.ReplyToCitizenAsync(TicketId, _draft, User, upload);
            }
            await ComposerSavedAsync();
            _draft = string.Empty;
            _attachment = null;
            // the line belongs to the draft that just left; above an empty composer it reads as the next one
            _suggestCost = null;
            _suggestQuota = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    // author only, and never the citizen's own line: leadership may delete a foreign line, never restate it
    private bool CanEdit(TicketMessageRow message)
        => CanWrite && message.Mine && !message.FromCitizen && _editingId != message.Id;

    private void BeginEdit(TicketMessageRow message)
    {
        _editingId = message.Id; // one edit at a time
        _editText = message.Text;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _editText = string.Empty;
    }

    private async Task SaveEditAsync()
    {
        if (_editSaving || _editingId is null || string.IsNullOrWhiteSpace(_editText))
        {
            return;
        }
        _editSaving = true;
        try
        {
            await Tickets.EditMessageAsync(_editingId, _editText, User);
            CancelEdit();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _editSaving = false;
        }
    }

    private string Author(TicketMessageRow message)
    {
        if (message.FromCitizen)
        {
            // a ticket is never anonymous, so the known name beats the generic label
            return string.IsNullOrWhiteSpace(CitizenName) ? "Bürger" : CitizenName;
        }
        return IsInternal ? message.AuthorCodename ?? TicketRules.AgencySender : TicketRules.AgencySender;
    }

    private void OnModified(string ticketId, string caseNumber, TicketMessageAudience? audience)
    {
        // a signal about the other thread is none of this panel's business; null concerns both
        if (ticketId != TicketId || (audience is { } only && only != Audience))
        {
            return;
        }
        InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
    }

    public void Dispose() => Broadcaster.Modified -= OnModified;
}
