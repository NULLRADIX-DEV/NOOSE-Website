@page "/tickets/{Id}"
@* InternalAgent, not LeadershipPage: an agent attached to one ticket has to reach that one. Which ticket they
   may see is decided in the service — GetAsync returns null, and the empty state below does not confirm that
   the ticket exists. *@
@attribute [Authorize(Policy = Policies.InternalAgent)]
@inject ITicketService Tickets
@inject ITicketConversionService Conversion
@inject TicketBroadcaster Broadcaster
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@(_ticket?.CaseNumber ?? "Bürger-Ticket") · FIB</PageTitle>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_ticket is null)
{
    <EmptyState Icon="@Icons.Material.Filled.SearchOff" Title="Ticket nicht gefunden"
                Text="Das Ticket existiert nicht oder wurde gelöscht." />
}
else
{
    <PageHeader Icon="@Icons.Material.Filled.Forum"
                Title="@($"Ticket {_ticket.CaseNumber}")"
                Subtitle="@($"Eröffnet am {_ticket.CreatedAt.ToLocalTime():dd.MM.yyyy HH:mm}")"
                BackHref="/tickets">
        <Actions>
            @if (_canWrite)
            {
                @if (_ticket.HandlerId is null)
                {
                    <MudButton OnClick="AssignAsync" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AssignmentInd">Übernehmen</MudButton>
                }
                <MudButton OnClick="AssignToAsync" Variant="Variant.Outlined" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.PersonSearch">Zuweisen</MudButton>
                <MudMenu Label="Kategorie" Variant="Variant.Outlined" Color="Color.Default"
                         StartIcon="@Icons.Material.Filled.Category">
                    @foreach (var option in TicketKategorieDisplay.All)
                    {
                        <MudMenuItem OnClick="@(() => SetCategoryAsync(option))"
                                     Disabled="@(option == _ticket.Category)">
                            @TicketKategorieDisplay.Name(option)
                        </MudMenuItem>
                    }
                </MudMenu>
                <MudButton OnClick="SetPriorityAsync" Variant="Variant.Outlined" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.LowPriority">Priorität</MudButton>
                <MudMenu Label="Status setzen" Variant="Variant.Outlined" Color="Color.Default"
                         StartIcon="@Icons.Material.Filled.Flag">
                    @foreach (var target in TicketRules.AllowedTargets(_ticket.Status))
                    {
                        <MudMenuItem OnClick="@(() => SetStatusAsync(target))">
                            @TicketStatusDisplay.Name(target)
                        </MudMenuItem>
                    }
                </MudMenu>
                <MudButton OnClick="ToCaseAsync" Disabled="_busy" Variant="Variant.Outlined"
                           Color="Color.Secondary" StartIcon="@Icons.Material.Filled.FolderSpecial">
                    Vorgang anlegen
                </MudButton>
                <MudButton OnClick="DeleteAsync" Variant="Variant.Text" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete">Löschen</MudButton>
            }
        </Actions>
    </PageHeader>

    <MudGrid Spacing="4">
        <MudItem xs="12" md="5">
            <MudStack Spacing="4">
                <MudPaper Outlined="true" Class="pa-4">
                    <MudStack Spacing="3">
                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                            <MudChip T="string" Size="Size.Small" Color="@StatusColour(_ticket.Status)">
                                @TicketStatusDisplay.Name(_ticket.Status)
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     Color="@(_ticket.Kind == TicketArt.Intern ? Color.Secondary : Color.Default)">
                                @TicketArtDisplay.Name(_ticket.Kind)
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     Icon="@Icons.Material.Filled.Category">
                                @TicketKategorieDisplay.Name(_ticket.Category)
                            </MudChip>
                            @if (_ticket.PriorityOverride is { } fixedPriority)
                            {
                                @* only the hand-set value lives on the ticket; the automatic order is the desk's *@
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                                         Icon="@Icons.Material.Filled.LowPriority">
                                    Priorität @fixedPriority
                                </MudChip>
                            }
                            @if (_ticket.Kind != TicketArt.Intern && _ticket.CitizenIsBlocked)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                                         Icon="@Icons.Material.Filled.Block">Konto gesperrt</MudChip>
                            }
                        </MudStack>
                        <MudText Typo="Typo.h6">@_ticket.Subject</MudText>
                        @if (_ticket.Kind == TicketArt.Intern)
                        {
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Eröffnet von</MudText>
                                <MudText Typo="Typo.body2">@(_ticket.OpenedByCodename ?? "—")</MudText>
                            </MudStack>
                        }
                        else
                        {
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Bürger</MudText>
                                <MudText Typo="Typo.body2">@_ticket.CitizenName</MudText>
                            </MudStack>
                        }
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Bearbeiter</MudText>
                            <MudText Typo="Typo.body2">
                                @(string.IsNullOrWhiteSpace(_ticket.HandlerCodename) ? "—" : _ticket.HandlerCodename)
                            </MudText>
                        </MudStack>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Letzte Aktivität</MudText>
                            <MudText Typo="Typo.body2">
                                @_ticket.LastActivityAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </MudText>
                        </MudStack>
                        @if (_ticket.ClosedAt is not null)
                        {
                            <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true">
                                <MudStack Spacing="1">
                                    <div>
                                        Geschlossen am @_ticket.ClosedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                        @(_ticket.ClosedByCodename is null ? string.Empty : $" von {_ticket.ClosedByCodename}")
                                        — der Bürger kann darauf nicht mehr antworten.
                                    </div>
                                    @* internal wording: outward the ticket says "Abgeschlossen" and nothing else *@
                                    @if (_ticket.ClosingReason is { } why)
                                    {
                                        <div>Grund: @TicketAbschlussgrundDisplay.Name(why)</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(_ticket.ClosingNote))
                                    {
                                        <MudText Typo="Typo.caption">@_ticket.ClosingNote</MudText>
                                    }
                                </MudStack>
                            </MudAlert>
                        }
                    </MudStack>
                </MudPaper>

                <MudPaper Outlined="true" Class="pa-4">
                    <TicketAgentsPanel TicketId="@_ticket.Id" User="@_user" CanManage="@_canManage"
                                       Changed="ReloadQuietlyAsync" />
                </MudPaper>

                @* the one record projection a ticket gets: an agent's own reminder, not an entry on any timeline.
                   The due notice names the case number and nothing else — RecordsReference keeps the subject out *@
                <MudPaper Outlined="true" Class="pa-4">
                    <FollowupPanel EntityType="@nameof(Ticket)" EntityId="@_ticket.Id" User="_user" />
                </MudPaper>
            </MudStack>
        </MudItem>
        <MudItem xs="12" md="7">
            <MudStack Spacing="4">
                @* the internal thread is the wide one on an internal ticket: there is no citizen side *@
                <TicketMessagePanel TicketId="@_ticket.Id" User="@_user"
                                    Audience="TicketMessageAudience.Intern" CanWrite="@_canWriteInternal" />
                @if (_ticket.Kind != TicketArt.Intern)
                {
                    @* Closed, not folded into CanWrite: a closed ticket takes no new answer, but its own lines
                       stay correctable *@
                    <TicketMessagePanel TicketId="@_ticket.Id" User="@_user"
                                        Audience="TicketMessageAudience.Buerger"
                                        CaseNumber="@_ticket.CaseNumber" CitizenName="@_ticket.CitizenName"
                                        CanWrite="@_canWrite" Closed="@(!TicketRules.IsOpen(_ticket.Status))" />
                }
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private ClaimsPrincipal _user = default!;
    private TicketDetail? _ticket;
    private bool _load = true;
    /// <summary>Desk rights: status, deletion, the citizen thread, and who is attached.</summary>
    private bool _canWrite;

    /// <summary>Managing participants is a desk call, never a participant's own.</summary>
    private bool _canManage;

    /// <summary>Writing an internal note: the desk, and every agent attached to this ticket.</summary>
    private bool _canWriteInternal;

    private string? _loadedId;
    private bool _busy;

    protected override void OnInitialized() => Broadcaster.Modified += OnModified;

    protected override async Task OnParametersSetAsync()
    {
        _user = (await AuthStateTask).User;
        _canWrite = _user.MayWrite() && _user.IsLeadership();
        _canManage = _canWrite;
        // a participant writes notes but sets no status and answers no citizen; the service enforces the same split
        _canWriteInternal = _user.MayWrite();
        if (_loadedId == Id)
        {
            return;
        }
        _loadedId = Id;
        await LoadAsync();
        // opening is reading; the mark moves before the desk draws its unread count again
        await Tickets.MarkAgentReadAsync(Id, _user);
    }

    private Task LoadAsync() => LoadAsync(showSpinner: true);

    /// <summary>Refresh without the spinner; swapping the page for a progress bar tears down both message panels
    /// and throws away whatever the handler had half-typed in them.</summary>
    private Task ReloadQuietlyAsync() => LoadAsync(showSpinner: false);

    private async Task LoadAsync(bool showSpinner)
    {
        if (showSpinner)
        {
            _load = true;
        }
        try
        {
            _ticket = await Tickets.GetAsync(Id, _user);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _load = false;
        }
    }

    private async Task AssignAsync()
    {
        try
        {
            await Tickets.AssignSelfAsync(Id, _user);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>Lifts the concern into a case and links the two; the ticket itself stays where it is.</summary>
    private async Task ToCaseAsync()
    {
        if (!await ConfirmDialog.ShowAsync(DialogService, "Vorgang aus diesem Ticket anlegen?",
                "Der Schriftwechsel wird in die Beschreibung übernommen und der Vorgang mit dem Ticket verknüpft. "
                + "Das Ticket bleibt bestehen.", "Vorgang anlegen"))
        {
            return;
        }
        _busy = true;
        try
        {
            var created = await Conversion.ToCaseAsync(Id, _user);
            Snackbar.Add($"Vorgang {created.CaseNumber} angelegt.", Severity.Success);
            Nav.NavigateTo($"/vorgaenge/{created.Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Puts another agent on the ticket as handler; participants stay a separate list.</summary>
    private async Task AssignToAsync()
    {
        string[] exclusion = _ticket?.HandlerId is { Length: > 0 } handler ? [handler] : [];
        var choice = await AgentAllocateDialog.ShowAsync(DialogService, exclusion, _user.MayRealNameSee(), false);
        if (choice is null)
        {
            return;
        }
        try
        {
            await Tickets.AssignAsync(Id, choice.AgentId, _user);
            Snackbar.Add("Bearbeiter gesetzt.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>Sets or clears the hand-set order; an empty entry hands the row back to the automatic one.</summary>
    private async Task SetPriorityAsync()
    {
        var entered = await ReasonDialog.ShowAsync(DialogService, "Priorität von Hand setzen",
            $"Zahl von {TicketPriority.Min} bis {TicketPriority.Max}. Leer lassen setzt die Ausgabe wieder auf die "
            + "automatische Reihenfolge aus Kategorie, Wartezeit und Vertrauen des Kontos.",
            "Übernehmen", "Priorität", preset: _ticket?.PriorityOverride?.ToString(), lines: 1);
        if (entered is null)
        {
            return;
        }
        int? wanted = null;
        if (!string.IsNullOrWhiteSpace(entered))
        {
            if (!int.TryParse(entered.Trim(), out var parsed))
            {
                Snackbar.Add("Bitte eine Zahl eingeben.", Severity.Error);
                return;
            }
            wanted = parsed;
        }
        try
        {
            await Tickets.SetPriorityAsync(Id, wanted, _user);
            await LoadAsync();
            Snackbar.Add(wanted is null ? "Priorität wieder automatisch." : "Priorität gesetzt.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SetCategoryAsync(TicketKategorie category)
    {
        try
        {
            await Tickets.SetCategoryAsync(Id, category, _user);
            await LoadAsync();
            Snackbar.Add($"Kategorie: {TicketKategorieDisplay.Name(category)}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SetStatusAsync(TicketStatus status)
    {
        TicketCloseDialog.Choice? closure = null;
        if (status == TicketStatus.Geschlossen)
        {
            // the service refuses a closure without a reason, so the dialog is the only way in
            closure = await TicketCloseDialog.ShowAsync(DialogService);
            if (closure is null)
            {
                return;
            }
        }
        try
        {
            await Tickets.SetStatusAsync(Id, status, _user, closure?.Reason, closure?.Note);
            await LoadAsync();
            Snackbar.Add($"Status: {TicketStatusDisplay.Name(status)}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync()
    {
        try
        {
            await Tickets.DeleteAsync(Id, _user);
            Snackbar.Add("Ticket in den Papierkorb verschoben.", Severity.Success);
            Nav.NavigateTo("/tickets");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void OnModified(string ticketId, string caseNumber, TicketMessageAudience? audience)
    {
        if (ticketId != Id)
        {
            return;
        }
        // the mark moves again: a line arriving while the handler has the ticket open has been read
        InvokeAsync(async () =>
        {
            await ReloadQuietlyAsync();
            await Tickets.MarkAgentReadAsync(Id, _user);
            StateHasChanged();
        });
    }

    public void Dispose() => Broadcaster.Modified -= OnModified;

    private static Color StatusColour(TicketStatus status) => status switch
    {
        TicketStatus.Offen => Color.Info,
        TicketStatus.InBearbeitung => Color.Primary,
        TicketStatus.WartetAufBuerger => Color.Warning,
        TicketStatus.Geschlossen => Color.Default,
        _ => Color.Default,
    };
}
