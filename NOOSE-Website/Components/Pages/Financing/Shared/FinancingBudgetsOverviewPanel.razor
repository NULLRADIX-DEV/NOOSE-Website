@* Monthly budget of every active agent; leadership can override an individual amount here. *@
@inject IFinancingBudgetService Budgets
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudStack Spacing="3">
    <MudText Typo="Typo.h6">Budgets · @_periodLabel</MudText>

    @if (_load)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_rows.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Filled.Savings" Title="Keine aktiven Agenten"
                    Text="Sobald Agenten freigegeben sind, erscheint hier ihr Monatsbudget." />
    }
    else
    {
        @* phones keep agent, remaining budget and the actions *@
        <MudSimpleTable Dense="true" Hover="true" Striped="true">
            <thead>
                <tr>
                    <th>Agent</th>
                    <th class="noose-mobil-aus">Dienstgrad</th>
                    <th class="noose-mobil-aus" style="text-align:right">Grundbudget</th>
                    <th class="noose-mobil-aus" style="text-align:right">Übertrag</th>
                    <th class="noose-mobil-aus" style="text-align:right">Verbraucht</th>
                    <th style="text-align:right">Rest</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>
                        <td>@row.Codename</td>
                        <td class="noose-mobil-aus">@RankDisplay.Name(row.Rank)</td>
                        <td class="noose-mobil-aus" style="text-align:right">
                            @Money.Format(row.BaseBudget)
                            @if (row.IsOverride)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info" Class="ml-1">individuell</MudChip>
                            }
                        </td>
                        <td class="noose-mobil-aus" style="text-align:right">@Money.Format(row.CarryIn)</td>
                        <td class="noose-mobil-aus" style="text-align:right">@Money.Format(row.Consumed)</td>
                        <td style="text-align:right">
                            <MudText Typo="Typo.body2" Color="@(row.Remaining > 0 ? Color.Success : Color.Error)">
                                @Money.Format(row.Remaining)
                            </MudText>
                        </td>
                        <td style="text-align:right; white-space:nowrap">
                            @if (_mayManage)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Tune" Size="Size.Small"
                                               OnClick="@(() => OverrideAsync(row))" aria-label="Budget anpassen" />
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Person" Size="Size.Small"
                                           Href="@($"/personal/{row.AgentId}?tab=finanzierung")" aria-label="Personalakte" />
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</MudStack>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    /// <summary>Bumped by the parent to force a reload after a decision changed consumption.</summary>
    [Parameter] public int Refresh { get; set; }

    private bool _load = true;
    private bool _mayManage;
    private int _loaded = -1;
    private ClaimsPrincipal _user = default!;
    private IReadOnlyList<FinancingBudgetStatus> _rows = [];
    private string _periodLabel = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded == Refresh)
        {
            return;
        }
        _loaded = Refresh;
        _user = (await AuthStateTask).User;
        // read-only supervision reads this page but must not get controls that always fail
        _mayManage = _user.IsLeadership() && _user.MayWrite();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _load = true;
        _rows = await Budgets.GetAllStatusAsync();
        var (year, month) = FinancingPeriod.Current();
        _periodLabel = FinancingPeriod.Label(year, month);
        _load = false;
    }

    private async Task OverrideAsync(FinancingBudgetStatus row)
    {
        var entered = await FinancingBudgetOverrideDialog.ShowAsync(DialogService, row);
        if (entered is null)
        {
            return;
        }
        try
        {
            await Budgets.SetOverrideAsync(row.AgentId, entered.Amount, _user);
            Snackbar.Add(entered.Amount is null
                ? "Budget auf den Rang-Standard zurückgesetzt."
                : "Individuelles Budget gesetzt.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
