@page "/finanzierungen/neu"
@inject IFinancingCatalogService Catalog
@inject IFinancingBudgetService Budgets
@inject IFinancingService Financing
@inject FinancingBroadcaster Broadcaster
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Neuer Finanzierungsantrag · FIB</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.RequestQuote"
            Title="Neuer Finanzierungsantrag"
            Subtitle="Position suchen, Menge festlegen, begründen."
            BackHref="/finanzierungen" />

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_isTeamLead)
{
    <EmptyState Icon="@Icons.Material.Filled.VisibilityOff" Title="Nicht für die Team-Leitung"
                Text="Die Team-Leitung ist Nur-Lese-Aufsicht und stellt keine Finanzierungsanträge." />
}
else if (_items.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Filled.Inventory" Title="Nichts verfügbar"
                Text="Für deinen Dienstgrad ist derzeit keine Position hinterlegt. Wende dich an die Führung." />
}
else
{
    <MudStack Spacing="3">
        <FinancingBudgetTiles Status="_budget" />

        <MudPaper Class="pa-4" Elevation="1">
            <MudForm @ref="_form">
                <MudStack Spacing="3">
                    <MudAutocomplete T="FinancingItem" @ref="_picker" Label="Position suchen & hinzufügen"
                                     Value="_pick" ValueChanged="OnPickAsync" SearchFunc="SearchItemsAsync"
                                     ToStringFunc="@(i => i is null ? string.Empty : i.Name)"
                                     ResetValueOnEmptyText="true" Clearable="true" MinCharacters="1" Immediate="true"
                                     CoerceText="false" CoerceValue="false" MaxItems="@MaxSuggestions"
                                     Variant="Variant.Outlined" Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.Search"
                                     HelperText="@SearchHint">
                        <ItemTemplate Context="item">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Style="width:100%">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2">@item.Name</MudText>
                                    @if (!string.IsNullOrWhiteSpace(item.Category))
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@item.Category</MudText>
                                    }
                                </MudStack>
                                <MudSpacer />
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @Money.Format(item.UnitPrice) · @item.SubsidyPercent % Zuschuss
                                </MudText>
                            </MudStack>
                        </ItemTemplate>
                        <NoItemsTemplate>
                            <MudText Typo="Typo.caption" Class="pa-2 mud-text-secondary">
                                Keine passende Position — bereits gewählte tauchen hier nicht mehr auf.
                            </MudText>
                        </NoItemsTemplate>
                    </MudAutocomplete>

                    @if (_cart.Count == 0)
                    {
                        <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true">
                            Noch keine Position gewählt. Was es gibt, steht im
                            <MudLink Href="/finanzierungen?tab=katalog" Target="_blank">Katalog</MudLink>.
                        </MudAlert>
                    }
                    else
                    {
                        <MudSimpleTable Dense="true" Hover="true">
                            <thead>
                                <tr>
                                    <th>Position</th>
                                    <th class="noose-mobil-aus" style="text-align:right">Einzelpreis</th>
                                    <th class="noose-mobil-aus" style="text-align:right">Zuschuss</th>
                                    <th style="text-align:right">Menge</th>
                                    <th style="text-align:right">FIB zahlt</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in _cart)
                                {
                                    var row = line;
                                    <tr>
                                        <td>
                                            @row.Item.Name
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                                                @(string.IsNullOrWhiteSpace(row.Item.Category) ? "Ohne Kategorie" : row.Item.Category)
                                                · max. @row.Item.MaxQuantity
                                            </MudText>
                                            @if (!string.IsNullOrWhiteSpace(row.Item.Description))
                                            {
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@row.Item.Description</MudText>
                                            }
                                        </td>
                                        <td class="noose-mobil-aus" style="text-align:right">@Money.Format(row.Item.UnitPrice)</td>
                                        <td class="noose-mobil-aus" style="text-align:right">@row.Item.SubsidyPercent %</td>
                                        <td style="text-align:right; width:130px">
                                            <MudNumericField T="int" Value="@row.Quantity" Min="1" Max="@row.Item.MaxQuantity"
                                                             ValueChanged="@(v => SetQuantity(row, v))"
                                                             Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </td>
                                        <td style="text-align:right">
                                            @Money.Format(FinancingMath.Subsidy(row.Item.UnitPrice, row.Quantity, row.Item.SubsidyPercent))
                                        </td>
                                        <td style="text-align:right">
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                           OnClick="@(() => Remove(row))" aria-label="Position entfernen" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }

                    <MentionInput @bind-Text="_justification" Label="Begründung" Lines="3" MaxLength="2000"
                                  Required="true" RequiredError="Eine Begründung ist erforderlich"
                                  HelperText="@JustificationHint" DraftKey="@DraftKey" />
                </MudStack>
            </MudForm>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="1">
            <MudStack Spacing="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2">Warenwert</MudText>
                    <MudText Typo="Typo.body2">@Money.Format(TotalGross)</MudText>
                </MudStack>
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2">Dein Eigenanteil</MudText>
                    <MudText Typo="Typo.body2">@Money.Format(TotalGross - TotalSubsidy)</MudText>
                </MudStack>
                <MudDivider Class="my-1" />
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.subtitle1"><b>FIB-Zuschuss</b></MudText>
                    <MudText Typo="Typo.subtitle1"><b>@Money.Format(TotalSubsidy)</b></MudText>
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (TotalSubsidy > _budget.Remaining)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                Der Zuschuss übersteigt dein Restbudget um <b>@Money.Format(TotalSubsidy - _budget.Remaining)</b>.
                Du kannst den Antrag stellen — die Führung muss die Überschreitung dann begründen.
            </MudAlert>
        }

        <FormActions>
            <MudButton Href="/finanzierungen">Abbrechen</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Send"
                       Disabled="@(_saving || TotalSubsidy <= 0 || string.IsNullOrWhiteSpace(_justification))"
                       OnClick="SaveAsync">Antrag stellen</MudButton>
        </FormActions>
    </MudStack>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    // held in C# because a literal "@" in a component attribute is parsed as a code block
    private const string JustificationHint = "Wofür brauchst du das? Mit @ kannst du Akten und Agenten erwähnen.";
    private const string SearchHint = "Bezeichnung, Kategorie oder Beschreibung eingeben — die Auswahl landet unten in der Liste.";
    private const int MaxSuggestions = 20;

    /// <summary>One chosen position with its quantity; the picker holds nothing, this list is the basket.</summary>
    private sealed class CartLine
    {
        public FinancingItem Item { get; init; } = default!;
        public int Quantity { get; set; } = 1;
    }

    private bool _load = true;
    private bool _saving;
    private bool _isTeamLead;
    private ClaimsPrincipal _user = default!;

    // the page only ever creates, so one draft per agent
    private const string DraftKey = "finanzierung:neu:begruendung";
    private MudForm _form = default!;
    private MudAutocomplete<FinancingItem> _picker = default!;
    private FinancingItem? _pick;
    private List<FinancingItem> _items = new();
    private readonly List<CartLine> _cart = new();
    private FinancingBudgetStatus _budget = FinancingBudgetStatus.Empty;
    private string _justification = string.Empty;

    private decimal TotalGross => _cart.Sum(l => FinancingMath.Gross(l.Item.UnitPrice, l.Quantity));

    private decimal TotalSubsidy => _cart.Sum(l => FinancingMath.Subsidy(l.Item.UnitPrice, l.Quantity, l.Item.SubsidyPercent));

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        // the service rejects it too; this only avoids offering a form that can never be submitted
        _isTeamLead = _user.IsTeamLead();
        if (!_isTeamLead)
        {
            _items = await Catalog.GetActiveForAsync(_user.GetRank(), _user.GetDivision());
            var agentId = _user.GetAgentId();
            if (!string.IsNullOrEmpty(agentId))
            {
                _budget = await Budgets.GetStatusAsync(agentId);
            }
        }
        _load = false;
    }

    private Task<IEnumerable<FinancingItem>> SearchItemsAsync(string value, CancellationToken token)
    {
        // hide what is already in the basket: a second line for the same position is rejected on save
        var pool = _items.Where(i => _cart.All(l => l.Item.Id != i.Id));
        var term = value?.Trim();
        if (!string.IsNullOrEmpty(term))
        {
            pool = pool.Where(i => Matches(i, term));
        }
        return Task.FromResult(pool.Take(MaxSuggestions));
    }

    private static bool Matches(FinancingItem item, string term)
        => item.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
        || (item.Category?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
        || (item.Description?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false);

    private async Task OnPickAsync(FinancingItem? item)
    {
        _pick = null;
        if (item is null)
        {
            return;
        }
        if (_cart.All(l => l.Item.Id != item.Id))
        {
            _cart.Add(new CartLine { Item = item, Quantity = 1 });
        }
        // wipe the search box so the next position starts from an empty field
        await _picker.ClearAsync();
    }

    // the numeric field also accepts a typed value outside Min/Max, which the service would reject
    private void SetQuantity(CartLine line, int value)
        => line.Quantity = Math.Clamp(value, 1, Math.Max(1, line.Item.MaxQuantity));

    private void Remove(CartLine line) => _cart.Remove(line);

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }
        _saving = true;
        try
        {
            var input = new FinancingRequestInput
            {
                Justification = _justification,
                Lines = _cart.Select(l => new FinancingRequestLineInput { ItemId = l.Item.Id, Quantity = l.Quantity }).ToList(),
            };
            var created = await Financing.CreateAsync(input, _user);
            await TextDraft.DiscardAsync(JS, _user.GetAgentId(), DraftKey);
            Broadcaster.Report();
            Snackbar.Add($"Antrag {created.CaseNumber} eingereicht.", Severity.Success);
            Nav.NavigateTo($"/finanzierungen/{created.Id}");
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _saving = false;
        }
    }
}
