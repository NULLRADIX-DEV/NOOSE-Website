@page "/brett"
@attribute [Authorize(Policy = Policies.InternalAgent)]
@inject IAnnouncementService BoardService
@inject ISnackbar Snackbar

<PageTitle>Schwarzes Brett · NOOSE</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
    <MudIcon Icon="@Icons.Material.Filled.Campaign" Color="Color.Primary" Size="Size.Large" />
    <MudText Typo="Typo.h4">Schwarzes Brett</MudText>
    <MudSpacer />
    <AuthorizeView Policy="@Policies.Leadership">
        <MudButton Href="/papierkorb?tab=brett" Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.Delete">Papierkorb</MudButton>
    </AuthorizeView>
    <AuthorizeView Policy="@Policies.WriteAccess" Context="schreib">
        <MudButton Href="/brett/neu" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">Neue Ankündigung</MudButton>
    </AuthorizeView>
</MudStack>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Ankündigungen &amp; Behörden-Broadcasts. Jeder aktive Agent kann eine Brett-Notiz posten; gezielte Broadcasts an
    Gruppen, Glocken-Push und Quittierungen sind der Führung vorbehalten.
</MudText>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_rows.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Noch keine Ankündigungen am Brett.</MudAlert>
}
else
{
    @if (_overdue.Count > 0)
    {
        <OverdueAcknowledgmentsPanel Items="_overdue" />
    }
    <MudStack Spacing="3">
        @foreach (var row in _rows)
        {
            <AnnouncementCard Row="row" OnAcknowledge="@(() => AcknowledgeAsync(row))" />
        }
    </MudStack>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;
    private ClaimsPrincipal _user = default!;
    private List<AnnouncementRow> _rows = new();
    private List<OverdueAcknowledgment> _overdue = new();

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _load = true;
        _rows = await BoardService.GetBoardAsync(_user);
        _overdue = await BoardService.GetOverdueAcknowledgmentsAsync(_user);
        _load = false;
    }

    private async Task AcknowledgeAsync(AnnouncementRow row)
    {
        try
        {
            await BoardService.AcknowledgeAsync(row.Id, _user);
            Snackbar.Add("Kenntnis genommen.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
