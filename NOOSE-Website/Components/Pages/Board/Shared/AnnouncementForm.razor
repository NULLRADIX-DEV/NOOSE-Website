@* Create/edit form for an announcement. *@
@inject ITaskforceService TaskforceService

<MudGrid>
    <MudItem xs="12">
        <MudTextField @bind-Value="Input.Title" Label="Titel" Required="true" RequiredError="Titel ist erforderlich"
                      Variant="Variant.Outlined" />
    </MudItem>

    <MudItem xs="12">
        <MudText Typo="Typo.subtitle2" Class="mb-1">Inhalt</MudText>
        <RichTextEditor @ref="_editor" Value="@_content" MinHeight="320px" Ai="TextAssistContext.Announcement" AiSubject="@Input.Title" Mentions="true"
                        DraftKey='@($"ankuendigung:{(string.IsNullOrEmpty(EntityId) ? "neu" : EntityId)}")' />
    </MudItem>

    <MudItem xs="12">
        <MudSwitch T="bool" @bind-Value="Input.Important" Color="Color.Warning" Label="Wichtig (oben am Brett anpinnen)" />
    </MudItem>

    @if (ShowBroadcastOptions)
    {
        <MudItem xs="12">
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.subtitle1">Behörden-Broadcast (nur Führung)</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Die Zielgruppe bestimmt, wer den Eintrag am Brett sieht. „In die Glocke senden" pusht zusätzlich eine
                Benachrichtigung; „Quittierung verlangen" fordert eine Lesebestätigung an. Wer sie bis zur Frist nicht
                gegeben hat, wird einmal erinnert.
            </MudText>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudSelect T="AnnouncementAudience" @bind-Value="Input.Audience" Label="Zielgruppe" Variant="Variant.Outlined">
                @foreach (var z in AnnouncementAudienceDisplay.All)
                {
                    <MudSelectItem Value="z">@AnnouncementAudienceDisplay.Name(z)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        @if (Input.Audience == AnnouncementAudience.Taskforce)
        {
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="Input.TargetId" Label="Taskforce" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var t in _taskforces)
                    {
                        <MudSelectItem T="string" Value="@t.Id">@t.Name (@t.CaseNumber)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        }
        else if (Input.Audience == AnnouncementAudience.FromRank)
        {
            <MudItem xs="12" md="6">
                <MudSelect T="Rank?" @bind-Value="Input.MinRank" Label="Mindest-Dienstgrad" Variant="Variant.Outlined">
                    @foreach (var d in RankDisplay.All)
                    {
                        <MudSelectItem T="Rank?" Value="@((Rank?)d)">@RankDisplay.Name(d)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        }
        <MudItem xs="12" md="6">
            <MudSwitch T="bool" @bind-Value="Input.AsBroadcast" Color="Color.Primary" Label="In die Glocke senden (Broadcast)" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudSwitch T="bool" @bind-Value="Input.AcknowledgmentRequired" Color="Color.Primary" Label="Quittierung verlangen (Lesebestätigung)" />
        </MudItem>
        @if (Input.AcknowledgmentRequired)
        {
            <MudItem xs="12" md="6">
                <MudSelect T="int" @bind-Value="Input.AcknowledgmentDays" Label="Erinnern, wer nicht quittiert hat"
                           Variant="Variant.Outlined"
                           HelperText="Ab dann gilt die Quittierung als überfällig. Die Erinnerung geht einmal raus.">
                    @foreach (var days in AcknowledgmentRules.DayChoices)
                    {
                        <MudSelectItem T="int" Value="days">@AcknowledgmentRules.ChoiceLabel(days)</MudSelectItem>
                    }
                    <MudSelectItem T="int" Value="0">@AcknowledgmentRules.ChoiceLabel(0)</MudSelectItem>
                </MudSelect>
            </MudItem>
        }
    }
</MudGrid>

@code {
    [Parameter, EditorRequired] public AnnouncementInput Input { get; set; } = default!;

    /// <summary>Show broadcast options (leadership, create only).</summary>
    [Parameter] public bool ShowBroadcastOptions { get; set; }

    /// <summary>Id of the announcement being edited; null for a new one (only scopes the browser draft).</summary>
    [Parameter] public string? EntityId { get; set; }

    /// <summary>Controls whether leadership-only broadcast targets are loaded.</summary>
    [Parameter] public bool IsLeadership { get; set; }

    private RichTextEditor? _editor;
    private List<Taskforce> _taskforces = new();

    // seed the editor with the (optional) stored HTML
    private string _content => Input.Content ?? string.Empty;

    /// <summary>Reads the final editor HTML so the parent can persist it on save.</summary>
    public async Task<string?> GetContentHtmlAsync() => _editor is null ? Input.Content : await _editor.GetHtmlAsync();

    /// <summary>Drops the browser draft after the parent stored the text; without it the next "new announcement"
    /// offers the already published one back as unsaved work.</summary>
    public Task MarkSavedAsync() => _editor?.MarkSavedAsync() ?? Task.CompletedTask;

    protected override async Task OnInitializedAsync()
    {
        if (ShowBroadcastOptions)
        {
            // leadership-only path: returns all taskforces
            _taskforces = await TaskforceService.GetListAsync(IsLeadership, null);
        }
    }
}
