@page "/suche"
@using Microsoft.AspNetCore.WebUtilities
@using NOOSE_Website.Components.Pages.Search.Shared
@using NOOSE_Website.Services.Search
@implements IDisposable
@inject ISearchService SearchService
@inject ISavedSearchService SavedSearchService
@inject ITagService TagService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject INavPreferencesService NavPrefs
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Suche · NOOSE</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.Search" Title="Globale Suche">
    <SubtitleContent>
        Durchsucht <b>alles, was du sehen darfst</b> — Akten, Inhalte und persönliche Einträge.
        <b>Es gibt keine Vorfilter:</b> Kategorien erscheinen unten als Filter <i>auf das Ergebnis</i>, damit man
        sich keine Treffer wegklicken kann. Die <b>Smart-Suche</b> toleriert Tippfehler; der <b>Deep-Scan</b> nimmt
        alle Nebenfelder dazu (Steckbrief, Telefonnummern, Fahrzeuge, Orte, Waffen).
        Verschlusssachen erscheinen nur für die Führung.
    </SubtitleContent>
</PageHeader>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudStack Spacing="3">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudTextField @bind-Value="_text" Placeholder="Suchbegriff…" Variant="Variant.Outlined" Immediate="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          OnKeyDown="SearchKeyDown" Class="flex-grow-1 mt-0" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search"
                       OnClick="NewSearchAsync">Suchen</MudButton>
        </MudStack>

        <MudStack Row="true" Spacing="3" Class="flex-wrap" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Modus:</MudText>
            <MudTooltip Text="Findet Treffer auch bei Tippfehlern (Levenshtein + phonetischer Index).">
                <MudCheckBox T="bool" @bind-Value="_fuzzy" Label="Smart-Suche" Dense="true" Color="Color.Primary" />
            </MudTooltip>
            <MudTooltip Text="Nimmt alle Nebenfelder dazu (Steckbrief, Telefon, Fahrzeuge, Orte, Waffen) – toleranter, aber langsamer.">
                <MudCheckBox T="bool" @bind-Value="_maxMode" Label="Deep-Scan" Dense="true" Color="Color.Secondary" />
            </MudTooltip>
            <MudTooltip Text="Nimmt archivierte Akten mit auf. Standardmäßig bleiben sie außen vor.">
                <MudCheckBox T="bool" @bind-Value="_includeArchived" Label="Archiv einschließen" Dense="true" Color="Color.Default" />
            </MudTooltip>
            @if (_tags.Count > 0)
            {
                <MudSelect T="string" MultiSelection="true" @bind-SelectedValues="_tagSelection" Label="Tags" Dense="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:220px;"
                           MultiSelectionTextFunc="@(items => $"{items.Count} Tag(s)")">
                    @foreach (var t in _tags)
                    {
                        <MudSelectItem T="string" Value="@t.Id">@t.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudTooltip Text="@TagScopeHint">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mud-text-secondary" />
                </MudTooltip>
            }
        </MudStack>

        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap">
            <MudTextField @bind-Value="_saveName" Placeholder="Suche speichern als…" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Style="max-width:240px;" Class="mt-0" />
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.BookmarkAdd"
                       OnClick="SaveAsync" Disabled="@string.IsNullOrWhiteSpace(_saveName)">Speichern</MudButton>

            @if (_saved.Count > 0)
            {
                <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Gespeichert:</MudText>
                @foreach (var g in _saved)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                             Icon="@(g.IsWatched ? Icons.Material.Filled.NotificationsActive : null)"
                             OnClick="@(() => ApplyAsync(g))" OnClose="@(() => SearchDeleteAsync(g))">@ChipLabel(g)</MudChip>
                }
                @if (_mayWatch)
                {
                    <MudTooltip Text="Gespeicherte Suchen überwachen lassen">
                        <MudIconButton Icon="@Icons.Material.Filled.Tune" Size="Size.Small" aria-label="Gespeicherte Suchen verwalten"
                                       Color="@(_manageOpen ? Color.Primary : Color.Default)"
                                       OnClick="@(() => _manageOpen = !_manageOpen)" />
                    </MudTooltip>
                }
            }
        </MudStack>

        @if (_manageOpen && _mayWatch && _saved.Count > 0)
        {
            <MudDivider />
            <MudStack Spacing="1">
                <MudText Typo="Typo.subtitle2">Gespeicherte Suchen überwachen</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Eine überwachte Suche läuft etwa stündlich in deinem Namen – mit deinen Rechten von heute – und meldet
                    dir über die Glocke, was sie noch nie gefunden hatte. Der erste Lauf merkt sich nur, was es
                    schon gibt. Höchstens @SavedSearchRules.MaxWatchedPerAgent Suchen gleichzeitig.
                </MudText>
                @foreach (var g in _saved)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                        <MudSwitch T="bool" Value="g.IsWatched" ValueChanged="@(v => WatchAsync(g, v))"
                                   Color="Color.Primary" Label="@g.Name" Class="ma-0" />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Describe(g)</MudText>
                        @if (g.IsWatched)
                        {
                            <MudText Typo="Typo.caption" Class="@(g.LastRunIncomplete ? "mud-warning-text" : "mud-text-secondary")">
                                @WatchState(g)
                            </MudText>
                        }
                    </MudStack>
                }
            </MudStack>
        }
    </MudStack>
</MudPaper>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (!_searched)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">Suchbegriff eingeben oder Tags wählen und „Suchen" klicken.</MudText>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2 flex-wrap">
        <MudText Typo="Typo.subtitle1">
            @if (_facet is null)
            {
                <text>@_results.Total Treffer in @_results.Groups.Count Kategorien</text>
            }
            else
            {
                <text>@ShownCount Treffer · @SearchCatalog.Plural(_facet)</text>
            }
        </MudText>
        @if (NewShown > 0)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Class="ma-0"
                     Icon="@Icons.Material.Filled.FiberNew">@NewShown neu seit deinem letzten Blick</MudChip>
        }
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            @_results.Searched.Count von @_results.VisibleCategories Kategorien durchsucht ·
            @_results.Elapsed.TotalSeconds.ToString("0.0") s
        </MudText>
        <MudSpacer />
        @if (_facet is not null)
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Clear"
                       OnClick="@(() => FacetAsync(null))">Filter aufheben</MudButton>
        }
        @if (_mayAct)
        {
            @if (_selectMode)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Close"
                           OnClick="ExitSelect">Auswahl beenden</MudButton>
            }
            else
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Checklist"
                           Disabled="@(_results.Total == 0)" OnClick="EnterSelect">Auswählen</MudButton>
            }
        }
    </MudStack>

    @if (_results.Incomplete.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3"
                  Icon="@Icons.Material.Filled.HourglassBottom">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                <MudText Typo="Typo.body2">
                    <b>Unvollständig.</b> Das Zeitbudget war erschöpft. Diese Kategorien wurden nicht zu Ende
                    durchsucht — <b>0 Treffer heißt hier nicht „nichts da"</b>:
                    @string.Join(", ", _results.Incomplete.Select(SearchCatalog.Plural)).
                </MudText>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.Bolt" OnClick="SearchRestAsync">Rest nachladen</MudButton>
            </MudStack>
        </MudAlert>
    }

    @if (_results.Total == 0)
    {
        <EmptyState Icon="@Icons.Material.Filled.SearchOff" Title="Keine Treffer."
                    Text="@($"Durchsucht wurden {_results.Searched.Count} Kategorien — alles, was du sehen darfst.")">
            <Actions>
                @if (!_fuzzy)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Spellcheck"
                               OnClick="@(async () => { _fuzzy = true; await SearchAsync(); })">Smart-Suche einschalten</MudButton>
                }
                @if (!_maxMode)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ZoomIn"
                               OnClick="@(async () => { _maxMode = true; await SearchAsync(); })">Deep-Scan</MudButton>
                }
                @if (!_includeArchived)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Inventory2"
                               OnClick="@(async () => { _includeArchived = true; await SearchAsync(); })">Archiv einschließen</MudButton>
                }
            </Actions>
        </EmptyState>
    }
    else
    {
        @if (_results.Groups.Count > 1)
        {
            <SearchFacetBar Results="_results" Active="_facet" ActiveChanged="FacetAsync" />
        }

        <MudStack Spacing="4">
            @foreach (var group in Shown())
            {
                <div>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                        <MudIcon Icon="@SearchCatalog.Icon(group.Category)" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle1">@group.Display</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @group.Hit.Count@(group.Capped ? "+" : "")
                        </MudText>
                        @if (group.Capped)
                        {
                            <MudTooltip Text="Nur die ersten Treffer dieser Kategorie – Suche eingrenzen.">
                                <MudIcon Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" Class="mud-text-secondary" />
                            </MudTooltip>
                        }
                        @if (_selectMode && group.Hit.Any(SearchSelection.IsSelectable))
                        {
                            var whole = group.Hit.Where(SearchSelection.IsSelectable).All(h => _picked.ContainsKey(SearchSelection.Key(h)));
                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                       OnClick="@(() => PickGroup(group, !whole))">@(whole ? "Keine dieser Gruppe" : "Alle dieser Gruppe")</MudButton>
                        }
                    </MudStack>
                    <MudStack Spacing="2">
                        @foreach (var t in group.Hit)
                        {
                            <SearchHitRow Hit="t" SelectMode="_selectMode" Selectable="@SearchSelection.IsSelectable(t)"
                                          Picked="@_picked.ContainsKey(SearchSelection.Key(t))" OnToggle="Toggle"
                                          IsNew="@_newKeys.Contains(SavedSearchRules.Key(t))" />
                        }
                    </MudStack>
                </div>
            }
        </MudStack>
    }
}

@* outside the result branches: the picks survive a running search *@
@if (_mayAct && _selectMode)
{
    <SearchSelectionBar Picked="_picked.Values" OutsideResults="OutsideResults" User="_user"
                        OnAll="PickAllShown" OnNone="PickNone" OnRemove="Toggle" />
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "q")] private string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "kat")] private string? Kat { get; set; }

    private ClaimsPrincipal _user = default!;
    private string? _agentId;

    private string _text = string.Empty;
    private bool _fuzzy;
    private bool _maxMode;
    private bool _includeArchived;
    private string? _facet;
    private IReadOnlyCollection<string> _tagSelection = new HashSet<string>();
    private string _saveName = string.Empty;

    private bool _load;
    private bool _searchingNow;
    private bool _againSearch;
    private bool _searched;
    private SearchResults _results = SearchResults.None;
    private List<Tag> _tags = new();
    private List<SavedSearch> _saved = new();

    private string? _appliedQ;
    private bool _parametersSeen;

    // watching: internal writers only, the service asks again
    private bool _mayWatch;
    private bool _manageOpen;
    // hits a watch reported since the last look; cleared in the database after an interactive render
    private HashSet<string> _newKeys = new(StringComparer.Ordinal);
    private (string Id, string Json)? _pendingSeen;

    // selection mode: only for agents who may write, and never cleared by a new search
    private bool _mayAct;
    private bool _selectMode;
    private readonly Dictionary<string, SearchHit> _picked = new(StringComparer.Ordinal);

    /// <summary>Derived, not hand-written: a hardcoded list of tagless categories goes stale on the next one.</summary>
    private static readonly string TagScopeHint =
        "Ein Tag-Filter wirkt nur auf Kategorien mit Stichwort-Zuordnung. Ohne Zuordnung und damit ausgelassen: "
        + string.Join(", ", SearchCatalog.Categories
            .Where(c => !c.Has(SearchTraits.Tagged)).Select(c => c.Plural)) + ".";

    private IEnumerable<SearchResultGroup> Shown()
        => _facet is null ? _results.Groups : _results.Groups.Where(g => g.Category == _facet);

    private int ShownCount => Shown().Sum(g => g.Hit.Count);

    private int NewShown => _newKeys.Count == 0 ? 0
        : Shown().SelectMany(g => g.Hit).Select(SavedSearchRules.Key).Distinct().Count(_newKeys.Contains);

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _agentId = _user.GetAgentId();
        _mayAct = _user.MayWrite();
        _mayWatch = SavedSearchRules.MayWatch(_user);
        // partners: no internal tag vocabulary
        if (!_user.IsPartner())
        {
            _tags = await TagService.GetAllAsync();
        }
        await SavedLoadAsync();
        Nav.LocationChanged += OnLocationChanged;
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    protected override async Task OnParametersSetAsync()
    {
        // a watch report links here. Opened here on load only; later navigations of this instance go through
        // OnLocationChanged, since a second click on the same notice changes no parameter at all. Nav.Uri keeps the
        // link after replaceState, so the query below would otherwise be read again on every parameter pass
        var first = !_parametersSeen;
        _parametersSeen = true;
        if (SavedFromUri(Nav.Uri) is { } savedId)
        {
            if (first)
            {
                _appliedQ = Q;
                await OpenSavedAsync(savedId);
            }
            return;
        }

        // real navigations only: QueryState.WriteAsync goes through replaceState, which raises no LocationChanged
        if (Q == _appliedQ)
        {
            return;
        }
        _appliedQ = Q;
        _facet = Kat is { Length: > 0 } && SearchCatalog.Find(Kat) is not null ? Kat : null;
        if (!string.IsNullOrWhiteSpace(Q))
        {
            _text = Q;
            await SearchAsync();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (SavedFromUri(e.Location) is { } savedId)
        {
            _ = InvokeAsync(async () =>
            {
                try
                {
                    await OpenSavedAsync(savedId);
                    StateHasChanged();
                }
                catch { /* best effort */ }
            });
        }
    }

    /// <summary>The saved search a link to this page names, if any.</summary>
    private static string? SavedFromUri(string uri)
    {
        var parsed = new Uri(uri);
        return string.Equals(parsed.AbsolutePath.TrimEnd('/'), "/suche", StringComparison.OrdinalIgnoreCase)
               && QueryHelpers.ParseQuery(parsed.Query).TryGetValue("gespeichert", out var id)
               && !string.IsNullOrWhiteSpace(id) ? id.ToString() : null;
    }

    /// <summary>Applies one of the agent's own searches by id; only their own are in the list.</summary>
    private async Task OpenSavedAsync(string id)
    {
        await SavedLoadAsync();
        if (_saved.FirstOrDefault(s => s.Id == id) is { } saved)
        {
            await ApplyAsync(saved);
        }
        else
        {
            Snackbar.Add("Diese gespeicherte Suche gibt es nicht mehr.", Severity.Info);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // never while prerendering, and only once the hits are on screen: a mark cleared before that is never seen
        if (_pendingSeen is not { } seen || _load || !_searched)
        {
            return;
        }
        _pendingSeen = null;
        try
        {
            await SavedSearchService.MarkSeenAsync(seen.Id, seen.Json, _user);
            await SavedLoadAsync();
            StateHasChanged();
        }
        catch { /* best effort */ }
    }

    private async Task SavedLoadAsync()
    {
        if (_agentId is not null)
        {
            _saved = await SavedSearchService.GetForAgentAsync(_agentId);
        }
    }

    private async Task SearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await NewSearchAsync();
        }
    }

    /// <summary>A search the agent typed; the marks of a saved search belong to that search only.</summary>
    private Task NewSearchAsync()
    {
        _newKeys = new HashSet<string>(StringComparer.Ordinal);
        _pendingSeen = null;
        return SearchAsync();
    }

    private SearchCriteria BuildCriteria() => new()
    {
        Text = _text,
        Facet = _facet,
        TagIds = _tagSelection.ToList(),
        Fuzzy = _fuzzy,
        MaxMode = _maxMode,
        IncludeArchived = _includeArchived,
        // Categories stays empty: the page never pre-filters, so nothing can be hidden from the reader
    };

    private async Task SearchAsync()
    {
        // a search already runs; queue a rerun instead of overlapping
        if (_searchingNow)
        {
            _againSearch = true;
            return;
        }

        _searchingNow = true;
        _load = true;
        StateHasChanged();
        try
        {
            do
            {
                _againSearch = false;
                _results = await SearchService.SearchAsync(BuildCriteria(), _user);
                _searched = true;
                await StampSearchAsync();
            }
            while (_againSearch);
            await UrlAsync();
        }
        catch (Exception ex)
        {
            // surface the error instead of hanging the spinner
            _results = SearchResults.None;
            _searched = true;
            // nothing was shown, so the new-marks stay for the next look
            _pendingSeen = null;
            Snackbar.Add($"Suche fehlgeschlagen: {ex.Message}", Severity.Error);
        }
        finally
        {
            _load = false;
            _searchingNow = false;
        }
    }

    /// <summary>The onboarding marker for "searched once"; there is no search log to mine it from later.</summary>
    private async Task StampSearchAsync()
    {
        if (_agentId is not { Length: > 0 } id || !_user.IsInternalAgent())
        {
            return;
        }
        try { await NavPrefs.MarkOnboardingStepAsync(id, Onboarding.StepSearch); } catch { /* best effort */ }
    }

    /// <summary>Re-runs only the categories the budget cut off and merges them in.</summary>
    /// <remarks>The one place the page restricts categories server-side — and it says so on a button rather than
    /// doing it silently.</remarks>
    private async Task SearchRestAsync()
    {
        if (_results.Incomplete.Count == 0)
        {
            return;
        }
        _load = true;
        StateHasChanged();
        try
        {
            var criteria = BuildCriteria();
            criteria.Categories = _results.Incomplete.ToList();
            var rest = await SearchService.SearchAsync(criteria, _user);
            var groups = _results.Groups
                .Where(g => !_results.Incomplete.Contains(g.Category))
                .Concat(rest.Groups)
                .OrderBy(g => SearchCatalog.Index(g.Category))
                .ToList();
            _results = new SearchResults(groups, groups.Sum(g => g.Hit.Count),
                _results.Searched.Concat(rest.Searched).Distinct().ToList(),
                rest.Incomplete, _results.VisibleCategories, _results.Elapsed + rest.Elapsed);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nachladen fehlgeschlagen: {ex.Message}", Severity.Error);
        }
        finally
        {
            _load = false;
        }
    }

    private int OutsideResults
    {
        get
        {
            var shown = _results.Groups.SelectMany(g => g.Hit).Select(SearchSelection.Key).ToHashSet(StringComparer.Ordinal);
            return _picked.Keys.Count(k => !shown.Contains(k));
        }
    }

    private void EnterSelect()
    {
        if (_mayAct)
        {
            _selectMode = true;
        }
    }

    private void ExitSelect()
    {
        _selectMode = false;
        _picked.Clear();
    }

    private void Toggle(SearchHit hit)
    {
        if (!_mayAct || !SearchSelection.IsSelectable(hit))
        {
            return;
        }
        if (!_picked.Remove(SearchSelection.Key(hit)))
        {
            Pick([hit]);
        }
    }

    private void PickGroup(SearchResultGroup group, bool pick)
    {
        if (!_mayAct)
        {
            return;
        }
        if (pick)
        {
            Pick(group.Hit);
            return;
        }
        foreach (var hit in group.Hit)
        {
            _picked.Remove(SearchSelection.Key(hit));
        }
    }

    private void PickAllShown()
    {
        if (_mayAct)
        {
            Pick(Shown().SelectMany(g => g.Hit));
        }
    }

    private void PickNone() => _picked.Clear();

    /// <summary>Adds selectable hits up to the batch cap and says so when it stops short.</summary>
    private void Pick(IEnumerable<SearchHit> hits)
    {
        var full = false;
        foreach (var hit in hits.Where(SearchSelection.IsSelectable))
        {
            if (_picked.ContainsKey(SearchSelection.Key(hit)))
            {
                continue;
            }
            if (_picked.Count >= RecordBatch.Max)
            {
                full = true;
                break;
            }
            _picked[SearchSelection.Key(hit)] = hit;
        }
        if (full)
        {
            Snackbar.Add($"Höchstens {RecordBatch.Max} Akten auf einmal.", Severity.Warning);
        }
    }

    private Task FacetAsync(string? category)
    {
        // no re-query: Shown() filters the groups already fetched
        _facet = category;
        return UrlAsync();
    }

    private async Task UrlAsync()
    {
        await QueryState.WriteAsync(JS, Nav, ("q", _text), ("kat", _facet), ("gespeichert", null));
        // replaceState raises no LocationChanged, so Q still holds the old value. Without this the guard in
        // OnParametersSetAsync swallows the next real navigation from the header search box.
        _appliedQ = string.IsNullOrWhiteSpace(_text) ? null : _text;
    }

    private async Task SaveAsync()
    {
        if (_agentId is null)
        {
            return;
        }
        try
        {
            await SavedSearchService.SaveAsync(_agentId, _saveName, BuildCriteria(), _user);
            Snackbar.Add($"Suche „{_saveName.Trim()}“ gespeichert.", Severity.Success);
            _saveName = string.Empty;
            await SavedLoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ApplyAsync(SavedSearch g)
    {
        // a run may have added marks since the list loaded
        await SavedLoadAsync();
        g = _saved.FirstOrDefault(s => s.Id == g.Id) ?? g;
        if (SavedSearchRules.Parse(g.SearchParameterJson) is not { } k)
        {
            return;
        }

        _text = k.Text ?? string.Empty;
        _tagSelection = new HashSet<string>(k.TagIds ?? new());
        _fuzzy = k.Fuzzy;
        _maxMode = k.MaxMode;
        _includeArchived = k.IncludeArchived;
        _facet = SavedSearchRules.FacetOf(k);

        if (k.Facet is null && k.Categories is { Count: > 1 })
        {
            Snackbar.Add("Diese gespeicherte Suche stammt aus der alten Kategorie-Auswahl. Es wird jetzt immer "
                + "alles Sichtbare durchsucht; Kategorien filtern nur das Ergebnis.", Severity.Info);
        }

        _newKeys = SavedSearchRules.ReadKeys(g.UnseenHitsJson).ToHashSet(StringComparer.Ordinal);
        _pendingSeen = _newKeys.Count > 0 ? (g.Id, g.UnseenHitsJson!) : null;
        await SearchAsync();
    }

    private async Task WatchAsync(SavedSearch g, bool watched)
    {
        try
        {
            await SavedSearchService.SetWatchedAsync(g.Id, watched, _user);
            Snackbar.Add(watched
                ? $"„{g.Name}“ wird überwacht. Neue Treffer meldet die Glocke."
                : $"„{g.Name}“ wird nicht mehr überwacht.", Severity.Success);
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        await SavedLoadAsync();
    }

    private static string ChipLabel(SavedSearch g)
    {
        var unseen = SavedSearchRules.ReadKeys(g.UnseenHitsJson).Count;
        return unseen > 0 ? $"{g.Name} · {unseen} neu" : g.Name;
    }

    /// <summary>What a saved search asks for, in one line.</summary>
    private static string Describe(SavedSearch g)
    {
        if (SavedSearchRules.Parse(g.SearchParameterJson) is not { } k)
        {
            return "nicht lesbar";
        }
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(k.Text))
        {
            parts.Add($"„{k.Text.Trim()}“");
        }
        if (k.TagIds.Count > 0)
        {
            parts.Add(k.TagIds.Count == 1 ? "1 Tag" : $"{k.TagIds.Count} Tags");
        }
        if (SavedSearchRules.FacetOf(k) is { } facet)
        {
            parts.Add($"nur {SearchCatalog.Plural(facet)}");
        }
        if (k.Fuzzy)
        {
            parts.Add("Smart-Suche");
        }
        if (k.MaxMode)
        {
            parts.Add("Deep-Scan");
        }
        if (k.IncludeArchived)
        {
            parts.Add("mit Archiv");
        }
        return string.Join(" · ", parts);
    }

    private static string WatchState(SavedSearch g)
    {
        if (g.LastCheckedAt is not { } at)
        {
            return "Wartet auf den ersten Lauf.";
        }
        var text = $"Zuletzt geprüft {at.ToLocalTime():dd.MM. HH:mm}";
        return g.LastRunIncomplete ? text + " – die Zeit reichte nicht für alle Kategorien." : text + ".";
    }

    private async Task SearchDeleteAsync(SavedSearch g)
    {
        if (_agentId is null)
        {
            return;
        }
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Gespeicherte Suche löschen?",
            $"„{g.Name}“ wird dauerhaft entfernt.");
        if (!ok)
        {
            return;
        }
        await SavedSearchService.DeleteAsync(g.Id, _agentId);
        Snackbar.Add($"Suche „{g.Name}“ gelöscht.", Severity.Success);
        await SavedLoadAsync();
    }
}
