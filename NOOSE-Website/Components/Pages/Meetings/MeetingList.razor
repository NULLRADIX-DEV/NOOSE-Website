@page "/besprechungen"
@using NOOSE_Website.Models.Navigation
@attribute [Authorize(Policy = Policies.InternalAgent)]
@inject IMeetingService MeetingService
@inject NavigationManager Nav

<PageTitle>Besprechungen – FIB</PageTitle>

@* page title with the h5 it always had (PageHeader would make it h4 on desktop): below 960px the row wraps, below
   600px the large icon goes and the column choice for the table appears beside the main action *@
<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4 noose-kopf-umbruch">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Primary" Size="Size.Large" Class="noose-mobil-aus" />
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Besprechungen</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Alle Besprechungen der Behörde, dauerhaft archiviert.
            </MudText>
        </MudStack>
    </MudStack>
    <div class="d-flex align-center gap-2">
        <MobileColumnPicker ListKey="besprechungen" Columns="PhoneColumns" Defaults="PhoneDefaults"
                            VisibleChanged="@(v => _phoneColumns = v)" />
        @if (_mayCreate)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                       Href="/besprechungen/neu">Neue Besprechung</MudButton>
        }
    </div>
</MudStack>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_list.Count == 0)
{
    <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined">Es gibt noch keine Besprechungen.</MudAlert>
}
else
{
    @* a table on phones too: fewer columns (the agent's choice) instead of stacked cards *@
    <MudTable Items="_list" Dense="true" Hover="true" Breakpoint="Breakpoint.None" Elevation="1"
              OnRowClick="@((TableRowClickEventArgs<MeetingListItem> e) => Open(e.Item))" T="MeetingListItem"
              Style="cursor:pointer;">
        <HeaderContent>
            <MudTh Class="@Col("aktenzeichen")">Aktenzeichen</MudTh>
            <MudTh Class="@Col("titel")">Titel</MudTh>
            <MudTh Class="@Col("beginn")">Beginn</MudTh>
            <MudTh Class="@Col("ort")">Ort</MudTh>
            <MudTh Class="@Col("tops")">TOPs</MudTh>
            <MudTh Class="@Col("status")">Status</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Aktenzeichen" Class="@Col("aktenzeichen")">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.CaseNumber</MudText>
            </MudTd>
            <MudTd DataLabel="Titel" Class="@Col("titel")">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="noose-kopf-umbruch">
                    <b>@context.Title</b>
                    @if (context.OwnSignedOff)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined"
                                 Icon="@Icons.Material.Filled.EventBusy">Abgemeldet</MudChip>
                    }
                </MudStack>
            </MudTd>
            <MudTd DataLabel="Beginn" Class="@Col("beginn")">@MeetingTime.Local(context.Start).ToString("dd.MM.yyyy HH:mm")</MudTd>
            <MudTd DataLabel="Ort" Class="@Col("ort")">@(context.Location ?? "—")</MudTd>
            <MudTd DataLabel="TOPs" Class="@Col("tops")">@context.AgendaCount</MudTd>
            <MudTd DataLabel="Status" Class="@Col("status")"><MeetingStatusChip Status="@context.Status" /></MudTd>
        </RowTemplate>
    </MudTable>

    @if (_total > _list.Count)
    {
        <MudStack Row="true" Justify="Justify.Center" Class="mt-4">
            <MudButton Variant="Variant.Outlined" OnClick="MoreAsync">Weitere laden (@_list.Count / @_total)</MudButton>
        </MudStack>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private const int PageSize = 50;

    private List<MeetingListItem> _list = new();
    private bool _load = true;
    private int _total;
    private string? _meId;
    private bool _mayCreate;

    /// <summary>The table's columns for the phone column picker, in table order.</summary>
    private static readonly IReadOnlyList<(string Key, string Label)> PhoneColumns =
    [
        ("aktenzeichen", "Aktenzeichen"), ("titel", "Titel"), ("beginn", "Beginn"), ("ort", "Ort"), ("tops", "TOPs"),
        ("status", "Status"),
    ];

    /// <summary>What a phone shows until the agent chooses: title and start.</summary>
    private static readonly IReadOnlyList<string> PhoneDefaults = ["titel", "beginn"];

    // the defaults until the picker reports the stored choice, so even the first paint is narrow on a phone
    private IReadOnlySet<string> _phoneColumns = MobileColumnSet.Resolve(PhoneColumns.Select(c => c.Key).ToList(), PhoneDefaults, null);

    // below 600px only; from 600px up every column shows, as before
    private string Col(string key) => MobileColumnSet.ClassFor(_phoneColumns, key);

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateTask!).User;
        _meId = user.GetAgentId();
        // rank AND write, matching Permission.RequireMeetingWrite
        _mayCreate = user.MayHighestClassification() && user.MayWrite();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _load = true;
        _total = await MeetingService.GetCountAsync();
        _list = await MeetingService.GetListAsync(_meId, take: PageSize);
        _load = false;
    }

    private async Task MoreAsync()
    {
        var more = await MeetingService.GetListAsync(_meId, skip: _list.Count, take: PageSize);
        _list.AddRange(more);
    }

    private void Open(MeetingListItem? item)
    {
        if (item is not null)
        {
            Nav.NavigateTo($"/besprechungen/{item.Id}");
        }
    }
}
