@inject IMeetingService MeetingService
@inject ILinkService LinkService
@inject IMeetingMeasureService Measures
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @if (CanEdit)
    {
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
            <MudTextField @bind-Value="_newTitle" Label="Neuer Tagesordnungspunkt" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="300" Immediate="true" Class="flex-grow-1" />
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddAsync" Disabled="@(string.IsNullOrWhiteSpace(_newTitle))">Hinzufügen</MudButton>
        </MudStack>
    }

    @if (_items.Count == 0)
    {
        <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined">Noch keine Tagesordnungspunkte.</MudAlert>
    }
    else
    {
        @* single expansion: the one-editor auto-save model relies on the previous panel collapsing *@
        <MudExpansionPanels MultiExpansion="false" Dense="true" Elevation="1">
            @for (var i = 0; i < _items.Count; i++)
            {
                var item = _items[i];
                var index = i;
                <div id="@($"top-{item.Id}")">
                    <MudExpansionPanel Expanded="@(_expandedId == item.Id)"
                                       ExpandedChanged="@(open => ExpandedAsync(item.Id, open))">
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">@(index + 1).</MudText>

                                @if (CanNote)
                                {
                                    <div @onclick:stopPropagation="true">
                                        <MudCheckBox T="bool" Value="@item.Done" Dense="true" Color="Color.Success"
                                                     ValueChanged="@(v => DoneAsync(item, v))" />
                                    </div>
                                }
                                else if (item.Done)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                }

                                <MudText Typo="Typo.body1"
                                         Style="@(item.Done ? "text-decoration:line-through;opacity:.6;" : null)">
                                    @item.Title
                                </MudText>

                                @foreach (var link in Chips(item.Id))
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info"
                                             Href="@link.Href">@link.OtherDesignation</MudChip>
                                }
                                @if (Extra(item.Id) is var extra && extra > 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">+@extra</MudChip>
                                }

                                @* every measure, not a capped few: the point is seeing what came of each decision *@
                                @foreach (var measure in MeasuresOf(item.Id))
                                {
                                    <MudTooltip Text="@MeasureTooltip(measure)">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                 Color="@MeasureColour(measure)" Href="@measure.Href"
                                                 Icon="@MeetingMeasureKindDisplay.Icon(measure.Kind)">
                                            @MeasureLabel(measure)
                                        </MudChip>
                                    </MudTooltip>
                                }

                                @if (CanEdit)
                                {
                                    <div @onclick:stopPropagation="true">
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                                                       Disabled="@(index == 0)"
                                                       OnClick="@(() => MoveAsync(item.Id, -1))" aria-label="Nach oben" />
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                                                       Disabled="@(index == _items.Count - 1)"
                                                       OnClick="@(() => MoveAsync(item.Id, 1))" aria-label="Nach unten" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                       OnClick="@(() => RemoveAsync(item))" aria-label="Punkt löschen" />
                                    </div>
                                }
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            @if (_expandedId == item.Id)
                            {
                                <MudText Typo="Typo.subtitle2" Class="mb-2">Notiz</MudText>
                                @if (CanNote)
                                {
                                    <RichTextEditor @ref="_itemEditor" @key="item.Id" Value="@_noteHtml" MinHeight="220px" Ai="TextAssistContext.AgendaNote" AiSubject="@item.Title" Mentions="true"
                                                    DraftKey='@($"tagesordnung:{item.Id}")' />
                                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-2">
                                        <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                                   OnClick="@(() => NoteSaveAsync(item))" Disabled="@_saving">
                                            Notiz speichern
                                        </MudButton>
                                    </MudStack>
                                }
                                else if (!string.IsNullOrWhiteSpace(_noteHtml))
                                {
                                    <RichHtml Html="@_noteHtml" />
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Keine Notiz erfasst.</MudText>
                                }

                                @if (CanNote)
                                {
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-3">
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.AddTask"
                                                   OnClick="@(() => MeasureAsync(item))">Maßnahme</MudButton>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            Aufgabe oder Wiedervorlage aus diesem Punkt; ihr Stand steht danach am Punkt.
                                        </MudText>
                                    </MudStack>
                                }

                                <MudDivider Class="my-3" />
                                <RecordLinksPanel EntityType="@nameof(MeetingAgendaItem)" EntityId="@item.Id" User="User" />
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                </div>
            }
        </MudExpansionPanels>
    }
}

@code {
    [Parameter, EditorRequired] public string MeetingId { get; set; } = default!;
    [Parameter, EditorRequired] public ClaimsPrincipal User { get; set; } = default!;

    /// <summary>Rank 3+ may add, rename, reorder and remove items.</summary>
    [Parameter] public bool CanEdit { get; set; }

    /// <summary>Leadership may write notes and tick items off.</summary>
    [Parameter] public bool CanNote { get; set; }

    private const int ChipLimit = 3;

    private List<MeetingAgendaItem> _items = new();
    private Dictionary<string, IReadOnlyList<LinkDisplay>> _links = new();
    private Dictionary<string, IReadOnlyList<MeetingMeasureRow>> _measures = new();
    private RichTextEditor? _itemEditor;
    private string? _expandedId;
    private string _noteHtml = string.Empty;
    private string? _newTitle;
    private bool _load = true;
    private bool _saving;
    private ViewerScope _scope;

    protected override async Task OnInitializedAsync()
    {
        _scope = ViewerScope.From(User);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _load = true;
        _items = await MeetingService.GetAgendaAsync(MeetingId, _scope);
        // one bulk query instead of a RecordLinksPanel per item
        _links = await MeetingService.GetAgendaLinksAsync(MeetingId, _scope);
        try
        {
            _measures = await Measures.GetForMeetingAsync(MeetingId, User);
        }
        catch (Exception)
        {
            // the status chips are extra; the agenda itself must still load
            _measures = new();
        }
        _load = false;
    }

    private IEnumerable<LinkDisplay> Chips(string itemId)
        => _links.TryGetValue(itemId, out var list) ? list.Take(ChipLimit) : Enumerable.Empty<LinkDisplay>();

    private IReadOnlyList<MeetingMeasureRow> MeasuresOf(string itemId)
        => _measures.TryGetValue(itemId, out var list) ? list : [];

    private static bool Overdue(MeetingMeasureRow measure)
        => !measure.Done && measure.DueAt is { } due && due.Date < DateTime.Now.Date;

    private static Color MeasureColour(MeetingMeasureRow measure)
        => measure.Done ? Color.Success : Overdue(measure) ? Color.Error : Color.Default;

    private static string MeasureLabel(MeetingMeasureRow measure)
    {
        var parts = new List<string> { measure.ResponsibleCodename ?? MeetingMeasureKindDisplay.Name(measure.Kind) };
        if (!measure.Done && measure.DueAt is { } due)
        {
            parts.Add($"bis {due:dd.MM.}");
        }
        parts.Add(measure.Status);
        return string.Join(" · ", parts);
    }

    private static string MeasureTooltip(MeetingMeasureRow measure)
        => $"{MeetingMeasureKindDisplay.Name(measure.Kind)}: {measure.Title}";

    private async Task MeasureAsync(MeetingAgendaItem item)
    {
        var input = await MeetingMeasureDialog.ShowAsync(DialogService, item.Title, User.MayRealNameSee());
        if (input is null)
        {
            return;
        }
        await RunAsync(async () =>
        {
            await Measures.CreateAsync(item.Id, input, User);
            Snackbar.Add($"{MeetingMeasureKindDisplay.Name(input.Kind)} angelegt.", Severity.Success);
        });
    }

    private int Extra(string itemId)
        => _links.TryGetValue(itemId, out var list) ? Math.Max(0, list.Count - ChipLimit) : 0;

    // load first, flip state last: the editor reads Value only in OnAfterRenderAsync(firstRender)
    private async Task ExpandedAsync(string itemId, bool open)
    {
        if (!open)
        {
            // only when this really is the open one: on a direct switch the panel component may report the
            // close of the old point after the open of the new, and clearing then shut the new one again
            if (_expandedId != itemId)
            {
                return;
            }
            // save before the editor unmounts, otherwise the typed text is gone silently
            await NoteSaveIfDirtyAsync(itemId);
            _expandedId = null;
            _itemEditor = null;
            return;
        }
        // whichever order the two events arrive in, the note that was open is written before it is dropped
        if (_expandedId is { } offen && offen != itemId)
        {
            await NoteSaveIfDirtyAsync(offen);
            _itemEditor = null;
        }
        var html = await MeetingService.GetItemNoteAsync(itemId, _scope) ?? string.Empty;
        _noteHtml = html;
        _expandedId = itemId;
    }

    /// <summary>Auto-saves the open note when it differs from what was loaded.</summary>
    private async Task NoteSaveIfDirtyAsync(string itemId)
    {
        if (!CanNote || _itemEditor is null || _expandedId != itemId)
        {
            return;
        }
        var item = _items.FirstOrDefault(p => p.Id == itemId);
        if (item is null)
        {
            return;
        }
        try
        {
            var html = await _itemEditor.GetHtmlAsync();
            // the loaded value is already sanitized, so compare on the sanitized form to avoid false dirties
            if (string.Equals(HtmlCleanup.Clean(html), _noteHtml, StringComparison.Ordinal))
            {
                return;
            }
            await MeetingService.AgendaItemNoteAsync(itemId, html, item.Done, User);
            await _itemEditor.MarkSavedAsync();
            _noteHtml = HtmlCleanup.Clean(html);
            Snackbar.Add("Notiz automatisch gespeichert.", Severity.Info);
            await LoadAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private async Task NoteSaveAsync(MeetingAgendaItem item)
    {
        if (_itemEditor is null)
        {
            return;
        }
        _saving = true;
        try
        {
            // read the definitive HTML straight from Quill
            var html = await _itemEditor.GetHtmlAsync();
            await MeetingService.AgendaItemNoteAsync(item.Id, html, item.Done, User);
            await _itemEditor.MarkSavedAsync();
            _noteHtml = html;
            Snackbar.Add("Notiz gespeichert.", Severity.Success);
            await LoadAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DoneAsync(MeetingAgendaItem item, bool done)
    {
        // the open editor holds the newest text, so keep it when only the flag flips
        var open = _expandedId == item.Id ? _itemEditor : null;
        var html = open is not null ? await open.GetHtmlAsync() : item.NotesHtml;
        await RunAsync(async () =>
        {
            await MeetingService.AgendaItemNoteAsync(item.Id, html, done, User);
            // only a stored note is the new baseline: after a failed save the collapse still has to save it
            if (open is not null)
            {
                await open.MarkSavedAsync();
                _noteHtml = HtmlCleanup.Clean(html);
            }
        });
    }

    private async Task AddAsync()
    {
        var title = _newTitle;
        if (string.IsNullOrWhiteSpace(title))
        {
            return;
        }
        _newTitle = null;
        await RunAsync(() => MeetingService.AgendaItemCreateAsync(MeetingId, new MeetingAgendaItemInput { Title = title }, User));
    }

    private Task MoveAsync(string itemId, int delta)
        => RunAsync(() => MeetingService.AgendaItemMoveAsync(itemId, delta, User));

    private async Task RemoveAsync(MeetingAgendaItem item)
    {
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Tagesordnungspunkt löschen?",
            $"„{item.Title}“ wird entfernt. Verknüpfungen dieses Punktes gehen dabei verloren.");
        if (!ok)
        {
            return;
        }
        if (_expandedId == item.Id)
        {
            _expandedId = null;
            _itemEditor = null;
        }
        await RunAsync(() => MeetingService.AgendaItemRemoveAsync(item.Id, User));
    }

    /// <summary>Runs a write and surfaces the service's German message instead of a circuit error.</summary>
    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
            await LoadAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }
}
