@page "/feedback"
@attribute [Authorize(Policy = Policies.InternalAgent)]

<PageTitle>Feedback · FIB</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.Feedback"
            Title="Feedback"
            Subtitle="Fehler, Ideen und Wünsche zur Website melden; jeder Agent sieht alle Meldungen, die Führung entscheidet." />

<RecordSectionRail>
    <RecordSection Slug="melden" Label="Melden" Icon="@Icons.Material.Filled.Feedback">
        <FeedbackForm />
    </RecordSection>

    @* the panel loads itself, so a freshly filed report shows up without a page reload *@
    <RecordSection Slug="meine" Label="Meine Meldungen" Icon="@Icons.Material.Filled.Person">
        <FeedbackListPanel Inbox="false" />
    </RecordSection>

    @* open to every internal agent; the page policy already keeps partners out *@
    <RecordSection Slug="eingang" Label="Alle Meldungen" Icon="@Icons.Material.Filled.Inbox">
        <FeedbackListPanel Inbox="true" />
    </RecordSection>
</RecordSectionRail>
