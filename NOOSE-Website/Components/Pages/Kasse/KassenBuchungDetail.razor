@page "/kasse/buchung/{Id}"
@attribute [Authorize(Policy = Policies.InternalAgent)]
@inject IKassenService Kasse
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>@(_display?.Buchung.CaseNumber ?? "Buchung") · FIB</PageTitle>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_display is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Buchung nicht gefunden.</MudAlert>
}
else
{
    var b = _display.Buchung;

    @* the hand-built record bar stays (its h5 title with chips has no PageHeader form, and the desktop keeps its
       look); below 960px it wraps, print and delete give way to the ⋮ menu, each entry behind its button's check *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4 noose-kopf-umbruch">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/kasse" aria-label="Zurück" />
        <MudChip T="string" Size="Size.Small" Color="@KassenKontoDisplay.Colour(b.Account)"
                 Icon="@KassenKontoDisplay.Icon(b.Account)">@KassenKontoDisplay.Name(b.Account)</MudChip>
        <MudChip T="string" Size="Size.Small" Color="@KassenBuchungArtDisplay.ChipColor(b.Kind)"
                 Icon="@KassenBuchungArtDisplay.Icon(b.Kind)">@KassenBuchungArtDisplay.Name(b.Kind)</MudChip>
        <MudText Typo="Typo.h5">@b.CaseNumber</MudText>
        <MudSpacer />
        <div class="d-contents noose-schmal-aus">
            <MudTooltip Text="Druckansicht">
                <MudIconButton Icon="@Icons.Material.Filled.Print" Href="@($"/kasse/buchung/{b.Id}/druck")" Target="_blank"
                               aria-label="Druckansicht öffnen" />
            </MudTooltip>
        </div>
        <AuthorizeView Policy="@Policies.Leadership" Context="edit">
            <MudButton Href="@($"/kasse/buchung/{b.Id}/bearbeiten")" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Edit">Bearbeiten</MudButton>
            <div class="d-contents noose-schmal-aus">
                <MudButton Color="Color.Error" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="DeleteAsync">Löschen</MudButton>
            </div>
        </AuthorizeView>
        <HeaderMenu>
            <MudMenuItem Icon="@Icons.Material.Filled.Print" Href="@($"/kasse/buchung/{b.Id}/druck")" Target="_blank">Druckansicht</MudMenuItem>
            <AuthorizeView Policy="@Policies.Leadership" Context="editMenu">
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="DeleteAsync">Löschen</MudMenuItem>
            </AuthorizeView>
        </HeaderMenu>
    </MudStack>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudGrid>
            <MudItem xs="6" sm="6" md="3">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">
                    @(b.Kind == KassenBuchungArt.Auszahlung ? "Abgebucht" : b.Kind == KassenBuchungArt.Einzahlung ? "Eingezahlt" : "Korrektur")
                </MudText>
                <MudText Typo="Typo.h6" Color="@KassenBuchungArtDisplay.ChipColor(b.Kind)">
                    @(b.Kind == KassenBuchungArt.Korrektur ? Money.Format(b.Amount) : Money.Signed(_display.Delta))
                </MudText>
            </MudItem>
            <MudItem xs="6" sm="6" md="3">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Neuer Stand</MudText>
                <MudText Typo="Typo.h6">@Money.Format(_display.BalanceAfter)</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Gebucht von</MudText>
                <MudText Typo="Typo.body1">@_display.BookedByCodename</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Zeitpunkt</MudText>
                <MudText Typo="Typo.body1">@b.Timestamp.ToLocalTime().ToString("dddd, d. MMMM yyyy 'um' HH:mm")</MudText>
            </MudItem>
        </MudGrid>

        @if (!string.IsNullOrWhiteSpace(b.Reason))
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.overline" Class="mud-text-secondary">Grund</MudText>
            <MudText Typo="Typo.body1">@b.Reason</MudText>
        }

        @if (_display.FinancingRequestId is { } financingId)
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.overline" Class="mud-text-secondary">Finanzierungsantrag</MudText>
            <MudLink Href="@($"/finanzierungen/{financingId}")" Typo="Typo.body1" Class="d-block">
                @(_display.FinancingCaseNumber ?? "Antrag öffnen")
            </MudLink>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Diese Auszahlung hat der Antrag gebucht. Rückgängig bitte dort über „Auszahlung stornieren“,
                sonst laufen Antrag und Kassenstand auseinander.
            </MudText>
        }
    </MudPaper>

    <RecordSectionRail>
        <RecordSection Slug="kommentare" Label="Kommentare" Icon="@Icons.Material.Filled.Comment">
            <CommentPanel EntityType="@nameof(KassenBuchung)" EntityId="@b.Id" User="_user" />
        </RecordSection>
        <RecordSection Slug="historie" Label="Zeitstrahl" Icon="@Icons.Material.Filled.Timeline">
            <TimelinePanel EntityType="@nameof(KassenBuchung)" EntityId="@b.Id" User="_user" @key="_historyKey" />
        </RecordSection>
    </RecordSectionRail>
}

@code {
    [Parameter] public string Id { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;
    private KassenBuchungDisplay? _display;
    private ClaimsPrincipal _user = default!;
    private Guid _historyKey = Guid.NewGuid();
    private string? _loadedId;

    protected override async Task OnInitializedAsync() => _user = (await AuthStateTask).User;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }
        _loadedId = Id;
        _load = true;
        _display = await Kasse.GetDisplayAsync(Id);
        _load = false;
    }

    private async Task DeleteAsync()
    {
        if (_display is null)
        {
            return;
        }
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Buchung löschen?",
            "Die Buchung wird in den Papierkorb verschoben und kann von der Führung wiederhergestellt werden. Der Kontostand wird neu berechnet.");
        if (!ok)
        {
            return;
        }
        try
        {
            await Kasse.DeleteAsync(_display.Buchung.Id, _user);
            Snackbar.Add("Buchung in den Papierkorb verschoben.", Severity.Success);
            Nav.NavigateTo("/kasse");
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
