@* Active templates as one-confirm buttons (2-click booking). *@
@inject IDialogService DialogService

@if (Visible.Count > 0)
{
    <MudPaper Class="pa-3 mb-4" Elevation="0" Outlined="true">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mr-2">Schnellbuchung:</MudText>
            @foreach (var t in Visible)
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           Color="@KassenBuchungArtDisplay.ChipColor(t.Kind)"
                           StartIcon="@KassenKontoDisplay.Icon(t.Account)"
                           OnClick="@(() => BookAsync(t))">
                    @t.Name · @KassenBuchungArtDisplay.Sign(t.Kind) @Money.Format(t.Amount)
                </MudButton>
            }
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter] public IReadOnlyList<KassenBuchungVorlage> Templates { get; set; } = [];
    [Parameter] public IReadOnlyList<KassenKontoSummary> Summaries { get; set; } = [];
    [Parameter, EditorRequired] public ClaimsPrincipal User { get; set; } = default!;
    [Parameter] public EventCallback OnBooked { get; set; }

    /// <summary>Templates this agent may actually book: everyone deposits, Senior Special Agent upward pays out.</summary>
    private IReadOnlyList<KassenBuchungVorlage> Visible
        => Templates.Where(t => User.MayKassenBook(t.Kind)).ToList();

    private async Task BookAsync(KassenBuchungVorlage template)
    {
        var current = Summaries.FirstOrDefault(s => s.Account == template.Account)?.Balance ?? 0m;
        var booked = await ConfirmBookingDialog.ShowAsync(DialogService, template, current, User);
        if (booked)
        {
            await OnBooked.InvokeAsync();
        }
    }
}
