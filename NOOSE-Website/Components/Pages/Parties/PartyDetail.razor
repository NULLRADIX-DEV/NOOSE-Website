@page "/parteien/{Id}"
@inject IPartyService PartyService
@inject IAccessLogService AccessLog
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IPartnerVisibilityPolicyService PartnerPolicy

<PageTitle>@(_party?.Name ?? "Partei") · NOOSE</PageTitle>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_party is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        Partei nicht gefunden oder nicht zugänglich (ggf. Verschlusssache).
    </MudAlert>
}
else
{
    @if (_party.IsArchived)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <div>
                    <MudText Typo="Typo.body2">
                        Archiviert am @(_party.ArchivedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—") —
                        erscheint nicht in Listen, Auswahllisten und der Standardsuche.
                    </MudText>
                    @if (!string.IsNullOrWhiteSpace(_party.ArchiveReason))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Grund: @_party.ArchiveReason</MudText>
                    }
                </div>
                <MudSpacer />
                <AuthorizeView Policy="@Policies.WriteAccess" Context="archiv">
                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Unarchive"
                               OnClick="UnarchiveAsync">Zurückholen</MudButton>
                </AuthorizeView>
            </MudStack>
        </MudAlert>
    }

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/parteien" aria-label="Zurück" />
        <MudSpacer />
        <MudTooltip Text="Druckansicht – Akte drucken / als PDF speichern">
            <MudIconButton Icon="@Icons.Material.Filled.Print" Color="Color.Default"
                           Href="@($"/parteien/{Id}/druck")" Target="_blank"
                           aria-label="Druckansicht öffnen" />
        </MudTooltip>
        <DossierExportButton EntityType="@nameof(Party)" EntityId="@Id" />
        @if (!_isPartner)
        {
            <FollowButton EntityType="@nameof(Party)" EntityId="@_party.Id" User="_user" />
            <JobCreateButton EntityType="@nameof(Party)" EntityId="@_party.Id" />
        }
        <AuthorizeView Policy="@Policies.WriteAccess" Context="freigabe">
            <PartnerShareButton EntityType="@nameof(Party)" EntityId="@_party.Id" />
        </AuthorizeView>
        <AuthorizeView Policy="@Policies.WriteAccess" Context="schreib">
            <MudButton Href="@($"/parteien/{_party.Id}/bearbeiten")" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">Bearbeiten</MudButton>
        </AuthorizeView>
        <AuthorizeView Policy="@Policies.WriteAccess" Context="ablegen">
            @if (!_party.IsArchived)
            {
                <MudButton Color="Color.Default" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Archive"
                           OnClick="ArchiveAsync">Archivieren</MudButton>
            }
        </AuthorizeView>
        <AuthorizeView Policy="@Policies.Leadership">
            <MudButton Color="Color.Error" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync">Löschen</MudButton>
        </AuthorizeView>
    </MudStack>

    @if (!_isPartner)
    {
        <MudPaper Class="pa-2 mb-4" Elevation="1">
            <TagChips EntityType="@nameof(Party)" EntityId="@_party.Id" User="_user" />
        </MudPaper>
    }

    <MudGrid>
        <MudItem xs="12" md="4" lg="3">
            <div class="akte-steckkarte">
                <PartyCard Party="_party" MemberCount="_memberCount" InvestigationLead="_investigationLead"
                           TitleImagePhotoId="@RecordAvatar.ProfileId(_party.Photos)"
                           User="_user" Changed="NewLoadAsync" />
            </div>
        </MudItem>

        <MudItem xs="12" md="8" lg="9">
            @if (_renderTabs.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    Für Ihren Zugang sind in dieser Akte keine Bereiche freigegeben.
                </MudAlert>
            }
            else
            {
            @if (TabOn("historie"))
            {
                <SinceLastVisitBar EntityType="@nameof(Party)" EntityId="@_party.Id" User="_user" Since="_since" />
            }
            <RecordSectionRail>
                @if (TabOn("stammdaten"))
                {
                <RecordSection Group="Akte" Slug="stammdaten" Label="Stammdaten" Icon="@Icons.Material.Filled.Info">
                    <MudStack Spacing="3">
                        @if (!string.IsNullOrWhiteSpace(_party.Targets))
                        {
                            <div>
                                <MudText Typo="Typo.subtitle2">Ziele</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary"><MentionDisplay Text="@_party.Targets" /></MudText>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_party.Description))
                        {
                            <div>
                                <MudText Typo="Typo.subtitle2">Beschreibung</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary"><MentionDisplay Text="@_party.Description" /></MudText>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_party.Remarks))
                        {
                            <div>
                                <MudText Typo="Typo.subtitle2">Bemerkungen</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="white-space:pre-line;"><MentionDisplay Text="@_party.Remarks" /></MudText>
                            </div>
                        }
                        @if (string.IsNullOrWhiteSpace(_party.Targets) && string.IsNullOrWhiteSpace(_party.Description) && string.IsNullOrWhiteSpace(_party.Remarks))
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Keine weiteren Stammdaten erfasst.</MudText>
                        }
                    </MudStack>
                </RecordSection>
                }
                @if (TabOn("mitglieder"))
                {
                <RecordSection Group="Struktur" Slug="mitglieder" Label="Mitglieder" Icon="@Icons.Material.Filled.Group">
                    <PartyMembersPanel PartyId="@_party.Id" User="_user" Changed="MembersModifiedAsync" />
                </RecordSection>
                }
                @* assigned NOOSE agents: internal only *@
                @if (!_isPartner)
                {
                <RecordSection Group="Struktur" Slug="agents" Label="Zugeteilte Agents" Icon="@Icons.Material.Filled.ManageAccounts">
                    <PartyAgentsPanel PartyId="@_party.Id" User="_user" Changed="InvestigationLeadRefreshAsync" />
                </RecordSection>
                }
                @if (TabOn("einstufung"))
                {
                <RecordSection Group="Akte" Slug="einstufung" Label="Einstufung" Icon="@Icons.Material.Filled.Shield">
                    <ClassificationPanel Current="_party.Classification" History="_classificationHistory" User="_user" OnSet="ClassificationSetAsync"
                                     EntityType="@nameof(Party)" EntityId="@_party.Id" TargetDesignation="@($"{_party.Name} ({_party.CaseNumber})")" />
                </RecordSection>
                }
                @if (TabOn("doks"))
                {
                <RecordSection Group="Ermittlung" Slug="doks" Label="Doks" Icon="@Icons.Material.Filled.Description">
                    <OrgDocsPanel OrgType="@nameof(Party)" OrgId="@_party.Id" User="_user" />
                </RecordSection>
                }
                @if (TabOn("fotos"))
                {
                <RecordSection Group="Anhänge" Slug="fotos" Label="Fotos" Icon="@Icons.Material.Filled.PhotoLibrary">
                    <PartyPhotoGallery PartyId="@_party.Id" User="_user" Changed="NewLoadAsync" />
                </RecordSection>
                }
                @* partner-safe child services *@
                @if (TabOn("beziehungen"))
                {
                <RecordSection Group="Struktur" Slug="beziehungen" Label="Beziehungen" Icon="@Icons.Material.Filled.Hub">
                    <OrgRelationsPanel EntityType="@nameof(Party)" EntityId="@_party.Id" User="_user" />
                </RecordSection>
                }
                @if (TabOn("quellen"))
                {
                <RecordSection Group="Anhänge" Slug="quellen" Label="Quellen" Icon="@Icons.Material.Filled.AttachFile">
                    <SourcesPanel EntityType="@nameof(Party)" EntityId="@_party.Id" User="_user" />
                </RecordSection>
                }
                @if (TabOn("wiedervorlagen"))
                {
                <RecordSection Group="Verlauf" Slug="wiedervorlagen" Label="Wiedervorlagen" Icon="@Icons.Material.Filled.EventRepeat">
                    <FollowupPanel EntityType="@nameof(Party)" EntityId="@_party.Id" User="_user" />
                </RecordSection>
                }
                @if (TabOn("kommentare"))
                {
                <RecordSection Group="Verlauf" Slug="kommentare" Label="Kommentare" Icon="@Icons.Material.Filled.Comment">
                    <CommentPanel EntityType="@nameof(Party)" EntityId="@_party.Id" User="_user" />
                </RecordSection>
                }
                @if (TabOn("zusatzfelder"))
                {
                <RecordSection Group="Akte" Slug="zusatzfelder" Label="Zusatzfelder" Icon="@Icons.Material.Filled.Tune">
                    <CustomFieldsPanel EntityType="@nameof(Party)" EntityId="@_party.Id" User="_user" />
                </RecordSection>
                }
                @* partner-safe: timeline filters cross-refs for partners *@
                @if (TabOn("historie"))
                {
                <RecordSection Group="Verlauf" Slug="historie" Label="Zeitstrahl" Icon="@Icons.Material.Filled.Timeline">
                    <TimelinePanel EntityType="@nameof(Party)" EntityId="@_party.Id" User="_user" NewSince="_since" @key="_historyKey" />
                </RecordSection>
                }
                @if (!_isPartner)
                {
                <RecordSection Group="Analyse" Slug="ki-kurzbrief" Label="NOOSEI-Kurzbrief" Icon="@Icons.Material.Filled.AutoAwesome">
                    <KiBriefPanel EntityType="@nameof(Party)" EntityId="@_party.Id" User="_user" />
                </RecordSection>
                }
            </RecordSectionRail>
            }
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public string Id { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;
    private bool _isPartner;
    private Party? _party;
    private int _memberCount;
    private List<string> _investigationLead = new();
    private List<ClassificationHistory> _classificationHistory = new();
    private ClaimsPrincipal _user = default!;
    private Guid _historyKey = Guid.NewGuid();
    private string? _loadedId;
    // last view of the previous visit, read before this one is logged
    private DateTime? _since;

    // every section slug on this page; the rail owns which one is active
    private static readonly string[] _tabs =
    {
        "stammdaten", "mitglieder", "agents", "einstufung", "doks", "fotos",
        "beziehungen", "quellen", "wiedervorlagen", "kommentare", "zusatzfelder", "historie",
    };

    // partner tab gating: null = no restriction (internal/unconfigured/individually released)
    private IReadOnlySet<string>? _visibleTabs;
    private List<string> _renderTabs = new();
    private bool TabOn(string slug) => _visibleTabs is null || _visibleTabs.Contains(slug);
    private void RebuildRenderTabs() => _renderTabs = _tabs.Where(s => (s != "agents" || !_isPartner) && TabOn(s)).ToList();

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _isPartner = _user.IsPartner();
    }

    // Component is reused across /parteien/{A}→{B}, so OnInitializedAsync does not re-run; react to Id change here.
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }
        _loadedId = Id;
        _load = true;
        _party = null;
        _since = null;
        await LoadAsync();
        if (_party is not null)
        {
            _since = await AccessLog.PreviousVisitAsync(nameof(Party), _party.Id);
            await AccessLog.LogViewAsync(nameof(Party), _party.Id);
        }
    }

    private async Task LoadAsync()
    {
        // Do not set _load=true on reload: re-mounting the rail would jump to the first section.
        var scope = ViewerScope.From(_user);
        _party = await PartyService.GetDetailAsync(Id, scope);
        if (_party is not null)
        {
            _classificationHistory = await PartyService.GetClassificationHistoryAsync(_party.Id, scope);
            // partners: skip member/agent fan-out
            if (!_isPartner)
            {
                _memberCount = (await PartyService.GetMembersAsync(_party.Id, scope)).Count;
                await InvestigationLeadLoadAsync();
            }
        }
        _visibleTabs = _isPartner && _party is not null
            ? await PartnerPolicy.GetVisibleTabsAsync(_user, nameof(Party), _party.Id)
            : null;
        RebuildRenderTabs();
        _load = false;
    }

    private async Task InvestigationLeadLoadAsync()
    {
        if (_party is null)
        {
            return;
        }
        var el = await PartyService.GetInvestigationLeadAsync(_party.Id);
        _investigationLead = el.Select(a => a.Agent?.Codename ?? "?").ToList();
    }

    private async Task InvestigationLeadRefreshAsync()
    {
        await InvestigationLeadLoadAsync();
        StateHasChanged();
    }

    private async Task NewLoadAsync()
    {
        await LoadAsync();
        _historyKey = Guid.NewGuid();
        StateHasChanged();
    }

    private async Task MembersModifiedAsync()
    {
        if (_party is not null)
        {
            _memberCount = (await PartyService.GetMembersAsync(_party.Id, ViewerScope.From(_user))).Count;
            StateHasChanged();
        }
    }

    private async Task ClassificationSetAsync((Classification New, string? Justification) input)
    {
        if (_party is null)
        {
            return;
        }
        await PartyService.ClassificationSetAsync(_party.Id, input.New, input.Justification, _user);
        await NewLoadAsync();
    }

    private async Task ArchiveAsync()
    {
        if (_party is null)
        {
            return;
        }
        var reason = await ReasonDialog.ShowAsync(DialogService, "Partei archivieren?",
            "Diese Partei verschwindet aus Listen, Auswahllisten und der Standardsuche. Verknüpfungen, "
            + "Erwähnungen und der Graph bleiben unverändert; zurückholen kann sie jeder mit Schreibrecht.",
            confirmText: "Archivieren", label: "Grund (optional)");
        if (reason is null)
        {
            return;
        }
        await PartyService.ArchiveAsync(_party.Id, reason, _user);
        Snackbar.Add("Partei archiviert.", Severity.Success);
        await NewLoadAsync();
    }

    private async Task UnarchiveAsync()
    {
        if (_party is null)
        {
            return;
        }
        await PartyService.UnarchiveAsync(_party.Id, _user);
        Snackbar.Add("Wieder im aktiven Bestand.", Severity.Success);
        await NewLoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (_party is null)
        {
            return;
        }
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Partei löschen?",
            "Die Partei wird in den Papierkorb verschoben und kann von der Führung wiederhergestellt werden.");
        if (!ok)
        {
            return;
        }
        await PartyService.DeleteAsync(_party.Id, _user);
        Snackbar.Add("Partei in den Papierkorb verschoben.", Severity.Success);
        Nav.NavigateTo("/parteien");
    }
}
