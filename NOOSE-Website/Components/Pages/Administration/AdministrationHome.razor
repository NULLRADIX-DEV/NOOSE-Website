@* One section of the Administration workspace per address; the side menu lists them, the page shows exactly one. *@
@page "/administration"
@page "/administration/{Slug}"
@attribute [Authorize(Policy = Policies.AdministrationWorkspace)]
@using NOOSE_Website.Components.Pages.Administration.Shared
@using NOOSE_Website.Navigation

<PageTitle>@(_section?.Label ?? "Administration") · FIB</PageTitle>

@if (_section is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Diesen Bereich gibt es in der Administration nicht.</MudAlert>
}
else if (_user is not null)
{
    <PageHeader Icon="@_section.Icon" Title="@_section.Label" Subtitle="@($"Administration Division · {_section.Group}")"
                HelpNavKey="@_section.HelpKey" />

    @switch (_section.Slug)
    {
        case "":
            <AdministrationChatPanel User="_user" @key="_section.Slug" />
            break;
        case "informationen":
            <AdministrationInfoPanel User="_user" @key="_section.Slug" />
            break;
        case "agents":
            <AdministrationMembersPanel User="_user" @key="_section.Slug" />
            break;
        case "beziehungen":
            <RelationshipsPanel User="_user" @key="_section.Slug" />
            break;
        case "sicherheitspruefungen":
            <SecurityChecksPanel User="_user" @key="_section.Slug" />
            break;
        case "beurteilungen":
            <EvaluationOverviewPanel User="_user" @key="_section.Slug" />
            break;
        case "befoerderungen":
            <PromotionOverviewPanel User="_user" @key="_section.Slug" />
            break;
        case "versetzungen":
            <TransfersPanel User="_user" @key="_section.Slug" />
            break;
        case "auszeichnungen":
            <DecorationProposalsPanel User="_user" @key="_section.Slug" />
            break;
        case "dienstzeugnisse":
            <ServiceReferencesPanel User="_user" @key="_section.Slug" />
            break;
        case "schusswaffengebrauch":
            <NOOSE_Website.Components.Pages.Firearm.FirearmUsePage Embedded="true" @key="_section.Slug" />
            break;
        case "ermittlungsverfahren":
            <DisciplinaryListPanel User="_user" Closed="false" @key="_section.Slug" />
            break;
        case "verfuegungen":
            <DisciplinaryListPanel User="_user" Closed="true" @key="_section.Slug" />
            break;
        case "presse":
            <PressPanel @key="_section.Slug" />
            break;
        case "parlament":
            <ParliamentPanel User="_user" @key="_section.Slug" />
            break;
        case "zeitstrahl":
            <TimelinePanel EntityType="@WorkspaceType" EntityId="@WorkspaceId" User="_user" @key="_section.Slug" />
            break;
        case "wiedervorlagen":
            <FollowupPanel EntityType="@WorkspaceType" EntityId="@WorkspaceId" User="_user" @key="_section.Slug" />
            break;
        case "kommentare":
            <CommentPanel EntityType="@WorkspaceType" EntityId="@WorkspaceId" User="_user" @key="_section.Slug" />
            break;
    }
}

@code {
    [Parameter] public string? Slug { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private const string WorkspaceType = nameof(NOOSE_Website.Data.Entities.Administration.AdministrationWorkspace);
    private const string WorkspaceId = NOOSE_Website.Data.Entities.Administration.AdministrationWorkspace.SingletonId;

    private ClaimsPrincipal? _user;
    private AdministrationSections.Section? _section;

    // both routes share this instance, so the section follows the parameter
    protected override async Task OnParametersSetAsync()
    {
        _user ??= (await AuthStateTask).User;
        _section = AdministrationSections.BySlug(Slug);
    }
}
