@page "/administration"
@attribute [Authorize(Policy = Policies.AdministrationWorkspace)]
@using NOOSE_Website.Components.Pages.Administration.Shared
@using NOOSE_Website.Services.Administration
@inject IAdministrationChatService ChatService

<PageTitle>Administration · FIB</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.AssuredWorkload" Title="Administration Division"
            Subtitle="Personalgewinnung, Personalwesen, Disziplinarwesen, Öffentlichkeits- und Parlamentsarbeit" />

@if (_user is not null)
{
    <RecordSectionRail>
        <RecordSection Group="Allgemeines" Slug="chat" Label="Chat" Icon="@Icons.Material.Filled.Forum" Badge="_chatUnread">
            <AdministrationChatPanel User="_user" Read="@(() => _chatUnread = 0)" />
        </RecordSection>
        <RecordSection Group="Allgemeines" Slug="informationen" Label="Informationen" Icon="@Icons.Material.Filled.Info">
            <AdministrationInfoPanel User="_user" />
        </RecordSection>
        <RecordSection Group="Allgemeines" Slug="agents" Label="Zugeteilte Agents" Icon="@Icons.Material.Filled.ManageAccounts">
            <AdministrationMembersPanel User="_user" />
        </RecordSection>
        <RecordSection Group="Allgemeines" Slug="beziehungen" Label="Personalbeziehungen" Icon="@Icons.Material.Filled.Favorite">
            <RelationshipsPanel User="_user" />
        </RecordSection>

        <RecordSection Group="Personalgewinnung" Slug="sicherheitspruefungen" Label="Sicherheitsüberprüfungen" Icon="@Icons.Material.Filled.Security">
            <SecurityChecksPanel User="_user" />
        </RecordSection>

        <RecordSection Group="Personalwesen" Slug="beurteilungen" Label="Beurteilungen" Icon="@Icons.Material.Filled.Grading">
            <EvaluationOverviewPanel User="_user" />
        </RecordSection>
        <RecordSection Group="Personalwesen" Slug="befoerderungen" Label="Beförderungen" Icon="@Icons.Material.Filled.TrendingUp">
            <PromotionOverviewPanel User="_user" />
        </RecordSection>
        <RecordSection Group="Personalwesen" Slug="versetzungen" Label="Versetzungen" Icon="@Icons.Material.Filled.SwapHoriz">
            <TransfersPanel User="_user" />
        </RecordSection>
        <RecordSection Group="Personalwesen" Slug="auszeichnungen" Label="Auszeichnungen" Icon="@Icons.Material.Filled.MilitaryTech">
            <DecorationProposalsPanel User="_user" />
        </RecordSection>
        <RecordSection Group="Personalwesen" Slug="dienstzeugnisse" Label="Dienstzeugnisse" Icon="@Icons.Material.Filled.WorkspacePremium">
            <ServiceReferencesPanel User="_user" />
        </RecordSection>

        <RecordSection Group="Disziplinarwesen" Slug="ermittlungsverfahren" Label="Ermittlungsverfahren" Icon="@Icons.Material.Filled.Gavel">
            <DisciplinaryListPanel User="_user" Closed="false" />
        </RecordSection>
        <RecordSection Group="Disziplinarwesen" Slug="verfuegungen" Label="Disziplinarverfügungen" Icon="@Icons.Material.Filled.Description">
            <DisciplinaryListPanel User="_user" Closed="true" />
        </RecordSection>

        <RecordSection Group="Öffentlichkeit & Parlament" Slug="presse" Label="Öffentlichkeitsarbeit" Icon="@Icons.Material.Filled.Feed">
            <PressPanel />
        </RecordSection>
        <RecordSection Group="Öffentlichkeit & Parlament" Slug="parlament" Label="Parlamentarische Arbeit" Icon="@Icons.Material.Filled.AccountBalance">
            <ParliamentPanel User="_user" />
        </RecordSection>

        <RecordSection Group="Verlauf" Slug="historie" Label="Zeitstrahl" Icon="@Icons.Material.Filled.Timeline">
            <TimelinePanel EntityType="@WorkspaceType" EntityId="@WorkspaceId" User="_user" />
        </RecordSection>
        <RecordSection Group="Verlauf" Slug="wiedervorlagen" Label="Wiedervorlagen" Icon="@Icons.Material.Filled.EventRepeat">
            <FollowupPanel EntityType="@WorkspaceType" EntityId="@WorkspaceId" User="_user" />
        </RecordSection>
        <RecordSection Group="Verlauf" Slug="kommentare" Label="Kommentare" Icon="@Icons.Material.Filled.Comment">
            <CommentPanel EntityType="@WorkspaceType" EntityId="@WorkspaceId" User="_user" />
        </RecordSection>
    </RecordSectionRail>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private const string WorkspaceType = nameof(NOOSE_Website.Data.Entities.Administration.AdministrationWorkspace);
    private const string WorkspaceId = NOOSE_Website.Data.Entities.Administration.AdministrationWorkspace.SingletonId;

    private ClaimsPrincipal? _user;
    private int _chatUnread;

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _chatUnread = (await ChatService.GetReadStateAsync(_user)).Unread;
    }
}
