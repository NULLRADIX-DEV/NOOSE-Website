@page "/anordnungen/neu"
@attribute [Authorize(Policy = Policies.InternalAgent)]
@using NOOSE_Website.Data.Entities.Cases
@inject IWarrantService WarrantService
@inject ILawService LawService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject SharesBroadcaster SharesBroadcaster

<PageTitle>Anordnung beantragen · FIB</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.Approval" Title="Anordnung beantragen" BackHref="@BackHref"
            Subtitle="Der Antrag geht an die Führung. Erst mit ihrer Unterschrift gilt die Anordnung und lässt sich drucken." />

@if (!_mayRequest)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        Anordnungen beantragen nur aktive interne Agenten mit Schreibrecht.
    </MudAlert>
}
else if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudPaper Class="pa-4" Elevation="1">
        <MudForm @ref="_form">
            <MudStack Spacing="3">
                <MudSelect T="WarrantType" @bind-Value="_input.Type" Label="Art der Anordnung" Variant="Variant.Outlined">
                    @foreach (var type in WarrantTypeDisplay.All)
                    {
                        <MudSelectItem Value="type">@WarrantTypeDisplay.Name(type)</MudSelectItem>
                    }
                </MudSelect>

                <QuickRecordPicker Allowed="PersonOnly" Value="_person" ValueChanged="@(h => _person = h)"
                                   Label="Betroffene Person" HelperText="Die Anordnung ist nie weiter sichtbar als diese Akte." />
                <QuickRecordPicker Allowed="CaseOnly" Value="_case" ValueChanged="@(h => _case = h)"
                                   Label="Vorgang (optional)" HelperText="Ist ein Vorgang gewählt, begrenzt auch er, wer die Anordnung sieht." />

                <TextDraft DraftKey='@DraftKeys.In(DraftScope, "gegenstand")' OnRestore="@(t => _input.Subject = t)">
                    <MudTextField @bind-Value="_input.Subject" Label="Gegenstand" Variant="Variant.Outlined" Lines="3"
                                  Immediate="true" Required="true" RequiredError="Bitte den Gegenstand angeben."
                                  MaxLength="WarrantRules.SubjectMaxLength" Counter="WarrantRules.SubjectMaxLength"
                                  HelperText="Was durchsucht oder beschlagnahmt wird, wer festgenommen wird. Steht so auf dem Papier." />
                </TextDraft>

                <div>
                    <MudAutocomplete T="Law" Value="_lawPick" ValueChanged="AddLaw" SearchFunc="SearchLaws"
                                     ToStringFunc="@(l => l is null ? string.Empty : WarrantRules.LawLabel(l))"
                                     Label="Rechtsgrundlage hinzufügen" Variant="Variant.Outlined" Clearable="true"
                                     CoerceText="false" CoerceValue="false" ResetValueOnEmptyText="true"
                                     MinCharacters="0" Immediate="true"
                                     Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Gavel">
                        <ItemTemplate Context="l">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.Gavel" Size="Size.Small" Color="Color.Primary" />
                                <MudText Typo="Typo.body2">@l.Paragraph @l.Title</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@l.LawBook</MudText>
                            </MudStack>
                        </ItemTemplate>
                    </MudAutocomplete>
                    @if (_laws.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Mindestens ein Paragraf aus dem Gesetzbuch, höchstens @WarrantRules.MaxLaws.
                        </MudText>
                    }
                    else
                    {
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-2">
                            @foreach (var law in _laws)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                                         OnClose="@(_ => { _laws.Remove(law); })">@WarrantRules.LawLabel(law)</MudChip>
                            }
                        </MudStack>
                    }
                </div>

                <TextDraft DraftKey='@DraftKeys.In(DraftScope, "begruendung")' OnRestore="@(t => _input.Justification = t)">
                    <MudTextField @bind-Value="_input.Justification" Label="Begründung" Variant="Variant.Outlined" Lines="4"
                                  Immediate="true" Required="true" RequiredError="Bitte eine Begründung angeben."
                                  MaxLength="WarrantRules.JustificationMaxLength" Counter="WarrantRules.JustificationMaxLength"
                                  HelperText="Nur intern: Die Führung entscheidet danach, auf das Papier kommt sie nicht." />
                </TextDraft>

                <MudSelect T="int" @bind-Value="_input.ValidityDays" Label="Gültig für (ab Unterschrift)" Variant="Variant.Outlined">
                    @foreach (var days in WarrantRules.ValidityChoices)
                    {
                        <MudSelectItem Value="days">@WarrantRules.ValidityLabel(days)</MudSelectItem>
                    }
                </MudSelect>

                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                    <MudButton Href="@BackHref">Abbrechen</MudButton>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_saving"
                               StartIcon="@Icons.Material.Filled.Send">Beantragen</MudButton>
                </MudStack>
            </MudStack>
        </MudForm>
    </MudPaper>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "person")] public string? PrePersonId { get; set; }
    [SupplyParameterFromQuery(Name = "vorgang")] public string? PreCaseId { get; set; }

    private const string DraftScope = "anordnung:neu";
    private static readonly IReadOnlySet<string> PersonOnly = new HashSet<string> { nameof(Person) };
    private static readonly IReadOnlySet<string> CaseOnly = new HashSet<string> { nameof(Case) };

    private ClaimsPrincipal _user = default!;
    private MudForm _form = default!;
    private bool _load = true;
    private bool _saving;
    private bool _mayRequest;
    private string? _loadedKey;
    private WarrantInput _input = new();
    private QuickHit? _person;
    private QuickHit? _case;
    private Law? _lawPick;
    private readonly List<Law> _laws = new();

    private string BackHref => PrePersonId is { Length: > 0 } person ? $"/personen/{person}?tab=anordnungen"
        : PreCaseId is { Length: > 0 } caseId ? $"/vorgaenge/{caseId}?tab=anordnungen"
        : "/anordnungen";

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _mayRequest = _user.MayWarrantRequest();
    }

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{PrePersonId}|{PreCaseId}";
        if (_loadedKey == key)
        {
            return;
        }
        _loadedKey = key;
        _load = true;
        _person = await HitAsync(nameof(Person), PrePersonId);
        _case = await HitAsync(nameof(Case), PreCaseId);
        _load = false;
    }

    private async Task<QuickHit?> HitAsync(string type, string? id)
    {
        if (string.IsNullOrWhiteSpace(id))
        {
            return null;
        }
        var target = await WarrantService.GetTargetAsync(type, id, _user);
        return target is null ? null : new QuickHit(type, target.Id, target.Name, target.CaseNumber);
    }

    private async Task<IEnumerable<Law>> SearchLaws(string value, CancellationToken token)
        => (await LawService.SearchAsync(value, 20, token)).Where(l => _laws.All(c => c.Id != l.Id));

    private void AddLaw(Law? law)
    {
        if (law is not null && _laws.All(l => l.Id != law.Id) && _laws.Count < WarrantRules.MaxLaws)
        {
            _laws.Add(law);
        }
        _lawPick = null;
    }

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }
        if (_person is null)
        {
            Snackbar.Add("Bitte die betroffene Person wählen.", Severity.Warning);
            return;
        }
        _saving = true;
        try
        {
            _input.PersonId = _person.TargetId;
            _input.CaseId = _case?.TargetId;
            _input.LawIds = _laws.Select(l => l.Id).ToList();
            var created = await WarrantService.CreateAsync(_input, _user);
            await TextDraft.DiscardScopeAsync(JS, _user.GetAgentId(), DraftScope);
            SharesBroadcaster.Report();
            Snackbar.Add($"Anordnung {created.CaseNumber} beantragt.", Severity.Success);
            Nav.NavigateTo($"/anordnungen/{created.Id}");
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _saving = false;
        }
    }
}
