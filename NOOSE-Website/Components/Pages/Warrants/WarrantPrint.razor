@* The paper to show in roleplay: what is ordered, against whom, on which legal basis, signed by whom and until when. *@
@page "/anordnungen/{Id}/druck"
@* no internal-only policy: the prosecutor prints the warrants of an investigation; the service decides *@
@layout PrintLayout
@inject IWarrantService WarrantService
@inject IPublicWarrantCheckService WarrantCheck

<PageTitle>@(_view is null ? "Druckansicht" : $"Anordnung {_view.Warrant.CaseNumber}") · FIB</PageTitle>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_view is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Diese Anordnung existiert nicht (mehr).</MudAlert>
}
else if (!WarrantRules.WasSigned(_view.Warrant))
{
    @* an unsigned request must never look like a paper *@
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        Diese Anordnung ist nicht unterzeichnet; eine Druckansicht gibt es erst mit der Unterschrift der Führung.
    </MudAlert>
}
else
{
    var w = _view.Warrant;
    <PrintFrame Title="@WarrantTypeDisplay.Name(w.Type)" BackHref="@($"/anordnungen/{Id}")" BackText="Zurück zur Anordnung"
                PrintedBy="@_printBy" IsClassified="false"
                Footer="@($"Amtliches Schriftstück des FIB · {w.CaseNumber} · Gilt nur im angegebenen Zeitraum und nur ohne Vermerk der Aufhebung.")">
        @if (_link is { CheckOnline: false })
        {
            <div class="no-print">
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    Die öffentliche Prüfung ist derzeit abgeschaltet. Der QR-Code auf dem Papier führt erst nach der
                    Freischaltung durch die Führung zu einer Antwort.
                </MudAlert>
            </div>
        }

        @if (_view.State != WarrantState.Valid)
        {
            <p><span class="druck-poster-warnung">Ungültig – @WarrantStateDisplay.Name(_view.State)</span></p>
        }

        <section>
            <table class="druck-felder">
                <tbody>
                    <tr><th>Aktenzeichen</th><td>@w.CaseNumber</td></tr>
                    <tr><th>Betroffene Person</th><td>@_view.PersonName</td></tr>
                    <tr><th>Gültig ab</th><td>@w.ValidFrom?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td></tr>
                    <tr><th>Gültig bis</th><td>@w.ValidUntil?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td></tr>
                    @if (w.CancelledAt is { } cancelled)
                    {
                        <tr><th>Aufgehoben am</th><td>@cancelled.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td></tr>
                    }
                </tbody>
            </table>
        </section>

        <section>
            <h2>Anordnung</h2>
            <p>@WarrantTypeDisplay.Order(w.Type)</p>
            <div class="druck-mehrzeilig">@w.Subject</div>
        </section>

        <section>
            <h2>Rechtsgrundlage</h2>
            @foreach (var line in WarrantRules.LegalBasisLines(w))
            {
                <div>@line</div>
            }
        </section>

        <section>
            <h2>Unterschrift</h2>
            <p>
                gez. @(w.DeciderName ?? "—")@(w.DeciderRank is { } rank ? $", {RankDisplay.Name(rank)}" : string.Empty)<br />
                @(w.DeciderFunction ?? "Federal Investigation Bureau"), @(w.DecidedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
            </p>
        </section>

        @if (_link is { } link)
        {
            @* scan or type to check the paper online *@
            <section class="druck-poster-qr druck-anordnung-qr">
                @if (link.QrSvg is { } svg)
                {
                    @* encoder output, no warrant text *@
                    <div class="druck-poster-qr-code">@((MarkupString)svg)</div>
                }
                <div>
                    <div class="druck-poster-qr-titel">Echtheit prüfen</div>
                    <div class="druck-poster-qr-adresse">@link.Address</div>
                    <div class="druck-poster-qr-hilfe">QR-Code scannen oder Adresse eingeben. Die Seite zeigt, ob die Anordnung gilt.</div>
                </div>
            </section>
        }
    </PrintFrame>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;
    private string? _printBy;
    private WarrantView? _view;
    private WarrantCheckLink? _link;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateTask).User;
        _printBy = user.GetCodename();
        _view = await WarrantService.GetAsync(Id, user);
        if (_view is not null && WarrantRules.WasSigned(_view.Warrant))
        {
            try
            {
                _link = await WarrantCheck.GetLinkAsync(_view.Warrant.Id);
            }
            catch
            {
                /* best effort */
            }
        }
        _load = false;
    }
}
