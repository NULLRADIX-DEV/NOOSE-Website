@* The agent's own phrases: kept here because they belong to nobody else. *@
@inject ITextSnippetService Snippets
@inject IPlaceholderService Placeholders
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h6" Class="mb-1">Meine Textbausteine</MudText>
<MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
    Sätze, die du immer wieder schreibst. Du holst sie mit einem Schrägstrich und den ersten Buchstaben
    des Namens: in einem gewöhnlichen Feld am Wortanfang, im Text-Editor am Anfang einer Zeile.
    Sie gehören dir allein.
</MudText>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudStack Spacing="2">
        @foreach (var s in _list)
        {
            <MudPaper Class="pa-3" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.ShortText" Size="Size.Small" Color="Color.Primary" />
                    <MudText Typo="Typo.body2" Class="noose-eintrag-titel"><b>@s.Name</b></MudText>
                    <MudSpacer />
                    @if (_mayWrite)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default"
                                       OnClick="@(() => EditAsync(s))" aria-label="Textbaustein bearbeiten" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeleteAsync(s))" aria-label="Textbaustein löschen" />
                    }
                </MudStack>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1" Style="white-space:pre-wrap;">@s.Text</MudText>
            </MudPaper>
        }

        @if (_list.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Noch keine Textbausteine.</MudText>
        }

        @if (_mayWrite)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="2">
                @if (_list.Count >= TextSnippetService.MaxPerAgent)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Mehr als @TextSnippetService.MaxPerAgent Bausteine sind nicht vorgesehen.
                    </MudText>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="CreateAsync" Disabled="@(_list.Count >= TextSnippetService.MaxPerAgent)">
                    Textbaustein anlegen
                </MudButton>
            </MudStack>
        }

        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" AlignItems="AlignItems.Center" Class="mt-1">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Platzhalter:</MudText>
            @foreach (var (token, description) in Placeholders.AvailablePlaceholder)
            {
                <MudTooltip Text="@description">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ma-0">@token</MudChip>
                </MudTooltip>
            }
        </MudStack>
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
            Beim Einfügen ersetzt. Ohne Akte im Feld bleibt der Platzhalter sichtbar stehen.
        </MudText>
    </MudStack>
}

@code {
    [Parameter, EditorRequired] public ClaimsPrincipal User { get; set; } = default!;

    private bool _load = true;
    private bool _mayWrite;
    private List<TextSnippet> _list = new();

    protected override async Task OnInitializedAsync()
    {
        _mayWrite = User.MayWrite();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _load = true;
        try
        {
            _list = await Snippets.GetMineAsync(User);
        }
        finally
        {
            // a failed load must not leave the panel on the progress bar
            _load = false;
        }
    }

    private Task CreateAsync() => EditAsync(null);

    private async Task EditAsync(TextSnippet? existing)
    {
        var input = await TextSnippetDialog.ShowAsync(DialogService, existing);
        if (input is null)
        {
            return;
        }
        try
        {
            if (existing is null)
            {
                await Snippets.CreateAsync(input, User);
            }
            else
            {
                await Snippets.RefreshAsync(existing.Id, input, User);
            }
            Snackbar.Add("Textbaustein gespeichert.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(TextSnippet snippet)
    {
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Textbaustein löschen?",
            $"„{snippet.Name}“ wird endgültig entfernt – Textbausteine haben keinen Papierkorb.");
        if (!ok)
        {
            return;
        }
        try
        {
            await Snippets.DeleteAsync(snippet.Id, User);
            Snackbar.Add("Textbaustein gelöscht.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
