@page "/profil"
@* Self-service profile edit; leadership changes apply instantly, others go to the release inbox. *@
@inject IAgentManagementService AgentService
@inject IRequestService RequestService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IGamificationService Gamification
@inject IDialogService DialogService
@inject INavPreferencesService NavPrefs
@using NOOSE_Website.Models.Gamification

<PageTitle>Mein Profil · NOOSE</PageTitle>

@* Centred column; MainLayout already supplies the horizontal gutter. *@
<MudContainer MaxWidth="MaxWidth.Large" Class="px-0">

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
        <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h4">Mein Profil</MudText>
    </MudStack>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">
        @if (!_mayWrite)
        {
            <span>Hier siehst du deine Stammdaten. Änderungen sind in deiner Rolle nicht möglich.</span>
        }
        else if (_isLeadership)
        {
            <span>Hier änderst du deine eigenen Stammdaten. Als Führungskraft greifen deine Änderungen <b>sofort</b>.</span>
        }
        else
        {
            <span>Hier änderst du deine eigenen Stammdaten. Deine Änderungen müssen von der Führung <b>freigegeben</b> werden, bevor sie wirksam werden.</span>
        }
    </MudText>

    @if (_load)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_agent is null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            Dein Konto konnte nicht geladen werden. Bitte melde dich neu an.
        </MudAlert>
    }
    else
    {
        @if (_agent.NameChangeRequestedAt is not null)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4" Icon="@Icons.Material.Filled.HourglassTop">
                Dein Antrag auf Stammdatenänderung wartet auf Freigabe durch die Führung
                (eingereicht am @_agent.NameChangeRequestedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")).
                Beantragter Codename: <b>@_agent.PendingCodename</b>.
                Du kannst die Eingaben unten anpassen und den Antrag erneut absenden.
            </MudAlert>
        }

        @if (_agent.AvatarRequestedAt is not null)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4" Icon="@Icons.Material.Filled.HourglassTop">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudAvatar Rounded="true" Style="height:56px;width:56px;">
                        <MudImage Src="@AgentAvatar.Url(_agent.PendingAvatarFileName)" Alt="Beantragtes Profilbild" />
                    </MudAvatar>
                    <span>
                        Dein Profilbild wartet auf Freigabe durch die Führung
                        (eingereicht am @_agent.AvatarRequestedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")).
                        Bis dahin bleibt dein bisheriges Bild sichtbar.
                    </span>
                </MudStack>
            </MudAlert>
        }

        @* Centres the lone card when the performance column is absent. *@
        <MudGrid Spacing="6" Justify="Justify.Center">

            <MudItem xs="12" md="6">
                <MudPaper Class="pa-6" Elevation="2" Style="height:100%;">
                    <MudForm @ref="_form">
                        <MudStack Spacing="3">
                            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                                @if (AgentAvatar.Url(_agent.AvatarFileName) is { } bild)
                                {
                                    <MudAvatar Rounded="true" Style="height:120px;width:120px;">
                                        <MudImage Src="@bild" Alt="Mein Profilbild" />
                                    </MudAvatar>
                                }
                                else
                                {
                                    <MudAvatar Color="Color.Primary" Rounded="true" Style="height:120px;width:120px;font-size:2.5rem;">
                                        @AgentAvatar.Initials(_agent.Codename)
                                    </MudAvatar>
                                }
                                @if (_mayWrite)
                                {
                                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="flex-wrap" Justify="Justify.Center">
                                        <MudFileUpload T="IBrowserFile" FilesChanged="AvatarUploadAsync" Accept="image/*">
                                            <CustomContent>
                                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                                           StartIcon="@Icons.Material.Filled.PhotoCamera" Disabled="_avatarBusy"
                                                           OnClick="@context.OpenFilePickerAsync">
                                                    Profilbild @(_agent.AvatarFileName is null ? "hochladen" : "ändern")
                                                </MudButton>
                                            </CustomContent>
                                        </MudFileUpload>
                                        @if (_agent.AvatarFileName is not null || _agent.PendingAvatarFileName is not null)
                                        {
                                            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Delete" Disabled="_avatarBusy"
                                                       OnClick="AvatarRemoveAsync">Entfernen</MudButton>
                                        }
                                    </MudStack>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="text-align:center;">
                                        JPG, PNG, WebP oder GIF, max. 2 MB.
                                        @(_isLeadership ? "Als Führungskraft greift dein Bild sofort." : "Dein Bild wird erst nach Freigabe durch die Führung sichtbar.")
                                    </MudText>
                                }
                            </MudStack>

                            <MudAlert Severity="Severity.Normal" Dense="true" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Shield">
                                @RankDisplay.Name(_agent.Rank)
                                @if (!string.IsNullOrWhiteSpace(_agent.DiscordUsername))
                                {
                                    <span class="mud-text-secondary"> · Discord: @_agent.DiscordUsername</span>
                                }
                            </MudAlert>

                            @if (!_mayWrite)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Lock">
                                    @(_isPartner ? "Als Partnerbehörde" : "In der Aufsichtsrolle") können Sie Ihre Stammdaten nur einsehen, nicht ändern.
                                </MudAlert>
                            }

                            <MudTextField @bind-Value="_realName" Label="Klarname (echter Name)" Variant="Variant.Outlined"
                                          AutoFocus="@_mayWrite" ReadOnly="@(!_mayWrite)"
                                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.VisibilityOff"
                                          HelperText="Nur für die Führungsebene sichtbar – wird rangniedrigeren Nutzern nie angezeigt." />

                            <MudTextField @bind-Value="_codename" Label="Codename (Deckname)" Variant="Variant.Outlined"
                                          Required="true" RequiredError="Der Codename darf nicht leer sein." ReadOnly="@(!_mayWrite)"
                                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Badge"
                                          HelperText="Für alle Nutzer sichtbar – dein überall angezeigter Name." />

                            <MudSelect T="string" @bind-Value="_badgeNumber" Label="Dienstnummer" Variant="Variant.Outlined"
                                       ReadOnly="@(!_mayWrite)" Clearable="true"
                                       Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Numbers"
                                       HelperText="Für alle Nutzer sichtbar (optional). Freie römische Nummern I–XXV.">
                                <MudSelectItem T="string" Value="@(null as string)">— keine —</MudSelectItem>
                                @foreach (var badgeNumber in _badgeNumberOptions)
                                {
                                    <MudSelectItem T="string" Value="@badgeNumber">@badgeNumber</MudSelectItem>
                                }
                            </MudSelect>

                            @if (_mayWrite)
                            {
                                <MudStack Row="true" Justify="Justify.FlexEnd">
                                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync"
                                               Disabled="_save" StartIcon="@(_isLeadership ? Icons.Material.Filled.Save : Icons.Material.Filled.Send)">
                                        @(_isLeadership ? "Speichern" : "Zur Freigabe einreichen")
                                    </MudButton>
                                </MudStack>
                            }
                        </MudStack>
                    </MudForm>
                </MudPaper>
            </MudItem>

            @if (!_isPartner)
            {
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-6" Elevation="2" Style="height:100%;">
                        <MudText Typo="Typo.h6" Class="mb-3">Meine Leistung</MudText>
                        <MudStack Row="true" Class="flex-wrap mb-4" Spacing="3">
                            <StatTile Icon="@Icons.Material.Filled.FolderOpen" Label="Akten" Value="@_stats.Records.ToString()" />
                            <StatTile Icon="@Icons.Material.Filled.Description" Label="Doks" Value="@_stats.Docs.ToString()" />
                            <StatTile Icon="@Icons.Material.Filled.Hub" Label="Verknüpfungen" Value="@_stats.Links.ToString()" />
                            <StatTile Icon="@Icons.Material.Filled.Shield" Label="Einstufungen" Value="@_stats.Classifications.ToString()" />
                            <StatTile Icon="@Icons.Material.Filled.Visibility" Label="Observationen" Value="@_stats.Observations.ToString()" />
                            <StatTile Icon="@Icons.Material.Filled.TaskAlt" Label="Gelöste Vorgänge" Value="@_stats.SolvedCases.ToString()" />
                        </MudStack>
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Auszeichnungen</MudText>
                        <AgentBadgesPanel AgentId="@_agent.Id" />
                    </MudPaper>
                </MudItem>
            }

            <MudItem xs="12">
                <MudPaper Class="pa-6" Elevation="2">
                    <TextSnippetsPanel User="_user" />
                </MudPaper>
            </MudItem>

            @if (_myRequests.Count > 0)
            {
                <MudItem xs="12">
                    <MudPaper Class="pa-6" Elevation="2">
                        <MudText Typo="Typo.h6" Class="mb-1">Meine Hochstufungs-Anträge</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
                            Von dir gestellte Anträge auf die Einstufung „Gesichert staatsgefährdend“.
                        </MudText>
                        <MudStack Spacing="2">
                            @foreach (var a in _myRequests)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudChip T="string" Size="Size.Small" Color="@StatusColour(a.Status)" Variant="Variant.Filled">@RequestStatusDisplay.Name(a.Status)</MudChip>
                                    <MudText Typo="Typo.body2">@a.TargetDesignation</MudText>
                                    <MudSpacer />
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@a.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</MudText>
                                </MudStack>
                                @if (!string.IsNullOrWhiteSpace(a.DecisionNote))
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary ml-1">Notiz: <MentionDisplay Text="@a.DecisionNote" /></MudText>
                                }
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }

        </MudGrid>
    }

</MudContainer>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;
    private bool _save;
    private bool _isLeadership;
    private bool _mayWrite;
    private bool _isPartner;
    private ClaimsPrincipal _user = default!;
    private Agent? _agent;
    private List<Request> _myRequests = new();
    private AgentStats _stats = AgentStats.Empty;

    // mirrors FileUploadOptions.AvatarMaxBytes; the service revalidates against the real option
    private const long AvatarMaxBytes = 2 * 1024 * 1024;
    private bool _avatarBusy;
    private MudForm _form = default!;
    private string _codename = string.Empty;
    private string? _realName;
    private string? _badgeNumber;
    private List<string> _badgeNumberOptions = [];

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _isLeadership = _user.IsLeadership();
        _isPartner = _user.IsPartner();
        _mayWrite = _user.MayWrite();

        var id = _user.GetAgentId();
        // same condition as the other stamp sites: a partner reaches this page but never sees the checklist,
        // so the mark would only cost a read-modify-write of the whole preferences blob
        if (id is { Length: > 0 } && _user.IsInternalAgent())
        {
            try { await NavPrefs.MarkOnboardingStepAsync(id, Onboarding.StepProfile); } catch { /* best effort */ }
        }
        _agent = string.IsNullOrWhiteSpace(id) ? null : await AgentService.FindAsync(id);
        if (_agent is not null)
        {
            FieldsPrefill();
            _badgeNumberOptions = await AgentService.GetAvailableBadgeNumbersAsync(_agent.Id);
        }
        if (!string.IsNullOrWhiteSpace(id))
        {
            // inquiries live on /anfragen
            _myRequests = (await RequestService.GetMyAsync(id)).Where(r => r.Type != RequestType.PartnerAnfrage).ToList();
            if (!_isPartner)
            {
                _stats = await Gamification.GetStatsAsync(id);
            }
        }
        _load = false;
    }

    private static Color StatusColour(RequestStatus status) => status switch
    {
        RequestStatus.Requested => Color.Info,
        RequestStatus.Approved => Color.Success,
        RequestStatus.Rejected => Color.Error,
        _ => Color.Default,
    };

    // Prefill from a pending request if one exists, else from live data
    private void FieldsPrefill()
    {
        if (_agent!.NameChangeRequestedAt is not null)
        {
            _codename = _agent.PendingCodename ?? string.Empty;
            _realName = _agent.PendingRealName;
            _badgeNumber = BadgeNumbers.Normalize(_agent.PendingBadgeNumber);
        }
        else
        {
            _codename = _agent.Codename;
            _realName = _agent.RealName;
            _badgeNumber = BadgeNumbers.Normalize(_agent.BadgeNumber);
        }
    }

    private async Task AvatarUploadAsync(IBrowserFile? file)
    {
        if (file is null || _agent is null || _avatarBusy)
        {
            return;
        }
        // checked before OpenReadStream, which would otherwise throw its own English message
        if (file.Size > AvatarMaxBytes)
        {
            Snackbar.Add($"Das Profilbild ist zu groß (max. {AvatarMaxBytes / (1024 * 1024)} MB).", Severity.Error);
            return;
        }
        _avatarBusy = true;
        try
        {
            await using var stream = file.OpenReadStream(AvatarMaxBytes);
            await using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            buffer.Position = 0;
            await AgentService.AvatarSetAsync(_agent.Id, buffer, file.ContentType, file.Size, _user);
            Snackbar.Add(_isLeadership
                ? "Profilbild gespeichert."
                : "Profilbild eingereicht. Es wird nach Freigabe durch die Führung sichtbar.", Severity.Success);
            await AgentReloadAsync();
        }
        catch (Exception ex)
        {
            // a write-block or an oversized file must not kill the circuit
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _avatarBusy = false;
        }
    }

    private async Task AvatarRemoveAsync()
    {
        if (_agent is null || _avatarBusy)
        {
            return;
        }
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Profilbild entfernen?",
            "Dein Bild wird gelöscht; überall erscheinen wieder deine Initialen.", "Entfernen");
        if (!ok)
        {
            return;
        }
        _avatarBusy = true;
        try
        {
            await AgentService.AvatarRemoveAsync(_agent.Id, _user);
            Snackbar.Add("Profilbild entfernt.", Severity.Success);
            await AgentReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _avatarBusy = false;
        }
    }

    // no SecurityStamp rotation on a picture, so the session stays; the form fields are left
    // untouched on purpose, re-prefilling them would discard unsubmitted master-data edits
    private async Task AgentReloadAsync()
        => _agent = await AgentService.FindAsync(_agent!.Id) ?? _agent;

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid || _agent is null)
        {
            return;
        }

        _save = true;
        try
        {
            if (_isLeadership)
            {
                await AgentService.MasterDataChangeAsync(_agent.Id, _realName, _codename.Trim(), _badgeNumber, _user);
                // New SecurityStamp invalidates this session; redirect to re-login cleanly
                Nav.NavigateTo("/Account/Login", forceLoad: true);
                return;
            }

            await AgentService.NameChangeRequestAsync(_agent.Id, _realName, _codename.Trim(), _badgeNumber, _user);
            Snackbar.Add("Antrag eingereicht. Die Änderung greift nach Freigabe durch die Führung.", Severity.Success);

            // Reload so the status banner is correct
            _agent = await AgentService.FindAsync(_agent.Id);
            if (_agent is not null)
            {
                FieldsPrefill();
            }
        }
        catch (Exception ex)
        {
            // Don't let a write-block or service error kill the circuit
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _save = false;
        }
    }
}
