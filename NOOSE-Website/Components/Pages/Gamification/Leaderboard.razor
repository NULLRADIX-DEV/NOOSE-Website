@page "/bestenliste"
@using NOOSE_Website.Models.Enums
@using NOOSE_Website.Models.Gamification
@attribute [Authorize(Policy = Policies.InternalAgent)]
@inject IGamificationService Gamification
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDecorationService Decorations
@using NOOSE_Website.Models.Navigation

<PageTitle>Bestenliste · FIB</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.EmojiEvents"
            Title="Bestenliste"
            Subtitle="Team-Ranking nach dokumentierter Ermittlungsarbeit — die Führungsebene zählt mit, aber außer Wertung." />

<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudSelect T="GamificationPeriod" Value="_period" ValueChanged="OnPeriodChanged" Label="Zeitraum"
               Dense="true" Style="max-width:220px;">
        @foreach (var p in Enum.GetValues<GamificationPeriod>())
        {
            <MudSelectItem T="GamificationPeriod" Value="@p">@GamificationPeriodDisplay.Name(p)</MudSelectItem>
        }
    </MudSelect>
    @* below 600px only: which columns both tables show there *@
    <MobileColumnPicker ListKey="bestenliste" Columns="PhoneColumns" Defaults="PhoneDefaults"
                        VisibleChanged="@(v => _phoneColumns = v)" />
</MudPaper>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @if (_view.Ranked.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Filled.EmojiEvents" Title="Noch keine Wertung"
                    Text="@(_view.OutOfCompetition.Count == 0
                             ? "In diesem Zeitraum wurde noch keine zählbare Ermittlungsarbeit erfasst."
                             : "In diesem Zeitraum hat nur die Führungsebene Punkte gesammelt — sie steht außer Wertung.")" />
    }
    else
    {
        <MudPaper Elevation="1">
            @* Breakpoint.None: on phones a table with the chosen columns instead of stacked cards *@
            <MudTable Items="_view.Ranked" Dense="true" Hover="true" Breakpoint="Breakpoint.None">
                <HeaderContent>
                    <MudTh Style="width:3rem;" Class="@Col("platz")">#</MudTh>
                    <MudTh Class="@Col("agent")">Agent</MudTh>
                    <MudTh Style="text-align:right;" Class="@Col("punkte")">Punkte</MudTh>
                    <MudTh Style="text-align:right;" Class="@Col("akten")">Akten</MudTh>
                    <MudTh Style="text-align:right;" Class="@Col("doks")">Doks</MudTh>
                    <MudTh Style="text-align:right;" Class="@Col("verkn")">Verkn.</MudTh>
                    <MudTh Style="text-align:right;" Class="@Col("einstuf")">Einstuf.</MudTh>
                    <MudTh Style="text-align:right;" Class="@Col("beob")">Beob.</MudTh>
                    <MudTh Style="text-align:right;" Class="@Col("geloest")">Gelöst</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="#" Class="@Col("platz")">@RankBadge(context.Position)</MudTd>
                    <MudTd DataLabel="Agent" Class="@Col("agent")">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudLink Href="@($"/personal/{context.AgentId}")">@context.Codename</MudLink>
                            <DecorationStrip Plaques="@_plaques.GetValueOrDefault(context.AgentId)" />
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="Punkte" Style="text-align:right;" Class="@Col("punkte")"><b>@context.Points</b></MudTd>
                    <MudTd DataLabel="Akten" Style="text-align:right;" Class="@Col("akten")">@context.Records</MudTd>
                    <MudTd DataLabel="Doks" Style="text-align:right;" Class="@Col("doks")">@context.Docs</MudTd>
                    <MudTd DataLabel="Verkn." Style="text-align:right;" Class="@Col("verkn")">@context.Links</MudTd>
                    <MudTd DataLabel="Einstuf." Style="text-align:right;" Class="@Col("einstuf")">@context.Classifications</MudTd>
                    <MudTd DataLabel="Beob." Style="text-align:right;" Class="@Col("beob")">@context.Observations</MudTd>
                    <MudTd DataLabel="Gelöst" Style="text-align:right;" Class="@Col("geloest")">@context.SolvedCases</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }

    @if (_view.OutOfCompetition.Count > 0)
    {
        @* no position column: an out-of-competition row holds no place and must never render one *@
        <MudPaper Elevation="1" Class="mt-3">
            <MudStack Spacing="0" Class="px-3 pt-3 pb-1">
                <MudText Typo="Typo.subtitle2">Führungsebene (außer Wertung)</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Ab Section Chief zählt die Arbeit weiter mit, belegt aber keinen Platz.
                </MudText>
            </MudStack>
            @* the same column choice as the ranking; this table has no position column *@
            <MudTable Items="_view.OutOfCompetition" Dense="true" Hover="true" Breakpoint="Breakpoint.None">
                <HeaderContent>
                    <MudTh Class="@Col("agent")">Agent</MudTh>
                    <MudTh Style="text-align:right;" Class="@Col("punkte")">Punkte</MudTh>
                    <MudTh Style="text-align:right;" Class="@Col("akten")">Akten</MudTh>
                    <MudTh Style="text-align:right;" Class="@Col("doks")">Doks</MudTh>
                    <MudTh Style="text-align:right;" Class="@Col("verkn")">Verkn.</MudTh>
                    <MudTh Style="text-align:right;" Class="@Col("einstuf")">Einstuf.</MudTh>
                    <MudTh Style="text-align:right;" Class="@Col("beob")">Beob.</MudTh>
                    <MudTh Style="text-align:right;" Class="@Col("geloest")">Gelöst</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Agent" Class="@Col("agent")">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudLink Href="@($"/personal/{context.AgentId}")">@context.Codename</MudLink>
                            <DecorationStrip Plaques="@_plaques.GetValueOrDefault(context.AgentId)" />
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="Punkte" Style="text-align:right;" Class="@Col("punkte")"><b>@context.Points</b></MudTd>
                    <MudTd DataLabel="Akten" Style="text-align:right;" Class="@Col("akten")">@context.Records</MudTd>
                    <MudTd DataLabel="Doks" Style="text-align:right;" Class="@Col("doks")">@context.Docs</MudTd>
                    <MudTd DataLabel="Verkn." Style="text-align:right;" Class="@Col("verkn")">@context.Links</MudTd>
                    <MudTd DataLabel="Einstuf." Style="text-align:right;" Class="@Col("einstuf")">@context.Classifications</MudTd>
                    <MudTd DataLabel="Beob." Style="text-align:right;" Class="@Col("beob")">@context.Observations</MudTd>
                    <MudTd DataLabel="Gelöst" Style="text-align:right;" Class="@Col("geloest")">@context.SolvedCases</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
}

@code {
    private bool _load = true;
    private GamificationPeriod _period = GamificationPeriod.AllTime;
    private LeaderboardView _view = LeaderboardView.Empty;
    private IReadOnlyDictionary<string, IReadOnlyList<DecorationPlaqueView>> _plaques
        = new Dictionary<string, IReadOnlyList<DecorationPlaqueView>>();

    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    /// <summary>Both tables' columns for the phone column picker, in table order.</summary>
    private static readonly IReadOnlyList<(string Key, string Label)> PhoneColumns =
    [
        ("platz", "Platz"), ("agent", "Agent"), ("punkte", "Punkte"), ("akten", "Akten"), ("doks", "Dokumente"),
        ("verkn", "Verknüpfungen"), ("einstuf", "Einstufungen"), ("beob", "Beobachtungen"), ("geloest", "Gelöst"),
    ];

    /// <summary>Place, agent and points: what the ranking is about.</summary>
    private static readonly IReadOnlyList<string> PhoneDefaults = ["platz", "agent", "punkte"];

    // the defaults until the picker reports the stored choice, so even the first paint is narrow on a phone
    private IReadOnlySet<string> _phoneColumns = MobileColumnSet.Resolve(PhoneColumns.Select(c => c.Key).ToList(), PhoneDefaults, null);

    // below 600px only; from 600px up every column shows, as before
    private string Col(string key) => MobileColumnSet.ClassFor(_phoneColumns, key);

    protected override async Task OnInitializedAsync()
    {
        _period = QueryState.ReadEnum<GamificationPeriod>(Nav, "zeitraum") ?? GamificationPeriod.AllTime;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _load = true;
        _view = await Gamification.GetLeaderboardAsync(_period);
        try
        {
            var user = (await AuthStateTask).User;
            _plaques = await Decorations.GetPlaquesAsync(
                _view.Ranked.Concat(_view.OutOfCompetition).Select(e => e.AgentId).ToList(), user);
        }
        catch
        {
            /* best effort */
        }
        _load = false;
    }

    private async Task OnPeriodChanged(GamificationPeriod period)
    {
        _period = period;
        await QueryState.WriteAsync(JS, Nav, ("zeitraum", period == GamificationPeriod.AllTime ? null : period.ToString()));
        await LoadAsync();
    }

    private static string RankBadge(int position) => position switch
    {
        1 => "🥇",
        2 => "🥈",
        3 => "🥉",
        _ => position.ToString(),
    };
}
