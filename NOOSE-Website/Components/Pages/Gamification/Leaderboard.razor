@page "/bestenliste"
@using NOOSE_Website.Models.Enums
@using NOOSE_Website.Models.Gamification
@attribute [Authorize(Policy = Policies.InternalAgent)]
@inject IGamificationService Gamification
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDecorationService Decorations

<PageTitle>Bestenliste · NOOSE</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.EmojiEvents"
            Title="Bestenliste"
            Subtitle="Team-Ranking nach dokumentierter Ermittlungsarbeit — die Führungsebene zählt mit, aber außer Wertung." />

<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudSelect T="GamificationPeriod" Value="_period" ValueChanged="OnPeriodChanged" Label="Zeitraum"
               Dense="true" Style="max-width:220px;">
        @foreach (var p in Enum.GetValues<GamificationPeriod>())
        {
            <MudSelectItem T="GamificationPeriod" Value="@p">@GamificationPeriodDisplay.Name(p)</MudSelectItem>
        }
    </MudSelect>
</MudPaper>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @if (_view.Ranked.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Filled.EmojiEvents" Title="Noch keine Wertung"
                    Text="@(_view.OutOfCompetition.Count == 0
                             ? "In diesem Zeitraum wurde noch keine zählbare Ermittlungsarbeit erfasst."
                             : "In diesem Zeitraum hat nur die Führungsebene Punkte gesammelt — sie steht außer Wertung.")" />
    }
    else
    {
        <MudPaper Elevation="1">
            <MudTable Items="_view.Ranked" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh Style="width:3rem;">#</MudTh>
                    <MudTh>Agent</MudTh>
                    <MudTh Style="text-align:right;">Punkte</MudTh>
                    <MudTh Style="text-align:right;">Akten</MudTh>
                    <MudTh Style="text-align:right;">Doks</MudTh>
                    <MudTh Style="text-align:right;">Verkn.</MudTh>
                    <MudTh Style="text-align:right;">Einstuf.</MudTh>
                    <MudTh Style="text-align:right;">Beob.</MudTh>
                    <MudTh Style="text-align:right;">Gelöst</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="#">@RankBadge(context.Position)</MudTd>
                    <MudTd DataLabel="Agent">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudLink Href="@($"/personal/{context.AgentId}")">@context.Codename</MudLink>
                            <DecorationStrip Plaques="@_plaques.GetValueOrDefault(context.AgentId)" />
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="Punkte" Style="text-align:right;"><b>@context.Points</b></MudTd>
                    <MudTd DataLabel="Akten" Style="text-align:right;">@context.Records</MudTd>
                    <MudTd DataLabel="Doks" Style="text-align:right;">@context.Docs</MudTd>
                    <MudTd DataLabel="Verkn." Style="text-align:right;">@context.Links</MudTd>
                    <MudTd DataLabel="Einstuf." Style="text-align:right;">@context.Classifications</MudTd>
                    <MudTd DataLabel="Beob." Style="text-align:right;">@context.Observations</MudTd>
                    <MudTd DataLabel="Gelöst" Style="text-align:right;">@context.SolvedCases</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }

    @if (_view.OutOfCompetition.Count > 0)
    {
        @* no position column: an out-of-competition row holds no place and must never render one *@
        <MudPaper Elevation="1" Class="mt-3">
            <MudStack Spacing="0" Class="px-3 pt-3 pb-1">
                <MudText Typo="Typo.subtitle2">Führungsebene (außer Wertung)</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Ab Supervisory Special Agent zählt die Arbeit weiter mit, belegt aber keinen Platz.
                </MudText>
            </MudStack>
            <MudTable Items="_view.OutOfCompetition" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>Agent</MudTh>
                    <MudTh Style="text-align:right;">Punkte</MudTh>
                    <MudTh Style="text-align:right;">Akten</MudTh>
                    <MudTh Style="text-align:right;">Doks</MudTh>
                    <MudTh Style="text-align:right;">Verkn.</MudTh>
                    <MudTh Style="text-align:right;">Einstuf.</MudTh>
                    <MudTh Style="text-align:right;">Beob.</MudTh>
                    <MudTh Style="text-align:right;">Gelöst</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Agent">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudLink Href="@($"/personal/{context.AgentId}")">@context.Codename</MudLink>
                            <DecorationStrip Plaques="@_plaques.GetValueOrDefault(context.AgentId)" />
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="Punkte" Style="text-align:right;"><b>@context.Points</b></MudTd>
                    <MudTd DataLabel="Akten" Style="text-align:right;">@context.Records</MudTd>
                    <MudTd DataLabel="Doks" Style="text-align:right;">@context.Docs</MudTd>
                    <MudTd DataLabel="Verkn." Style="text-align:right;">@context.Links</MudTd>
                    <MudTd DataLabel="Einstuf." Style="text-align:right;">@context.Classifications</MudTd>
                    <MudTd DataLabel="Beob." Style="text-align:right;">@context.Observations</MudTd>
                    <MudTd DataLabel="Gelöst" Style="text-align:right;">@context.SolvedCases</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
}

@code {
    private bool _load = true;
    private GamificationPeriod _period = GamificationPeriod.AllTime;
    private LeaderboardView _view = LeaderboardView.Empty;
    private IReadOnlyDictionary<string, IReadOnlyList<DecorationPlaqueView>> _plaques
        = new Dictionary<string, IReadOnlyList<DecorationPlaqueView>>();

    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _period = QueryState.ReadEnum<GamificationPeriod>(Nav, "zeitraum") ?? GamificationPeriod.AllTime;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _load = true;
        _view = await Gamification.GetLeaderboardAsync(_period);
        try
        {
            var user = (await AuthStateTask).User;
            _plaques = await Decorations.GetPlaquesAsync(
                _view.Ranked.Concat(_view.OutOfCompetition).Select(e => e.AgentId).ToList(), user);
        }
        catch
        {
            /* best effort */
        }
        _load = false;
    }

    private async Task OnPeriodChanged(GamificationPeriod period)
    {
        _period = period;
        await QueryState.WriteAsync(JS, Nav, ("zeitraum", period == GamificationPeriod.AllTime ? null : period.ToString()));
        await LoadAsync();
    }

    private static string RankBadge(int position) => position switch
    {
        1 => "🥇",
        2 => "🥈",
        3 => "🥉",
        _ => position.ToString(),
    };
}
