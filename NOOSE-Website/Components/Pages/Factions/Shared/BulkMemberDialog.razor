@* Bulk-reconcile faction members from a pasted name list: create/link, dedupe, optionally remove the rest. *@
@inject IPersonService PersonService
@inject IFactionService FactionService
@inject ISnackbar Snackbar

@* long form: full screen below 600px (noose-dialog-lang); the fixed min-widths give way there *@
<MudDialog Class="noose-dialog-lang">
    <DialogContent>
        @if (_stage == 1)
        {
            <MudStack Spacing="3">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Einen Namen pro Zeile einfügen. Bestehende Akten werden erkannt und zugeordnet,
                    unbekannte Namen als neue Akte angelegt. Doppelte werden zusammengefasst.
                </MudText>
                <MudTextField @bind-Value="_pasteText" Label="Namen (eine Zeile pro Person)" Variant="Variant.Outlined"
                              Lines="10" Immediate="true" AutoFocus="true"
                              Placeholder="@("Max Mustermann\nErika Musterfrau\n…")"
                              HelperText="@($"Höchstens {MaxLines} Namen auf einmal.")" />
                @if (Ranks.Count > 0)
                {
                    <MudSelect T="string" @bind-Value="_sharedRank" Label="Rang für alle (optional)" Variant="Variant.Outlined"
                               Clearable="true" Dense="true">
                        @foreach (var r in Ranks)
                        {
                            <MudSelectItem Value="@r">@r</MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    <MudTextField @bind-Value="_sharedRank" Label="Rang für alle (optional)" Variant="Variant.Outlined" />
                }
            </MudStack>
        }
        else
        {
            <MudStack Spacing="3" Style="min-width:480px;" Class="noose-min-breite-frei">
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">@_countCreate neu</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">@_countAdd zuordnen</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@_countAlready bereits Mitglied</MudChip>
                    @if (_countAmbiguous > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">@_countAmbiguous mehrdeutig</MudChip>
                    }
                </MudStack>

                @if (_countAmbiguous > 0)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined">
                        Bitte jede mehrdeutige Zeile zuordnen (bestehende Akte wählen oder neu anlegen), bevor du anwendest.
                    </MudAlert>
                }

                <MudPaper Class="pa-2" Outlined="true" Style="max-height:320px; overflow-y:auto;">
                    <MudStack Spacing="1">
                        @foreach (var row in _rows)
                        {
                            var otherFactions = OtherFactions(row);
                            <MudStack Spacing="0" Class="px-1 py-1">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="noose-eintrag">
                                    <MudChip T="string" Size="Size.Small" Color="@KindColor(row.Kind)" Variant="Variant.Filled"
                                             Icon="@KindIcon(row.Kind)">@KindLabel(row.Kind)</MudChip>
                                    <MudText Typo="Typo.body2"><b>@row.Display</b></MudText>
                                    @if (row.Kind == RowKind.Ambiguous)
                                    {
                                        <MudSpacer />
                                        <MudSelect T="string" Value="@AmbiguousValue(row)" ValueChanged="@(v => SetAmbiguous(row, v))"
                                                   Label="Zuordnen" Dense="true" Variant="Variant.Outlined" Style="min-width:240px;" Class="noose-breite-frei">
                                            @foreach (var c in row.Candidates)
                                            {
                                                <MudSelectItem Value="@c.Id">@c.Name (@c.CaseNumber)</MudSelectItem>
                                            }
                                            <MudSelectItem Value="@NewSentinel">➕ Neue Person anlegen</MudSelectItem>
                                        </MudSelect>
                                    }
                                    else if (row.Kind == RowKind.AddExisting && row.Candidates.Count == 1)
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@row.Candidates[0].CaseNumber</MudText>
                                    }
                                    @if (otherFactions.Count > 0)
                                    {
                                        <MudSpacer />
                                        <MudCheckBox T="bool" @bind-Value="row.RemoveFromOthers" Dense="true" Color="Color.Error"
                                                     Label="Alte Fraktion verlassen" />
                                    }
                                </MudStack>
                                @if (otherFactions.Count > 0)
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="padding-left:44px;">
                                        @($"Derzeit Mitglied in: {string.Join(", ", otherFactions.Select(f => f.Name))}")
                                    </MudText>
                                }
                            </MudStack>
                        }
                    </MudStack>
                </MudPaper>

                @if (_orphans.Count > 0)
                {
                    <MudDivider />
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="noose-kopf-umbruch">
                        <MudText Typo="Typo.subtitle2">Nicht in der Liste (@_orphans.Count)</MudText>
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ToggleAllOrphans">
                            @(_orphans.All(o => o.Remove) ? "Keine" : "Alle") auswählen
                        </MudButton>
                    </MudStack>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Angehakte Mitglieder werden aus der Fraktion entfernt (Standard: keine).
                    </MudText>
                    <MudPaper Class="pa-2" Outlined="true" Style="max-height:200px; overflow-y:auto;">
                        <MudStack Spacing="0">
                            @foreach (var o in _orphans)
                            {
                                <MudCheckBox T="bool" @bind-Value="o.Remove" Dense="true" Color="Color.Error">
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="noose-eintrag">
                                        <MudText Typo="Typo.body2">@o.Member.Person?.Name</MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@o.Member.Person?.CaseNumber</MudText>
                                        @if (o.Member.IsLead)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Leitung</MudChip>
                                        }
                                    </MudStack>
                                </MudCheckBox>
                            }
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        @if (_stage == 1)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ReconcileAsync"
                       Disabled="@(_busy || string.IsNullOrWhiteSpace(_pasteText))"
                       StartIcon="@Icons.Material.Filled.ManageSearch">
                @(_busy ? "Wird geprüft…" : "Prüfen")
            </MudButton>
        }
        else
        {
            <MudButton OnClick="@(() => _stage = 1)" Disabled="_busy">Zurück</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ApplyAsync"
                       Disabled="@(!CanApply)" StartIcon="@Icons.Material.Filled.GroupAdd">
                @(_busy ? "Wird angewendet…" : "Anwenden")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public string FactionId { get; set; } = default!;
    [Parameter, EditorRequired] public ClaimsPrincipal User { get; set; } = default!;
    [Parameter] public IReadOnlyList<string> Ranks { get; set; } = Array.Empty<string>();
    [Parameter] public IReadOnlyList<FactionMember> CurrentMembers { get; set; } = Array.Empty<FactionMember>();

    private const int MaxLines = 200;
    private const string NewSentinel = "__new__";

    private int _stage = 1;
    private string? _pasteText;
    private string? _sharedRank;
    private bool _busy;
    private List<BulkRow> _rows = new();
    private List<OrphanRow> _orphans = new();
    private Dictionary<string, List<PersonAffiliation>> _otherFactions = new();

    private int _countCreate;
    private int _countAdd;
    private int _countAlready;
    private int _countAmbiguous;

    private enum RowKind { Create, AddExisting, Ambiguous, AlreadyMember }

    private sealed class BulkRow
    {
        public string Display { get; set; } = string.Empty;
        public string Key { get; set; } = string.Empty;
        public RowKind Kind { get; set; }
        public List<Person> Candidates { get; set; } = new();
        public string? SelectedPersonId { get; set; }
        public bool CreateNewChosen { get; set; }
        public bool RemoveFromOthers { get; set; }
    }

    private sealed class OrphanRow
    {
        public FactionMember Member { get; set; } = default!;
        public bool Remove { get; set; }
    }

    private static string Key(string s) => s.Trim().ToLowerInvariant();

    private bool CanApply => !_busy && _rows.All(r =>
        r.Kind != RowKind.Ambiguous || r.CreateNewChosen || r.SelectedPersonId is not null);

    private async Task ReconcileAsync()
    {
        var distinct = new List<string>();
        var seen = new HashSet<string>();
        foreach (var line in (_pasteText ?? string.Empty).Split('\n'))
        {
            var name = line.Trim();
            if (name.Length > 0 && seen.Add(Key(name)))
            {
                distinct.Add(name);
            }
        }

        if (distinct.Count == 0)
        {
            Snackbar.Add("Keine Namen eingegeben.", Severity.Warning);
            return;
        }
        if (distinct.Count > MaxLines)
        {
            Snackbar.Add($"Zu viele Namen ({distinct.Count}). Höchstens {MaxLines} auf einmal.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var matches = await PersonService.FindByNamesAsync(distinct, User.IsLeadership());
            var byKey = matches
                .GroupBy(p => Key(p.Name))
                .ToDictionary(g => g.Key, g => g.ToList());

            var memberPersonIds = CurrentMembers.Select(m => m.PersonId).ToHashSet();
            var memberNames = CurrentMembers
                .Where(m => m.Person is not null)
                .Select(m => Key(m.Person!.Name))
                .ToHashSet();

            _rows = new List<BulkRow>();
            foreach (var name in distinct)
            {
                var key = Key(name);
                var cands = byKey.TryGetValue(key, out var list) ? list : new List<Person>();
                var row = new BulkRow { Display = name, Key = key, Candidates = cands };

                // Already-member wins: covers a classified member the viewer can't resolve, avoiding a duplicate.
                if (cands.Any(p => memberPersonIds.Contains(p.Id)) || memberNames.Contains(key))
                {
                    row.Kind = RowKind.AlreadyMember;
                }
                else if (cands.Count == 0)
                {
                    row.Kind = RowKind.Create;
                }
                else
                {
                    var nonMembers = cands.Where(p => !memberPersonIds.Contains(p.Id)).ToList();
                    if (nonMembers.Count == 1)
                    {
                        row.Kind = RowKind.AddExisting;
                        row.Candidates = nonMembers;
                        row.SelectedPersonId = nonMembers[0].Id;
                    }
                    else
                    {
                        row.Kind = RowKind.Ambiguous;
                        row.Candidates = nonMembers;
                    }
                }
                _rows.Add(row);
            }

            var pastedSet = distinct.Select(Key).ToHashSet();
            _orphans = CurrentMembers
                .Where(m => m.Person is not null && !pastedSet.Contains(Key(m.Person!.Name)))
                .OrderBy(m => m.Person!.Name)
                .Select(m => new OrphanRow { Member = m })
                .ToList();

            var candidateIds = _rows
                .Where(r => r.Kind is RowKind.AddExisting or RowKind.Ambiguous)
                .SelectMany(r => r.Candidates)
                .Select(p => p.Id)
                .Distinct()
                .ToList();
            _otherFactions = new();
            if (candidateIds.Count > 0)
            {
                var affiliations = await PersonService.GetAffiliationsManyAsync(candidateIds, ViewerScope.From(User));
                _otherFactions = affiliations.ToDictionary(
                    kv => kv.Key,
                    kv => kv.Value.Where(a => a.Type == nameof(Faction) && a.Id != FactionId).ToList());
            }

            _countCreate = _rows.Count(r => r.Kind == RowKind.Create);
            _countAdd = _rows.Count(r => r.Kind == RowKind.AddExisting);
            _countAlready = _rows.Count(r => r.Kind == RowKind.AlreadyMember);
            _countAmbiguous = _rows.Count(r => r.Kind == RowKind.Ambiguous);
            _stage = 2;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ApplyAsync()
    {
        if (!CanApply)
        {
            return;
        }

        var toAdd = new List<MemberInput>();
        foreach (var r in _rows)
        {
            switch (r.Kind)
            {
                case RowKind.Create:
                    toAdd.Add(new MemberInput { NewPersonName = r.Display, Rank = _sharedRank, IsLead = false });
                    break;
                case RowKind.AddExisting:
                    toAdd.Add(new MemberInput
                    {
                        PersonId = r.SelectedPersonId!, Rank = _sharedRank, IsLead = false,
                        RemoveFromOtherFactions = r.RemoveFromOthers,
                    });
                    break;
                case RowKind.Ambiguous:
                    toAdd.Add(r.CreateNewChosen
                        ? new MemberInput { NewPersonName = r.Display, Rank = _sharedRank, IsLead = false }
                        : new MemberInput
                        {
                            PersonId = r.SelectedPersonId!, Rank = _sharedRank, IsLead = false,
                            RemoveFromOtherFactions = r.RemoveFromOthers,
                        });
                    break;
            }
        }
        var removeIds = _orphans.Where(o => o.Remove).Select(o => o.Member.Id).ToList();

        _busy = true;
        try
        {
            var srv = await FactionService.MembersBulkApplyAsync(FactionId, toAdd, removeIds, User);
            var already = _countAlready + srv.AlreadyMembers;
            MudDialog.Close(DialogResult.Ok(new BulkMemberResult(
                srv.Created, srv.AddedExisting, already, srv.Removed, srv.RemovedFromOtherFactions)));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _busy = false;
        }
    }

    private void ToggleAllOrphans()
    {
        var target = !_orphans.All(o => o.Remove);
        foreach (var o in _orphans)
        {
            o.Remove = target;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private string? AmbiguousValue(BulkRow r) => r.CreateNewChosen ? NewSentinel : r.SelectedPersonId;

    private void SetAmbiguous(BulkRow r, string value)
    {
        r.RemoveFromOthers = false;
        if (value == NewSentinel)
        {
            r.CreateNewChosen = true;
            r.SelectedPersonId = null;
        }
        else
        {
            r.CreateNewChosen = false;
            r.SelectedPersonId = value;
        }
    }

    /// <summary>Visible other factions of the row's resolved person; empty for new or already-member rows.</summary>
    private List<PersonAffiliation> OtherFactions(BulkRow r)
    {
        if (r.Kind is RowKind.Create or RowKind.AlreadyMember)
        {
            return new();
        }
        var personId = r.Kind == RowKind.Ambiguous && r.CreateNewChosen ? null : r.SelectedPersonId;
        return personId is not null && _otherFactions.TryGetValue(personId, out var list) ? list : new();
    }

    private static Color KindColor(RowKind k) => k switch
    {
        RowKind.Create => Color.Success,
        RowKind.AddExisting => Color.Info,
        RowKind.Ambiguous => Color.Warning,
        _ => Color.Default,
    };

    private static string KindLabel(RowKind k) => k switch
    {
        RowKind.Create => "Neu anlegen",
        RowKind.AddExisting => "Zuordnen",
        RowKind.Ambiguous => "Mehrdeutig",
        _ => "Bereits Mitglied",
    };

    private static string KindIcon(RowKind k) => k switch
    {
        RowKind.Create => Icons.Material.Filled.PersonAddAlt1,
        RowKind.AddExisting => Icons.Material.Filled.HowToReg,
        RowKind.Ambiguous => Icons.Material.Filled.HelpOutline,
        _ => Icons.Material.Filled.CheckCircle,
    };

    /// <summary>Opens the bulk-member dialog; returns the reconcile outcome or null if cancelled.</summary>
    public static async Task<BulkMemberResult?> ShowAsync(IDialogService dialog, string factionId, ClaimsPrincipal user,
        IReadOnlyList<string> ranks, IReadOnlyList<FactionMember> currentMembers)
    {
        var parameters = new DialogParameters<BulkMemberDialog>
        {
            { x => x.FactionId, factionId },
            { x => x.User, user },
            { x => x.Ranks, ranks },
            { x => x.CurrentMembers, currentMembers },
        };
        var reference = await dialog.ShowAsync<BulkMemberDialog>("Mitglieder per Liste hinzufügen", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });
        var result = await reference.Result;
        return result is { Canceled: false, Data: BulkMemberResult r } ? r : null;
    }
}
