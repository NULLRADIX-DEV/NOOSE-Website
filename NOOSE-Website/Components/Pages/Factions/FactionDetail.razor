@page "/fraktionen/{Id}"
@inject IFactionService FactionService
@inject IAccessLogService AccessLog
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IPartnerVisibilityPolicyService PartnerPolicy
@inject NOOSE_Website.Services.Public.IPublicFactionProfileService PublicProfiles

<PageTitle>@(_faction?.Name ?? "Fraktion") · NOOSE</PageTitle>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_faction is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        Fraktion nicht gefunden oder nicht zugänglich (ggf. Verschlusssache).
    </MudAlert>
}
else
{
    @if (_publicBanner is { Status: PublicProfileStatus.Veroeffentlicht } banner)
    {
        @* only the published state: a draft is not outside, and its existence is an internal matter *@
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mb-4">
            Diese Organisation ist öffentlich dargestellt (@PublicFactionStandingDisplay.Name(banner.Standing)).
        </MudAlert>
    }

    @if (_faction.IsArchived)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <div>
                    <MudText Typo="Typo.body2">
                        Archiviert am @(_faction.ArchivedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—") —
                        erscheint nicht in Listen, Auswahllisten und der Standardsuche.
                    </MudText>
                    @if (!string.IsNullOrWhiteSpace(_faction.ArchiveReason))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Grund: @_faction.ArchiveReason</MudText>
                    }
                </div>
                <MudSpacer />
                <AuthorizeView Policy="@Policies.WriteAccess" Context="archiv">
                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Unarchive"
                               OnClick="UnarchiveAsync">Zurückholen</MudButton>
                </AuthorizeView>
            </MudStack>
        </MudAlert>
    }

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/fraktionen" aria-label="Zurück" />
        <CompromisedBadge EntityType="@nameof(Faction)" EntityId="@_faction.Id" />
        <MudSpacer />
        <MudTooltip Text="Druckansicht – Akte drucken / als PDF speichern">
            <MudIconButton Icon="@Icons.Material.Filled.Print" Color="Color.Default"
                           Href="@($"/fraktionen/{Id}/druck")" Target="_blank"
                           aria-label="Druckansicht öffnen" />
        </MudTooltip>
        <DossierExportButton EntityType="@nameof(Faction)" EntityId="@Id" />
        @if (!_isPartner)
        {
            <FollowButton EntityType="@nameof(Faction)" EntityId="@_faction.Id" User="_user" />
            <JobCreateButton EntityType="@nameof(Faction)" EntityId="@_faction.Id" />
        }
        <AuthorizeView Policy="@Policies.WriteAccess" Context="freigabe">
            <PartnerShareButton EntityType="@nameof(Faction)" EntityId="@_faction.Id" />
        </AuthorizeView>
        <AuthorizeView Policy="@Policies.WriteAccess" Context="schreib">
            <MudButton Href="@($"/fraktionen/{_faction.Id}/bearbeiten")" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">Bearbeiten</MudButton>
        </AuthorizeView>
        <AuthorizeView Policy="@Policies.WriteAccess" Context="ablegen">
            @if (!_faction.IsArchived)
            {
                <MudButton Color="Color.Default" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Archive"
                           OnClick="ArchiveAsync">Archivieren</MudButton>
            }
        </AuthorizeView>
        <AuthorizeView Policy="@Policies.Leadership">
            <MudButton Color="Color.Error" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync">Löschen</MudButton>
        </AuthorizeView>
    </MudStack>

    @if (!_isPartner)
    {
        <MudPaper Class="pa-2 mb-4" Elevation="1">
            <TagChips EntityType="@nameof(Faction)" EntityId="@_faction.Id" User="_user" />
        </MudPaper>
    }

    <MudGrid>
        <MudItem xs="12" md="4" lg="3">
            <div class="akte-steckkarte">
                <FactionCard Faction="_faction" MemberCount="_memberCount" InvestigationLead="_investigationLead"
                                TitleImagePhotoId="@RecordAvatar.ProfileId(_faction.Photos)"
                                User="_user" Changed="NewLoadAsync" />
            </div>
        </MudItem>

        <MudItem xs="12" md="8" lg="9">
            @if (_renderTabs.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    Für Ihren Zugang sind in dieser Akte keine Bereiche freigegeben.
                </MudAlert>
            }
            else
            {
            @if (TabOn("historie"))
            {
                <SinceLastVisitBar EntityType="@nameof(Faction)" EntityId="@_faction.Id" User="_user" Since="_since" />
            }
            <RecordSectionRail>
                @if (TabOn("stammdaten"))
                {
                <RecordSection Group="Akte" Slug="stammdaten" Label="Stammdaten" Icon="@Icons.Material.Filled.Info">
                    <MudStack Spacing="3">
                        <MudStack Row="true" Spacing="6" Class="flex-wrap">
                            @foreach (var (label, value) in MasterData())
                            {
                                <div>
                                    <MudText Typo="Typo.subtitle2">@label</MudText>
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@value</MudText>
                                </div>
                            }
                        </MudStack>
                        @if (!string.IsNullOrWhiteSpace(_faction.Estate))
                        {
                            <div>
                                <MudText Typo="Typo.subtitle2">Anwesen</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="white-space:pre-line;"><MentionDisplay Text="@_faction.Estate" /></MudText>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_faction.Targets))
                        {
                            <div>
                                <MudText Typo="Typo.subtitle2">Ziele</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary"><MentionDisplay Text="@_faction.Targets" /></MudText>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_faction.Description))
                        {
                            <div>
                                <MudText Typo="Typo.subtitle2">Beschreibung</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary"><MentionDisplay Text="@_faction.Description" /></MudText>
                            </div>
                        }
                        <ProfileList Title="Ränge" Values="@_faction.Ranks.OrderBy(r => r.Order).Select(r => r.Designation)" />
                        @if (TabOn("bestaende"))
                        {
                            <ProfileList Title="Drogenrouten" Values="StockTexts(_faction.DrugRoutes.Select(d => (d.Designation, d.Note)))" />
                        }
                        @if (TabOn("mitglieder"))
                        {
                            <ProfileList Title="Leitung" Values="StockTexts(_members.Where(m => m.IsLead).Select(m => (m.Person!.Name, m.Rank)))" />
                        }
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Erstellt am @(_faction.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy"))
                            @if (_faction.ModifiedAt is { } modified)
                            {
                                @($" · Zuletzt geändert am {modified.ToLocalTime():dd.MM.yyyy}")
                            }
                        </MudText>
                    </MudStack>
                </RecordSection>
                }
                @if (TabOn("mitglieder"))
                {
                <RecordSection Group="Struktur" Slug="mitglieder" Label="Mitglieder" Icon="@Icons.Material.Filled.Groups">
                    <MembersPanel FactionId="@_faction.Id" User="_user" Ranks="_ranks" Changed="MembersModifiedAsync" />
                </RecordSection>
                }
                @* assigned NOOSE agents: internal only *@
                @if (!_isPartner)
                {
                <RecordSection Group="Struktur" Slug="agents" Label="Zugeteilte Agents" Icon="@Icons.Material.Filled.ManageAccounts">
                    <FactionAgentsPanel FactionId="@_faction.Id" User="_user" Changed="InvestigationLeadRefreshAsync" />
                </RecordSection>
                <RecordSection Group="Ermittlung" Slug="informanten" Label="Informanten" Icon="@Icons.Material.Filled.VisibilityOff">
                    <FactionInformantsPanel FactionId="@_faction.Id" User="_user" />
                </RecordSection>
                <RecordSection Group="Ermittlung" Slug="entfuehrungen" Label="Verübte Entführungen" Icon="@Icons.Material.Filled.PersonOff">
                    <AbductionsPanel PerpetratorType="@nameof(Faction)" PerpetratorId="@_faction.Id" />
                </RecordSection>
                <RecordSection Group="Ermittlung" Slug="asservate-mitglieder" Label="Asservate (Mitglieder)" Icon="@Icons.Material.Filled.Inventory">
                    <EvidenceOwnerPanel FactionId="@_faction.Id" />
                </RecordSection>
                @* deliberately outside the "einstufung" section and internal only: PartnerTabCatalog lists that slug,
                   so anything in it is visible to a released partner — and what NOOSE is preparing to publish is not
                   partner business *@
                <RecordSection Group="Akte" Slug="oeffentlich" Label="Öffentliches Profil" Icon="@Icons.Material.Filled.Public">
                    <PublicFactionProfilePanel FactionId="@_faction.Id" User="_user" Changed="PublicProfileReloadAsync" />
                </RecordSection>
                }
                @if (TabOn("bestaende"))
                {
                <RecordSection Group="Struktur" Slug="bestaende" Label="Bestände" Icon="@Icons.Material.Filled.Inventory2">
                    <MudStack Spacing="3">
                        <ProfileList Title="WeaponStock" Values="StockTexts(_faction.WeaponStock.Select(w => (w.Designation, w.Quantity)))" />
                        <ProfileList Title="Inventory" Values="StockTexts(_faction.Inventory.Select(l => (l.Designation, l.Quantity)))" />
                        <ProfileList Title="DrugRoutes" Values="StockTexts(_faction.DrugRoutes.Select(d => (d.Designation, d.Note)))" />
                    </MudStack>
                </RecordSection>
                }
                @if (TabOn("aktivitaeten"))
                {
                <RecordSection Group="Ermittlung" Slug="aktivitaeten" Label="Aktivitäten" Icon="@Icons.Material.Filled.Bolt">
                    <AgentActivityLinkedPanel EntityType="@nameof(Faction)" EntityId="@_faction.Id" User="_user" />
                </RecordSection>
                }
                @* partner-safe child service *@
                @if (TabOn("fotos"))
                {
                <RecordSection Group="Anhänge" Slug="fotos" Label="Fotos" Icon="@Icons.Material.Filled.PhotoLibrary">
                    <FactionPhotoGallery FactionId="@_faction.Id" User="_user" Changed="PhotosModifiedAsync" />
                </RecordSection>
                }
                @if (TabOn("einstufung"))
                {
                <RecordSection Group="Akte" Slug="einstufung" Label="Einstufung" Icon="@Icons.Material.Filled.Shield">
                    <ClassificationPanel Current="_faction.Classification" History="_classificationHistory" User="_user" OnSet="ClassificationSetAsync"
                                     EntityType="@nameof(Faction)" EntityId="@_faction.Id" TargetDesignation="@($"{_faction.Name} ({_faction.CaseNumber})")" />
                </RecordSection>
                }
                @if (TabOn("gefaehrdung"))
                {
                <RecordSection Group="Akte" Slug="gefaehrdung" Label="Gefährdung" Icon="@Icons.Material.Filled.Warning">
                    <HazardPanel Score="_faction.ThreatScore" Confidence="_faction.ThreatConfidence"
                                      DetailJson="@_faction.ThreatDetailJson" />
                    <MudDivider Class="my-4" />
                    <RecordThreatTrend EntityType="@nameof(Faction)" EntityId="@_faction.Id" />
                </RecordSection>
                }
                @if (TabOn("doks"))
                {
                <RecordSection Group="Ermittlung" Slug="doks" Label="Doks" Icon="@Icons.Material.Filled.Description">
                    <OrgDocsPanel OrgType="@nameof(Faction)" OrgId="@_faction.Id" User="_user" />
                </RecordSection>
                }
                @* partner-safe child services *@
                @if (TabOn("beziehungen"))
                {
                <RecordSection Group="Struktur" Slug="beziehungen" Label="Beziehungen" Icon="@Icons.Material.Filled.Hub">
                    <OrgRelationsPanel EntityType="@nameof(Faction)" EntityId="@_faction.Id" User="_user" />
                </RecordSection>
                }
                @if (TabOn("quellen"))
                {
                <RecordSection Group="Anhänge" Slug="quellen" Label="Quellen" Icon="@Icons.Material.Filled.AttachFile">
                    <SourcesPanel EntityType="@nameof(Faction)" EntityId="@_faction.Id" User="_user" />
                </RecordSection>
                }
                @if (TabOn("wiedervorlagen"))
                {
                <RecordSection Group="Verlauf" Slug="wiedervorlagen" Label="Wiedervorlagen" Icon="@Icons.Material.Filled.EventRepeat">
                    <FollowupPanel EntityType="@nameof(Faction)" EntityId="@_faction.Id" User="_user" />
                </RecordSection>
                }
                @if (TabOn("kommentare"))
                {
                <RecordSection Group="Verlauf" Slug="kommentare" Label="Kommentare" Icon="@Icons.Material.Filled.Comment">
                    <CommentPanel EntityType="@nameof(Faction)" EntityId="@_faction.Id" User="_user" />
                </RecordSection>
                }
                @if (TabOn("zusatzfelder"))
                {
                <RecordSection Group="Akte" Slug="zusatzfelder" Label="Zusatzfelder" Icon="@Icons.Material.Filled.Tune">
                    <CustomFieldsPanel EntityType="@nameof(Faction)" EntityId="@_faction.Id" User="_user" />
                </RecordSection>
                }
                @* partner-safe: timeline filters cross-refs for partners *@
                @if (TabOn("historie"))
                {
                <RecordSection Group="Verlauf" Slug="historie" Label="Zeitstrahl" Icon="@Icons.Material.Filled.Timeline">
                    <TimelinePanel EntityType="@nameof(Faction)" EntityId="@_faction.Id" User="_user" NewSince="_since" @key="_historyKey" />
                </RecordSection>
                }
                @* NOOSEI-Kurzbrief: internal only *@
                @if (!_isPartner)
                {
                <RecordSection Group="Analyse" Slug="ki-kurzbrief" Label="NOOSEI-Kurzbrief" Icon="@Icons.Material.Filled.AutoAwesome">
                    <KiBriefPanel EntityType="@nameof(Faction)" EntityId="@_faction.Id" User="_user" />
                </RecordSection>
                }
            </RecordSectionRail>
            }
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public string Id { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;
    private bool _isPartner;
    private Faction? _faction;
    private int _memberCount;
    private List<FactionMember> _members = new();
    private List<string> _investigationLead = new();
    private List<string> _ranks = new();
    private List<ClassificationHistory> _classificationHistory = new();
    private ClaimsPrincipal _user = default!;
    private Guid _historyKey = Guid.NewGuid();
    private string? _loadedId;
    // last view of the previous visit, read before this one is logged
    private DateTime? _since;

    // every section slug on this page; the rail owns which one is active
    private static readonly string[] _tabs =
    {
        "stammdaten", "mitglieder", "agents", "bestaende", "aktivitaeten", "fotos", "einstufung", "gefaehrdung", "doks",
        "beziehungen", "quellen", "wiedervorlagen", "kommentare", "zusatzfelder", "historie",
    };

    // partner tab gating: null = no restriction (internal/unconfigured/individually released)
    private IReadOnlySet<string>? _visibleTabs;
    private List<string> _renderTabs = new();
    private bool TabOn(string slug) => _visibleTabs is null || _visibleTabs.Contains(slug);
    private void RebuildRenderTabs() => _renderTabs = _tabs.Where(s => (s != "agents" || !_isPartner) && TabOn(s)).ToList();

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _isPartner = _user.IsPartner();
    }

    // Page is reused across /fraktionen/{A}→{B}, so OnInitializedAsync won't re-run; react to Id change here.
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }
        _loadedId = Id;
        _load = true;
        _faction = null;
        _since = null;
        await LoadAsync();
        if (_faction is not null)
        {
            _since = await AccessLog.PreviousVisitAsync(nameof(Faction), _faction.Id);
            await AccessLog.LogViewAsync(nameof(Faction), _faction.Id);
        }
    }

    private PublicFactionProfileBanner? _publicBanner;

    private async Task PublicProfileLoadAsync()
    {
        try
        {
            _publicBanner = _faction is null ? null : await PublicProfiles.GetBannerForFactionAsync(_faction.Id);
        }
        catch
        {
            /* best effort */
        }
    }

    private async Task PublicProfileReloadAsync()
    {
        await PublicProfileLoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        // Don't set _load=true on reload: remounting the rail would jump to the first section.
        var scope = ViewerScope.From(_user);
        _faction = await FactionService.GetDetailAsync(Id, scope);
        if (_faction is not null)
        {
            _ranks = _faction.Ranks.OrderBy(r => r.Order).Select(r => r.Designation).ToList();
            _classificationHistory = await FactionService.GetClassificationHistoryAsync(_faction.Id, scope);
            _members = await FactionService.GetMembersAsync(_faction.Id, scope);
            _memberCount = _members.Count;
            // partners: skip agent fan-out
            if (!_isPartner)
            {
                await InvestigationLeadLoadAsync();
                await PublicProfileLoadAsync();
            }
        }
        _visibleTabs = _isPartner && _faction is not null
            ? await PartnerPolicy.GetVisibleTabsAsync(_user, nameof(Faction), _faction.Id)
            : null;
        RebuildRenderTabs();
        _load = false;
    }

    private async Task InvestigationLeadLoadAsync()
    {
        if (_faction is null)
        {
            return;
        }
        var el = await FactionService.GetInvestigationLeadAsync(_faction.Id);
        _investigationLead = el.Select(a => a.Agent?.Codename ?? "?").ToList();
    }

    private async Task InvestigationLeadRefreshAsync()
    {
        await InvestigationLeadLoadAsync();
        StateHasChanged();
    }

    private async Task NewLoadAsync()
    {
        await LoadAsync();
        _historyKey = Guid.NewGuid();
        StateHasChanged();
    }

    private async Task MembersModifiedAsync()
    {
        if (_faction is not null)
        {
            _members = await FactionService.GetMembersAsync(_faction.Id, ViewerScope.From(_user));
            _memberCount = _members.Count;
            StateHasChanged();
        }
    }

    private async Task PhotosModifiedAsync()
    {
        if (_faction is not null)
        {
            // refresh title image banner
            _faction.Photos = await FactionService.GetPhotosAsync(_faction.Id);
            StateHasChanged();
        }
    }

    private async Task ClassificationSetAsync((Classification New, string? Justification) input)
    {
        if (_faction is null)
        {
            return;
        }
        await FactionService.ClassificationSetAsync(_faction.Id, input.New, input.Justification, _user);
        await NewLoadAsync();
    }

    private async Task ArchiveAsync()
    {
        if (_faction is null)
        {
            return;
        }
        var reason = await ReasonDialog.ShowAsync(DialogService, "Fraktion archivieren?",
            "Diese Fraktion verschwindet aus Listen, Auswahllisten und der Standardsuche. Verknüpfungen, "
            + "Erwähnungen und der Graph bleiben unverändert; zurückholen kann sie jeder mit Schreibrecht.",
            confirmText: "Archivieren", label: "Grund (optional)");
        if (reason is null)
        {
            return;
        }
        await FactionService.ArchiveAsync(_faction.Id, reason, _user);
        Snackbar.Add("Fraktion archiviert.", Severity.Success);
        await NewLoadAsync();
    }

    private async Task UnarchiveAsync()
    {
        if (_faction is null)
        {
            return;
        }
        await FactionService.UnarchiveAsync(_faction.Id, _user);
        Snackbar.Add("Wieder im aktiven Bestand.", Severity.Success);
        await NewLoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (_faction is null)
        {
            return;
        }
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Fraktion löschen?",
            "Die Fraktion wird in den Papierkorb verschoben und kann von der Führung wiederhergestellt werden.");
        if (!ok)
        {
            return;
        }
        await FactionService.DeleteAsync(_faction.Id, _user);
        Snackbar.Add("Fraktion in den Papierkorb verschoben.", Severity.Success);
        Nav.NavigateTo("/fraktionen");
    }

    private IEnumerable<(string Label, string Value)> MasterData()
    {
        yield return ("Art", _faction!.Kind ?? "—");
        yield return ("Funk", _faction.Radio ?? "—");
        yield return ("Darkchat", _faction.Darkchat ?? "—");
        yield return ("Aufstellungszeiten", _faction.IssuingTimes ?? "—");
    }

    private static IEnumerable<string> StockTexts(IEnumerable<(string Designation, string? Quantity)> items)
        => items.Select(i => string.IsNullOrWhiteSpace(i.Quantity) ? i.Designation : $"{i.Designation} · {i.Quantity}");
}
