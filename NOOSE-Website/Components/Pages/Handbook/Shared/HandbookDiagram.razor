@* Picks a drawing by its key. An unknown key renders nothing rather than throwing - the key is data.
   The frame lets a wide drawing keep a readable size on phones and scroll sideways inside it (HandbookDiagram.razor.css);
   from 600px up it is a plain block around the drawing. *@

<div class="handbuch-diagramm-rahmen">
@switch (DiagramKey)
{
    case "oberflaeche":
        <LayoutDiagram />
        break;
    case "rechte-matrix":
        <RightsMatrixDiagram />
        break;
    case "personenakte":
        <PersonRecordDiagram />
        break;
    case "einstufung":
        <ClassificationDiagram />
        break;
    case "vs-stufen":
        <ClassifiedLevelsDiagram />
        break;
    case "verknuepfung":
        <LinkDiagram />
        break;
    case "akten-ebenen":
        <RecordLevelsDiagram />
        break;
    case "ehk-score":
        <ThreatScoreDiagram />
        break;
    case "fahndung-lebenszyklus":
        <WantedLifecycleDiagram />
        break;
    case "hinweis-weg":
        <TipFlowDiagram />
        break;
    case "bewerbung-ablauf":
        <ApplicationFlowDiagram />
        break;
    case "befoerderung":
        <PromotionDiagram />
        break;
    case "partner-freigabe":
        <PartnerAccessDiagram />
        break;
    case "noosei-grenzen":
        <NooseiScopeDiagram />
        break;
    case "sicherheitsfreigaben":
        <ClearanceLaddersDiagram />
        break;
}
</div>

@code {
    [Parameter] public string? DiagramKey { get; set; }

    /// <summary>Keys that resolve to a drawing; the editor offers exactly these.</summary>
    public static readonly IReadOnlyList<(string Key, string Label)> Known =
    [
        ("oberflaeche", "Aufbau der Oberfläche"),
        ("rechte-matrix", "Dienstgrad, Abteilung und Kennzeichen"),
        ("personenakte", "Aufbau einer Personenakte"),
        ("akten-ebenen", "Vorgang, Operation, Taskforce"),
        ("einstufung", "Die drei Einstufungen"),
        ("vs-stufen", "Stufen einer Verschlusssache"),
        ("verknuepfung", "Eine Verknüpfung, zwei Seiten"),
        ("ehk-score", "Der Bedrohungs-Score"),
        ("fahndung-lebenszyklus", "Lebenszyklus einer Fahndung"),
        ("hinweis-weg", "Der Weg eines Bürgerhinweises"),
        ("bewerbung-ablauf", "Ablauf einer Bewerbung"),
        ("befoerderung", "Ablauf einer Beförderung"),
        ("partner-freigabe", "Was eine Partnerbehörde sieht"),
        ("noosei-grenzen", "Was FIBI sieht"),
        ("sicherheitsfreigaben", "Sicherheitsfreigaben und VS-Stufen"),
    ];
}
