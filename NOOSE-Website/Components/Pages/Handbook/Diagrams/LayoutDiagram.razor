@* Schematic of the screen: icon rail, page list, content, top bar. Drawn, not screenshotted - a screenshot ages. *@

<svg viewBox="0 0 640 340" role="img" aria-labelledby="layoutDiagramTitle layoutDiagramDesc"
     style="width:100%;height:auto;max-width:640px;">
    <title id="layoutDiagramTitle">Aufbau der Oberfläche</title>
    <desc id="layoutDiagramDesc">
        Links die schmale Symbolleiste der Bereiche, daneben die Liste der Seiten des gewählten Bereichs,
        rechts der Inhalt. Oben eine Leiste mit Suche, Glocke und Konto.
    </desc>

    <!-- top bar -->
    <rect x="8" y="8" width="624" height="44" rx="6"
          fill="var(--mud-palette-surface)" stroke="var(--mud-palette-lines-default)" stroke-width="1.5" />
    <text x="26" y="36" font-size="14" fill="var(--mud-palette-text-primary)">FIB</text>
    <rect x="300" y="18" width="150" height="24" rx="12"
          fill="var(--mud-palette-background)" stroke="var(--mud-palette-lines-default)" />
    <text x="316" y="35" font-size="11" fill="var(--mud-palette-text-secondary)">Suche · Strg+K</text>
    <circle cx="510" cy="30" r="10" fill="none" stroke="var(--mud-palette-primary)" stroke-width="1.5" />
    <text x="506" y="34" font-size="10" fill="var(--mud-palette-primary)">!</text>
    <circle cx="560" cy="30" r="11" fill="var(--mud-palette-primary)" opacity="0.25" />
    <text x="596" y="34" font-size="11" fill="var(--mud-palette-text-secondary)">Konto</text>

    <!-- icon rail -->
    <rect x="8" y="62" width="56" height="270" rx="6"
          fill="var(--mud-palette-surface)" stroke="var(--mud-palette-lines-default)" stroke-width="1.5" />
    @for (var i = 0; i < 5; i++)
    {
        var y = 78 + (i * 46);
        var active = i == 1;
        <rect x="20" y="@y" width="32" height="32" rx="8"
              fill="@(active ? "var(--mud-palette-primary)" : "var(--mud-palette-background)")"
              opacity="@(active ? "0.35" : "1")"
              stroke="@(active ? "var(--mud-palette-primary)" : "var(--mud-palette-lines-default)")" />
    }
    <text x="36" y="326" font-size="9" text-anchor="middle" fill="var(--mud-palette-text-secondary)">Bereiche</text>

    <!-- page list -->
    <rect x="72" y="62" width="176" height="270" rx="6"
          fill="var(--mud-palette-surface)" stroke="var(--mud-palette-lines-default)" stroke-width="1.5" />
    <text x="88" y="84" font-size="11" fill="var(--mud-palette-text-secondary)">Akten</text>
    @for (var i = 0; i < 6; i++)
    {
        var y = 96 + (i * 30);
        var active = i == 2;
        <rect x="84" y="@y" width="152" height="22" rx="5"
              fill="@(active ? "var(--mud-palette-primary)" : "transparent")"
              opacity="@(active ? "0.2" : "1")" />
        <rect x="92" y="@(y + 7)" width="@(70 + (i * 9))" height="8" rx="4"
              fill="var(--mud-palette-text-secondary)" opacity="0.45" />
    }

    <!-- content -->
    <rect x="256" y="62" width="376" height="270" rx="6"
          fill="var(--mud-palette-surface)" stroke="var(--mud-palette-lines-default)" stroke-width="1.5" />
    <rect x="276" y="82" width="180" height="14" rx="4" fill="var(--mud-palette-text-primary)" opacity="0.7" />
    <rect x="276" y="104" width="300" height="8" rx="4" fill="var(--mud-palette-text-secondary)" opacity="0.4" />
    @for (var i = 0; i < 4; i++)
    {
        var y = 134 + (i * 46);
        <rect x="276" y="@y" width="336" height="36" rx="5"
              fill="var(--mud-palette-background)" stroke="var(--mud-palette-lines-default)" />
        <rect x="290" y="@(y + 14)" width="@(120 + (i * 24))" height="8" rx="4"
              fill="var(--mud-palette-text-secondary)" opacity="0.45" />
    }

    <!-- labels -->
    <text x="160" y="326" font-size="9" text-anchor="middle" fill="var(--mud-palette-text-secondary)">
        Seiten des Bereichs
    </text>
    <text x="444" y="326" font-size="9" text-anchor="middle" fill="var(--mud-palette-text-secondary)">
        Inhalt
    </text>
</svg>
