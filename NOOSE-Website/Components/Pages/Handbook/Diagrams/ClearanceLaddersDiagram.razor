@* Two ladders that share the word "Verschlusssache" but measure different things. *@
@* Deliberately NOT drawn as matching rows: a connector between them would claim a correspondence
   that does not exist, which is the very mistake the article is there to prevent. *@

<svg viewBox="0 0 640 372" role="img" aria-labelledby="clearanceTitle clearanceDesc"
     style="width:100%;height:auto;max-width:640px;">
    <title id="clearanceTitle">Sicherheitsfreigaben und VS-Stufen</title>
    <desc id="clearanceDesc">
        Links die vier Sicherheitsfreigaben der Dienstverordnung, gestaffelt nach Dienstgrad:
        Confidential, Secret, Top Secret und das Special Access Program als Zusatzstufe. Rechts die
        vier VS-Stufen dieser Seite: Offen, Führung, HRT und Administration. Die beiden Leitern entsprechen
        einander nicht Zeile für Zeile.
    </desc>

    @{
        var freigaben = new[]
        {
            ("Special Access Program", "Stufe 6 - Zusatzstufe, abgeschirmt", true),
            ("Top Secret", "Stufe 5 - Board of Directors", false),
            ("Secret", "ab Section Chief", false),
            ("Confidential", "alle Agenten, vom Trainee an", false),
        };
        var stufen = new[]
        {
            ("Offen", "jeder interne Agent"),
            ("Führung", "ab Section Chief"),
            ("HRT", "Abteilung HRT, dazu die Führung"),
            ("Administration", "Administration Division, dazu die Führung"),
        };
    }

    <text x="16" y="22" font-size="12" fill="var(--mud-palette-text-secondary)">
        Sicherheitsfreigabe (Dienstverordnung §1.1)
    </text>
    <text x="356" y="22" font-size="12" fill="var(--mud-palette-text-secondary)">
        VS-Stufe (diese Seite)
    </text>

    @for (var i = 0; i < freigaben.Length; i++)
    {
        var (name, wer, zusatz) = freigaben[i];
        var y = 36 + (i * 58);
        @* wrapped in a group: Razor claims a bare <text> inside a code block for its own use *@
        <g>
            <rect x="16" y="@y" width="288" height="48" rx="5"
                  fill="@(zusatz ? "var(--mud-palette-background)" : "var(--mud-palette-surface)")"
                  stroke="var(--mud-palette-lines-default)"
                  stroke-dasharray="@(zusatz ? "4 3" : "none")" />
            <text x="32" y="@(y + 21)" font-size="12" fill="var(--mud-palette-text-primary)">@name</text>
            <text x="32" y="@(y + 37)" font-size="10" fill="var(--mud-palette-text-secondary)">@wer</text>
        </g>
    }

    @for (var i = 0; i < stufen.Length; i++)
    {
        var (name, wer) = stufen[i];
        var y = 36 + (i * 58);
        <g>
            <rect x="356" y="@y" width="268" height="48" rx="5"
                  fill="var(--mud-palette-surface)" stroke="var(--mud-palette-lines-default)" />
            <text x="372" y="@(y + 21)" font-size="12" fill="var(--mud-palette-text-primary)">@name</text>
            <text x="372" y="@(y + 37)" font-size="10" fill="var(--mud-palette-text-secondary)">@wer</text>
        </g>
    }

    @* the gap between the columns is the message: no rung matches a rung *@
    <line x1="330" y1="36" x2="330" y2="258"
          stroke="var(--mud-palette-lines-default)" stroke-width="1" stroke-dasharray="3 4" />

    <rect x="16" y="274" width="608" height="86" rx="5"
          fill="var(--mud-palette-background)" stroke="var(--mud-palette-lines-default)" />
    <text x="32" y="296" font-size="11" fill="var(--mud-palette-primary)">
        Zwei Achsen - keine Zeile-für-Zeile-Entsprechung
    </text>
    <text x="32" y="314" font-size="10" fill="var(--mud-palette-text-secondary)">
        Die Dienstverordnung staffelt allein nach Dienstgrad. Die Seite staffelt nach Dienstgrad und Abteilung.
    </text>
    <text x="32" y="330" font-size="10" fill="var(--mud-palette-text-secondary)">
        HRT und Administration sind das Fachprinzip: Abteilung oder Kennzeichen öffnet, was ein höherer Rang nicht öffnet.
    </text>
    <text x="32" y="346" font-size="10" fill="var(--mud-palette-text-secondary)">
        Für das Special Access Program gibt es auf der Seite bewusst keine Entsprechung.
    </text>
</svg>
