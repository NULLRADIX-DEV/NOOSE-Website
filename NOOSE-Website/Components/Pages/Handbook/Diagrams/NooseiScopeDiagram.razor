@* Three nested rings: the whole store, what you may read, and what NOOSEI can therefore answer. *@

<svg viewBox="0 0 640 300" role="img" aria-labelledby="nooseiScopeTitle nooseiScopeDesc"
     style="width:100%;height:auto;max-width:640px;">
    <title id="nooseiScopeTitle">Was NOOSEI sieht</title>
    <desc id="nooseiScopeDesc">
        Der gesamte Bestand, darin der Ausschnitt, den du lesen darfst, und darin deckungsgleich das, worüber
        NOOSEI antwortet. NOOSEI schreibt nicht selbst; eine Änderung schlägt sie nur vor.
    </desc>

    <!-- everything -->
    <rect x="16" y="24" width="380" height="228" rx="10"
          fill="var(--mud-palette-surface)" stroke="var(--mud-palette-lines-default)" stroke-width="1.5" />
    <text x="32" y="46" font-size="12" fill="var(--mud-palette-text-secondary)">Gesamter Aktenbestand</text>

    <!-- what you may read -->
    <rect x="44" y="62" width="324" height="168" rx="10"
          fill="var(--mud-palette-primary)" opacity="0.14"
          stroke="var(--mud-palette-primary)" stroke-width="1.5" />
    <text x="60" y="86" font-size="12" fill="var(--mud-palette-text-primary)">Was du lesen darfst</text>

    <!-- what noosei answers on -->
    <rect x="72" y="102" width="268" height="110" rx="10"
          fill="var(--mud-palette-primary)" opacity="0.3"
          stroke="var(--mud-palette-primary)" stroke-width="2" stroke-dasharray="6 4" />
    <text x="206" y="140" font-size="13" text-anchor="middle" fill="var(--mud-palette-text-primary)">
        Worüber NOOSEI antwortet
    </text>
    <text x="206" y="162" font-size="11" text-anchor="middle" fill="var(--mud-palette-text-secondary)">
        deckungsgleich mit deinen Rechten
    </text>
    <text x="206" y="184" font-size="10" text-anchor="middle" fill="var(--mud-palette-text-secondary)">
        nachgeschlagen, nicht gewusst
    </text>

    <!-- the two rules -->
    <rect x="416" y="24" width="208" height="104" rx="8"
          fill="var(--mud-palette-background)" stroke="var(--mud-palette-lines-default)" stroke-width="1.5" />
    <text x="432" y="48" font-size="12" fill="var(--mud-palette-text-primary)">NOOSEI liest</text>
    <text x="432" y="70" font-size="10" fill="var(--mud-palette-text-secondary)">Eine Verschlusssache,</text>
    <text x="432" y="86" font-size="10" fill="var(--mud-palette-text-secondary)">die du nicht sehen darfst,</text>
    <text x="432" y="102" font-size="10" fill="var(--mud-palette-text-secondary)">kommt nicht vor -</text>
    <text x="432" y="118" font-size="10" fill="var(--mud-palette-warning)">auch nicht als Andeutung.</text>

    <rect x="416" y="148" width="208" height="104" rx="8"
          fill="var(--mud-palette-background)" stroke="var(--mud-palette-lines-default)" stroke-width="1.5" />
    <text x="432" y="172" font-size="12" fill="var(--mud-palette-text-primary)">NOOSEI schlägt nur vor</text>
    <text x="432" y="194" font-size="10" fill="var(--mud-palette-text-secondary)">Eine Änderung kommt als Karte</text>
    <text x="432" y="210" font-size="10" fill="var(--mud-palette-text-secondary)">unter die Antwort.</text>
    <text x="432" y="232" font-size="10" fill="var(--mud-palette-warning)">Erst dein Klick schreibt,</text>
    <text x="432" y="246" font-size="10" fill="var(--mud-palette-warning)">mit deinen Rechten.</text>

    <text x="16" y="278" font-size="11" fill="var(--mud-palette-text-primary)">
        Unter jeder Antwort stehen die Quellen. Klick sie an und prüf nach.
    </text>
    <text x="16" y="294" font-size="10" fill="var(--mud-palette-text-secondary)">
        Eine Antwort ohne Quelle ist eine Formulierung, kein Befund.
    </text>
</svg>
