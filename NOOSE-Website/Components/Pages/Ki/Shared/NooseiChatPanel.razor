@implements IDisposable
@using System.Security.Claims
@using NOOSE_Website.Authorization
@using NOOSE_Website.Models.Llm
@inject INooseiChatService Chat
@inject ILlmQuotaService Quota
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@if (!Chat.IsConfigured)
{
    <EmptyState Icon="@Icons.Material.Filled.SmartToy"
                Text="NOOSEI ist nicht konfiguriert. Ein Admin muss Endpoint, Modell und Schlüssel hinterlegen." />
}
else
{
    <MudGrid Spacing="3">
        <MudItem xs="12" md="3">
            <MudPaper Elevation="0" Class="pa-2">
                <MudButton FullWidth="true" Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="StartNew" Disabled="_busy">
                    Neue Unterhaltung
                </MudButton>
                <MudList T="string" Dense="true" Class="mt-2">
                    @foreach (var row in _conversations)
                    {
                        <MudListItem T="string" OnClick="() => OpenAsync(row.Id)"
                                     Icon="@Icons.Material.Filled.ChatBubbleOutline"
                                     Class="@(row.Id == _conversationId ? "mud-selected-item" : null)">
                            <div class="d-flex align-center" style="gap:4px;">
                                <div class="flex-grow-1" style="min-width:0;">
                                    <MudText Typo="Typo.body2">@row.Title</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @row.LastMessageAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    </MudText>
                                </div>
                                @* without stopPropagation the list item opens the conversation behind the menu *@
                                <div @onclick:stopPropagation="true">
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                        <MudMenuItem Icon="@Icons.Material.Filled.DriveFileRenameOutline"
                                                     OnClick="() => RenameAsync(row)">Umbenennen</MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.DeleteForever" IconColor="Color.Error"
                                                     OnClick="() => DeleteAsync(row)">Endgültig löschen</MudMenuItem>
                                    </MudMenu>
                                </div>
                            </div>
                        </MudListItem>
                    }
                </MudList>
                @if (_conversations.Count == 0)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary pa-2">
                        Noch keine Unterhaltungen. Unterhaltungen sind privat — nur du siehst sie.
                    </MudText>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="9">
            @if (_quota is { } quota)
            {
                <div class="d-flex align-center justify-space-between mb-2" style="gap:12px;">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@QuotaColour(quota)"
                             Icon="@Icons.Material.Filled.Token">
                        @quota.Remaining.ToString("N0") Token
                    </MudChip>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @* tokens only: an agent budgets in quota, never in money *@
                        @if (_lastCost is { } cost)
                        {
                            <text>letzte Antwort: @cost.ToString("N0") Token · </text>
                        }
                        @quota.PeriodLabel
                    </MudText>
                </div>
            }

            @if (_quota?.IsBlocked == true)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">
                    Dein NOOSEI-Kontingent ist aufgebraucht.
                    @if (_quota.NextResetLocal is { } reset)
                    {
                        <text> Neues Kontingent ab @reset.ToString("dd.MM.yyyy HH:mm") Uhr.</text>
                    }
                </MudAlert>
            }
            else if (_quota?.IsDayBlocked == true)
            {
                @* a different state entirely: the week is fine, only today is spent *@
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                    Du hast heute @_quota.ConsumedToday.ToString("N0") von @_quota.DailyLimit.ToString("N0") Token
                    verbraucht. Die Tagesgrenze schützt dein Wochenkontingent — ab morgen früh geht es weiter.
                    Diese Woche bleiben dir @_quota.Remaining.ToString("N0") Token.
                </MudAlert>
            }

            <MudPaper Class="pa-4 mb-3" Elevation="1" Style="min-height:40vh;max-height:60vh;overflow-y:auto;">
                @if (_messages.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @if (_isPartner)
                        {
                            <text>Frag nach den Gesetzbüchern — NOOSEI sucht die passenden Paragrafen selbst.
                            Zum Beispiel: „Welche Strafe steht auf Geiselnahme?"</text>
                        }
                        else
                        {
                            <text>Frag nach der Aktenlage — NOOSEI durchsucht die Datenbank selbst.
                            Zum Beispiel: „Was weißt du über die Ballas und wer führt sie?"</text>
                        }
                    </MudText>
                    <div class="d-flex flex-wrap mt-3" style="gap:6px;">
                        @foreach (var start in _isPartner ? LegalStarterQuestions : StarterQuestions)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                     Icon="@Icons.Material.Filled.NorthEast" OnClick="() => Suggest(start)">
                                @start
                            </MudChip>
                        }
                    </div>
                }
                @foreach (var m in _messages)
                {
                    <MudStack Row="true" Justify="@(m.FromUser ? Justify.FlexEnd : Justify.FlexStart)" Class="my-2">
                        <MudPaper Class="pa-3" Elevation="0"
                                  Style="@($"max-width:80%;background:{(m.FromUser ? "rgba(34,211,238,0.10)" : "rgba(255,255,255,0.05)")};border-radius:10px;")">
                            @if (!m.FromUser)
                            {
                                <MudText Typo="Typo.overline" Class="mud-text-secondary">NOOSEI · ungeprüft</MudText>
                            }
                            @if (m.Html is { } html)
                            {
                                <div class="dokument-html noosei-antwort">@((MarkupString)html)</div>
                            }
                            else
                            {
                                @* the agent's own wording stays verbatim; only NOOSEI answers in Markdown *@
                                <MudText Typo="Typo.body2"><MentionDisplay Text="@m.Text" /></MudText>
                            }
                            @if (m.Truncated || m.Degraded || m.UnsupportedNote is { Length: > 0 })
                            {
                                @* stored, not a snackbar: a reopened conversation has to show the same caveats *@
                                <div class="d-flex flex-wrap mt-2" style="gap:4px;">
                                    @if (m.Truncated)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                                 Icon="@Icons.Material.Filled.ContentCut">Antwort gekürzt</MudChip>
                                    }
                                    @if (m.Degraded)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                                 Icon="@Icons.Material.Filled.FolderOff">ohne Aktenzugriff</MudChip>
                                    }
                                </div>
                                @if (m.UnsupportedNote is { Length: > 0 } note)
                                {
                                    @* says "not evidenced", never "does not exist" — NOOSEI only sees part of the stock *@
                                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@note</MudAlert>
                                }
                            }
                            @if (m.Sources.Count > 0)
                            {
                                @* what NOOSEI read, not a claim about what every sentence rests on *@
                                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">Gelesen:</MudText>
                                <div class="d-flex flex-wrap" style="gap:4px;">
                                    @foreach (var source in m.Sources)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                 Color="Color.Default" Href="@SearchNavigation.For(source.Type, source.Id)">
                                            @source.Name
                                        </MudChip>
                                    }
                                </div>
                            }
                            @if (m.Tools.Count > 0)
                            {
                                @* folded away by default: it explains an answer, it is not part of it *@
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Class="mt-1"
                                           StartIcon="@(_openTraces.Contains(m.Id) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                           OnClick="() => ToggleTrace(m.Id)">
                                    NOOSEI hat @ToolCount(m) @(ToolCount(m) == 1 ? "Werkzeug" : "Werkzeuge") benutzt
                                </MudButton>
                                <MudCollapse Expanded="@_openTraces.Contains(m.Id)">
                                    <div class="d-flex flex-wrap mt-1" style="gap:4px;">
                                        @foreach (var tool in m.Tools)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                                     Icon="@Icons.Material.Filled.Build">
                                                @tool.Label@(tool.Count > 1 ? $" ×{tool.Count}" : string.Empty)
                                            </MudChip>
                                        }
                                    </div>
                                </MudCollapse>
                            }
                        </MudPaper>
                    </MudStack>
                }
                @if (!_busy && FollowUps() is { Count: > 0 } followUps)
                {
                    @* derived from what the answer read, so a suggestion costs nothing until it is sent *@
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-3 d-block">Weiterfragen:</MudText>
                    <div class="d-flex flex-wrap" style="gap:6px;">
                        @foreach (var followUp in followUps)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                     Icon="@Icons.Material.Filled.NorthEast" OnClick="() => Suggest(followUp)">
                                @followUp
                            </MudChip>
                        }
                    </div>
                }
                @if (_busy)
                {
                    <div class="mt-2">
                        @foreach (var step in _steps)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@step</MudText>
                        }
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-1" />
                        <div class="d-flex align-center mt-1" style="gap:8px;">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@_elapsed s</MudText>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                       StartIcon="@Icons.Material.Filled.Stop" OnClick="Cancel">Abbrechen</MudButton>
                        </div>
                    </div>
                }
            </MudPaper>

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
                @* NOOSEI resolves the token itself via loese_erwaehnung_auf, so an @ here points it at a record *@
                <MentionInput @bind-Text="_input" Label="Frage an NOOSEI" Lines="3" HelperText="@MentionInput.Hint"
                              Class="flex-grow-1" Disabled="@(_busy || Locked)" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send"
                           OnClick="SendAsync"
                           Disabled="@(_busy || string.IsNullOrWhiteSpace(_input) || Locked)">Senden</MudButton>
            </MudStack>
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
                @(_isPartner
                    ? "NOOSEI beantwortet hier nur Rechtsfragen zu den Gesetzbüchern. Antworten sind KI-generiert und ungeprüft."
                    : "NOOSEI sieht nur, was du sehen darfst. Antworten sind KI-generiert und ungeprüft.")
            </MudText>
        </MudItem>
    </MudGrid>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    /// <summary>Record the chat was opened from, as <c>Typ:Id</c>; only used when a new conversation starts.</summary>
    [Parameter] public string? Anchor { get; set; }

    /// <summary>Question carried in from elsewhere. Pre-filled only — sending stays a deliberate act,
    /// because a stray Enter would spend quota.</summary>
    [Parameter] public string? Draft { get; set; }

    /// <summary>Openers in the empty state. Deliberately answerable whatever is in the database, so a first-time
    /// agent gets a real answer rather than "dazu finde ich nichts".</summary>
    private static readonly string[] StarterQuestions =
    [
        "Was steht diese Woche an?",
        "Wer ist zur Fahndung ausgeschrieben?",
        "Was hat sich in den letzten 7 Tagen geändert?",
        "Wie lege ich eine Fahndung an?",
    ];

    /// <summary>Openers of the law chat a partner agency sees.</summary>
    private static readonly string[] LegalStarterQuestions =
    [
        "Welche Gesetzbücher gibt es?",
        "Was gilt bei Körperverletzung?",
        "Welche Strafe steht auf Geiselnahme?",
    ];

    // partners get the law chat
    private bool _isPartner;

    private ClaimsPrincipal? _user;
    private IReadOnlyList<NooseiConversationRow> _conversations = [];
    private readonly List<NooseiChatMessage> _messages = new();
    private readonly List<string> _steps = new();
    private readonly HashSet<string> _openTraces = new(StringComparer.Ordinal);
    private string? _conversationId;
    private string? _input;
    private string? _lastDraft;
    private bool _busy;
    private bool _loaded;
    private int _elapsed;
    private CancellationTokenSource? _cts;
    private LlmQuotaStatus? _quota;
    private long? _lastCost;

    private static Color QuotaColour(LlmQuotaStatus quota)
        => quota.IsBlocked || quota.UsedShare >= 0.9 ? Color.Error
            : quota.IsDayBlocked || quota.UsedShare >= 0.7 ? Color.Warning
            : Color.Success;

    /// <summary>Either ceiling stops a question; the alert above says which one.</summary>
    private bool Locked => _quota is { } quota && (quota.IsBlocked || quota.IsDayBlocked);

    private static int ToolCount(NooseiChatMessage message) => message.Tools.Sum(t => t.Count);

    private void ToggleTrace(string messageId)
    {
        if (!_openTraces.Add(messageId))
        {
            _openTraces.Remove(messageId);
        }
    }

    /// <summary>Fills the box instead of sending. A suggestion is a shortcut to a question, not a decision to spend
    /// quota — the same reason a question carried in from the command palette is only ever pre-filled.</summary>
    private void Suggest(string question) => _input = question;

    /// <summary>Two or three next questions, read off the records the last answer touched. No model call: the names
    /// are already in hand, and asking a model what to ask next would cost as much as the answer did.</summary>
    private List<string> FollowUps()
    {
        var last = _messages.Count > 0 && !_messages[^1].FromUser ? _messages[^1] : null;
        if (last is null || last.Sources.Count == 0)
        {
            return [];
        }
        var questions = new List<string>();
        foreach (var source in last.Sources.Take(2))
        {
            if (_isPartner)
            {
                questions.Add($"Wie hängt {source.Name} mit anderen Paragrafen zusammen?");
                continue;
            }
            questions.Add($"Welche Verbindungen hat {source.Name}?");
            questions.Add($"Was ist bei {source.Name} zuletzt passiert?");
        }
        return questions.Take(3).ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        if (_loaded)
        {
            return;
        }
        _loaded = true;
        _user = (await AuthStateTask).User;
        _isPartner = _user.IsPartner();
        if (!Chat.IsConfigured)
        {
            return;
        }
        await ReloadQuotaAsync();
        await ReloadConversationsAsync();
    }

    /// <summary>Picks up a new question from the command palette. The page stays alive across those navigations,
    /// so a second Strg+K only ever changes the parameter — <c>OnInitialized</c> would never see it.</summary>
    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Draft) && !string.Equals(Draft, _lastDraft, StringComparison.Ordinal))
        {
            _lastDraft = Draft;
            _input = Draft;
        }
    }

    /// <summary>Without this the counter and the block only appear after the first answer — which is exactly
    /// the request an agent with an exhausted quota is not allowed to send.</summary>
    private async Task ReloadQuotaAsync()
    {
        if (_user?.GetAgentId() is not { Length: > 0 } agentId)
        {
            return;
        }
        try
        {
            _quota = await Quota.GetStatusAsync(agentId, _user);
        }
        catch (Exception)
        {
            /* the chat stays usable without the counter */
        }
    }

    private async Task ReloadConversationsAsync()
    {
        try
        {
            _conversations = await Chat.GetConversationsAsync(_user!);
        }
        catch (Exception ex)
        {
            Snackbar.Add(NooseiErrors.Describe(ex), Severity.Error);
        }
    }

    private void StartNew()
    {
        _conversationId = null;
        _messages.Clear();
        _openTraces.Clear();
    }

    private async Task RenameAsync(NooseiConversationRow row)
    {
        var title = await ReasonDialog.ShowAsync(DialogService, "Unterhaltung umbenennen", null,
            confirmText: "Umbenennen", label: "Titel", mandatoryReason: true, preset: row.Title, lines: 1);
        if (string.IsNullOrWhiteSpace(title) || string.Equals(title, row.Title, StringComparison.Ordinal))
        {
            return;
        }
        try
        {
            await Chat.RenameAsync(row.Id, title, _user!);
            await ReloadConversationsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(NooseiErrors.Describe(ex), Severity.Error);
        }
    }

    private async Task DeleteAsync(NooseiConversationRow row)
    {
        // conversations are owner-private and deliberately outside the trash, so this really is the last stop
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Unterhaltung endgültig löschen?",
            $"Die Unterhaltung wird mit allen Nachrichten sofort und unwiderruflich gelöscht: {row.Title}. "
            + "Unterhaltungen liegen nicht im Papierkorb und lassen sich nicht wiederherstellen.",
            confirmText: "Endgültig löschen");
        if (!ok)
        {
            return;
        }
        try
        {
            await Chat.DeleteAsync(row.Id, _user!);
            if (row.Id == _conversationId)
            {
                StartNew();
            }
            await ReloadConversationsAsync();
            Snackbar.Add("Unterhaltung gelöscht.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(NooseiErrors.Describe(ex), Severity.Error);
        }
    }

    private async Task OpenAsync(string id)
    {
        if (_busy || id == _conversationId)
        {
            return;
        }
        try
        {
            _messages.Clear();
            _openTraces.Clear();
            _messages.AddRange(await Chat.GetMessagesAsync(id, _user!));
            _conversationId = id;
        }
        catch (Exception ex)
        {
            Snackbar.Add(NooseiErrors.Describe(ex), Severity.Error);
        }
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_input) || _busy || _user is null)
        {
            return;
        }
        var question = _input!.Trim();
        _messages.Add(NooseiChatMessage.FromAgent(question));
        _input = string.Empty;
        _busy = true;
        _elapsed = 0;
        _steps.Clear();
        _steps.Add("NOOSEI arbeitet …");

        // every step is kept: the trace is what a 60-second answer has to show instead of a bare spinner
        var progress = new Progress<string>(step =>
        {
            if (_steps.Count == 0 || !string.Equals(_steps[^1], step, StringComparison.Ordinal))
            {
                _steps.Add(step);
                InvokeAsync(StateHasChanged);
            }
        });

        _cts = new CancellationTokenSource();
        var ticker = TickAsync(_cts.Token);
        try
        {
            var anchor = _conversationId is null ? NooseiAnchor.Parse(Anchor) : null;
            var turn = await Chat.AskAsync(_conversationId, question, _user, progress, anchor, _cts.Token);
            _conversationId = turn.ConversationId;
            _messages.Add(turn.Answer);
            _quota = turn.Quota;
            _lastCost = turn.QuotaTokens;
            if (turn.Degraded)
            {
                Snackbar.Add("NOOSEI konnte diesmal nicht auf die Aktendatenbank zugreifen.", Severity.Warning);
            }
            if (turn.ScopeChanged)
            {
                // otherwise it just looks as if NOOSEI forgot what it had read a minute ago
                Snackbar.Add("Deine Rechte haben sich geändert. Frühere Werkzeug-Ergebnisse dieser Unterhaltung "
                    + "wurden verworfen; NOOSEI liest neu.", Severity.Info);
            }
            await ReloadConversationsAsync();
        }
        catch (OperationCanceledException)
        {
            // the gateway still books what was burned, so say so rather than implying it was free
            Snackbar.Add("Anfrage abgebrochen. Bereits verbrauchte Token wurden abgerechnet.", Severity.Info);
            await ReloadQuotaAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(NooseiErrors.Describe(ex), Severity.Error);
        }
        finally
        {
            _busy = false;
            _cts?.Cancel();
            _cts?.Dispose();
            _cts = null;
            try { await ticker; } catch (Exception) { /* the ticker only ever ends by cancellation */ }
        }
    }

    private void Cancel() => _cts?.Cancel();

    /// <summary>Counts the seconds while an answer is being built; ends with the turn.</summary>
    private async Task TickAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                _elapsed++;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { /* expected */ }
        catch (ObjectDisposedException) { /* circuit gone */ }
    }

    public void Dispose()
    {
        // a torn-down circuit must not leave the ticker running
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
    }
}
