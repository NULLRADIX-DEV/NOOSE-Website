@page "/benachrichtigungen"
@attribute [Authorize(Policy = Policies.InternalAgent)]
@using NOOSE_Website.Models.Notifications
@implements IDisposable
@inject INotificationService NotificationService
@inject NotificationBroadcaster Broadcaster
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject ILogger<NotificationInbox> Logger

<PageTitle>Benachrichtigungen · NOOSE</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.Notifications" Title="Benachrichtigungen"
            Subtitle="Alles, was dich persönlich erreicht hat – auch das, was aus der Glocke schon herausgefallen ist.">
    <Actions>
        <SavedViewButton BaseRoute="/benachrichtigungen" Filters="FilterState" OnApply="ApplyViewAsync" />
        <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.DoneAll"
                   Disabled="@(_unread == 0)" OnClick="AllReadAsync">Alle als gelesen</MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.Tune"
                   Href="/profil#benachrichtigungen">Einstellen</MudButton>
    </Actions>
</PageHeader>

<MudPaper Outlined="true" Class="pa-3 mb-3">
    <MudGrid Spacing="2" Class="align-center">
        <MudItem xs="12" md="4">
            <MudSelect T="NotificationType" MultiSelection="true" SelectedValues="_filter.Types"
                       SelectedValuesChanged="TypesChangedAsync" Label="Art" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Dense="true" ToStringFunc="@(t => NotificationTypeDisplay.Name(t))"
                       MultiSelectionTextFunc="@(names => TypesText(names.ToList()))" Disabled="@(TypeOptions.Count == 0)">
                @foreach (var option in TypeOptions)
                {
                    <MudSelectItem T="NotificationType" Value="@option.Type">
                        @NotificationTypeDisplay.Name(option.Type) (@option.Count)
                    </MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="2">
            <MudDatePicker Date="@_filter.From" DateChanged="FromChangedAsync" Label="Von" Editable="true" Clearable="true"
                           DateFormat="dd.MM.yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="6" md="2">
            <MudDatePicker Date="@_filter.To" DateChanged="ToChangedAsync" Label="Bis" Editable="true" Clearable="true"
                           DateFormat="dd.MM.yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSwitch T="bool" Value="_filter.OnlyUnread" ValueChanged="UnreadChangedAsync" Color="Color.Primary"
                       Label="Nur ungelesene" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2" Class="d-flex justify-end">
            <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.FilterAltOff"
                       Disabled="@(!HasFilter)" OnClick="ResetFiltersAsync">Zurücksetzen</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_loadFailed && _page.Total == 0)
{
    <EmptyState Icon="@Icons.Material.Filled.CloudOff" Title="Die Benachrichtigungen ließen sich nicht laden"
                Text="Das liegt nicht an dir. Versuch es gleich noch einmal.">
        <Actions>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="RefreshAsync">Neu laden</MudButton>
        </Actions>
    </EmptyState>
}
else if (_page.Total == 0)
{
    @if (HasFilter)
    {
        <EmptyState Icon="@Icons.Material.Filled.FilterAlt" Title="Kein Treffer für diesen Filter"
                    Text="Lockere den Filter oder setz ihn zurück." />
    }
    else
    {
        <EmptyState Icon="@Icons.Material.Filled.NotificationsNone" Title="Keine Benachrichtigungen"
                    Text="Hier landet alles, was dich persönlich betrifft: Erwähnungen, Aufgaben, fällige Wiedervorlagen, Änderungen an beobachteten Akten." />
    }
}
else
{
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-1">
        @(_page.Total == 1 ? "1 Benachrichtigung" : $"{_page.Total} Benachrichtigungen")
        @if (_unread > 0)
        {
            <text> · @_unread ungelesen insgesamt</text>
        }
        @if (_page.PageCount > 1)
        {
            <text> · Seite @_page.Page von @_page.PageCount</text>
        }
    </MudText>
    <MudPaper Outlined="true">
        <MudList T="string" Dense="true" Class="py-0">
            @foreach (var n in _page.Items)
            {
                var unread = n.ReadAt is null;
                <MudListItem T="string" Icon="@NotificationTypeDisplay.Icon(n.Type)"
                             IconColor="@(unread ? Color.Primary : Color.Default)" OnClick="@(() => OpenAsync(n))">
                    <div class="d-flex align-center gap-2">
                        <div class="flex-grow-1" style="min-width:0;">
                            <MudText Typo="Typo.body2" Style="@(unread ? "font-weight:600;" : "")">@n.Title</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @NotificationTypeDisplay.Name(n.Type) · @n.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </MudText>
                        </div>
                        @* the row opens the target (click, Enter, Space); the toggle beside it must not *@
                        <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                            <MudTooltip Text="@(unread ? "Als gelesen markieren" : "Als ungelesen markieren")">
                                <MudIconButton Icon="@(unread ? Icons.Material.Filled.MarkEmailRead : Icons.Material.Filled.MarkEmailUnread)"
                                               Size="Size.Small" Color="Color.Default" OnClick="@(() => ToggleReadAsync(n))"
                                               aria-label="@(unread ? "Als gelesen markieren" : "Als ungelesen markieren")" />
                            </MudTooltip>
                        </span>
                    </div>
                </MudListItem>
            }
        </MudList>
    </MudPaper>
    @if (_page.PageCount > 1)
    {
        <div class="d-flex justify-center mt-3">
            <MudPagination Count="_page.PageCount" Selected="_page.Page" SelectedChanged="PageChangedAsync"
                           Color="Color.Primary" />
        </div>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private ClaimsPrincipal _user = new();
    private string? _agentId;
    private bool _load = true;
    private int _loadGeneration;
    private bool _subscribed;
    private NotificationInboxFilter _filter = NotificationInboxFilter.None;
    private int _pageNumber = 1;
    private NotificationInboxPage _page = NotificationInboxPage.Empty;
    private List<NotificationTypeCount> _types = new();
    private int _unread;
    private bool _loadFailed;
    // own writes signal this page too; their handler reloads already
    private int _ownWrites;

    private bool HasFilter => QueryState.AnySet(FilterState);

    // a type chosen in the address but never received still shows, or it could not be deselected
    private List<NotificationTypeCount> TypeOptions => _types
        .Concat(_filter.Types.Where(t => _types.All(c => c.Type != t)).Select(t => new NotificationTypeCount(t, 0)))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _agentId = _user.GetAgentId();
        // restore the view from the URL so back-navigation and shared links keep the filters
        ReadFilters(new Uri(Nav.Uri).Query);

        await RefreshAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // prerender is a static snapshot: subscribing there leaks a handler onto a circuit that never lives
        if (firstRender && RendererInfo.IsInteractive && !_subscribed)
        {
            Broadcaster.Received += OnReceived;
            _subscribed = true;
        }
    }

    private void ReadFilters(string query)
    {
        _filter = NotificationInboxUrl.Parse(query);
    }

    // a saved view, the palette or the menu landing on this page while it shows: the instance is reused
    private async Task ApplyViewAsync(string query)
    {
        ReadFilters(query);
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // a view or a live signal can land while a load still runs; only the newest may write the rows
        var generation = ++_loadGeneration;
        var (fromUtc, toUtc) = NotificationInboxUrl.ToUtcRange(_filter.From, _filter.To);
        var query = new NotificationInboxQuery(_filter.Types, fromUtc, toUtc, _filter.OnlyUnread, _pageNumber);
        var page = await NotificationService.GetInboxAsync(_user, query);
        var types = await NotificationService.GetOwnTypesAsync(_user);
        var unread = await NotificationService.GetUnreadCountAsync(_user);
        if (generation != _loadGeneration)
        {
            return;
        }
        _page = page;
        _pageNumber = page.Page;
        _types = types;
        _unread = unread;
        _loadFailed = false;
        _load = false;
    }

    // every handler goes through here: a failed load must not kill the circuit
    private async Task RefreshAsync()
    {
        var generation = _loadGeneration + 1;
        try
        {
            await LoadAsync();
        }
        catch (Exception ex)
        {
            // a newer load already replaced this one; its failure is no longer news
            if (generation != _loadGeneration)
            {
                return;
            }
            Logger.LogWarning(ex, "Benachrichtigungen konnten nicht geladen werden.");
            _load = false;
            _loadFailed = true;
            Snackbar.Add("Die Benachrichtigungen ließen sich nicht laden. Versuch es gleich noch einmal.", Severity.Error);
        }
    }

    /// <summary>Runs one of the page's own writes and reloads once, ignoring the signal the write sends back.</summary>
    private async Task WriteAsync(Func<Task> write, string failure)
    {
        _ownWrites++;
        try
        {
            await write();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Benachrichtigung: {Failure}", failure);
            Snackbar.Add("Das ließ sich nicht speichern.", Severity.Error);
        }
        finally
        {
            _ownWrites--;
        }
    }

    private async Task FilterChangedAsync(NotificationInboxFilter filter)
    {
        _filter = filter;
        _pageNumber = 1;
        await PersistFiltersAsync();
        await RefreshAsync();
    }

    private Task TypesChangedAsync(IEnumerable<NotificationType> values)
        => FilterChangedAsync(_filter with { Types = values.Distinct().Order().ToList() });

    private Task FromChangedAsync(DateTime? value) => FilterChangedAsync(_filter with { From = value?.Date });

    private Task ToChangedAsync(DateTime? value) => FilterChangedAsync(_filter with { To = value?.Date });

    private Task UnreadChangedAsync(bool value) => FilterChangedAsync(_filter with { OnlyUnread = value });

    private Task ResetFiltersAsync() => FilterChangedAsync(NotificationInboxFilter.None);

    private async Task PageChangedAsync(int page)
    {
        _pageNumber = page;
        await RefreshAsync();
    }

    /// <summary>The filters as query pairs: written to the address, and what a saved view keeps.</summary>
    private (string Name, string? Value)[] FilterState => NotificationInboxUrl.ToPairs(_filter);

    private Task PersistFiltersAsync() => QueryState.WriteAsync(JS, Nav, FilterState);

    private static string TypesText(IReadOnlyList<string?> names) => names.Count switch
    {
        0 => "Alle Arten",
        <= 2 => string.Join(", ", names),
        _ => $"{names.Count} Arten",
    };

    private async Task OpenAsync(Notification n)
    {
        if (n.ReadAt is null)
        {
            _ownWrites++;
            try
            {
                await NotificationService.AsReadMarkAsync(n.Id, _user);
            }
            catch (Exception ex)
            {
                // the link still works; only the marker stays
                Logger.LogWarning(ex, "Benachrichtigung {Id} ließ sich nicht als gelesen markieren.", n.Id);
            }
            finally
            {
                _ownWrites--;
            }
        }
        if (!string.IsNullOrWhiteSpace(n.Href))
        {
            Nav.NavigateTo(n.Href);
            return;
        }
        await RefreshAsync();
    }

    private async Task ToggleReadAsync(Notification n)
    {
        await WriteAsync(() => n.ReadAt is null
                ? NotificationService.AsReadMarkAsync(n.Id, _user)
                : NotificationService.AsUnreadMarkAsync(n.Id, _user),
            "umschalten fehlgeschlagen");
        await RefreshAsync();
    }

    private async Task AllReadAsync()
    {
        await WriteAsync(() => NotificationService.AllAsReadAsync(_user), "alle als gelesen fehlgeschlagen");
        await RefreshAsync();
    }

    // only react to this recipient's own signal, and not to the echo of a write this page is handling
    private void OnReceived(string recipientId)
    {
        if (recipientId != _agentId || _ownWrites > 0)
        {
            return;
        }
        _ = InvokeAsync(async () =>
        {
            await RefreshAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        if (_subscribed)
        {
            Broadcaster.Received -= OnReceived;
        }
    }
}
