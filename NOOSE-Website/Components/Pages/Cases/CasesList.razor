@page "/vorgaenge"
@inject ICaseService CaseService
@inject IRecencyService Recency
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Vorgänge · NOOSE</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.FolderSpecial" Title="Vorgänge"
            Subtitle="Übergeordnete Ermittlungsakte: bündelt Personen, Operationen, Observationen und Doks zu einem Vorgang mit eigenem Status.">
    <Actions>
        <SavedViewButton BaseRoute="/vorgaenge" Filters="FilterState" OnApply="ApplyViewAsync" />
        <ListExportButton T="CaseRow" RecordType="@nameof(Case)" Items="@(() => _grid?.FilteredItems ?? [])" Columns="ExportColumns" Disabled="_load" />
        <AuthorizeView Policy="@Policies.Leadership">
            <MudButton Href="/papierkorb?tab=vorgaenge" Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.Delete">Papierkorb</MudButton>
        </AuthorizeView>
        <AuthorizeView Policy="@Policies.WriteAccess" Context="schreib">
            <MudButton Href="/vorgaenge/neu" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">Neuer Vorgang</MudButton>
        </AuthorizeView>
    </Actions>
</PageHeader>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudDataGrid @ref="_grid" T="CaseRow" Items="_rows" Hover="true" Filterable="false" SortMode="SortMode.Multiple"
                 QuickFilter="Filter" Elevation="2" RowClick="@(args => Open(args.Item))" Dense="true">
        <ToolBarContent>
            <MudTextField Value="_search" ValueChanged="@((string v) => SearchChangedAsync(v))" Placeholder="Suchen (Titel, Aktenzeichen, Typ)…" Immediate="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
            <MudSpacer />
            <MudSelect T="CaseStatus?" Value="_statusFilter" ValueChanged="StatusSelectedAsync" Label="Status" Dense="true"
                       Clearable="true" Variant="Variant.Outlined" Style="max-width:200px;" Margin="Margin.Dense">
                <MudSelectItem T="CaseStatus?" Value="@((CaseStatus?)null)">Alle</MudSelectItem>
                @foreach (var s in CaseStatusDisplay.All)
                {
                    <MudSelectItem T="CaseStatus?" Value="@s">@CaseStatusDisplay.Name(s)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="Classification?" Value="_classification" ValueChanged="ClassificationSelectedAsync" Label="Einstufung" Dense="true"
                       Clearable="true" Variant="Variant.Outlined" Style="max-width:220px;" Margin="Margin.Dense" Class="ml-2">
                <MudSelectItem T="Classification?" Value="@(null)">Alle</MudSelectItem>
                @foreach (var e in ClassificationDisplay.All)
                {
                    <MudSelectItem T="Classification?" Value="@e">@ClassificationDisplay.Name(e)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="RecencyLevel?" Value="_recency" ValueChanged="RecencySelectedAsync" Label="Aktualität" Dense="true"
                       Clearable="true" Variant="Variant.Outlined" Style="max-width:180px;" Margin="Margin.Dense" Class="ml-2">
                <MudSelectItem T="RecencyLevel?" Value="@(null)">Alle</MudSelectItem>
                @foreach (var e in Enum.GetValues<RecencyLevel>())
                {
                    <MudSelectItem T="RecencyLevel?" Value="@e">@RecencyLevelDisplay.Name(e)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="ArchiveFilter" Value="_archive" ValueChanged="ArchiveSelectedAsync" Label="Archiv" Dense="true"
                       Variant="Variant.Outlined" Style="max-width:170px;" Margin="Margin.Dense" Class="ml-2">
                <MudSelectItem T="ArchiveFilter" Value="ArchiveFilter.Active">Aktiv</MudSelectItem>
                <MudSelectItem T="ArchiveFilter" Value="ArchiveFilter.Including">Mit Archiv</MudSelectItem>
                <MudSelectItem T="ArchiveFilter" Value="ArchiveFilter.Only">Nur Archiv</MudSelectItem>
            </MudSelect>
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.CaseNumber" Title="Aktenzeichen" />
            <TemplateColumn Sortable="true" Title="Titel" SortBy="x => x.Title">
                <CellTemplate>
                    @* real link: middle-click/ctrl-click opens in new tab; keyboard/screenreader reachable *@
                    <MudLink Href="@($"/vorgaenge/{context.Item.Id}")" @onclick:stopPropagation="true">@context.Item.Title</MudLink>
                    @if (context.Item.IsArchived)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Class="ml-2">Archiviert</MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Type" Title="Typ" />
            <TemplateColumn Sortable="true" Title="Status" SortBy="x => x.Status">
                <CellTemplate>
                    <CaseStatusChip Status="context.Item.Status" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="true" Title="Einstufung" SortBy="x => x.Classification">
                <CellTemplate>
                    <ClassificationBadge Value="context.Item.Classification" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="true" Title="Verschluss" SortBy="x => x.IsClassified">
                <CellTemplate>
                    @if (context.Item.IsClassified)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Lock">@DocumentClassificationDisplay.ChipLabel(context.Item.SecrecyLevel)</MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="true" Title="Aktualität" SortBy="x => x.Level">
                <CellTemplate>
                    <RecencyIndicator Level="context.Item.Level" ReferenceDateUtc="context.Item.RefreshedUtc" />
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Refreshed" Title="Zuletzt" Format="dd.MM.yyyy HH:mm" />
        </Columns>
        <NoRecordsContent>
            @if (HasFilter)
            {
                <EmptyState Icon="@Icons.Material.Filled.SearchOff" Title="Keine Treffer"
                            Text="Für diese Filter gibt es keinen Vorgang. Setze die Filter zurück, um alle zu sehen.">
                    <Actions>
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.FilterAltOff" OnClick="ResetFiltersAsync">Filter zurücksetzen</MudButton>
                    </Actions>
                </EmptyState>
            }
            else
            {
                <AuthorizeView Policy="@Policies.PartnerView" Context="partnerEmpty">
                    <Authorized>
                        <EmptyState Icon="@Icons.Material.Filled.FolderSpecial" Title="Noch nichts freigegeben"
                                    Text="Für Ihre Behörde wurde noch kein Vorgang freigegeben." />
                    </Authorized>
                    <NotAuthorized>
                        <EmptyState Icon="@Icons.Material.Filled.FolderSpecial" Title="Noch keine Vorgänge"
                                    Text="Lege den ersten Vorgang an, um mehrere Akten zu einer Ermittlung zu bündeln.">
                            <Actions>
                                <AuthorizeView Policy="@Policies.WriteAccess" Context="schreib">
                                    <MudButton Href="/vorgaenge/neu" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">Neuer Vorgang</MudButton>
                                </AuthorizeView>
                            </Actions>
                        </EmptyState>
                    </NotAuthorized>
                </AuthorizeView>
            }
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="CaseRow" />
        </PagerContent>
    </MudDataGrid>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private MudDataGrid<CaseRow>? _grid;

    /// <summary>The CSV export's columns: the grid's own.</summary>
    private static readonly IReadOnlyList<ExportColumn<CaseRow>> ExportColumns =
    [
        new("Aktenzeichen", r => r.CaseNumber),
        new("Titel", r => r.Title),
        new("Archiviert", r => ExportText.Flag(r.IsArchived)),
        new("Typ", r => r.Type),
        new("Status", r => CaseStatusDisplay.Name(r.Status)),
        new("Einstufung", r => ClassificationDisplay.Name(r.Classification)),
        new("Verschluss", r => ExportText.Secrecy(r.IsClassified, r.SecrecyLevel)),
        new("Aktualität", r => RecencyLevelDisplay.Name(r.Level)),
        new("Zuletzt", r => ExportText.Stamp(r.Refreshed)),
    ];

    private bool _load = true;
    private int _loadGeneration;
    private string _search = string.Empty;
    private CaseStatus? _statusFilter;
    private Classification? _classification;
    private RecencyLevel? _recency;
    private ArchiveFilter _archive = ArchiveFilter.Active;
    private List<CaseRow> _rows = new();

    private bool HasFilter => !string.IsNullOrWhiteSpace(_search) || _statusFilter is not null
        || _classification is not null || _recency is not null
        || _archive != ArchiveFilter.Active;

    protected override async Task OnInitializedAsync()
    {
        // restore the view from the URL so back-navigation and shared links keep the filters
        ReadFilters(new Uri(Nav.Uri).Query);

        await LoadAsync();
    }

    private void ReadFilters(string query)
    {
        _search = QueryState.Read(query, "q") ?? string.Empty;
        _statusFilter = QueryState.ReadEnum<CaseStatus>(query, "status");
        _classification = QueryState.ReadEnum<Classification>(query, "einstufung");
        _recency = QueryState.ReadEnum<RecencyLevel>(query, "aktualitaet");
        _archive = QueryState.ReadEnum<ArchiveFilter>(query, "archiv") ?? ArchiveFilter.Active;
    }

    // a saved view, the palette or the menu landing on this list while it shows: the instance is reused
    private async Task ApplyViewAsync(string query)
    {
        var archive = _archive;
        ReadFilters(query);
        // the archive filter is the one that lives on the server
        if (_archive == archive)
        {
            return;
        }
        _load = true;
        try
        {
            await LoadAsync();
        }
        catch
        {
            // no endless spinner; the button tells the agent the reload failed
            _load = false;
            throw;
        }
    }

    // the archive filter is server-side, so switching it reloads rather than filtering in place
    private async Task LoadAsync()
    {
        // a view can land while a load still runs; only the newest may write the rows
        var generation = ++_loadGeneration;
        var user = (await AuthStateTask).User;
        var cases = await CaseService.GetListAsync(ViewerScope.From(user), _archive);
        var settings = await Recency.GetSettingsAsync(nameof(Case));
        var now = DateTime.UtcNow;
        if (generation != _loadGeneration)
        {
            return;
        }
        _rows = cases.Select(v =>
        {
            var referenceUtc = v.ModifiedAt ?? v.CreatedAt;
            return new CaseRow
            {
                Id = v.Id,
                CaseNumber = v.CaseNumber,
                Title = v.Title,
                Type = v.Type ?? string.Empty,
                Status = v.Status,
                Classification = v.Classification,
                IsClassified = v.IsClassified,
                SecrecyLevel = v.SecrecyLevel,
                RefreshedUtc = referenceUtc,
                Refreshed = referenceUtc.ToLocalTime(),
                IsArchived = v.IsArchived,
                Level = RecencyAssessment.For(settings.AgingDisabled, v.AgingDisabled, v.IsArchived,
                    settings.WarningDays, settings.StaleDays, referenceUtc, now),
            };
        }).ToList();
        _load = false;
    }

    private Task StatusSelectedAsync(CaseStatus? status)
    {
        _statusFilter = status;
        return PersistFiltersAsync();
    }

    private Task SearchChangedAsync(string value)
    {
        _search = value ?? string.Empty;
        return PersistFiltersAsync();
    }

    private Task ClassificationSelectedAsync(Classification? value)
    {
        _classification = value;
        return PersistFiltersAsync();
    }

    private Task RecencySelectedAsync(RecencyLevel? value)
    {
        _recency = value;
        return PersistFiltersAsync();
    }

    private async Task ArchiveSelectedAsync(ArchiveFilter value)
    {
        _archive = value;
        await PersistFiltersAsync();
        _load = true;
        await LoadAsync();
    }

    private async Task ResetFiltersAsync()
    {
        _search = string.Empty;
        _statusFilter = null;
        _classification = null;
        _recency = null;
        var reload = _archive != ArchiveFilter.Active;
        _archive = ArchiveFilter.Active;
        await PersistFiltersAsync();
        if (reload)
        {
            _load = true;
            await LoadAsync();
        }
    }

    /// <summary>The filters as query pairs: written to the address, and what a saved view keeps.</summary>
    private (string Name, string? Value)[] FilterState =>
    [
        ("q", _search),
        ("status", _statusFilter?.ToString()),
        ("einstufung", _classification?.ToString()),
        ("aktualitaet", _recency?.ToString()),
        ("archiv", _archive == ArchiveFilter.Active ? null : _archive.ToString()),
    ];

    private Task PersistFiltersAsync() => QueryState.WriteAsync(JS, Nav, FilterState);

    private bool Filter(CaseRow z)
    {
        if (_statusFilter is not null && z.Status != _statusFilter)
        {
            return false;
        }
        if (_classification is { } c && z.Classification != c)
        {
            return false;
        }
        if (_recency is { } r && z.Level != r)
        {
            return false;
        }
        if (string.IsNullOrWhiteSpace(_search))
        {
            return true;
        }
        var s = _search.Trim();
        return z.Title.Contains(s, StringComparison.OrdinalIgnoreCase)
            || z.CaseNumber.Contains(s, StringComparison.OrdinalIgnoreCase)
            || z.Type.Contains(s, StringComparison.OrdinalIgnoreCase);
    }

    private void Open(CaseRow z) => Nav.NavigateTo($"/vorgaenge/{z.Id}");

    private sealed class CaseRow
    {
        public string Id { get; set; } = string.Empty;
        public string CaseNumber { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public CaseStatus Status { get; set; }
        public Classification Classification { get; set; }
        public bool IsClassified { get; set; }
        public DocumentClassification SecrecyLevel { get; set; }
        public DateTime RefreshedUtc { get; set; }
        public DateTime Refreshed { get; set; }
        public RecencyLevel Level { get; set; }
        public bool IsArchived { get; set; }
    }
}
