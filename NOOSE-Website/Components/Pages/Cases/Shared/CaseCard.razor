@* Below 960px the card shrinks to a compact head (noose-steckbrief-* in app.css): 64px picture beside the name, the
   markers in one wrapping row, the rest behind "Details". The wrappers repeat MudStack's gap-3 column, so from 960px
   up the card renders as before. *@
<MudPaper Class="pa-4 noose-steckbrief" Elevation="2">
    <MudStack Spacing="3">
        <div class="d-flex flex-column gap-3 noose-steckbrief-kopf">
        <MudStack AlignItems="AlignItems.Center" Class="py-2 noose-steckbrief-bild">
            <MudAvatar Color="Color.Primary" Rounded="true" Style="height:120px;width:120px;">
                <MudIcon Icon="@Icons.Material.Filled.FolderSpecial" Style="font-size:3rem;" />
            </MudAvatar>
        </MudStack>

        <div class="noose-steckbrief-name">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.h5">@Case.Title</MudText>
                @if (Case.IsClassified)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" Size="Size.Small" Title="@DocumentClassificationDisplay.Label(Case.SecrecyLevel)" />
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@DocumentClassificationDisplay.ChipLabel(Case.SecrecyLevel)</MudChip>
                }
            </MudStack>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Case.CaseNumber</MudText>
        </div>
        </div>

        <div class="d-flex flex-column gap-3 noose-steckbrief-kennzeichen">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
            <CaseStatusChip Status="Case.Status" />
            @if (!string.IsNullOrWhiteSpace(Case.Type))
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@Case.Type</MudChip>
            }
        </MudStack>

        <ClassificationBadge Value="Case.Classification" />
        </div>

        <div class="@RestClass">
        <div>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                <MudIcon Icon="@Icons.Material.Filled.LocalPolice" Color="Color.Warning" Size="Size.Small" />
                <MudText Typo="Typo.subtitle2">Fallführer</MudText>
            </MudStack>
            @if (CaseLead.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">— nicht zugewiesen</MudText>
            }
            else
            {
                <MudStack Row="true" Spacing="1" Class="flex-wrap">
                    @foreach (var name in CaseLead)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                                 Icon="@Icons.Material.Filled.LocalPolice">@name</MudChip>
                    }
                </MudStack>
            }
        </div>

        <MudDivider />

        @if (Case.CompletedAt is not null)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
                <MudText Typo="Typo.body2">Abgeschlossen: @Case.CompletedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
            </MudStack>
        }

        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            Eröffnet: @Case.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
        </MudText>
        <MudStack Spacing="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <RecencyIndicator Level="@(RecencyAssessment.NeverAges(Case.AgingDisabled, Case.IsArchived) ? RecencyLevel.Fresh : (RecencyLevel?)null)"
                                  RecordsType="@nameof(Case)" ReferenceDateUtc="@(Case.ModifiedAt ?? Case.CreatedAt)" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Zuletzt aktualisiert: @((Case.ModifiedAt ?? Case.CreatedAt).ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                </MudText>
            </MudStack>
            <AuthorizeView Policy="@Policies.Leadership">
                <MudSwitch T="bool" Value="Case.AgingDisabled" ValueChanged="ToggleAgingAsync"
                           Color="Color.Info" Size="Size.Small" Label="Veralterung deaktiviert" />
            </AuthorizeView>
        </MudStack>
        </div>
        <MudButton Variant="Variant.Text" Size="Size.Small" Class="noose-nur-schmal align-self-start"
                   EndIcon="@(_details ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                   OnClick="@(() => _details = !_details)" aria-expanded="@(_details ? "true" : "false")">
            @(_details ? "Weniger" : "Details")
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired] public Case Case { get; set; } = default!;

    /// <summary>Case-lead codenames.</summary>
    [Parameter] public IReadOnlyList<string> CaseLead { get; set; } = Array.Empty<string>();

    [Parameter] public ClaimsPrincipal? User { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    // below 960px everything after the markers starts folded behind "Details"; the class does nothing from 960px up
    private bool _details;

    private string RestClass => _details
        ? "d-flex flex-column gap-3 noose-steckbrief-rest"
        : "d-flex flex-column gap-3 noose-steckbrief-rest noose-steckbrief-zu";

    [Inject] private IRecencyService Recency { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    /// <summary>Toggle this record's aging exemption.</summary>
    private async Task ToggleAgingAsync(bool value)
    {
        if (User is null)
        {
            return;
        }
        try
        {
            await Recency.SetRecordExemptionAsync(nameof(Case), Case.Id, value, User);
            Snackbar.Add(value ? "Veralterung für diese Akte deaktiviert." : "Veralterung wieder aktiv.", Severity.Success);
            await Changed.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            StateHasChanged();
        }
    }
}
