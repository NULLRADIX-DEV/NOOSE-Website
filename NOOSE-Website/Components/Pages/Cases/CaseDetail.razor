@page "/vorgaenge/{Id}"
@inject ICaseService CaseService
@inject IAccessLogService AccessLog
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IPartnerVisibilityPolicyService PartnerPolicy

<PageTitle>@(_case?.Title ?? "Vorgang") · NOOSE</PageTitle>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_case is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        Vorgang nicht gefunden oder nicht zugänglich (ggf. Verschlusssache).
    </MudAlert>
}
else
{
    @if (_case.IsArchived)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <div>
                    <MudText Typo="Typo.body2">
                        Archiviert am @(_case.ArchivedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—") —
                        erscheint nicht in Listen, Auswahllisten und der Standardsuche.
                    </MudText>
                    @if (!string.IsNullOrWhiteSpace(_case.ArchiveReason))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Grund: @_case.ArchiveReason</MudText>
                    }
                </div>
                <MudSpacer />
                <AuthorizeView Policy="@Policies.WriteAccess" Context="archiv">
                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Unarchive"
                               OnClick="UnarchiveAsync">Zurückholen</MudButton>
                </AuthorizeView>
            </MudStack>
        </MudAlert>
    }

    @if (_case.Status == CaseStatus.Archived && !_case.IsArchived)
    {
        <AuthorizeView Policy="@Policies.WriteAccess" Context="vorschlag">
            <MudAlert Severity="Severity.Normal" Variant="Variant.Text" Dense="true" Class="mb-2">
                Dieser Vorgang ist als archiviert gekennzeichnet, steht aber noch im aktiven Bestand.
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ArchiveAsync">Jetzt archivieren</MudButton>
            </MudAlert>
        </AuthorizeView>
    }

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/vorgaenge" aria-label="Zurück" />
        <MudSpacer />
        <MudTooltip Text="Druckansicht – Akte drucken / als PDF speichern">
            <MudIconButton Icon="@Icons.Material.Filled.Print" Color="Color.Default"
                           Href="@($"/vorgaenge/{Id}/druck")" Target="_blank"
                           aria-label="Druckansicht öffnen" />
        </MudTooltip>
        <DossierExportButton EntityType="@nameof(Case)" EntityId="@Id" />
        @if (!_isPartner)
        {
            <FollowButton EntityType="@nameof(Case)" EntityId="@_case.Id" User="_user" />
            <JobCreateButton EntityType="@nameof(Case)" EntityId="@_case.Id" />
        }
        <AuthorizeView Policy="@Policies.WriteAccess" Context="freigabe">
            <PartnerShareButton EntityType="@nameof(Case)" EntityId="@_case.Id" />
        </AuthorizeView>
        <AuthorizeView Policy="@Policies.WriteAccess" Context="schreib">
            <MudButton Href="@($"/vorgaenge/{_case.Id}/bearbeiten")" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">Bearbeiten</MudButton>
        </AuthorizeView>
        <AuthorizeView Policy="@Policies.WriteAccess" Context="ablegen">
            @if (!_case.IsArchived)
            {
                <MudButton Color="Color.Default" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Archive"
                           OnClick="ArchiveAsync">Archivieren</MudButton>
            }
        </AuthorizeView>
        <AuthorizeView Policy="@Policies.Leadership">
            <MudButton Color="Color.Error" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync">Löschen</MudButton>
        </AuthorizeView>
    </MudStack>

    @if (!_isPartner)
    {
        <MudPaper Class="pa-2 mb-4" Elevation="1">
            <TagChips EntityType="@nameof(Case)" EntityId="@_case.Id" User="_user" />
        </MudPaper>
    }

    <MudGrid>
        <MudItem xs="12" md="4" lg="3">
            <div class="akte-steckkarte">
                <CaseCard Case="_case" CaseLead="_caseLead" User="_user" Changed="NewLoadAsync" />
            </div>
        </MudItem>

        <MudItem xs="12" md="8" lg="9">
            @if (_renderTabs.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    Für Ihren Zugang sind in dieser Akte keine Bereiche freigegeben.
                </MudAlert>
            }
            else
            {
            @if (TabOn("historie"))
            {
                <SinceLastVisitBar EntityType="@nameof(Case)" EntityId="@_case.Id" User="_user" Since="_since" />
            }
            <RecordSectionRail>
                @if (TabOn("stammdaten"))
                {
                <RecordSection Group="Akte" Slug="stammdaten" Label="Stammdaten" Icon="@Icons.Material.Filled.Info">
                    <MudStack Spacing="3">
                        @if (!string.IsNullOrWhiteSpace(_case.Description))
                        {
                            <div>
                                <MudText Typo="Typo.subtitle2">Sachverhalt / Beschreibung</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="white-space:pre-line;"><MentionDisplay Text="@_case.Description" /></MudText>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_case.Summary))
                        {
                            <div>
                                <MudText Typo="Typo.subtitle2">Aktueller Stand</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="white-space:pre-line;"><MentionDisplay Text="@_case.Summary" /></MudText>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_case.ClosingNote))
                        {
                            <div>
                                <MudText Typo="Typo.subtitle2">Abschlussvermerk</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="white-space:pre-line;"><MentionDisplay Text="@_case.ClosingNote" /></MudText>
                            </div>
                        }
                        @if (string.IsNullOrWhiteSpace(_case.Description) && string.IsNullOrWhiteSpace(_case.Summary) && string.IsNullOrWhiteSpace(_case.ClosingNote))
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Keine weiteren Stammdaten erfasst.</MudText>
                        }
                    </MudStack>
                </RecordSection>
                }
                @if (TabOn("inhalt"))
                {
                <RecordSection Group="Akte" Slug="inhalt" Label="Inhalt" Icon="@Icons.Material.Filled.Hub">
                    <CaseContentPanel CaseId="@_case.Id" User="_user" />
                </RecordSection>
                }
                @* assigned NOOSE agents: internal only *@
                @if (!_isPartner)
                {
                <RecordSection Group="Struktur" Slug="agents" Label="Beteiligte Agents" Icon="@Icons.Material.Filled.ManageAccounts">
                    <CaseAgentsPanel CaseId="@_case.Id" User="_user" Changed="CaseLeadRefreshAsync" />
                </RecordSection>
                }
                @if (TabOn("einstufung"))
                {
                <RecordSection Group="Akte" Slug="einstufung" Label="Einstufung" Icon="@Icons.Material.Filled.Shield">
                    <ClassificationPanel Current="_case.Classification" History="_classificationHistory" User="_user" OnSet="ClassificationSetAsync"
                                     EntityType="@nameof(Case)" EntityId="@_case.Id" TargetDesignation="@($"{_case.Title} ({_case.CaseNumber})")" />
                </RecordSection>
                }
                @* partner-safe: Sources child service is partner-safe *@
                @if (TabOn("quellen"))
                {
                <RecordSection Group="Anhänge" Slug="quellen" Label="Quellen" Icon="@Icons.Material.Filled.AttachFile">
                    <SourcesPanel EntityType="@nameof(Case)" EntityId="@_case.Id" User="_user" />
                </RecordSection>
                }
                @* partner-safe child tabs *@
                @if (TabOn("wiedervorlagen"))
                {
                <RecordSection Group="Verlauf" Slug="wiedervorlagen" Label="Wiedervorlagen" Icon="@Icons.Material.Filled.EventRepeat">
                    <FollowupPanel EntityType="@nameof(Case)" EntityId="@_case.Id" User="_user" />
                </RecordSection>
                }
                @if (TabOn("kommentare"))
                {
                <RecordSection Group="Verlauf" Slug="kommentare" Label="Kommentare" Icon="@Icons.Material.Filled.Comment">
                    <CommentPanel EntityType="@nameof(Case)" EntityId="@_case.Id" User="_user" />
                </RecordSection>
                }
                @if (TabOn("zusatzfelder"))
                {
                <RecordSection Group="Akte" Slug="zusatzfelder" Label="Zusatzfelder" Icon="@Icons.Material.Filled.Tune">
                    <CustomFieldsPanel EntityType="@nameof(Case)" EntityId="@_case.Id" User="_user" />
                </RecordSection>
                }
                @* partner-safe: timeline filters cross-refs for partners *@
                @if (TabOn("historie"))
                {
                <RecordSection Group="Verlauf" Slug="historie" Label="Zeitstrahl" Icon="@Icons.Material.Filled.Timeline">
                    <TimelinePanel EntityType="@nameof(Case)" EntityId="@_case.Id" User="_user" NewSince="_since" @key="_historyKey" />
                </RecordSection>
                }
                @if (!_isPartner)
                {
                <RecordSection Group="Analyse" Slug="ki-kurzbrief" Label="NOOSEI-Kurzbrief" Icon="@Icons.Material.Filled.AutoAwesome">
                    <KiBriefPanel EntityType="@nameof(Case)" EntityId="@_case.Id" User="_user" />
                </RecordSection>
                }
            </RecordSectionRail>
            }
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public string Id { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;
    private bool _isPartner;
    private Case? _case;
    private List<string> _caseLead = new();
    private List<ClassificationHistory> _classificationHistory = new();
    private ClaimsPrincipal _user = default!;
    private Guid _historyKey = Guid.NewGuid();
    private string? _loadedId;
    // last view of the previous visit, read before this one is logged
    private DateTime? _since;

    // every section slug on this page; the rail owns which one is active
    private static readonly string[] _tabs =
    {
        "stammdaten", "inhalt", "agents", "einstufung",
        "quellen", "wiedervorlagen", "kommentare", "zusatzfelder", "historie",
    };

    // partner tab gating: null = no restriction (internal/unconfigured/individually released)
    private IReadOnlySet<string>? _visibleTabs;
    private List<string> _renderTabs = new();
    private bool TabOn(string slug) => _visibleTabs is null || _visibleTabs.Contains(slug);
    private void RebuildRenderTabs() => _renderTabs = _tabs.Where(s => (s != "agents" || !_isPartner) && TabOn(s)).ToList();

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _isPartner = _user.IsPartner();
    }

    // component is reused across Id navigation; OnInitializedAsync won't re-run
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }
        _loadedId = Id;
        _load = true;
        _case = null;
        _since = null;
        await LoadAsync();
        if (_case is not null)
        {
            _since = await AccessLog.PreviousVisitAsync(nameof(Case), _case.Id);
            await AccessLog.LogViewAsync(nameof(Case), _case.Id);
        }
    }

    private async Task LoadAsync()
    {
        // no _load=true here: remounting the rail would reset to the first section
        var scope = ViewerScope.From(_user);
        _case = await CaseService.GetDetailAsync(Id, scope);
        if (_case is not null)
        {
            _classificationHistory = await CaseService.GetClassificationHistoryAsync(_case.Id, scope);
            // partners: skip case-lead fan-out
            if (!_isPartner)
            {
                await CaseLeadLoadAsync();
            }
        }
        _visibleTabs = _isPartner && _case is not null
            ? await PartnerPolicy.GetVisibleTabsAsync(_user, nameof(Case), _case.Id)
            : null;
        RebuildRenderTabs();
        _load = false;
    }

    private async Task CaseLeadLoadAsync()
    {
        if (_case is null)
        {
            return;
        }
        var ff = await CaseService.GetCaseLeadAsync(_case.Id);
        _caseLead = ff.Select(a => a.Agent?.Codename ?? "?").ToList();
    }

    private async Task CaseLeadRefreshAsync()
    {
        await CaseLeadLoadAsync();
        StateHasChanged();
    }

    private async Task NewLoadAsync()
    {
        await LoadAsync();
        _historyKey = Guid.NewGuid();
        StateHasChanged();
    }

    private async Task ClassificationSetAsync((Classification New, string? Justification) input)
    {
        if (_case is null)
        {
            return;
        }
        await CaseService.ClassificationSetAsync(_case.Id, input.New, input.Justification, _user);
        await NewLoadAsync();
    }

    private async Task ArchiveAsync()
    {
        if (_case is null)
        {
            return;
        }
        var reason = await ReasonDialog.ShowAsync(DialogService, "Vorgang archivieren?",
            "Dieser Vorgang verschwindet aus Listen, Auswahllisten und der Standardsuche. Verknüpfungen, "
            + "Erwähnungen und der Graph bleiben unverändert; zurückholen kann sie jeder mit Schreibrecht.",
            confirmText: "Archivieren", label: "Grund (optional)");
        if (reason is null)
        {
            return;
        }
        await CaseService.ArchiveAsync(_case.Id, reason, _user);
        Snackbar.Add("Vorgang archiviert.", Severity.Success);
        await NewLoadAsync();
    }

    private async Task UnarchiveAsync()
    {
        if (_case is null)
        {
            return;
        }
        await CaseService.UnarchiveAsync(_case.Id, _user);
        Snackbar.Add("Wieder im aktiven Bestand.", Severity.Success);
        await NewLoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (_case is null)
        {
            return;
        }
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Vorgang löschen?",
            "Der Vorgang wird in den Papierkorb verschoben und kann von der Führung wiederhergestellt werden.");
        if (!ok)
        {
            return;
        }
        await CaseService.DeleteAsync(_case.Id, _user);
        Snackbar.Add("Vorgang in den Papierkorb verschoben.", Severity.Success);
        Nav.NavigateTo("/vorgaenge");
    }
}
