@page "/buerger/tickets"
@page "/buerger/tickets/{CaseNumber}"
@layout BuergerLayout
@attribute [AllowAnonymous]
@inject ITicketService Tickets
@inject ITicketAttachmentStorageService AttachmentStore
@inject IBuergerService Buerger
@inject IPublicModuleService Modules
@inject TicketBroadcaster Broadcaster
@inject IDialogService Dialog
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Meine Tickets · FIB</PageTitle>

@if (_anonymous)
{
    <CitizenSignInPanel Title="Meine Tickets"
                        Text="Melde dich mit Discord an, um deine Anliegen an die Führungsebene zu sehen."
                        ReturnUrl="@ReturnUrl()" />
}
else if (_ready)
{
    <MudPaper Elevation="4" Class="pa-4 pa-sm-8">
        <MudStack Spacing="4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.overline" Color="Color.Primary">Bürgerbereich</MudText>
                    <MudText Typo="Typo.h4">Meine Tickets</MudText>
                </MudStack>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    @if (_moduleOn && _detail is null && !_needsIdentity)
                    {
                        <MudButton OnClick="OpenNewAsync" Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add">Neues Ticket</MudButton>
                    }
                    @* agents took their own questions to leadership over Discord; the same desk answers both *@
                    @if (_isAgent && _detail is null)
                    {
                        <MudButton OnClick="OpenInternalAsync" Variant="Variant.Outlined" Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.Lock">Internes Ticket</MudButton>
                    }
                </MudStack>
            </MudStack>

            @if (!_moduleOn && _detail is null)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    Der Ticket-Chat ist derzeit geschlossen. Bestehende Tickets kannst du weiterhin lesen.
                </MudAlert>
            }

            @* a citizen has a name by the time they get here; every other account may not, and the desk needs one
               behind the ticket. Without this the button led straight into a red toast *@
            @if (_needsIdentity && _moduleOn && _detail is null)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    Für ein Ticket brauchst du zuerst eine Zivil-Identität: Lege unter
                    <MudLink Href="/buerger/profil">Mein Konto</MudLink> Vor- und Nachnamen fest.
                </MudAlert>
            }

            @if (_detail is not null)
            {
                <MudButton Href="/buerger/tickets" Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.ArrowBack" Class="align-self-start">Zur Übersicht</MudButton>

                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@_detail.CaseNumber</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@StatusColour(_detail.Status)">
                        @TicketStatusDisplay.CitizenName(_detail.Status)
                    </MudChip>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        eröffnet am @_detail.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </MudText>
                </MudStack>

                <MudText Typo="Typo.h6">@_detail.Subject</MudText>
                <MudDivider />

                <MudStack Spacing="2">
                    @* indexed, because an attachment is addressed by its position in exactly this list *@
                    @for (var index = 0; index < _detail.Messages.Count; index++)
                    {
                        var message = _detail.Messages[index];
                        <MudPaper Outlined="true" Class="pa-3"
                                  Style="@(message.FromCitizen ? "margin-left:15%;" : "margin-right:15%;")">
                            <MudStack Spacing="1">
                                @* a line you may already have read can be corrected; saying so costs no identity *@
                                <MudText Typo="Typo.caption" Color="@(message.FromCitizen ? Color.Default : Color.Primary)">
                                    @(message.FromCitizen ? "Du" : TicketRules.AgencySender)
                                    · @message.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    @if (message.EditedAt is not null)
                                    {
                                        <span> · bearbeitet</span>
                                    }
                                </MudText>
                                <MudText Typo="Typo.body2" Style="white-space:pre-wrap;">@message.Text</MudText>
                                @if (message.HasAttachment)
                                {
                                    @* addressed by case number and position: the outward record carries no row id *@
                                    <MudButton Href="@($"/dateien/tickets/az/{_detail.CaseNumber}/{index}?inline=true")"
                                               Target="_blank" Variant="Variant.Text" Color="Color.Default"
                                               Size="Size.Small" StartIcon="@Icons.Material.Filled.Image">
                                        @(message.AttachmentName ?? "Anhang")
                                    </MudButton>
                                }
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>

                @if (_loadFailed)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">
                        Deine Tickets konnten nicht geladen werden. Bitte lade die Seite neu.
                    </MudAlert>
                }
                else if (_detail.MayReply)
                {
                    <MudTextField @bind-Value="_reply" Label="Antwort" Lines="3" Variant="Variant.Outlined"
                                  MaxLength="@TicketRules.MaxMessageLength" />
                    <ImageAttachmentPicker @bind-Picked="_attachment" MaxBytes="@AttachmentStore.MaxBytes"
                                           Disabled="_busy" />
                    <div>
                        <MudButton OnClick="ReplyAsync" Disabled="_busy" Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Send">Antwort senden</MudButton>
                    </div>
                }
                else if (_detail.IsBlocked)
                {
                    @* the real reason: one collapsed flag told a blocked account its OPEN ticket was closed *@
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                        Dieses Konto ist für Einreichungen gesperrt. Antworten ist derzeit nicht möglich.
                    </MudAlert>
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Dieses Ticket ist abgeschlossen. Für ein neues Anliegen öffne bitte ein neues Ticket.
                    </MudText>
                }
            }
            else if (_rows.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    Du hast noch kein Ticket eröffnet.
                </MudAlert>
            }
            else
            {
                <MudStack Spacing="2">
                    @foreach (var row in _rows)
                    {
                        @* keyboard-reachable, like StatTile: this row is the ONLY way into the detail view, so
                           a click-only div locks out every keyboard and screen-reader user *@
                        <MudPaper Outlined="true" Class="pa-4" Style="cursor:pointer;"
                                  role="link" tabindex="0"
                                  aria-label="@($"Ticket {row.CaseNumber} öffnen")"
                                  @onkeydown="@(e => { if (e.Key is "Enter" or " ") Open(row.CaseNumber); })"
                                  @onclick="@(() => Open(row.CaseNumber))">
                            <MudStack Spacing="2">
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@row.CaseNumber</MudChip>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@StatusColour(row.Status)">
                                        @TicketStatusDisplay.CitizenName(row.Status)
                                    </MudChip>
                                    @if (row.UnreadCount > 0)
                                    {
                                        <MudBadge Content="@row.UnreadCount" Color="Color.Error" Overlap="false">
                                            <MudText Typo="Typo.caption">Neue Nachricht</MudText>
                                        </MudBadge>
                                    }
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @row.LastActivityAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    </MudText>
                                </MudStack>
                                <MudText Typo="Typo.body2">@row.Subject</MudText>
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            }
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter]
    public string? CaseNumber { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private ClaimsPrincipal _user = default!;
    private IReadOnlyList<CitizenTicketRow> _rows = Array.Empty<CitizenTicketRow>();
    private bool _loadFailed;
    private CitizenTicketDetail? _detail;
    private string _reply = string.Empty;
    private ImageAttachmentPicker.PickedImage? _attachment;
    private bool _ready;
    private bool _busy;
    private bool _moduleOn;
    private bool _anonymous;
    private bool _isAgent;
    private bool _needsIdentity;
    private string? _loadedKey;

    private string ReturnUrl()
        => string.IsNullOrWhiteSpace(CaseNumber) ? "/buerger/tickets" : $"/buerger/tickets/{CaseNumber}";

    protected override void OnInitialized() => Broadcaster.Modified += OnModified;

    // OnParametersSet, not OnInitialized: list and detail share this component, so Blazor reuses the instance
    protected override async Task OnParametersSetAsync()
    {
        _user = (await AuthStateTask).User;
        // render the sign-in panel instead of navigating: OnParametersSet re-runs on every auth-state change, and a
        // forceLoad there threw the visitor onto the landing page mid-session
        if (!_user.MayUseCitizenPortal())
        {
            _anonymous = true;
            _ready = true;
            return;
        }
        _anonymous = false;
        _isAgent = _user.IsInternalAgent();

        var key = CaseNumber ?? string.Empty;
        if (_loadedKey == key)
        {
            return;
        }
        _loadedKey = key;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try { _moduleOn = (await Modules.GetAsync()).IsEnabled(PublicModules.Tickets); }
        catch { /* best effort */ }

        // fails open: a lookup error leaves the button in place rather than claiming an identity is missing
        try { _needsIdentity = _user.MayCitizenSubmit() && !await Buerger.HasCompleteProfileAsync(_user); }
        catch { /* best effort */ }

        try
        {
            if (string.IsNullOrWhiteSpace(CaseNumber))
            {
                _detail = null;
                _rows = await Tickets.GetOwnAsync(_user);
                _loadFailed = false;
            }
            else
            {
                _detail = await Tickets.GetOwnDetailAsync(CaseNumber, _user);
                if (_detail is null)
                {
                    Nav.NavigateTo("/buerger/tickets");
                    return;
                }
                // opening is reading; the mark moves before the next unread count is drawn
                await Tickets.MarkCitizenReadAsync(CaseNumber, _user);
            }
        }
        catch (Exception ex)
        {
            // the flag as well as the snackbar: the toast is gone on the next render, and without it the list
            // below would claim the account has none
            _loadFailed = true;
            Snackbar.Add(ex.Message, Severity.Error);
        }
        _ready = true;
    }

    private void Open(string caseNumber) => Nav.NavigateTo($"/buerger/tickets/{caseNumber}");

    private async Task OpenInternalAsync()
    {
        var caseNumber = await InternalTicketOpenDialog.ShowAsync(Dialog, _user);
        if (caseNumber is not null)
        {
            // the internal desk, not this shell: an internal ticket has no citizen side to show here
            Nav.NavigateTo("/tickets?tab=beteiligt");
        }
    }

    private async Task OpenNewAsync()
    {
        var caseNumber = await TicketOpenDialog.ShowAsync(Dialog, _user);
        if (caseNumber is not null)
        {
            Nav.NavigateTo($"/buerger/tickets/{caseNumber}");
        }
    }

    private async Task ReplyAsync()
    {
        if (CaseNumber is null)
        {
            return;
        }
        _busy = true;
        try
        {
            var upload = _attachment is { } picked
                ? new TicketAttachmentUpload(new MemoryStream(picked.Content), picked.ContentType,
                    picked.OriginalName, picked.Size)
                : null;
            await Tickets.ReplyAsCitizenAsync(CaseNumber, _reply, _user, upload);
            _reply = string.Empty;
            _attachment = null;
            _detail = await Tickets.GetOwnDetailAsync(CaseNumber, _user);
            Snackbar.Add("Antwort gesendet.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    // the case number is what this page knows; the row id in the same signal belongs to the desk. Comparing it
    // is what keeps every citizen circuit from reloading on every ticket in the house
    private void OnModified(string ticketId, string caseNumber, TicketMessageAudience? audience)
    {
        // an internal note is signalled too, and the citizen circuit must not learn WHEN the desk talks about them
        if (audience == TicketMessageAudience.Intern)
        {
            return;
        }
        var mine = string.IsNullOrWhiteSpace(CaseNumber)
            ? _rows.Any(r => r.CaseNumber == caseNumber)
            : CaseNumbers.Normalize(CaseNumber) == caseNumber;
        if (!mine)
        {
            return;
        }
        InvokeAsync(async () =>
        {
            if (string.IsNullOrWhiteSpace(CaseNumber))
            {
                _rows = await Tickets.GetOwnAsync(_user);
            }
            else
            {
                _detail = await Tickets.GetOwnDetailAsync(CaseNumber, _user);
                // an answer arriving while the thread is open has been read
                await Tickets.MarkCitizenReadAsync(CaseNumber, _user);
            }
            StateHasChanged();
        });
    }

    public void Dispose() => Broadcaster.Modified -= OnModified;

    private static Color StatusColour(TicketStatus status) => status switch
    {
        TicketStatus.Offen => Color.Info,
        TicketStatus.InBearbeitung => Color.Primary,
        TicketStatus.WartetAufBuerger => Color.Warning,
        TicketStatus.Geschlossen => Color.Default,
        _ => Color.Default,
    };
}
