@page "/buerger/hinweise"
@page "/buerger/hinweise/{CaseNumber}"
@layout BuergerLayout
@attribute [AllowAnonymous]
@implements IDisposable
@using NOOSE_Website.Infrastructure.Chat
@using NOOSE_Website.Models.Public
@using NOOSE_Website.Services.Public
@inject ITipService Tips
@inject IRewardService Reward
@inject IPublicModuleService Modules
@inject TipsBroadcaster Broadcaster
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Meine Hinweise · FIB</PageTitle>

@if (_anonymous)
{
    <CitizenSignInPanel Title="Meine Hinweise"
                        Text="Melde dich mit Discord an, um deine Hinweise zu sehen und zu beantworten."
                        ReturnUrl="@ReturnUrl()" />
}
else if (_ready)
{
    <MudPaper Elevation="4" Class="pa-4 pa-sm-8">
        <MudStack Spacing="4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.overline" Color="Color.Primary">Bürgerbereich</MudText>
                    <MudText Typo="Typo.h4">Meine Hinweise</MudText>
                </MudStack>
                @if (_moduleOn && _detail is null)
                {
                    <MudButton Href="/hinweis" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add">Neuen Hinweis geben</MudButton>
                }
            </MudStack>

            @if (_detail is not null)
            {
                <MudButton Href="/buerger/hinweise" Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.ArrowBack" Class="align-self-start">Zur Übersicht</MudButton>

                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@_detail.CaseNumber</MudChip>
                    @if (_detail.Kind == TipKind.Ergreifung)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                                 Icon="@TipKindDisplay.Icon(TipKind.Ergreifung)">
                            @TipKindDisplay.Name(TipKind.Ergreifung)
                        </MudChip>
                    }
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@StatusColour(_detail.Status)">
                        @TipStatusDisplay.CitizenName(_detail.Status)
                    </MudChip>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        eingegangen am @_detail.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </MudText>
                </MudStack>

                @if (_detail.WantedCaseNumber is not null)
                {
                    <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true"
                              Icon="@Icons.Material.Filled.PersonSearch">
                        Bezug: <b>@_detail.WantedDisplayName</b> (@_detail.WantedCaseNumber)
                    </MudAlert>
                }
                @if (_detail.Kind == TipKind.Ergreifung && _detail.Handover is { } handover)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true"
                              Icon="@TipHandoverDisplay.Icon(handover)">
                        <MudStack Spacing="0">
                            <div>@TipHandoverDisplay.Name(handover)</div>
                            @if (!string.IsNullOrWhiteSpace(_detail.HandoverLocation))
                            {
                                <div class="mud-text-secondary">@_detail.HandoverLocation</div>
                            }
                        </MudStack>
                    </MudAlert>
                }
                @if (_detail.WantsAnonymity)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        @(_detail.AnonymityResolved
                            ? "Die Anonymität wurde von der Führungsebene aufgehoben — eine Belohnung ist damit möglich."
                            : "Dieser Hinweis ist anonym. Für eine Belohnung muss die Anonymität aufgehoben werden.")
                    </MudAlert>
                }

                @foreach (var reward in _rewards.Where(r => r.TipCaseNumber == _detail.CaseNumber))
                {
                    <MudPaper Outlined="true" Class="pa-4">
                        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudIcon Icon="@Icons.Material.Filled.Redeem" Color="Color.Success" />
                            <MudStack Spacing="0" Style="flex:1 1 240px;">
                                <MudText Typo="Typo.h6">Belohnung: @Money.Format(reward.Amount)</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    Beleg @reward.ReceiptNumber ·
                                    ausgezahlt am @reward.PaidAt.ToLocalTime().ToString("dd.MM.yyyy")
                                </MudText>
                            </MudStack>
                            <MudButton Href="@($"/buerger/belohnung/{reward.ReceiptNumber}/druck")" Target="_blank"
                                       Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Print">Beleg drucken</MudButton>
                        </MudStack>
                    </MudPaper>
                }

                <MudPaper Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.body1" Style="white-space:pre-wrap;">@_detail.Text</MudText>
                </MudPaper>

                @if (_detail.HasAttachment)
                {
                    @* a real link now: the projection carries no row id (deliberately), so the owner route is
                       addressed by case number - the id route serves the desk only *@
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Anhang:
                        <MudLink Href="@($"/dateien/hinweise/az/{_detail.CaseNumber}?inline=true")"
                                 Target="_blank" rel="noopener noreferrer" Typo="Typo.caption">
                            @(_detail.AttachmentName ?? "Bild")
                        </MudLink>
                    </MudText>
                }

                <MudDivider />
                <MudText Typo="Typo.h6">Schriftwechsel</MudText>
                @if (_detail.Messages.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Noch keine Nachricht. Wir melden uns, wenn wir eine Rückfrage haben.
                    </MudText>
                }
                else
                {
                    <MudStack Spacing="2">
                        @foreach (var message in _detail.Messages)
                        {
                            <MudPaper Outlined="true" Class="pa-3"
                                      Style="@(message.FromCitizen ? "margin-left:15%;" : "margin-right:15%;")">
                                <MudStack Spacing="1">
                                    @* a line you may already have read can be corrected; saying so costs no identity *@
                                    <MudText Typo="Typo.caption" Color="@(message.FromCitizen ? Color.Default : Color.Primary)">
                                        @(message.FromCitizen ? "Du" : "FIB")
                                        · @message.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                        @if (message.EditedAt is not null)
                                        {
                                            <span> · bearbeitet</span>
                                        }
                                    </MudText>
                                    <MudText Typo="Typo.body2" Style="white-space:pre-wrap;">@message.Text</MudText>
                                </MudStack>
                            </MudPaper>
                        }
                    </MudStack>
                }

                @if (_loadFailed)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">
                        Deine Hinweise konnten nicht geladen werden. Bitte lade die Seite neu.
                    </MudAlert>
                }
                else if (_detail.MayReply)
                {
                    <MudTextField @bind-Value="_reply" Label="Antwort" Lines="3" Variant="Variant.Outlined"
                                  MaxLength="@TipRules.MaxMessageLength" />
                    <div>
                        <MudButton OnClick="ReplyAsync" Disabled="_busy" Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Send">Antwort senden</MudButton>
                    </div>
                }
                else if (_detail.IsBlocked)
                {
                    @* the real reason, as on a ticket: one collapsed flag claimed the tip was closed *@
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                        Dieses Konto ist für Einreichungen gesperrt. Antworten ist derzeit nicht möglich.
                    </MudAlert>
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Dieser Hinweis ist abgeschlossen; eine Antwort ist nicht mehr möglich.
                    </MudText>
                }
            }
            else if (_rows.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    Du hast noch keinen Hinweis übermittelt.
                </MudAlert>
            }
            else
            {
                <MudStack Spacing="2">
                    @foreach (var row in _rows)
                    {
                        @* keyboard-reachable, like StatTile: this row is the ONLY way into the detail view, so
                           a click-only div locks out every keyboard and screen-reader user *@
                        <MudPaper Outlined="true" Class="pa-4" Style="cursor:pointer;"
                                  role="link" tabindex="0"
                                  aria-label="@($"Hinweis {row.CaseNumber} öffnen")"
                                  @onkeydown="@(e => { if (e.Key is "Enter" or " ") Open(row.CaseNumber); })"
                                  @onclick="@(() => Open(row.CaseNumber))">
                            <MudStack Spacing="2">
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@row.CaseNumber</MudChip>
                                    @if (row.Kind == TipKind.Ergreifung)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                                                 Icon="@TipKindDisplay.Icon(TipKind.Ergreifung)">
                                            @TipKindDisplay.Name(TipKind.Ergreifung)
                                        </MudChip>
                                    }
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@StatusColour(row.Status)">
                                        @TipStatusDisplay.CitizenName(row.Status)
                                    </MudChip>
                                    @if (row.UnreadCount > 0)
                                    {
                                        <MudBadge Content="@row.UnreadCount" Color="Color.Error" Overlap="false">
                                            <MudText Typo="Typo.caption">Neue Nachricht</MudText>
                                        </MudBadge>
                                    }
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @row.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")
                                    </MudText>
                                </MudStack>
                                @if (row.WantedCaseNumber is not null)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Primary">
                                        Bezug: @row.WantedDisplayName (@row.WantedCaseNumber)
                                    </MudText>
                                }
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">@row.Excerpt</MudText>
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            }
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter]
    public string? CaseNumber { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private ClaimsPrincipal _user = default!;
    private IReadOnlyList<CitizenTipRow> _rows = Array.Empty<CitizenTipRow>();
    private bool _loadFailed;
    private IReadOnlyList<CitizenRewardRow> _rewards = Array.Empty<CitizenRewardRow>();
    private CitizenTipDetail? _detail;
    private string _reply = string.Empty;
    private bool _ready;
    private bool _busy;
    private bool _moduleOn;
    private bool _anonymous;
    private string? _loadedKey;

    protected override void OnInitialized() => Broadcaster.Modified += OnModified;

    // the case number is what this page knows; the row id in the same signal belongs to the desk. Comparing it is
    // what keeps every citizen circuit from reloading on every tip in the house
    private void OnModified(string tipId, string caseNumber, TipMessageAudience? audience)
    {
        // an internal note is signalled too, and the citizen circuit must not learn WHEN the desk talks about them
        if (audience == TipMessageAudience.Intern)
        {
            return;
        }
        if (_anonymous || !_ready)
        {
            return;
        }
        var mine = string.IsNullOrWhiteSpace(CaseNumber)
            ? _rows.Any(r => r.CaseNumber == caseNumber)
            : CaseNumber == caseNumber;
        if (!mine)
        {
            return;
        }
        InvokeAsync(async () =>
        {
            try
            {
                if (string.IsNullOrWhiteSpace(CaseNumber))
                {
                    _rows = await Tips.GetOwnAsync(_user);
                }
                else
                {
                    _detail = await Tips.GetOwnDetailAsync(CaseNumber, _user);
                    // an answer arriving while the thread is open has been read
                    await Tips.MarkCitizenReadAsync(CaseNumber, _user);
                }
                StateHasChanged();
            }
            catch
            {
                /* best effort: a live refresh must never topple the page */
            }
        });
    }

    public void Dispose() => Broadcaster.Modified -= OnModified;

    private string ReturnUrl()
        => string.IsNullOrWhiteSpace(CaseNumber) ? "/buerger/hinweise" : $"/buerger/hinweise/{CaseNumber}";

    // OnParametersSet, not OnInitialized: list and detail share this component, so Blazor reuses the instance
    protected override async Task OnParametersSetAsync()
    {
        _user = (await AuthStateTask).User;
        // render the sign-in panel instead of navigating: OnParametersSet re-runs on every auth-state change, and a
        // forceLoad there threw the visitor onto the landing page mid-session
        if (!_user.MayUseCitizenPortal())
        {
            _anonymous = true;
            _ready = true;
            return;
        }
        _anonymous = false;

        var key = CaseNumber ?? string.Empty;
        if (_loadedKey == key)
        {
            return;
        }
        _loadedKey = key;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try { _moduleOn = (await Modules.GetAsync()).IsEnabled(PublicModules.Tips); }
        catch { /* best effort */ }

        // its own try: the reward module is switched separately, and a closed one only costs the receipt card
        try { _rewards = await Reward.GetOwnAsync(_user); }
        catch { /* best effort */ }

        try
        {
            if (string.IsNullOrWhiteSpace(CaseNumber))
            {
                _detail = null;
                _rows = await Tips.GetOwnAsync(_user);
                _loadFailed = false;
            }
            else
            {
                _detail = await Tips.GetOwnDetailAsync(CaseNumber, _user);
                if (_detail is null)
                {
                    Nav.NavigateTo("/buerger/hinweise");
                    return;
                }
                // opening is reading; the mark moves before the next unread count is drawn
                await Tips.MarkCitizenReadAsync(CaseNumber, _user);
            }
        }
        catch (Exception ex)
        {
            // the flag as well as the snackbar: the toast is gone on the next render, and without it the list
            // below would claim the account has none
            _loadFailed = true;
            Snackbar.Add(ex.Message, Severity.Error);
        }
        _ready = true;
    }

    private void Open(string caseNumber) => Nav.NavigateTo($"/buerger/hinweise/{caseNumber}");

    private async Task ReplyAsync()
    {
        if (CaseNumber is null)
        {
            return;
        }
        _busy = true;
        try
        {
            await Tips.ReplyAsCitizenAsync(CaseNumber, _reply, _user);
            _reply = string.Empty;
            _detail = await Tips.GetOwnDetailAsync(CaseNumber, _user);
            Snackbar.Add("Antwort gesendet.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static Color StatusColour(TipStatus status) => status switch
    {
        TipStatus.Neu => Color.Info,
        TipStatus.InPruefung => Color.Primary,
        TipStatus.Rueckfrage => Color.Warning,
        TipStatus.Bestaetigt => Color.Success,
        TipStatus.FuehrteZurErgreifung => Color.Success,
        _ => Color.Default,
    };
}
