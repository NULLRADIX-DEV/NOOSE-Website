@page "/portal/status"
@layout ApplicantPortalLayout
@attribute [AllowAnonymous]
@inject IBewerbungService BewerbungService
@inject IBewerbungTestService TestService
@inject IBewerbungssperreService SperreService
@inject IDialogService DialogService
@inject NavigationManager Nav

<PageTitle>Status · FIB</PageTitle>

@if (_ready)
{
    <div style="display:flex;flex-direction:column;height:calc(100dvh - 180px);min-height:460px;gap:16px;">
        @* compact status bar keeps the chat as the centrepiece *@
        <MudPaper Elevation="4" Class="pa-4" Style="flex:0 0 auto;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
                    <MudChip T="string" Color="BewerbungStatusDisplay.ChipColor(BewerbungStatusDisplay.ApplicantStep(_bewerbung.Status))" Variant="Variant.Filled">
                        @BewerbungStatusDisplay.ApplicantName(_bewerbung.Status)
                    </MudChip>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2" Style="line-height:1.15;">@_bewerbung.Name</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Aktenzeichen @_bewerbung.CaseNumber</MudText>
                    </MudStack>
                </MudStack>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    @* merged stage, so the button does not vanish when HRB advances past the test *@
                    @if (_test is { Completed: false } && !Ueberfaellig
                         && BewerbungStatusDisplay.ApplicantStep(_bewerbung.Status) == BewerbungStatus.ImTest)
                    {
                        <MudStack Spacing="0" AlignItems="AlignItems.End">
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                                       StartIcon="@(_test.StartedAt is null ? Icons.Material.Filled.Quiz : Icons.Material.Filled.PlayArrow)"
                                       Href="/portal/test">
                                @(_test.StartedAt is null ? "Eignungstest ausfüllen" : "Test fortsetzen")
                            </MudButton>
                            @if (Zeithinweis is { Length: > 0 } hinweis)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">@hinweis</MudText>
                            }
                        </MudStack>
                    }
                    @if (_bewerbung.Status != BewerbungStatus.Abgelehnt && _bewerbung.Status != BewerbungStatus.Geschlossen)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                   EndIcon="@(_detailsOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                   OnClick="@(() => _detailsOpen = !_detailsOpen)">Details</MudButton>
                    }
                </MudStack>
            </MudStack>

            @* in the bar, not folded away behind "Details": this is the only confirmation the applicant gets
               after submitting, and it took the place the questionnaire button just vacated *@
            @if (_test is { Completed: true, TimedOut: true })
            {
                @* Info, not Warning: a timeout is a neutral fact, and a louder colour would read as a verdict *@
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                    Die Bearbeitungszeit ist abgelaufen. Deine bis dahin eingetragenen Antworten wurden
                    übermittelt. Wir melden uns.
                </MudAlert>
            }
            else if (_test is { Completed: true })
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                    Dein Eignungstest wurde übermittelt. Wir melden uns.
                </MudAlert>
            }
            else if (Ueberfaellig)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                    Die Bearbeitungszeit ist abgelaufen. Deine Antworten werden abgeschlossen.
                </MudAlert>
            }

            @if (_bewerbung.AttachmentFileNameSaved is not null)
            {
                @* own divider; both following branches emit their own *@
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Dein Anhang</MudText>
                @if (IsImage(_bewerbung.AttachmentContentType))
                {
                    @* keyboard-reachable: this is the only way to open the attachment *@
                    <div @onclick="OpenAttachmentAsync" role="button" tabindex="0" aria-label="Anhang öffnen"
                         @onkeydown="@(e => { if (e.Key is "Enter" or " ") { return OpenAttachmentAsync(); } return Task.CompletedTask; })"
                         style="cursor:pointer;width:max-content;" class="mt-1">
                        <MudImage Src="@($"/dateien/bewerbungen/anhang/{_bewerbung.Id}?inline=true")" Alt="@_bewerbung.AttachmentOriginalName"
                                  Height="96" ObjectFit="ObjectFit.Cover" Class="rounded" />
                    </div>
                    <MudLink Href="@($"/dateien/bewerbungen/anhang/{_bewerbung.Id}")" Target="_blank" Typo="Typo.body2" Class="d-block mt-1">
                        <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" Class="mr-1" />@(_bewerbung.AttachmentOriginalName ?? "Datei herunterladen")
                    </MudLink>
                }
                else
                {
                    <MudButton Href="@($"/dateien/bewerbungen/anhang/{_bewerbung.Id}")" Target="_blank" Variant="Variant.Outlined"
                               Size="Size.Small" StartIcon="@Icons.Material.Filled.AttachFile" Class="mt-1">
                        @(_bewerbung.AttachmentOriginalName ?? "Datei")
                    </MudButton>
                }
            }

            @if (_bewerbung.Status == BewerbungStatus.Abgelehnt || _bewerbung.Status == BewerbungStatus.Geschlossen)
            {
                <MudDivider Class="my-3" />
                @if (_ban is not null)
                {
                    <BewerbungssperreCard IsBlacklist="_ban.IsBlacklist" BannedUntil="_ban.BannedUntil" DecisionStatus="_bewerbung.Status" />
                }
                else
                {
                    <MudAlert Severity="@(_bewerbung.Status == BewerbungStatus.Abgelehnt ? Severity.Error : Severity.Info)" Variant="Variant.Outlined">
                        @(_bewerbung.Status == BewerbungStatus.Abgelehnt
                            ? "Deine Bewerbung wurde abgelehnt. Weitere Auskünfte werden nicht erteilt."
                            : "Dein Auswahlverfahren wurde abgeschlossen. Weitere Auskünfte werden nicht erteilt.")
                    </MudAlert>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send"
                               Href="/portal" Class="mt-3">Neue Bewerbung</MudButton>
                }
            }
            else
            {
                <MudCollapse Expanded="_detailsOpen">
                    <MudDivider Class="my-3" />
                    <MudTimeline TimelinePosition="TimelinePosition.Start">
                        @foreach (var step in Steps)
                        {
                            <MudTimelineItem Color="@(StepReached(step) ? Color.Primary : Color.Default)"
                                             Variant="@(step == BewerbungStatusDisplay.ApplicantStep(_bewerbung.Status) ? Variant.Filled : Variant.Outlined)">
                                <MudText Typo="Typo.body2">@BewerbungStatusDisplay.ApplicantName(step)</MudText>
                            </MudTimelineItem>
                        }
                    </MudTimeline>
                </MudCollapse>
            }
        </MudPaper>

        @* chat takes all remaining viewport height *@
        <MudPaper Elevation="4" Class="pa-4" Style="flex:1 1 auto;min-height:0;display:flex;flex-direction:column;">
            <MudText Typo="Typo.subtitle1" Class="mb-2" Style="flex:0 0 auto;">Kommunikation mit dem FIB</MudText>
            <div style="flex:1 1 auto;min-height:0;">
                <BewerbungMessagePanel BewerbungId="@_bewerbung.Id" User="_user"
                                       Audience="BewerbungMessageAudience.Bewerber" IsApplicantView="true"
                                       CanWrite="true" CollapsibleComposer="true" HeightCss="100%" />
            </div>
        </MudPaper>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    // interview stage merged into the test stage; see ApplicantName
    private static readonly BewerbungStatus[] Steps =
    [
        BewerbungStatus.Eingereicht,
        BewerbungStatus.InSicherheitspruefung,
        BewerbungStatus.ImTest,
        BewerbungStatus.Angenommen,
    ];

    private ClaimsPrincipal _user = default!;
    private bool _ready;
    private bool _detailsOpen;
    private Bewerbung _bewerbung = default!;
    private TestStatusView? _test;
    private BewerbungssperreInfo? _ban;

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        if (!_user.MayApply())
        {
            Nav.NavigateTo("/karriere", forceLoad: true);
            return;
        }
        var own = await BewerbungService.GetOwnAsync(_user);
        if (own is null)
        {
            Nav.NavigateTo("/portal");
            return;
        }
        _bewerbung = own;
        if (own.Status is BewerbungStatus.Abgelehnt or BewerbungStatus.Geschlossen)
        {
            _ban = await SperreService.GetActiveAsync(_user.GetAgentId() ?? string.Empty);
        }
        // the summary, never the questionnaire: opening this page must not start the attempt clock
        _test = await TestService.GetTestStatusForApplicantAsync(_user);
        _ready = true;
    }

    private bool StepReached(BewerbungStatus step) => (int)_bewerbung.Status >= (int)step;

    /// <summary>Deadline gone but nothing closed it yet; offering to continue would be a broken promise.</summary>
    private bool Ueberfaellig => _test is { Completed: false }
        && TestDeadline.IsExpired(_test.DeadlineAt, DateTime.UtcNow);

    /// <summary>"ca." on purpose: this page has no ticker, and one would re-render the chat beneath it.</summary>
    private string Zeithinweis
    {
        get
        {
            if (_test is null)
            {
                return string.Empty;
            }
            if (_test.StartedAt is null)
            {
                return _test.TimeLimitMinutes is { } limit
                    ? $"Bearbeitungszeit: {limit} Minuten. Die Zeit läuft erst, wenn du den Test startest."
                    : string.Empty;
            }
            return TestAttemptLogic.RemainingMinutes(_test.DeadlineAt, DateTime.UtcNow) switch
            {
                null => string.Empty,
                1 => "Weniger als eine Minute.",
                var minutes => $"Restzeit noch ca. {minutes} Minuten.",
            };
        }
    }

    private static bool IsImage(string? contentType)
        => contentType?.StartsWith("image/", StringComparison.OrdinalIgnoreCase) == true;

    private Task OpenAttachmentAsync()
        => ImageLightbox.ShowAsync(DialogService,
            [new ImageLightbox.LightboxImage($"/dateien/bewerbungen/anhang/{_bewerbung.Id}?inline=true", _bewerbung.AttachmentOriginalName)]);
}
