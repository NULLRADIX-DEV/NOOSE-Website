@page "/portal"
@layout ApplicantPortalLayout
@attribute [AllowAnonymous]
@inject IBewerbungService BewerbungService
@inject IBewerbungssperreService SperreService
@inject IDiscordMembershipCheck MembershipCheck
@inject IDiscordDmService DiscordSettings
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Bewerbung · FIB</PageTitle>

@if (_blocked && _ban is not null)
{
    <MudPaper Elevation="4" Class="pa-4 pa-sm-8">
        <BewerbungssperreCard IsBlacklist="_ban.IsBlacklist" BannedUntil="_ban.BannedUntil" DecisionStatus="_lastStatus" />
    </MudPaper>
}
else if (_ready)
{
    <MudPaper Elevation="4" Class="pa-4 pa-sm-8">
        <MudStack Spacing="4">
            <MudText Typo="Typo.h4">Deine Bewerbung</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Bitte fülle die folgenden Angaben sorgfältig aus. Nach dem Absenden kannst du den Status hier im
                Portal verfolgen und mit der Administration Division kommunizieren.
            </MudText>

            @if (NotMember)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                    <MudStack Spacing="3">
                        <MudText>
                            Du bist noch nicht auf unserem Discord-Server. Bewerbungen nehmen wir nur von Mitgliedern an.
                        </MudText>
                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                            <MudButton Variant="Variant.Filled" Color="Color.Warning" Href="@_inviteLink" Target="_blank"
                                       rel="noopener noreferrer" StartIcon="@Icons.Material.Filled.OpenInNew">
                                Discord beitreten
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="RecheckAsync"
                                       Disabled="_checking" StartIcon="@Icons.Material.Filled.Refresh">
                                Erneut prüfen
                            </MudButton>
                        </MudStack>
                    </MudStack>
                </MudAlert>
            }

            <MudTextField @bind-Value="_model.AcademicDegree" Label="Akademischer Grad (optional)" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="_model.Name" Label="Name" Required="true" Variant="Variant.Outlined" />
            <MudDatePicker @bind-Date="_model.BirthDate" Label="Geburtsdatum" Variant="Variant.Outlined"
                           MaxDate="DateTime.Today" />
            <MudTextField @bind-Value="_model.Employer" Label="Arbeitgeber" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="_model.PriorExperience" Label="Vorerfahrung" Variant="Variant.Outlined"
                          Lines="3" Placeholder="z. B. 05.10.2024 – 14.06.2026 LSPD" />
            <MudTextField @bind-Value="_model.CoverLetter" Label="Anschreiben" Variant="Variant.Outlined"
                          Lines="6" Placeholder="Deine Motivation und weitere Angaben …" />

            <MudStack Spacing="1">
                <MudText Typo="Typo.subtitle2">Darf deine Bewerbung gestreamt werden?</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Gemeint ist, ob die Bearbeitung deiner Bewerbung, etwa das Vorstellungsgespräch, live gestreamt
                    werden darf. Deine Wahl hat keinen Einfluss auf die Entscheidung.
                </MudText>
                <MudRadioGroup T="bool?" @bind-Value="_model.StreamConsent">
                    <MudRadio T="bool?" Value="true" Color="Color.Primary">Ja, das ist okay</MudRadio>
                    <MudRadio T="bool?" Value="false" Color="Color.Primary">Nein, bitte nicht</MudRadio>
                </MudRadioGroup>
            </MudStack>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudButton HtmlTag="label" Variant="Variant.Outlined" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.AttachFile" for="anhang">
                    Anhang wählen (optional)
                </MudButton>
                <InputFile id="anhang" OnChange="OnFile" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg,.webp,.gif" style="display:none;" />
                @if (_file is not null)
                {
                    <MudText Typo="Typo.body2">@_file.Name</MudText>
                }
            </MudStack>

            <MudStack Row="true" Justify="Justify.FlexEnd">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send"
                           OnClick="SubmitAsync" Disabled="@(_busy || NotMember)">Bewerbung absenden</MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private const long MaxBytes = 15 * 1024 * 1024;
    private ClaimsPrincipal _user = default!;
    private bool _ready;
    private bool _blocked;
    private bool _busy;
    private bool _checking;
    private bool _membershipAsked;
    private DiscordMembership _membership = DiscordMembership.Unknown;
    private string _inviteLink = DiscordDmSettings.DefaultInviteLink;
    private BewerbungssperreInfo? _ban;
    private BewerbungStatus? _lastStatus;
    private readonly BewerbungSubmitModel _model = new();
    private IBrowserFile? _file;

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        if (!_user.MayApply())
        {
            Nav.NavigateTo("/karriere", forceLoad: true);
            return;
        }
        var own = await BewerbungService.GetOwnAsync(_user);
        _lastStatus = own?.Status;
        if (own is not null && own.Status != BewerbungStatus.Abgelehnt && own.Status != BewerbungStatus.Geschlossen)
        {
            // an open or accepted application already exists
            Nav.NavigateTo("/portal/status");
            return;
        }
        // no application, or a closed/rejected one — eligible to (re)apply unless banned or blacklisted
        _ban = await SperreService.GetActiveAsync(_user.GetAgentId() ?? string.Empty);
        if (_ban is not null)
        {
            _blocked = true;
            return;
        }
        _ready = true;
    }

    private bool NotMember => _membership == DiscordMembership.NotMember;

    // once the form shows, so an unreachable Discord never holds it back; the first render is still without it
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_ready && !_membershipAsked)
        {
            _membershipAsked = true;
            await CheckMembershipAsync();
            StateHasChanged();
        }
    }

    private async Task RecheckAsync()
    {
        await CheckMembershipAsync();
        if (NotMember)
        {
            Snackbar.Add("Wir finden dich noch nicht auf dem Server.", Severity.Info);
        }
    }

    // Unknown (also on any error) shows nothing and blocks nothing
    private async Task CheckMembershipAsync()
    {
        _checking = true;
        try
        {
            _membership = await MembershipCheck.CheckAsync(_user.GetAgentId() ?? string.Empty);
            if (NotMember)
            {
                _inviteLink = (await DiscordSettings.GetSettingsAsync()).InviteLink;
            }
        }
        catch
        {
            _membership = DiscordMembership.Unknown;
        }
        finally
        {
            _checking = false;
        }
    }

    private void OnFile(InputFileChangeEventArgs e) => _file = e.File;

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            Snackbar.Add("Bitte gib deinen Namen an.", Severity.Warning);
            return;
        }
        if (_model.StreamConsent is null)
        {
            Snackbar.Add("Bitte gib an, ob deine Bewerbung gestreamt werden darf.", Severity.Warning);
            return;
        }
        _busy = true;
        try
        {
            if (_file is not null)
            {
                await using var stream = _file.OpenReadStream(MaxBytes);
                await BewerbungService.SubmitAsync(_model, stream, _file.Name, _file.ContentType, _user, _file.Size);
            }
            else
            {
                await BewerbungService.SubmitAsync(_model, null, null, null, _user);
            }
            Snackbar.Add("Deine Bewerbung wurde eingereicht.", Severity.Success);
            // full reload guarantees the status page re-evaluates the freshly created application
            Nav.NavigateTo("/portal/status", forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            // a refusal for the missing Discord membership then shows its link and buttons
            await CheckMembershipAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
