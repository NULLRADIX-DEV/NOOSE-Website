@page "/buerger/profil"
@layout BuergerLayout
@attribute [AllowAnonymous]
@inject IBuergerService BuergerService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Mein Konto · FIB</PageTitle>

@if (_ready)
{
    <MudPaper Elevation="4" Class="pa-4 pa-sm-8">
        <MudStack Spacing="4">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h4">Mein Konto</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="max-width:620px;">
                    Vor- und Nachname sind für jede Einreichung im öffentlichen Bereich verpflichtend. Gib den Namen
                    an, unter dem du auftrittst — eine Belohnung kann nur an eine benannte Person ausgezahlt werden.
                </MudText>
            </MudStack>

            @if (_locked)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true"
                          Icon="@Icons.Material.Filled.Lock">
                    @BuergerNameRules.LockedMessage
                </MudAlert>
            }
            else
            {
                @if (_isNew)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        @(_mustComplete
                            ? "Bitte vervollständige deine Angaben, um den Bürgerbereich nutzen zu können."
                            : "Ohne diese Angaben kannst du den Bürgerbereich ansehen, aber nichts einreichen.")
                    </MudAlert>
                }
                <MudAlert Severity="Severity.Warning" Variant="Variant.Filled"
                          Icon="@Icons.Material.Filled.WarningAmber">
                    @BuergerNameRules.LockWarning
                </MudAlert>
            }

            @* width-bounded grid, not a flexing row: two name fields in the full 860px shell grew to half the
               viewport each. One column below sm, two above, and never wider than a name needs. *@
            <div style="max-width:640px;">
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_firstName" Label="Vorname" Variant="Variant.Outlined"
                                      MaxLength="64" Immediate="true" Required="true" autocomplete="given-name"
                                      ReadOnly="_locked" Disabled="_locked" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_lastName" Label="Nachname" Variant="Variant.Outlined"
                                      MaxLength="64" Immediate="true" Required="true" autocomplete="family-name"
                                      ReadOnly="_locked" Disabled="_locked" />
                    </MudItem>
                </MudGrid>
            </div>

            @if (!_maySubmit)
            {
                @* SaveOwnAsync holds RequireCitizenSubmission, so the demo visitor can read this page but never
                   save it. An enabled button would only ever produce a red toast. *@
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    Nur-Lese-Modus: In dieser Rolle lässt sich keine Zivil-Identität anlegen oder ändern.
                </MudAlert>
            }
            @if (!_locked && _maySubmit)
            {
                <MudCheckBox T="bool" @bind-Value="_consented" Color="Color.Warning" Dense="true"
                             Label="@BuergerNameRules.LockConsent" />
            }

            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                @if (!_locked)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                               Disabled="@(_saving || !_maySubmit || !_consented)"
                               OnClick="SaveAsync">Namen festlegen</MudButton>
                }
                @if (_locked || !_isNew || !_mustComplete)
                {
                    <MudButton Href="/buerger" Variant="Variant.Text" Color="Color.Default">Zurück</MudButton>
                }
            </MudStack>

            @if (_blocked)
            {
                <MudDivider />
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                    Dieses Konto ist für Einreichungen gesperrt. Wende dich an die Führungsebene.
                </MudAlert>
            }
        </MudStack>
    </MudPaper>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private ClaimsPrincipal _user = default!;
    private bool _ready;
    private bool _saving;
    private bool _isNew;
    private bool _mustComplete;
    private bool _blocked;
    private bool _maySubmit;
    private bool _locked;
    private bool _consented;
    private string _firstName = string.Empty;
    private string _lastName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        if (!_user.MayUseCitizenPortal())
        {
            Nav.NavigateTo("/", forceLoad: true);
            return;
        }

        var profile = await BuergerService.GetOwnAsync(_user);
        _firstName = profile?.FirstName ?? string.Empty;
        _lastName = profile?.LastName ?? string.Empty;
        _blocked = profile?.IsBlocked ?? false;
        _isNew = string.IsNullOrWhiteSpace(_firstName) || string.IsNullOrWhiteSpace(_lastName);
        // the twin of the refusal in BuergerService.SaveOwnAsync; both ask BuergerNameRules
        _locked = BuergerNameRules.IsLocked(profile);
        // only a citizen account is held on this page until the names are there
        _mustComplete = _user.IsCitizen();
        // the twin of RequireCitizenSubmission in BuergerService.SaveOwnAsync: partner and supervision may hold a
        // civilian identity too — they need one for a ticket or a tip — only the demo visitor may not
        _maySubmit = _user.MayCitizenSubmit();
        _ready = true;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            await BuergerService.SaveOwnAsync(_firstName, _lastName, _user);
            Snackbar.Add("Angaben gespeichert.", Severity.Success);
            Nav.NavigateTo("/buerger");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
