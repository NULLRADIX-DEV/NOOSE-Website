@* Opens a citizen ticket to leadership. Under Pages/Portal so the citizen-surface scan covers it too. *@
@inject ITicketService Tickets
@inject ITicketAttachmentStorageService AttachmentStore
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @* no min-width: a 480px floor plus the dialog padding needs 528px, which put the submit button off
           screen on every phone and MudBlazor clamps nothing below its own 600px cap. FullWidth on the options
           below does the sizing, the house pattern of every other dialog here. *@
        <MudStack Spacing="3">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Dein Anliegen geht an die Führungsebene des FIB. Die zuständigen Agenten bleiben dabei anonym;
                du erhältst die Antwort hier im Bürgerbereich.
            </MudText>

            <MudSelect T="TicketKategorie" @bind-Value="_category" Label="Worum geht es?"
                       Variant="Variant.Outlined"
                       ToStringFunc="@(c => TicketKategorieDisplay.Name(c))"
                       HelperText="@TicketKategorieDisplay.Hint(_category)">
                @foreach (var option in TicketKategorieDisplay.All)
                {
                    <MudSelectItem T="TicketKategorie" Value="@option">@TicketKategorieDisplay.Name(option)</MudSelectItem>
                }
            </MudSelect>

            <MudTextField @bind-Value="_subject" Label="Betreff" Variant="Variant.Outlined"
                          MaxLength="@TicketRules.SubjectMaxLength" Immediate="true" />
            <MudTextField @bind-Value="_text" Label="Dein Anliegen" Lines="6" Variant="Variant.Outlined"
                          MaxLength="@TicketRules.MaxMessageLength" Immediate="true" />

            <ImageAttachmentPicker @bind-Picked="_attachment" MaxBytes="@AttachmentStore.MaxBytes"
                                   Disabled="_busy" />

            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Mindestens @TicketRules.SubjectMinLength Zeichen im Betreff und
                @TicketRules.MinLength Zeichen im Text. Höchstens @TicketRules.MaxOpen offene Tickets
                und @TicketRules.PerDay neue Tickets pro Tag.
            </MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_busy || !MayOpen)"
                   OnClick="SubmitAsync" StartIcon="@Icons.Material.Filled.Send">Ticket öffnen</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public ClaimsPrincipal User { get; set; } = default!;

    // the same default the entity and TicketInput carry: an unchanged pick must not claim a crime report and
    // walk off with its priority band. A guess either way - the desk re-files it
    private TicketKategorie _category = TicketKategorie.Sonstiges;
    private string _subject = string.Empty;
    private string _text = string.Empty;
    private ImageAttachmentPicker.PickedImage? _attachment;
    private bool _busy;

    private bool MayOpen => _subject.Trim().Length >= TicketRules.SubjectMinLength
                            && _text.Trim().Length >= TicketRules.MinLength;

    private async Task SubmitAsync()
    {
        _busy = true;
        try
        {
            var upload = _attachment is { } picked
                ? new TicketAttachmentUpload(new MemoryStream(picked.Content), picked.ContentType,
                    picked.OriginalName, picked.Size)
                : null;
            var caseNumber = await Tickets.OpenAsync(
                new TicketInput { Subject = _subject, Text = _text, Category = _category }, User, upload);
            Snackbar.Add($"Ticket {caseNumber} eröffnet.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(caseNumber));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    /// <summary>Shows the form; returns the new case number or null when nothing was opened.</summary>
    public static async Task<string?> ShowAsync(IDialogService dialog, ClaimsPrincipal user)
    {
        var parameters = new DialogParameters<TicketOpenDialog> { { x => x.User, user } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var reference = await dialog.ShowAsync<TicketOpenDialog>("Neues Ticket", parameters, options);
        var result = await reference.Result;
        return result is { Canceled: false, Data: string caseNumber } ? caseNumber : null;
    }
}
