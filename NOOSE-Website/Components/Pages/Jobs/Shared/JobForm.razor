@* Shared create/edit form for a job. *@
@inject IAgentManagementService AgentService
@inject IAbsenceService AbsenceService

<MudGrid>
    <MudItem xs="12">
        <MudTextField @bind-Value="Input.Title" Label="Titel" Required="true" RequiredError="Titel ist erforderlich"
                      Variant="Variant.Outlined" />
    </MudItem>

    <MudItem xs="12" md="4">
        <MudSelect T="JobStatus" @bind-Value="Input.Status" Label="Status" Variant="Variant.Outlined">
            @foreach (var s in JobStatusDisplay.All)
            {
                <MudSelectItem Value="s">@JobStatusDisplay.Name(s)</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudSelect T="JobPriority" @bind-Value="Input.Priority" Label="Priorität" Variant="Variant.Outlined">
            @foreach (var p in JobPriorityDisplay.All)
            {
                <MudSelectItem Value="p">@JobPriorityDisplay.Name(p)</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" md="4">
        @* the sign-offs are read for the due date, so moving it has to move them too *@
        <MudDatePicker @bind-Date="Input.DueDate" @bind-Date:after="ReloadAbsencesAsync"
                       Label="Fälligkeit (optional)" Variant="Variant.Outlined"
                       Clearable="true" Editable="true" DateFormat="dd.MM.yyyy" />
    </MudItem>

    <MudItem xs="12">
        <MudSwitch T="bool" @bind-Value="Input.IsRestricted" Color="Color.Warning"
                   Label="Eingeschränkt (nur zugeteilte Agents, Ersteller und die Leitung sehen die Aufgabe)" />
    </MudItem>

    @if (ShowAssignment)
    {
        <MudItem xs="12">
            <MudSelect T="string" Label="Zuweisen an (optional)" MultiSelection="true"
                       SelectedValues="AgentIds" SelectedValuesChanged="OnAgentsChanged"
                       MultiSelectionTextFunc="@DisplaySelection" Variant="Variant.Outlined"
                       Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.ManageAccounts"
                       HelperText="Zugewiesene Agenten erhalten eine Benachrichtigung.">
                @foreach (var a in _agents)
                {
                    <MudSelectItem T="string" Value="@a.Id">
                        @a.Codename (@DivisionRules.RankName(a))
                        @if (AbsenceHint.For(_absent, a.Id, _reference) is { Length: > 0 } hint)
                        {
                            <span class="mud-text-secondary"> · @hint</span>
                        }
                    </MudSelectItem>
                }
            </MudSelect>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap" Class="mt-1">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Ganze Einheit hinzufügen:</MudText>
                @foreach (var unit in DivisionRules.Seats)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@DivisionRules.Colour(unit)"
                             Icon="@Icons.Material.Filled.GroupAdd" OnClick="@(() => UnitAddAsync(unit))">
                        @DivisionRules.Label(unit) (@UnitMembers(unit).Count())
                    </MudChip>
                }
            </MudStack>
            @* a hint you lose by closing the dropdown is a hint nobody read *@
            @if (SelectedAbsenceNote() is { Length: > 0 } note)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true" Class="mt-1">@note</MudAlert>
            }
        </MudItem>
    }

    <MudItem xs="12">
        <MentionInput Text="@(Input.Description ?? string.Empty)" TextChanged="@(v => Input.Description = v)"
                      DraftKey='@DraftKeys.In(DraftScope, "description")'
                      Label="Beschreibung (optional)" Lines="4"
                      HelperText="@($"Worum geht es bei dieser Aufgabe? {MentionInput.Hint}")" />
    </MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired] public JobInput Input { get; set; } = default!;

    /// <summary>Show multi-assignment (create only).</summary>
    /// <summary>Browser draft scope of the text fields; the editor drops it once the save went through.</summary>
    [Parameter] public string? DraftScope { get; set; }

    [Parameter] public bool ShowAssignment { get; set; }

    /// <summary>Selected agent ids (two-way bound).</summary>
    [Parameter] public IReadOnlyCollection<string> AgentIds { get; set; } = Array.Empty<string>();
    [Parameter] public EventCallback<IReadOnlyCollection<string>> AgentIdsChanged { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private List<Agent> _agents = new();
    private IReadOnlyDictionary<string, DateOnly> _absent = new Dictionary<string, DateOnly>();
    private DateOnly _reference = DateOnly.FromDateTime(DateTime.Now);

    protected override async Task OnInitializedAsync()
    {
        if (ShowAssignment)
        {
            // Active agents without the TeamLead marker, sorted by codename.
            _agents = await AgentService.GetSelectableAsync();
            await ReloadAbsencesAsync();
        }
    }

    /// <summary>Reads the sign-offs for the due date, or for today while none is set.</summary>
    private async Task ReloadAbsencesAsync()
    {
        if (!ShowAssignment)
        {
            return;
        }
        _reference = Input.DueDate is { } due
            ? DateOnly.FromDateTime(due)
            : DateOnly.FromDateTime(DateTime.Now);
        try
        {
            var user = (await AuthStateTask).User;
            _absent = await AbsenceService.GetAbsentOnAsync(_reference, user);
        }
        catch (Exception)
        {
            // a hint is never worth the form; without it the picker simply says nothing
            _absent = new Dictionary<string, DateOnly>();
        }
    }

    private string SelectedAbsenceNote()
        => AbsenceHint.Selected(_absent,
            _agents.Where(a => AgentIds.Contains(a.Id)).Select(a => (a.Id, a.Codename)), _reference);

    private async Task OnAgentsChanged(IReadOnlyCollection<string> values)
    {
        AgentIds = values;
        await AgentIdsChanged.InvokeAsync(values);
    }

    private IEnumerable<string> UnitMembers(OrgUnit unit)
        => _agents.Where(a => DivisionRules.InSeat(a, unit)).Select(a => a.Id);

    /// <summary>Adds today's members of the unit to the selection; later members are not included.</summary>
    private Task UnitAddAsync(OrgUnit unit)
        => OnAgentsChanged(AgentIds.Union(UnitMembers(unit)).ToHashSet());

    private string DisplaySelection(IReadOnlyList<string> ids)
    {
        var names = _agents.Where(a => ids.Contains(a.Id)).Select(a => a.Codename).ToList();
        return names.Count == 0 ? string.Empty : string.Join(", ", names);
    }
}
