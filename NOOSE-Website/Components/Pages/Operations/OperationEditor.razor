@page "/operationen/neu"
@page "/operationen/{Id}/bearbeiten"
@inject IOperationService OperationService
@inject ILinkService LinkService
@inject IFactionService FactionService
@inject IPersonGroupService GroupService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(IsEdit ? "Operation bearbeiten" : "Neue Operation") · FIB</PageTitle>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_input is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        Operation nicht gefunden oder nicht zugänglich.
    </MudAlert>
}
else
{
    @* the shared page header; no handbook link, as the hand-built title it replaces had none *@
    <PageHeader Icon="@(IsEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.Radar)" Title="@(IsEdit ? "Operation bearbeiten" : "Neue Operation anlegen")" BackHref="@BackHref" ShowHelp="false" />

    @if (!IsEdit && _prelinkName is not null)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
            Wird nach dem Anlegen mit „@_prelinkName“ verknüpft.
        </MudAlert>
    }
    <MudForm @ref="_form">
        <OperationForm DraftScope="@DraftScope" @key="_loadedId" Input="_input" ShowClassification="@(!IsEdit)" MayHighest="_mayHighest"
                       IsLeadership="_isLeadership" SecrecyOptions="_secrecyOptions" />
    </MudForm>
    @if (IsEdit)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
            Hinweis: Die Einstufung wird in der Akte unter „Einstufung" geändert (mit Verlauf und Rang-Prüfung).
        </MudText>
    }

    <FormActions Justify="Justify.FlexStart" Class="mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAsync" Disabled="_saves">@(IsEdit ? "Speichern" : "Anlegen")</MudButton>
        <MudButton Variant="Variant.Text" Href="@BackHref">Abbrechen</MudButton>
    </FormActions>
}

@code {
    [Parameter] public string? Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;
    /// <summary>Faction to link on create, e.g. from the deployments tab of a faction.</summary>
    [SupplyParameterFromQuery(Name = "fraktion")] public string? FactionId { get; set; }
    /// <summary>Person group to link on create.</summary>
    [SupplyParameterFromQuery(Name = "personengruppe")] public string? GroupId { get; set; }

    private string? _prelinkName;

    // RouteView only supplies the matched template's route values, so a stale Id survives bearbeiten -> neu
    private bool IsEdit { get; set; }
    private string BackHref => IsEdit ? $"/operationen/{Id}" : "/operationen";

    private MudForm _form = default!;
    private OperationInput? _input;
    private ClaimsPrincipal _user = default!;

    // one scope for every text field of the form; dropped once the save went through
    private string DraftScope => IsEdit ? $"operation:{Id}" : "operation:neu";
    private bool _mayHighest;
    private bool _isLeadership;
    private bool _load = true;
    private bool _saves;
    private string? _loadedId;
    // level as loaded; loosening it asks for a reason
    private DocumentClassification _loadedSecrecy;
    private IReadOnlyList<DocumentClassification> _secrecyOptions = Array.Empty<DocumentClassification>();

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _mayHighest = _user.MayHighestClassification();
        _isLeadership = _user.IsLeadership();
        _secrecyOptions = DocumentViewerScope.AssignableOptions(_user);
    }

    // both routes bind the same component, so Blazor reuses the instance across neu ↔ bearbeiten
    protected override async Task OnParametersSetAsync()
    {
        IsEdit = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0]
            .EndsWith("/bearbeiten", StringComparison.OrdinalIgnoreCase);
        var key = IsEdit ? Id ?? string.Empty : string.Empty;
        if (_loadedId == key)
        {
            return;
        }
        _loadedId = key;
        _load = true;
        _input = null;

        if (!IsEdit)
        {
            _input = new OperationInput();
            _prelinkName = await PrelinkNameAsync();
            _load = false;
            return;
        }

        var o = await OperationService.GetDetailAsync(Id!, ViewerScope.From(_user));
        if (o is not null)
        {
            _input = new OperationInput
            {
                Title = o.Title,
                Type = o.Type,
                Status = o.Status,
                Location = o.Location,
                Start = o.Start?.ToLocalTime(),
                End = o.End?.ToLocalTime(),
                Expiry = o.Expiry,
                Result = o.Result,
                Remarks = o.Remarks,
                Legitimation = o.Legitimation,
                InvolvedAgencies = o.InvolvedAgencies,
                Evidence = o.Evidence,
                Classification = o.Classification,
                SecrecyLevel = o.SecrecyLevel,
            };
        }
        _loadedSecrecy = _input?.SecrecyLevel ?? DocumentClassification.None;
        _load = false;
    }

    private (string Type, string Id)? Prelink => (FactionId, GroupId) switch
    {
        ({ Length: > 0 } f, _) => (nameof(Faction), f),
        (_, { Length: > 0 } g) => (nameof(PersonGroup), g),
        _ => null,
    };

    // shown before saving, so the agent sees what the record will hang on
    private async Task<string?> PrelinkNameAsync()
    {
        if (Prelink is not { } p)
        {
            return null;
        }
        try
        {
            var scope = ViewerScope.From(_user);
            return p.Type == nameof(Faction)
                ? (await FactionService.GetDetailAsync(p.Id, scope))?.Name
                : (await GroupService.GetDetailAsync(p.Id, scope))?.Name;
        }
        catch
        {
            return null; /* best effort */
        }
    }

    private async Task PrelinkAsync(string operationId)
    {
        if (Prelink is not { } p || _prelinkName is null)
        {
            return;
        }
        try
        {
            await LinkService.CreateAsync(nameof(Operation), operationId, p.Type, p.Id, null, _user,
                allowedTargetTypes: NOOSE_Website.Services.LinkService.InvolvedTypes);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Verknüpfung nicht gespeichert: {ex.Message}", Severity.Warning);
        }
    }

    private async Task SaveAsync()
    {
        if (_input is null)
        {
            return;
        }
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        if (IsEdit)
        {
            var secrecyReason = await CriticalReasonPrompt.SecrecyAsync(DialogService, _loadedSecrecy, _input.SecrecyLevel);
            if (secrecyReason is null)
            {
                return;
            }
            _input.SecrecyReason = secrecyReason;
        }

        _saves = true;
        try
        {
            if (IsEdit)
            {
                await OperationService.RefreshAsync(Id!, _input, _user);
                await TextDraft.DiscardScopeAsync(JS, _user.GetAgentId(), DraftScope);
                Snackbar.Add("Änderungen gespeichert.", Severity.Success);
                Nav.NavigateTo($"/operationen/{Id}");
            }
            else
            {
                var operation = await OperationService.CreateAsync(_input, _user);
                await TextDraft.DiscardScopeAsync(JS, _user.GetAgentId(), DraftScope);
                await PrelinkAsync(operation.Id);
                Snackbar.Add($"Operation {operation.CaseNumber} angelegt.", Severity.Success);
                Nav.NavigateTo($"/operationen/{operation.Id}");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _saves = false;
        }
    }
}
