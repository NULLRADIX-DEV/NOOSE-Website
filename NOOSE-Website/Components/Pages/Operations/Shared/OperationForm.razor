@* Shared create/edit form for an operation. *@
@inject IProfileSuggestionService SuggestionService

<MudGrid>
    <MudItem xs="12">
        <MudTextField @bind-Value="Input.Title" Label="Titel" Required="true" RequiredError="Titel ist erforderlich"
                      Variant="Variant.Outlined" />
    </MudItem>

    <MudItem xs="12" md="6">
        <MudAutocomplete T="string" @bind-Value="Input.Type" Label="Typ / Kategorie (optional)"
                         SearchFunc="@TypeSearch" Variant="Variant.Outlined"
                         CoerceText="false" CoerceValue="true" ResetValueOnEmptyText="false"
                         MinCharacters="0" Immediate="true" MaxItems="20" Clearable="true"
                         Placeholder="z. B. Razzia, Observation, Infiltration" />
    </MudItem>
    <MudItem xs="12" md="6">
        <MudSelect T="OperationStatus" @bind-Value="Input.Status" Label="Status" Variant="Variant.Outlined">
            @foreach (var s in OperationStatusDisplay.All)
            {
                <MudSelectItem Value="s">@OperationStatusDisplay.Name(s)</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="7" md="3">
        <MudDatePicker @bind-Date="StartDate" Label="Beginn" Variant="Variant.Outlined"
                       Clearable="true" Editable="true" DateFormat="dd.MM.yyyy" />
    </MudItem>
    <MudItem xs="12" sm="5" md="3">
        <MudTimePicker @bind-Time="StartTime" Label="Uhrzeit" Variant="Variant.Outlined" AmPm="false"
                       Disabled="@(Input.Start is null)" />
    </MudItem>
    <MudItem xs="12" sm="7" md="3">
        <MudDatePicker @bind-Date="EndDate" Label="Ende (optional)" Variant="Variant.Outlined"
                       Clearable="true" Editable="true" DateFormat="dd.MM.yyyy" />
    </MudItem>
    <MudItem xs="12" sm="5" md="3">
        <MudTimePicker @bind-Time="EndTime" Label="Uhrzeit" Variant="Variant.Outlined" AmPm="false"
                       Disabled="@(Input.End is null)" />
    </MudItem>

    <MudItem xs="12" md="6">
        <MudTextField @bind-Value="Input.Location" Label="Ort (optional)" Variant="Variant.Outlined"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Place" />
    </MudItem>

    @if (ShowClassification)
    {
        <MudItem xs="12" md="6">
            <MudSelect T="Classification" @bind-Value="Input.Classification" Label="Einstufung" Variant="Variant.Outlined">
                @foreach (var e in ClassificationDisplay.All)
                {
                    <MudSelectItem Value="e" Disabled="@(e == Classification.SecuredStateThreatening && !MayHighest)">
                        @ClassificationDisplay.Name(e)
                    </MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    }
    @if (SecrecyOptions.Count > 1)
    {
        <MudItem xs="12" md="6">
            <MudSelect T="DocumentClassification" @bind-Value="Input.SecrecyLevel" Label="Verschluss-Stufe"
                       Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock"
                       HelperText="Bestimmt, wer die Akte sehen darf.">
                @foreach (var o in SecrecyOptions)
                {
                    <MudSelectItem T="DocumentClassification" Value="@o">@DocumentClassificationDisplay.Label(o)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    }

    <MudItem xs="12">
        <MentionInput Text="@(Input.InvolvedAgencies ?? string.Empty)" TextChanged="@(v => Input.InvolvedAgencies = v)"
                      DraftKey='@DraftKeys.In(DraftScope, "agencies")'
                      Label="Beteiligte Behörden (optional)" Lines="1" MaxLength="1000"
                      HelperText="@($"z. B. LSPD, National Guard. {MentionInput.Hint}")" />
    </MudItem>
    <MudItem xs="12">
        <MentionInput Text="@(Input.Legitimation ?? string.Empty)" TextChanged="@(v => Input.Legitimation = v)"
                      DraftKey='@DraftKeys.In(DraftScope, "legitimation")'
                      Label="Legitimation" Lines="2" MaxLength="2000"
                      HelperText="Begründung zur Teilnahme. Pflicht nach §4.6.2, wenn das FIB an der Einsatzlage einer anderen Behörde teilnimmt." />
    </MudItem>
    <MudItem xs="12">
        <MentionInput Text="@(Input.Expiry ?? string.Empty)" TextChanged="@(v => Input.Expiry = v)"
                      DraftKey='@DraftKeys.In(DraftScope, "expiry")'
                      Label="Ablauf / Sachverhalt" Lines="4"
                      HelperText="@($"Was ist passiert? Läuft ein Einsatztagebuch, übernimmst du es in der Akte per Knopf. {MentionInput.Hint}")" />
    </MudItem>
    <MudItem xs="12">
        <MentionInput Text="@(Input.Evidence ?? string.Empty)" TextChanged="@(v => Input.Evidence = v)"
                      DraftKey='@DraftKeys.In(DraftScope, "evidence")'
                      Label="Beweismittel (optional)" Lines="3" MaxLength="4000"
                      HelperText="Sichergestellte Waffen, Munition, Gegenstände, am besten je Person." />
    </MudItem>
    <MudItem xs="12">
        <MentionInput Text="@(Input.Result ?? string.Empty)" TextChanged="@(v => Input.Result = v)"
                      DraftKey='@DraftKeys.In(DraftScope, "result")'
                      Label="Ergebnis / Abschlussvermerk" Lines="3" HelperText="Wie ist der Einsatz ausgegangen?" />
    </MudItem>
    <MudItem xs="12">
        <MentionInput Text="@(Input.Remarks ?? string.Empty)" TextChanged="@(v => Input.Remarks = v)"
                      DraftKey='@DraftKeys.In(DraftScope, "remarks")'
                      Label="Bemerkungen" Lines="3"
                      HelperText="Fahrzeuge, Forderungen und alles, was sonst nirgends hingehört." />
    </MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired] public OperationInput Input { get; set; } = default!;
    /// <summary>Show classification in the form (create only).</summary>
    /// <summary>Browser draft scope of the text fields; the editor drops it once the save went through.</summary>
    [Parameter] public string? DraftScope { get; set; }

    [Parameter] public bool ShowClassification { get; set; }
    [Parameter] public bool MayHighest { get; set; }
    [Parameter] public bool IsLeadership { get; set; }
    /// <summary>Secrecy levels the current user may assign (DocumentViewerScope.AssignableOptions).</summary>
    [Parameter] public IReadOnlyList<DocumentClassification> SecrecyOptions { get; set; } = Array.Empty<DocumentClassification>();

    private IReadOnlyList<string> _typeSuggestions = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        var types = await SuggestionService.GetAsync(SuggestionType.OperationType);
        // the kinds the activity reports used, so a deployment keeps its familiar name
        var kinds = await SuggestionService.GetActivityKindsAsync();
        _typeSuggestions = OperationTypeSuggestions.Merge(types, kinds.Select(k => k.Value));
    }

    // date and time edit one value; picking a date keeps the time, clearing it clears both
    private DateTime? StartDate
    {
        get => Input.Start?.Date;
        set => Input.Start = value is { } d ? d.Date + (Input.Start?.TimeOfDay ?? TimeSpan.Zero) : null;
    }

    private TimeSpan? StartTime
    {
        get => Input.Start?.TimeOfDay;
        set => Input.Start = Input.Start is { } d ? d.Date + (value ?? TimeSpan.Zero) : null;
    }

    private DateTime? EndDate
    {
        get => Input.End?.Date;
        set => Input.End = value is { } d ? d.Date + (Input.End?.TimeOfDay ?? TimeSpan.Zero) : null;
    }

    private TimeSpan? EndTime
    {
        get => Input.End?.TimeOfDay;
        set => Input.End = Input.End is { } d ? d.Date + (value ?? TimeSpan.Zero) : null;
    }

    private Task<IEnumerable<string>> TypeSearch(string value, CancellationToken token)
    {
        IEnumerable<string> hit = string.IsNullOrWhiteSpace(value)
            ? _typeSuggestions
            : _typeSuggestions.Where(v => v.Contains(value.Trim(), StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(hit);
    }
}
