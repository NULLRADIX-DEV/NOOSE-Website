@* Identity card for an operation.
   Below 960px the card shrinks to a compact head (noose-steckbrief-* in app.css): 64px picture beside the name, the
   markers in one wrapping row, the rest behind "Details". The wrappers repeat MudStack's gap-3 column, so from 960px
   up the card renders as before. *@
<MudPaper Class="pa-4 noose-steckbrief" Elevation="2">
    <MudStack Spacing="3">
        <div class="d-flex flex-column gap-3 noose-steckbrief-kopf">
        <MudStack AlignItems="AlignItems.Center" Class="py-2 noose-steckbrief-bild">
            <MudAvatar Color="Color.Primary" Rounded="true" Style="height:120px;width:120px;">
                <MudIcon Icon="@Icons.Material.Filled.Radar" Style="font-size:3rem;" />
            </MudAvatar>
        </MudStack>

        <div class="noose-steckbrief-name">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.h5">@Operation.Title</MudText>
                @if (Operation.IsClassified)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" Size="Size.Small" Title="@DocumentClassificationDisplay.Label(Operation.SecrecyLevel)" />
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@DocumentClassificationDisplay.ChipLabel(Operation.SecrecyLevel)</MudChip>
                }
            </MudStack>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Operation.CaseNumber</MudText>
        </div>
        </div>

        <div class="d-flex flex-column gap-3 noose-steckbrief-kennzeichen">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
            <OperationStatusChip Status="Operation.Status" />
            @if (!string.IsNullOrWhiteSpace(Operation.Type))
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@Operation.Type</MudChip>
            }
        </MudStack>

        <ClassificationBadge Value="Operation.Classification" />
        </div>

        <div class="@RestClass">
        <InvestigationLeadDisplay Names="InvestigationLead" />

        <MudDivider />

        @if (Operation.Start is not null || Operation.End is not null)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Color="Color.Default" />
                <MudText Typo="Typo.body2">@TimeRange</MudText>
            </MudStack>
        }
        @if (!string.IsNullOrWhiteSpace(Operation.Location))
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Color="Color.Default" />
                <MudText Typo="Typo.body2">@Operation.Location</MudText>
            </MudStack>
        }

        <MudDivider />

        <MudStack Spacing="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <RecencyIndicator Level="@(RecencyAssessment.NeverAges(Operation.AgingDisabled, Operation.IsArchived) ? RecencyLevel.Fresh : (RecencyLevel?)null)"
                                  RecordsType="@nameof(Operation)" ReferenceDateUtc="@(Operation.ModifiedAt ?? Operation.CreatedAt)" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Zuletzt aktualisiert: @((Operation.ModifiedAt ?? Operation.CreatedAt).ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                </MudText>
            </MudStack>
            <AuthorizeView Policy="@Policies.Leadership">
                <MudSwitch T="bool" Value="Operation.AgingDisabled" ValueChanged="ToggleAgingAsync"
                           Color="Color.Info" Size="Size.Small" Label="Veralterung deaktiviert" />
            </AuthorizeView>
        </MudStack>
        </div>
        <MudButton Variant="Variant.Text" Size="Size.Small" Class="noose-nur-schmal align-self-start"
                   EndIcon="@(_details ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                   OnClick="@(() => _details = !_details)" aria-expanded="@(_details ? "true" : "false")">
            @(_details ? "Weniger" : "Details")
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired] public Operation Operation { get; set; } = default!;

    /// <summary>Investigation lead codenames.</summary>
    [Parameter] public IReadOnlyList<string> InvestigationLead { get; set; } = Array.Empty<string>();

    [Parameter] public ClaimsPrincipal? User { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    // below 960px everything after the markers starts folded behind "Details"; the class does nothing from 960px up
    private bool _details;

    private string RestClass => _details
        ? "d-flex flex-column gap-3 noose-steckbrief-rest"
        : "d-flex flex-column gap-3 noose-steckbrief-rest noose-steckbrief-zu";

    [Inject] private IRecencyService Recency { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    /// <summary>Toggle this record's aging exemption.</summary>
    private async Task ToggleAgingAsync(bool value)
    {
        if (User is null)
        {
            return;
        }
        try
        {
            await Recency.SetRecordExemptionAsync(nameof(Operation), Operation.Id, value, User);
            Snackbar.Add(value ? "Veralterung für diese Akte deaktiviert." : "Veralterung wieder aktiv.", Severity.Success);
            await Changed.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            StateHasChanged();
        }
    }

    private string TimeRange
    {
        get
        {
            var source = Operation.Start?.ToLocalTime().ToString("dd.MM.yyyy HH:mm");
            var until = Operation.End?.ToLocalTime().ToString("dd.MM.yyyy HH:mm");
            return (source, until) switch
            {
                (not null, not null) => $"{source} – {until}",
                (not null, null) => $"ab {source}",
                (null, not null) => $"bis {until}",
                _ => "—",
            };
        }
    }
}
