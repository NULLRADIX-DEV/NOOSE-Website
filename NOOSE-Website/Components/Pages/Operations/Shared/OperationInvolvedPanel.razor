@* People and organisations involved in an operation; agents are handled separately. *@
@inject ILinkService LinkService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.subtitle1">Beteiligte Personen &amp; Organisationen (@_list.Count)</MudText>
        @if (User.MayWrite())
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddLink" OnClick="AddAsync">
                Beteiligten hinzufügen
            </MudButton>
        }
    </MudStack>

    @if (_load)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_list.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Noch keine Beteiligten erfasst. (Agents werden im Tab „Beteiligte Agents" zugeteilt.)
        </MudText>
    }
    else
    {
        @foreach (var v in _list.OrderBy(v => Rank(v)).ThenBy(v => v.OtherDesignation))
        {
            <MudPaper Class="pa-3" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@TypeIcon(v.OtherType)" Color="Color.Primary" Size="Size.Small" />
                        @if (v.Href is not null)
                        {
                            <MudLink Href="@v.Href" Typo="Typo.body2"><b>@v.OtherDesignation</b></MudLink>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2"><b>@v.OtherDesignation</b></MudText>
                        }
                        @if (!string.IsNullOrWhiteSpace(v.Label))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">@v.Label</MudChip>
                        }
                    </MudStack>
                    @if (User.MayWrite())
                    {
                        <MudStack Row="true" Spacing="0">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                           OnClick="@(() => EditRoleAsync(v))"
                                           aria-label="@(v.OtherType == nameof(Person) ? "Rolle ändern" : "Notiz ändern")" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => RemoveAsync(v))" aria-label="Beteiligten entfernen" />
                        </MudStack>
                    }
                </MudStack>
            </MudPaper>
        }
    }
</MudStack>

@code {

    /// <summary>The types this panel offers; the same list goes to the picker and to the service.</summary>
    // qualified: the injected property shadows the class name
    private static readonly IReadOnlyList<string> OrgTypes = NOOSE_Website.Services.LinkService.InvolvedTypes;
    [Parameter, EditorRequired] public string OperationId { get; set; } = default!;
    [Parameter, EditorRequired] public ClaimsPrincipal User { get; set; } = default!;

    private bool _load = true;
    private List<LinkDisplay> _list = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _load = true;
        _list = await LinkService.GetForRecordAsync(nameof(Operation), OperationId, ViewerScope.From(User), LinkKind.Default);
        _load = false;
    }

    private async Task AddAsync()
    {
        // Exclude already-involved targets and self.
        var choice = await LinkDialog.ShowAsync(DialogService, User.IsLeadership(), sourceType: nameof(Operation),
            allowedTypes: OrgTypes,
            excluded: LinkDialog.Exclusions(_list, nameof(Operation), OperationId),
            designation: "Beteiligten",
            labelCaption: "Notiz (optional)",
            labelPlaceholder: "z. B. Hauptgruppierung, Unterstützer");
        if (choice is null)
        {
            return;
        }
        try
        {
            await LinkService.CreateAsync(nameof(Operation), OperationId, choice.TargetType, choice.TargetId, choice.Label, User, LinkKind.Default,
                allowedTargetTypes: OrgTypes);
            Snackbar.Add("Beteiligter gespeichert.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RemoveAsync(LinkDisplay v)
    {
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Beteiligten entfernen?",
            $"Die Beziehung zu „{v.OtherDesignation}“ wird entfernt.");
        if (!ok)
        {
            return;
        }
        await LinkService.RemoveAsync(v.LinkId, User);
        Snackbar.Add("Beteiligter entfernt.", Severity.Success);
        await LoadAsync();
    }

    private static string TypeIcon(string type) => RecordTypeDisplay.Icon(type);

    // organisations first, then accused, victims, everyone else
    private static int Rank(LinkDisplay v) => v.OtherType != nameof(Person) ? 0
        : OperationInvolvedRoles.Group(v.Label) switch
        {
            OperationRoleGroup.Accused => 1,
            OperationRoleGroup.Victim => 2,
            _ => 3,
        };

    private async Task EditRoleAsync(LinkDisplay v)
    {
        if (await LinkLabelEditDialog.ShowAsync(DialogService, v, v.OtherType == nameof(Person), nameof(Operation)))
        {
            await LoadAsync();
        }
    }
}
