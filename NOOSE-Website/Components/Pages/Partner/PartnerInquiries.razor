@* A partner agency asks for records it cannot see yet and follows the answers. *@
@page "/anfragen"
@using NOOSE_Website.Models.Navigation
@inject IPartnerShareService Shares
@inject ISnackbar Snackbar

<PageTitle>Freigaben anfragen · FIB</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.RequestPage" Title="Freigaben anfragen"
            Subtitle="Nenne eine Person, Fraktion oder einen Vorgang, den deine Behörde sehen möchte. Die Führung des FIB entscheidet." />

@if (!_isPartner)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Anfragen stellen Partnerbehörden. Interne Freigaben laufen über die Akte selbst.</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-6" Elevation="2">
        <MudTextField @bind-Value="_target" Label="Wen oder was möchtet ihr sehen?" Variant="Variant.Outlined" Immediate="true"
                      MaxLength="256" Counter="256" Class="mb-3" />
        <MudTextField @bind-Value="_justification" Label="Begründung" Variant="Variant.Outlined" Immediate="true"
                      Lines="2" MaxLength="2000" />
        <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send"
                   Disabled="@(_busy || string.IsNullOrWhiteSpace(_target) || string.IsNullOrWhiteSpace(_justification))"
                   OnClick="SubmitAsync">Anfrage senden</MudButton>
    </MudPaper>

    <MudText Typo="Typo.h6" Class="mb-2">Eure Anfragen</MudText>
    @* phones only: which columns of the list stay visible *@
    <MobileColumnPicker ListKey="freigabe-anfragen" Columns="PhoneColumns" Defaults="PhoneDefaults"
                        VisibleChanged="@(v => _phoneColumns = v)" />
    @if (_mine.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Filled.RequestPage" Title="Noch keine Anfragen" />
    }
    else
    {
        <MudTable Items="_mine" Hover="true" Dense="true" Breakpoint="Breakpoint.None" Elevation="2">
            <HeaderContent>
                <MudTh Class="@Col("anfrage")">Anfrage</MudTh>
                <MudTh Class="@Col("gestellt")">Gestellt</MudTh>
                <MudTh Class="@Col("stand")">Stand</MudTh>
                <MudTh Class="@Col("antwort")">Antwort</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Anfrage" Class="@Col("anfrage")">@context.TargetDesignation</MudTd>
                <MudTd DataLabel="Gestellt" Class="@Col("gestellt")">@context.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudTd>
                <MudTd DataLabel="Stand" Class="@Col("stand")">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@StatusColour(context.Status)">@StatusName(context.Status)</MudChip>
                </MudTd>
                <MudTd DataLabel="Antwort" Class="@Col("antwort")">
                    @if (context.Status == RequestStatus.Approved && SearchNavigation.For(context.TargetType, context.TargetId) is { } href)
                    {
                        <MudLink Href="@href">Zur freigegebenen Akte</MudLink>
                    }
                    @if (!string.IsNullOrWhiteSpace(context.DecisionNote))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@context.DecisionNote</MudText>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private ClaimsPrincipal _user = default!;
    private bool _isPartner;
    private bool _busy;
    private string? _target;
    private string? _justification;
    private List<Request> _mine = new();

    /// <summary>The list's columns for the phone column picker, in table order.</summary>
    private static readonly IReadOnlyList<(string Key, string Label)> PhoneColumns =
    [
        ("anfrage", "Anfrage"), ("gestellt", "Gestellt"), ("stand", "Stand"), ("antwort", "Antwort"),
    ];

    /// <summary>What a phone shows until the agent chooses: the request, its state and the way to the record.</summary>
    private static readonly IReadOnlyList<string> PhoneDefaults = ["anfrage", "stand", "antwort"];

    // the defaults until the picker reports the stored choice, so the first paint is already narrow
    private IReadOnlySet<string> _phoneColumns = MobileColumnSet.Resolve(PhoneColumns.Select(c => c.Key).ToList(), PhoneDefaults, null);

    // below 600px only; from 600px up every column shows, as before
    private string Col(string key) => MobileColumnSet.ClassFor(_phoneColumns, key);

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _isPartner = _user.IsPartner();
        if (_isPartner)
        {
            _mine = await Shares.GetMyPartnerInquiriesAsync(_user);
        }
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        try
        {
            await Shares.SubmitPartnerInquiryAsync(_user, _target ?? string.Empty, _justification ?? string.Empty);
            Snackbar.Add("Anfrage gesendet. Ihr bekommt Bescheid, sobald sie entschieden ist.", Severity.Success);
            _target = null;
            _justification = null;
            _mine = await Shares.GetMyPartnerInquiriesAsync(_user);
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string StatusName(RequestStatus status) => status switch
    {
        RequestStatus.Approved => "Freigegeben",
        RequestStatus.Rejected => "Abgelehnt",
        _ => "Offen",
    };

    private static Color StatusColour(RequestStatus status) => status switch
    {
        RequestStatus.Approved => Color.Success,
        RequestStatus.Rejected => Color.Error,
        _ => Color.Info,
    };
}
