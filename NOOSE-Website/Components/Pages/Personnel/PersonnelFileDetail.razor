@page "/personal/{AgentId}"
@inject IAgentManagementService AgentService
@inject NavigationManager Nav
@inject INavPreferencesService NavPrefs
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@(_agent?.Codename ?? "Personalakte") · NOOSE</PageTitle>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_agent is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Agent nicht gefunden.</MudAlert>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/personal" aria-label="Zurück" />
        <MudText Typo="Typo.h5">Personalakte</MudText>
        @* Personnel files count as leadership-only content. *@
        @if (_isLeadership)
        {
            <MudSpacer />
            <MudTooltip Text="Druckansicht – Akte drucken / als PDF speichern">
            <MudIconButton Icon="@Icons.Material.Filled.Print" Color="Color.Default"
                           Href="@($"/personal/{AgentId}/druck")" Target="_blank"
                           aria-label="Druckansicht öffnen" />
        </MudTooltip>
            <FollowButton EntityType="@nameof(Agent)" EntityId="@_agent.Id" User="_user" />
            <JobCreateButton EntityType="@nameof(Agent)" EntityId="@_agent.Id" />
            @if (_agent.Status == AgentStatus.Terminated && _mayWrite)
            {
                <MudButton StartIcon="@Icons.Material.Filled.RestoreFromTrash" Color="Color.Success"
                           Variant="Variant.Outlined" Size="Size.Small" OnClick="TerminationRevoke">
                    Kündigung zurücknehmen
                </MudButton>
            }
            else if (_mayTerminate)
            {
                <MudButton StartIcon="@Icons.Material.Filled.PersonRemove" Color="Color.Error"
                           Variant="Variant.Outlined" Size="Size.Small" OnClick="Terminate">
                    Kündigen
                </MudButton>
            }
        }
    </MudStack>

    @if (_agent.Status == AgentStatus.Terminated)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Icon="@Icons.Material.Filled.PersonOff" Class="mb-4">
            <MudText Typo="Typo.subtitle2">
                Gekündigt am @(_agent.TerminatedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")
                @(string.IsNullOrWhiteSpace(_agent.TerminatedByName) ? "" : $" durch {_agent.TerminatedByName}")
            </MudText>
            @if (_isLeadership && !string.IsNullOrWhiteSpace(_agent.TerminationReason))
            {
                <MudText Typo="Typo.body2" Class="mt-1">@_agent.TerminationReason</MudText>
            }
        </MudAlert>
    }

    <div class="mb-3">
        <CompromisedBadge EntityType="@nameof(Agent)" EntityId="@_agent.Id" />
    </div>

    @* outside the tab strip: another URL-synced control would collide on ?tab= *@
    @if (_onboardingTotal > 0)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Flag" Size="Size.Small"
                     Color="@(_onboardingDone == _onboardingTotal ? Color.Success : Color.Default)" />
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Einarbeitung: @_onboardingDone von @_onboardingTotal Schritten
            </MudText>
            <MudProgressLinear Value="@(_onboardingDone * 100.0 / _onboardingTotal)" Size="Size.Small"
                               Color="@(_onboardingDone == _onboardingTotal ? Color.Success : Color.Primary)"
                               Style="max-width:180px;" />
        </MudStack>
    }


    <MudGrid>
        <MudItem xs="12" md="4" lg="3">
            <div class="akte-steckkarte">
                <AgentProfileCard Agent="_agent" MayRealName="_mayRealName"
                                  MayRemove="@(_isLeadership && _user.MayWrite())" OnRemove="AvatarRemove" />
            </div>
        </MudItem>

        <MudItem xs="12" md="8" lg="9">
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4"
                     @bind-ActivePanelIndex="_activeTab"
                     @bind-ActivePanelIndex:after="@(() => TabUrlState.WriteAsync(JS, Nav, _tabs, _activeTab))">
                <MudTabPanel Text="Dienstgrad-Verlauf" Icon="@Icons.Material.Filled.TrendingUp">
                    <RankHistoryPanel AgentId="@_agent.Id" @key="_reloadKey" />
                </MudTabPanel>
                <MudTabPanel Text="Vermerke" Icon="@Icons.Material.Filled.Description">
                    <NotesPanel AgentId="@_agent.Id" />
                </MudTabPanel>
                <MudTabPanel Text="Beförderungen" Icon="@Icons.Material.Filled.MilitaryTech">
                    <PromotionPanel Agent="_agent" Changed="TargetDecisionAsync" />
                </MudTabPanel>
                <MudTabPanel Text="Finanzierung" Icon="@Icons.Material.Filled.RequestQuote">
                    <FinancingAgentPanel Agent="_agent" @key="_reloadKey" />
                </MudTabPanel>
                <MudTabPanel Text="KI-Kontingent" Icon="@Icons.Material.Filled.Token">
                    <LlmQuotaAgentPanel Agent="_agent" @key="_reloadKey" />
                </MudTabPanel>
                <MudTabPanel Text="Module" Icon="@Icons.Material.Filled.School">
                    <ModulesPanel AgentId="@_agent.Id" MayMark="@AgentSelection.IsSelectable(_agent)" />
                    @if (_isHrbOrLeadership)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-6 mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Quiz" Color="Color.Primary" />
                            <MudText Typo="Typo.h6">Interne Tests</MudText>
                        </MudStack>
                        <AgentTestHistoryPanel AgentId="@_agent.Id" />
                    }
                </MudTabPanel>
                <MudTabPanel Text="Auszeichnungen" Icon="@Icons.Material.Filled.EmojiEvents">
                    <DecorationsPanel Agent="_agent" />
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-6 mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">Abzeichen</MudText>
                    </MudStack>
                    <AgentBadgesPanel AgentId="@_agent.Id" />
                </MudTabPanel>
                <MudTabPanel Text="Entführungen" Icon="@Icons.Material.Filled.PersonOff">
                    <AbductionsPanel VictimAgentId="@_agent.Id" />
                </MudTabPanel>
                @if (_isLeadership)
                {
                    <MudTabPanel Text="Kommentare" Icon="@Icons.Material.Filled.Comment">
                        <CommentPanel EntityType="@nameof(Agent)" EntityId="@_agent.Id" User="_user" />
                    </MudTabPanel>
                }
            </MudTabs>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public string AgentId { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;
    private bool _isLeadership;
    private bool _isHrbOrLeadership;
    private int _onboardingDone;
    private int _onboardingTotal;
    private bool _mayRealName;
    private bool _mayWrite;
    private Agent? _agent;
    private ClaimsPrincipal _user = default!;
    private Guid _reloadKey = Guid.NewGuid();
    private string? _loadedId;

    private int _activeTab;
    // Order must match the MudTabPanels; comments tab is leadership-only
    private string[] _tabs = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _isLeadership = _user.IsLeadership();
        _isHrbOrLeadership = _user.IsHrbOrLeadership();
        _mayRealName = _user.MayRealNameSee();
        _mayWrite = _user.MayWrite();
        _tabs = _isLeadership
            ? new[] { "verlauf", "vermerke", "befoerderungen", "finanzierung", "ki-kontingent", "module", "auszeichnungen", "entfuehrungen", "kommentare" }
            : new[] { "verlauf", "vermerke", "befoerderungen", "finanzierung", "ki-kontingent", "module", "auszeichnungen", "entfuehrungen" };
    }

    // Component is reused across /personal/{A}→{B}; react to AgentId change since OnInitialized won't rerun
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == AgentId)
        {
            return;
        }
        _loadedId = AgentId;
        _load = true;
        _agent = null;
        _activeTab = TabUrlState.Read(Nav, _tabs);
        _agent = await AgentService.FindAsync(AgentId);
        await LoadOnboardingAsync();
        _load = false;
    }

    /// <summary>Progress through the first steps, for the people who look after new agents.</summary>
    /// <remarks>
    /// Costs nothing beyond the preferences row, which is cached per agent. A read error is indistinguishable
    /// from a fresh account here - both answer "0 of 6" - because the preferences service returns defaults
    /// rather than throwing.
    /// </remarks>
    private async Task LoadOnboardingAsync()
    {
        _onboardingDone = 0;
        _onboardingTotal = 0;
        // internal, active accounts only: a partner or a departed account has no first steps to take
        if (!_isHrbOrLeadership || _agent is null || !AgentSelection.IsSelectable(_agent))
        {
            return;
        }
        try
        {
            var prefs = await NavPrefs.GetAsync(_agent.Id);
            _onboardingDone = Onboarding.DoneCount(prefs);
            _onboardingTotal = Onboarding.TotalCount(prefs);
        }
        catch
        {
            /* best effort */
        }
    }

    private async Task TargetDecisionAsync()
    {
        // Approved promotion changes rank; reload agent + history
        _agent = await AgentService.FindAsync(AgentId);
        _reloadKey = Guid.NewGuid();
        StateHasChanged();
    }

    // Self, applicants, the already-terminated and the read-only supervision are excluded
    private bool _mayTerminate => _mayWrite
                                  && _agent is { Status: not (AgentStatus.Applicant or AgentStatus.Terminated) }
                                  && _agent.Id != _user.GetAgentId();

    private async Task Terminate()
    {
        if (_agent is null)
        {
            return;
        }
        var display = _mayRealName && !string.IsNullOrWhiteSpace(_agent.RealName)
            ? $"{_agent.RealName} ({_agent.Codename})"
            : _agent.Codename;
        var choice = await TerminationDialog.ShowAsync(DialogService, display);
        if (choice is null)
        {
            return;
        }
        try
        {
            await AgentService.TerminateAsync(_agent.Id, choice.Reason, choice.CreateNote, choice.PostDiscord, _user);
            Snackbar.Add($"{display} wurde gekündigt.", Severity.Warning);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task TerminationRevoke()
    {
        if (_agent is null)
        {
            return;
        }
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Kündigung zurücknehmen?",
            "Der Account wird wieder aktiv und der Blacklist-Eintrag entfernt. Admin-Rechte werden nicht wiederhergestellt.",
            "Zurücknehmen");
        if (!ok)
        {
            return;
        }
        try
        {
            await AgentService.TerminationRevokeAsync(_agent.Id, _user);
            Snackbar.Add("Kündigung zurückgenommen.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task AvatarRemove()
    {
        if (_agent is null)
        {
            return;
        }
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Profilbild entfernen?",
            "Das Bild wird gelöscht; der Agent kann ein neues beantragen.", "Entfernen");
        if (!ok)
        {
            return;
        }
        try
        {
            await AgentService.AvatarRemoveAsync(_agent.Id, _user);
            Snackbar.Add("Profilbild entfernt.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ReloadAsync()
    {
        _agent = await AgentService.FindAsync(AgentId);
        _reloadKey = Guid.NewGuid();
        StateHasChanged();
    }
}
