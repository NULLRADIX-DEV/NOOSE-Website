@* Printable personnel file; real name only for authorized viewers. *@
@page "/personal/{Id}/druck"
@layout PrintLayout
@inject IAgentManagementService AgentService
@inject IPersonnelFileService PersonnelFileService
@inject ITrainingModuleService ModuleService
@inject IAccessLogService AccessLog
@inject ISupervisionSheetService SheetService
@using NOOSE_Website.Models.Personnel

<PageTitle>@(_agent is null ? "Druckansicht" : $"Personalakte {_agent.Codename}") · NOOSE</PageTitle>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_agent is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Diese Personalakte existiert nicht (mehr).</MudAlert>
}
else
{
    <PrintFrame Title="@($"Personalakte – {DisplayName(_agent)}")" BackHref="@($"/personal/{Id}")"
                 PrintedBy="@_printBy" IsClassified="false"
                 Footer="NOOSE-interne Personalakte · Weitergabe nur nach Freigabe durch die Führung.">
        <section>
            <h2>Stammdaten</h2>
            <table class="druck-felder">
                <tbody>
                    <tr><th>Codename</th><td>@DisplayName(_agent)</td></tr>
                    @if (_mayRealName && !string.IsNullOrWhiteSpace(_agent.RealName))
                    {
                        <tr><th>Klarname</th><td>@_agent.RealName</td></tr>
                    }
                    @if (!string.IsNullOrWhiteSpace(_agent.BadgeNumber))
                    {
                        <tr><th>Dienstnummer</th><td>@_agent.BadgeNumber</td></tr>
                    }
                    <tr><th>Dienstgrad</th><td>@RankDisplay.Name(_agent.Rank)</td></tr>
                    <tr><th>Status</th><td>@AgentStatusDisplay.Name(_agent.Status)</td></tr>
                    @if (_agent.IsTRU)
                    {
                        <tr><th>Einheit</th><td>TRU (Tactical Response Unit)</td></tr>
                    }
                    @if (_agent.IsHRB)
                    {
                        <tr><th>Einheit</th><td>HRB (Human Resources Branch)</td></tr>
                    }
                    <tr><th>Registriert am</th><td>@_agent.RegisteredAt.ToLocalTime().ToString("dd.MM.yyyy")</td></tr>
                    @if (_agent.Status == AgentStatus.Terminated)
                    {
                        <tr>
                            <th>Gekündigt</th>
                            <td>
                                @(_agent.TerminatedAt?.ToLocalTime().ToString("dd.MM.yyyy") ?? "—")@(string.IsNullOrWhiteSpace(_agent.TerminatedByName) ? "" : $" durch {_agent.TerminatedByName}")
                            </td>
                        </tr>
                        @* the file shows the reason to leadership only; the printout must not show more *@
                        @if (_isLeadership && !string.IsNullOrWhiteSpace(_agent.TerminationReason))
                        {
                            <tr><th>Kündigungsgrund</th><td>@_agent.TerminationReason</td></tr>
                        }
                    }
                </tbody>
            </table>
        </section>

        @if (_rankHistory.Count > 0)
        {
            <section>
                <h2>Dienstgrad-Verlauf</h2>
                <table class="druck-tabelle">
                    <thead><tr><th>Zeitpunkt</th><th>Änderung</th><th>Grund</th><th>Durch</th></tr></thead>
                    <tbody>
                        @foreach (var v in _rankHistory)
                        {
                            <tr>
                                <td>@v.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@RankDisplay.Name(v.Alt) → @RankDisplay.Name(v.New)</td>
                                <td>@(string.IsNullOrWhiteSpace(v.Reason) ? "—" : v.Reason)</td>
                                <td>@(v.ActorName ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }

        @if (_notes.Count > 0)
        {
            <section>
                <h2>Vermerke</h2>
                @foreach (var v in _notes)
                {
                    <div class="druck-eintrag">
                        <div class="druck-eintrag-kopf">
                            <b>@v.ArtLabel</b>
                            <text> · @v.EntryDate.ToString("dd.MM.yyyy HH:mm")</text>
                            @if (!string.IsNullOrWhiteSpace(v.AuthorName))
                            {
                                <text> · @v.AuthorName</text>
                            }
                            @if (ExecutorNames(v) is { Length: > 0 } exec)
                            {
                                <text> · Auszuführende: @exec</text>
                            }
                        </div>
                        <RichHtml Html="@v.Text" Plain="true" />
                    </div>
                }
            </section>
        }

        @if (_completedModules.Count > 0)
        {
            <section>
                <h2>Abgeschlossene Module</h2>
                <table class="druck-tabelle">
                    <thead><tr><th>Modul</th><th>Abgeschlossen am</th><th>Erfasst durch</th><th>Notiz</th></tr></thead>
                    <tbody>
                        @foreach (var m in _completedModules)
                        {
                            <tr>
                                <td>@m.Module.Name</td>
                                <td>@m.CompletedAt!.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@(m.CompleterName ?? "—")</td>
                                <td>@(string.IsNullOrWhiteSpace(m.Note) ? "—" : m.Note)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }

        @if (_sheet is { } s)
        {
            <section>
                <h2>Dienstaufsicht – @SupervisionDisplay.Window(s.Days) seit @MeetingTime.Day(s.SinceUtc).ToString("dd.MM.yyyy")</h2>
                <table class="druck-tabelle">
                    <thead><tr><th>Kennzahl</th><th>Wert</th><th>Team (Median)</th></tr></thead>
                    <tbody>
                        <tr>
                            <td>Letztes Lebenszeichen</td>
                            <td>@MeetingTime.Day(s.Activity.LastTraceAt).ToString("dd.MM.yyyy") · @InactivityDisplay.Trace(s.Activity.Kind)</td>
                            <td>—</td>
                        </tr>
                        <tr>
                            <td>Tage ohne Lebenszeichen</td>
                            <td>@s.Activity.SilentDays@(s.Activity.AbsentDays > 0 ? $" (davon {s.Activity.AbsentDays} abgemeldet)" : "")</td>
                            <td>—</td>
                        </tr>
                        <tr>
                            <td>Schreibleistung pro Woche</td>
                            <td>@SupervisionDisplay.PerWeek(s.Writes.Value, s.Days) (@s.Writes.Value.ToString("N0") Einträge)</td>
                            <td>@TeamCell(s.Writes.Team is { } w ? SupervisionDisplay.PerWeek(w, s.Days) : null)</td>
                        </tr>
                        @foreach (var (label, figure) in PrintedFigures(s))
                        {
                            <tr>
                                <td>@label</td>
                                <td>@figure.Value.ToString("N0")</td>
                                <td>@TeamCell(figure.Team is { } t ? SupervisionDisplay.Number(t) : null)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (s.CounterIntel is { } ci && ci.Flags.Count > 0)
                {
                    <h3>Regel-Treffer der Gegenaufklärung</h3>
                    <table class="druck-tabelle">
                        <thead><tr><th>Regel</th><th>Befund</th></tr></thead>
                        <tbody>
                            @foreach (var f in ci.Flags)
                            {
                                <tr><td>@f.Rule</td><td>@f.Detail</td></tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
        }
    </PrintFrame>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "tage")] public int? Days { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private SupervisionSheet? _sheet;

    private static string TeamCell(string? team) => team ?? "—";

    /// <summary>The sheet's plain counts in the order the tab shows them; the access figures only when present.</summary>
    private static IEnumerable<(string Label, SupervisionFigure Figure)> PrintedFigures(SupervisionSheet s)
    {
        yield return ("Wiedervorlagen pünktlich erledigt", s.FollowupsOnTime);
        yield return ("Wiedervorlagen verspätet erledigt", s.FollowupsLate);
        yield return ("Wiedervorlagen offen überfällig", s.FollowupsOverdue);
        yield return ("Besprechungen anwesend", s.MeetingsPresent);
        yield return ("Besprechungen abgemeldet", s.MeetingsSignedOff);
        yield return ("Besprechungen gefehlt", s.MeetingsMissing);
        yield return ("Abmeldetage", s.AbsenceDays);
        yield return ("Punkte", s.Points);
        yield return ("Abzeichen (insgesamt)", s.Badges);
        yield return ("Belobigungen", s.Commendations);
        yield return ("Disziplinarvermerke", s.Disciplinary);
        if (s.CounterIntel is { } ci)
        {
            yield return ("Zugriffe", ci.Accesses);
            yield return ("Verschiedene Akten", new SupervisionFigure(ci.DistinctRecords, null));
            yield return ("Zugriffe 22–6 Uhr", new SupervisionFigure(ci.OffHours, null));
        }
    }

    private bool _load = true;
    private bool _mayRealName;
    private bool _isLeadership;
    private string? _printBy;
    private Agent? _agent;
    private List<AgentRankHistory> _rankHistory = new();
    private List<AgentNote> _notes = new();
    private List<AgentModuleStatus> _completedModules = new();
    private Dictionary<string, string> _agentNames = new();

    private static string DisplayName(Agent a)
        => string.IsNullOrWhiteSpace(a.Codename) ? "Unbenannter Agent" : a.Codename;

    private string ExecutorNames(AgentNote v)
        => string.Join(", ", v.ExecutorIds.Select(id => _agentNames.GetValueOrDefault(id)).Where(n => !string.IsNullOrEmpty(n)));

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateTask).User;
        _mayRealName = user.MayRealNameSee();
        _isLeadership = user.IsLeadership();
        _printBy = user.GetCodename();

        _agent = await AgentService.FindAsync(Id);
        if (_agent is not null)
        {
            // name lookup, not a picker: terminated authors must still render
            _agentNames = (await AgentService.GetAllAsync()).ToDictionary(a => a.Id, a => a.Codename);
            _rankHistory = await PersonnelFileService.GetRankHistoryAsync(Id);
            _notes = await PersonnelFileService.GetNotesAsync(Id);
            _completedModules = (await ModuleService.GetStatusForAgentAsync(Id)).Where(m => m.IsCompleted).ToList();
            // the same gate as the tab; the service decides about the counter-intelligence part on its own
            if (user.MayClassifiedRead() && !user.IsPartner())
            {
                _sheet = await SheetService.GetAsync(Id, SupervisionWindow.Normalize(Days), user);
            }
            await AccessLog.LogViewAsync(nameof(Agent), Id);
        }
        _load = false;
    }
}
