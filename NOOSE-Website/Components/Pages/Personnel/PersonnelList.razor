@page "/personal"
@using NOOSE_Website.Models.Personnel
@using NOOSE_Website.Models.Navigation
@inject IAgentManagementService AgentService
@inject IInactivityRadarService RadarService
@inject NavigationManager Nav

<PageTitle>Personal · FIB</PageTitle>

@* no help button: the page never had one, and the desktop stays as it was *@
<PageHeader Icon="@Icons.Material.Filled.Badge" Title="Personal" ShowHelp="false"
            Subtitle="Personalakten aller FIB-Agenten: Dienstgrad-Verlauf, Belobigungen, Disziplinarisches und Beförderungen." />

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="false"
             @bind-ActivePanelIndex="_tab" Class="mb-3 noose-reiter-handy">
        <MudTabPanel Icon="@Icons.Material.Filled.Badge" IconColor="Color.Primary"
                     Text="@($"FIB ({CountInternal})")" />
        <MudTabPanel Icon="@Icons.Material.Filled.Handshake" IconColor="Color.Info"
                     Text="@($"Partner ({CountPartner})")" />
        @if (_isLeadership)
        {
            <MudTabPanel Icon="@Icons.Material.Filled.HourglassBottom" IconColor="Color.Warning"
                         Text="@($"Inaktiv ({_radar?.Rows.Count ?? 0})")" />
            <MudTabPanel Icon="@Icons.Material.Filled.PersonOff" IconColor="Color.Error"
                         Text="@($"Gekündigt ({CountTerminated})")" />
        }
    </MudTabs>

    @if (_tab == TabInactive)
    {
        @if (_radar is null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Das Radar konnte nicht geladen werden.</MudAlert>
        }
        else
        {
            <InactivityRadarPanel Radar="_radar" Changed="ReloadAsync" />
        }
    }
    else
    {
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3 noose-filterleiste" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_search" Placeholder="Suchen (Codename, Dienstnummer)…" Immediate="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1 noose-filter-feld" Style="min-width:220px;" />
            @if (_tab == TabPartner)
            {
                @* below 600px the two selects fold behind this button; from 600px up it is gone and they stand as before *@
                <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.FilterList"
                           Class="noose-nur-handy" OnClick="@(() => _filtersOpen = !_filtersOpen)"
                           aria-expanded="@(_filtersOpen ? "true" : "false")">Filter (@ActiveFilters)</MudButton>
                <MudSelect T="PartnerAgency?" Value="_agencyFilter" ValueChanged="@(v => _agencyFilter = v)"
                           Label="Behörde" Clearable="true" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                           Class="@FilterClass" Style="min-width:160px;">
                    <MudSelectItem T="PartnerAgency?" Value="@((PartnerAgency?)null)">Alle Behörden</MudSelectItem>
                    @foreach (var ag in PartnerAgencyDisplay.All)
                    {
                        <MudSelectItem T="PartnerAgency?" Value="@ag">@PartnerAgencyDisplay.Name(ag)</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="PartnerRank?" Value="_rankFilter" ValueChanged="@(v => _rankFilter = v)"
                           Label="Rang" Clearable="true" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                           Class="@FilterClass" Style="min-width:160px;">
                    <MudSelectItem T="PartnerRank?" Value="@((PartnerRank?)null)">Alle Ränge</MudSelectItem>
                    @foreach (var pr in PartnerRankDisplay.All)
                    {
                        <MudSelectItem T="PartnerRank?" Value="@pr">@pr</MudSelectItem>
                    }
                </MudSelect>
            }
            <MobileColumnPicker ListKey="personal" Columns="_phoneColumnSet" Defaults="PhoneDefaults"
                                VisibleChanged="@(v => _phoneColumns = v)" />
        </MudStack>

        @* Breakpoint.None: on phones the list stays a table with fewer columns instead of stacked cards *@
        <MudTable Items="_filtered" Hover="true" Breakpoint="Breakpoint.None" Elevation="2" Dense="true"
                  OnRowClick="@((TableRowClickEventArgs<Agent> e) => Open(e.Item))" T="Agent">
            <HeaderContent>
                <MudTh Class="@Col("codename")"><MudTableSortLabel T="Agent" SortBy="@(x => x.Codename)">Codename</MudTableSortLabel></MudTh>
                <MudTh Class="@Col("dienstnummer")"><MudTableSortLabel T="Agent" SortBy="@(x => x.BadgeNumber)">Dienstnummer</MudTableSortLabel></MudTh>
                @if (_mayRealName)
                {
                    <MudTh Class="@Col("klarname")"><MudTableSortLabel T="Agent" SortBy="@(x => x.RealName)">Klarname</MudTableSortLabel></MudTh>
                }
                @if (_tab == TabTerminated)
                {
                    <MudTh Class="@Col("dienstgrad")"><MudTableSortLabel T="Agent" SortBy="@(x => x.Rank)">Letzter Dienstgrad</MudTableSortLabel></MudTh>
                    <MudTh Class="@Col("gekuendigtam")"><MudTableSortLabel T="Agent" SortBy="@(x => x.TerminatedAt)" InitialDirection="SortDirection.Descending">Gekündigt am</MudTableSortLabel></MudTh>
                    <MudTh Class="@Col("gekuendigtvon")"><MudTableSortLabel T="Agent" SortBy="@(x => x.TerminatedByName)">Gekündigt von</MudTableSortLabel></MudTh>
                    <MudTh Class="@Col("grund")">Grund</MudTh>
                }
                else if (_tab == TabPartner)
                {
                    <MudTh Class="@Col("behoerde")"><MudTableSortLabel T="Agent" SortBy="@(x => x.PartnerAgency)">Behörde</MudTableSortLabel></MudTh>
                    <MudTh Class="@Col("partnerrang")"><MudTableSortLabel T="Agent" SortBy="@(x => x.PartnerRank)">Partner-Rang</MudTableSortLabel></MudTh>
                    <MudTh Class="@Col("status")"><MudTableSortLabel T="Agent" SortBy="@(x => AgentStatusDisplay.Name(x.Status))">Status</MudTableSortLabel></MudTh>
                }
                else
                {
                    <MudTh Class="@Col("dienstgrad")"><MudTableSortLabel T="Agent" SortBy="@(x => x.Rank)">Dienstgrad</MudTableSortLabel></MudTh>
                    <MudTh Class="@Col("status")"><MudTableSortLabel T="Agent" SortBy="@(x => AgentStatusDisplay.Name(x.Status))">Status</MudTableSortLabel></MudTh>
                    <MudTh Class="@Col("abteilung")"><MudTableSortLabel T="Agent" SortBy="@(x => UnitLabel(x))">Abteilung</MudTableSortLabel></MudTh>
                    <MudTh Class="@Col("hrb")"><MudTableSortLabel T="Agent" SortBy="@(x => x.IsHRB)">@DepartmentRules.ColumnLabel</MudTableSortLabel></MudTh>
                }
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Codename" Class="@Col("codename")">
                    <MudLink Href="@($"/personal/{context.Id}")" @onclick:stopPropagation="true">
                        @(string.IsNullOrWhiteSpace(context.Codename) ? "Unbenannter Agent" : context.Codename)
                    </MudLink>
                </MudTd>
                <MudTd DataLabel="Dienstnummer" Class="@Col("dienstnummer")"><MudText Typo="Typo.body2" Class="mud-text-secondary">@(context.BadgeNumber ?? "—")</MudText></MudTd>
                @if (_mayRealName)
                {
                    <MudTd DataLabel="Klarname" Class="@Col("klarname")"><MudText Typo="Typo.body2" Class="mud-text-secondary">@(context.RealName ?? "—")</MudText></MudTd>
                }
                @if (_tab == TabTerminated)
                {
                    <MudTd DataLabel="Letzter Dienstgrad" Class="@Col("dienstgrad")">@DivisionRules.RankName(context)</MudTd>
                    <MudTd DataLabel="Gekündigt am" Class="@Col("gekuendigtam")">@(context.TerminatedAt?.ToLocalTime().ToString("dd.MM.yyyy") ?? "—")</MudTd>
                    <MudTd DataLabel="Gekündigt von" Class="@Col("gekuendigtvon")">@(context.TerminatedByName ?? "—")</MudTd>
                    <MudTd DataLabel="Grund" Class="@Col("grund")">
                        <MudTooltip Text="@context.TerminationReason">
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Shorten(context.TerminationReason)</MudText>
                        </MudTooltip>
                    </MudTd>
                }
                else if (_tab == TabPartner)
                {
                    <MudTd DataLabel="Behörde" Class="@Col("behoerde")">@PartnerAgencyDisplay.Name(context.PartnerAgency)</MudTd>
                    <MudTd DataLabel="Partner-Rang" Class="@Col("partnerrang")">@PartnerRankDisplay.Full(context.PartnerAgency, context.PartnerRank)</MudTd>
                    <MudTd DataLabel="Status" Class="@Col("status")">@AgentStatusDisplay.Name(context.Status)</MudTd>
                }
                else
                {
                    <MudTd DataLabel="Dienstgrad" Class="@Col("dienstgrad")">@DivisionRules.RankName(context)</MudTd>
                    <MudTd DataLabel="Status" Class="@Col("status")">@AgentStatusDisplay.Name(context.Status)</MudTd>
                    <MudTd DataLabel="Abteilung" Class="@Col("abteilung")">@UnitLabel(context)</MudTd>
                    <MudTd DataLabel="@DepartmentRules.ColumnLabel" Class="@Col("hrb")">@(context.IsHRB ? "Ja" : "")</MudTd>
                }
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">Keine Agenten gefunden.</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager Class="noose-pager-handy" />
            </PagerContent>
        </MudTable>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    // positions of the MudTabPanels; the last two are leadership-only
    private const int TabPartner = 1;
    private const int TabInactive = 2;
    private const int TabTerminated = 3;

    private bool _load = true;
    private bool _mayRealName;
    private bool _isLeadership;
    private string _search = string.Empty;
    private int _tab;
    private PartnerAgency? _agencyFilter;
    private PartnerRank? _rankFilter;
    private List<Agent> _agents = new();
    private InactivityRadar? _radar;
    private ClaimsPrincipal _user = default!;
    private bool _filtersOpen;

    /// <summary>Every column the three agent tabs can show, in table order; the real name only for who may see it.</summary>
    private static readonly IReadOnlyList<(string Key, string Label)> PhoneColumns =
    [
        ("codename", "Codename"), ("dienstnummer", "Dienstnummer"), ("klarname", "Klarname"),
        ("dienstgrad", "Dienstgrad"), ("gekuendigtam", "Gekündigt am"), ("gekuendigtvon", "Gekündigt von"),
        ("grund", "Grund"), ("behoerde", "Behörde"), ("partnerrang", "Partner-Rang"), ("status", "Status"),
        ("abteilung", "Abteilung"), ("hrb", DepartmentRules.ColumnLabel),
    ];

    /// <summary>Codename plus the rank: the FIB rank, the last rank of a terminated agent or the partner rank.</summary>
    private static readonly IReadOnlyList<string> PhoneDefaults = ["codename", "dienstgrad", "partnerrang"];

    private IReadOnlyList<(string Key, string Label)> _phoneColumnSet = PhoneColumns;

    // the defaults until the picker reports the stored choice, so even the first paint is narrow on a phone
    private IReadOnlySet<string> _phoneColumns = MobileColumnSet.Resolve(PhoneColumns.Select(c => c.Key).ToList(), PhoneDefaults, null);

    // below 600px only; from 600px up every column shows, as before
    private string Col(string key) => MobileColumnSet.ClassFor(_phoneColumns, key);

    private int ActiveFilters => (_agencyFilter is null ? 0 : 1) + (_rankFilter is null ? 0 : 1);

    // folded only below 600px (noose-filter-zu); from 600px up the selects stand in the row as before
    private string FilterClass => _filtersOpen ? "noose-filter-feld" : "noose-filter-feld noose-filter-zu";

    private IEnumerable<Agent> _filtered
    {
        get
        {
            var query = _tab switch
            {
                TabTerminated => _agents.Where(a => a.Status == AgentStatus.Terminated),
                TabPartner => _agents.Where(a => a.PartnerAgency != null && a.Status != AgentStatus.Terminated),
                _ => _agents.Where(a => a.PartnerAgency == null && a.Status != AgentStatus.Terminated),
            };
            if (_tab == TabPartner)
            {
                if (_agencyFilter is { } agency)
                {
                    query = query.Where(a => a.PartnerAgency == agency);
                }
                if (_rankFilter is { } rank)
                {
                    query = query.Where(a => a.PartnerRank == rank);
                }
            }
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                query = query.Where(a => (a.Codename ?? string.Empty).Contains(s, StringComparison.OrdinalIgnoreCase)
                                       || (a.BadgeNumber ?? string.Empty).Contains(s, StringComparison.OrdinalIgnoreCase)
                                       || (_mayRealName && (a.RealName ?? string.Empty).Contains(s, StringComparison.OrdinalIgnoreCase)));
            }
            return query;
        }
    }

    private int CountInternal => _agents.Count(a => a.PartnerAgency == null && a.Status != AgentStatus.Terminated);
    private int CountPartner => _agents.Count(a => a.PartnerAgency != null && a.Status != AgentStatus.Terminated);
    private int CountTerminated => _agents.Count(a => a.Status == AgentStatus.Terminated);

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _mayRealName = _user.MayRealNameSee();
        _isLeadership = _user.IsLeadership();
        _phoneColumnSet = _mayRealName ? PhoneColumns : PhoneColumns.Where(c => c.Key != "klarname").ToList();
        await LoadAsync();
        _load = false;
    }

    private async Task LoadAsync()
    {
        // TeamLeads invisible in RP; blocked accounts hidden too. Named in AgentSelection so the global
        // search over personnel files answers the same, instead of being wider than this page.
        _agents = (await AgentService.GetAllAsync())
            .Where(AgentSelection.HasPersonnelFile)
            .ToList();
        if (_isLeadership)
        {
            try
            {
                _radar = await RadarService.GetAsync(_user);
            }
            // a null radar makes the tab say it could not load
            catch
            {
                /* best effort */
                _radar = null;
            }
        }
    }

    // a termination from the radar also moves the agent to the terminated tab
    private Task ReloadAsync() => LoadAsync();

    private void Open(Agent? a)
    {
        if (a is not null)
        {
            Nav.NavigateTo($"/personal/{a.Id}");
        }
    }

    /// <summary>Board or division; empty for an account without a rank.</summary>
    private static string UnitLabel(Agent agent)
        => DivisionRules.Of(agent) is { IsNone: false } unit ? DivisionRules.Label(unit) : string.Empty;

    private static string Shorten(string? text)
        => string.IsNullOrWhiteSpace(text) ? "—"
            : text.Length <= 60 ? text : text[..60] + "…";
}
