@* Personnel-file entries (all kinds); add/delete is leadership-only and posts a Discord "EINTRAG" pinging the subject. *@
@inject IPersonnelFileService PersonnelFileService
@inject IAgentManagementService AgentService
@inject IPersonnelTemplateService PersonnelTemplateService
@inject IPlaceholderService Placeholder
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudStack Spacing="3">
    <AuthorizeView Policy="@Policies.LeadershipWrite">
        <MudPaper Class="pa-3" Elevation="1">
            <MudStack Spacing="2">
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                    @* below 600px each field takes the full row: date and time stand one under the other *@
                    <MudSelect T="AgentNoteKind" @bind-Value="_kind" @bind-Value:after="OnKindChanged" Label="Art"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Class="noose-breite-frei" Style="min-width:200px;">
                        @foreach (var k in AgentNoteKindDisplay.Creatable)
                        {
                            <MudSelectItem T="AgentNoteKind" Value="@k">@AgentNoteKindDisplay.Name(k)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField @bind-Value="_artFreetext" Label="Art-Freitext (optional)" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" Class="noose-breite-frei" Style="min-width:220px;" HelperText="Überschreibt die Kategorie-Bezeichnung." />
                    <MudDatePicker @bind-Date="_entryDate" Label="Datum" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Class="noose-breite-frei" Style="min-width:180px;" />
                    <MudTimePicker @bind-Time="_entryTime" Label="Uhrzeit" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Class="noose-breite-frei" Style="min-width:140px;" />
                </MudStack>

                <MudSelect T="string" Label="Auszuführende" MultiSelection="true"
                           SelectedValues="_executorIds" SelectedValuesChanged="OnExecutorsChanged"
                           MultiSelectionTextFunc="@DisplaySelection" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.ManageAccounts">
                    @foreach (var a in _agents)
                    {
                        <MudSelectItem T="string" Value="@a.Id">@a.Codename (@DivisionRules.RankName(a))</MudSelectItem>
                    }
                </MudSelect>

                @if (_templates.Count > 0)
                {
                    <MudSelect T="string" Value="_selectedTemplateId" ValueChanged="ApplyTemplateAsync" Label="Vorlage einfügen"
                               Variant="Variant.Outlined" Dense="true" Clearable="true" Placeholder="Vorlage wählen …">
                        @foreach (var t in _templates)
                        {
                            <MudSelectItem T="string" Value="@t.Id">@t.Name</MudSelectItem>
                        }
                    </MudSelect>
                }
                <RichTextEditor @ref="_editor" @bind-Value="_newHtml" MinHeight="200px" Ai="TextAssistContext.PersonnelNote" Mentions="true"
                                DraftKey='@($"personalnotiz:{AgentId}")' />
                <div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddAsync" Disabled="@(_saves || string.IsNullOrWhiteSpace(_newHtml))">Hinzufügen</MudButton>
                </div>
            </MudStack>
        </MudPaper>
    </AuthorizeView>

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="noose-kopf-umbruch">
        <MudText Typo="Typo.subtitle1">Einträge (@Filtered.Count)</MudText>
        <MudSpacer />
        <MudSelect T="AgentNoteKind?" @bind-Value="_filterKind" Label="Filter" Variant="Variant.Outlined" Dense="true"
                   Clearable="true" Class="noose-filter-feld" Style="min-width:220px;" Placeholder="Alle Arten">
            @foreach (var k in AgentNoteKindDisplay.All)
            {
                <MudSelectItem T="AgentNoteKind?" Value="@k">@AgentNoteKindDisplay.Name(k)</MudSelectItem>
            }
        </MudSelect>
    </MudStack>

    @if (_load)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (Filtered.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Keine Einträge.</MudText>
    }
    else
    {
        @foreach (var v in Filtered)
        {
            <MudPaper Class="pa-3" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                    <div style="flex:1;" class="noose-eintrag-titel">
                        <MudText Typo="Typo.overline" Class="mud-text-secondary">📝 Eintrag</MudText>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
                            <MudChip T="string" Size="Size.Small" Color="@AgentNoteKindDisplay.ChipColor(v.Kind)"
                                     Variant="Variant.Text" Icon="@Icons.Material.Filled.Label">@v.ArtLabel</MudChip>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                📅 @v.EntryDate.ToString("dd.MM.yyyy HH:mm")
                            </MudText>
                        </MudStack>
                        <RichHtml Html="@v.Text" />
                        @if (ExecutorNames(v) is { Length: > 0 } exec)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">👮 @exec</MudText>
                        }
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @(string.IsNullOrWhiteSpace(v.AuthorName) ? "—" : v.AuthorName) · erfasst @v.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </MudText>
                    </div>
                    <AuthorizeView Policy="@Policies.LeadershipWrite">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => DeleteAsync(v))" aria-label="Eintrag löschen" />
                    </AuthorizeView>
                </MudStack>
            </MudPaper>
        }
    }
</MudStack>

@code {
    [Parameter, EditorRequired] public string AgentId { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;
    private bool _saves;
    private string _newHtml = string.Empty;
    private string? _selectedTemplateId;
    private RichTextEditor _editor = default!;
    private ClaimsPrincipal _user = default!;
    private List<AgentNote> _notes = new();
    private List<PersonnelTemplate> _templates = new();
    private List<Agent> _agents = new();
    private Dictionary<string, string> _agentNames = new();

    private AgentNoteKind _kind = AgentNoteKind.Commendation;
    private string? _artFreetext;
    private DateTime? _entryDate = DateTime.Now;
    private TimeSpan? _entryTime = DateTime.Now.TimeOfDay;
    private IReadOnlyCollection<string> _executorIds = new List<string>();
    private AgentNoteKind? _filterKind;

    private List<AgentNote> Filtered =>
        _filterKind is { } k ? _notes.Where(n => n.Kind == k).ToList() : _notes;

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _agents = await AgentService.GetSelectableAsync();
        // name lookup, not a picker: already-recorded executors must still render
        _agentNames = (await AgentService.GetAllAsync()).ToDictionary(a => a.Id, a => a.Codename);
        if (_user.IsLeadership())
        {
            await LoadTemplatesAsync();
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _load = true;
        _notes = await PersonnelFileService.GetNotesAsync(AgentId);
        _load = false;
    }

    private async Task LoadTemplatesAsync()
    {
        _templates = TemplateKind is { } tk ? await PersonnelTemplateService.GetActiveAsync(tk) : new();
    }

    private PersonnelTemplateKind? TemplateKind => _kind switch
    {
        AgentNoteKind.Commendation => PersonnelTemplateKind.Commendation,
        AgentNoteKind.Disciplinary => PersonnelTemplateKind.Disciplinary,
        _ => null,
    };

    private async Task OnKindChanged() => await LoadTemplatesAsync();

    private void OnExecutorsChanged(IReadOnlyCollection<string> ids) => _executorIds = ids?.ToList() ?? new();

    private string DisplaySelection(IReadOnlyList<string> ids)
    {
        var names = ids.Select(id => _agentNames.GetValueOrDefault(id, id)).ToList();
        return names.Count == 0 ? string.Empty : string.Join(", ", names);
    }

    private string ExecutorNames(AgentNote v)
        => string.Join(", ", v.ExecutorIds.Select(id => _agentNames.GetValueOrDefault(id)).Where(n => !string.IsNullOrEmpty(n)));

    private async Task ApplyTemplateAsync(string? id)
    {
        _selectedTemplateId = null;
        if (string.IsNullOrEmpty(id))
        {
            return;
        }
        var t = _templates.FirstOrDefault(x => x.Id == id);
        if (t is null)
        {
            return;
        }
        // {{Name}} resolves to the agent this personnel file belongs to
        var html = await Placeholder.ApplyAsync(t.ContentHtml, nameof(Agent), AgentId, _user);
        _newHtml = html;
        await _editor.SetHtmlAsync(html);
    }

    private async Task AddAsync()
    {
        if (_saves)
        {
            return;
        }
        var html = await _editor.GetHtmlAsync();
        if (string.IsNullOrWhiteSpace(html))
        {
            return;
        }
        _saves = true;
        try
        {
            var when = (_entryDate ?? DateTime.Now).Date + (_entryTime ?? TimeSpan.Zero);
            await PersonnelFileService.NoteCreateAsync(AgentId, _kind, _artFreetext, when, _executorIds.ToList(), html, _user);
            await _editor.MarkSavedAsync();
            _newHtml = string.Empty;
            _artFreetext = null;
            _executorIds = new List<string>();
            _entryDate = DateTime.Now;
            _entryTime = DateTime.Now.TimeOfDay;
            await _editor.SetHtmlAsync(string.Empty);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        _saves = false;
    }

    private async Task DeleteAsync(AgentNote v)
    {
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Eintrag löschen?", "Der Eintrag wird entfernt.");
        if (!ok)
        {
            return;
        }
        try
        {
            await PersonnelFileService.NoteDeleteAsync(v.Id, _user);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
