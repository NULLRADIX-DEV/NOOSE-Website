@inject IPersonnelTemplateService PersonnelTemplateService
@inject IPlaceholderService Placeholder

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3" Style="min-width:420px;">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Beförderungsantrag für <b>@Codename</b> (aktuell: @RankDisplay.Name(Current)).</MudText>
            <MudSelect T="Rank" @bind-Value="_target" Label="Ziel-Dienstgrad" Variant="Variant.Outlined">
                @foreach (var d in RankDisplay.All)
                {
                    <MudSelectItem Value="d">@RankDisplay.Name(d)</MudSelectItem>
                }
            </MudSelect>
            @if (_templates.Count > 0)
            {
                <MudSelect T="string" Value="_selectedTemplateId" ValueChanged="ApplyTemplateAsync" Label="Vorlage einfügen"
                           Variant="Variant.Outlined" Dense="true" Clearable="true" Placeholder="Vorlage wählen …">
                    @foreach (var t in _templates)
                    {
                        <MudSelectItem T="string" Value="@t.Id">@t.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            <div>
                <MudText Typo="Typo.subtitle2" Class="mb-1">Begründung</MudText>
                <RichTextEditor @ref="_editor" MinHeight="200px" Ai="TextAssistContext.Promotion" Mentions="true"
                                DraftKey='@($"beforderung:{AgentId}")' />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Wird im Posteingang für die Entscheidung angezeigt.</MudText>
            </div>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Beantragen</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    [Parameter] public string AgentId { get; set; } = string.Empty;
    [Parameter] public string Codename { get; set; } = string.Empty;
    [Parameter] public Rank Current { get; set; } = Rank.Trainee;

    private Rank _target;
    private RichTextEditor _editor = default!;
    private ClaimsPrincipal _user = default!;
    private string? _selectedTemplateId;
    private List<PersonnelTemplate> _templates = new();

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _target = Current;
        _templates = await PersonnelTemplateService.GetActiveAsync(PersonnelTemplateKind.Promotion);
    }

    private async Task ApplyTemplateAsync(string? id)
    {
        _selectedTemplateId = null;
        if (string.IsNullOrEmpty(id))
        {
            return;
        }
        var t = _templates.FirstOrDefault(x => x.Id == id);
        if (t is null)
        {
            return;
        }
        // {{Name}} resolves to the agent being promoted
        var html = await Placeholder.ApplyAsync(t.ContentHtml, nameof(Agent), AgentId, _user);
        await _editor.SetHtmlAsync(html);
    }

    private async Task Save()
    {
        var html = await _editor.GetHtmlAsync();
        MudDialog.Close(DialogResult.Ok(new Choice(_target, html)));
    }

    private void Cancel() => MudDialog.Cancel();

    public record Choice(Rank TargetRank, string? Justification);

    public static async Task<Choice?> ShowAsync(IDialogService dialog, string agentId, string codename, Rank current)
    {
        var parameters = new DialogParameters<PromotionDialog>
        {
            { x => x.AgentId, agentId },
            { x => x.Codename, codename },
            { x => x.Current, current },
        };
        var reference = await dialog.ShowAsync<PromotionDialog>("Beförderung beantragen", parameters);
        var result = await reference.Result;
        return result is { Canceled: false, Data: Choice choice } ? choice : null;
    }
}
