    private async Task SaveLayoutAsync()
    {
        if (_module is null || !_ready)
        {
            return;
        }
        string? name;
        try { name = await JS.InvokeAsync<string?>("prompt", "Name der Ansicht:", "Meine Ansicht"); }
        catch (JSDisconnectedException) { return; }
        if (string.IsNullOrWhiteSpace(name))
        {
            return;
        }
        try
        {
            var json = await _module.InvokeAsync<string>("holePositionen", ContainerId);
            // a saved view is positions *plus* the workbench/filter state that produced them
            var payload = GraphViewPayload.Wrap(json, new GraphViewState(
                Centrality: _computeCentrality,
                Community: _communityOn,
                FocusMode: _modeFocus,
                FocusType: _focus?.Type,
                FocusId: _focus?.Id,
                FocusName: string.IsNullOrWhiteSpace(_focus?.Designation) ? null : _focus!.Designation,
                Depth: _depth,
                Types: _typeFilter.Count > 0 ? _typeFilter.ToList() : null,
                Kind: _kindChoice));
            await LayoutService.SaveAsync(name, payload, _user);
            _layouts = await LayoutService.GetForAgentAsync(_meId ?? string.Empty);
            Snackbar.Add("Ansicht gespeichert.", Severity.Success);
        }
        catch (UnauthorizedAccessException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        catch (JSDisconnectedException) { /* ignore */ }
        catch (Exception ex) { Logger.LogWarning(ex, "Beziehungsgraph: Ansicht speichern fehlgeschlagen."); }
    }

    private async Task LoadLayoutAsync(GraphCanvasLayout layout)
    {
        if (_module is null || !_ready)
        {
            return;
        }
        var (positions, view) = GraphViewPayload.Unwrap(layout.LayoutJson);
        if (view is not null)
        {
            _computeCentrality = view.Centrality;
            _communityOn = view.Community;
            _modeFocus = view.FocusMode;
            _depth = view.Depth;
            _typeFilter = view.Types is { Count: > 0 } t ? new HashSet<string>(t) : new HashSet<string>();
            _kindChoice = view.Kind;
            _focus = view.FocusType is not null && view.FocusId is not null
                ? new GraphRecordChoice(view.FocusType, view.FocusId, view.FocusName ?? string.Empty)
                : null;
            _focusPreset = _focus;
            // filters and analytics change the node set, so re-query before placing the nodes
            await LoadAndDrawAsync();
        }
        try
        {
            _freeMode = true; // loaded positions only stick with physics frozen
            await _module.InvokeVoidAsync("setzePositionen", ContainerId, positions);
        }
        catch (JSDisconnectedException) { /* ignore */ }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("zerstoere", ContainerId);
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { /* ignore */ }
        catch (Exception) { /* best effort */ }
        _ref?.Dispose();
    }
