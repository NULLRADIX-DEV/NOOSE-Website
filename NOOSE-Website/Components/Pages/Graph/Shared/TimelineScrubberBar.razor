@* Time scrubber for network-growth playback: emits a UTC cutoff (null = show all). *@
@implements IAsyncDisposable

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap noose-breite-frei">
    <MudIconButton Icon="@(_playing ? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow)"
                   Color="Color.Primary" Size="Size.Small" OnClick="ToggleAsync" />
    <MudText Typo="Typo.body2" Style="min-width:9rem;" Class="noose-min-breite-frei">@Label</MudText>
    <MudSlider T="int" Min="0" Max="100" Step="1" Value="_pos" ValueChanged="OnScrubAsync" Class="flex-grow-1" />
</MudStack>

@code {
    [Parameter, EditorRequired] public DateTime MinDate { get; set; }
    [Parameter, EditorRequired] public DateTime MaxDate { get; set; }
    [Parameter] public EventCallback<DateTime?> OnCutoffChanged { get; set; }

    private int _pos = 100;
    private bool _playing;
    private CancellationTokenSource? _cts;
    private DateTime? _queued;
    private bool _hasQueued;
    private bool _pushing;

    private DateTime? Cutoff => _pos >= 100 || MaxDate <= MinDate
        ? null
        : MinDate.AddTicks((long)((MaxDate - MinDate).Ticks * (_pos / 100.0)));

    private string Label => Cutoff is { } c ? $"bis {c.ToLocalTime():dd.MM.yyyy}" : "Alle Zeiträume";

    private async Task OnScrubAsync(int value)
    {
        _pos = Math.Clamp(value, 0, 100);
        await PushAsync();
    }

    // Dragging fires per input event; keep one push in flight and drop what it superseded.
    private async Task PushAsync()
    {
        _queued = Cutoff;
        _hasQueued = true;
        if (_pushing)
        {
            return;
        }
        _pushing = true;
        try
        {
            while (_hasQueued)
            {
                _hasQueued = false;
                await OnCutoffChanged.InvokeAsync(_queued);
            }
        }
        finally
        {
            _pushing = false;
        }
    }

    private async Task ToggleAsync()
    {
        if (_playing)
        {
            await StopAsync();
            return;
        }
        if (_pos >= 100)
        {
            _pos = 0; // restart from the beginning
        }
        _playing = true;
        var cts = new CancellationTokenSource();
        _cts = cts;
        _ = RunAsync(cts);
    }

    private async Task RunAsync(CancellationTokenSource cts)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(140));
            while (await timer.WaitForNextTickAsync(cts.Token))
            {
                var done = false;
                await InvokeAsync(async () =>
                {
                    _pos = Math.Min(100, _pos + 2);
                    done = _pos >= 100;
                    await PushAsync();
                    StateHasChanged();
                });
                if (done)
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException) { /* stopped */ }
        catch (ObjectDisposedException) { /* circuit gone */ }
        finally
        {
            // only tear down if a restart has not already replaced this run
            if (ReferenceEquals(_cts, cts))
            {
                _playing = false;
                _cts = null;
                cts.Dispose();
                try { await InvokeAsync(StateHasChanged); }
                catch (ObjectDisposedException) { /* ignore */ }
            }
        }
    }

    private async Task StopAsync()
    {
        _playing = false;
        var cts = _cts;
        _cts = null;
        if (cts is not null)
        {
            try { await cts.CancelAsync(); }
            catch (ObjectDisposedException) { /* ignore */ }
            cts.Dispose();
        }
    }

    public async ValueTask DisposeAsync() => await StopAsync();
}
