    private async Task DeleteAccount(Agent agent)
    {
        // Irreversible: require the operator to type the codename to confirm.
        var name = DisplayName(agent);
        var ok = await ConfirmTypedDialog.ShowAsync(DialogService,
            $"{name} löschen?",
            "Der Account wird unwiderruflich gelöscht. Die Discord-Verknüpfung wird getrennt; bei einem "
            + "erneuten Login entsteht ein frischer, ausstehender Account. Erstellte Inhalte (Personen, "
            + "Dokumente, Kommentare) bleiben erhalten.",
            confirmPhrase: name);
        if (!ok)
        {
            return;
        }
        var user = (await AuthStateTask).User;
        try
        {
            await AgentService.DeleteAccountAsync(agent.Id, user);
            Snackbar.Add($"{name} wurde vollständig gelöscht.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await LoadAsync();
    }

    private string AdminToggleHint(Agent agent)
    {
        if (!_amAdmin)
        {
            return "Nur Admins können Admin-Rechte vergeben oder entziehen.";
        }
        return agent.Id == _myId ? "Du kannst deine eigenen Admin-Rechte hier nicht ändern." : string.Empty;
    }

    private static string DisplayName(Agent agent)
        => string.IsNullOrWhiteSpace(agent.Codename) ? "Unbenannter Agent" : agent.Codename;

    private static string RealNameBadgeNumber(Agent agent)
        => string.Join(" · ", new[] { agent.RealName, agent.BadgeNumber }
            .Where(s => !string.IsNullOrWhiteSpace(s)));

}
