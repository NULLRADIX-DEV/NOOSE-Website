@page "/admin/agenten"
@attribute [Authorize(Policy = Policies.LeadershipPage)]
@inject IAgentManagementService AgentService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using NOOSE_Website.Models.Navigation

<PageTitle>Agenten-Verwaltung · FIB</PageTitle>

@* no help button: the hand-built header this replaces had none, and the desktop stays as it was *@
<PageHeader Icon="@Icons.Material.Filled.ManageAccounts" Title="Agenten-Verwaltung" ShowHelp="false">
    <SubtitleContent>
        Dienstgrade und Abteilungen vergeben, die Administration Division und Teamleitung-Rechte verwalten sowie Accounts sperren. Eine Sperre beendet
        alle laufenden Sitzungen des Agents sofort (Kill-Switch). Teamleitungen (FiveM-Aufsicht) sind im RP-Betrieb
        überall ausgeblendet und nur hier sichtbar – Vollzugriff erst durch den Admin-Haken. Das Setzen des
        Admin-Hakens selbst ist ausschließlich Admins vorbehalten; die Führung kann ihn nur einsehen.
    </SubtitleContent>
</PageHeader>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="false"
             @bind-ActivePanelIndex="_tab" Class="mb-3 noose-reiter-handy">
        <MudTabPanel Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success"
                     Text="@($"Aktiv ({CountActive})")" />
        <MudTabPanel Icon="@Icons.Material.Filled.Block" IconColor="Color.Error"
                     Text="@($"Gesperrt ({CountBlocked})")" />
        <MudTabPanel Icon="@Icons.Material.Filled.SupervisorAccount" IconColor="Color.Tertiary"
                     Text="@($"Teamleitung ({CountTeamLead})")" />
        <MudTabPanel Icon="@Icons.Material.Filled.Handshake" IconColor="Color.Info"
                     Text="@($"Partner ({CountPartner})")" />
        <MudTabPanel Icon="@Icons.Material.Filled.PersonOff" IconColor="Color.Error"
                     Text="@($"Gekündigt ({CountTerminated})")" />
    </MudTabs>

    @if (_tab == 3)
    {
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3 noose-filterleiste" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_search" Placeholder="Suchen (Codename, Klarname)…" Immediate="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1 noose-filter-feld" Style="min-width:220px;" />
            @* phones: the two selects fold behind this button; from 600px up it is gone and they stand as before *@
            <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.FilterList"
                       Class="noose-nur-handy" OnClick="@(() => _filtersOpen = !_filtersOpen)">Filter (@ActiveFilterCount)</MudButton>
            <MudSelect T="PartnerAgency?" Value="_agencyFilter" ValueChanged="@(v => _agencyFilter = v)"
                       Label="Behörde" Clearable="true" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                       Style="min-width:160px;" Class="@FilterClass">
                <MudSelectItem T="PartnerAgency?" Value="@((PartnerAgency?)null)">Alle Behörden</MudSelectItem>
                @foreach (var ag in PartnerAgencyDisplay.All)
                {
                    <MudSelectItem T="PartnerAgency?" Value="@ag">@PartnerAgencyDisplay.Name(ag)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="PartnerRank?" Value="_rankFilter" ValueChanged="@(v => _rankFilter = v)"
                       Label="Rang" Clearable="true" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                       Style="min-width:160px;" Class="@FilterClass">
                <MudSelectItem T="PartnerRank?" Value="@((PartnerRank?)null)">Alle Ränge</MudSelectItem>
                @foreach (var pr in PartnerRankDisplay.All)
                {
                    <MudSelectItem T="PartnerRank?" Value="@pr">@pr</MudSelectItem>
                }
            </MudSelect>
        </MudStack>
    }

    <MobileColumnPicker ListKey="admin-agenten" Columns="PhoneColumns" Defaults="PhoneDefaults"
                        VisibleChanged="@(v => _phoneColumns = v)" />
    @* rows stay rows on phones, with the columns the agent chose (MudBlazor stacked them below 600px before) *@
    <MudTable Items="VisibleAgents" Hover="true" Breakpoint="Breakpoint.None" Elevation="2" Dense="true">
        <HeaderContent>
            <MudTh Class="@Col("agent")"><MudTableSortLabel T="Agent" SortBy="@(x => DisplayName(x))">Agent</MudTableSortLabel></MudTh>
            <MudTh Style="min-width:220px;" Class="@($"noose-min-breite-frei {Col("dienstgrad")}")"><MudTableSortLabel T="Agent" SortBy="@(x => x.Rank)">Dienstgrad</MudTableSortLabel></MudTh>
            <MudTh Class="@Col("status")"><MudTableSortLabel T="Agent" SortBy="@(x => AgentStatusDisplay.Name(x.Status))">Status</MudTableSortLabel></MudTh>
            <MudTh Class="@Col("abteilung")"><MudTableSortLabel T="Agent" SortBy="@(x => DivisionRules.Of(x).Home)">Abteilung</MudTableSortLabel></MudTh>
            <MudTh Class="@Col("hrb")"><MudTableSortLabel T="Agent" SortBy="@(x => x.IsHRB)">@DepartmentRules.ColumnLabel</MudTableSortLabel></MudTh>
            <MudTh Class="@Col("teamleitung")"><MudTableSortLabel T="Agent" SortBy="@(x => x.IsTeamLead)">Teamleitung</MudTableSortLabel></MudTh>
            <MudTh Class="@Col("admin")"><MudTableSortLabel T="Agent" SortBy="@(x => x.IsAdmin)">Admin</MudTableSortLabel></MudTh>
            <MudTh Style="text-align:right;" Class="@Col("aktion")">Aktion</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Agent" Class="@Col("agent")">
                <MudText Typo="Typo.body2">@DisplayName(context)</MudText>
                @if (!string.IsNullOrWhiteSpace(RealNameBadgeNumber(context)))
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@RealNameBadgeNumber(context)</MudText>
                }
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@(context.DiscordUsername ?? context.DiscordId)</MudText>
                @if (context.IsTeamLead)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Outlined" Class="mt-1">Teamleitung</MudChip>
                }
                @if (context.PartnerAgency is { } partnerAgency)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Class="mt-1">Partner · @PartnerRankDisplay.Full(partnerAgency, context.PartnerRank)</MudChip>
                }
                @if (context.Status == AgentStatus.Blocked && !string.IsNullOrWhiteSpace(context.BlockedReason))
                {
                    <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block mt-1">Grund: @context.BlockedReason</MudText>
                }
                @if (context.Status == AgentStatus.Terminated)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block mt-1">
                        Gekündigt am @(context.TerminatedAt?.ToLocalTime().ToString("dd.MM.yyyy") ?? "—")@(string.IsNullOrWhiteSpace(context.TerminatedByName) ? "" : $" durch {context.TerminatedByName}")@(string.IsNullOrWhiteSpace(context.TerminationReason) ? "" : $" · {context.TerminationReason}")
                    </MudText>
                }
            </MudTd>
            <MudTd DataLabel="Dienstgrad" Class="@Col("dienstgrad")">
                @if (context.PartnerAgency is { } partnerAgency)
                {
                    <MudSelect T="PartnerRank" Value="@(context.PartnerRank ?? PartnerRank.Member)"
                               ValueChanged="@(pr => PartnerRankChange(context, pr))"
                               Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                               Disabled="@(context.Status != AgentStatus.Active)">
                        @foreach (var pr in PartnerRankDisplay.All)
                        {
                            <MudSelectItem Value="pr">@PartnerRankDisplay.Full(partnerAgency, pr)</MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    @if (RankOptions(context) is { Count: > 0 } options)
                    {
                        <MudSelect T="Rank" Value="@(context.Rank ?? Rank.Trainee)"
                                   ValueChanged="@(degree => RankChange(context, degree))"
                                   Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                   Disabled="@(context.Status != AgentStatus.Active)">
                            @foreach (var dg in options)
                            {
                                <MudSelectItem Value="dg">@RankDisplay.Name(dg, HomeOf(context))</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        @* nothing assignable: plain label *@
                        <MudText Typo="Typo.body2">@RankDisplay.Name(context.Rank, HomeOf(context))</MudText>
                    }
                }
            </MudTd>
            <MudTd DataLabel="Status" Class="@Col("status")">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@AgentStatusDisplay.Icon(context.Status)" Color="@AgentStatusDisplay.Colour(context.Status)" Size="Size.Small" />
                    <MudText Typo="Typo.body2" Color="@AgentStatusDisplay.Colour(context.Status)">@AgentStatusDisplay.Name(context.Status)</MudText>
                </MudStack>
            </MudTd>
            <MudTd DataLabel="Abteilung" Class="@Col("abteilung")">
                <AuthorizeView Policy="@Policies.DivisionSetWrite" Context="abteilung">
                    <Authorized>
                        <MudTooltip Text="@DivisionRules.PickerHint(context.Rank)" Disabled="@(DivisionRules.PickerHint(context.Rank) is null)">
                            <MudSelect T="Division" Value="HomeOf(context)" ValueChanged="@(d => DivisionSet(context, d))"
                                       Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="min-width:110px;"
                                       Disabled="@(!HasDivision(context))">
                                @foreach (var d in DivisionDisplay.All)
                                {
                                    <MudSelectItem Value="d" Disabled="@(!DivisionRules.MayHold(d, context.Rank))">@DivisionDisplay.Short(d)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTooltip>
                    </Authorized>
                    <NotAuthorized>
                        <MudText Typo="Typo.body2">@(HasDivision(context) ? DivisionDisplay.Short(HomeOf(context)) : "—")</MudText>
                    </NotAuthorized>
                </AuthorizeView>
                @if (DivisionRules.Of(context).IsBoard)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Board</MudText>
                }
            </MudTd>
            <MudTd DataLabel="@DepartmentRules.ColumnLabel" Class="@Col("hrb")">
                <MudTooltip Text="@DepartmentRules.Hint" Disabled="@(context.PartnerAgency != null || DepartmentOpen(context))">
                    <MudSwitch T="bool" Value="context.IsHRB" ValueChanged="@(v => HrbSet(context, v))" Color="Color.Info"
                               Disabled="@(context.PartnerAgency != null || (!DepartmentOpen(context) && !context.IsHRB))" />
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="Teamleitung" Class="@Col("teamleitung")">
                <MudSwitch T="bool" Value="context.IsTeamLead" ValueChanged="@(v => TeamLeadSet(context, v))" Color="Color.Tertiary"
                           Disabled="@(context.PartnerAgency != null)" />
            </MudTd>
            <MudTd DataLabel="Admin" Class="@Col("admin")">
                <MudTooltip Text="@AdminToggleHint(context)" Disabled="@(_amAdmin && context.Id != _myId)">
                    <MudSwitch T="bool" Value="context.IsAdmin" ValueChanged="@(v => AdminSet(context, v))"
                               Color="Color.Secondary" Disabled="@(!_amAdmin || context.Id == _myId || context.PartnerAgency != null)" />
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="Aktion" Style="text-align:right;" Class="@Col("aktion")">
                <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Class="noose-mobil-aus">
                    <MudTooltip Text="Personalakte">
                        <MudIconButton Icon="@Icons.Material.Filled.Badge" Size="Size.Small" Color="Color.Default"
                                       Href="@($"/personal/{context.Id}")" aria-label="Personalakte öffnen" />
                    </MudTooltip>
                    <MudTooltip Text="Stammdaten bearbeiten">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                       OnClick="() => Edit(context)" aria-label="Stammdaten bearbeiten" />
                    </MudTooltip>
                    @if (context.Status == AgentStatus.Active && MayChangeAffiliation(context))
                    {
                        <MudTooltip Text="Zugehörigkeit ändern (intern FIB ↔ Partnerbehörde)">
                            <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small" Color="Color.Info"
                                           Disabled="@(context.Id == _myId)"
                                           OnClick="() => ChangeAffiliation(context)" aria-label="Zugehörigkeit ändern" />
                        </MudTooltip>
                    }
                    @if (context.Status == AgentStatus.Terminated)
                    {
                        @* Sperren würde die Kündigungsdaten überschreiben; Rücknahme sitzt in der Personalakte. *@
                        <MudTooltip Text="Kündigung wird in der Personalakte zurückgenommen">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                                       StartIcon="@Icons.Material.Filled.Badge"
                                       Href="@($"/personal/{context.Id}")">Personalakte</MudButton>
                        </MudTooltip>
                    }
                    else if (context.Status == AgentStatus.Blocked)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.LockOpen"
                                   OnClick="() => Unblock(context)">Entsperren</MudButton>
                    }
                    else
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Block"
                                   Disabled="@(context.Id == _myId)"
                                   OnClick="() => Block(context)">Sperren</MudButton>
                    }
                    @if (context.Id != _myId)
                    {
                        @* Deleting purges the recruitment blacklist along with the account. *@
                        <MudTooltip Text="@(context.Status == AgentStatus.Terminated
                                              ? "Nicht möglich: Das Löschen würde den Blacklist-Eintrag mit entfernen."
                                              : "Account vollständig löschen (unwiderruflich)")">
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" Size="Size.Small" Color="Color.Error"
                                           Disabled="@(context.Status == AgentStatus.Terminated)"
                                           OnClick="() => DeleteAccount(context)" aria-label="Account vollständig löschen" />
                        </MudTooltip>
                    }
                </MudStack>
                @* phones: the same actions under the same conditions in a ⋮ menu, deleting last after a line *@
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" Class="noose-nur-handy"
                         AriaLabel="Aktionen" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudMenuItem Icon="@Icons.Material.Filled.Badge" Href="@($"/personal/{context.Id}")">Personalakte</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="() => Edit(context)">Stammdaten bearbeiten</MudMenuItem>
                    @if (context.Status == AgentStatus.Active && MayChangeAffiliation(context))
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.SwapHoriz" Disabled="@(context.Id == _myId)"
                                     OnClick="() => ChangeAffiliation(context)">Zugehörigkeit ändern</MudMenuItem>
                    }
                    @if (context.Status == AgentStatus.Blocked)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.LockOpen" IconColor="Color.Success"
                                     OnClick="() => Unblock(context)">Entsperren</MudMenuItem>
                    }
                    else if (context.Status != AgentStatus.Terminated)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Block" IconColor="Color.Error" Disabled="@(context.Id == _myId)"
                                     OnClick="() => Block(context)">Sperren</MudMenuItem>
                    }
                    @if (context.Id != _myId)
                    {
                        <MudDivider Class="my-1" />
                        <MudMenuItem Icon="@Icons.Material.Filled.DeleteForever" IconColor="Color.Error"
                                     Disabled="@(context.Status == AgentStatus.Terminated)"
                                     OnClick="() => DeleteAccount(context)">Account vollständig löschen</MudMenuItem>
                    }
                </MudMenu>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Class="mud-text-secondary py-4">
                @(_tab switch
                {
                    1 => "Keine gesperrten Agenten.",
                    2 => "Keine Teamleitungen.",
                    3 => "Keine Partner-Konten.",
                    _ => "Keine aktiven Agenten.",
                })
            </MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;
    private List<Agent> _agents = new();
    private string? _myId;
    private bool _amAdmin;
    private PromotionStanding _standing;
    
    // Tabs: 0 active internal, 1 blocked, 2 team-lead, 3 partner. Partners show only in the partner tab.
    private int _tab;

    // partner-tab filters
    private string _search = string.Empty;
    private PartnerAgency? _agencyFilter;
    private PartnerRank? _rankFilter;

    // phones only: whether the two partner selects are unfolded under the search
    private bool _filtersOpen;
    private int ActiveFilterCount => (_agencyFilter is null ? 0 : 1) + (_rankFilter is null ? 0 : 1);
    private string FilterClass => _filtersOpen ? "noose-filter-feld" : "noose-filter-feld noose-filter-zu";

    /// <summary>The table's columns for the phone column picker, in table order.</summary>
    private static readonly IReadOnlyList<(string Key, string Label)> PhoneColumns =
    [
        ("agent", "Agent"), ("dienstgrad", "Dienstgrad"), ("status", "Status"), ("abteilung", "Abteilung"),
        ("hrb", DepartmentRules.ColumnLabel), ("teamleitung", "Teamleitung"), ("admin", "Admin"), ("aktion", "Aktion"),
    ];

    /// <summary>What a phone shows until the agent chooses: who, their rank, and the row's actions.</summary>
    private static readonly IReadOnlyList<string> PhoneDefaults = ["agent", "dienstgrad", "aktion"];

    // the defaults until the picker reports the stored choice, so even the first paint is narrow on a phone
    private IReadOnlySet<string> _phoneColumns = MobileColumnSet.Resolve(PhoneColumns.Select(c => c.Key).ToList(), PhoneDefaults, null);

    // below 600px only; from 600px up every column shows, as before
    private string Col(string key) => MobileColumnSet.ClassFor(_phoneColumns, key);

    private IEnumerable<Agent> VisibleAgents => _tab switch
    {
        1 => _agents.Where(a => a.Status == AgentStatus.Blocked),
        2 => _agents.Where(a => a.Status == AgentStatus.Active && a.IsTeamLead),
        3 => PartnerAgents,
        4 => _agents.Where(a => a.Status == AgentStatus.Terminated).OrderByDescending(a => a.TerminatedAt),
        _ => _agents.Where(AgentSelection.IsSelectable),
    };

    private IEnumerable<Agent> PartnerAgents
    {
        get
        {
            var query = _agents.Where(a => a.Status == AgentStatus.Active && a.PartnerAgency != null);
            if (_agencyFilter is { } agency)
            {
                query = query.Where(a => a.PartnerAgency == agency);
            }
            if (_rankFilter is { } rank)
            {
                query = query.Where(a => a.PartnerRank == rank);
            }
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                query = query.Where(a => (a.Codename ?? string.Empty).Contains(s, StringComparison.OrdinalIgnoreCase)
                                       || (a.RealName ?? string.Empty).Contains(s, StringComparison.OrdinalIgnoreCase));
            }
            return query;
        }
    }

    private int CountActive => _agents.Count(AgentSelection.IsSelectable);
    private int CountBlocked => _agents.Count(a => a.Status == AgentStatus.Blocked);
    private int CountTeamLead => _agents.Count(a => a.Status == AgentStatus.Active && a.IsTeamLead);
    private int CountPartner => _agents.Count(a => a.Status == AgentStatus.Active && a.PartnerAgency != null);
    private int CountTerminated => _agents.Count(a => a.Status == AgentStatus.Terminated);

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateTask).User;
        _myId = user.GetAgentId();
        _amAdmin = user.IsAdmin();
        _standing = PromotionStanding.Of(user);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _load = true;
        _agents = await AgentService.GetAllAsync();
        _load = false;
    }

    private async Task Edit(Agent agent)
    {
        var badgeNumberOptions = await AgentService.GetAvailableBadgeNumbersAsync(agent.Id);
        var result = await AgentEditDialog.ShowAsync(DialogService, agent, badgeNumberOptions);
        if (result is null)
        {
            return;
        }
        var user = (await AuthStateTask).User;
        try
        {
            await AgentService.MasterDataChangeAsync(agent.Id, result.RealName, result.Codename, result.BadgeNumber, user);
            Snackbar.Add($"Stammdaten von {result.Codename} gespeichert.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ChangeAffiliation(Agent agent)
    {
        var result = await AgentAffiliationDialog.ShowAsync(DialogService, agent);
        if (result is null)
        {
            return;
        }
        var user = (await AuthStateTask).User;
        try
        {
            if (result.Agency is { } agency)
            {
                await AgentService.ConvertToPartnerAsync(agent.Id, agency, result.PartnerRank, user);
                Snackbar.Add($"{DisplayName(agent)}: Zugehörigkeit auf {PartnerRankDisplay.Full(agency, result.PartnerRank)} gesetzt.", Severity.Success);
            }
            else
            {
                if (await DivisionLimitConfirm.RunAsync(DialogService,
                        confirm => AgentService.ConvertToInternalAsync(agent.Id, result.Rank, confirm, user)))
                {
                    Snackbar.Add($"{DisplayName(agent)}: Zugehörigkeit auf interner FIB-Agent ({RankDisplay.Name(result.Rank)}) gesetzt.", Severity.Success);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await LoadAsync();
    }

    private async Task RankChange(Agent agent, Rank degree)
    {
        if (agent.Rank == degree)
        {
            return;
        }
        var user = (await AuthStateTask).User;
        try
        {
            if (await DivisionLimitConfirm.RunAsync(DialogService,
                    confirm => AgentService.RankChangeAsync(agent.Id, degree, confirm, user)))
            {
                Snackbar.Add($"{DisplayName(agent)}: Dienstgrad auf {RankDisplay.Name(degree)} gesetzt.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await LoadAsync();
    }

    private async Task PartnerRankChange(Agent agent, PartnerRank rank)
    {
        if (agent.PartnerRank == rank)
        {
            return;
        }
        var user = (await AuthStateTask).User;
        try
        {
            await AgentService.SetPartnerRankAsync(agent.Id, rank, user);
            Snackbar.Add($"{DisplayName(agent)}: Partner-Rang auf {PartnerRankDisplay.Full(agent.PartnerAgency, rank)} gesetzt.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await LoadAsync();
    }

    /// <summary>Ranks the viewer may set, plus the current one.</summary>
    private List<Rank> RankOptions(Agent agent)
    {
        var allowed = PromotionRules.AssignableRanks(_standing, HomeOf(agent), agent.Rank);
        if (allowed.Count == 0)
        {
            return [];
        }
        return RankDisplay.All.Where(r => r == agent.Rank || allowed.Contains(r)).ToList();
    }

    /// <summary>Mirrors the service: an agent with a rank passes the fine gate, a partner stays with the leadership.</summary>
    private bool MayChangeAffiliation(Agent agent)
        => agent.Rank is not { } rank || PromotionRules.MayConvertToPartner(_standing, HomeOf(agent), rank);

    /// <summary>Mirrors DepartmentRules.MayHold; a switch the service then refuses is a dialog that fails on save.</summary>
    private static bool DepartmentOpen(Agent agent) => DepartmentRules.MayHold(agent.Rank);

    /// <summary>Only an active internal agent with a rank has a division to pick.</summary>
    private static bool HasDivision(Agent agent) => agent.Status == AgentStatus.Active && !DivisionRules.Of(agent).IsNone;

    private static Division HomeOf(Agent agent) => DivisionRules.Of(agent).Home ?? Division.Cid;

    private async Task DivisionSet(Agent agent, Division division)
    {
        if (HomeOf(agent) == division)
        {
            return;
        }
        var user = (await AuthStateTask).User;
        try
        {
            if (await DivisionLimitConfirm.RunAsync(DialogService,
                    confirm => AgentService.DivisionSetAsync(agent.Id, division, confirm, user)))
            {
                Snackbar.Add($"{DisplayName(agent)}: Abteilung {DivisionDisplay.Short(division)} gesetzt.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await LoadAsync();
    }

    private async Task HrbSet(Agent agent, bool value)
    {
        var user = (await AuthStateTask).User;
        try
        {
            await AgentService.HrbSetAsync(agent.Id, value, user);
            Snackbar.Add($"{DisplayName(agent)}: Administration Division {(value ? "gesetzt" : "entfernt")}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await LoadAsync();
    }

