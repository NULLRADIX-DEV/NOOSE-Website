@page "/einstellungen"
@attribute [Authorize(Policy = Policies.LeadershipPage)]
@using NOOSE_Website.Navigation
@inject NavigationManager Nav

<PageTitle>Einstellungen · NOOSE</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.SettingsApplications"
            Title="Einstellungen"
            Subtitle="Alles, was sich an der Seite konfigurieren lässt, an einer Stelle." />

@* Admin-only sections are wrapped, so they neither render nor register a rail button. *@
<RecordSectionRail>
    <AuthorizeView Policy="@Policies.AdminPage" Context="systemSection">
        <RecordSection Group="Betrieb" Slug="system" Label="System &amp; Erscheinungsbild"
                       Icon="@Icons.Material.Filled.SettingsApplications">
            <SystemSettingsPanel />
        </RecordSection>
    </AuthorizeView>

    <RecordSection Group="Betrieb" Slug="discord" Label="Discord-Benachrichtigungen"
                   Icon="@Icons.Material.Filled.Notifications">
        <DiscordPanel />
    </RecordSection>

    <RecordSection Group="Betrieb" Slug="bester-agent" Label="Bester Agent"
                   Icon="@Icons.Material.Filled.EmojiEvents">
        <BestAgentPanel />
    </RecordSection>

    <RecordSection Group="Betrieb" Slug="neuerungen" Label="Neuerungen"
                   Icon="@Icons.Material.Filled.NewReleases">
        <ChangelogPanel />
    </RecordSection>

    <AuthorizeView Policy="@Policies.AdminPage" Context="statusSection">
        <RecordSection Group="Betrieb" Slug="status" Label="System-Status"
                       Icon="@Icons.Material.Filled.MonitorHeart">
            <SystemStatusPanel />
        </RecordSection>
    </AuthorizeView>

    <RecordSection Group="Akten-Konfiguration" Slug="custom-felder" Label="Custom-Felder"
                   Icon="@Icons.Material.Filled.Tune">
        <CustomFieldDefinitionsPanel />
    </RecordSection>
    <RecordSection Group="Akten-Konfiguration" Slug="tags" Label="Tags"
                   Icon="@Icons.Material.Filled.Label">
        <TagsPanel />
    </RecordSection>
    <RecordSection Group="Akten-Konfiguration" Slug="aktualitaet" Label="Aktualitäts-Ampel"
                   Icon="@Icons.Material.Filled.Timelapse">
        <RecencyPanel />
    </RecordSection>
    <RecordSection Group="Akten-Konfiguration" Slug="bedrohungs-score" Label="Bedrohungs-Score"
                   Icon="@Icons.Material.Filled.Speed">
        <ThreatScorePanel />
    </RecordSection>

    @* the former /admin/vorlagen tab page: one rail section per template family *@
    <RecordSection Group="Vorlagen" Slug="vorlagen-dok" Label="Dok-Vorlagen"
                   Icon="@Icons.Material.Filled.Dvr">
        <DocTemplatesManagement />
    </RecordSection>
    <RecordSection Group="Vorlagen" Slug="vorlagen-dokument" Label="Dokument-Vorlagen"
                   Icon="@Icons.Material.Filled.Article">
        <DocumentTemplatesManagement />
    </RecordSection>
    <RecordSection Group="Vorlagen" Slug="vorlagen-aktivitaet" Label="Aktivitäts-Vorlagen"
                   Icon="@Icons.Material.Filled.Bolt">
        <ActivityTemplatesManagement />
    </RecordSection>
    <RecordSection Group="Vorlagen" Slug="vorlagen-personal" Label="Personal-Vorlagen"
                   Icon="@Icons.Material.Filled.Badge">
        <PersonnelTemplatesManagement />
    </RecordSection>

    <RecordSection Group="Personal" Slug="module" Label="Ausbildungsmodule"
                   Icon="@Icons.Material.Filled.School">
        <TrainingModulesPanel />
    </RecordSection>
    <RecordSection Group="Personal" Slug="einladungen" Label="Einladungen"
                   Icon="@Icons.Material.Filled.PersonAddAlt">
        <InvitesPanel />
    </RecordSection>
    <RecordSection Group="Personal" Slug="ehrenzeichen" Label="Ehrenzeichen"
                   Icon="@Icons.Material.Filled.MilitaryTech">
        <DecorationCatalogPanel />
    </RecordSection>
    <RecordSection Group="Personal" Slug="inaktivitaet" Label="Inaktivitäts-Radar"
                   Icon="@Icons.Material.Filled.HourglassBottom">
        <InactivityThresholdsPanel />
    </RecordSection>

    <RecordSection Group="Finanzierung" Slug="finanzierung" Label="Budget-Regeln"
                   Icon="@Icons.Material.Filled.RequestQuote">
        <FinancingRulesPanel />
    </RecordSection>

    <RecordSection Group="KI" Slug="noosei" Label="NOOSEI-Betrieb"
                   Icon="@Icons.Material.Filled.SmartToy">
        <NooseiOperationsPanel />
    </RecordSection>
    @* the switch itself is AI-owner-only inside the panel; leadership reads which upstream is serving them *@
    <RecordSection Group="KI" Slug="ki-anbieter" Label="Anbieter"
                   Icon="@Icons.Material.Filled.SwapHoriz">
        <NooseiProviderPanel />
    </RecordSection>
    <RecordSection Group="KI" Slug="ki-regeln" Label="Token-Regeln"
                   Icon="@Icons.Material.Filled.Rule">
        <LlmQuotaRulesPanel />
    </RecordSection>
    @* aggregates only, no prompt text — so this stays at leadership and needs no counter-intel gate *@
    <RecordSection Group="KI" Slug="ki-betrieb" Label="Betriebszahlen"
                   Icon="@Icons.Material.Filled.QueryStats">
        <NooseiHealthPanel />
    </RecordSection>
    <RecordSection Group="KI" Slug="ki-kontingente" Label="Kontingente"
                   Icon="@Icons.Material.Filled.Token">
        <LlmQuotaOverviewPanel @bind-Unseen="_anomaliesUnseen" />
    </RecordSection>
    @* Prompts and answers are stored in full: agents do paste real names, and supervision must never see those. *@
    <AuthorizeView Policy="@Policies.CounterIntel" Context="kiLogSection">
        <RecordSection Group="KI" Slug="ki-anfragen" Label="Anfragen"
                       Icon="@Icons.Material.Filled.Forum">
            <LlmRequestLogPanel />
        </RecordSection>
    </AuthorizeView>

    <AuthorizeView Policy="@Policies.AdminPage" Context="partnerSection">
        <RecordSection Group="Partnerbehörden" Slug="partner" Label="Sichtbarkeit &amp; Freigaben"
                       Icon="@Icons.Material.Filled.Handshake">
            <PartnerPanel />
        </RecordSection>
    </AuthorizeView>

    <AuthorizeView Policy="@Policies.AdminPage" Context="publicModulesSection">
        <RecordSection Group="Öffentlicher Bereich" Slug="oeffentliche-module" Label="Module &amp; Not-Aus"
                       Icon="@Icons.Material.Filled.ToggleOn">
            <PublicModulesPanel />
        </RecordSection>
    </AuthorizeView>

    <RecordSection Group="Öffentlicher Bereich" Slug="oeffentliche-seiten" Label="Öffentliche Seiten"
                   Icon="@Icons.Material.Filled.MenuBook">
        <PublicPagesPanel />
    </RecordSection>

    <RecordSection Group="Öffentlicher Bereich" Slug="oeffentliche-faq" Label="Häufige Fragen"
                   Icon="@Icons.Material.Filled.QuestionAnswer">
        <PublicFaqPanel />
    </RecordSection>

    <RecordSection Group="Öffentlicher Bereich" Slug="presse" Label="Pressemitteilungen"
                   Icon="@Icons.Material.Filled.Feed">
        <PressPanel />
    </RecordSection>

    <RecordSection Group="Öffentlicher Bereich" Slug="lage" Label="Gefahrenlage"
                   Icon="@Icons.Material.Filled.Speed">
        <PublicSituationPanel />
    </RecordSection>

    <RecordSection Group="Öffentlicher Bereich" Slug="warnungen" Label="Öffentliche Warnungen"
                   Icon="@Icons.Material.Filled.Campaign">
        <PublicWarningsPanel />
    </RecordSection>

    <RecordSection Group="Öffentlicher Bereich" Slug="berichte" Label="Öffentliche Lageberichte"
                   Icon="@Icons.Material.Filled.Assessment">
        <PublicReportsPanel />
    </RecordSection>

    <RecordSection Group="Öffentlicher Bereich" Slug="recht" Label="Gesetzesauszüge"
                   Icon="@Icons.Material.Filled.Gavel">
        <PublicLawPanel />
    </RecordSection>

    <RecordSection Group="Öffentlicher Bereich" Slug="oeffentliche-kennzahlen" Label="Kennzahlen"
                   Icon="@Icons.Material.Filled.QueryStats">
        <PublicKpiPanel />
    </RecordSection>

    @* Row order, phone and photo would pair every codename with its public card; supervision stays out. *@
    <AuthorizeView Policy="@Policies.CounterIntel" Context="rosterSection">
        <RecordSection Group="Öffentlicher Bereich" Slug="oeffentliche-fuehrung" Label="Mitarbeiterliste"
                       Icon="@Icons.Material.Filled.Groups">
            <PublicLeadershipPanel />
        </RecordSection>
    </AuthorizeView>

    <RecordSection Group="Öffentlicher Bereich" Slug="warnhinweise" Label="Warnhinweise"
                   Icon="@Icons.Material.Filled.Warning">
        <WarnhinweisPanel />
    </RecordSection>

    <RecordSection Group="Öffentlicher Bereich" Slug="oeffentliche-vorlagen" Label="Öffentliche Vorlagen"
                   Icon="@Icons.Material.Filled.Mail">
        <PublicTemplatesPanel />
    </RecordSection>

    <RecordSection Group="Öffentlicher Bereich" Slug="buerger" Label="Bürgerkonten"
                   Icon="@Icons.Material.Filled.Person">
        <PublicCitizensPanel />
    </RecordSection>

    @* Protokoll and Gegenaufklärung moved to /nachweis; only the value lists stay here. *@
    <RecordSection Group="Nachweis" Slug="basisdaten" Label="Wertelisten"
                   Icon="@Icons.Material.Filled.Storage">
        <BaseDataPanel />
    </RecordSection>
</RecordSectionRail>

@code {
    // on the page, not in the panel: the rail rebuilds a panel on every section switch
    private UnseenFindings? _anomaliesUnseen;

    // three sections left for /nachweis; forward old deep links instead of silently falling back
    protected override void OnInitialized()
    {
        if (LegacyRoutes.MovedSettingsTab(QueryState.Read(Nav, "tab")) is { } target)
        {
            Nav.NavigateTo(target, replace: true);
        }
    }
}
