@* Full-text editor for an activity template (HTML body). *@
@page "/admin/vorlagen/aktivitaet-vorlage/neu"
@page "/admin/vorlagen/aktivitaet-vorlage/{Id}/bearbeiten"
@attribute [Authorize(Policy = Policies.LeadershipPage)]
@using System.Security.Claims
@inject IActivityTemplateService TemplateService
@inject IPlaceholderService Placeholder
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>@(_edit ? "Vorlage bearbeiten" : "Neue Aktivitäts-Vorlage") · FIB</PageTitle>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_edit && !_found)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Vorlage nicht gefunden.</MudAlert>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="Cancel" aria-label="Zurück" />
        <MudIcon Icon="@Icons.Material.Filled.Dvr" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h4">@(_edit ? "Aktivitäts-Vorlage bearbeiten" : "Neue Aktivitäts-Vorlage")</MudText>
        <MudSpacer />
        <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Default">Abbrechen</MudButton>
        <MudButton OnClick="SaveAsync" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="_saves">Speichern</MudButton>
    </MudStack>

    <MudPaper Class="pa-4" Elevation="2">
        <MudStack Spacing="3">
            <MudGrid>
                <MudItem xs="12" md="7">
                    <MudTextField @bind-Value="_name" Label="Name der Vorlage" Variant="Variant.Outlined" Required="true"
                                  RequiredError="Name ist erforderlich" AutoFocus="true" />
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudTextField @bind-Value="_kind" Label="Standard-Art (optional)" Variant="Variant.Outlined"
                                  Placeholder="z. B. Streife, Ermittlung" />
                </MudItem>
            </MudGrid>
            <MudTextField @bind-Value="_description" Label="Beschreibung (optional)" Lines="2" Variant="Variant.Outlined" />
            <MudGrid>
                <MudItem xs="6">
                    <MudSwitch @bind-Value="_isActive" Color="Color.Primary" Label="Aktiv (im Picker auswählbar)" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField @bind-Value="_sorting" Label="Sortierung" Variant="Variant.Outlined" Min="0" />
                </MudItem>
            </MudGrid>

            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                <MudText Typo="Typo.body2" Class="mb-1">Verfügbare Platzhalter (beim Anlegen einer Aktivität automatisch ersetzt):</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                    @foreach (var (token, description) in Placeholder.AvailablePlaceholder)
                    {
                        <MudTooltip Text="@description">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">@token</MudChip>
                        </MudTooltip>
                    }
                </MudStack>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    {{Name}} und {{Aktenzeichen}} stammen aus der ersten verknüpften Fraktion / Personengruppe – ohne Verknüpfung bleiben sie leer.
                </MudText>
            </MudAlert>

            <MudText Typo="Typo.subtitle2">Vorlagen-Inhalt</MudText>
            <RichTextEditor @ref="_editor" Value="@_contentHtml" MinHeight="360px" Ai="TextAssistContext.ActivityTemplate" Mentions="true"
                            DraftKey='@(_edit ? $"vorlage-aktivitaet:{Id}" : "vorlage-aktivitaet:neu")' />
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter] public string? Id { get; set; }

    private RichTextEditor _editor = default!;
    private ClaimsPrincipal _user = default!;

    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;
    private bool _edit;
    private bool _found;
    private bool _saves;

    private string _name = string.Empty;
    private string? _description;
    private string? _kind;
    private bool _isActive = true;
    private int _sorting;
    private string? _contentHtml;

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _edit = !string.IsNullOrEmpty(Id);

        if (_edit)
        {
            var template = await TemplateService.GetAsync(Id!);
            if (template is not null)
            {
                _found = true;
                _name = template.Name;
                _description = template.Description;
                _kind = template.Kind;
                _isActive = template.IsActive;
                _sorting = template.Sorting;
                _contentHtml = template.ContentHtml;
            }
        }

        _load = false;
    }

    private async Task SaveAsync()
    {
        var name = _name?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(name))
        {
            Snackbar.Add("Bitte einen Namen angeben.", Severity.Warning);
            return;
        }

        _saves = true;
        try
        {
            var html = await _editor.GetHtmlAsync();
            var input = new ActivityTemplateInput
            {
                Name = name,
                Description = _description,
                Kind = _kind,
                ContentHtml = html,
                IsActive = _isActive,
                Sorting = _sorting,
            };

            if (_edit)
            {
                await TemplateService.RefreshAsync(Id!, input, _user);
            }
            else
            {
                await TemplateService.CreateAsync(input, _user);
            }

            await _editor.MarkSavedAsync();
            Snackbar.Add("Vorlage gespeichert.", Severity.Success);
            Nav.NavigateTo("/einstellungen?tab=vorlagen-aktivitaet");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saves = false;
        }
    }

    private void Cancel() => Nav.NavigateTo("/einstellungen?tab=vorlagen-aktivitaet");
}
