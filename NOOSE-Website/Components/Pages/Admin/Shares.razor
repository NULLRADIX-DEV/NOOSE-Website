@page "/admin/freigaben"
@* Inbox: upgrade and publication requests are decided by Senior Special Agent+; the other four sections are leadership-only. *@
@attribute [Authorize(Policy = Policies.HighestClassificationPage)]
@inject IAgentManagementService AgentService
@inject ITaskforceService TaskforceService
@inject IPersonnelFileService PersonnelFileService
@inject IRequestService RequestService
@inject IPartnerShareService PartnerShareService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject SharesBroadcaster SharesBroadcaster
@inject NOOSE_Website.Services.Public.IPublicWantedService PublicWanted
@inject NOOSE_Website.Services.Public.IBountyService Bounty
@using NOOSE_Website.Models.Enums
@using NOOSE_Website.Models.Public

<PageTitle>Freigaben · NOOSE</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
    <MudIcon Icon="@Icons.Material.Filled.HowToReg" Color="Color.Primary" Size="Size.Large" />
    <MudText Typo="Typo.h4">Freigabe-Posteingang</MudText>
</MudStack>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">
    Hochstufungs- und Veröffentlichungs-Anträge sowie – für die Führung – Partner-Freigabe-Anträge, neu registrierte Discord-Konten,
    beantragte Stammdatenänderungen, Taskforce- und Beförderungsanträge warten hier auf Entscheidung.
</MudText>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudText Typo="Typo.h6" Class="mb-2">Hochstufungs-Anträge</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
        Anträge auf die Einstufung „Gesichert staatsgefährdend“. Die Entscheidung trifft Senior Special Agent
        aufwärts bzw. ein Admin; bei Genehmigung wird die Einstufung der Akte gesetzt und im Verlauf protokolliert.
    </MudText>
    @if (_openUpgrades.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Keine offenen Hochstufungs-Anträge.</MudAlert>
    }
    else
    {
        <MudTable Items="_openUpgrades" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="2">
            <HeaderContent>
                <MudTh><MudTableSortLabel T="Request" SortBy="@(x => x.TargetDesignation)">Ziel-Akte</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="Request" SortBy="@(x => x.TargetClassification)">Gewünscht</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="Request" SortBy="@(x => x.Justification)">Begründung</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="Request" SortBy="@(x => x.CreatedAt)">Beantragt</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:right;">Aktion</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Ziel-Akte">
                    <MudLink Href="@SearchNavigation.For(context.TargetType, context.TargetId)" Typo="Typo.body2">@context.TargetDesignation</MudLink>
                </MudTd>
                <MudTd DataLabel="Gewünscht"><ClassificationBadge Value="context.TargetClassification" /></MudTd>
                <MudTd DataLabel="Begründung">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@if (string.IsNullOrWhiteSpace(context.Justification)) { <text>—</text> } else { <MentionDisplay Text="@context.Justification" /> }</MudText>
                </MudTd>
                <MudTd DataLabel="Beantragt">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@(context.RequesterName ?? "—") · @context.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                </MudTd>
                <MudTd DataLabel="Aktion" Style="text-align:right;">
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Check" Class="mr-2"
                               OnClick="() => UpgradeDecide(context, true)">Genehmigen</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Close"
                               OnClick="() => UpgradeDecide(context, false)">Ablehnen</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    <MudDivider Class="my-6" />

    @* outside the leadership block on purpose: a publication is decided at Senior Special Agent, like the table above *@
    <MudText Typo="Typo.h6" Class="mb-2">Veröffentlichungs-Anträge</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
        Anträge, eine Personenakte öffentlich auszuschreiben. Bei Genehmigung geht der Steckbrief sofort online;
        eine inzwischen eingestufte Akte wird abgewiesen.
    </MudText>
    @if (_openPublications.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Keine offenen Veröffentlichungs-Anträge.</MudAlert>
    }
    else
    {
        <MudTable Items="_openPublications" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="2">
            <HeaderContent>
                <MudTh>Ziel-Akte</MudTh>
                <MudTh>Anzeigename</MudTh>
                <MudTh>Begründung</MudTh>
                <MudTh>Beantragt</MudTh>
                <MudTh Style="text-align:right;">Aktion</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Ziel-Akte">
                    <MudText Typo="Typo.body2">@context.TargetDesignation</MudText>
                </MudTd>
                <MudTd DataLabel="Anzeigename"><MudText Typo="Typo.body2">@context.DisplayName</MudText></MudTd>
                <MudTd DataLabel="Begründung">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@(string.IsNullOrWhiteSpace(context.Justification) ? "—" : context.Justification)</MudText>
                </MudTd>
                <MudTd DataLabel="Beantragt">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@(context.RequesterName ?? "—") · @context.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                </MudTd>
                <MudTd DataLabel="Aktion" Style="text-align:right;">
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Check" Class="mr-2"
                               OnClick="() => PublicationDecide(context, true)">Genehmigen</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Close"
                               OnClick="() => PublicationDecide(context, false)">Ablehnen</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    <MudDivider Class="my-6" />

    @* same gate as the publications above: agency money is committed from Senior Special Agent upwards *@
    <MudText Typo="Typo.h6" Class="mb-2">Kopfgeld-Anträge</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
        Anträge, behördliches Geld auf einen Kopf zu setzen. Erst mit der Genehmigung zählt der Anteil zur
        öffentlich sichtbaren Summe; abgelehnt wird er zurückgezogen.
    </MudText>
    @if (_openBounties.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Keine offenen Kopfgeld-Anträge.</MudAlert>
    }
    else
    {
        <MudTable Items="_openBounties" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="2">
            <HeaderContent>
                <MudTh>Ziel-Akte</MudTh>
                <MudTh>Betrag</MudTh>
                <MudTh>Begründung</MudTh>
                <MudTh>Beantragt</MudTh>
                <MudTh Style="text-align:right;">Aktion</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Ziel-Akte">
                    <MudText Typo="Typo.body2">@context.TargetDesignation</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.DisplayName</MudText>
                </MudTd>
                <MudTd DataLabel="Betrag">
                    <MudText Typo="Typo.body2">@context.Amount.ToString("N0") $</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @(context.Account is { } a ? KassenKontoDisplay.Name(a) : "—")
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Begründung">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@(string.IsNullOrWhiteSpace(context.Justification) ? "—" : context.Justification)</MudText>
                </MudTd>
                <MudTd DataLabel="Beantragt">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@(context.RequesterName ?? "—") · @context.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                </MudTd>
                <MudTd DataLabel="Aktion" Style="text-align:right;">
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Check" Class="mr-2"
                               OnClick="() => BountyDecide(context, true)">Genehmigen</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Close"
                               OnClick="() => BountyDecide(context, false)">Ablehnen</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    <AuthorizeView Policy="@Policies.Leadership" Context="fuehrung">
    <MudDivider Class="my-6" />

    <MudText Typo="Typo.h6" Class="mb-2">Registrierungen</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
        Beim Freischalten wird ein Dienstgrad vergeben; danach erhält der Agent beim nächsten Login Zugriff.
        Wird stattdessen eine Partnerbehörde gewählt, erhält das Konto nur lesenden Partner-Zugriff (kein Rang).
    </MudText>
    @if (_pending.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Keine ausstehenden Registrierungen.</MudAlert>
    }
    else
    {
        <MudTable Items="_pending" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="2">
            <HeaderContent>
                <MudTh><MudTableSortLabel T="Agent" SortBy="@(x => DisplayName(x))">Agent</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="Agent" SortBy="@(x => x.DiscordUsername ?? x.DiscordId)">Discord</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="Agent" SortBy="@(x => x.RegisteredAt)">Registriert</MudTableSortLabel></MudTh>
                <MudTh Style="min-width:220px;"><MudTableSortLabel T="Agent" SortBy="@(x => (int)Selection(x.Id).Degree)">Dienstgrad</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="Agent" SortBy="@(x => Selection(x.Id).Tru)">TRU</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="Agent" SortBy="@(x => Selection(x.Id).Hrb)">HRB</MudTableSortLabel></MudTh>
                <MudTh Style="min-width:170px;">Partner</MudTh>
                <MudTh Style="text-align:right;">Aktion</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Agent">
                    <MudText Typo="Typo.body2">@DisplayName(context)</MudText>
                </MudTd>
                <MudTd DataLabel="Discord">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@(context.DiscordUsername ?? context.DiscordId)</MudText>
                </MudTd>
                <MudTd DataLabel="Registriert">
                    <MudText Typo="Typo.caption">@context.RegisteredAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                </MudTd>
                <MudTd DataLabel="Dienstgrad">
                    <MudSelect T="Rank" @bind-Value="Selection(context.Id).Degree" Dense="true" Margin="Margin.Dense"
                               Variant="Variant.Outlined">
                        @foreach (var dg in RankDisplay.All)
                        {
                            <MudSelectItem Value="dg">@RankDisplay.Name(dg)</MudSelectItem>
                        }
                    </MudSelect>
                </MudTd>
                <MudTd DataLabel="TRU">
                    <MudTooltip Text="@DepartmentHint" Disabled="Selection(context.Id).DepartmentsOpen">
                        <MudCheckBox T="bool" @bind-Value="Selection(context.Id).Tru" Color="Color.Primary"
                                     Disabled="@(!Selection(context.Id).DepartmentsOpen)" />
                    </MudTooltip>
                </MudTd>
                <MudTd DataLabel="HRB">
                    <MudTooltip Text="@DepartmentHint" Disabled="Selection(context.Id).DepartmentsOpen">
                        <MudCheckBox T="bool" @bind-Value="Selection(context.Id).Hrb" Color="Color.Info"
                                     Disabled="@(!Selection(context.Id).DepartmentsOpen)" />
                    </MudTooltip>
                </MudTd>
                <MudTd DataLabel="Partner">
                    <MudSelect T="PartnerAgency?" @bind-Value="Selection(context.Id).Partner" Dense="true" Margin="Margin.Dense"
                               Variant="Variant.Outlined" Clearable="true" Placeholder="— (interner Agent)">
                        @foreach (var agency in PartnerAgencyDisplay.All)
                        {
                            <MudSelectItem T="PartnerAgency?" Value="@((PartnerAgency?)agency)">@PartnerAgencyDisplay.Name(agency)</MudSelectItem>
                        }
                    </MudSelect>
                    @if (Selection(context.Id).Partner is not null)
                    {
                        <MudSelect T="PartnerRank" @bind-Value="Selection(context.Id).PartnerDegree" Dense="true" Margin="Margin.Dense"
                                   Variant="Variant.Outlined" Class="mt-1">
                            @foreach (var pr in PartnerRankDisplay.All)
                            {
                                <MudSelectItem Value="pr">@(PartnerRankDisplay.Suffix(pr) is { Length: > 0 } s ? s : "Standard")</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </MudTd>
                <MudTd DataLabel="Aktion" Style="text-align:right;">
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Check" Class="mr-2"
                               OnClick="() => Release(context)">Freigeben</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Close"
                               OnClick="() => Reject(context)">Ablehnen</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    <MudDivider Class="my-6" />

    <MudText Typo="Typo.h6" Class="mb-2">Namensänderungen</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
        Selbst beantragte Stammdatenänderungen von Agenten unterhalb Supervisory. Beim Genehmigen werden die
        Werte übernommen; der Agent sieht den neuen Namen beim nächsten Login.
    </MudText>
    @if (_nameChanges.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Keine offenen Namensänderungen.</MudAlert>
    }
    else
    {
        <MudTable Items="_nameChanges" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="2">
            <HeaderContent>
                <MudTh><MudTableSortLabel T="Agent" SortBy="@(x => DisplayName(x))">Agent</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="Agent" SortBy="@(x => x.NameChangeRequestedAt)">Beantragt</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="Agent" SortBy="@(x => Changes(x).Count)">Änderungen</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:right;">Aktion</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Agent">
                    <MudText Typo="Typo.body2">@DisplayName(context)</MudText>
                </MudTd>
                <MudTd DataLabel="Beantragt">
                    <MudText Typo="Typo.caption">@(context.NameChangeRequestedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))</MudText>
                </MudTd>
                <MudTd DataLabel="Änderungen">
                    <MudStack Spacing="0">
                        @foreach (var field in Changes(context))
                        {
                            <MudText Typo="Typo.caption">
                                <b>@field.Label:</b> <span>@field.Alt → @field.New</span>
                            </MudText>
                        }
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Aktion" Style="text-align:right;">
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Check" Class="mr-2"
                               OnClick="() => NamesApprove(context)">Genehmigen</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Close"
                               OnClick="() => NamesReject(context)">Ablehnen</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    <MudDivider Class="my-6" />

    <MudText Typo="Typo.h6" Class="mb-2">Profilbilder</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
        Selbst eingereichte Profilbilder von Agenten unterhalb Supervisory. Beim Genehmigen wird das Bild
        sofort überall sichtbar; beim Ablehnen wird es verworfen.
    </MudText>
    @if (_avatars.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Keine offenen Profilbilder.</MudAlert>
    }
    else
    {
        <MudTable Items="_avatars" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="2">
            <HeaderContent>
                <MudTh>Bild</MudTh>
                <MudTh><MudTableSortLabel T="Agent" SortBy="@(x => DisplayName(x))">Agent</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="Agent" SortBy="@(x => x.AvatarRequestedAt)">Beantragt</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:right;">Aktion</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Bild">
                    <MudAvatar Rounded="true" Style="height:64px;width:64px;">
                        <MudImage Src="@AgentAvatar.Url(context.PendingAvatarFileName)"
                                  Alt="@($"Beantragtes Profilbild von {DisplayName(context)}")" />
                    </MudAvatar>
                </MudTd>
                <MudTd DataLabel="Agent">
                    <MudText Typo="Typo.body2">@DisplayName(context)</MudText>
                </MudTd>
                <MudTd DataLabel="Beantragt">
                    <MudText Typo="Typo.caption">@(context.AvatarRequestedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))</MudText>
                </MudTd>
                <MudTd DataLabel="Aktion" Style="text-align:right;">
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Check" Class="mr-2"
                               OnClick="() => AvatarApprove(context)">Genehmigen</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Close"
                               OnClick="() => AvatarReject(context)">Ablehnen</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    <MudDivider Class="my-6" />

    <MudText Typo="Typo.h6" Class="mb-2">Taskforce-Anträge</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
        Beantragte Taskforces warten auf Genehmigung. Beim Genehmigen wird die Einsatzgruppe aktiv; beim Ablehnen wird der Antrag abgelehnt.
    </MudText>
    @if (_requestedTaskforces.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Keine offenen Taskforce-Anträge.</MudAlert>
    }
    else
    {
        <MudTable Items="_requestedTaskforces" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="2">
            <HeaderContent>
                <MudTh><MudTableSortLabel T="Taskforce" SortBy="@(x => x.CaseNumber)">Aktenzeichen</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="Taskforce" SortBy="@(x => x.Name)">Name</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="Taskforce" SortBy="@(x => TaskforceScopeDisplay.Name(x.Scope))">Geltungsbereich</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="Taskforce" SortBy="@(x => x.CreatedAt)">Beantragt</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:right;">Aktion</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Aktenzeichen"><MudText Typo="Typo.caption" Class="mud-text-secondary">@context.CaseNumber</MudText></MudTd>
                <MudTd DataLabel="Name">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudLink Href="@($"/taskforces/{context.Id}")" Typo="Typo.body2">@context.Name</MudLink>
                        @if (context.IsClassified)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" Size="Size.Small" Title="Verschlusssache" />
                        }
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Geltungsbereich">
                    <MudText Typo="Typo.caption">@TaskforceScopeDisplay.Name(context.Scope)</MudText>
                </MudTd>
                <MudTd DataLabel="Beantragt">
                    <MudText Typo="Typo.caption">@context.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                </MudTd>
                <MudTd DataLabel="Aktion" Style="text-align:right;">
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Check" Class="mr-2"
                               OnClick="() => TaskforceApprove(context)">Genehmigen</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Close"
                               OnClick="() => TaskforceReject(context)">Ablehnen</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    <MudDivider Class="my-6" />

    <MudText Typo="Typo.h6" Class="mb-2">Beförderungsanträge</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
        Beantragte Beförderungen. Die Entscheidung trifft Deputy Director aufwärts bzw. ein Admin; bei Genehmigung
        wird der Rang gesetzt und der betroffene Agent muss sich neu anmelden.
    </MudText>
    @if (_openPromotions.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Keine offenen Beförderungsanträge.</MudAlert>
    }
    else
    {
        <MudTable Items="_openPromotions" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="2">
            <HeaderContent>
                <MudTh><MudTableSortLabel T="AgentPromotionRequest" SortBy="@(x => AgentName(x.AgentId))">Agent</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="AgentPromotionRequest" SortBy="@(x => x.TargetRank)">Ziel-Dienstgrad</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="AgentPromotionRequest" SortBy="@(x => x.Justification)">Begründung</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="AgentPromotionRequest" SortBy="@(x => x.CreatedAt)">Beantragt</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:right;">Aktion</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Agent">
                    <MudLink Href="@($"/personal/{context.AgentId}")" Typo="Typo.body2">@AgentName(context.AgentId)</MudLink>
                </MudTd>
                <MudTd DataLabel="Ziel-Dienstgrad"><MudText Typo="Typo.body2">@RankDisplay.Name(context.TargetRank)</MudText></MudTd>
                <MudTd DataLabel="Begründung"><MudText Typo="Typo.caption" Class="mud-text-secondary">@if (string.IsNullOrWhiteSpace(context.Justification)) { <text>—</text> } else { <MentionDisplay Text="@context.Justification" /> }</MudText></MudTd>
                <MudTd DataLabel="Beantragt">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@(context.RequesterName ?? "—") · @context.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                </MudTd>
                <MudTd DataLabel="Aktion" Style="text-align:right;">
                    <AuthorizeView Policy="@Policies.PromotionDecideWrite" Context="auth">
                        <Authorized>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.Check" Class="mr-2"
                                       OnClick="() => PromotionDecide(context, true)">Genehmigen</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Close"
                                       OnClick="() => PromotionDecide(context, false)">Ablehnen</MudButton>
                        </Authorized>
                        <NotAuthorized>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Entscheidung: Deputy Director+/Admin</MudText>
                        </NotAuthorized>
                    </AuthorizeView>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
    <MudDivider Class="my-6" />

    <MudText Typo="Typo.h6" Class="mb-2">Partner-Freigabe-Anträge</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
        Agenten unterhalb Supervisory können beantragen, dass eine Akte für eine Partnerbehörde oder einen einzelnen
        Partner freigegeben wird. Bei Genehmigung wird die Freigabe automatisch gesetzt.
    </MudText>
    @if (_openPartnerRequests.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Keine offenen Partner-Freigabe-Anträge.</MudAlert>
    }
    else
    {
        <MudTable Items="_openPartnerRequests" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="2">
            <HeaderContent>
                <MudTh><MudTableSortLabel T="Request" SortBy="@(x => x.TargetDesignation)">Akte</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="Request" SortBy="@(x => x.FreigabeAgency)">Behörde</MudTableSortLabel></MudTh>
                <MudTh>Ganze Akte</MudTh>
                <MudTh><MudTableSortLabel T="Request" SortBy="@(x => x.Justification)">Begründung</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="Request" SortBy="@(x => x.CreatedAt)">Beantragt</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:right;">Aktion</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Akte">
                    <MudLink Href="@SearchNavigation.For(context.TargetType, context.TargetId)" Typo="Typo.body2">@context.TargetDesignation</MudLink>
                </MudTd>
                <MudTd DataLabel="Behörde">
                    @if (context.FreigabePartnerAgentId is not null)
                    {
                        <MudText Typo="Typo.body2">@(context.FreigabeAgency.HasValue ? PartnerAgencyDisplay.Name(context.FreigabeAgency.Value) : "—") · @(_agentNames.GetValueOrDefault(context.FreigabePartnerAgentId, "Einzel-Partner"))</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Einzelner Partner</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">@(context.FreigabeAgency.HasValue ? PartnerAgencyDisplay.Name(context.FreigabeAgency.Value) : "—")</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Ganze Akte">
                    <MudIcon Icon="@(context.FreigabeIncludesChildren ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                             Color="@(context.FreigabeIncludesChildren ? Color.Success : Color.Default)" Size="Size.Small" />
                </MudTd>
                <MudTd DataLabel="Begründung">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@if (string.IsNullOrWhiteSpace(context.Justification)) { <text>—</text> } else { <MentionDisplay Text="@context.Justification" /> }</MudText>
                </MudTd>
                <MudTd DataLabel="Beantragt">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@(context.RequesterName ?? "—") · @context.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                </MudTd>
                <MudTd DataLabel="Aktion" Style="text-align:right;">
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Check" Class="mr-2"
                               OnClick="() => PartnerRequestDecide(context, true)">Genehmigen</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Close"
                               OnClick="() => PartnerRequestDecide(context, false)">Ablehnen</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
    <MudDivider Class="my-6" />

    <MudText Typo="Typo.h6" Class="mb-2">Anfragen von Partnern</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
        Partnerbehörden fragen hier in eigenen Worten nach Akten, die sie noch nicht sehen. Zum Genehmigen wählst du
        die passende Akte aus; die Freigabe wird dann gesetzt und das anfragende Konto benachrichtigt.
    </MudText>
    @if (_openInquiries.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Keine offenen Anfragen von Partnern.</MudAlert>
    }
    else
    {
        <MudTable Items="_openInquiries" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="2">
            <HeaderContent>
                <MudTh>Anfrage</MudTh>
                <MudTh>Behörde</MudTh>
                <MudTh>Begründung</MudTh>
                <MudTh>Gestellt</MudTh>
                <MudTh Style="text-align:right;">Aktion</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Anfrage"><MudText Typo="Typo.body2">@context.TargetDesignation</MudText></MudTd>
                <MudTd DataLabel="Behörde">@(context.FreigabeAgency.HasValue ? PartnerAgencyDisplay.Name(context.FreigabeAgency.Value) : "—")</MudTd>
                <MudTd DataLabel="Begründung"><MudText Typo="Typo.caption" Class="mud-text-secondary">@context.Justification</MudText></MudTd>
                <MudTd DataLabel="Gestellt">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@(context.RequesterName ?? "—") · @context.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                </MudTd>
                <MudTd DataLabel="Aktion" Style="text-align:right;">
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Check" Class="mr-2"
                               OnClick="() => InquiryApproveAsync(context)">Genehmigen</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Close"
                               OnClick="() => InquiryRejectAsync(context)">Ablehnen</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
    </AuthorizeView>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;
    private bool _isLeadership;
    private List<Request> _openUpgrades = new();
    private List<Request> _openPartnerRequests = new();
    private List<Request> _openInquiries = new();
    private IReadOnlyList<PublicWantedRequestRow> _openPublications = Array.Empty<PublicWantedRequestRow>();
    private IReadOnlyList<BountyRequestRow> _openBounties = Array.Empty<BountyRequestRow>();
    private List<Agent> _pending = new();
    private List<Agent> _nameChanges = new();
    private List<Agent> _avatars = new();
    private List<Taskforce> _requestedTaskforces = new();
    private List<AgentPromotionRequest> _openPromotions = new();
    private Dictionary<string, string> _agentNames = new();
    private ClaimsPrincipal _user = default!;
    private readonly Dictionary<string, SelectionState> _selection = new();

    private const string DepartmentHint =
        "TRU und HRB sind laut Dienstverordnung erst ab dem Dienstgrad Special Agent möglich.";

    private sealed class SelectionState
    {
        private Rank _degree = Rank.JuniorAgent;

        /// <summary>Picking a rank below the threshold drops the departments with it, so the release cannot fail on save.</summary>
        public Rank Degree
        {
            get => _degree;
            set
            {
                _degree = value;
                if (!DepartmentRules.MayHold(_degree))
                {
                    Tru = false;
                    Hrb = false;
                }
            }
        }

        /// <summary>Mirrors DepartmentRules.MayHold for the two checkboxes.</summary>
        public bool DepartmentsOpen => DepartmentRules.MayHold(_degree);

        public bool Tru { get; set; }
        public bool Hrb { get; set; }
        // non-null = release as partner
        public PartnerAgency? Partner { get; set; }
        public PartnerRank PartnerDegree { get; set; } = PartnerRank.Member;
    }

    private SelectionState Selection(string agentId)
    {
        if (!_selection.TryGetValue(agentId, out var state))
        {
            state = new SelectionState();
            _selection[agentId] = state;
        }
        return state;
    }

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _load = true;
        _isLeadership = _user.IsLeadership();

        // Senior Special Agent+ sees upgrade requests (broader than leadership).
        _openUpgrades = await RequestService.GetOpenAsync(_isLeadership);
        _openPublications = await PublicWanted.GetPendingRequestsAsync();
        _openBounties = await Bounty.GetPendingRequestsAsync();

        // Remaining four sections are leadership-only.
        if (_isLeadership)
        {
            _openPartnerRequests = await PartnerShareService.GetPendingPartnerShareRequestsAsync();
            _openInquiries = await PartnerShareService.GetPendingPartnerInquiriesAsync(_user);
            _pending = await AgentService.GetPendingAsync();
            _nameChanges = await AgentService.GetPendingNameChangesAsync();
            _avatars = await AgentService.GetPendingAvatarsAsync();
            _requestedTaskforces = await TaskforceService.GetRequestedAsync();
            _openPromotions = await PersonnelFileService.GetOpenPromotionRequestsAsync();
            _agentNames = (await AgentService.GetAllAsync())
                .ToDictionary(a => a.Id, a => string.IsNullOrWhiteSpace(a.Codename) ? "Unbenannter Agent" : a.Codename);
            foreach (var agent in _pending)
            {
                _ = Selection(agent.Id);
            }
        }
        _load = false;

        // Refresh the NavMenu badge count after every decision.
        SharesBroadcaster.Report();
    }

    private async Task PublicationDecide(PublicWantedRequestRow row, bool approved)
    {
        var note = await ReasonDialog.ShowAsync(DialogService,
            approved ? $"Veröffentlichung von {row.DisplayName} genehmigen?" : $"Veröffentlichung von {row.DisplayName} ablehnen?",
            approved
                ? "Der Steckbrief wird sofort anonym abrufbar. Eine Notiz ist optional."
                : "Der Antrag wird abgelehnt und die Ausschreibung bleibt ein Entwurf. Eine Notiz ist optional.",
            confirmText: approved ? "Genehmigen" : "Ablehnen",
            label: "Notiz (optional)",
            colour: approved ? Color.Success : Color.Error);
        if (note is null)
        {
            return;
        }

        try
        {
            // never RequestService.DecideAsync: that one sets a classification on the target
            if (approved)
            {
                await PublicWanted.ApprovePublicationRequestAsync(row.RequestId, note, _user);
            }
            else
            {
                await PublicWanted.RejectPublicationRequestAsync(row.RequestId, note, _user);
            }
            Snackbar.Add(approved ? "Veröffentlichung genehmigt." : "Antrag abgelehnt.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await LoadAsync();
    }

    private async Task BountyDecide(BountyRequestRow row, bool approved)
    {
        var note = await ReasonDialog.ShowAsync(DialogService,
            approved ? $"Kopfgeld für {row.DisplayName} genehmigen?" : $"Kopfgeld für {row.DisplayName} ablehnen?",
            approved
                ? $"{row.Amount:N0} $ zählen danach zur öffentlich sichtbaren Summe. Eine Notiz ist optional."
                : "Der Anteil wird zurückgezogen und zählt nie zur öffentlichen Summe. Eine Notiz ist optional.",
            confirmText: approved ? "Genehmigen" : "Ablehnen",
            label: "Notiz (optional)",
            colour: approved ? Color.Success : Color.Error);
        if (note is null)
        {
            return;
        }

        try
        {
            if (approved)
            {
                await Bounty.ApproveRequestAsync(row.RequestId, note, _user);
            }
            else
            {
                await Bounty.RejectRequestAsync(row.RequestId, note, _user);
            }
            Snackbar.Add(approved ? "Kopfgeld genehmigt." : "Antrag abgelehnt.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await LoadAsync();
    }

    private async Task UpgradeDecide(Request request, bool approved)
    {
        var note = await ReasonDialog.ShowAsync(DialogService,
            approved ? $"Hochstufung von {request.TargetDesignation} genehmigen?" : $"Hochstufung von {request.TargetDesignation} ablehnen?",
            approved
                ? "Die Akte wird auf „Gesichert staatsgefährdend“ eingestuft. Eine Notiz ist optional."
                : "Der Antrag wird abgelehnt. Eine Notiz ist optional.",
            confirmText: approved ? "Genehmigen" : "Ablehnen",
            label: "Notiz (optional)",
            colour: approved ? Color.Success : Color.Error, mentions: true);
        if (note is null)
        {
            return; // Abgebrochen
        }
        try
        {
            await RequestService.DecideAsync(request.Id, approved, string.IsNullOrWhiteSpace(note) ? null : note, _user);
            Snackbar.Add(approved
                ? $"Hochstufung von {request.TargetDesignation} genehmigt."
                : $"Hochstufungs-Antrag von {request.TargetDesignation} abgelehnt.", approved ? Severity.Success : Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await LoadAsync();
    }

    private async Task Release(Agent agent)
    {
        var selection = Selection(agent.Id);
        try
        {
            if (selection.Partner is { } agency)
            {
                await AgentService.ReleaseAsPartnerAsync(agent.Id, agency, selection.PartnerDegree, _user);
                Snackbar.Add($"{DisplayName(agent)} als Partner ({PartnerRankDisplay.Full(agency, selection.PartnerDegree)}) freigegeben.", Severity.Success);
            }
            else
            {
                await AgentService.ReleaseAsync(agent.Id, selection.Degree, selection.Tru, selection.Hrb, _user);
                Snackbar.Add($"{DisplayName(agent)} als {RankDisplay.Name(selection.Degree)} freigegeben.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await LoadAsync();
    }

    private async Task Reject(Agent agent)
    {
        var reason = await ReasonDialog.ShowAsync(DialogService,
            $"{DisplayName(agent)} ablehnen?",
            "Das Konto wird abgelehnt (gesperrt). Die Begründung wird protokolliert.",
            confirmText: "Ablehnen", label: "Begründung (optional)", colour: Color.Error);
        if (reason is null)
        {
            return;
        }
        try
        {
            await AgentService.RejectAsync(agent.Id, string.IsNullOrWhiteSpace(reason) ? "Registrierung abgelehnt" : reason, _user);
            Snackbar.Add($"{DisplayName(agent)} abgelehnt.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await LoadAsync();
    }

    private async Task NamesApprove(Agent agent)
    {
        try
        {
            await AgentService.NameChangeApproveAsync(agent.Id, _user);
            Snackbar.Add($"Namensänderung von {DisplayName(agent)} genehmigt.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await LoadAsync();
    }

    private async Task NamesReject(Agent agent)
    {
        var reason = await ReasonDialog.ShowAsync(DialogService,
            $"Namensänderung von {DisplayName(agent)} ablehnen?",
            "Der Antrag wird verworfen. Die Begründung wird protokolliert.",
            confirmText: "Ablehnen", label: "Begründung (optional)", colour: Color.Error);
        if (reason is null)
        {
            return;
        }
        try
        {
            await AgentService.NameChangeRejectAsync(agent.Id, string.IsNullOrWhiteSpace(reason) ? "Namensänderung abgelehnt" : reason, _user);
            Snackbar.Add($"Namensänderung von {DisplayName(agent)} abgelehnt.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await LoadAsync();
    }

    private async Task AvatarApprove(Agent agent)
    {
        try
        {
            await AgentService.AvatarApproveAsync(agent.Id, _user);
            Snackbar.Add($"Profilbild von {DisplayName(agent)} genehmigt.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await LoadAsync();
    }

    private async Task AvatarReject(Agent agent)
    {
        var reason = await ReasonDialog.ShowAsync(DialogService,
            $"Profilbild von {DisplayName(agent)} ablehnen?",
            "Das Bild wird verworfen. Die Begründung wird protokolliert.",
            confirmText: "Ablehnen", label: "Begründung (optional)", colour: Color.Error);
        if (reason is null)
        {
            return;
        }
        try
        {
            await AgentService.AvatarRejectAsync(agent.Id, string.IsNullOrWhiteSpace(reason) ? "Profilbild abgelehnt" : reason, _user);
            Snackbar.Add($"Profilbild von {DisplayName(agent)} abgelehnt.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await LoadAsync();
    }

    private async Task TaskforceApprove(Taskforce taskforce)
    {
        try
        {
            await TaskforceService.ApprovalSetAsync(taskforce.Id, TaskforceStatus.Approved, _user);
            Snackbar.Add($"Taskforce {taskforce.CaseNumber} genehmigt.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await LoadAsync();
    }

    private async Task TaskforceReject(Taskforce taskforce)
    {
        var ok = await ConfirmDialog.ShowAsync(DialogService,
            $"Taskforce {taskforce.CaseNumber} ablehnen?",
            $"Der Antrag „{taskforce.Name}“ wird abgelehnt. Die Statusänderung wird protokolliert.",
            "Ablehnen");
        if (!ok)
        {
            return;
        }
        try
        {
            await TaskforceService.ApprovalSetAsync(taskforce.Id, TaskforceStatus.Rejected, _user);
            Snackbar.Add($"Taskforce {taskforce.CaseNumber} abgelehnt.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await LoadAsync();
    }

    private string AgentName(string agentId) => _agentNames.GetValueOrDefault(agentId) ?? "Agent";

    private async Task PromotionDecide(AgentPromotionRequest request, bool approved)
    {
        try
        {
            await AgentService.PromotionDecideAsync(request.Id, approved, null, _user);
            Snackbar.Add(approved
                ? $"Beförderung von {AgentName(request.AgentId)} genehmigt."
                : $"Beförderungsantrag von {AgentName(request.AgentId)} abgelehnt.", approved ? Severity.Success : Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await LoadAsync();
    }

    private async Task PartnerRequestDecide(Request request, bool approved)
    {
        var agencyName = request.FreigabeAgency.HasValue ? PartnerAgencyDisplay.Name(request.FreigabeAgency.Value) : "Behörde";
        var note = await ReasonDialog.ShowAsync(DialogService,
            approved
                ? $"Freigabe von {request.TargetDesignation} fuer {agencyName} genehmigen?"
                : $"Freigabe-Antrag fuer {request.TargetDesignation} ablehnen?",
            approved
                ? "Die Akte wird fuer die Behoerde freigegeben. Eine Notiz ist optional."
                : "Der Antrag wird abgelehnt. Eine Notiz ist optional.",
            confirmText: approved ? "Genehmigen" : "Ablehnen",
            label: "Notiz (optional)",
            colour: approved ? Color.Success : Color.Error, mentions: true);
        if (note is null)
        {
            return; // abgebrochen
        }
        try
        {
            if (approved)
            {
                await PartnerShareService.ApprovePartnerShareRequestAsync(_user, request.Id, string.IsNullOrWhiteSpace(note) ? null : note);
                Snackbar.Add($"Freigabe von {request.TargetDesignation} genehmigt.", Severity.Success);
            }
            else
            {
                await PartnerShareService.RejectPartnerShareRequestAsync(_user, request.Id, string.IsNullOrWhiteSpace(note) ? null : note);
                Snackbar.Add($"Freigabe-Antrag von {request.TargetDesignation} abgelehnt.", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await LoadAsync();
    }

    private async Task InquiryApproveAsync(Request inquiry)
    {
        var dialog = await DialogService.ShowAsync<PartnerInquiryApproveDialog>("Anfrage beantworten", new DialogParameters<PartnerInquiryApproveDialog>
        {
            { d => d.Target, inquiry.TargetDesignation },
            { d => d.Justification, inquiry.Justification },
        }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is not { Canceled: false, Data: PartnerInquiryAnswer answer })
        {
            return;
        }
        try
        {
            await PartnerShareService.ApprovePartnerInquiryAsync(_user, inquiry.Id, answer.EntityType, answer.EntityId,
                answer.ToAccountOnly, answer.IncludesChildren, answer.Note);
            Snackbar.Add("Anfrage beantwortet, Akte freigegeben.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await LoadAsync();
    }

    private async Task InquiryRejectAsync(Request inquiry)
    {
        var note = await ReasonDialog.ShowAsync(DialogService, "Anfrage ablehnen?",
            $"„{inquiry.TargetDesignation}“ wird abgelehnt. Eine Notiz sieht die anfragende Behörde.",
            confirmText: "Ablehnen", label: "Notiz (optional)", colour: Color.Error);
        if (note is null)
        {
            return;
        }
        try
        {
            await PartnerShareService.RejectPartnerInquiryAsync(_user, inquiry.Id, string.IsNullOrWhiteSpace(note) ? null : note);
            Snackbar.Add("Anfrage abgelehnt.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        await LoadAsync();
    }

    // Liefert nur die tatsächlich geänderten Felder als „alt → neu". Die Seite ist Führungs-gated, und die
    // Führungsebene darf den Klarnamen sehen (DarfKlarnameSehen) – daher hier keine Maskierung nötig.
    private static List<FieldChange> Changes(Agent a)
    {
        var list = new List<FieldChange>();
        void Check(string label, string? alt, string? @new)
        {
            if (!string.Equals(alt ?? string.Empty, @new ?? string.Empty, StringComparison.Ordinal))
            {
                list.Add(new FieldChange(label, Display(alt), Display(@new)));
            }
        }
        Check("Codename", a.Codename, a.PendingCodename);
        Check("Klarname", a.RealName, a.PendingRealName);
        Check("Dienstnummer", a.BadgeNumber, a.PendingBadgeNumber);
        return list;
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private sealed record FieldChange(string Label, string Alt, string New);

    private static string DisplayName(Agent agent)
        => string.IsNullOrWhiteSpace(agent.Codename) ? "Neuer Agent" : agent.Codename;
}
