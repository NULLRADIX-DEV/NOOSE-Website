@* Catalog of decorations plus who signs and where certificates are issued. *@
@inject IDecorationService Decorations
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Ehrenzeichen verleiht die Führung in der Personalakte eines Agenten, im Reiter <em>Auszeichnungen</em>. Hier legst du
    fest, welche es gibt. Ein schon verliehenes Ehrenzeichen bleibt im Katalog; schalte es ab, wenn es nicht mehr
    vergeben werden soll.
</MudText>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
    <MudText Typo="Typo.h6">Katalog</MudText>
    <MudSpacer />
    @if (_mayWrite)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="NewAsync">
            Neues Ehrenzeichen
        </MudButton>
    }
</MudStack>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_catalog.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Filled.MilitaryTech" Title="Noch keine Ehrenzeichen"
                Text="Lege das erste Ehrenzeichen an, dann kann die Führung es verleihen." />
}
else
{
    <MudTable Items="_catalog" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="2" Dense="true">
        <HeaderContent>
            <MudTh>#</MudTh>
            <MudTh>Ehrenzeichen</MudTh>
            <MudTh>Beschreibung</MudTh>
            <MudTh>Verliehen</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Style="text-align:right;">Aktion</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="#">@context.Order</MudTd>
            <MudTd DataLabel="Ehrenzeichen">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <DecorationPlaque Name="@context.Name" Symbol="@context.Symbol" Tier="@context.Tier" />
                    <MudText Typo="Typo.body2"><b>@context.Name</b> · @DecorationTierDisplay.Name(context.Tier)</MudText>
                </MudStack>
            </MudTd>
            <MudTd DataLabel="Beschreibung">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@context.Description</MudText>
            </MudTd>
            <MudTd DataLabel="Verliehen">@context.AwardCount×</MudTd>
            <MudTd DataLabel="Status">
                @if (context.IsActive)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Verleihbar</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">Abgeschaltet</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Aktion" Style="text-align:right;">
                @if (_mayWrite)
                {
                    <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => EditAsync(context))" aria-label="Ehrenzeichen bearbeiten" />
                        @if (context.AwardCount == 0)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => DeleteAsync(context))" aria-label="Ehrenzeichen löschen" />
                        }
                    </MudStack>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

<MudText Typo="Typo.h6" Class="mt-8 mb-2">Urkunden</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
    Wer Urkunden für die Behördenleitung unterschreibt und welcher Ort neben dem Datum steht. Eine Ehrungs-Urkunde
    behält die Unterschrift vom Tag der Verleihung; Ernennungs- und Beförderungsurkunden tragen die heutige.
</MudText>
@if (!_load)
{
    <MudStack Spacing="2" Style="max-width:560px;">
        <MudSelect T="string" @bind-Value="_signatoryId" Label="Unterschrift der Behördenleitung" Variant="Variant.Outlined"
                   Clearable="true" Disabled="@(!_mayWrite)" Placeholder="Keine – „Die Behördenleitung“"
                   HelperText="Aktive Agenten ab Deputy Director.">
            @foreach (var s in _signatories)
            {
                <MudSelectItem T="string" Value="@s.Id">
                    @s.Codename (@RankDisplay.Name(s.Rank))@(s.Eligible ? "" : " – unterschreibt nicht mehr")
                </MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="_place" Label="Ort" Variant="Variant.Outlined" Disabled="@(!_mayWrite)"
                      MaxLength="@DecorationRules.MaxPlaceLength" Placeholder="@DecorationRules.DefaultPlace" />
        @if (_mayWrite)
        {
            <div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                           OnClick="SaveSettingsAsync" Disabled="_saving">Speichern</MudButton>
            </div>
        }
    </MudStack>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;
    private bool _saving;
    private bool _mayWrite;
    private ClaimsPrincipal _user = new();
    private IReadOnlyList<DecorationView> _catalog = [];
    private IReadOnlyList<SignatoryOption> _signatories = [];
    private string? _signatoryId;
    private string? _place;

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _mayWrite = _user.IsLeadership() && _user.MayWrite();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _load = true;
        try
        {
            _catalog = await Decorations.GetCatalogAsync(_user);
            _signatories = await Decorations.GetSignatoryOptionsAsync(_user);
            var settings = await Decorations.GetCertificateSettingsAsync();
            _signatoryId = settings.SignatoryId;
            _place = settings.Place == DecorationRules.DefaultPlace ? null : settings.Place;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ehrenzeichen konnten nicht geladen werden: {ex.Message}", Severity.Error);
        }
        finally
        {
            _load = false;
        }
    }

    private async Task NewAsync()
    {
        var next = _catalog.Count == 0 ? 10 : _catalog.Max(d => d.Order) + 10;
        await SaveAsync(await DecorationDialog.ShowAsync(DialogService, null, next), DecorationDialog.DraftScopeFor(null));
    }

    private async Task EditAsync(DecorationView row)
        => await SaveAsync(await DecorationDialog.ShowAsync(DialogService, row), DecorationDialog.DraftScopeFor(row.Id));

    private async Task SaveAsync(DecorationInput? input, string draftScope)
    {
        if (input is null)
        {
            return;
        }
        try
        {
            await Decorations.SaveDecorationAsync(input, _user);
            try
            {
                await TextDraft.DiscardScopeAsync(JS, _user.GetAgentId(), draftScope);
            }
            catch
            {
                /* best effort */
            }
            Snackbar.Add("Ehrenzeichen gespeichert.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(DecorationView row)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Ehrenzeichen löschen",
            $"„{row.Name}“ wird endgültig aus dem Katalog entfernt.", yesText: "Löschen", cancelText: "Abbrechen");
        if (confirmed != true)
        {
            return;
        }
        try
        {
            await Decorations.DeleteDecorationAsync(row.Id, _user);
            Snackbar.Add("Ehrenzeichen gelöscht.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SaveSettingsAsync()
    {
        _saving = true;
        try
        {
            await Decorations.SaveCertificateSettingsAsync(
                new CertificateSettings(_signatoryId, _place ?? string.Empty), _user);
            Snackbar.Add("Urkunden-Einstellungen gespeichert.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
