@* Discord webhook routing: one channel per notification category. Managed by leadership. *@
@inject IDiscordWebhookService Discord
@inject ISnackbar Snackbar


<MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">
    Leite ausgewählte Ereignis-Kategorien zusätzlich in Discord-Channels weiter – pro Kategorie ein eigener
    Channel-Webhook. Der Nachrichtentext enthält nur einen generischen Hinweis und einen login-geschützten Link –
    <b>niemals</b> Namen, Aktenzeichen, Notizen oder VS-Inhalte (die sieht man erst nach Login mit den nötigen
    Rechten). <b>Zusätzlich</b> wird angepingt: persönliche Kategorien (Erwähnung, Wiedervorlage) pingen die
    betroffene(n) Person(en) direkt, Broadcast-Kategorien die je Kategorie konfigurierte Rolle. Der Ping verrät
    nur <i>wer</i> bzw. <i>welche Rolle</i> gemeint ist – nicht den Inhalt.
</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">
    Zwei Kategorien sind bewusst ausführlicher, weil sie <b>Bekanntmachungen</b> sind und keine Hinweise auf eine
    Akte: <b>Personalakte-Eintrag</b> und <b>Kündigung</b> posten ein Embed mit Name, Datum und Begründung.
    Die Kündigung geht in ihren eigenen Channel und pingt niemanden.
</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">
    Jeder Agent legt im Profil fest, wann ihn die persönlichen Kategorien (Erwähnung, Aufgabe, Wiedervorlage)
    anpingen: sofort, nie oder <b>gesammelt</b>. Gesammeltes geht einmal am Tag um @DiscordPings.DigestHour Uhr in den
    Channel <b>Tagesüberblick</b>, eine Zeile je Agent mit Ping und der Zahl der ungelesenen Meldungen, ohne Titel.
    Ohne diesen Channel lässt sich „gesammelt“ im Profil nicht wählen.
</MudText>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudStack Spacing="4">
        <MudPaper Class="pa-4" Elevation="2">
            <MudSwitch T="bool" @bind-Value="_input.Enabled" Color="Color.Primary" Label="Discord-Weiterleitung aktiv" />
            <MudTextField @bind-Value="_input.SiteBaseUrl" Label="Basis-URL für Links" Variant="Variant.Outlined"
                          Class="mt-2" Placeholder="@DiscordWebhookConfig.DefaultBaseUrl"
                          HelperText="Vorangestellt bei relativen Links in den Discord-Nachrichten." />
            <MudSwitch T="bool" @bind-Value="_input.IncludeHeadline" Color="Color.Primary" Class="mt-2"
                       Label="Header/Inhalt mitsenden (Ankündigung, Bewerbung inkl. Name, Terminkopf)" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Aus: nur generischer Hinweis. An: Ankündigungs-Titel bzw. Bewerbername stehen direkt in der Discord-Nachricht
                (nur diese Kategorien; Besprechungen/Lageberichte bleiben generisch).
            </MudText>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-1">Channel je Kategorie</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                Trage pro Kategorie die Webhook-URL des Ziel-Channels ein (in Discord: Channel →
                Einstellungen → Integrationen → Webhooks). Leer lassen = diese Kategorie nicht weiterleiten.
            </MudText>
            <MudStack Spacing="3">
                @foreach (var type in _types)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@NotificationTypeDisplay.Icon(type)" Color="Color.Default" />
                        <div style="min-width:190px;">
                            <MudText Typo="Typo.body2">@NotificationTypeDisplay.Name(type)</MudText>
                            @if (IsInternal(type))
                            {
                                <MudTooltip Text="Der Link kann auf eine eingestufte Akte führen – auf einen internen, zugriffsbeschränkten Channel legen.">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                                             Icon="@Icons.Material.Filled.Lock">intern</MudChip>
                                </MudTooltip>
                            }
                        </div>
                        <MudTextField @bind-Value="_webhooks[type]" Placeholder="https://discord.com/api/webhooks/…"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                        @if (DiscordRouting.PingsRole(type))
                        {
                            <MudTextField @bind-Value="_roles[type]" Label="Rollen-ID" Placeholder="@DiscordRouting.DefaultRole(type)"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:220px;"
                                          HelperText="Rolle, die bei diesem Ereignis gepingt wird." />
                        }
                        else if (DiscordRouting.PingsNobody(type))
                        {
                            <MudTooltip Text="Diese Kategorie pingt niemanden – die Namen stehen als Mention im Embed, lösen aber keine Benachrichtigung aus.">
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined"
                                         Icon="@Icons.Material.Filled.NotificationsOff">ohne Ping</MudChip>
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="Diese Kategorie pingt die betroffene(n) Person(en) direkt per Discord-Mention.">
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined"
                                         Icon="@Icons.Material.Filled.AlternateEmail">pingt Empfänger</MudChip>
                            </MudTooltip>
                        }
                        <MudTooltip Text="Test verwendet die zuletzt gespeicherte URL.">
                            <MudIconButton Icon="@Icons.Material.Filled.Send" Color="Color.Primary"
                                           OnClick="@(() => TestAsync(type))" aria-label="Test senden" />
                        </MudTooltip>
                    </MudStack>
                }
            </MudStack>
        </MudPaper>

        <MudStack Row="true" Justify="Justify.FlexEnd">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveAsync" Disabled="_saving">Speichern</MudButton>
        </MudStack>
    </MudStack>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private static readonly IReadOnlyList<NotificationType> _types = DiscordRouting.RoutableTypes;

    private ClaimsPrincipal _user = new();
    private DiscordWebhookConfigInput _input = new();
    private readonly Dictionary<NotificationType, string?> _webhooks = new();
    private readonly Dictionary<NotificationType, string?> _roles = new();
    private bool _load = true;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        var config = await Discord.GetConfigAsync();
        _input = new DiscordWebhookConfigInput
        {
            Enabled = config.Enabled,
            SiteBaseUrl = config.SiteBaseUrl == DiscordWebhookConfig.DefaultBaseUrl ? null : config.SiteBaseUrl,
            IncludeHeadline = config.IncludeHeadline,
        };
        foreach (var type in _types)
        {
            _webhooks[type] = config.Webhooks.GetValueOrDefault(type);
        }
        foreach (var type in DiscordRouting.RoleRoutableTypes)
        {
            _roles[type] = config.Roles.GetValueOrDefault(type);
        }
        _load = false;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            _input.Webhooks = new Dictionary<NotificationType, string?>(_webhooks);
            _input.Roles = new Dictionary<NotificationType, string?>(_roles);
            await Discord.SaveConfigAsync(_input, _user);
            Snackbar.Add("Discord-Einstellungen gespeichert.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task TestAsync(NotificationType type)
    {
        try
        {
            var ok = await Discord.TestAsync(type, _user);
            Snackbar.Add(ok ? "Test-Nachricht gesendet." : "Kein gespeicherter Webhook für diese Kategorie (erst speichern).",
                ok ? Severity.Success : Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    // every routable category except the outward ones is internal (link may reach a classified record)
    private static bool IsInternal(NotificationType type)
        => type is not (NotificationType.Announcement or NotificationType.PublicWantedPublished);
}
