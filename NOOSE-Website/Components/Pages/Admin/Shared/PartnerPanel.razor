@* Everything about one partner agency: its profile, its units, which records are released, and what each unit sees of them. *@

<MudPaper Class="pa-4 mb-6" Elevation="2">
    <MudSelect T="PartnerAgency" @bind-Value="_agency" Label="Behörde"
               Dense="true" Variant="Variant.Outlined" Style="max-width:260px;">
        @foreach (var a in PartnerAgencyDisplay.All)
        {
            <MudSelectItem T="PartnerAgency" Value="@a">@PartnerAgencyDisplay.Name(a)</MudSelectItem>
        }
    </MudSelect>
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
        Alle Abschnitte unten beziehen sich auf diese Behörde.
    </MudText>
</MudPaper>

<MudText Typo="Typo.h6" Class="mb-2">Zugang der Behörde</MudText>
<PartnerAgencyProfileEditor Agency="_agency" OnSaved="@(() => _releaseVersion++)" />

<MudDivider Class="my-8" />

<MudText Typo="Typo.h6" Class="mb-2">Einheiten</MudText>
<PartnerUnitsEditor Agency="_agency" OnChanged="@(() => _unitVersion++)" />

<MudDivider Class="my-8" />

<MudText Typo="Typo.h6" Class="mb-2">Freigegebene Akten</MudText>
<PartnerReleaseEditor @key="_releaseVersion" Agency="_agency" />

<MudDivider Class="my-8" />

<MudText Typo="Typo.h6" Class="mb-2">Sichtbarkeit je Einheit</MudText>
<PartnerVisibilityEditor Agency="_agency" Version="_unitVersion" />

@code {
    private PartnerAgency _agency = PartnerAgency.DoJ;
    // remounts release editor
    private int _releaseVersion;
    // reloads unit pickers
    private int _unitVersion;
}
