@inject IBuergerService BuergerService
@inject IPersonService PersonService
@inject ISnackbar Snackbar

<MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">
    Konten von Spielern, die sich über den öffentlichen Bereich mit Discord angemeldet haben. Diese Konten haben
    keinerlei Rechte in der Behörde und erscheinen in keiner Agenten-Auswahlliste. Eine Sperre nimmt dem Konto
    nur das Einreichen — öffentliche Inhalte bleiben lesbar. Die Sperre hängt am Discord-Konto, nicht am Namen.
</MudText>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap" Class="mb-4 noose-filterleiste">
    <MudTextField @bind-Value="_search" @bind-Value:after="LoadAsync" Placeholder="Suchen (Name, Discord)…"
                  Immediate="true" DebounceInterval="300" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Style="max-width:340px;" Class="mt-0 noose-filter-feld" />
    <MudSpacer />
    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">@_rows.Count Konten</MudChip>
    @if (_blockedCount > 0)
    {
        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Error">@_blockedCount gesperrt</MudChip>
    }
</MudStack>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_rows.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Noch keine Bürgerkonten registriert.</MudAlert>
}
else
{
    <MudTable Breakpoint="Breakpoint.None" Items="_rows" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh Class="noose-mobil-aus">Discord</MudTh>
            <MudTh Class="noose-mobil-aus">Registriert</MudTh>
            <MudTh Class="noose-mobil-aus">Bestätigte Hinweise</MudTh>
            <MudTh Class="noose-mobil-aus">Personenakte</MudTh>
            <MudTh>Status</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.DisplayName</MudTd>
            <MudTd DataLabel="Discord" Class="noose-mobil-aus">@(context.DiscordUsername ?? "—")</MudTd>
            <MudTd DataLabel="Registriert" Class="noose-mobil-aus">@context.RegisteredAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudTd>
            <MudTd DataLabel="Bestätigte Hinweise" Class="noose-mobil-aus">@context.ConfirmedTips</MudTd>
            <MudTd DataLabel="Personenakte" Class="noose-mobil-aus">
                @if (context.LinkedPersonId is not null)
                {
                    <MudLink Href="@($"/personen/{context.LinkedPersonId}")">Akte öffnen</MudLink>
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">—</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Status">
                @if (context.AccountBlocked)
                {
                    <MudTooltip Text="@(context.BlockedReason ?? "")">
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                                 Icon="@Icons.Material.Filled.NoAccounts">Ausgesperrt</MudChip>
                    </MudTooltip>
                }
                else if (context.IsBlocked)
                {
                    <MudTooltip Text="@(context.BlockedReason ?? "")">
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">Gesperrt</MudChip>
                    </MudTooltip>
                }
                else if (!context.HasCompleteProfile)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Angaben fehlen</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Aktiv</MudChip>
                }
            </MudTd>
            <MudTd>
                <AuthorizeView Policy="@Policies.WriteAccess" Context="writeCtx">
                    <span class="noose-mobil-aus">
                    @if (context.IsBlocked)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.LockOpen"
                                   OnClick="() => UnblockAsync(context)">Entsperren</MudButton>
                    }
                    else
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Block"
                                   OnClick="() => StartBlock(context)">Sperren</MudButton>
                    }
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Link"
                               OnClick="() => StartLinkAsync(context)">Personenakte</MudButton>
                    @* the citizen's own form refuses a rename once the name stands; this is the only way back *@
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.DriveFileRenameOutline"
                               OnClick="() => StartRename(context)">Name ändern</MudButton>
                    @if (context.AccountBlocked)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.HowToReg"
                                   OnClick="() => UnblockAccountAsync(context)">Aussperrung aufheben</MudButton>
                    }
                    else
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.NoAccounts"
                                   OnClick="() => StartAccountBlock(context)">Konto aussperren</MudButton>
                    }
                    </span>
                    @* phones: the same four actions in a ⋮ menu, inside the same write check *@
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" Class="noose-nur-handy"
                             AriaLabel="Aktionen" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        @if (context.IsBlocked)
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.LockOpen" OnClick="() => UnblockAsync(context)">Entsperren</MudMenuItem>
                        }
                        else
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.Block" IconColor="Color.Error" OnClick="() => StartBlock(context)">Sperren</MudMenuItem>
                        }
                        <MudMenuItem Icon="@Icons.Material.Filled.Link" OnClick="() => StartLinkAsync(context)">Personenakte</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.DriveFileRenameOutline" OnClick="() => StartRename(context)">Name ändern</MudMenuItem>
                        @if (context.AccountBlocked)
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.HowToReg" OnClick="() => UnblockAccountAsync(context)">Aussperrung aufheben</MudMenuItem>
                        }
                        else
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.NoAccounts" IconColor="Color.Error" OnClick="() => StartAccountBlock(context)">Konto aussperren</MudMenuItem>
                        }
                    </MudMenu>
                </AuthorizeView>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@if (_linkTarget is not null)
{
    <MudPaper Elevation="2" Class="pa-4 mt-4">
        <MudStack Spacing="3">
            <MudText Typo="Typo.subtitle1">@_linkTarget.DisplayName mit einer Personenakte verknüpfen</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Die Verknüpfung zeigt an der Personenakte die nicht anonymen Hinweise dieses Kontos.
            </MudText>

            @if (_linkInfo is not null)
            {
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudLink Href="@($"/personen/{_linkInfo.PersonId}")">@_linkInfo.Name</MudLink>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@_linkInfo.CaseNumber</MudText>
                    @if (_linkInfo.ThreatScore is { } score)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">EHK-Score: @score</MudChip>
                    }
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.LinkOff" OnClick="UnlinkAsync">Verknüpfung entfernen</MudButton>
                </MudStack>
            }
            else if (_linkTarget.LinkedPersonId is not null)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Die verknüpfte Personenakte ist für dich nicht sichtbar.
                </MudText>
            }

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudTextField @bind-Value="_personSearch" Label="Person suchen" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Immediate="true" Style="min-width:240px;" Class="noose-breite-frei" />
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Search"
                           OnClick="SearchPeopleAsync">Suchen</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CancelLink">Schließen</MudButton>
            </MudStack>

            @if (_people.Count > 0)
            {
                <MudList T="string" Dense="true">
                    @foreach (var person in _people)
                    {
                        <MudListItem T="string" OnClick="@(() => LinkAsync(person.Id))">
                            @person.Name
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@person.CaseNumber</MudText>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudStack>
    </MudPaper>
}

@if (_renameTarget is not null)
{
    <MudPaper Elevation="2" Class="pa-4 mt-4">
        <MudStack Spacing="3">
            <MudText Typo="Typo.subtitle1">Namen von @_renameTarget.DisplayName ändern</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Der Bürger kann seinen Namen nicht selbst ändern. Die Änderung steht mit deinem Namen im Protokoll.
            </MudText>
            <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap">
                <MudTextField @bind-Value="_renameFirst" Label="Vorname" Variant="Variant.Outlined"
                              Margin="Margin.Dense" MaxLength="64" Immediate="true" Style="max-width:240px;" />
                <MudTextField @bind-Value="_renameLast" Label="Nachname" Variant="Variant.Outlined"
                              Margin="Margin.Dense" MaxLength="64" Immediate="true" Style="max-width:240px;" />
            </MudStack>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@(_renameFirst.Trim().Length == 0 || _renameLast.Trim().Length == 0)"
                           OnClick="ConfirmRenameAsync">Speichern</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CancelRename">Abbrechen</MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
}

@if (_accountBlockTarget is not null)
{
    <MudPaper Elevation="2" Class="pa-4 mt-4">
        <MudStack Spacing="3">
            <MudText Typo="Typo.subtitle1">@_accountBlockTarget.DisplayName aussperren</MudText>
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                Das Konto kann sich danach nicht mehr anmelden; eine laufende Sitzung endet binnen 30 Sekunden.
                Das ist die Stufe für einen Troll-Namen — für reinen Einreichungs-Missbrauch reicht „Sperren“.
            </MudAlert>
            <MudTextField @bind-Value="_accountBlockReason" Label="Grund" Variant="Variant.Outlined"
                          Lines="2" Immediate="true" />
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.NoAccounts"
                           OnClick="ConfirmAccountBlockAsync">Aussperren</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CancelAccountBlock">Abbrechen</MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
}

@if (_blockTarget is not null)
{
    <MudPaper Elevation="2" Class="pa-4 mt-4">
        <MudStack Spacing="3">
            <MudText Typo="Typo.subtitle1">@_blockTarget.DisplayName sperren</MudText>
            <MudTextField @bind-Value="_blockReason" Label="Sperrgrund" Variant="Variant.Outlined"
                          Lines="2" Immediate="true" />
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Block"
                           OnClick="ConfirmBlockAsync">Sperren</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CancelBlock">Abbrechen</MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private ClaimsPrincipal _user = default!;
    private bool _load = true;
    private string? _search;
    private IReadOnlyList<CitizenRow> _rows = Array.Empty<CitizenRow>();
    private CitizenRow? _blockTarget;
    private string _blockReason = string.Empty;
    private CitizenRow? _linkTarget;
    private LinkedPersonInfo? _linkInfo;
    private string _personSearch = string.Empty;
    private List<Person> _people = new();

    private int _blockedCount;

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _load = true;
        try
        {
            _rows = await BuergerService.ListAsync(_user, _search);
            _blockedCount = _rows.Count(r => r.IsBlocked);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _load = false;
        }
    }

    private async Task StartLinkAsync(CitizenRow row)
    {
        _linkTarget = row;
        _people = new();
        _personSearch = string.Empty;
        await RefreshLinkAsync();
    }

    private async Task RefreshLinkAsync()
    {
        if (_linkTarget is null)
        {
            return;
        }
        try
        {
            _linkInfo = await BuergerService.GetLinkedPersonAsync(_linkTarget.Id, _user);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void CancelLink()
    {
        _linkTarget = null;
        _linkInfo = null;
        _people = new();
        _personSearch = string.Empty;
    }

    private async Task SearchPeopleAsync()
    {
        if (string.IsNullOrWhiteSpace(_personSearch))
        {
            _people = new();
            return;
        }
        try
        {
            _people = await PersonService.SearchAsync(_personSearch, _user.IsLeadership());
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task LinkAsync(string personId)
    {
        if (_linkTarget is null)
        {
            return;
        }
        try
        {
            await BuergerService.LinkPersonAsync(_linkTarget.Id, personId, _user);
            Snackbar.Add("Personenakte verknüpft.", Severity.Success);
            _people = new();
            _personSearch = string.Empty;
            await LoadAsync();
            _linkTarget = _rows.FirstOrDefault(r => r.Id == _linkTarget.Id) ?? _linkTarget;
            await RefreshLinkAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task UnlinkAsync()
    {
        if (_linkTarget is null)
        {
            return;
        }
        try
        {
            await BuergerService.LinkPersonAsync(_linkTarget.Id, null, _user);
            Snackbar.Add("Verknüpfung entfernt.", Severity.Info);
            _linkInfo = null;
            await LoadAsync();
            _linkTarget = _rows.FirstOrDefault(r => r.Id == _linkTarget.Id) ?? _linkTarget;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void StartBlock(CitizenRow row)
    {
        _blockTarget = row;
        _blockReason = string.Empty;
    }

    private void CancelBlock()
    {
        _blockTarget = null;
        _blockReason = string.Empty;
    }

    private CitizenRow? _renameTarget;
    private string _renameFirst = string.Empty;
    private string _renameLast = string.Empty;

    private CitizenRow? _accountBlockTarget;
    private string _accountBlockReason = string.Empty;

    private void StartRename(CitizenRow row)
    {
        _renameTarget = row;
        _renameFirst = row.FirstName;
        _renameLast = row.LastName;
    }

    private void CancelRename() => _renameTarget = null;

    private async Task ConfirmRenameAsync()
    {
        if (_renameTarget is null)
        {
            return;
        }
        try
        {
            await BuergerService.SetNameAsync(_renameTarget.Id, _renameFirst, _renameLast, _user);
            Snackbar.Add("Name geändert.", Severity.Success);
            _renameTarget = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void StartAccountBlock(CitizenRow row)
    {
        _accountBlockTarget = row;
        _accountBlockReason = string.Empty;
    }

    private void CancelAccountBlock() => _accountBlockTarget = null;

    private async Task ConfirmAccountBlockAsync()
    {
        if (_accountBlockTarget is null)
        {
            return;
        }
        try
        {
            await BuergerService.BlockAccountAsync(_accountBlockTarget.Id, _accountBlockReason, _user);
            Snackbar.Add("Konto ausgesperrt.", Severity.Success);
            _accountBlockTarget = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task UnblockAccountAsync(CitizenRow row)
    {
        try
        {
            await BuergerService.UnblockAccountAsync(row.Id, _user);
            Snackbar.Add("Aussperrung aufgehoben.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ConfirmBlockAsync()
    {
        if (_blockTarget is null)
        {
            return;
        }
        try
        {
            await BuergerService.BlockAsync(_blockTarget.Id, _blockReason, _user);
            Snackbar.Add("Konto gesperrt.", Severity.Info);
            CancelBlock();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task UnblockAsync(CitizenRow row)
    {
        try
        {
            await BuergerService.UnblockAsync(row.Id, _user);
            Snackbar.Add("Sperre aufgehoben.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
