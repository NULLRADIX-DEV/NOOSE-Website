@* "Bester Agent": periodic top-3 Discord announcement + optional personnel entries. Leadership-managed. *@
@inject ITopAgentAwardService Awards
@inject ISnackbar Snackbar

<MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">
    In einstellbarem Takt werden die drei Agenten mit den meisten Gamification-Punkten des Zeitraums in den
    Ankündigungs-Discord-Channel gepostet (mit @@FIB-Ping). Die Überschrift folgt dem Intervall
    („der Woche (KW 36)", „des Monats", …). Die Führungsebene wird darunter außer Wertung mitgepostet: sie
    belegt keinen der drei Plätze und erhält keinen Vermerk. Optional erhält jeder der drei Platzierten einen
    positiven Personalakten-Vermerk mit demselben Zeitraum. Der Discord-Post nutzt denselben Webhook +
    dieselbe Rolle wie die Kategorie <b>Ankündigung</b> (siehe Discord-Benachrichtigungen).
</MudText>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudStack Spacing="3" Style="max-width:520px;">
        <MudSwitch T="bool" @bind-Value="_enabled" Color="Color.Primary" Label="Automatische Ankündigung aktiv" />

        <MudNumericField T="int" @bind-Value="_intervalDays" Label="Intervall (Tage)" Min="1" Max="366"
                         Variant="Variant.Outlined"
                         HelperText="Alle wie viele Tage die Top 3 gepostet werden. Die Überschrift folgt: 1 = Tag, 7 = Woche (mit KW), 28–31 = Monat, 90–92 = Quartal, 365 = Jahr, sonst „letzte N Tage“." />

        <MudSwitch T="bool" @bind-Value="_createNote" Color="Color.Primary"
                   Label="Positiven Personalakten-Vermerk für die Top 3 anlegen" />

        <MudStack Row="true" Spacing="2">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveAsync" Disabled="_saving">Speichern</MudButton>
            <MudButton Color="Color.Secondary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Send"
                       OnClick="RunNowAsync" Disabled="_running">Jetzt senden</MudButton>
        </MudStack>

        @if (_lastRun is not null)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Zuletzt gesendet: @_lastRun.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
            </MudText>
        }
    </MudStack>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private ClaimsPrincipal _user = default!;
    private bool _load = true;
    private bool _saving;
    private bool _running;
    private bool _enabled;
    private int _intervalDays = 7;
    private bool _createNote = true;
    private DateTime? _lastRun;

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        var cfg = await Awards.GetConfigAsync();
        _enabled = cfg.Enabled;
        _intervalDays = cfg.IntervalDays;
        _createNote = cfg.CreateNote;
        _lastRun = cfg.LastRun;
        _load = false;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            await Awards.SaveConfigAsync(new TopAgentConfigInput(_enabled, _intervalDays, _createNote), _user);
            Snackbar.Add("Einstellungen gespeichert.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RunNowAsync()
    {
        _running = true;
        try
        {
            var result = await Awards.RunNowAsync(_user);
            if (result.Announced)
            {
                _lastRun = DateTime.UtcNow;
            }
            var (message, severity) = Outcome(result);
            Snackbar.Add(message, severity);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _running = false;
        }
    }

    // "nothing sent" has four different reasons; reporting them as one hides a broken webhook
    private static (string Message, Severity Severity) Outcome(TopAgentRunResult result) => result switch
    {
        { Ranked: 0, OutOfCompetition: 0 } =>
            ("Keine Agenten mit Punkten im Zeitraum — nichts gesendet.", Severity.Info),
        { Ranked: 0 } =>
            ("Nur die Führungsebene hat Punkte gesammelt — sie steht außer Wertung, es wurde nichts gesendet.", Severity.Info),
        { Posted: false, Announced: true } =>
            ("Discord-Ankündigungen sind deaktiviert — es wurde nichts gepostet.", Severity.Info),
        { Posted: false } =>
            ($"Top {result.Ranked} ermittelt, aber Discord hat den Post nicht angenommen.", Severity.Warning),
        _ =>
            ($"Ankündigung gesendet ({result.Ranked} gewertete Agenten).", Severity.Success),
    };
}
