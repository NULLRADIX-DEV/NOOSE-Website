@* Monthly funding budget and carry-over share per division and rank; the rules behind every budget figure. *@
@inject IFinancingConfigService Config
@inject ISnackbar Snackbar

<MudStack Spacing="3">
    <MudText Typo="Typo.h6">Monatsbudget je Abteilung und Dienstgrad</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        Das Grundbudget steht jedem Agenten pro Kalendermonat zur Verfügung, je nach Abteilung und Dienstgrad.
        Das Board gilt dabei für seine Heimatabteilung. Vom nicht genutzten Rest wandert der eingestellte Anteil
        in den Folgemonat — und nur dorthin, nicht weiter. Ein individuell gesetztes Budget in der Personalakte
        schlägt den Wert hier.
    </MudText>

    @if (_load)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudTabs Elevation="0" Rounded="true" TabPanelsClass="pt-3" @bind-ActivePanelIndex="_tab">
            @foreach (var division in DivisionDisplay.All)
            {
                var rows = _rows[division];
                <MudTabPanel Text="@DivisionDisplay.Short(division)" Icon="@DivisionDisplay.Icon(division)">
                    <MudSimpleTable Dense="true" Striped="true">
                        <thead>
                            <tr>
                                <th>Dienstgrad</th>
                                <th style="width:220px">Grundbudget ($)</th>
                                <th style="width:180px">Übertrag (%)</th>
                                <th style="text-align:right">Maximal im Monat</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (rank, budget) in rows)
                            {
                                <tr>
                                    <td>@RankDisplay.Name(rank, division)</td>
                                    <td>
                                        <MudNumericField T="decimal" @bind-Value="budget.BaseMonthly" Min="0" Variant="Variant.Outlined"
                                                         Margin="Margin.Dense" Adornment="Adornment.End" AdornmentText="$"
                                                         HideSpinButtons="true" />
                                    </td>
                                    <td>
                                        <MudNumericField T="int" @bind-Value="budget.CarryOverPercent" Min="0" Max="100"
                                                         Variant="Variant.Outlined" Margin="Margin.Dense"
                                                         Adornment="Adornment.End" AdornmentText="%" />
                                    </td>
                                    <td style="text-align:right">
                                        @Money.Format(budget.BaseMonthly + FinancingMath.CarryOut(budget.BaseMonthly, budget.CarryOverPercent))
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudTabPanel>
            }
        </MudTabs>

        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton OnClick="ResetAsync" StartIcon="@Icons.Material.Filled.RestartAlt">Auf Standard zurücksetzen</MudButton>
            <AuthorizeView Policy="@Policies.Leadership" Context="save">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save"
                           Disabled="_saving" OnClick="SaveAsync">Speichern</MudButton>
            </AuthorizeView>
        </MudStack>
    }
</MudStack>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;
    private bool _saving;
    private ClaimsPrincipal _user = default!;
    private int _tab;
    // holdable ranks per division
    private Dictionary<Division, List<(Rank Rank, FinancingRankBudget Budget)>> _rows = new();

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _load = true;
        // editable read: never from the cache, or the form would show a stale state
        var config = await Config.GetEditableAsync();
        Fill(config);
        _load = false;
    }

    private void Fill(FinancingBudgetConfig config)
        => _rows = DivisionDisplay.All.ToDictionary(division => division, division => RankDisplay.All
            .Where(rank => DivisionRules.MayHold(division, rank))
            .Select(rank =>
            {
                var stored = config.For(rank, division);
                return (rank, new FinancingRankBudget { BaseMonthly = stored.BaseMonthly, CarryOverPercent = stored.CarryOverPercent });
            })
            .ToList());

    private void ResetAsync()
    {
        Fill(FinancingBudgetConfig.Default());
        Snackbar.Add("Standardwerte eingesetzt — noch nicht gespeichert.", Severity.Info);
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            var config = new FinancingBudgetConfig
            {
                // CID doubles as fallback
                Ranks = _rows[Division.Cid].ToDictionary(row => FinancingBudgetConfig.RankKey(row.Rank), row => row.Budget),
                Divisions = _rows.ToDictionary(
                    entry => FinancingBudgetConfig.DivisionKey(entry.Key),
                    entry => entry.Value.ToDictionary(row => FinancingBudgetConfig.RankKey(row.Rank), row => row.Budget)),
            };
            await Config.SaveAsync(config, _user);
            Snackbar.Add("Finanzierungs-Budgets gespeichert.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
