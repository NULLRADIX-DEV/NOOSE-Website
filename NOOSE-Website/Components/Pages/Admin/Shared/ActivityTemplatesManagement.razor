@* Activity-template (HTML body) management, embedded as a tab in template management. *@
@inject IActivityTemplateService TemplateService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<SectionHeader Title="Aktivitäts-Vorlagen" Class="mb-1">
    <Actions>
        <MudButton Href="/admin/vorlagen/aktivitaet-vorlage/neu" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
            Neue Vorlage
        </MudButton>
    </Actions>
</SectionHeader>
<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
    Neue Aktivitäten gibt es nicht mehr: Einsätze laufen über Operationen mit Einsatzbericht. Diese Vorlagen werden deshalb
    nirgends mehr angeboten und bleiben nur zum Nachlesen.
</MudAlert>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Vorlagen für Aktivitäten: ein formatierter Text mit optionalen Platzhaltern (z. B. {{Datum}}, {{Agent}})
    und optional eine Standard-Art, der beim Anlegen einer Aktivität in den Editor übernommen wird.
</MudText>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudTable Items="_templates" Hover="true" Breakpoint="Breakpoint.None" Elevation="2" Dense="true">
        <HeaderContent>
            <MudTh><MudTableSortLabel T="ActivityTemplate" SortBy="@(x => x.Name)">Name</MudTableSortLabel></MudTh>
            <MudTh Class="noose-mobil-aus"><MudTableSortLabel T="ActivityTemplate" SortBy="@(x => x.Description)">Beschreibung</MudTableSortLabel></MudTh>
            <MudTh Class="noose-mobil-aus"><MudTableSortLabel T="ActivityTemplate" SortBy="@(x => x.Kind)">Art</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="ActivityTemplate" SortBy="@(x => x.IsActive)">Status</MudTableSortLabel></MudTh>
            <MudTh Style="text-align:right;">Aktion</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Beschreibung" Class="noose-mobil-aus">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@(string.IsNullOrWhiteSpace(context.Description) ? "—" : context.Description)</MudText>
            </MudTd>
            <MudTd DataLabel="Art" Class="noose-mobil-aus">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@(string.IsNullOrWhiteSpace(context.Kind) ? "—" : context.Kind)</MudText>
            </MudTd>
            <MudTd DataLabel="Status">
                @if (context.IsActive)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Aktiv</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">Inaktiv</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Aktion" Style="text-align:right;">
                <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                   Href="@($"/admin/vorlagen/aktivitaet-vorlage/{context.Id}/bearbeiten")" aria-label="Vorlage bearbeiten" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => DeleteAsync(context))" aria-label="Vorlage löschen" />
                </MudStack>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">Noch keine Aktivitäts-Vorlagen angelegt.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;
    private List<ActivityTemplate> _templates = new();
    private ClaimsPrincipal _user = default!;

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _load = true;
        _templates = await TemplateService.GetAllAsync();
        _load = false;
    }

    private async Task DeleteAsync(ActivityTemplate template)
    {
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Vorlage löschen?",
            $"„{template.Name}“ wird in den Papierkorb verschoben.");
        if (!ok)
        {
            return;
        }
        try
        {
            await TemplateService.DeleteAsync(template.Id, _user);
            Snackbar.Add("Vorlage gelöscht.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
