@* Editorial pages of the public area: draft, preview, publish, retract. *@
@using NOOSE_Website.Models.Public
@inject IPublicPageService PageService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Redaktionelle Seiten unter <code>/info/&lt;adresse&gt;</code>. Der <em>Text</em> einer Seite ändert sich für
    Besucher erst beim Veröffentlichen. Titel und Menü-Einstellungen wirken dagegen sofort, und die Adresse einer
    veröffentlichten Seite lässt sich erst nach dem Zurückziehen ändern. Vor dem Veröffentlichen lässt sich jeder Entwurf
    als Agent über die Vorschau ansehen; anonym ist er nicht erreichbar. Die Seiten erscheinen nur, solange das
    Modul „Information" eingeschaltet ist. Eine Ausnahme: die Seite <code>faq</code> liefert Überschrift und
    Einleitung der eigenen Seite <code>/faq</code> und hängt am Modul „Häufige Fragen" — im Menü unter
    <code>/info</code> taucht sie nicht auf.
</MudText>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_edit is not null)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3 noose-kopf-umbruch">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="CloseEditor" aria-label="Zurück zur Liste" />
        <MudText Typo="Typo.h6" Class="noose-eintrag-titel">@(_isNew ? "Neue Seite" : _edit.Title)</MudText>
        <MudSpacer />
        @if (!_isNew)
        {
            <MudButton Href="@($"{PublicFaq.PageHref(_savedSlug)}?vorschau=1")" Target="_blank" Variant="Variant.Text"
                       Color="Color.Default" StartIcon="@Icons.Material.Filled.Visibility">Vorschau</MudButton>
        }
        @* below 960px the same button pins to the foot of the form *@
        <MudButton OnClick="SaveDraftAsync" Variant="Variant.Filled" Color="Color.Primary" Class="noose-schmal-aus"
                   StartIcon="@Icons.Material.Filled.Save" Disabled="_save">Entwurf speichern</MudButton>
    </MudStack>

    <MudPaper Outlined="true" Class="pa-4">
        <MudStack Spacing="3">
            <MudGrid>
                <MudItem xs="12" md="7">
                    @* MaxLength, because the service cuts silently once the column is full *@
                    <MudTextField @bind-Value="_edit.Title" Label="Titel" Variant="Variant.Outlined" Required="true"
                                  RequiredError="Titel ist erforderlich"
                                  MaxLength="@PublicPageRules.MaxTitle" Counter="@PublicPageRules.MaxTitle" />
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudTextField @bind-Value="_edit.Slug" Label="Adresse (/info/…)" Variant="Variant.Outlined"
                                  Placeholder="@SlugSuggestion" HelperText="Leer lassen, um sie aus dem Titel zu bilden."
                                  MaxLength="@PublicPageSlug.MaxLength" />
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudTextField @bind-Value="_edit.MenuTitle" Label="Menütitel (optional)" Variant="Variant.Outlined"
                                  Placeholder="@_edit.Title"
                                  MaxLength="@PublicPageRules.MaxMenuTitle" Counter="@PublicPageRules.MaxMenuTitle" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="_edit.IconName" Label="Icon" Clearable="true"
                               Variant="Variant.Outlined">
                        @foreach (var choice in PublicModules.IconChoices)
                        {
                            <MudSelectItem T="string" Value="@choice.Name">@choice.Label</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudNumericField T="int" @bind-Value="_edit.SortOrder" Label="Reihenfolge" Min="0" Max="9999"
                                     Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>

            <MudSwitch T="bool" @bind-Value="_edit.ShowInMenu" Color="Color.Primary"
                       Label="In Übersicht und Menü zeigen" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Aus heißt: veröffentlicht und über den direkten Link erreichbar, aber nicht verlinkt.
            </MudText>

            <MudText Typo="Typo.subtitle2">Entwurf</MudText>
            @* keyed by row: switching pages must re-initialise Quill instead of keeping the previous content *@
            <RichTextEditor @ref="_editor" @key="_editorKey" Value="@_draftHtml" MinHeight="360px"
                            DraftKey='@(_edit is null ? null : $"oeffentliche-seite:{_edit.Id}")' />
            <FormActions Class="noose-nur-schmal">
                <MudButton OnClick="SaveDraftAsync" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save" Disabled="_save">Entwurf speichern</MudButton>
            </FormActions>
        </MudStack>
    </MudPaper>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
        <MudSpacer />
        @if (_mayEdit)
        {
            <MudButton OnClick="NewPage" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add">Neue Seite</MudButton>
        }
    </MudStack>

    <MudTable Items="_rows" Hover="true" Breakpoint="Breakpoint.None" Elevation="2" Dense="true">
        <HeaderContent>
            <MudTh>Titel</MudTh>
            <MudTh Class="noose-mobil-aus">Adresse</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Class="noose-mobil-aus">Zuletzt veröffentlicht</MudTh>
            <MudTh Style="text-align:right;">Aktion</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Titel">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@PublicModules.IconFor(context.IconName, PublicModules.PageDefaultIcon)" Size="Size.Small" />
                    <MudText Typo="Typo.body2">@context.Title</MudText>
                    @if (!context.ShowInMenu)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">nicht verlinkt</MudChip>
                    }
                </MudStack>
            </MudTd>
            <MudTd DataLabel="Adresse" Class="noose-mobil-aus"><code>@PublicFaq.PageHref(context.Slug)</code></MudTd>
            <MudTd DataLabel="Status">
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    @if (context.Status == PublicPageStatus.Veroeffentlicht)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Veröffentlicht</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">Entwurf</MudChip>
                    }
                    @* only meaningful next to a published page; on a draft the status chip already says it *@
                    @if (context.DraftDiffers && context.Status == PublicPageStatus.Veroeffentlicht)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                            Entwurf abweichend
                        </MudChip>
                    }
                </MudStack>
            </MudTd>
            <MudTd DataLabel="Zuletzt veröffentlicht" Class="noose-mobil-aus">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @(context.PublishedAt is { } at
                        ? $"{at.ToLocalTime():dd.MM.yyyy HH:mm}{(context.PublishedByName is { } who ? $" · {who}" : "")}"
                        : "—")
                </MudText>
            </MudTd>
            <MudTd DataLabel="Aktion" Style="text-align:right;">
                <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Class="noose-mobil-aus">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Default"
                                   Href="@($"{PublicFaq.PageHref(context.Slug)}?vorschau=1")" Target="_blank" aria-label="Entwurf ansehen" />
                    @if (_mayEdit)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => OpenEditorAsync(context))" aria-label="Seite bearbeiten" />
                        @if (context.Status == PublicPageStatus.Veroeffentlicht)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.CloudOff" Size="Size.Small" Color="Color.Warning"
                                           OnClick="@(() => RetractAsync(context))" aria-label="Seite zurückziehen" />
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Small" Color="Color.Success"
                                       OnClick="@(() => PublishAsync(context))" aria-label="Seite veröffentlichen" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeleteAsync(context))" aria-label="Seite löschen" />
                    }
                </MudStack>
                @* phones: the same actions under the same conditions in a ⋮ menu, deleting last after a line *@
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" Class="noose-nur-handy"
                         AriaLabel="Aktionen" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudMenuItem Icon="@Icons.Material.Filled.Visibility" Href="@($"{PublicFaq.PageHref(context.Slug)}?vorschau=1")" Target="_blank">Entwurf ansehen</MudMenuItem>
                    @if (_mayEdit)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => OpenEditorAsync(context))">Bearbeiten</MudMenuItem>
                        @if (context.Status == PublicPageStatus.Veroeffentlicht)
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.CloudOff" IconColor="Color.Warning" OnClick="@(() => RetractAsync(context))">Zurückziehen</MudMenuItem>
                        }
                        <MudMenuItem Icon="@Icons.Material.Filled.CloudUpload" IconColor="Color.Success" OnClick="@(() => PublishAsync(context))">Veröffentlichen</MudMenuItem>
                        <MudDivider Class="my-1" />
                        <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="@(() => DeleteAsync(context))">Löschen</MudMenuItem>
                    }
                </MudMenu>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">Noch keine öffentlichen Seiten angelegt.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private ClaimsPrincipal _user = default!;
    private bool _mayEdit;
    private bool _load = true;
    private bool _save;

    private IReadOnlyList<PublicPageEdit> _rows = Array.Empty<PublicPageEdit>();

    private PublicPageInput? _edit;
    private bool _isNew;
    private string? _draftHtml;
    // the address as stored; the bound field may already hold an edited one the preview route does not know
    private string _savedSlug = string.Empty;
    private string _editorKey = "neu";
    private RichTextEditor? _editor;

    private string SlugSuggestion => PublicPageSlug.Normalize(_edit?.Title);

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _mayEdit = _user.IsLeadership() && _user.MayWrite();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _load = true;
        try
        {
            _rows = await PageService.GetAllAsync(_user);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _load = false;
        }
    }

    private void NewPage()
    {
        _isNew = true;
        _draftHtml = null;
        _editorKey = "neu";
        _edit = new PublicPageInput { SortOrder = NextSortOrder() };
    }

    private int NextSortOrder()
        => _rows.Count == 0 ? 10 : Math.Min(9999, _rows.Max(r => r.SortOrder) + 10);

    private async Task OpenEditorAsync(PublicPageEdit row)
    {
        try
        {
            // the list carries no HTML; fetch the one body about to be edited
            _draftHtml = await PageService.GetDraftAsync(row.Id, _user);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }

        _isNew = false;
        _editorKey = row.Id;
        _savedSlug = row.Slug;
        _edit = new PublicPageInput
        {
            Id = row.Id,
            Slug = row.Slug,
            Title = row.Title,
            MenuTitle = row.MenuTitle,
            IconName = row.IconName,
            SortOrder = row.SortOrder,
            ShowInMenu = row.ShowInMenu,
            LoadedModifiedAt = row.ModifiedAt,
        };
    }

    private void CloseEditor()
    {
        _edit = null;
        _editor = null;
    }

    private async Task SaveDraftAsync()
    {
        if (_edit is null)
        {
            return;
        }

        _save = true;
        try
        {
            // an empty address is derived from the title, so nobody has to invent a slug by hand
            if (string.IsNullOrWhiteSpace(_edit.Slug))
            {
                _edit.Slug = PublicPageSlug.Normalize(_edit.Title);
            }
            // null would tell the service to keep the stored draft; only send a body once the editor really answered
            _edit.DraftHtml = _editor is null ? _draftHtml : await _editor.GetHtmlAsync();

            await PageService.SaveDraftAsync(_edit, _user);
            if (_editor is not null)
            {
                await _editor.MarkSavedAsync();
            }
            Snackbar.Add("Entwurf gespeichert.", Severity.Success);
            await LoadAsync();
            CloseEditor();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _save = false;
        }
    }

    private async Task PublishAsync(PublicPageEdit row)
    {
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Seite veröffentlichen?",
            $"Der aktuelle Entwurf von „{row.Title}“ wird unter {PublicFaq.PageHref(row.Slug)} öffentlich sichtbar.",
            "Veröffentlichen", Color.Success);
        if (!ok)
        {
            return;
        }
        try
        {
            await PageService.PublishAsync(row.Id, _user);
            Snackbar.Add("Seite veröffentlicht.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RetractAsync(PublicPageEdit row)
    {
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Seite zurückziehen?",
            $"„{row.Title}“ ist danach öffentlich nicht mehr erreichbar. Der Entwurf bleibt erhalten.",
            "Zurückziehen", Color.Warning);
        if (!ok)
        {
            return;
        }
        try
        {
            await PageService.RetractAsync(row.Id, _user);
            Snackbar.Add("Seite zurückgezogen.", Severity.Info);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(PublicPageEdit row)
    {
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Seite löschen?",
            $"„{row.Title}“ wird in den Papierkorb verschoben und ist öffentlich nicht mehr erreichbar.");
        if (!ok)
        {
            return;
        }
        try
        {
            await PageService.DeleteAsync(row.Id, _user);
            Snackbar.Add("Seite gelöscht.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
