@* What a partner unit may see; the agency selector lives on the parent panel. *@
@inject IPartnerUnitService Units
@inject ISnackbar Snackbar

<MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">
    Lege je Einheit fest, welche Akten-Bereiche und welche Tabs darin standardmäßig sichtbar sind.
    Ohne Einschränkung sieht eine Einheit alle für sie freigegebenen Akten. Einzelfreigaben an ein
    einzelnes Konto bleiben unberührt – sie zeigen die Akte immer vollständig.
    Diese Einstellung schränkt nur ein; <b>welche Akten überhaupt freigegeben sind, steuerst du oben.</b>
</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudSelect T="string" Value="_unitId" ValueChanged="UnitChangedAsync" Label="Einheit"
                   Dense="true" Variant="Variant.Outlined" Style="min-width:220px;">
            @foreach (var u in _units)
            {
                <MudSelectItem T="string" Value="@u.Id">@u.Name</MudSelectItem>
            }
        </MudSelect>
        @if (_units.FirstOrDefault(u => u.Id == _unitId) is { } current)
        {
            <MudChip T="string" Color="Color.Info" Variant="Variant.Filled">@current.FullName</MudChip>
        }
    </MudStack>
</MudPaper>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudSwitch T="bool" Value="_restricted" ValueChanged="RestrictedChanged" Color="Color.Primary"
                   Label="Sichtbarkeit für diese Einheit einschränken" Disabled="!_mayEdit" />
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            Aus: die Einheit sieht alle freigegebenen Akten und Tabs. Ein: nur die unten angehakten Bereiche und Tabs.
        </MudText>
    </MudPaper>

    @if (_restricted)
    {
        <MudGrid Spacing="3">
            @foreach (var type in PartnerTabCatalog.All)
            {
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Elevation="1">
                        <MudCheckBox T="bool" Value="@_typeChecked[type.TypeKey]"
                                     ValueChanged="@(v => TypeToggled(type.TypeKey, v))"
                                     Color="Color.Primary" Label="@type.DisplayName" />
                        @if (_typeChecked[type.TypeKey] && type.Tabs.Count > 0)
                        {
                            <MudStack Class="ml-6 mt-1" Spacing="0">
                                @foreach (var tab in type.Tabs)
                                {
                                    <MudCheckBox T="bool" Dense="true" Value="@_tabChecked[type.TypeKey][tab.Slug]"
                                                 ValueChanged="@(v => TabToggled(type.TypeKey, tab.Slug, v))"
                                                 Color="Color.Primary" Label="@tab.Label" />
                                }
                            </MudStack>
                        }
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }

    @if (_mayEdit)
    {
        <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAsync" Disabled="@(_busy || _unitId is null)">Speichern</MudButton>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    /// <summary>Agency whose unit visibility is edited; owned by the parent panel.</summary>
    [Parameter] public PartnerAgency Agency { get; set; }

    /// <summary>Bumped by the parent when units were added or renamed.</summary>
    [Parameter] public int Version { get; set; }

    private ClaimsPrincipal _user = default!;
    private bool _load = true;
    private bool _busy;
    private bool _mayEdit;
    private (PartnerAgency, int)? _loadedFor;
    private IReadOnlyList<PartnerUnitView> _units = Array.Empty<PartnerUnitView>();
    private string? _unitId;
    private bool _restricted;
    private Dictionary<string, bool> _typeChecked = new();
    private Dictionary<string, Dictionary<string, bool>> _tabChecked = new();

    // the parent swaps the agency without recreating this component, so react to parameters
    protected override async Task OnParametersSetAsync()
    {
        _user = (await AuthStateTask).User;
        _mayEdit = _user.IsAdmin() && _user.MayWrite();
        if (_loadedFor == (Agency, Version))
        {
            return;
        }
        _loadedFor = (Agency, Version);
        _units = await Units.ForAgencyAsync(Agency);
        if (_units.All(u => u.Id != _unitId))
        {
            _unitId = _units.FirstOrDefault()?.Id;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _load = true;
        var entry = (await Units.GetAsync(_unitId))?.Visibility;
        _restricted = entry is not null;
        BuildState(entry);
        _load = false;
    }

    // null entry = "sees all" → every box checked (starting point when the admin enables restriction)
    private void BuildState(PartnerUnitVisibility? entry)
    {
        _typeChecked = new();
        _tabChecked = new();
        foreach (var type in PartnerTabCatalog.All)
        {
            var typeOn = entry is null || entry.Types.Contains(type.TypeKey);
            _typeChecked[type.TypeKey] = typeOn;

            List<string>? slugs = null;
            entry?.Tabs.TryGetValue(type.TypeKey, out slugs);

            var tabMap = new Dictionary<string, bool>();
            foreach (var tab in type.Tabs)
            {
                tabMap[tab.Slug] = entry is null
                    ? true
                    : (slugs is not null ? slugs.Contains(tab.Slug) : typeOn);
            }
            _tabChecked[type.TypeKey] = tabMap;
        }
    }

    private async Task UnitChangedAsync(string unitId)
    {
        _unitId = unitId;
        await LoadAsync();
    }

    private void RestrictedChanged(bool on)
    {
        _restricted = on;
        if (on)
        {
            // start from "sees all" so the admin only has to subtract
            BuildState(null);
        }
    }

    private void TypeToggled(string typeKey, bool on)
    {
        _typeChecked[typeKey] = on;
        if (on)
        {
            // enabling a type defaults all its tabs on
            var map = _tabChecked[typeKey];
            foreach (var slug in map.Keys.ToList())
            {
                map[slug] = true;
            }
        }
    }

    private void TabToggled(string typeKey, string slug, bool on) => _tabChecked[typeKey][slug] = on;

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            await Units.SaveVisibilityAsync(_unitId!, _restricted ? Build() : null, _user);
            Snackbar.Add("Partner-Sichtbarkeit gespeichert – wirksam beim nächsten Seitenwechsel.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private PartnerUnitVisibility Build()
    {
        var vis = new PartnerUnitVisibility();
        foreach (var type in PartnerTabCatalog.All)
        {
            if (!_typeChecked[type.TypeKey])
            {
                continue;
            }
            vis.Types.Add(type.TypeKey);
            if (type.Tabs.Count == 0)
            {
                continue;
            }
            var map = _tabChecked[type.TypeKey];
            var picked = type.Tabs.Where(t => map[t.Slug]).Select(t => t.Slug).ToList();
            // all tabs picked = no restriction; a subset (incl. none) is stored explicitly
            if (picked.Count < type.Tabs.Count)
            {
                vis.Tabs[type.TypeKey] = picked;
            }
        }
        return vis;
    }
}
