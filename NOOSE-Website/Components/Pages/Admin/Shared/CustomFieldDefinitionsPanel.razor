@inject ICustomFieldDefinitionService FieldService
@inject IDialogService DialogService
@inject ISnackbar Snackbar


<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="NewAsync">
        Neues Feld
    </MudButton>
</MudStack>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">
    Zusatzfelder erweitern die Akten je Aktentyp – ohne Code. Aktive Felder erscheinen auf den jeweiligen
    Akten im Tab „Zusatzfelder“ und können dort von jedem aktiven Agenten ausgefüllt werden.
</MudText>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
    <MudSelect T="string" Label="Aktentyp-Filter" @bind-Value="_filterType" @bind-Value:after="StateHasChanged"
               Variant="Variant.Outlined" Dense="true" Clearable="true" Style="max-width:280px;" Class="noose-filter-feld">
        <MudSelectItem T="string" Value="@("")">Alle Aktentypen</MudSelectItem>
        @foreach (var t in CustomFieldRecordTypes.All)
        {
            <MudSelectItem T="string" Value="@t.TypeName">@t.Display</MudSelectItem>
        }
    </MudSelect>
</MudStack>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudTable Items="Filtered" Hover="true" Breakpoint="Breakpoint.None" Elevation="2" Dense="true">
        <HeaderContent>
            <MudTh><MudTableSortLabel T="CustomFieldDefinition" SortBy="@(x => CustomFieldRecordTypes.Display(x.EntityType))">Aktentyp</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="CustomFieldDefinition" SortBy="@(x => x.Name)">Feld</MudTableSortLabel></MudTh>
            <MudTh Class="noose-mobil-aus"><MudTableSortLabel T="CustomFieldDefinition" SortBy="@(x => CustomFieldTypeDisplay.Name(x.FieldType))">Typ</MudTableSortLabel></MudTh>
            <MudTh Class="noose-mobil-aus"><MudTableSortLabel T="CustomFieldDefinition" SortBy="@(x => x.Mandatory)">Pflicht</MudTableSortLabel></MudTh>
            <MudTh Class="noose-mobil-aus"><MudTableSortLabel T="CustomFieldDefinition" SortBy="@(x => x.IsActive)">Status</MudTableSortLabel></MudTh>
            <MudTh Style="text-align:right;">Aktion</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Aktentyp">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">@CustomFieldRecordTypes.Display(context.EntityType)</MudChip>
            </MudTd>
            <MudTd DataLabel="Feld">@context.Name</MudTd>
            <MudTd DataLabel="Typ" Class="noose-mobil-aus">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@CustomFieldTypeDisplay.Name(context.FieldType)</MudChip>
            </MudTd>
            <MudTd DataLabel="Pflicht" Class="noose-mobil-aus">
                @if (context.Mandatory)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">Pflicht</MudChip>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">optional</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Status" Class="noose-mobil-aus">
                @if (context.IsActive)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Aktiv</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">Inaktiv</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Aktion" Style="text-align:right;">
                <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                   OnClick="@(() => EditAsync(context))" aria-label="Feld bearbeiten" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => DeleteAsync(context))" aria-label="Feld löschen" />
                </MudStack>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">Noch keine Custom-Felder angelegt.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;
    private List<CustomFieldDefinition> _fields = new();
    private ClaimsPrincipal _user = default!;
    private string? _filterType;

    private IEnumerable<CustomFieldDefinition> Filtered =>
        string.IsNullOrEmpty(_filterType) ? _fields : _fields.Where(d => d.EntityType == _filterType);

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _load = true;
        _fields = await FieldService.GetAllAsync();
        _load = false;
    }

    private async Task NewAsync()
    {
        var input = await CustomFieldDefinitionDialog.ShowAsync(DialogService, "Neues Custom-Feld", defaultType: _filterType);
        if (input is null)
        {
            return;
        }
        try
        {
            await FieldService.CreateAsync(input, _user);
            Snackbar.Add("Feld angelegt.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task EditAsync(CustomFieldDefinition field)
    {
        var input = await CustomFieldDefinitionDialog.ShowAsync(DialogService, "Custom-Feld bearbeiten", field);
        if (input is null)
        {
            return;
        }
        try
        {
            await FieldService.RefreshAsync(field.Id, input, _user);
            Snackbar.Add("Feld gespeichert.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(CustomFieldDefinition field)
    {
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Feld löschen?",
            $"„{field.Name}“ wird in den Papierkorb verschoben. Bereits erfasste Werte bleiben erhalten, sind aber nicht mehr sichtbar.");
        if (!ok)
        {
            return;
        }
        try
        {
            await FieldService.DeleteAsync(field.Id, _user);
            Snackbar.Add("Feld gelöscht.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
