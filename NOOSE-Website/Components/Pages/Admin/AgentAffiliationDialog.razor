@* Dialog to change an active account's affiliation: internal agent (with rank) or a unit of a partner agency.
   Switching to a partner clears the internal rank and flags. *@
@inject IPartnerUnitService Units

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined">
                Beim Wechsel zu einer Partnerbehörde verliert das Konto Dienstgrad, Abteilung, Administration Division,
                Teamleitung und Admin-Rechte und erhält nur noch Lesezugriff auf freigegebene Akten. Beim Wechsel zu
                einem internen FIB-Agenten wird die Partner-Zugehörigkeit entfernt und ein Dienstgrad
                vergeben. In beiden Fällen muss sich der Agent neu anmelden.
            </MudAlert>

            <MudRadioGroup @bind-Value="_isPartner">
                <MudRadio T="bool" Value="@false" Color="Color.Primary">Interner FIB-Agent</MudRadio>
                <MudRadio T="bool" Value="@true" Color="Color.Info">Partnerbehörde</MudRadio>
            </MudRadioGroup>

            @if (_isPartner)
            {
                <MudSelect T="string" @bind-Value="_unitId" Label="Behörde und Einheit" Variant="Variant.Outlined" Dense="true">
                    @foreach (var unit in _units)
                    {
                        <MudSelectItem T="string" Value="@unit.Id">@unit.FullName</MudSelectItem>
                    }
                </MudSelect>
                <MudCheckBox T="bool" @bind-Value="_isUnitLead" Color="Color.Primary" Label="Leitung der Einheit" />
            }
            else
            {
                @if (_ranks.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                        Mit deinem Dienstgrad kannst du hier keinen Dienstgrad vergeben.
                    </MudAlert>
                }
                else
                {
                    <MudSelect T="Rank" @bind-Value="_rank" Label="Dienstgrad" Variant="Variant.Outlined" Dense="true">
                        @foreach (var dg in _ranks)
                        {
                            <MudSelectItem Value="dg">@RankDisplay.Name(dg)</MudSelectItem>
                        }
                    </MudSelect>
                }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Confirm"
                   Disabled="@((!_isPartner && _ranks.Count == 0) || (_isPartner && _unitId is null))">Übernehmen</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    [Parameter] public PartnerAgency? CurrentAgency { get; set; }
    [Parameter] public string? CurrentUnitId { get; set; }
    [Parameter] public bool CurrentUnitLead { get; set; }
    [Parameter] public Rank? CurrentRank { get; set; }

    private bool _isPartner;
    private IReadOnlyList<PartnerUnitView> _units = Array.Empty<PartnerUnitView>();
    private string? _unitId;
    private bool _isUnitLead;
    private Rank _rank = Rank.Trainee;
    private IReadOnlyList<Rank> _ranks = [];

    protected override async Task OnInitializedAsync()
    {
        // a switch to internal is a first release: the CID, or the own division for a Section Chief
        var viewer = PromotionStanding.Of((await AuthStateTask).User);
        var division = PromotionRules.ReleaseDivision(viewer);
        _ranks = PromotionRules.AssignableRanks(viewer, division, null).Where(r => DivisionRules.MayHold(division, r)).ToList();
        _isPartner = CurrentAgency is not null;
        _units = await Units.GetAllAsync();
        _unitId = _units.Any(u => u.Id == CurrentUnitId) ? CurrentUnitId : _units.FirstOrDefault()?.Id;
        _isUnitLead = CurrentUnitLead;
        _rank = CurrentRank is { } current && _ranks.Contains(current) ? current : _ranks.FirstOrDefault(Rank.Trainee);
    }

    private void Confirm()
        => MudDialog.Close(DialogResult.Ok(new AgentAffiliation(_isPartner ? _unitId : null, _isUnitLead, _rank)));

    private void Cancel() => MudDialog.Cancel();

    /// <summary>Show the affiliation dialog; returns the chosen affiliation or null if cancelled.</summary>
    public static async Task<AgentAffiliation?> ShowAsync(IDialogService dialog, Agent agent)
    {
        var parameters = new DialogParameters<AgentAffiliationDialog>
        {
            { x => x.CurrentAgency, agent.PartnerAgency },
            { x => x.CurrentUnitId, agent.PartnerUnitId },
            { x => x.CurrentUnitLead, agent.IsPartnerUnitLead },
            { x => x.CurrentRank, agent.Rank },
        };
        var reference = await dialog.ShowAsync<AgentAffiliationDialog>("Zugehörigkeit ändern", parameters);
        var result = await reference.Result;
        return result is { Canceled: false, Data: AgentAffiliation a } ? a : null;
    }

    /// <summary>Result of the affiliation dialog. Unit null = internal agent (Rank applies).</summary>
    public record AgentAffiliation(string? PartnerUnitId, bool IsUnitLead, Rank Rank);
}
