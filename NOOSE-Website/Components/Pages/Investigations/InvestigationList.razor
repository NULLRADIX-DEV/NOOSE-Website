@page "/ermittlungen"
@* open to partners too: the list only ever holds files the viewer takes part in *@
@inject IInvestigationService Investigations

<PageTitle>Ermittlungen · FIB</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.Gavel" Title="Ermittlungen"
            Subtitle="Ermittlungsakten, die FIB und DoJ gemeinsam führen. Jede hängt an einer Taskforce und ist nur für ihre Beteiligten sichtbar.">
    <Actions>
        @if (_mayCreate)
        {
            <MudButton Href="/ermittlungen/import" Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.UploadFile">Aus Excel übernehmen</MudButton>
            <MudButton Href="/ermittlungen/neu" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">Neue Ermittlung</MudButton>
        }
    </Actions>
</PageHeader>

<MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mb-3">
    <MudTextField @bind-Value="_search" Placeholder="Aktenzeichen, Titel, Az. SID, Taskforce …" Immediate="true" Clearable="true"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Class="flex-grow-1" Style="min-width:220px;" />
    <MudSelect T="string" @bind-Value="_status" Label="Status" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:180px;">
        <MudSelectItem T="string" Value="@("offen")">Laufend</MudSelectItem>
        <MudSelectItem T="string" Value="@("alle")">Alle</MudSelectItem>
        @foreach (var s in InvestigationDisplay.Statuses)
        {
            <MudSelectItem T="string" Value="@s.ToString()">@InvestigationDisplay.Name(s)</MudSelectItem>
        }
    </MudSelect>
</MudStack>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_rows.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Filled.Gavel" Title="Keine Ermittlungen"
                Text="Du bist an keiner Ermittlung beteiligt. Beteiligte trägt die Ermittlungsleitung im Tab „Beteiligte & Zugriff“ ein." />
}
else
{
    <MudTable Items="Filtered" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" T="InvestigationListItem">
        <HeaderContent>
            <MudTh>Aktenzeichen</MudTh>
            <MudTh>Titel</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Taskforce</MudTh>
            <MudTh>Az. SID</MudTh>
            <MudTh>Staatsanwalt</MudTh>
            <MudTh>Eröffnet</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Aktenzeichen"><MudLink Href="@($"/ermittlungen/{context.Id}")">@context.CaseNumber</MudLink></MudTd>
            <MudTd DataLabel="Titel"><MudLink Href="@($"/ermittlungen/{context.Id}")" Color="Color.Inherit">@context.Title</MudLink></MudTd>
            <MudTd DataLabel="Status"><InvestigationStatusChip Status="context.Status" /></MudTd>
            <MudTd DataLabel="Taskforce">@(context.TaskforceName ?? "—")</MudTd>
            <MudTd DataLabel="Az. SID">@(context.SidCaseNumber ?? "—")</MudTd>
            <MudTd DataLabel="Staatsanwalt">@(context.Prosecutors.Count == 0 ? "—" : string.Join(", ", context.Prosecutors))</MudTd>
            <MudTd DataLabel="Eröffnet">@context.OpenedAt.ToLocalTime().ToString("dd.MM.yyyy")</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;
    private bool _mayCreate;
    private string _search = string.Empty;
    private string _status = "offen";
    private List<InvestigationListItem> _rows = new();

    private IEnumerable<InvestigationListItem> Filtered => _rows
        .Where(r => _status switch
        {
            "offen" => InvestigationDisplay.IsOpen(r.Status),
            "alle" => true,
            _ => r.Status.ToString() == _status,
        })
        .Where(r => string.IsNullOrWhiteSpace(_search)
            || r.CaseNumber.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || r.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (r.SidCaseNumber ?? string.Empty).Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (r.TaskforceName ?? string.Empty).Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateTask).User;
        _rows = await Investigations.GetListAsync(user);
        _mayCreate = await Investigations.MayCreateAsync(user);
        _load = false;
    }
}
