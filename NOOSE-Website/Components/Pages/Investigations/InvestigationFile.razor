@page "/ermittlungen/{Id}"
@* open to partners: InvestigationAccess decides per tab and per entry, the page only shows what the service returns *@
@inject IInvestigationService Investigations
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@(_detail?.CaseNumber ?? "Ermittlung") · FIB</PageTitle>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_detail is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        Ermittlung nicht gefunden oder du bist nicht beteiligt.
    </MudAlert>
}
else
{
    var d = _detail;
    var a = d.Access;
    <PageHeader Icon="@Icons.Material.Filled.Gavel" Title="@($"{d.CaseNumber} · {d.Title}")" BackHref="/ermittlungen">
        <SubtitleContent>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <InvestigationStatusChip Status="d.Status" />
                @if (!string.IsNullOrWhiteSpace(d.SidCaseNumber))
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Az. SID @d.SidCaseNumber</MudText>
                }
                @if (d.Prosecutors.Count > 0)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">StA @string.Join(", ", d.Prosecutors)</MudText>
                }
            </MudStack>
        </SubtitleContent>
        @* as on the other files: print and delete keep their places from 960px up and move into the ⋮ menu below *@
        <Actions>
            <div class="d-contents noose-schmal-aus">
                <MudTooltip Text="Druckansicht im Aktenlayout">
                    <MudIconButton Icon="@Icons.Material.Filled.Print" Href="@($"/ermittlungen/{d.Id}/druck")" Target="_blank" aria-label="Druckansicht öffnen" />
                </MudTooltip>
            </div>
            @if (a.CanEdit(InvestigationTabs.Overview))
            {
                <MudButton Href="@($"/ermittlungen/{d.Id}/bearbeiten")" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit">Deckblatt</MudButton>
            }
            @if (a.FullAccess)
            {
                <div class="d-contents noose-schmal-aus">
                    <MudButton Color="Color.Error" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync">Löschen</MudButton>
                </div>
            }
            <HeaderMenu>
                <MudMenuItem Icon="@Icons.Material.Filled.Print" Href="@($"/ermittlungen/{d.Id}/druck")" Target="_blank">Druckansicht</MudMenuItem>
                @if (a.FullAccess)
                {
                    <MudDivider Class="my-1" />
                    <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="DeleteAsync">Löschen</MudMenuItem>
                }
            </HeaderMenu>
        </Actions>
    </PageHeader>

    @if (!a.MayWrite && (a.FullAccess || InvestigationTabs.Slugs.Any(s => a.Level(s) == InvestigationAccessLevel.Edit)))
    {
        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-3">Du liest diese Ermittlung nur.</MudAlert>
    }

    <RecordSectionRail>
        <RecordSection Slug="@InvestigationTabs.Overview" Label="Übersicht" Icon="@Icons.Material.Outlined.Summarize">
            <InvestigationOverviewPanel Detail="d" User="_user" />
        </RecordSection>
        @if (a.CanRead(InvestigationTabs.Charges))
        {
            <RecordSection Slug="@InvestigationTabs.Charges" Label="Tatvorwurf" Icon="@Icons.Material.Outlined.Gavel" Badge="@d.Charges.Count">
                <InvestigationChargesPanel Detail="d" User="_user" Changed="ReloadAsync" Highlight="@_highlight" />
                <InvestigationEntryScroll Target="@ScrollFor(InvestigationTabs.Charges)" Done="@(() => _scrollPending = false)" />
            </RecordSection>
        }
        @if (a.CanRead(InvestigationTabs.Narrative))
        {
            <RecordSection Slug="@InvestigationTabs.Narrative" Label="Tathergang" Icon="@Icons.Material.Outlined.Article">
                <InvestigationNarrativePanel Detail="d" User="_user" Changed="ReloadAsync" />
            </RecordSection>
        }
        @if (a.CanRead(InvestigationTabs.People))
        {
            <RecordSection Slug="@InvestigationTabs.People" Label="Zeugen & Beschuldigte" Icon="@Icons.Material.Outlined.Groups" Badge="@d.People.Count">
                <InvestigationPeoplePanel Detail="d" User="_user" Changed="ReloadAsync" Highlight="@_highlight" />
                <InvestigationEntryScroll Target="@ScrollFor(InvestigationTabs.People)" Done="@(() => _scrollPending = false)" />
            </RecordSection>
        }
        @if (a.CanRead(InvestigationTabs.Evidence))
        {
            <RecordSection Slug="@InvestigationTabs.Evidence" Label="Beweismittel" Icon="@Icons.Material.Outlined.Inventory2" Badge="@d.Evidence.Count">
                <InvestigationEvidencePanel Detail="d" User="_user" Changed="ReloadAsync" Highlight="@_highlight" />
                <InvestigationEntryScroll Target="@ScrollFor(InvestigationTabs.Evidence)" Done="@(() => _scrollPending = false)" />
            </RecordSection>
        }
        @if (a.CanRead(InvestigationTabs.Interrogations))
        {
            <RecordSection Slug="@InvestigationTabs.Interrogations" Label="Vernehmungen" Icon="@Icons.Material.Outlined.RecordVoiceOver" Badge="@d.Interrogations.Count">
                <InvestigationInterrogationsPanel Detail="d" User="_user" Changed="ReloadAsync" Highlight="@_highlight" HighlightRound="@_highlightRound" />
                <InvestigationEntryScroll Target="@ScrollFor(InvestigationTabs.Interrogations)" Done="@(() => _scrollPending = false)" />
            </RecordSection>
        }
        @if (a.CanRead(InvestigationTabs.Tasks))
        {
            <RecordSection Slug="@InvestigationTabs.Tasks" Label="To-Do" Icon="@Icons.Material.Outlined.Checklist" Badge="@d.Tasks.Count(t => !t.Done)">
                <InvestigationTasksPanel Detail="d" User="_user" Changed="ReloadAsync" Highlight="@_highlight" />
                <InvestigationEntryScroll Target="@ScrollFor(InvestigationTabs.Tasks)" Done="@(() => _scrollPending = false)" />
            </RecordSection>
        }
        @if (a.CanRead(InvestigationTabs.Notes))
        {
            <RecordSection Slug="@InvestigationTabs.Notes" Label="Notizen" Icon="@Icons.Material.Outlined.StickyNote2" Badge="@d.Notes.Count">
                <InvestigationNotesPanel Detail="d" User="_user" Changed="ReloadAsync" Highlight="@_highlight" />
                <InvestigationEntryScroll Target="@ScrollFor(InvestigationTabs.Notes)" Done="@(() => _scrollPending = false)" />
            </RecordSection>
        }
        @if (a.CanRead(InvestigationTabs.Warrants))
        {
            <RecordSection Slug="@InvestigationTabs.Warrants" Label="Anordnungen" Icon="@Icons.Material.Outlined.Policy">
                <InvestigationWarrantsPanel Detail="d" User="_user" />
            </RecordSection>
        }
        @* no rights tab of its own: whoever reads the cover sheet sees the links, each one filtered by its other end *@
        @if (a.CanRead(InvestigationTabs.Overview))
        {
            <RecordSection Slug="@InvestigationService.LinksSlug" Label="@InvestigationService.LinksSection" Icon="@Icons.Material.Filled.AccountTree">
                <InvestigationLinksPanel Detail="d" User="_user" />
            </RecordSection>
        }
        @if (a.CanRead(InvestigationTabs.Participants))
        {
            <RecordSection Slug="@InvestigationTabs.Participants" Label="Beteiligte & Zugriff" Icon="@Icons.Material.Outlined.AdminPanelSettings" Badge="@d.Participants.Count">
                <InvestigationAccessPanel Detail="d" User="_user" Changed="ReloadAsync" />
            </RecordSection>
        }
        @if (a.CanRead(InvestigationTabs.History))
        {
            <RecordSection Slug="@InvestigationTabs.History" Label="Verlauf" Icon="@Icons.Material.Outlined.History">
                <InvestigationHistoryPanel InvestigationId="@d.Id" User="_user" />
            </RecordSection>
        }
    </RecordSectionRail>
}

@code {
    [Parameter] public string Id { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private ClaimsPrincipal _user = default!;
    private bool _load = true;
    private string? _loadedId;
    private InvestigationDetail? _detail;

    // ?eintrag= of a reference: the row to highlight, kept only when the viewer's own detail holds it
    private string? _highlight;
    private string? _highlightTab;
    private bool _scrollPending;

    // bumped each time a reference is followed, so the same link opens a folded interrogation again
    private int _highlightRound;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }
        _loadedId = Id;
        _load = true;
        _user = (await AuthStateTask).User;
        _detail = await Investigations.GetAsync(Id, _user);
        ReadHighlight(scroll: true);
        _load = false;
    }

    // a reference into the same file changes only the query, which reaches no parameter of this page
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => _ = InvokeAsync(() =>
        {
            ReadHighlight(scroll: true);
            StateHasChanged();
        });

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    /// <summary>Reads the entry to highlight; an id that is hidden, deleted or made up does nothing and says nothing.</summary>
    private void ReadHighlight(bool scroll)
    {
        var wanted = QueryState.Read(Nav, "eintrag");
        _highlightTab = _detail is null ? null : InvestigationTexts.TabOf(_detail, wanted);
        _highlight = _highlightTab is null ? null : wanted;
        _scrollPending = scroll && _highlight is not null;
        if (_scrollPending)
        {
            _highlightRound++;
        }
    }

    // only the section holding the row scrolls: MudBlazor would scroll the page itself for a selector it cannot find
    private string? ScrollFor(string tab) => _scrollPending && tab == _highlightTab ? _highlight : null;

    private async Task ReloadAsync()
    {
        _detail = await Investigations.GetAsync(Id, _user);
        // an edit keeps the mark where it was, but does not jump back to it
        ReadHighlight(scroll: false);
        StateHasChanged();
    }

    private async Task DeleteAsync()
    {
        var ok = await DialogService.ShowMessageBoxAsync("Ermittlung löschen",
            $"{_detail!.CaseNumber} kommt in den Papierkorb; wiederherstellen kann die Führung.", yesText: "Löschen", cancelText: "Abbrechen");
        if (ok != true)
        {
            return;
        }
        try
        {
            await Investigations.DeleteAsync(Id, _user);
            Snackbar.Add("Ermittlung gelöscht.", Severity.Success);
            Nav.NavigateTo("/ermittlungen");
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or KeyNotFoundException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
