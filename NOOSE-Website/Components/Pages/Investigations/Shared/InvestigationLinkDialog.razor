@* Picks what to link: another record (quick search, partner-aware) or another investigation file. *@
@inject IInvestigationLinkService Links

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3" Style="min-width:380px;" Class="noose-min-breite-frei">
            @if (OfferRecords && OfferFiles)
            {
                <MudSelect T="bool" Label="Art" @bind-Value="_file" @bind-Value:after="Switched" Variant="Variant.Outlined" Dense="true"
                           Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Category">
                    <MudSelectItem Value="false">Akte</MudSelectItem>
                    <MudSelectItem Value="true">Ermittlung</MudSelectItem>
                </MudSelect>
            }

            @if (_file)
            {
                <MudAutocomplete T="InvestigationPick" Label="Ermittlung" @bind-Value="_pick" AutoFocus="true"
                                 SearchFunc="@SearchFiles" ToStringFunc="@(p => p?.Display ?? string.Empty)"
                                 Variant="Variant.Outlined" Clearable="true" CoerceText="false" CoerceValue="false"
                                 ResetValueOnEmptyText="true" MinCharacters="0" Immediate="true"
                                 HelperText="@(EditableOnly ? "Nur Ermittlungen, deren Deckblatt du bearbeiten darfst." : null)"
                                 Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Gavel">
                    <ItemTemplate Context="p">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Gavel" Size="Size.Small" Color="Color.Primary" />
                            <MudText Typo="Typo.body2">@p.CaseNumber</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@p.Title</MudText>
                        </MudStack>
                    </ItemTemplate>
                    <NoItemsTemplate>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary pa-2">
                            @(EditableOnly ? "Keine Ermittlung gefunden, deren Deckblatt du bearbeiten darfst." : "Keine Ermittlung gefunden.")
                        </MudText>
                    </NoItemsTemplate>
                </MudAutocomplete>
            }
            else
            {
                @* linked records are not offered; the error text covers a hit that slipped through anyway *@
                <QuickRecordPicker Allowed="RecordTypes" Exclude="Linked" Value="_record" ValueChanged="PickRecord" AutoFocus="true"
                                   Label="Akte" Placeholder="Name, Titel oder Aktenzeichen"
                                   HelperText="@(_alreadyLinked ? "Schon mit dieser Ermittlung verknüpft." : null)" />
            }

            <MudTextField @bind-Value="_label" Label="Bezeichnung (optional)" Variant="Variant.Outlined"
                          MaxLength="@InvestigationLinkService.LabelMaxLength" Placeholder="z. B. Hauptverdächtiger, Tatort, Vorermittlung" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@(Current is null)">Verknüpfen</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    /// <summary>Offer records of the other types (the file's own side).</summary>
    [Parameter] public bool OfferRecords { get; set; }

    /// <summary>Offer investigation files.</summary>
    [Parameter] public bool OfferFiles { get; set; } = true;

    /// <summary>Only files whose cover sheet the viewer may edit (the record's side).</summary>
    [Parameter] public bool EditableOnly { get; set; }

    /// <summary>The file the dialog was opened from, never offered.</summary>
    [Parameter] public string? ExcludeId { get; set; }

    /// <summary>Already linked records, never offered again.</summary>
    [Parameter] public IReadOnlySet<(string Type, string Id)> Linked { get; set; } = new HashSet<(string, string)>();

    // the file itself is picked through the file search, which knows the participants
    private static readonly IReadOnlySet<string> RecordTypes = InvestigationLinkService.RecordTypes
        .Where(t => t != nameof(Investigation)).ToHashSet(StringComparer.Ordinal);

    private ClaimsPrincipal _user = default!;
    private bool _file;
    private InvestigationPick? _pick;
    private QuickHit? _record;
    private string? _label;
    private bool _alreadyLinked;

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _file = !OfferRecords;
    }

    private void Switched()
    {
        _pick = null;
        _record = null;
        _alreadyLinked = false;
    }

    private void PickRecord(QuickHit? hit)
    {
        _alreadyLinked = hit is not null && Linked.Contains((hit.Category, hit.TargetId));
        _record = _alreadyLinked ? null : hit;
    }

    // the server leaves out the file itself and the linked ones before its cap, so they never take a slot
    private async Task<IEnumerable<InvestigationPick>> SearchFiles(string value, CancellationToken token)
        => await Links.FindInvestigationsAsync(value, _user, EditableOnly,
            Linked.Where(l => l.Type == nameof(Investigation)).Select(l => l.Id).Append(ExcludeId ?? string.Empty).ToList(), token);

    private (string Type, string Id)? Current => _file
        ? _pick is null ? null : (nameof(Investigation), _pick.Id)
        : _record is null ? null : (_record.Category, _record.TargetId);

    private void Save()
    {
        if (Current is not { } c)
        {
            return;
        }
        MudDialog.Close(DialogResult.Ok(new Choice(c.Type, c.Id, _label)));
    }

    private void Cancel() => MudDialog.Cancel();

    /// <summary>What was picked.</summary>
    public sealed record Choice(string Type, string Id, string? Label);

    /// <summary>Shows the dialog; null on cancel.</summary>
    public static async Task<Choice?> ShowAsync(IDialogService dialog, string title, bool offerRecords, bool offerFiles,
        bool editableOnly, string? excludeId, IReadOnlySet<(string Type, string Id)> linked)
    {
        var parameters = new DialogParameters<InvestigationLinkDialog>
        {
            { x => x.OfferRecords, offerRecords },
            { x => x.OfferFiles, offerFiles },
            { x => x.EditableOnly, editableOnly },
            { x => x.ExcludeId, excludeId },
            { x => x.Linked, linked },
        };
        var reference = await dialog.ShowAsync<InvestigationLinkDialog>(title, parameters);
        var result = await reference.Result;
        return result is { Canceled: false, Data: Choice c } ? c : null;
    }
}
