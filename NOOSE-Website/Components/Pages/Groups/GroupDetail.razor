@page "/personengruppen/{Id}"
@inject IPersonGroupService GroupService
@inject IAccessLogService AccessLog
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IPartnerVisibilityPolicyService PartnerPolicy

<PageTitle>@(_group?.Name ?? "Personengruppe") · NOOSE</PageTitle>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_group is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        Personengruppe nicht gefunden oder nicht zugänglich (ggf. Verschlusssache).
    </MudAlert>
}
else
{
    @if (_group.IsArchived)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <div>
                    <MudText Typo="Typo.body2">
                        Archiviert am @(_group.ArchivedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—") —
                        erscheint nicht in Listen, Auswahllisten und der Standardsuche.
                    </MudText>
                    @if (!string.IsNullOrWhiteSpace(_group.ArchiveReason))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Grund: @_group.ArchiveReason</MudText>
                    }
                </div>
                <MudSpacer />
                <AuthorizeView Policy="@Policies.WriteAccess" Context="archiv">
                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Unarchive"
                               OnClick="UnarchiveAsync">Zurückholen</MudButton>
                </AuthorizeView>
            </MudStack>
        </MudAlert>
    }

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/personengruppen" aria-label="Zurück" />
        <CompromisedBadge EntityType="@nameof(PersonGroup)" EntityId="@_group.Id" />
        <MudSpacer />
        <MudTooltip Text="Druckansicht – Akte drucken / als PDF speichern">
            <MudIconButton Icon="@Icons.Material.Filled.Print" Color="Color.Default"
                           Href="@($"/personengruppen/{Id}/druck")" Target="_blank"
                           aria-label="Druckansicht öffnen" />
        </MudTooltip>
        <DossierExportButton EntityType="@nameof(PersonGroup)" EntityId="@Id" />
        @if (!_isPartner)
        {
            <FollowButton EntityType="@nameof(PersonGroup)" EntityId="@_group.Id" User="_user" />
            <JobCreateButton EntityType="@nameof(PersonGroup)" EntityId="@_group.Id" />
        }
        <AuthorizeView Policy="@Policies.WriteAccess" Context="freigabe">
            <PartnerShareButton EntityType="@nameof(PersonGroup)" EntityId="@_group.Id" />
        </AuthorizeView>
        <AuthorizeView Policy="@Policies.WriteAccess" Context="schreib">
            <MudButton Href="@($"/personengruppen/{_group.Id}/bearbeiten")" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">Bearbeiten</MudButton>
        </AuthorizeView>
        <AuthorizeView Policy="@Policies.WriteAccess" Context="ablegen">
            @if (!_group.IsArchived)
            {
                <MudButton Color="Color.Default" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Archive"
                           OnClick="ArchiveAsync">Archivieren</MudButton>
            }
        </AuthorizeView>
        <AuthorizeView Policy="@Policies.Leadership">
            <MudButton Color="Color.Error" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync">Löschen</MudButton>
        </AuthorizeView>
    </MudStack>

    @if (!_isPartner)
    {
        <MudPaper Class="pa-2 mb-4" Elevation="1">
            <TagChips EntityType="@nameof(PersonGroup)" EntityId="@_group.Id" User="_user" />
        </MudPaper>
    }

    <MudGrid>
        <MudItem xs="12" md="4" lg="3">
            <div class="akte-steckkarte">
                <GroupCard Group="_group" Progress="_progress" InvestigationLead="_investigationLead"
                           TitleImagePhotoId="@RecordAvatar.ProfileId(_group.Photos)"
                           User="_user" Changed="NewLoadAsync" />
            </div>
        </MudItem>

        <MudItem xs="12" md="8" lg="9">
            @if (_renderTabs.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    Für Ihren Zugang sind in dieser Akte keine Bereiche freigegeben.
                </MudAlert>
            }
            else
            {
            @if (TabOn("historie"))
            {
                <SinceLastVisitBar EntityType="@nameof(PersonGroup)" EntityId="@_group.Id" User="_user" Since="_since" />
            }
            <RecordSectionRail>
                @if (TabOn("stammdaten"))
                {
                <RecordSection Group="Akte" Slug="stammdaten" Label="Stammdaten" Icon="@Icons.Material.Filled.Info">
                    <MudStack Spacing="3">
                        @if (!string.IsNullOrWhiteSpace(_group.Targets))
                        {
                            <div>
                                <MudText Typo="Typo.subtitle2">Ziele</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary"><MentionDisplay Text="@_group.Targets" /></MudText>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_group.Description))
                        {
                            <div>
                                <MudText Typo="Typo.subtitle2">Beschreibung</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary"><MentionDisplay Text="@_group.Description" /></MudText>
                            </div>
                        }
                        @if (string.IsNullOrWhiteSpace(_group.Targets) && string.IsNullOrWhiteSpace(_group.Description))
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Keine weiteren Stammdaten erfasst.</MudText>
                        }
                    </MudStack>
                </RecordSection>
                }
                @if (TabOn("mitglieder"))
                {
                <RecordSection Group="Struktur" Slug="mitglieder" Label="Mitglieder" Icon="@Icons.Material.Filled.Group">
                    <GroupMembersPanel GroupId="@_group.Id" User="_user" Changed="ProgressRefreshAsync" />
                </RecordSection>
                }
                @* assigned NOOSE agents: internal only *@
                @if (!_isPartner)
                {
                <RecordSection Group="Struktur" Slug="agents" Label="Zugeteilte Agents" Icon="@Icons.Material.Filled.ManageAccounts">
                    <AgentsPanel GroupId="@_group.Id" User="_user" Changed="InvestigationLeadRefreshAsync" />
                </RecordSection>
                }
                @if (TabOn("einstufung"))
                {
                <RecordSection Group="Akte" Slug="einstufung" Label="Einstufung" Icon="@Icons.Material.Filled.Shield">
                    <ClassificationPanel Current="_group.Classification" History="_classificationHistory" User="_user" OnSet="ClassificationSetAsync"
                                     EntityType="@nameof(PersonGroup)" EntityId="@_group.Id" TargetDesignation="@($"{_group.Name} ({_group.CaseNumber})")" />
                </RecordSection>
                }
                @if (TabOn("doks"))
                {
                <RecordSection Group="Ermittlung" Slug="doks" Label="Doks" Icon="@Icons.Material.Filled.Description">
                    <OrgDocsPanel OrgType="@nameof(PersonGroup)" OrgId="@_group.Id" User="_user" />
                </RecordSection>
                }
                @if (!_isPartner)
                {
                <RecordSection Group="Ermittlung" Slug="entfuehrungen" Label="Verübte Entführungen" Icon="@Icons.Material.Filled.PersonOff">
                    <AbductionsPanel PerpetratorType="@nameof(PersonGroup)" PerpetratorId="@_group.Id" />
                </RecordSection>
                }
                @if (TabOn("aktivitaeten"))
                {
                <RecordSection Group="Ermittlung" Slug="aktivitaeten" Label="Aktivitäten" Icon="@Icons.Material.Filled.Bolt">
                    <AgentActivityLinkedPanel EntityType="@nameof(PersonGroup)" EntityId="@_group.Id" User="_user" />
                </RecordSection>
                }
                @if (TabOn("fotos"))
                {
                <RecordSection Group="Anhänge" Slug="fotos" Label="Fotos" Icon="@Icons.Material.Filled.PhotoLibrary">
                    <GroupPhotoGallery GroupId="@_group.Id" User="_user" Changed="NewLoadAsync" />
                </RecordSection>
                }
                @* partner-safe child services *@
                @if (TabOn("beziehungen"))
                {
                <RecordSection Group="Struktur" Slug="beziehungen" Label="Beziehungen" Icon="@Icons.Material.Filled.Hub">
                    <OrgRelationsPanel EntityType="@nameof(PersonGroup)" EntityId="@_group.Id" User="_user" />
                </RecordSection>
                }
                @if (TabOn("quellen"))
                {
                <RecordSection Group="Anhänge" Slug="quellen" Label="Quellen" Icon="@Icons.Material.Filled.AttachFile">
                    <SourcesPanel EntityType="@nameof(PersonGroup)" EntityId="@_group.Id" User="_user" />
                </RecordSection>
                }
                @if (TabOn("wiedervorlagen"))
                {
                <RecordSection Group="Verlauf" Slug="wiedervorlagen" Label="Wiedervorlagen" Icon="@Icons.Material.Filled.EventRepeat">
                    <FollowupPanel EntityType="@nameof(PersonGroup)" EntityId="@_group.Id" User="_user" />
                </RecordSection>
                }
                @if (TabOn("kommentare"))
                {
                <RecordSection Group="Verlauf" Slug="kommentare" Label="Kommentare" Icon="@Icons.Material.Filled.Comment">
                    <CommentPanel EntityType="@nameof(PersonGroup)" EntityId="@_group.Id" User="_user" />
                </RecordSection>
                }
                @if (TabOn("zusatzfelder"))
                {
                <RecordSection Group="Akte" Slug="zusatzfelder" Label="Zusatzfelder" Icon="@Icons.Material.Filled.Tune">
                    <CustomFieldsPanel EntityType="@nameof(PersonGroup)" EntityId="@_group.Id" User="_user" />
                </RecordSection>
                }
                @* partner-safe: timeline filters cross-refs for partners *@
                @if (TabOn("historie"))
                {
                <RecordSection Group="Verlauf" Slug="historie" Label="Zeitstrahl" Icon="@Icons.Material.Filled.Timeline">
                    <TimelinePanel EntityType="@nameof(PersonGroup)" EntityId="@_group.Id" User="_user" NewSince="_since" @key="_historyKey" />
                </RecordSection>
                }
                @* AI short brief: internal only *@
                @if (!_isPartner)
                {
                <RecordSection Group="Analyse" Slug="ki-kurzbrief" Label="NOOSEI-Kurzbrief" Icon="@Icons.Material.Filled.AutoAwesome">
                    <KiBriefPanel EntityType="@nameof(PersonGroup)" EntityId="@_group.Id" User="_user" />
                </RecordSection>
                }
            </RecordSectionRail>
            }
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public string Id { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;
    private bool _isPartner;
    private PersonGroup? _group;
    private PersonGroupProgress _progress = new(0, null);
    private List<string> _investigationLead = new();
    private List<ClassificationHistory> _classificationHistory = new();
    private ClaimsPrincipal _user = default!;
    private Guid _historyKey = Guid.NewGuid();
    private string? _loadedId;
    // last view of the previous visit, read before this one is logged
    private DateTime? _since;

    // every section slug on this page; the rail persists the active one in the URL
    private static readonly string[] _tabs =
    {
        "stammdaten", "mitglieder", "agents", "einstufung", "doks", "aktivitaeten", "fotos",
        "beziehungen", "quellen", "wiedervorlagen", "kommentare", "zusatzfelder", "historie",
    };

    // partner tab gating: null = no restriction (internal/unconfigured/individually released)
    private IReadOnlySet<string>? _visibleTabs;
    private List<string> _renderTabs = new();
    private bool TabOn(string slug) => _visibleTabs is null || _visibleTabs.Contains(slug);
    private void RebuildRenderTabs() => _renderTabs = _tabs.Where(s => (s != "agents" || !_isPartner) && TabOn(s)).ToList();

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _isPartner = _user.IsPartner();
    }

    // Component is reused across ids; react to id changes here since OnInitialized won't rerun
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }
        _loadedId = Id;
        _load = true;
        _group = null;
        _since = null;
        await LoadAsync();
        if (_group is not null)
        {
            _since = await AccessLog.PreviousVisitAsync(nameof(PersonGroup), _group.Id);
            await AccessLog.LogViewAsync(nameof(PersonGroup), _group.Id);
        }
    }

    private async Task LoadAsync()
    {
        // Don't set _load on reload: it would remount the rail and jump to the first section
        var scope = ViewerScope.From(_user);
        _group = await GroupService.GetDetailAsync(Id, scope);
        if (_group is not null)
        {
            _classificationHistory = await GroupService.GetClassificationHistoryAsync(_group.Id, scope);
            // partners: skip progress/agent fan-out
            if (!_isPartner)
            {
                _progress = await GroupService.GetProgressAsync(_group.Id);
                await InvestigationLeadLoadAsync();
            }
        }
        _visibleTabs = _isPartner && _group is not null
            ? await PartnerPolicy.GetVisibleTabsAsync(_user, nameof(PersonGroup), _group.Id)
            : null;
        RebuildRenderTabs();
        _load = false;
    }

    private async Task InvestigationLeadLoadAsync()
    {
        if (_group is null)
        {
            return;
        }
        var el = await GroupService.GetInvestigationLeadAsync(_group.Id);
        _investigationLead = el.Select(a => a.Agent?.Codename ?? "?").ToList();
    }

    private async Task InvestigationLeadRefreshAsync()
    {
        await InvestigationLeadLoadAsync();
        StateHasChanged();
    }

    private async Task NewLoadAsync()
    {
        await LoadAsync();
        _historyKey = Guid.NewGuid();
        StateHasChanged();
    }

    private async Task ProgressRefreshAsync()
    {
        if (_group is not null)
        {
            _progress = await GroupService.GetProgressAsync(_group.Id);
            StateHasChanged();
        }
    }

    private async Task ClassificationSetAsync((Classification New, string? Justification) input)
    {
        if (_group is null)
        {
            return;
        }
        await GroupService.ClassificationSetAsync(_group.Id, input.New, input.Justification, _user);
        await NewLoadAsync();
    }

    private async Task ArchiveAsync()
    {
        if (_group is null)
        {
            return;
        }
        var reason = await ReasonDialog.ShowAsync(DialogService, "Personengruppe archivieren?",
            "Diese Personengruppe verschwindet aus Listen, Auswahllisten und der Standardsuche. Verknüpfungen, "
            + "Erwähnungen und der Graph bleiben unverändert; zurückholen kann sie jeder mit Schreibrecht.",
            confirmText: "Archivieren", label: "Grund (optional)");
        if (reason is null)
        {
            return;
        }
        await GroupService.ArchiveAsync(_group.Id, reason, _user);
        Snackbar.Add("Personengruppe archiviert.", Severity.Success);
        await NewLoadAsync();
    }

    private async Task UnarchiveAsync()
    {
        if (_group is null)
        {
            return;
        }
        await GroupService.UnarchiveAsync(_group.Id, _user);
        Snackbar.Add("Wieder im aktiven Bestand.", Severity.Success);
        await NewLoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (_group is null)
        {
            return;
        }
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Personengruppe löschen?",
            "Die Gruppe wird in den Papierkorb verschoben und kann von der Führung wiederhergestellt werden.");
        if (!ok)
        {
            return;
        }
        await GroupService.DeleteAsync(_group.Id, _user);
        Snackbar.Add("Personengruppe in den Papierkorb verschoben.", Severity.Success);
        Nav.NavigateTo("/personengruppen");
    }
}
