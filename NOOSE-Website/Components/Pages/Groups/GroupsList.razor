@page "/personengruppen"
@using NOOSE_Website.Models.Navigation
@inject IPersonGroupService GroupService
@inject IRecencyService Recency
@inject NavigationManager Nav

<PageTitle>Personengruppen · FIB</PageTitle>

@* no help button: the list never had one, and from 960px up the header keeps its old buttons *@
<PageHeader Icon="@Icons.Material.Filled.Diversity3" Title="Personengruppen" ShowHelp="false"
            Subtitle="Lose Zusammenschlüsse von Personen mit Einstufung, zugeteilten Agents und Erfassungsfortschritt.">
    <MoreActions>
        <ListExportButton T="GroupRow" RecordType="@nameof(PersonGroup)" Items="@(() => _grid?.FilteredItems ?? [])" Columns="ExportColumns" Disabled="_load" />
        <AuthorizeView Policy="@Policies.Leadership">
            <MudButton Href="/papierkorb?tab=personengruppen" Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.Delete">Papierkorb</MudButton>
        </AuthorizeView>
    </MoreActions>
    <MoreActionsMenu>
        <ListExportButton AsMenuItem="true" T="GroupRow" RecordType="@nameof(PersonGroup)" Items="@(() => _grid?.FilteredItems ?? [])" Columns="ExportColumns" Disabled="_load" />
        <AuthorizeView Policy="@Policies.Leadership">
            <MudMenuItem Icon="@Icons.Material.Filled.Delete" Href="/papierkorb?tab=personengruppen">Papierkorb</MudMenuItem>
        </AuthorizeView>
    </MoreActionsMenu>
    <Actions>
        <AuthorizeView Policy="@Policies.WriteAccess" Context="schreib">
            <MudButton Href="/personengruppen/neu" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">Neue Gruppe</MudButton>
        </AuthorizeView>
    </Actions>
</PageHeader>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudDataGrid @ref="_grid" T="GroupRow" Items="_rows" Hover="true" Filterable="false" SortMode="SortMode.Multiple"
                 QuickFilter="Filter" Elevation="2" RowClick="@(args => Open(args.Item))" Dense="true"
                 Breakpoint="Breakpoint.None" Class="noose-filterleiste">
        <ToolBarContent>
            <MudTextField @bind-Value="_search" Placeholder="Suchen (Name, Aktenzeichen)…" Immediate="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0 noose-filter-feld" />
            <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.FilterList" Class="noose-nur-handy"
                       OnClick="@(() => _filtersOpen = !_filtersOpen)" aria-expanded="@(_filtersOpen ? "true" : "false")">Filter (@ActiveFilterCount)</MudButton>
            <MudSpacer />
            @* d-contents: the filters stay items of the toolbar row; on phones they fold behind the button above *@
            <div class="@(_filtersOpen ? "d-contents" : "d-contents noose-filter-zu")">
                <MudSelect T="GroupsKind?" @bind-Value="_kindFilter" Clearable="true" Dense="true" Margin="Margin.Dense"
                           Label="Kategorie" Variant="Variant.Outlined" Class="mt-0 noose-filter-feld" Style="max-width:240px;">
                    @foreach (var a in GroupsKindDisplay.All)
                    {
                        <MudSelectItem T="GroupsKind?" Value="@((GroupsKind?)a)">@GroupsKindDisplay.Name(a)</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="ArchiveFilter" Value="_archive" ValueChanged="ArchiveSelectedAsync" Label="Archiv" Dense="true"
                           Variant="Variant.Outlined" Style="max-width:170px;" Margin="Margin.Dense" Class="ml-sm-2 noose-filter-feld">
                    <MudSelectItem T="ArchiveFilter" Value="ArchiveFilter.Active">Aktiv</MudSelectItem>
                    <MudSelectItem T="ArchiveFilter" Value="ArchiveFilter.Including">Mit Archiv</MudSelectItem>
                    <MudSelectItem T="ArchiveFilter" Value="ArchiveFilter.Only">Nur Archiv</MudSelectItem>
                </MudSelect>
            </div>
            <MobileColumnPicker ListKey="personengruppen" Columns="PhoneColumns" Defaults="PhoneDefaults"
                                VisibleChanged="@(v => _phoneColumns = v)" />
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.CaseNumber" Title="Aktenzeichen" HeaderClass="@Col("aktenzeichen")" CellClass="@Col("aktenzeichen")" />
            <TemplateColumn Sortable="true" Title="Name" HeaderClass="@Col("name")" CellClass="@Col("name")" SortBy="x => x.Name">
                <CellTemplate>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        @if (!string.IsNullOrEmpty(context.Item.TitleImagePhotoId))
                        {
                            <MudImage Src="@RecordAvatar.Url(nameof(PersonGroup), context.Item.TitleImagePhotoId)" Alt="Titelbild"
                                      Height="28" Width="28" ObjectFit="ObjectFit.Cover" Class="rounded" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Diversity3" Color="Color.Default" Size="Size.Small" />
                        }
                        @* Real link so middle/ctrl-click opens in new tab and stays keyboard-reachable *@
                        <MudLink Href="@($"/personengruppen/{context.Item.Id}")" @onclick:stopPropagation="true">@context.Item.Name</MudLink>
                        @if (context.Item.IsArchived)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Class="ml-2">Archiviert</MudChip>
                        }
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="true" Title="Kategorie" HeaderClass="@Col("kategorie")" CellClass="@Col("kategorie")" SortBy="x => x.Kind">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">@GroupsKindDisplay.Name(context.Item.Kind)</MudChip>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.MemberCount" Title="Mitglieder" HeaderClass="@Col("mitglieder")" CellClass="@Col("mitglieder")" />
            <TemplateColumn Sortable="true" Title="Einstufung" HeaderClass="@Col("einstufung")" CellClass="@Col("einstufung")" SortBy="x => x.Classification">
                <CellTemplate>
                    <ClassificationBadge Value="context.Item.Classification" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="true" Title="Verschluss" HeaderClass="@Col("verschluss")" CellClass="@Col("verschluss")" SortBy="x => x.IsClassified">
                <CellTemplate>
                    @if (context.Item.IsClassified)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Lock">@DocumentClassificationDisplay.ChipLabel(context.Item.SecrecyLevel)</MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="true" Title="Aktualität" HeaderClass="@Col("aktualitaet")" CellClass="@Col("aktualitaet")" SortBy="x => x.Level">
                <CellTemplate>
                    <RecencyIndicator Level="context.Item.Level" ReferenceDateUtc="context.Item.RefreshedUtc" />
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Refreshed" Title="Zuletzt" HeaderClass="@Col("zuletzt")" CellClass="@Col("zuletzt")" Format="dd.MM.yyyy HH:mm" />
        </Columns>
        <NoRecordsContent>
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-6">
                <MudIcon Icon="@Icons.Material.Filled.Diversity3" Color="Color.Default" Size="Size.Large" />
                <AuthorizeView Policy="@Policies.PartnerView" Context="partnerEmpty">
                    <Authorized>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Für Ihre Behörde wurde noch keine Personengruppe freigegeben.</MudText>
                    </Authorized>
                    <NotAuthorized>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Noch keine Personengruppen – lege die erste an.</MudText>
                    </NotAuthorized>
                </AuthorizeView>
                <AuthorizeView Policy="@Policies.WriteAccess" Context="schreib">
                    <MudButton Href="/personengruppen/neu" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">Neue Gruppe</MudButton>
                </AuthorizeView>
            </MudStack>
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="GroupRow" />
        </PagerContent>
    </MudDataGrid>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private MudDataGrid<GroupRow>? _grid;

    /// <summary>The CSV export's columns: the grid's own, minus the image.</summary>
    private static readonly IReadOnlyList<ExportColumn<GroupRow>> ExportColumns =
    [
        new("Aktenzeichen", r => r.CaseNumber),
        new("Name", r => r.Name),
        new("Archiviert", r => ExportText.Flag(r.IsArchived)),
        new("Kategorie", r => GroupsKindDisplay.Name(r.Kind)),
        new("Mitglieder", r => r.MemberCount.ToString()),
        new("Einstufung", r => ClassificationDisplay.Name(r.Classification)),
        new("Verschluss", r => ExportText.Secrecy(r.IsClassified, r.SecrecyLevel)),
        new("Aktualität", r => RecencyLevelDisplay.Name(r.Level)),
        new("Zuletzt", r => ExportText.Stamp(r.Refreshed)),
    ];

    /// <summary>The grid's columns for the phone column picker, in table order; keys in lower case without umlauts.</summary>
    private static readonly IReadOnlyList<(string Key, string Label)> PhoneColumns =
    [
        ("aktenzeichen", "Aktenzeichen"), ("name", "Name"), ("kategorie", "Kategorie"), ("mitglieder", "Mitglieder"),
        ("einstufung", "Einstufung"), ("verschluss", "Verschluss"), ("aktualitaet", "Aktualität"), ("zuletzt", "Zuletzt"),
    ];

    /// <summary>What a phone shows until the agent chooses: the name and the classification, the record's weight.</summary>
    private static readonly IReadOnlyList<string> PhoneDefaults = ["name", "einstufung"];

    // the defaults until the picker reports the stored choice, so even the first paint is narrow on a phone
    private IReadOnlySet<string> _phoneColumns = MobileColumnSet.Resolve(PhoneColumns.Select(c => c.Key).ToList(), PhoneDefaults, null);

    // below 600px only; from 600px up every column shows, as before
    private string Col(string key) => MobileColumnSet.ClassFor(_phoneColumns, key);

    // the filters behind "Filter (n)" on phones; from 600px up they always stand in the toolbar
    private bool _filtersOpen;

    private int ActiveFilterCount => (_kindFilter is null ? 0 : 1) + (_archive == ArchiveFilter.Active ? 0 : 1);

    private bool _load = true;
    private ArchiveFilter _archive = ArchiveFilter.Active;
    private string _search = string.Empty;
    private GroupsKind? _kindFilter;
    private List<GroupRow> _rows = new();

    protected override Task OnInitializedAsync() => LoadAsync();

    // the archive filter is server-side, so switching it reloads rather than filtering in place
    private async Task LoadAsync()
    {
        var user = (await AuthStateTask).User;
        var isPartner = user.IsPartner();
        var mayClassifiedRead = user.MayClassifiedRead();
        var groups = await GroupService.GetListAsync(ViewerScope.From(user), _archive);
        var settings = await Recency.GetSettingsAsync(nameof(PersonGroup));
        var now = DateTime.UtcNow;
        _rows = groups.Select(g =>
        {
            var referenceUtc = g.ModifiedAt ?? g.CreatedAt;
            return new GroupRow
            {
                Id = g.Id,
                CaseNumber = g.CaseNumber,
                Name = g.Name,
                // Count only members with a visible (non-deleted, classification-permitted) file; partners hidden
                MemberCount = isPartner ? 0 : g.Members.Count(m => m.Person is not null && (mayClassifiedRead || !m.Person.IsClassified)),
                Kind = g.Kind,
                TitleImagePhotoId = RecordAvatar.ProfileId(g.Photos),
                Classification = g.Classification,
                IsClassified = g.IsClassified,
                SecrecyLevel = g.SecrecyLevel,
                RefreshedUtc = referenceUtc,
                Refreshed = referenceUtc.ToLocalTime(),
                IsArchived = g.IsArchived,
                Level = RecencyAssessment.For(settings.AgingDisabled, g.AgingDisabled, g.IsArchived,
                    settings.WarningDays, settings.StaleDays, referenceUtc, now),
            };
        }).ToList();
        _load = false;
    }

    private bool Filter(GroupRow z)
    {
        if (_kindFilter is not null && z.Kind != _kindFilter)
        {
            return false;
        }
        if (string.IsNullOrWhiteSpace(_search))
        {
            return true;
        }
        var s = _search.Trim();
        return z.Name.Contains(s, StringComparison.OrdinalIgnoreCase)
            || z.CaseNumber.Contains(s, StringComparison.OrdinalIgnoreCase);
    }

    private void Open(GroupRow z) => Nav.NavigateTo($"/personengruppen/{z.Id}");

    private async Task ArchiveSelectedAsync(ArchiveFilter value)
    {
        _archive = value;
        _load = true;
        await LoadAsync();
    }

    private sealed class GroupRow
    {
        public string Id { get; set; } = string.Empty;
        public string CaseNumber { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public int MemberCount { get; set; }
        public GroupsKind Kind { get; set; }
        public string? TitleImagePhotoId { get; set; }
        public Classification Classification { get; set; }
        public bool IsClassified { get; set; }
        public DocumentClassification SecrecyLevel { get; set; }
        public DateTime RefreshedUtc { get; set; }
        public DateTime Refreshed { get; set; }
        public RecencyLevel Level { get; set; }
        public bool IsArchived { get; set; }
    }
}
