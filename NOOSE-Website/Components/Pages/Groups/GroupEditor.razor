@page "/personengruppen/neu"
@page "/personengruppen/{Id}/bearbeiten"
@inject IPersonGroupService GroupService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(IsEdit ? "Personengruppe bearbeiten" : "Neue Personengruppe") · NOOSE</PageTitle>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_input is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        Personengruppe nicht gefunden oder nicht zugänglich.
    </MudAlert>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="@BackHref" aria-label="Zurück" />
        <MudIcon Icon="@(IsEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.Diversity3)" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h4">@(IsEdit ? "Personengruppe bearbeiten" : "Neue Personengruppe anlegen")</MudText>
    </MudStack>

    <MudForm @ref="_form">
        <GroupForm DraftScope="@DraftScope" @key="_loadedId" Input="_input" ShowClassification="@(!IsEdit)" MayHighest="_mayHighest"
                   ShowMembers="@(!IsEdit)" IsLeadership="_isLeadership" SecrecyOptions="_secrecyOptions" />
    </MudForm>
    @if (IsEdit)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
            Hinweis: Die Einstufung wird in der Akte unter „Einstufung" geändert (mit Verlauf und Rang-Prüfung).
        </MudText>
    }

    <MudStack Row="true" Spacing="2" Class="mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAsync" Disabled="_saves">@(IsEdit ? "Speichern" : "Anlegen")</MudButton>
        <MudButton Variant="Variant.Text" Href="@BackHref">Abbrechen</MudButton>
    </MudStack>
}

@code {
    [Parameter] public string? Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    // RouteView only supplies the matched template's route values, so a stale Id survives bearbeiten -> neu
    private bool IsEdit { get; set; }
    private string BackHref => IsEdit ? $"/personengruppen/{Id}" : "/personengruppen";

    private MudForm _form = default!;
    private PersonGroupInput? _input;
    private ClaimsPrincipal _user = default!;

    // one scope for every text field of the form; dropped once the save went through
    private string DraftScope => IsEdit ? $"personengruppe:{Id}" : "personengruppe:neu";
    private bool _mayHighest;
    private bool _isLeadership;
    private bool _load = true;
    private bool _saves;
    private string? _loadedId;
    // level as loaded; loosening it asks for a reason
    private DocumentClassification _loadedSecrecy;
    private IReadOnlyList<DocumentClassification> _secrecyOptions = Array.Empty<DocumentClassification>();

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _mayHighest = _user.MayHighestClassification();
        _isLeadership = _user.IsLeadership();
        _secrecyOptions = DocumentViewerScope.AssignableOptions(_user);
    }

    // both routes bind the same component, so Blazor reuses the instance across neu ↔ bearbeiten
    protected override async Task OnParametersSetAsync()
    {
        IsEdit = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0]
            .EndsWith("/bearbeiten", StringComparison.OrdinalIgnoreCase);
        var key = IsEdit ? Id ?? string.Empty : string.Empty;
        if (_loadedId == key)
        {
            return;
        }
        _loadedId = key;
        _load = true;
        _input = null;

        if (!IsEdit)
        {
            _input = new PersonGroupInput();
            _load = false;
            return;
        }

        var g = await GroupService.GetDetailAsync(Id!, ViewerScope.From(_user));
        if (g is not null)
        {
            _input = new PersonGroupInput
            {
                Name = g.Name,
                Description = g.Description,
                Targets = g.Targets,
                Kind = g.Kind,
                Classification = g.Classification,
                EstimatedMemberCount = g.EstimatedMemberCount,
                SecrecyLevel = g.SecrecyLevel,
            };
        }
        _loadedSecrecy = _input?.SecrecyLevel ?? DocumentClassification.None;
        _load = false;
    }

    private async Task SaveAsync()
    {
        if (_input is null)
        {
            return;
        }
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        if (IsEdit)
        {
            var secrecyReason = await CriticalReasonPrompt.SecrecyAsync(DialogService, _loadedSecrecy, _input.SecrecyLevel);
            if (secrecyReason is null)
            {
                return;
            }
            _input.SecrecyReason = secrecyReason;
        }

        _saves = true;
        try
        {
            if (IsEdit)
            {
                await GroupService.RefreshAsync(Id!, _input, _user);
                await TextDraft.DiscardScopeAsync(JS, _user.GetAgentId(), DraftScope);
                Snackbar.Add("Änderungen gespeichert.", Severity.Success);
                Nav.NavigateTo($"/personengruppen/{Id}");
            }
            else
            {
                var group = await GroupService.CreateAsync(_input, _user);
                await TextDraft.DiscardScopeAsync(JS, _user.GetAgentId(), DraftScope);
                Snackbar.Add($"Personengruppe {group.CaseNumber} angelegt.", Severity.Success);
                Nav.NavigateTo($"/personengruppen/{group.Id}");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _saves = false;
        }
    }
}
