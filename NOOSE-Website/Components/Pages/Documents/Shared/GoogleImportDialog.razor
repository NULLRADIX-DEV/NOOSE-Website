@using Microsoft.Extensions.Options
@using NOOSE_Website.Services.Import
@inject IGoogleImportService GoogleImport
@inject IOptions<GoogleDriveOptions> DriveOptions
@inject ISnackbar Snackbar
@inject ILogger<GoogleImportDialog> Logger

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTabs Elevation="0" @bind-ActivePanelIndex="_sourceTab" Class="mb-1">
                <MudTabPanel Text="Freigabe-Link" Icon="@Icons.Material.Filled.Link">
                    <MudTextField @bind-Value="_link" Label="Link zum Google-Dokument" Variant="Variant.Outlined" Immediate="true"
                                  Placeholder="https://docs.google.com/document/d/…/edit"
                                  HelperText="In Google: Teilen → Allgemeiner Zugriff → „Jeder mit dem Link“ (Betrachter)." />
                </MudTabPanel>
                @if (DriveOptions.Value.IsConfigured)
                {
                    <MudTabPanel Text="Google-Anmeldung" Icon="@Icons.Custom.Brands.Google">
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Melde dich bei Google an und wähle das Dokument. Geht auch mit Dokumenten, die nicht freigegeben
                            sind; NOOSE darf nur die Datei lesen, die du wählst
                            (<MudLink Href="/datenschutz#google" Target="_blank" rel="noopener noreferrer">Datenschutz</MudLink>).
                        </MudText>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <GoogleDrivePicker Kind="GoogleFileKind.Document" Disabled="_busy" OnPicked="Picked" />
                            @if (_drive is not null)
                            {
                                <MudText Typo="Typo.body2">Gewählt: <b>@_drive.Name</b></MudText>
                            }
                        </MudStack>
                    </MudTabPanel>
                }
                <MudTabPanel Text="Datei hochladen" Icon="@Icons.Material.Filled.Upload">
                    <MudText Typo="Typo.body2" Class="mb-2">
                        In Google: <i>Datei → Herunterladen → Webseite (.html, gezippt)</i>. Geht auch mit Dokumenten,
                        die nicht freigegeben sind.
                    </MudText>
                    <MudFileUpload T="IBrowserFile" Accept=".zip" FilesChanged="PickAsync">
                        <CustomContent>
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FolderZip"
                                       OnClick="@context.OpenFilePickerAsync">
                                @(_fileName ?? "Zip-Datei wählen")
                            </MudButton>
                        </CustomContent>
                    </MudFileUpload>
                </MudTabPanel>
            </MudTabs>

            <MudRadioGroup T="GoogleImportMode" @bind-Value="_mode">
                <MudRadio T="GoogleImportMode" Value="GoogleImportMode.Original" Color="Color.Primary">
                    <b>Original 1:1</b> - sieht aus wie in Google, Text nur lesen, später aktualisierbar
                </MudRadio>
                <MudRadio T="GoogleImportMode" Value="GoogleImportMode.Editable" Color="Color.Primary">
                    <b>Bearbeitbare Kopie</b> - im Editor änderbar, Schriften und Abstände gehen verloren
                </MudRadio>
            </MudRadioGroup>

            <MudTextField @bind-Value="_title" Label="Titel (leer = Titel aus Google)" Variant="Variant.Outlined" MaxLength="300" />
            <MudTextField @bind-Value="_category" Label="Kategorie (optional)" Variant="Variant.Outlined" MaxLength="120" />
            @if (_classificationOptions.Count > 1)
            {
                <MudSelect T="DocumentClassification" @bind-Value="_classification" Label="Verschluss-Stufe"
                           Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock">
                    @foreach (var option in _classificationOptions)
                    {
                        <MudSelectItem T="DocumentClassification" Value="@option">@DocumentClassificationDisplay.Label(option)</MudSelectItem>
                    }
                </MudSelect>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ImportAsync" Disabled="@(_busy || !Ready)"
                   StartIcon="@Icons.Material.Filled.CloudDownload">
            @(_busy ? "Importiere …" : "Importieren")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ClaimsPrincipal User { get; set; } = default!;

    private enum Source { Link, Drive, Upload }

    private int _sourceTab;
    private string? _link;
    private GoogleDriveChoice? _drive;
    private byte[]? _upload;
    private string? _fileName;
    private GoogleImportMode _mode = GoogleImportMode.Original;
    private string? _title;
    private string? _category;
    private DocumentClassification _classification;
    private IReadOnlyList<DocumentClassification> _classificationOptions = [];
    private bool _busy;

    // the sign-in tab sits between link and upload only when it is configured
    private Source Chosen => _sourceTab switch
    {
        0 => Source.Link,
        1 when DriveOptions.Value.IsConfigured => Source.Drive,
        _ => Source.Upload,
    };

    private bool Ready => Chosen switch
    {
        Source.Link => !string.IsNullOrWhiteSpace(_link),
        Source.Drive => _drive is not null,
        _ => _upload is not null,
    };

    protected override void OnInitialized() => _classificationOptions = DocumentViewerScope.AssignableOptions(User);

    private void Picked(GoogleDriveChoice choice) => _drive = choice;

    private async Task PickAsync(IBrowserFile? file)
    {
        if (file is null)
        {
            return;
        }
        // the previous choice goes first: while the new file streams in, importing must not send the old one
        _upload = null;
        _fileName = null;
        _busy = true;
        try
        {
            await using var stream = file.OpenReadStream(GoogleExportFetcher.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            _upload = buffer.ToArray();
            _fileName = file.Name;
        }
        catch (IOException)
        {
            Snackbar.Add("Die Datei ist zu groß (höchstens 25 MB).", Severity.Error);
        }
        catch (Exception ex)
        {
            // outside the page's error boundary: a file the browser cannot read must not end the circuit
            Logger.LogWarning(ex, "Reading an uploaded Google Docs zip failed.");
            Snackbar.Add("Die Datei ließ sich nicht lesen. Wähle sie noch einmal.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ImportAsync()
    {
        var source = Chosen;
        _busy = true;
        try
        {
            var document = await GoogleImport.ImportDocumentAsync(new GoogleDocImportInput
            {
                Link = source == Source.Link ? _link : null,
                Drive = source == Source.Drive ? _drive?.Pick : null,
                UploadZip = source == Source.Upload ? _upload : null,
                Mode = _mode,
                Title = _title,
                Category = _category,
                Classification = _classification,
            }, User);
            MudDialog.Close(DialogResult.Ok(document.Id));
        }
        catch (Exception ex) when (ex is GoogleExportException or InvalidOperationException or UnauthorizedAccessException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _busy = false;
        }
        catch (Exception ex)
        {
            // the dialog sits outside the page's error boundary: anything escaping here would end the circuit
            Logger.LogError(ex, "Google import failed.");
            Snackbar.Add("Der Import ist fehlgeschlagen. Versuche es später erneut.", Severity.Error);
            _busy = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    /// <summary>Opens the dialog; returns the new document's id, or null when cancelled.</summary>
    public static async Task<string?> ShowAsync(IDialogService dialog, ClaimsPrincipal user)
    {
        var parameters = new DialogParameters<GoogleImportDialog> { { x => x.User, user } };
        var reference = await dialog.ShowAsync<GoogleImportDialog>("Aus Google Docs importieren", parameters,
            // no closing beside the dialog while it imports: the import would finish unseen and invite a second one
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        var result = await reference.Result;
        return result is { Canceled: false, Data: string id } ? id : null;
    }
}
