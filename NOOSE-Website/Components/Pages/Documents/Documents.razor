@* Central document library: searchable list of all documents visible to the caller. *@
@page "/dokumente"
@inject IDocumentService DocumentService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using NOOSE_Website.Models.Navigation

<PageTitle>Dokumenten-Bibliothek · FIB</PageTitle>

@* ShowHelp off: the hand-built header this replaces had no help button, and the desktop stays as it was *@
<PageHeader Icon="@Icons.Material.Filled.MenuBook" Title="Dokumenten-Bibliothek" ShowHelp="false"
            Subtitle="Zentrale Bibliothek formatierter Dokumente und hochgeladener Dateien (Formulare, SOPs, Vorlagen). Ein Dokument kann an beliebig viele Akten als Quelle angehängt werden. Verschlusssachen sind je nach Stufe nur der Führung, dem HRT oder der Administration Division sichtbar.">
    <MoreActions>
        @if (_mayImport)
        {
            <MudButton OnClick="ImportAsync" Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.CloudDownload">Aus Google Docs</MudButton>
        }
    </MoreActions>
    <MoreActionsMenu>
        @if (_mayImport)
        {
            <MudMenuItem Icon="@Icons.Material.Filled.CloudDownload" OnClick="ImportAsync">Aus Google Docs</MudMenuItem>
        }
    </MoreActionsMenu>
    <Actions>
        <AuthorizeView Policy="@Policies.DocumentAuthor" Context="schreib">
            <MudButton Href="/dokumente/neu" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">Neues Dokument</MudButton>
        </AuthorizeView>
    </Actions>
</PageHeader>

<MudTabs Elevation="0" Rounded="true" Class="mb-3 noose-reiter-handy">
<MudTabPanel Icon="@Icons.Material.Filled.Article" Text="Dokumente">

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @if (_pinned.Count > 0)
    {
        <MudPaper Class="pa-3 mb-4" Elevation="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.PushPin" Color="Color.Primary" Size="Size.Small" />
                <MudText Typo="Typo.subtitle2">Angepinnt</MudText>
            </MudStack>
            <MudStack Spacing="1">
                @foreach (var p in _pinned)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="noose-eintrag">
                        <MudIcon Icon="@Icons.Material.Filled.Article" Color="Color.Default" Size="Size.Small" />
                        <MudLink Href="@($"/dokumente/{p.Id}")" Class="noose-eintrag-titel">@p.Title</MudLink>
                        @if (!string.IsNullOrWhiteSpace(p.Category))
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@p.Category</MudText>
                        }
                        @if (p.IsRestricted)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" Size="Size.Small"
                                     Title="@DocumentClassificationDisplay.Label(p.Classification)" />
                        }
                        <MudSpacer />
                        @if (_isLeadership)
                        {
                            <MudTooltip Text="Lösen">
                                <MudIconButton Icon="@Icons.Material.Filled.PushPin" Color="Color.Primary" Size="Size.Small"
                                               OnClick="() => PinSet(p, false)" aria-label="Anpinnen lösen" />
                            </MudTooltip>
                        }
                    </MudStack>
                }
            </MudStack>
        </MudPaper>
    }

    <MudDataGrid T="DocumentListItem" Items="_rows" Hover="true" Filterable="false" SortMode="SortMode.Multiple"
                 QuickFilter="Filter" Elevation="2" RowClick="@(args => Open(args.Item))" Dense="true"
                 Breakpoint="Breakpoint.None" Class="noose-filterleiste">
        <ToolBarContent>
            <MudTextField @bind-Value="_search" Placeholder="Suchen (Titel, Kategorie)…" Immediate="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0 noose-filter-feld" />
            <MobileColumnPicker ListKey="dokumente" Columns="PhoneColumns" Defaults="PhoneDefaults"
                                VisibleChanged="@(v => _phoneColumns = v)" />
        </ToolBarContent>
        <Columns>
            @if (_isLeadership)
            {
                <TemplateColumn Title="" Sortable="false" HeaderClass="@Col("anpinnen")" CellClass="@Col("anpinnen")">
                    <CellTemplate>
                        @* Stop propagation so the pin click doesn't also open the row. *@
                        <span @onclick:stopPropagation="true">
                            <MudTooltip Text="Anpinnen">
                                <MudIconButton Icon="@Icons.Material.Outlined.PushPin" Color="Color.Default" Size="Size.Small"
                                               OnClick="@(() => PinSet(context.Item, true))"
                                               aria-label="Dokument anpinnen" />
                            </MudTooltip>
                        </span>
                    </CellTemplate>
                </TemplateColumn>
            }
            <TemplateColumn Sortable="true" Title="Titel" SortBy="x => x.Title" HeaderClass="@Col("titel")" CellClass="@Col("titel")">
                <CellTemplate>
                    @* Real link: middle/Ctrl-click opens a new tab; keyboard/screen-reader reachable. *@
                    <MudLink Href="@($"/dokumente/{context.Item.Id}")" @onclick:stopPropagation="true">@context.Item.Title</MudLink>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="true" Title="Kategorie" SortBy="x => x.Category" HeaderClass="@Col("kategorie")" CellClass="@Col("kategorie")">
                <CellTemplate>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@(string.IsNullOrWhiteSpace(context.Item.Category) ? "—" : context.Item.Category)</MudText>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="true" Title="Verschluss" SortBy="x => x.Classification" HeaderClass="@Col("verschluss")" CellClass="@Col("verschluss")">
                <CellTemplate>
                    @if (context.Item.IsRestricted)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                                 Icon="@Icons.Material.Filled.Lock">@DocumentClassificationDisplay.ChipLabel(context.Item.Classification)</MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Refreshed" Title="Zuletzt" Format="dd.MM.yyyy HH:mm" HeaderClass="@Col("zuletzt")" CellClass="@Col("zuletzt")" />
        </Columns>
        <NoRecordsContent>
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-6">
                <MudIcon Icon="@Icons.Material.Filled.MenuBook" Color="Color.Default" Size="Size.Large" />
                <AuthorizeView Policy="@Policies.PartnerView" Context="partnerEmpty">
                    <Authorized>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Für Ihre Behörde wurde noch kein Dokument freigegeben.</MudText>
                    </Authorized>
                    <NotAuthorized>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Noch keine Dokumente – lege das erste an.</MudText>
                    </NotAuthorized>
                </AuthorizeView>
                <AuthorizeView Policy="@Policies.DocumentAuthor" Context="schreib">
                    <MudButton Href="/dokumente/neu" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">Neues Dokument</MudButton>
                </AuthorizeView>
            </MudStack>
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager Class="noose-pager-handy" T="DocumentListItem" />
        </PagerContent>
    </MudDataGrid>
}

</MudTabPanel>
@if (!_isPartner)
{
<MudTabPanel Icon="@Icons.Material.Filled.FolderOpen" Text="Dateien">
    @* internal file library *@
    <LibraryPanel />
</MudTabPanel>
}
</MudTabs>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;
    private bool _isLeadership;
    private bool _isPartner;
    private string _search = string.Empty;
    private ClaimsPrincipal _user = default!;
    private bool _mayImport;

    /// <summary>The grid's columns for the phone column picker, in table order; keys in lower case without umlauts.</summary>
    private static readonly IReadOnlyList<(string Key, string Label)> AllPhoneColumns =
    [
        ("anpinnen", "Anpinnen"), ("titel", "Titel"), ("kategorie", "Kategorie"), ("verschluss", "Verschluss"),
        ("zuletzt", "Zuletzt"),
    ];

    // the pin column exists for leadership only, so only leadership gets to choose it
    private IReadOnlyList<(string Key, string Label)> PhoneColumns
        => _isLeadership ? AllPhoneColumns : AllPhoneColumns.Where(c => c.Key != "anpinnen").ToList();

    /// <summary>What a phone shows until the agent chooses: the title and when it last changed.</summary>
    private static readonly IReadOnlyList<string> PhoneDefaults = ["titel", "zuletzt"];

    // the defaults until the picker reports the stored choice, so even the first paint is narrow on a phone
    private IReadOnlySet<string> _phoneColumns = MobileColumnSet.Resolve(AllPhoneColumns.Select(c => c.Key).ToList(), PhoneDefaults, null);

    // below 600px only; from 600px up every column shows, as before
    private string Col(string key) => MobileColumnSet.ClassFor(_phoneColumns, key);

    private async Task ImportAsync()
    {
        if (await GoogleImportDialog.ShowAsync(DialogService, _user) is { } id)
        {
            Snackbar.Add("Dokument importiert.", Severity.Success);
            Nav.NavigateTo($"/dokumente/{id}");
        }
    }
    private List<DocumentListItem> _rows = new();      // Nicht angepinnte – im Grid darunter.
    private List<DocumentListItem> _pinned = new();   // Angepinnte – im Block oben.

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _isLeadership = _user.IsLeadership();
        // mirrors the import service: partners author documents but never make the server fetch
        _mayImport = _user.MayWrite() && _user.IsInternalAgent();
        _isPartner = _user.IsPartner();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var all = await DocumentService.GetListAsync(DocumentViewerScope.From(_user), partnerAgency: _user.GetPartnerAgency(), partnerAgentId: _user.GetAgentId());
        _pinned = all.Where(d => d.Pinned).ToList();
        _rows = all.Where(d => !d.Pinned).ToList();
        _load = false;
    }

    private async Task PinSet(DocumentListItem item, bool pinned)
    {
        try
        {
            await DocumentService.PinSetAsync(item.Id, pinned, _user);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private bool Filter(DocumentListItem z)
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            return true;
        }
        var s = _search.Trim();
        return z.Title.Contains(s, StringComparison.OrdinalIgnoreCase)
            || (z.Category?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private void Open(DocumentListItem z) => Nav.NavigateTo($"/dokumente/{z.Id}");
}
