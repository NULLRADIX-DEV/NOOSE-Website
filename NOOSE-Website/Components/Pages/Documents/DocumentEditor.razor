@* WYSIWYG editor to create/edit a library document; may attach to a record or preselect a template via query. *@
@page "/dokumente/neu"
@page "/dokumente/{Id}/bearbeiten"
@using NOOSE_Website.Infrastructure
@using NOOSE_Website.Services.Import
@inject IDocumentService DocumentService
@inject IGoogleImportService GoogleImport
@inject IDialogService DialogService
@inject IDocumentTemplateService TemplateService
@inject IPlaceholderService Placeholder
@inject ISourceService SourceService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject ILogger<DocumentEditor> Logger

<PageTitle>@(_edit ? "Dokument bearbeiten" : "Neues Dokument") · NOOSE</PageTitle>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_edit && !_found)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Dokument nicht gefunden oder nicht zugänglich.</MudAlert>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="Cancel" aria-label="Zurück" />
        <MudIcon Icon="@Icons.Material.Filled.Article" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h4">@(_edit ? "Dokument bearbeiten" : "Neues Dokument")</MudText>
        <MudSpacer />
        <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Default">Abbrechen</MudButton>
        @* edit-mode save is for writers or a partner editing their own document; create-mode stays open *@
        @if (!_edit || _user.MayWrite() || _mayEditOwn)
        {
            <MudButton OnClick="SaveAsync" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="_saves">Speichern</MudButton>
        }
    </MudStack>

    <MudPaper Class="pa-4" Elevation="2">
        <MudStack Spacing="3">
            <MudGrid>
                <MudItem xs="12" md="7">
                    <MudTextField @bind-Value="_title" Label="Titel" Variant="Variant.Outlined" Required="true"
                                  RequiredError="Titel ist erforderlich" AutoFocus="true" />
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudTextField @bind-Value="_category" Label="Kategorie (optional)" Variant="Variant.Outlined"
                                  Placeholder="z. B. SOP, Formular, Vermerk" />
                </MudItem>
            </MudGrid>

            @if (!_edit && _templates.Count > 0)
            {
                <MudSelect T="string" Label="Vorlage übernehmen (optional)" Value="_selectedTemplateId"
                           ValueChanged="TemplateApplyAsync" Variant="Variant.Outlined" Clearable="true"
                           Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Dvr"
                           HelperText="Füllt den Editor mit dem Vorlagen-Text vor und ersetzt Platzhalter aus dem Kontext.">
                    @foreach (var v in _templates)
                    {
                        <MudSelectItem T="string" Value="@v.Id">@v.Name</MudSelectItem>
                    }
                </MudSelect>
            }

            @if (_classificationOptions.Count > 1)
            {
                <MudSelect T="DocumentClassification" @bind-Value="_classification" Label="Verschluss-Stufe"
                           Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock"
                           HelperText="Bestimmt, wer das Dokument sehen darf.">
                    @foreach (var option in _classificationOptions)
                    {
                        <MudSelectItem T="DocumentClassification" Value="@option">@DocumentClassificationDisplay.Label(option)</MudSelectItem>
                    }
                </MudSelect>
            }

            @if (_original is not null)
            {
                @* the text of an imported original lives in Google: editing here would have to drop its formatting *@
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    Dieses Dokument ist ein Original aus Google Docs. Den Text änderst du in Google und holst ihn mit
                    <b>Aktualisieren</b> neu; Titel, Kategorie und Verschluss-Stufe speicherst du hier. Erst eine
                    <b>bearbeitbare Kopie</b> lässt sich im Editor ändern - dabei geht Formatierung verloren, die der
                    Editor nicht kennt (Schriften, Abstände, Spalten).
                </MudAlert>
                @if (_mayImport)
                {
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        @if (_importKind == ImportSourceKind.Link)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Sync"
                                       OnClick="@(() => ReimportAsync(null))" Disabled="_importing">Aktualisieren</MudButton>
                        }
                        else
                        {
                            <MudFileUpload T="IBrowserFile" Accept=".zip" FilesChanged="ReimportUploadAsync" Disabled="_importing">
                                <CustomContent>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Upload"
                                               Disabled="_importing" OnClick="@context.OpenFilePickerAsync">Neue Fassung hochladen (.zip)</MudButton>
                                </CustomContent>
                            </MudFileUpload>
                        }
                        <MudButton Variant="Variant.Text" Color="Color.Warning" StartIcon="@Icons.Material.Filled.EditNote"
                                   OnClick="ConvertAsync" Disabled="_importing">In bearbeitbare Kopie umwandeln</MudButton>
                        @if (_importing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        }
                    </MudStack>
                }
                <ImportedDocument Html="@_original" />
            }
            else
            {
                <RichTextEditor @ref="_editor" Value="@_contentHtml" Ai="TextAssistContext.Document" AiSubject="@_title" Mentions="true"
                                OnSaveRequested="SaveAsync"
                                DraftKey='@(_edit ? $"dokument:{Id}" : $"dokument:neu:{_entityType}:{_entityId}")' />
            }
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter] public string? Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private RichTextEditor? _editor;
    private ClaimsPrincipal _user = default!;
    private string? _original;
    private ImportSourceKind? _importKind;
    private bool _mayImport;
    private bool _importing;

    private bool _load = true;
    private bool _edit;
    private bool _found;
    private bool _saves;
    private bool _mayEditOwn;

    private string _title = string.Empty;
    private string? _category;
    private DocumentClassification _classification;
    private IReadOnlyList<DocumentClassification> _classificationOptions = Array.Empty<DocumentClassification>();
    private string? _contentHtml;

    private List<DocumentTemplate> _templates = new();
    private string? _selectedTemplateId;

    // Record context when launched from a source view.
    private string? _entityType;
    private string? _entityId;
    private bool _attach;

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _classificationOptions = DocumentViewerScope.AssignableOptions(_user);
        _edit = !string.IsNullOrEmpty(Id);

        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        _entityType = query.TryGetValue("entitaetTyp", out var et) ? et.ToString() : null;
        _entityId = query.TryGetValue("entitaetId", out var ei) ? ei.ToString() : null;
        _attach = query.TryGetValue("attach", out var at) && at == "1";
        var templateId = query.TryGetValue("vorlageId", out var vid) ? vid.ToString() : null;

        if (_edit)
        {
            // partner-scoped load: a partner only opens documents released to them or authored by themselves
            var document = await DocumentService.GetAsync(Id!, DocumentViewerScope.From(_user),
                partnerAgency: _user.GetPartnerAgency(), partnerAgentId: _user.GetAgentId());
            if (document is not null)
            {
                _found = true;
                _mayEditOwn = document.CreatedById == _user.GetAgentId();
                _title = document.Title;
                _category = document.Category;
                _classification = document.Classification;
                _contentHtml = document.ContentHtml;
                _original = document.ImportedHtml;
                _importKind = document.ImportSourceKind;
                // mirrors the import service: partners author documents but never make the server fetch
                _mayImport = _user.MayWrite() && _user.IsInternalAgent();
            }
        }
        else
        {
            // recruiting letters share this table but use the bare-word token scheme, which this editor cannot fill
            _templates = (await TemplateService.GetActiveAsync())
                .Where(v => !string.Equals(v.Category, RecruitingSeeder.TemplateCategory, StringComparison.OrdinalIgnoreCase))
                .ToList();
            // Editor reads the value only on init, so inject the template into the initial content.
            if (!string.IsNullOrEmpty(templateId))
            {
                var template = _templates.FirstOrDefault(v => v.Id == templateId);
                if (template is not null)
                {
                    _selectedTemplateId = template.Id;
                    _contentHtml = await Placeholder.ApplyAsync(template.ContentHtml, _entityType, _entityId, _user);
                    if (string.IsNullOrWhiteSpace(_title))
                    {
                        _title = template.Name;
                    }
                }
            }
        }

        _load = false;
    }

    private async Task TemplateApplyAsync(string? templateId)
    {
        _selectedTemplateId = templateId;
        if (string.IsNullOrEmpty(templateId))
        {
            return;
        }
        var template = _templates.FirstOrDefault(v => v.Id == templateId);
        if (template is null)
        {
            return;
        }
        var html = await Placeholder.ApplyAsync(template.ContentHtml, _entityType, _entityId, _user);
        if (_editor is not null)
        {
            await _editor.SetHtmlAsync(html);
        }
        if (string.IsNullOrWhiteSpace(_title))
        {
            _title = template.Name;
        }
    }

    private async Task SaveAsync()
    {
        var title = _title?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(title))
        {
            Snackbar.Add("Bitte einen Titel angeben.", Severity.Warning);
            return;
        }

        _saves = true;
        try
        {
            // an imported original sends its stored copy; the service keeps that text anyway
            var html = _editor is null ? _contentHtml ?? string.Empty : await _editor.GetHtmlAsync();
            // documents created from a taskforce's sources are taskforce-internal
            var isTaskforceDoc = !_edit && HasRecordsContext() && _entityType == nameof(Taskforce);
            var input = new DocumentInput
            {
                Title = title,
                Category = _category,
                ContentHtml = html,
                // the text was shown locked: whatever happened to it since must not be replaced by this old copy
                KeepContent = _edit && _original is not null,
                Classification = _classification,
                OwnerTaskforceId = isTaskforceDoc ? _entityId : null,
            };

            string id;
            if (_edit)
            {
                await DocumentService.RefreshAsync(Id!, input, _user);
                id = Id!;
            }
            else
            {
                var document = await DocumentService.CreateAsync(input, _user);
                id = document.Id;
                // stored from here on: a failing source link below must not leave the text offered as unsaved
                if (_editor is not null)
                {
                    await _editor.MarkSavedAsync();
                }

                // Attach as a source when created from a record. Taskforce docs stay internal via
                // Document.OwnerTaskforceId, so the source row itself need not be marked internal-only
                // (that would hide it from leadership/admin who aren't assigned members).
                if (HasRecordsContext())
                {
                    await SourceService.CreateAsync(_entityType!, _entityId!, new SourceInput
                    {
                        Type = SourceType.Document,
                        Title = title,
                        TargetType = nameof(Document),
                        TargetId = id,
                    }, _user);
                }
            }

            if (_editor is not null)
            {
                await _editor.MarkSavedAsync();
            }
            Snackbar.Add("Dokument gespeichert.", Severity.Success);
            Nav.NavigateTo(TargetBySave(id));
        }
        catch (Exception ex)
        {
            // diagnostic: each gate throws a distinct message, so this pins the failing layer
            Logger.LogError(ex, "Document create/save failed (agent={Agent}, partner={Partner}, entity={EntityType}/{EntityId})",
                _user.GetAgentId(), _user.IsPartner(), _entityType, _entityId);
            Snackbar.Add($"{ex.GetType().Name}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saves = false;
        }
    }

    private async Task ReimportUploadAsync(IBrowserFile? file)
    {
        if (file is null)
        {
            return;
        }
        try
        {
            await using var stream = file.OpenReadStream(GoogleExportFetcher.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            await ReimportAsync(buffer.ToArray());
        }
        catch (IOException)
        {
            Snackbar.Add("Die Datei ist zu groß (höchstens 25 MB).", Severity.Error);
        }
    }

    private async Task ReimportAsync(byte[]? upload)
    {
        _importing = true;
        try
        {
            await GoogleImport.ReimportDocumentAsync(Id!, upload, _user);
            var document = await DocumentService.GetAsync(Id!, DocumentViewerScope.From(_user));
            _original = document?.ImportedHtml;
            _contentHtml = document?.ContentHtml;
            Snackbar.Add("Aus Google aktualisiert.", Severity.Success);
        }
        catch (Exception ex) when (ex is GoogleExportException or InvalidOperationException or UnauthorizedAccessException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Das Aktualisieren ist fehlgeschlagen. Versuche es später erneut.", Severity.Error);
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task ConvertAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("In bearbeitbare Kopie umwandeln?",
            "Das Google-Original wird verworfen. Übrig bleibt eine vereinfachte Fassung, die du hier bearbeiten kannst; "
            + "Schriften, Abstände und andere Formatierung, die der Editor nicht kennt, gehen verloren. "
            + "Aktualisieren aus Google ist danach nicht mehr möglich.",
            yesText: "Umwandeln", cancelText: "Abbrechen");
        if (confirmed != true)
        {
            return;
        }
        _importing = true;
        try
        {
            await GoogleImport.ConvertToEditableAsync(Id!, _user);
            var document = await DocumentService.GetAsync(Id!, DocumentViewerScope.From(_user));
            _contentHtml = document?.ContentHtml;
            // the editor renders fresh and reads the copy on its first render
            _original = null;
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Das Umwandeln ist fehlgeschlagen. Versuche es später erneut.", Severity.Error);
        }
        finally
        {
            _importing = false;
        }
    }

    private void Cancel()
    {
        if (HasRecordsContext() && SourcesTab() is { } back)
        {
            Nav.NavigateTo(back);
        }
        else if (_edit)
        {
            Nav.NavigateTo($"/dokumente/{Id}");
        }
        else
        {
            Nav.NavigateTo("/dokumente");
        }
    }

    private bool HasRecordsContext()
        => _attach && !string.IsNullOrWhiteSpace(_entityType) && !string.IsNullOrWhiteSpace(_entityId);

    private string TargetBySave(string id)
        // partners don't see document sources on a record's Quellen tab, so open the created doc directly
        => HasRecordsContext() && !_user.IsPartner() && SourcesTab() is { } tab
            ? tab
            : $"/dokumente/{id}";

    // the parent record's Quellen tab, or null when its type has no page of its own
    private string? SourcesTab()
        => SearchNavigation.For(_entityType, _entityId!) is { } route ? $"{route}?tab=quellen" : null;
}
