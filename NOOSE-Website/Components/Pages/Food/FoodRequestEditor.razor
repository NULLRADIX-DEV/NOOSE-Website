@page "/verpflegung/neu"
@inject IFoodCatalogService Catalog
@inject IFoodLimitService Limits
@inject IFoodService FoodRequests
@inject FoodBroadcaster Broadcaster
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Neue Verpflegungsanforderung · FIB</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.Restaurant"
            Title="Neue Verpflegungsanforderung"
            Subtitle="Essen und Trinken suchen, Menge festlegen, abschicken."
            BackHref="/verpflegung" />

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_isTeamLead)
{
    <EmptyState Icon="@Icons.Material.Filled.VisibilityOff" Title="Nicht für die Team-Leitung"
                Text="Die Team-Leitung ist Nur-Lese-Aufsicht und fordert keine Verpflegung an." />
}
else if (_items.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Filled.Restaurant" Title="Nichts verfügbar"
                Text="Derzeit ist keine Verpflegung im Katalog hinterlegt. Wende dich an die Führung." />
}
else
{
    <MudStack Spacing="3">
        <FoodLimitTiles Status="_limit" />

        <MudPaper Class="pa-4" Elevation="1">
            <MudForm @ref="_form">
                <MudStack Spacing="3">
                    <MudAutocomplete T="FoodItemDisplay" @ref="_picker" Label="Essen oder Trinken suchen & hinzufügen"
                                     Value="_pick" ValueChanged="OnPickAsync" SearchFunc="SearchItemsAsync"
                                     ToStringFunc="@(i => i is null ? string.Empty : i.Name)"
                                     ResetValueOnEmptyText="true" Clearable="true" MinCharacters="0" Immediate="true"
                                     CoerceText="false" CoerceValue="false" MaxItems="@MaxSuggestions"
                                     Variant="Variant.Outlined" Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.Search"
                                     HelperText="@SearchHint">
                        <ItemTemplate Context="item">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Style="width:100%">
                                <MudIcon Icon="@FoodKindDisplay.Icon(item.Item.Kind)" Size="Size.Small" Class="mud-text-secondary" />
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2">@item.Name</MudText>
                                    @if (!string.IsNullOrWhiteSpace(item.Item.Description))
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@item.Item.Description</MudText>
                                    }
                                </MudStack>
                                <MudSpacer />
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    Bestand: @item.OnHand · max. @item.Item.MaxQuantity
                                </MudText>
                            </MudStack>
                        </ItemTemplate>
                        <NoItemsTemplate>
                            <MudText Typo="Typo.caption" Class="pa-2 mud-text-secondary">
                                Nichts Passendes — bereits gewählte Positionen tauchen hier nicht mehr auf.
                            </MudText>
                        </NoItemsTemplate>
                    </MudAutocomplete>

                    @if (_cart.Count == 0)
                    {
                        <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true">
                            Noch nichts gewählt. Was es gibt, steht im
                            <MudLink Href="/verpflegung?tab=katalog" Target="_blank">Katalog</MudLink>.
                        </MudAlert>
                    }
                    else
                    {
                        <MudSimpleTable Dense="true" Hover="true">
                            <thead>
                                <tr>
                                    <th>Position</th>
                                    <th class="noose-mobil-aus">Art</th>
                                    <th class="noose-mobil-aus" style="text-align:right">Bestand</th>
                                    <th style="text-align:right">Menge</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in _cart)
                                {
                                    var row = line;
                                    <tr>
                                        <td>
                                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                                <MudIcon Icon="@FoodKindDisplay.Icon(row.Item.Item.Kind)" Size="Size.Small" Class="mud-text-secondary" />
                                                <span>@row.Item.Name</span>
                                            </MudStack>
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                                                Bestand: @row.Item.OnHand · max. @row.Item.Item.MaxQuantity
                                            </MudText>
                                            @if (!string.IsNullOrWhiteSpace(row.Item.Item.Description))
                                            {
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@row.Item.Item.Description</MudText>
                                            }
                                        </td>
                                        <td class="noose-mobil-aus">@FoodKindDisplay.Name(row.Item.Item.Kind)</td>
                                        <td class="noose-mobil-aus" style="text-align:right">@row.Item.OnHand</td>
                                        <td style="text-align:right; width:130px">
                                            <MudNumericField T="int" Value="@row.Quantity" Min="1" Max="@row.Item.Item.MaxQuantity"
                                                             ValueChanged="@(v => SetQuantity(row, v))"
                                                             Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </td>
                                        <td style="text-align:right">
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                           OnClick="@(() => Remove(row))" aria-label="Position entfernen" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }

                    <MentionInput @bind-Text="_justification" Label="Begründung (optional)" Lines="3" MaxLength="2000"
                                  HelperText="@JustificationHint" DraftKey="@DraftKey" />
                </MudStack>
            </MudForm>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="1">
            <MudStack Spacing="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2">Essen</MudText>
                    <MudText Typo="Typo.body2">@TotalFood von @_limit.FoodRemaining übrig</MudText>
                </MudStack>
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2">Trinken</MudText>
                    <MudText Typo="Typo.body2">@TotalDrink von @_limit.DrinkRemaining übrig</MudText>
                </MudStack>
                <MudDivider Class="my-1" />
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.subtitle1"><b>Angefordert</b></MudText>
                    <MudText Typo="Typo.subtitle1"><b>@FoodService.Summary(TotalFood, TotalDrink)</b></MudText>
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (FoodOverrun > 0 || DrinkOverrun > 0)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                Die Anforderung übersteigt dein Wochenlimit: <b>@OverrunText</b>.
                Du kannst sie stellen — die Führung muss die Überschreitung dann begründen.
            </MudAlert>
        }

        <FormActions>
            <MudButton Href="/verpflegung">Abbrechen</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Send"
                       Disabled="@(_saving || _cart.Count == 0)"
                       OnClick="SaveAsync">Anfordern</MudButton>
        </FormActions>
    </MudStack>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    // held in C# because a literal "@" in a component attribute is parsed as a code block
    private const string JustificationHint = "Wofür brauchst du das? Mit @ kannst du Akten und Agenten erwähnen.";
    private const string SearchHint = "Bezeichnung oder Beschreibung eingeben — die Auswahl landet unten in der Liste.";
    private const int MaxSuggestions = 20;

    /// <summary>One chosen position with its quantity; the picker holds nothing, this list is the basket.</summary>
    private sealed class CartLine
    {
        public FoodItemDisplay Item { get; init; } = default!;
        public int Quantity { get; set; } = 1;
    }

    private bool _load = true;
    private bool _saving;
    private bool _isTeamLead;
    private ClaimsPrincipal _user = default!;

    // the page only ever creates, so one draft per agent
    private const string DraftKey = "verpflegung:neu:begruendung";
    private MudForm _form = default!;
    private MudAutocomplete<FoodItemDisplay> _picker = default!;
    private FoodItemDisplay? _pick;
    private List<FoodItemDisplay> _items = new();
    private readonly List<CartLine> _cart = new();
    private FoodLimitStatus _limit = FoodLimitStatus.Empty;
    private string _justification = string.Empty;

    private int TotalFood => _cart.Where(l => l.Item.Item.Kind == FoodKind.Food).Sum(l => l.Quantity);

    private int TotalDrink => _cart.Where(l => l.Item.Item.Kind == FoodKind.Drink).Sum(l => l.Quantity);

    private int FoodOverrun => TotalFood > 0 ? Math.Max(0, TotalFood - _limit.FoodRemaining) : 0;

    private int DrinkOverrun => TotalDrink > 0 ? Math.Max(0, TotalDrink - _limit.DrinkRemaining) : 0;

    private string OverrunText => string.Join(", ", new[]
    {
        FoodOverrun > 0 ? $"Essen um {FoodOverrun}" : null,
        DrinkOverrun > 0 ? $"Trinken um {DrinkOverrun}" : null,
    }.Where(p => p is not null));

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        // the service rejects it too; this only avoids offering a form that can never be submitted
        _isTeamLead = _user.IsTeamLead();
        if (!_isTeamLead)
        {
            _items = await Catalog.GetActiveAsync();
            var agentId = _user.GetAgentId();
            if (!string.IsNullOrEmpty(agentId))
            {
                _limit = await Limits.GetStatusAsync(agentId);
            }
        }
        _load = false;
    }

    private Task<IEnumerable<FoodItemDisplay>> SearchItemsAsync(string value, CancellationToken token)
    {
        // hide what is already in the basket: a second line for the same position is rejected on save
        var pool = _items.Where(i => _cart.All(l => l.Item.Item.Id != i.Item.Id));
        var term = value?.Trim();
        if (!string.IsNullOrEmpty(term))
        {
            pool = pool.Where(i => Matches(i, term));
        }
        return Task.FromResult(pool.Take(MaxSuggestions));
    }

    private static bool Matches(FoodItemDisplay item, string term)
        => item.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
        || FoodKindDisplay.Name(item.Item.Kind).Contains(term, StringComparison.OrdinalIgnoreCase)
        || (item.Item.Description?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false);

    private async Task OnPickAsync(FoodItemDisplay? item)
    {
        _pick = null;
        if (item is null)
        {
            return;
        }
        if (_cart.All(l => l.Item.Item.Id != item.Item.Id))
        {
            _cart.Add(new CartLine { Item = item, Quantity = 1 });
        }
        // wipe the search box so the next position starts from an empty field
        await _picker.ClearAsync();
    }

    // the numeric field also accepts a typed value outside Min/Max, which the service would reject
    private void SetQuantity(CartLine line, int value)
        => line.Quantity = Math.Clamp(value, 1, Math.Max(1, line.Item.Item.MaxQuantity));

    private void Remove(CartLine line) => _cart.Remove(line);

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }
        _saving = true;
        try
        {
            var input = new FoodRequestInput
            {
                Justification = _justification,
                Lines = _cart.Select(l => new FoodRequestLineInput { ItemId = l.Item.Item.Id, Quantity = l.Quantity }).ToList(),
            };
            var created = await FoodRequests.CreateAsync(input, _user);
            await TextDraft.DiscardAsync(JS, _user.GetAgentId(), DraftKey);
            Broadcaster.Report();
            Snackbar.Add($"Anforderung {created.CaseNumber} eingereicht.", Severity.Success);
            Nav.NavigateTo($"/verpflegung/{created.Id}");
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _saving = false;
        }
    }
}
