@* Editor field: pick the records compromised by the leak. Local list only — persisted by the service on save. *@
@inject ISearchService SearchService
@inject IAgentManagementService Agents

<MudStack Spacing="2">
    <MudAutocomplete T="QuickHit" Label="Kompromittierte Akte suchen & hinzufügen" Value="_pick" ValueChanged="OnPick"
                     SearchFunc="Search" ToStringFunc="@(h => h is null ? string.Empty : $"{h.Name} ({h.CaseNumber})")"
                     ResetValueOnEmptyText="true" Clearable="true" MinCharacters="1" Immediate="true"
                     CoerceText="false" CoerceValue="false" Variant="Variant.Outlined"
                     HelperText="Person, Agent, Operation, Dokument … die durch den Abfluss betroffen ist.">
        <ItemTemplate Context="h">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.body2">@h.Name</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@h.CaseNumber</MudText>
            </MudStack>
        </ItemTemplate>
    </MudAutocomplete>

    @if (Items.Count == 0)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary">Noch keine Akte als kompromittiert markiert.</MudText>
    }
    else
    {
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
            @foreach (var c in Items)
            {
                <MudChip T="string" Color="@(c.Cleared ? Color.Default : Color.Error)" Variant="Variant.Outlined"
                         Size="Size.Small" OnClose="@(() => Remove(c))"
                         Icon="@(c.Cleared ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.GppBad)">
                    @c.Display@(c.Cleared ? " (bereinigt)" : string.Empty)
                </MudChip>
            }
        </MudStack>
    }
</MudStack>

@code {
    [Parameter, EditorRequired] public List<CompromiseTargetInput> Items { get; set; } = new();
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private QuickHit? _pick;
    private List<Agent> _agents = new();

    protected override async Task OnInitializedAsync()
        => _agents = await Agents.GetSelectableAsync();

    private async Task<IEnumerable<QuickHit>> Search(string value, CancellationToken token)
    {
        var term = value ?? string.Empty;
        var user = (await AuthStateTask).User;
        // the quick search also answers with categories that are not records at all - a handbook article, a
        // glossary term. Stored as a compromised item they resolve to nothing and the row reads "(gelöschte
        // Akte)" forever. ReferenceTypes is the set that resolves to a reference, same filter as the @-picker.
        var records = (await SearchService.QuickSearchAsync(term, user, 10, token))
            .Where(h => LinkService.ReferenceTypes.Contains(h.Category, StringComparer.Ordinal))
            .ToList();
        if (string.IsNullOrWhiteSpace(term))
        {
            return records;
        }
        // agents are absent from the quick search, so match them here for compromised Personalakten
        var agentHits = _agents
            .Where(a => (a.Codename ?? string.Empty).Contains(term, StringComparison.OrdinalIgnoreCase)
                     || (a.BadgeNumber ?? string.Empty).Contains(term, StringComparison.OrdinalIgnoreCase))
            .Take(5)
            .Select(a => new QuickHit(nameof(Agent), a.Id, a.Codename, a.BadgeNumber ?? string.Empty));
        return agentHits.Concat(records);
    }

    private void OnPick(QuickHit? hit)
    {
        _pick = null;
        if (hit is null || Items.Any(c => c.TargetType == hit.Category && c.TargetId == hit.TargetId))
        {
            return;
        }
        Items.Add(new CompromiseTargetInput { TargetType = hit.Category, TargetId = hit.TargetId, Display = hit.Name });
    }

    private void Remove(CompromiseTargetInput c) => Items.Remove(c);
}
