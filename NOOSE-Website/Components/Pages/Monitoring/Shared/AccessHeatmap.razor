@* Access heatmap: agent rows × hour-of-day columns, intensity by count. Pure CSS grid, no JS. *@
@using NOOSE_Website.Models.CounterIntel

@if (Data.Agents.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">Keine Zugriffsdaten im Zeitraum.</MudText>
}
else
{
    <div style="overflow-x:auto;">
        <table style="border-collapse:collapse;">
            <thead>
                <tr>
                    <th></th>
                    @for (var h = 0; h < 24; h++)
                    {
                        <th style="font-size:.6rem;color:#A8A29A;width:18px;text-align:center;font-weight:400;">@h</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var agent in Data.Agents)
                {
                    <tr>
                        <td style="font-size:.75rem;padding-right:8px;white-space:nowrap;max-width:150px;overflow:hidden;text-overflow:ellipsis;" title="@agent.AgentName">@agent.AgentName</td>
                        @for (var h = 0; h < 24; h++)
                        {
                            var count = agent.Hours[h];
                            <td title="@($"{h}:00 – {count} Zugriffe")" style="@CellStyle(count)"></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public CounterIntelHeatmap Data { get; set; } = default!;

    private string CellStyle(int count)
    {
        var baseStyle = "width:18px;height:18px;border:1px solid #333333;";
        if (count == 0 || Data.MaxCount == 0)
        {
            return baseStyle + "background:transparent;";
        }
        var alpha = 0.12 + 0.88 * count / Data.MaxCount;
        var a = alpha.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        return baseStyle + $"background:rgba(197,159,103,{a});";
    }
}
