@page "/praesentationen/{Id}/live"
@attribute [Authorize(Policy = Policies.InternalAgent)]
@implements IAsyncDisposable
@inject IPresentationService Presentations
@inject IPresentationLiveService Live
@inject PresentationLiveRegistry Registry
@inject PresentationBroadcaster Broadcaster
@inject PresentationScript Script
@inject IAgentManagementService Agents
@inject ISnackbar Snackbar

<PageTitle>@(_view is null ? "Live" : $"Live: {_view.Presentation.Title}") · NOOSE</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_view is null && _ended)
{
    @* an invitation ends with the session: the invited keep nothing of the deck *@
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        Die Vorführung ist beendet. <MudLink Href="/praesentationen">Zu den Präsentationen</MudLink>
    </MudAlert>
}
else if (_view is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Diese Präsentation existiert nicht (mehr) oder ist nicht für dich freigegeben.</MudAlert>
}
else if (_view.Slides.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Diese Präsentation hat noch keine Folien.</MudAlert>
}
else if (_role == LiveRole.Presenter && _session is not null)
{
    var current = SlideAt(_session.SlideIndex);
    var next = _session.SlideIndex + 1 < _view.Slides.Count ? _view.Slides[_session.SlideIndex + 1] : null;
    <div class="praesentation-live" tabindex="0" @ref="_keys" @onkeydown="OnKey">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3 flex-wrap">
            <MudChip T="string" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.FiberManualRecord">LIVE</MudChip>
            <MudText Typo="Typo.h6">@_view.Presentation.Title</MudText>
            <MudSpacer />
            <MudToggleGroup T="PresentationFollowMode" Value="_session.Mode" ValueChanged="SetModeAsync"
                            Size="Size.Small" Color="Color.Primary" Outlined="true">
                <MudToggleItem Value="PresentationFollowMode.Strict" Text="Alle folgen mir" />
                <MudToggleItem Value="PresentationFollowMode.Free" Text="Frei blättern" />
            </MudToggleGroup>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Stop" OnClick="EndAsync">Beenden</MudButton>
        </MudStack>

        <MudGrid>
            <MudItem xs="12" md="8">
                <div class="praesentation-buehne" @ref="_stage">
                    <SlideView Slide="current" Number="@(_session.SlideIndex + 1)" />
                </div>
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2" Class="my-2">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Disabled="@(_session.SlideIndex == 0)"
                                   OnClick="@(() => GoAsync(_session.SlideIndex - 1))" />
                    <MudText Typo="Typo.body2">@(_session.SlideIndex + 1) / @_view.Slides.Count</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Disabled="@(next is null)"
                                   OnClick="@(() => GoAsync(_session.SlideIndex + 1))" />
                    <MudTooltip Text="Vollbild (F)">
                        <MudIconButton Icon="@Icons.Material.Filled.Fullscreen" OnClick="FullscreenAsync" />
                    </MudTooltip>
                </MudStack>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block text-center">
                    Pfeiltasten, Bild auf/ab oder Leertaste blättern; F schaltet das Vollbild.
                </MudText>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Als Nächstes</MudText>
                @if (next is null)
                {
                    <MudPaper Outlined="true" Class="pa-3 mb-3"><MudText Typo="Typo.body2">Ende der Präsentation</MudText></MudPaper>
                }
                else
                {
                    <div class="mb-3"><SlideView Slide="next" Number="@(_session.SlideIndex + 2)" /></div>
                }
                <MudPaper Outlined="true" Class="pa-3 mb-3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Sprechernotizen</MudText>
                    <MudText Typo="Typo.body2" Style="white-space:pre-line;">
                        @(string.IsNullOrWhiteSpace(current?.Notes) ? "—" : current!.Notes)
                    </MudText>
                </MudPaper>
                <MudPaper Outlined="true" Class="pa-3 mb-3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @_session.ViewerCodenames.Count Zuschauer
                    </MudText>
                    @if (_session.ViewerCodenames.Count > 0)
                    {
                        <MudText Typo="Typo.body2">@string.Join(", ", _session.ViewerCodenames)</MudText>
                    }
                </MudPaper>
                @* typing in the picker must not page the slides *@
                <div @onkeydown:stopPropagation="true">
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Zu dieser Vorführung eingeladen</MudText>
                        @if (_session.InvitedIds.Count == 0)
                        {
                            <MudText Typo="Typo.body2">Niemand</MudText>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-1 my-1">
                                @foreach (var invited in _session.InvitedIds)
                                {
                                    var agentId = invited;
                                    <MudChip T="string" Size="Size.Small" OnClose="@(() => Uninvite(agentId))">@AgentName(agentId)</MudChip>
                                }
                            </div>
                        }
                        <MudSelect T="string" Label="Agenten einladen" MultiSelection="true" Variant="Variant.Outlined" Dense="true"
                                   Class="mt-2" SelectedValues="_toInvite" SelectedValuesChanged="@(v => _toInvite = v.ToList())"
                                   MultiSelectionTextFunc="@(ids => $"{ids.Count} ausgewählt")"
                                   HelperText="Sie sehen nur diese Vorführung, nicht die Präsentation selbst.">
                            @foreach (var a in Invitable)
                            {
                                <MudSelectItem T="string" Value="@a.Id">@a.Codename (@RankDisplay.Name(a.Rank))</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="mt-2"
                                   StartIcon="@Icons.Material.Filled.PersonAdd" Disabled="@(_busy || _toInvite.Count == 0)"
                                   OnClick="InviteAsync">Einladen</MudButton>
                    </MudPaper>
                </div>
            </MudItem>
        </MudGrid>
    </div>
}
else if (_role == LiveRole.Viewer && _session is not null)
{
    var shownIndex = Following ? _session.SlideIndex : _localIndex;
    <div class="praesentation-live" tabindex="0" @ref="_keys" @onkeydown="OnKey">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3 flex-wrap">
            <MudChip T="string" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.FiberManualRecord">LIVE</MudChip>
            <MudText Typo="Typo.h6">@_view.Presentation.Title</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @_session.PresenterCodename präsentiert ·
                @(_session.Mode == PresentationFollowMode.Strict ? "Der Vortragende blättert für alle." : "Du darfst frei blättern.")
            </MudText>
            <MudSpacer />
            @if (_user.IsLeadership())
            {
                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="EndAsync">Vorführung beenden</MudButton>
            }
        </MudStack>
        <div class="praesentation-buehne" @ref="_stage">
            <SlideView Slide="SlideAt(shownIndex)" Number="@(shownIndex + 1)" />
        </div>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2" Class="my-2">
            @if (_session.Mode == PresentationFollowMode.Free)
            {
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Disabled="@(shownIndex == 0)" OnClick="@(() => Browse(shownIndex - 1))" />
            }
            <MudText Typo="Typo.body2">@(shownIndex + 1) / @_view.Slides.Count</MudText>
            @if (_session.Mode == PresentationFollowMode.Free)
            {
                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Disabled="@(shownIndex >= _view.Slides.Count - 1)"
                               OnClick="@(() => Browse(shownIndex + 1))" />
                @if (!Following)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Replay" OnClick="@(() => _following = true)">
                        Zurück zum Vortrag (Folie @(_session.SlideIndex + 1))
                    </MudButton>
                }
            }
            <MudTooltip Text="Vollbild (F)">
                <MudIconButton Icon="@Icons.Material.Filled.Fullscreen" OnClick="FullscreenAsync" />
            </MudTooltip>
        </MudStack>
    </div>
}
else
{
    <PageHeader Icon="@Icons.Material.Filled.CoPresent" Title="@_view.Presentation.Title"
                BackHref="@($"/praesentationen/{Id}")" BackText="Zur Ansicht" />
    @if (_ended)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">Die Vorführung ist beendet.</MudAlert>
    }
    @if (_view.MayManage)
    {
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.body1" Class="mb-2">
                Wer die Präsentation sehen darf, bekommt einen Hinweis und kann zuschauen. Du blätterst für alle;
                während der Vorführung kannst du das freie Blättern erlauben.
            </MudText>
            <MudSelect T="string" Label="Zusätzlich einladen (optional)" MultiSelection="true" Variant="Variant.Outlined"
                       Class="mb-3" Style="max-width:520px;" SelectedValues="_toInvite" SelectedValuesChanged="@(v => _toInvite = v.ToList())"
                       MultiSelectionTextFunc="@(ids => $"{ids.Count} eingeladen")" Adornment="Adornment.Start"
                       AdornmentIcon="@Icons.Material.Filled.PersonAdd"
                       HelperText="Eingeladene sehen nur diese Vorführung, nicht die Präsentation selbst; die Einladung endet mit ihr.">
                @foreach (var a in Invitable)
                {
                    <MudSelectItem T="string" Value="@a.Id">@a.Codename (@RankDisplay.Name(a.Rank))</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.PlayArrow"
                       Disabled="_busy" OnClick="StartAsync">Vorführung starten</MudButton>
        </MudPaper>
    }
    else if (!_ended)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            Diese Präsentation wird gerade nicht vorgeführt. Bleib auf der Seite: Sobald sie startet, bist du dabei.
        </MudAlert>
    }
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private enum LiveRole { None, Presenter, Viewer }

    // one key per open page: two tabs of the same agent count apart, and closing one leaves the other in
    private readonly string _key = Guid.NewGuid().ToString("N");

    private ClaimsPrincipal _user = new();
    private string? _me;
    private bool _loading = true;
    private bool _busy;
    private bool _ended;
    // set first on dispose: a load or join still in flight must give its seat back instead of keeping it forever
    private bool _disposed;
    private string? _loadedId;
    private PresentationView? _view;
    private LiveSessionSnapshot? _session;
    private LiveRole _role;
    private int _localIndex;
    private bool _following = true;
    private ElementReference _keys;
    private ElementReference _stage;
    // the picker for whoever may present; empty for everyone else
    private List<Agent> _agents = [];
    private List<string> _toInvite = [];

    private bool Following => _session is null || _session.Mode == PresentationFollowMode.Strict || _following;

    /// <summary>Watching only by the presenter's invitation: the session is all this page may show.</summary>
    private bool LiveOnly => _view?.LiveInviteOnly == true;

    private IEnumerable<Agent> Invitable => _agents.Where(a => a.Id != _me && _session?.InvitedIds.Contains(a.Id) != true);

    private string AgentName(string id) => _agents.FirstOrDefault(a => a.Id == id)?.Codename ?? "nicht mehr auswählbar";

    protected override void OnInitialized() => Broadcaster.Changed += OnLiveChanged;

    protected override async Task OnParametersSetAsync()
    {
        // the banner may lead from one live page to another; the instance stays, the session changes
        if (Id == _loadedId)
        {
            return;
        }
        Detach();
        _loadedId = Id;
        _loading = true;
        _ended = false;
        _user = (await AuthStateTask).User;
        _me = _user.GetAgentId();
        _toInvite = [];
        _view = await Presentations.GetForLiveAsync(Id, _user);
        if (_disposed)
        {
            return;
        }
        if (_view is not null)
        {
            await AttachAsync();
        }
        if (_view?.MayManage == true && _agents.Count == 0)
        {
            _agents = await Agents.GetSelectableAsync();
        }
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_role != LiveRole.None && !_focused)
        {
            _focused = true;
            try
            {
                await _keys.FocusAsync(preventScroll: true);
            }
            catch (Exception)
            {
                /* the element is not there yet */
            }
        }
    }

    private bool _focused;

    /// <summary>Takes the presenter's or a viewer's seat in a running session; no seat when nothing runs.</summary>
    private async Task AttachAsync()
    {
        var id = _loadedId;
        if (_disposed || id is null)
        {
            return;
        }
        var running = Registry.Get(id);
        if (running is null)
        {
            _role = LiveRole.None;
            _session = null;
            DropIfLiveOnly();
            return;
        }
        if (running.PresenterId == _me && Live.PresenterConnected(id, _key, _user))
        {
            _role = LiveRole.Presenter;
            _session = Registry.Get(id);
            return;
        }
        _session = await Live.JoinAsync(id, _key, _user);
        if (_disposed)
        {
            Live.Leave(id, _key);
            return;
        }
        _role = _session is null ? LiveRole.None : LiveRole.Viewer;
        _localIndex = _session?.SlideIndex ?? 0;
        _following = true;
        DropIfLiveOnly();
    }

    /// <summary>Invited when this page last looked and no more now; only then may the seat have lost its ground.</summary>
    private bool LostInvite(string presentationId)
        => _me is not null && _session?.InvitedIds.Contains(_me) == true && !Registry.IsInvited(presentationId, _me);

    /// <summary>Without a seat, an invited viewer keeps nothing of the deck.</summary>
    private void DropIfLiveOnly()
    {
        if (LiveOnly && _role == LiveRole.None)
        {
            _view = null;
        }
    }

    private void Detach()
    {
        if (_loadedId is null)
        {
            return;
        }
        if (_role == LiveRole.Presenter)
        {
            Live.PresenterDisconnected(_loadedId, _key);
        }
        else if (_role == LiveRole.Viewer)
        {
            Live.Leave(_loadedId, _key);
        }
        _role = LiveRole.None;
        _session = null;
        _focused = false;
    }

    private PresentationSlide? SlideAt(int index)
        => _view is null || _view.Slides.Count == 0 ? null : _view.Slides[Math.Clamp(index, 0, _view.Slides.Count - 1)];

    private async Task StartAsync()
    {
        _busy = true;
        try
        {
            await Live.StartAsync(Id, _user, _toInvite);
            _toInvite = [];
            _ended = false;
            await AttachAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task GoAsync(int index)
    {
        if (_role != LiveRole.Presenter || _view is null)
        {
            return Task.CompletedTask;
        }
        try
        {
            Live.GoTo(Id, Math.Clamp(index, 0, _view.Slides.Count - 1), _user);
            _session = Registry.Get(Id) ?? _session;
        }
        catch (UnauthorizedAccessException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        return Task.CompletedTask;
    }

    private void Browse(int index)
    {
        if (_view is null || _session?.Mode != PresentationFollowMode.Free)
        {
            return;
        }
        _localIndex = Math.Clamp(index, 0, _view.Slides.Count - 1);
        // landing on the presenter's slide is following again
        _following = _localIndex == _session.SlideIndex;
    }

    private Task SetModeAsync(PresentationFollowMode mode)
    {
        try
        {
            Live.SetMode(Id, mode, _user);
            _session = Registry.Get(Id) ?? _session;
        }
        catch (UnauthorizedAccessException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        return Task.CompletedTask;
    }

    private async Task InviteAsync()
    {
        _busy = true;
        try
        {
            var added = await Live.InviteAsync(Id, _toInvite, _user);
            _toInvite = [];
            _session = Registry.Get(Id) ?? _session;
            Snackbar.Add(added == 0 ? "Niemand neu eingeladen." : $"{added} eingeladen.", added == 0 ? Severity.Info : Severity.Success);
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Uninvite(string agentId)
    {
        try
        {
            Live.Uninvite(Id, agentId, _user);
            _session = Registry.Get(Id) ?? _session;
        }
        catch (UnauthorizedAccessException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private Task EndAsync()
    {
        try
        {
            Live.End(Id, _user);
        }
        catch (UnauthorizedAccessException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        return Task.CompletedTask;
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        var forward = e.Key is "ArrowRight" or "PageDown" or " ";
        var back = e.Key is "ArrowLeft" or "PageUp";
        if (e.Key is "f" or "F")
        {
            await FullscreenAsync();
            return;
        }
        if (!forward && !back || _session is null)
        {
            return;
        }
        if (_role == LiveRole.Presenter)
        {
            await GoAsync(_session.SlideIndex + (forward ? 1 : -1));
        }
        else if (_session.Mode == PresentationFollowMode.Free)
        {
            Browse((Following ? _session.SlideIndex : _localIndex) + (forward ? 1 : -1));
        }
    }

    private async Task FullscreenAsync()
    {
        try
        {
            await Script.ToggleFullscreenAsync(_stage);
            await _keys.FocusAsync(preventScroll: true);
        }
        catch (JSDisconnectedException)
        {
            /* ignore */
        }
        catch (JSException)
        {
            /* the browser refused full screen */
        }
    }

    private void OnLiveChanged(string presentationId, PresentationLiveEvent kind)
    {
        if (presentationId != _loadedId || _disposed)
        {
            return;
        }
        _ = InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }
            try
            {
                await ApplyAsync(presentationId, kind);
                StateHasChanged();
            }
            catch (Exception)
            {
                /* the next event refreshes it */
            }
        });
    }

    private async Task ApplyAsync(string presentationId, PresentationLiveEvent kind)
    {
        if (presentationId != _loadedId)
        {
            return;
        }
        if (_view is null)
        {
            // invited while this page waited without access: the deck comes now
            if (kind is PresentationLiveEvent.Started or PresentationLiveEvent.InvitesChanged)
            {
                var invited = await Presentations.GetForLiveAsync(presentationId, _user);
                // a handler that overlapped this one may have loaded and attached already
                if (_disposed || _view is not null || invited is null)
                {
                    return;
                }
                _view = invited;
                _ended = false;
                await AttachAsync();
            }
            return;
        }
        switch (kind)
        {
            case PresentationLiveEvent.Ended:
                _ended = _role != LiveRole.None;
                _role = LiveRole.None;
                _session = null;
                _focused = false;
                DropIfLiveOnly();
                break;
            case PresentationLiveEvent.Started when _role == LiveRole.Viewer:
            case PresentationLiveEvent.InvitesChanged when _role == LiveRole.Viewer && LostInvite(presentationId):
                // also sent when the audience or the invites changed: deck and seat are checked again, so whoever
                // lost the right leaves at once and whoever now watches only by invitation keeps no notes
                var deck = await Presentations.GetForLiveAsync(presentationId, _user);
                if (_disposed)
                {
                    return;
                }
                _session = deck is null ? null : await Live.JoinAsync(presentationId, _key, _user);
                if (_disposed)
                {
                    Live.Leave(presentationId, _key);
                    return;
                }
                if (_session is null)
                {
                    Live.Leave(presentationId, _key);
                    _role = LiveRole.None;
                    _view = deck is { LiveInviteOnly: false } ? deck : null;
                }
                else
                {
                    _view = deck;
                }
                break;
            case PresentationLiveEvent.SlidesChanged:
                var fresh = await Presentations.GetForLiveAsync(presentationId, _user);
                if (_disposed)
                {
                    return;
                }
                if (fresh is null)
                {
                    // the deck is gone or no longer visible: give the seat back
                    Detach();
                    _view = null;
                    break;
                }
                _view = fresh;
                if (_role == LiveRole.Presenter && _session is not null && fresh.Slides.Count > 0
                    && _session.SlideIndex >= fresh.Slides.Count)
                {
                    await GoAsync(fresh.Slides.Count - 1);
                }
                _localIndex = Math.Min(_localIndex, Math.Max(0, fresh.Slides.Count - 1));
                break;
            case PresentationLiveEvent.Started when _role == LiveRole.None:
                _ended = false;
                await AttachAsync();
                break;
            case PresentationLiveEvent.ModeChanged:
                _session = Registry.Get(presentationId) ?? _session;
                if (_session?.Mode == PresentationFollowMode.Strict)
                {
                    _following = true;
                }
                else if (_session is not null)
                {
                    _localIndex = _session.SlideIndex;
                }
                break;
            default:
                if (_role != LiveRole.None)
                {
                    _session = Registry.Get(presentationId) ?? _session;
                }
                break;
        }
    }

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        Broadcaster.Changed -= OnLiveChanged;
        Detach();
        return ValueTask.CompletedTask;
    }
}
