@* Linked people and organisations. Rows below 600px (noose-eintrag-*): icon and name beside the button, the label
   chip on a line of its own. *@
@inject ILinkService LinkService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="noose-kopf-umbruch">
        <MudText Typo="Typo.subtitle1">Verknüpfte Personen &amp; Organisationen (@_list.Count)</MudText>
        @if (_mayWrite)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddLink" OnClick="AddAsync">
                Verknüpfung hinzufügen
            </MudButton>
        }
    </MudStack>

    @if (_load)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_list.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Noch keine Verknüpfungen erfasst. (Agents werden im Tab „Zugeteilte Agents" zugeteilt.)
        </MudText>
    }
    else
    {
        @foreach (var v in _list)
        {
            <MudPaper Class="pa-3" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="noose-eintrag">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="noose-eintrag noose-eintrag-titel">
                        <MudIcon Icon="@TypeIcon(v.OtherType)" Color="Color.Primary" Size="Size.Small" />
                        @if (v.Href is not null)
                        {
                            <MudLink Href="@v.Href" Typo="Typo.body2"><b>@v.OtherDesignation</b></MudLink>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2"><b>@v.OtherDesignation</b></MudText>
                        }
                        @if (!string.IsNullOrWhiteSpace(v.Label))
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="noose-eintrag-chips">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">@v.Label</MudChip>
                            </MudStack>
                        }
                    </MudStack>
                    @if (_mayWrite)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => RemoveAsync(v))" aria-label="Verknüpfung entfernen" />
                    }
                </MudStack>
            </MudPaper>
        }
    }
</MudStack>

@code {

    /// <summary>The types this panel offers; the same list goes to the picker and to the service.</summary>
    // qualified: the injected property shadows the class name
    private static readonly IReadOnlyList<string> OrgTypes = NOOSE_Website.Services.LinkService.InvolvedTypes;
    [Parameter, EditorRequired] public string TaskforceId { get; set; } = default!;
    [Parameter, EditorRequired] public ClaimsPrincipal User { get; set; } = default!;

    private bool _load = true;
    private bool _mayWrite;
    private List<LinkDisplay> _list = new();

    protected override async Task OnInitializedAsync()
    {
        _mayWrite = User.MayWrite();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _load = true;
        // partner-scoped: parent visibility + the "other side" is filtered to what the viewer may see
        _list = await LinkService.GetForRecordAsync(nameof(Taskforce), TaskforceId, ViewerScope.From(User), LinkKind.Default);
        _load = false;
    }

    private async Task AddAsync()
    {
        // Exclude already-linked targets and self
        var choice = await LinkDialog.ShowAsync(DialogService, User.IsLeadership(),
            allowedTypes: OrgTypes,
            excluded: LinkDialog.Exclusions(_list, nameof(Taskforce), TaskforceId),
            designation: "Verknüpfung",
            labelCaption: "Notiz (optional)",
            labelPlaceholder: "z. B. Zielperson, Zeuge, beteiligte Bande");
        if (choice is null)
        {
            return;
        }
        try
        {
            await LinkService.CreateAsync(nameof(Taskforce), TaskforceId, choice.TargetType, choice.TargetId, choice.Label, User, LinkKind.Default,
                allowedTargetTypes: OrgTypes);
            Snackbar.Add("Verknüpfung gespeichert.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RemoveAsync(LinkDisplay v)
    {
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Verknüpfung entfernen?",
            $"Die Beziehung zu „{v.OtherDesignation}“ wird entfernt.");
        if (!ok)
        {
            return;
        }
        await LinkService.RemoveAsync(v.LinkId, User);
        Snackbar.Add("Verknüpfung entfernt.", Severity.Success);
        await LoadAsync();
    }

    private static string TypeIcon(string type) => RecordTypeDisplay.Icon(type);
}
