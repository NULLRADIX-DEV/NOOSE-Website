<MudGrid>
    <MudItem xs="12">
        <MudTextField @bind-Value="Input.Name" Label="Name" Required="true" RequiredError="Name ist erforderlich"
                      Variant="Variant.Outlined" />
    </MudItem>

    <MudItem xs="12" md="6">
        <MudSelect T="TaskforceScope" @bind-Value="Input.Scope" Label="Geltungsbereich" Variant="Variant.Outlined">
            @foreach (var b in TaskforceScopeDisplay.All)
            {
                <MudSelectItem Value="b">@TaskforceScopeDisplay.Name(b)</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    @if (Input.Scope == TaskforceScope.CrossAgency)
    {
        <MudItem xs="12">
            <MudSelect T="PartnerAgency" SelectedValues="Input.PartnerAgencies" SelectedValuesChanged="@(v => Input.PartnerAgencies = v.ToList())"
                       MultiSelection="true" Label="Beteiligte Partnerbehörden" Variant="Variant.Outlined"
                       HelperText="Nur Behörden, die hier eingetragen sind, können an Ermittlungen dieser Taskforce beteiligt werden. Die Leitung einer Einheit mit entsprechender Einstellung (z. B. SID) sieht dann alles in dieser Taskforce.">
                @foreach (var agency in PartnerAgencyDisplay.All)
                {
                    <MudSelectItem T="PartnerAgency" Value="agency">@PartnerAgencyDisplay.Name(agency) · @PartnerAgencyDisplay.LongName(agency)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    }
    <MudItem xs="12" md="6" Class="d-flex flex-column justify-center">
        <MudSwitch T="bool" @bind-Value="Input.IsClassified" Color="Color.Warning"
                   Label="Verschlusssache (nur Führung sichtbar)" />
        @if (Input.IsClassified && !IsLeadership)
        {
            <MudText Typo="Typo.caption" Color="Color.Warning">
                Achtung: Du verlierst als Nicht-Führung nach dem Speichern selbst den Zugriff auf diese Akte.
            </MudText>
        }
    </MudItem>

    <MudItem xs="12">
        <MentionInput Text="@(Input.Purpose ?? string.Empty)" TextChanged="@(v => Input.Purpose = v)"
                      DraftKey='@DraftKeys.In(DraftScope, "purpose")'
                      Label="Sinn / Zweck" Lines="4"
                      HelperText="@($"Auftrag und Ziel der Taskforce. {MentionInput.Hint}")" />
    </MudItem>
    <MudItem xs="12">
        <MentionInput Text="@(Input.Remarks ?? string.Empty)" TextChanged="@(v => Input.Remarks = v)"
                      DraftKey='@DraftKeys.In(DraftScope, "remarks")'
                      Label="Bemerkungen" Lines="3" HelperText="Interne Vermerke." />
    </MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired] public TaskforceInput Input { get; set; } = default!;
    /// <summary>Browser draft scope of the text fields; the editor drops it once the save went through.</summary>
    [Parameter] public string? DraftScope { get; set; }

    [Parameter] public bool IsLeadership { get; set; }
}
