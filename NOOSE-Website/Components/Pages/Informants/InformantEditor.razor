@page "/informanten/neu"
@page "/informanten/{Id}/bearbeiten"
@attribute [Authorize(Policy = Policies.InternalAgent)]
@using NOOSE_Website.Models.Enums
@using NOOSE_Website.Models.Informants
@inject IInformantService Service
@inject IPersonService PersonService
@inject IFactionService FactionService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>@(_isNew ? "Neuer Informant" : "Informant bearbeiten") · FIB</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.VisibilityOff"
            Title="@(_isNew ? "Neuer Informant" : "Informant bearbeiten")"
            BackHref="@(_isNew ? "/informanten" : $"/informanten/{Id}")" />

@if (_forbidden)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">Keine Berechtigung.</MudAlert>
}
else if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudPaper Class="pa-4" Elevation="1" Style="max-width:720px;">
        <MudGrid>
            <MudItem xs="12">
                <MudAutocomplete T="Person" Label="Personenakte verknüpfen (optional)" Value="_person" ValueChanged="PersonChanged"
                                 SearchFunc="@SearchPeople" ToStringFunc="@(p => p?.Name ?? string.Empty)"
                                 Clearable="true" CoerceText="false" CoerceValue="false"
                                 ResetValueOnEmptyText="true" MinCharacters="0" Immediate="true"
                                 Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.PersonSearch"
                                 HelperText="Ist eine Akte verknüpft, ist deren Name der Klarname des Informanten.">
                    <ItemTemplate Context="p">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" Color="Color.Primary" />
                            <MudText Typo="Typo.body2">@p.Name</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@p.CaseNumber</MudText>
                        </MudStack>
                    </ItemTemplate>
                </MudAutocomplete>
            </MudItem>
            <MudItem xs="12">
                <MudAutocomplete T="Faction" Label="Fraktion verknüpfen (optional)" @bind-Value="_faction"
                                 SearchFunc="@SearchFactions" ToStringFunc="@(f => f?.Name ?? string.Empty)"
                                 Clearable="true" CoerceText="false" CoerceValue="false"
                                 ResetValueOnEmptyText="true" MinCharacters="0" Immediate="true"
                                 Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Groups"
                                 HelperText="Fraktion, zu der der Informant Zugang hat.">
                    <ItemTemplate Context="f">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" Color="Color.Primary" />
                            <MudText Typo="Typo.body2">@f.Name</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@f.CaseNumber</MudText>
                        </MudStack>
                    </ItemTemplate>
                </MudAutocomplete>
            </MudItem>
            <MudItem xs="12" sm="6">
                @if (_person is not null)
                {
                    <MudTextField Value="@_person.Name" Label="Klarname (aus der Personenakte)" ReadOnly="true"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Link" />
                }
                else
                {
                    <MudTextField @bind-Value="_realName" Label="Klarname" Required="true"
                                  HelperText="Informanten haben keinen Decknamen." />
                }
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="InformantReliability" @bind-Value="_reliability" Label="Zuverlässigkeit">
                    @foreach (var r in Enum.GetValues<InformantReliability>())
                    {
                        <MudSelectItem T="InformantReliability" Value="@r">@InformantEnumDisplay.Reliability(r)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="InformantStatus" @bind-Value="_status" Label="Status">
                    @foreach (var s in Enum.GetValues<InformantStatus>())
                    {
                        <MudSelectItem T="InformantStatus" Value="@s">@InformantEnumDisplay.Status(s)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MentionInput @bind-Text="_description" Label="Beschreibung" Lines="2" HelperText="@MentionInput.Hint"
                              DraftKey='@DraftKeys.In(DraftScope, "beschreibung")' />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" @bind-Value="_handlerId" Label="Führungsagent" Required="true"
                           HelperText="Wer die Quelle führt — jeder Agent darf das ändern.">
                    @foreach (var h in _handlers)
                    {
                        <MudSelectItem T="string" Value="@h.Id">@h.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-4" />
        <MudText Typo="Typo.subtitle2" Class="mb-1">Kontakt</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_contact" Label="Kontakt" />
            </MudItem>
            <MudItem xs="12">
                <MentionInput @bind-Text="_notes" Label="Notizen" Lines="2" HelperText="@MentionInput.Hint"
                              DraftKey='@DraftKeys.In(DraftScope, "notizen")' />
            </MudItem>
        </MudGrid>

        <FormActions Justify="Justify.FlexStart" Class="mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveAsync" Disabled="_saving">Speichern</MudButton>
        </FormActions>
    </MudPaper>
}

@code {
    [Parameter] public string? Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private ClaimsPrincipal _user = default!;

    // one scope for every text field of the page; dropped once the save went through
    private string DraftScope => string.IsNullOrEmpty(Id) ? "informant:neu" : $"informant:{Id}";
    private bool _load = true;
    private bool _forbidden;
    private bool _isNew;
    private bool _saving;
    private List<InformantHandlerOption> _handlers = new();

    private string? _realName;
    private Person? _person;
    private Faction? _faction;
    private string? _description;
    private InformantReliability _reliability = InformantReliability.C;
    private InformantStatus _status = InformantStatus.Active;
    private string _handlerId = string.Empty;
    private string? _contact;
    private string? _notes;

    private string _loadedKey = " ";

    protected override async Task OnParametersSetAsync()
    {
        var key = Id ?? string.Empty;
        if (key == _loadedKey)
        {
            return;
        }
        _loadedKey = key;
        _load = true;
        _forbidden = false;
        _user = (await AuthStateTask).User;
        _isNew = string.IsNullOrEmpty(Id);
        if (_user.MayWrite())
        {
            _handlers = await Service.GetHandlerOptionsAsync(_user);
        }

        // reset every field first: a reused instance must never carry a prior informant (incl. contact) into /neu
        _realName = null;
        _person = null;
        _faction = null;
        _description = null;
        _reliability = InformantReliability.C;
        _status = InformantStatus.Active;
        _handlerId = string.Empty;
        _contact = null;
        _notes = null;

        if (_isNew)
        {
            if (!_user.MayWrite())
            {
                _forbidden = true;
                _load = false;
                return;
            }
            _handlerId = _user.GetAgentId() ?? string.Empty;
        }
        else
        {
            var d = await Service.GetDetailAsync(Id!, _user);
            if (d is null || !d.MayEdit)
            {
                _forbidden = true;
                _load = false;
                return;
            }
            _description = d.Description;
            _reliability = d.Reliability;
            _status = d.Status;
            _handlerId = d.HandlerId;
            // a handler who left the roster is no longer offered — carry them in so the field is not blank.
            // An empty id means the account was deleted: no option to carry, or the picker grows a blank row.
            if (_handlerId.Length > 0 && _handlers.All(h => h.Id != d.HandlerId))
            {
                _handlers.Add(new InformantHandlerOption(d.HandlerId, d.HandlerName ?? d.HandlerId));
            }
            _contact = d.ContactInfo;
            _notes = d.Notes;
            // the pickers only need id/name/case number — no point loading the whole record
            if (d.PersonId is not null)
            {
                _person = new Person { Id = d.PersonId, Name = d.PersonName ?? d.Name, CaseNumber = d.PersonCaseNumber ?? string.Empty };
            }
            if (d.FactionId is not null)
            {
                _faction = new Faction { Id = d.FactionId, Name = d.FactionName ?? string.Empty };
            }
            _realName = _person is null ? d.Name : null;
        }
        _load = false;
    }

    // Unlinking pre-fills the free-text field so the informant does not silently lose its name.
    private void PersonChanged(Person? person)
    {
        if (person is null && _person is not null && string.IsNullOrWhiteSpace(_realName))
        {
            _realName = _person.Name;
        }
        _person = person;
    }

    private async Task<IEnumerable<Person>> SearchPeople(string value, CancellationToken token)
        => await PersonService.SearchAsync(value, _user.MayClassifiedRead(), 20, token);

    private async Task<IEnumerable<Faction>> SearchFactions(string value, CancellationToken token)
        => await FactionService.SearchAsync(value, _user.MayClassifiedRead(), 20, token);

    private async Task SaveAsync()
    {
        _saving = true;
        var input = new InformantInput(_person is null ? _realName : null, _person?.Id, _faction?.Id,
            _description, _reliability, _status, _handlerId, _contact, _notes);
        try
        {
            if (_isNew)
            {
                var newId = await Service.CreateAsync(input, _user);
                await TextDraft.DiscardScopeAsync(JS, _user.GetAgentId(), DraftScope);
                Nav.NavigateTo($"/informanten/{newId}");
            }
            else
            {
                await Service.UpdateAsync(Id!, input, _user);
                await TextDraft.DiscardScopeAsync(JS, _user.GetAgentId(), DraftScope);
                Nav.NavigateTo($"/informanten/{Id}");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _saving = false;
        }
    }
}
