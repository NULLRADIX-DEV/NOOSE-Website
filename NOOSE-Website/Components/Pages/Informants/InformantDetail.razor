@page "/informanten/{Id}"
@attribute [Authorize(Policy = Policies.InternalAgent)]
@using NOOSE_Website.Models.Enums
@using NOOSE_Website.Models.Informants
@using NOOSE_Website.Components.Pages.Informants.Shared
@using NOOSE_Website.Data.Entities.Informants
@inject IInformantService Service
@inject IAccessLogService AccessLog
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>@Label · FIB</PageTitle>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_detail is null)
{
    <PageHeader Icon="@Icons.Material.Filled.VisibilityOff" Title="Informant" BackHref="/informanten" />
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Nicht gefunden oder kein Zugriff.</MudAlert>
}
else
{
    <PageHeader Icon="@Icons.Material.Filled.VisibilityOff"
                Title="@Label"
                Subtitle="@($"{_detail.CaseNumber} · V-Person · {InformantEnumDisplay.Status(_detail.Status)}")"
                BackHref="/informanten" MoreActionsLast="true">
        <Actions>
            @if (_detail.MayEdit)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                           Href="@($"/informanten/{Id}/bearbeiten")">Bearbeiten</MudButton>
            }
        </Actions>
        @* deleting is behind the same MayEdit check as a button and as a menu entry *@
        <MoreActions>
            @if (_detail.MayEdit)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="DeleteAsync">Löschen</MudButton>
            }
        </MoreActions>
        <MoreActionsMenu>
            @if (_detail.MayEdit)
            {
                <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="DeleteAsync">Löschen</MudMenuItem>
            }
        </MoreActionsMenu>
    </PageHeader>

    <RecordSectionRail>
        <RecordSection Slug="uebersicht" Label="Übersicht" Icon="@Icons.Material.Filled.Info">
            <MudSimpleTable Dense="true" Elevation="0">
                <tbody>
                    <tr><td class="informant-feld" style="width:12rem;">Status</td><td>@InformantEnumDisplay.Status(_detail.Status)</td></tr>
                    <tr><td>Zuverlässigkeit</td><td>@InformantEnumDisplay.Reliability(_detail.Reliability)</td></tr>
                    <tr><td>Führungsagent</td><td>@(_detail.HandlerName ?? "—")</td></tr>
                    <tr>
                        <td>Personenakte</td>
                        <td>
                            @if (_detail.PersonId is not null)
                            {
                                <MudLink Href="@($"/personen/{_detail.PersonId}")">@_detail.PersonName (@_detail.PersonCaseNumber)</MudLink>
                            }
                            else
                            {
                                <text>— nicht verknüpft</text>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td>Fraktion</td>
                        <td>
                            @if (_detail.FactionId is not null)
                            {
                                <MudLink Href="@($"/fraktionen/{_detail.FactionId}")">@_detail.FactionName</MudLink>
                            }
                            else
                            {
                                <text>— nicht verknüpft</text>
                            }
                        </td>
                    </tr>
                    <tr><td>Beschreibung</td><td><MentionDisplay Text="@(_detail.Description ?? "—")" /></td></tr>
                    <tr><td>Kontakt</td><td>@(_detail.ContactInfo ?? "—")</td></tr>
                    <tr><td>Notizen</td><td><MentionDisplay Text="@(_detail.Notes ?? "—")" /></td></tr>
                </tbody>
            </MudSimpleTable>
        </RecordSection>

        <RecordSection Slug="treffen" Label="Treffen" Icon="@Icons.Material.Filled.Forum">
            <InformantMeetingPanel InformantId="@Id" MayWrite="_detail.MayEdit" User="_user" />
        </RecordSection>
    </RecordSectionRail>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private ClaimsPrincipal _user = default!;
    private bool _load = true;
    private string _loadedId = string.Empty;
    private InformantDisplay? _detail;

    private string Label => _detail?.Name ?? "Informant";

    protected override async Task OnParametersSetAsync()
    {
        if (Id == _loadedId)
        {
            return;
        }
        _loadedId = Id;
        _load = true;
        _user = (await AuthStateTask).User;
        _detail = await Service.GetDetailAsync(Id, _user);
        _load = false;
        if (_detail is not null)
        {
            // open to every internal agent now, so who looked is worth keeping
            await AccessLog.LogViewAsync(nameof(Informant), Id);
        }
    }

    private async Task DeleteAsync()
    {
        if (_detail is null)
        {
            return;
        }
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Informant löschen?",
            "Die Akte wird in den Papierkorb verschoben und kann von der Führung wiederhergestellt werden.");
        if (!ok)
        {
            return;
        }
        try
        {
            await Service.DeleteAsync(Id, _user);
            Snackbar.Add("Informant in den Papierkorb verschoben.", Severity.Success);
            Nav.NavigateTo("/informanten");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
