@inject IAbsenceService AbsenceService
@inject IDialogService DialogService
@inject ISnackbar Snackbar


<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4 noose-kopf-umbruch">
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        Für einen Zeitraum abmelden. Wer abgemeldet ist, gilt bei Besprechungen automatisch als entschuldigt.
    </MudText>
    <AuthorizeView Policy="@Policies.WriteAccess">
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="CreateAsync">Abmelden</MudButton>
    </AuthorizeView>
</MudStack>

<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="false" Class="mb-3 noose-reiter-handy"
         ActivePanelIndex="_tab" ActivePanelIndexChanged="TabChangedAsync">
    <MudTabPanel Icon="@Icons.Material.Filled.EventBusy" IconColor="Color.Primary" Text="Meine Abmeldungen" />
    <MudTabPanel Icon="@Icons.Material.Filled.Groups" IconColor="Color.Info" Text="Team" />
</MudTabs>

@if (_tab == 0)
{
    @if (_load)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_list.Count == 0)
    {
        <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined">
            Du hast dich bisher nicht abgemeldet.
        </MudAlert>
    }
    else
    {
        @* a table on phones too: period, reason and the actions stay below 600px *@
        <MudTable Items="_list" Dense="true" Hover="true" Breakpoint="Breakpoint.None" Elevation="1">
            <HeaderContent>
                <MudTh>Zeitraum</MudTh>
                <MudTh Class="noose-mobil-aus">Tage</MudTh>
                <MudTh>Grund</MudTh>
                <MudTh Class="noose-mobil-aus">Anmerkung</MudTh>
                <MudTh Class="noose-mobil-aus">Kenntnisnahme</MudTh>
                <MudTh Style="width:110px;"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Zeitraum">
                    <b>@context.FromDate.ToString("dd.MM.yyyy")</b>
                    @if (context.ToDate != context.FromDate)
                    {
                        <text> – <b>@context.ToDate.ToString("dd.MM.yyyy")</b></text>
                    }
                </MudTd>
                <MudTd DataLabel="Tage" Class="noose-mobil-aus">@context.Days</MudTd>
                <MudTd DataLabel="Grund"><AbsenceCategoryChip Category="@context.Category" /></MudTd>
                <MudTd DataLabel="Anmerkung" Class="noose-mobil-aus">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @if (context.Reason is null)
                        {
                            <text>—</text>
                        }
                        else
                        {
                            <MentionDisplay Text="@context.Reason" />
                        }
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Kenntnisnahme" Class="noose-mobil-aus">
                    @if (context.AcknowledgedAt is { } at)
                    {
                        <MudTooltip Text="@($"Durch {context.AcknowledgedByName ?? "die Führung"} am {at.ToLocalTime():dd.MM.yyyy HH:mm}")">
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined"
                                     Icon="@Icons.Material.Filled.CheckCircle">Erfolgt</MudChip>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">Offen</MudChip>
                    }
                </MudTd>
                <MudTd>
                    @if (context.MayEdit)
                    {
                        <AuthorizeView Policy="@Policies.WriteAccess" Context="write">
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                           OnClick="@(() => EditAsync(context))" aria-label="Abmeldung bearbeiten" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => DeleteAsync(context))" aria-label="Abmeldung löschen" />
                        </AuthorizeView>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3 flex-wrap">
        @if (!_teamLoad)
        {
            <MudIcon Icon="@Icons.Material.Filled.Today" Color="Color.Primary" Size="Size.Small" />
            <MudText Typo="Typo.body2">
                @if (_todayNames.Count == 0)
                {
                    <text>Heute ist niemand abgemeldet.</text>
                }
                else
                {
                    <text>Heute abgemeldet: <b>@string.Join(" · ", _todayNames)</b></text>
                }
            </MudText>
        }
        <MudSpacer />
        <MudSwitch T="bool" Value="_withPast" ValueChanged="PastToggledAsync" Color="Color.Primary"
                   Label="Auch vergangene anzeigen" />
    </MudStack>

    @if (_teamLoad)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_team is null || _team.Count == 0)
    {
        <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined">
            @(_withPast ? "Es liegen keine Abmeldungen vor." : "Aktuell ist niemand abgemeldet.")
        </MudAlert>
    }
    else
    {
        @* a table on phones too: agent and period; days and reason are hidden below 600px *@
        <MudTable Items="_team" Dense="true" Hover="true" Breakpoint="Breakpoint.None" Elevation="1" T="AbsenceRow">
            <HeaderContent>
                <MudTh>Agent</MudTh>
                <MudTh>Zeitraum</MudTh>
                <MudTh Class="noose-mobil-aus">Tage</MudTh>
                <MudTh Class="noose-mobil-aus">Grund</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Agent"><b>@context.Codename</b></MudTd>
                <MudTd DataLabel="Zeitraum">
                    @context.FromDate.ToString("dd.MM.yyyy")
                    @if (context.ToDate != context.FromDate)
                    {
                        <text> – @context.ToDate.ToString("dd.MM.yyyy")</text>
                    }
                </MudTd>
                <MudTd DataLabel="Tage" Class="noose-mobil-aus">@context.Days</MudTd>
                <MudTd DataLabel="Grund" Class="noose-mobil-aus"><AbsenceCategoryChip Category="@context.Category" /></MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private ClaimsPrincipal _user = default!;
    private List<AbsenceRow> _list = new();
    private bool _load = true;
    private int _tab;

    // null until the team tab is opened for the first time
    private List<AbsenceRow>? _team;
    private List<string> _todayNames = new();
    private bool _teamLoad;
    private bool _withPast;

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask!).User;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _load = true;
        // own list only; the team roster lives on the second tab
        _list = await AbsenceService.GetListAsync(_user, AbsenceViewScope.Own);
        _load = false;
    }

    private async Task TabChangedAsync(int index)
    {
        _tab = index;
        // the team list is fetched on first visit, not on page load
        if (index == 1 && _team is null)
        {
            await TeamLoadAsync();
        }
    }

    private async Task PastToggledAsync(bool value)
    {
        _withPast = value;
        await TeamLoadAsync();
    }

    private async Task TeamLoadAsync()
    {
        _teamLoad = true;
        var today = MeetingTime.Day(DateTime.UtcNow);
        // running and upcoming by default; the switch drops the window
        _team = await AbsenceService.GetListAsync(_user, AbsenceViewScope.Team, _withPast ? null : today);
        _todayNames = _team.Where(a => a.FromDate <= today && a.ToDate >= today)
            .Select(a => a.Codename)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(n => n, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
        _teamLoad = false;
    }

    private async Task CreateAsync()
    {
        var input = await AbsenceDialog.ShowAsync(DialogService);
        if (input is null)
        {
            return;
        }
        await RunAsync(async () =>
        {
            await AbsenceService.CreateAsync(input, _user);
            Snackbar.Add("Abmeldung eingetragen.", Severity.Success);
        });
    }

    private async Task EditAsync(AbsenceRow row)
    {
        var input = await AbsenceDialog.ShowAsync(DialogService, "Abmeldung bearbeiten",
            row.FromDate.ToDateTime(TimeOnly.MinValue), row.ToDate.ToDateTime(TimeOnly.MinValue),
            row.Category, row.Reason);
        if (input is null)
        {
            return;
        }
        await RunAsync(async () =>
        {
            await AbsenceService.RefreshAsync(row.Id, input, _user);
            Snackbar.Add("Abmeldung geändert.", Severity.Success);
        });
    }

    private async Task DeleteAsync(AbsenceRow row)
    {
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Abmeldung löschen?",
            $"Die Abmeldung vom {row.FromDate:dd.MM.yyyy} bis {row.ToDate:dd.MM.yyyy} wird in den Papierkorb verschoben.");
        if (!ok)
        {
            return;
        }
        await RunAsync(async () =>
        {
            await AbsenceService.DeleteAsync(row.Id, _user);
            Snackbar.Add("Abmeldung gelöscht.", Severity.Success);
        });
    }

    /// <summary>Runs a write and surfaces the service's German message instead of a circuit error.</summary>
    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
            await LoadAsync();
            // own change invalidates the cached roster
            _team = null;
            if (_tab == 1)
            {
                await TeamLoadAsync();
            }
        }
        catch (UnauthorizedAccessException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }
}
