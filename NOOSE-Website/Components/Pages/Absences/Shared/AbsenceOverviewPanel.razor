@using NOOSE_Website.Services.Statistics
@inject IAttendanceStatisticsService StatisticsService
@inject IAbsenceService AbsenceService
@inject ISnackbar Snackbar


<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Wer meldet sich wie oft ab, und wer fehlt unentschuldigt.
</MudText>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_report is { } r)
{
    <MudGrid Spacing="3" Class="mb-2">
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Bewertete Besprechungen</MudText>
                <MudText Typo="Typo.h5">@r.MeetingsEvaluated</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Offene Kenntnisnahmen</MudText>
                <MudText Typo="Typo.h5">@r.AbsencesOpenAcknowledgement</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Auffällig</MudText>
                <MudText Typo="Typo.h5">@r.Anomalies.Count</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Fenster</MudText>
                <MudText Typo="Typo.h5">@r.WindowSize</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    gelb ab @r.YellowThreshold, rot ab @r.RedThreshold
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="3" Class="mb-2">
        <MudItem xs="12" md="6" Class="d-flex">
            <DistributionChart Title="Anwesenheit im Fenster" Segments="@r.AttendanceDistribution"
                               Colours="_coloursAttendance" Height="260px" />
        </MudItem>
        <MudItem xs="12" md="6" Class="d-flex">
            <DistributionChart Title="Abmeldungen nach Grund" Segments="@r.AbsencesByCategory"
                               Colours="_coloursCategory" Height="260px" />
        </MudItem>
        <MudItem xs="12">
            <TimeSeriesChart Title="Verlauf (12 Monate)" Points="@r.TimeSeries" Rows="_rows"
                             Colours="_coloursSeries" Height="280px" DiagramType="ChartType.Line" />
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-2">Auffälligkeiten</MudText>
        @if (r.Anomalies.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Kein Agent überschreitet die Schwellen. Agenten mit weniger als @r.WindowSize bewerteten
                Besprechungen werden bewusst nie markiert.
            </MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true" Striped="false">
                <thead>
                    <tr>
                        <th style="width:32px;"></th>
                        <th>Agent</th>
                        @* phones keep the level dot, the agent, the unexcused count and the level *@
                        <th class="noose-mobil-aus">Bewertet</th>
                        <th class="noose-mobil-aus">Anwesend</th>
                        <th class="noose-mobil-aus">Abgemeldet</th>
                        <th>Unentschuldigt</th>
                        <th>Stufe</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in r.Anomalies)
                    {
                        <tr>
                            <td>
                                <span style="@($"display:inline-block;width:10px;height:10px;border-radius:50%;background:{AttendanceAnomalyLevelDisplay.Colour(a.Level)};")"></span>
                            </td>
                            <td><MudLink Href="@a.Href"><b>@a.Codename</b></MudLink></td>
                            <td class="noose-mobil-aus">@a.Evaluated</td>
                            <td class="noose-mobil-aus">@a.Present</td>
                            <td class="noose-mobil-aus">@a.Excused</td>
                            <td><b>@a.Missing</b></td>
                            <td>@AttendanceAnomalyLevelDisplay.Name(a.Level)</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-2">Anwesenheit je Agent</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            Über die letzten @r.WindowSize abgeschlossenen Besprechungen.
        </MudText>
        @* a table on phones too: agent, unexcused and level; the other counts are hidden below 600px *@
        <MudTable Items="r.AllAgents" Dense="true" Hover="true" Breakpoint="Breakpoint.None" Elevation="0"
                  T="AttendanceAgentRow" SortLabel="Sortieren">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<AttendanceAgentRow, object>(a => a.Codename)">Agent</MudTableSortLabel></MudTh>
                <MudTh Class="noose-mobil-aus"><MudTableSortLabel SortBy="new Func<AttendanceAgentRow, object>(a => a.Evaluated)">Bewertet</MudTableSortLabel></MudTh>
                <MudTh Class="noose-mobil-aus"><MudTableSortLabel SortBy="new Func<AttendanceAgentRow, object>(a => a.Present)">Anwesend</MudTableSortLabel></MudTh>
                <MudTh Class="noose-mobil-aus"><MudTableSortLabel SortBy="new Func<AttendanceAgentRow, object>(a => a.Excused)">Abgemeldet</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<AttendanceAgentRow, object>(a => a.Missing)" InitialDirection="SortDirection.Descending">Unentschuldigt</MudTableSortLabel></MudTh>
                <MudTh>Stufe</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Agent"><MudLink Href="@context.Href"><b>@context.Codename</b></MudLink></MudTd>
                <MudTd DataLabel="Bewertet" Class="noose-mobil-aus">@context.Evaluated</MudTd>
                <MudTd DataLabel="Anwesend" Class="noose-mobil-aus">@context.Present</MudTd>
                <MudTd DataLabel="Abgemeldet" Class="noose-mobil-aus">@context.Excused</MudTd>
                <MudTd DataLabel="Unentschuldigt"><b>@context.Missing</b></MudTd>
                <MudTd DataLabel="Stufe">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <span style="@($"display:inline-block;width:10px;height:10px;border-radius:50%;background:{AttendanceAnomalyLevelDisplay.Colour(context.Level)};")"></span>
                        <MudText Typo="Typo.caption">@AttendanceAnomalyLevelDisplay.Name(context.Level)</MudText>
                    </MudStack>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

    <MudPaper Class="pa-4" Elevation="1">
        <SectionHeader Title="Alle Abmeldungen" Class="mb-3">
            <Actions>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    @* the Papierkorb button is gone: it is a sibling section of this panel now *@
                    <MudSwitch T="bool" @bind-Value="_onlyOpen" @bind-Value:after="Filter"
                               Color="Color.Primary" Label="Nur offene Kenntnisnahmen" />
                </MudStack>
            </Actions>
        </SectionHeader>

        @if (_shown.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Keine Abmeldungen im gewählten Filter.</MudText>
        }
        else
        {
            @* a table on phones too: agent, period and the acknowledgement action stay below 600px *@
            <MudTable Items="_shown" Dense="true" Hover="true" Breakpoint="Breakpoint.None" Elevation="0" T="AbsenceRow">
                <HeaderContent>
                    <MudTh>Agent</MudTh>
                    <MudTh>Zeitraum</MudTh>
                    <MudTh Class="noose-mobil-aus">Tage</MudTh>
                    <MudTh Class="noose-mobil-aus">Grund</MudTh>
                    <MudTh Class="noose-mobil-aus">Anmerkung</MudTh>
                    <MudTh>Kenntnisnahme</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Agent"><b>@context.Codename</b></MudTd>
                    <MudTd DataLabel="Zeitraum">
                        @context.FromDate.ToString("dd.MM.yyyy")
                        @if (context.ToDate != context.FromDate)
                        {
                            <text> – @context.ToDate.ToString("dd.MM.yyyy")</text>
                        }
                    </MudTd>
                    <MudTd DataLabel="Tage" Class="noose-mobil-aus">@context.Days</MudTd>
                    <MudTd DataLabel="Grund" Class="noose-mobil-aus"><AbsenceCategoryChip Category="@context.Category" /></MudTd>
                    <MudTd DataLabel="Anmerkung" Class="noose-mobil-aus">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            @if (context.Reason is null)
                            {
                                <text>—</text>
                            }
                            else
                            {
                                <MentionDisplay Text="@context.Reason" />
                            }
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Kenntnisnahme">
                        @if (context.AcknowledgedAt is { } at)
                        {
                            <MudTooltip Text="@($"{context.AcknowledgedByName ?? "Führung"} am {at.ToLocalTime():dd.MM.yyyy HH:mm}")">
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined"
                                         Icon="@Icons.Material.Filled.CheckCircle">Erfolgt</MudChip>
                            </MudTooltip>
                        }
                        else
                        {
                            <AuthorizeView Policy="@Policies.WriteAccess" Context="write">
                                <Authorized>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                               StartIcon="@Icons.Material.Filled.Check"
                                               OnClick="@(() => AcknowledgeAsync(context))">Zur Kenntnis</MudButton>
                                </Authorized>
                                <NotAuthorized>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Offen</MudChip>
                                </NotAuthorized>
                            </AuthorizeView>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    // colour order must match each *Display.All order for a stable legend
    private static readonly string[] _coloursAttendance = { "#3FB950", "#D29922", "#F85149" };
    private static readonly string[] _coloursCategory = { "#8C7757", "#A3C23B", "#D29922", "#A371F7", "#9A9488" };
    private static readonly string[] _coloursSeries = { "#DB61A2", "#F85149" };

    private AttendanceReport? _report;
    private List<AbsenceRow> _all = new();
    private List<AbsenceRow> _shown = new();
    private IReadOnlyList<(string Name, IReadOnlyList<int> Values)> _rows = Array.Empty<(string, IReadOnlyList<int>)>();
    private bool _load = true;
    private bool _onlyOpen;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _load = true;
        var user = (await AuthStateTask!).User;
        _report = await StatisticsService.GetReportAsync(user);
        _rows = new (string, IReadOnlyList<int>)[]
        {
            ("Abmeldungen", _report.AbsenceCountsPerMonth),
            ("Unentschuldigt", _report.MissingCountsPerMonth),
        };
        _all = await AbsenceService.GetListAsync(user, AbsenceViewScope.All);
        Filter();
        _load = false;
    }

    private void Filter()
        => _shown = _onlyOpen ? _all.Where(a => a.AcknowledgedAt is null).ToList() : _all;

    private async Task AcknowledgeAsync(AbsenceRow row)
    {
        try
        {
            var user = (await AuthStateTask!).User;
            await AbsenceService.AcknowledgeAsync(row.Id, user);
            Snackbar.Add("Kenntnisnahme vermerkt.", Severity.Success);
            await LoadAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }
}
