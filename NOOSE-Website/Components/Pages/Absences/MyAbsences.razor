@page "/abmeldungen"
@attribute [Authorize(Policy = Policies.InternalAgent)]

<PageTitle>Abmeldungen · FIB</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.EventBusy"
            Title="Abmeldungen"
            Subtitle="Eigene Abwesenheiten melden; die Führung sieht zusätzlich die Auswertung." />

@* the last two sections neither render nor register for anyone below leadership *@
<RecordSectionRail>
    <RecordSection Slug="meine" Label="Meine Abmeldungen" Icon="@Icons.Material.Filled.EventBusy">
        <MyAbsencesPanel />
    </RecordSection>

    <AuthorizeView Policy="@Policies.LeadershipPage" Context="overviewSection">
        <RecordSection Slug="uebersicht" Label="Anwesenheit" Icon="@Icons.Material.Filled.Groups">
            <AbsenceOverviewPanel />
        </RecordSection>
    </AuthorizeView>

    <AuthorizeView Policy="@Policies.LeadershipPage" Context="trashSection">
        <RecordSection Slug="papierkorb" Label="Papierkorb" Icon="@Icons.Material.Filled.Delete">
            <TrashPanel Kind="abmeldungen" />
        </RecordSection>
    </AuthorizeView>
</RecordSectionRail>
