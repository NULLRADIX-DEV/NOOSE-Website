@page "/personen"
@inject IPersonService PersonService
@inject IRecencyService Recency
@inject IThreatTrendService Trends
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Personen-Akten · NOOSE</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.Badge" Title="Personen-Akten"
            Subtitle="Zentrale Personenakten des Nachrichtendienstes. Klicke eine Akte an, um Steckbrief, Doks, Einstufung, Fotos und Historie zu sehen.">
    <Actions>
        <SavedViewButton BaseRoute="/personen" Filters="FilterState" OnApply="ApplyViewAsync" />
        <ListExportButton T="PersonRow" RecordType="@nameof(Person)" Items="@(() => _grid?.FilteredItems ?? [])" Columns="ExportColumns" Disabled="_load" />
        <AuthorizeView Policy="@Policies.Leadership">
            <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.CallMerge"
                       OnClick="MergeAsync">Zusammenführen</MudButton>
            <MudButton Href="/papierkorb?tab=personen" Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.Delete">Papierkorb</MudButton>
        </AuthorizeView>
        <AuthorizeView Policy="@Policies.WriteAccess" Context="schreib">
            <MudButton Href="/personen/neu" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd">Neue Person</MudButton>
        </AuthorizeView>
    </Actions>
</PageHeader>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudDataGrid @ref="_grid" T="PersonRow" Items="_rows" Hover="true" Filterable="false" SortMode="SortMode.Multiple"
                 QuickFilter="Filter" Elevation="2" RowClick="@(args => Open(args.Item))" Dense="true">
        <ToolBarContent>
            <MudTextField Value="_search" ValueChanged="@((string v) => SearchChangedAsync(v))" Placeholder="Suchen (Name, Aktenzeichen, Alias)…" Immediate="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
            <MudSpacer />
            <MudSelect T="Classification?" Value="_classification" ValueChanged="ClassificationSelectedAsync" Label="Einstufung" Dense="true"
                       Clearable="true" Variant="Variant.Outlined" Style="max-width:220px;" Margin="Margin.Dense">
                <MudSelectItem T="Classification?" Value="@(null)">Alle</MudSelectItem>
                @foreach (var e in ClassificationDisplay.All)
                {
                    <MudSelectItem T="Classification?" Value="@e">@ClassificationDisplay.Name(e)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="RecencyLevel?" Value="_recency" ValueChanged="RecencySelectedAsync" Label="Aktualität" Dense="true"
                       Clearable="true" Variant="Variant.Outlined" Style="max-width:180px;" Margin="Margin.Dense" Class="ml-2">
                <MudSelectItem T="RecencyLevel?" Value="@(null)">Alle</MudSelectItem>
                @foreach (var e in Enum.GetValues<RecencyLevel>())
                {
                    <MudSelectItem T="RecencyLevel?" Value="@e">@RecencyLevelDisplay.Name(e)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="ArchiveFilter" Value="_archive" ValueChanged="ArchiveSelectedAsync" Label="Archiv" Dense="true"
                       Variant="Variant.Outlined" Style="max-width:170px;" Margin="Margin.Dense" Class="ml-2">
                <MudSelectItem T="ArchiveFilter" Value="ArchiveFilter.Active">Aktiv</MudSelectItem>
                <MudSelectItem T="ArchiveFilter" Value="ArchiveFilter.Including">Mit Archiv</MudSelectItem>
                <MudSelectItem T="ArchiveFilter" Value="ArchiveFilter.Only">Nur Archiv</MudSelectItem>
            </MudSelect>
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.CaseNumber" Title="Aktenzeichen" />
            <TemplateColumn Sortable="true" Title="Name" SortBy="x => x.Name">
                <CellTemplate>
                    @* Real link: middle/ctrl-click opens record in new tab; keyboard/screenreader-reachable. *@
                    <MudLink Href="@($"/personen/{context.Item.Id}")" @onclick:stopPropagation="true">@context.Item.Name</MudLink>
                    @if (context.Item.IsArchived)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Class="ml-2">Archiviert</MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Aliases" Title="Aliase" />
            <TemplateColumn Sortable="true" Title="Lebensstatus" SortBy="x => x.EffectiveLifeStatus">
                <CellTemplate>
                    <LifeStatusBadge Status="context.Item.LifeStatusRaw" DeadUntil="context.Item.DeadUntil" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="true" Title="Einstufung" SortBy="x => x.Classification">
                <CellTemplate>
                    <ClassificationBadge Value="context.Item.Classification" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="true" Title="Gefährdung" SortBy="x => x.ThreatScore ?? -1" InitialDirection="SortDirection.Descending">
                <CellTemplate>
                    @if (context.Item.ThreatScore is { } gscore)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudTooltip Text="@($"Bedrohungs-Score {gscore}/100" + (context.Item.ThreatConfidence is { } gk ? $" · Konfidenz {gk} %" : ""))">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@DangerColour(context.Item.Hazard)">
                                    @HazardLevelLogic.Name(context.Item.Hazard)
                                </MudChip>
                            </MudTooltip>
                            <MudTooltip Text="@ThreatTrendText.Hint(context.Item.Trend)">
                                <ThreatSparkline Values="context.Item.Trend" />
                            </MudTooltip>
                        </MudStack>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">—</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="true" Title="Verschluss" SortBy="x => x.IsClassified">
                <CellTemplate>
                    @if (context.Item.IsClassified)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Lock">@DocumentClassificationDisplay.ChipLabel(context.Item.SecrecyLevel)</MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="true" Title="Aktualität" SortBy="x => x.Level">
                <CellTemplate>
                    <RecencyIndicator Level="context.Item.Level" ReferenceDateUtc="context.Item.RefreshedUtc" />
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Refreshed" Title="Zuletzt" Format="dd.MM.yyyy HH:mm" />
        </Columns>
        <NoRecordsContent>
            @if (HasFilter)
            {
                <EmptyState Icon="@Icons.Material.Filled.SearchOff" Title="Keine Treffer"
                            Text="Für diese Filter gibt es keine Akte. Setze die Filter zurück, um alle zu sehen.">
                    <Actions>
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.FilterAltOff" OnClick="ResetFiltersAsync">Filter zurücksetzen</MudButton>
                    </Actions>
                </EmptyState>
            }
            else
            {
                <AuthorizeView Policy="@Policies.PartnerView" Context="partnerEmpty">
                    <Authorized>
                        <EmptyState Icon="@Icons.Material.Filled.Badge" Title="Noch nichts freigegeben"
                                    Text="Für Ihre Behörde wurde noch keine Personen-Akte freigegeben." />
                    </Authorized>
                    <NotAuthorized>
                        <EmptyState Icon="@Icons.Material.Filled.Badge" Title="Noch keine Personen-Akten"
                                    Text="Lege die erste Akte an, um Steckbrief, Doks und Einstufung zu erfassen.">
                            <Actions>
                                <AuthorizeView Policy="@Policies.WriteAccess" Context="schreib">
                                    <MudButton Href="/personen/neu" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd">Neue Person</MudButton>
                                </AuthorizeView>
                            </Actions>
                        </EmptyState>
                    </NotAuthorized>
                </AuthorizeView>
            }
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="PersonRow" />
        </PagerContent>
    </MudDataGrid>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private MudDataGrid<PersonRow>? _grid;

    /// <summary>The CSV export's columns: the grid's own, minus the trend curve.</summary>
    private static readonly IReadOnlyList<ExportColumn<PersonRow>> ExportColumns =
    [
        new("Aktenzeichen", r => r.CaseNumber),
        new("Name", r => r.Name),
        new("Archiviert", r => ExportText.Flag(r.IsArchived)),
        new("Aliase", r => r.Aliases),
        new("Lebensstatus", r => r.EffectiveLifeStatus),
        new("Einstufung", r => ClassificationDisplay.Name(r.Classification)),
        new("Gefährdung", r => ExportText.Hazard(r.Hazard, r.ThreatScore)),
        new("Verschluss", r => ExportText.Secrecy(r.IsClassified, r.SecrecyLevel)),
        new("Aktualität", r => RecencyLevelDisplay.Name(r.Level)),
        new("Zuletzt", r => ExportText.Stamp(r.Refreshed)),
    ];

    private bool _load = true;
    private int _loadGeneration;
    private string _search = string.Empty;
    private Classification? _classification;
    private RecencyLevel? _recency;
    private ArchiveFilter _archive = ArchiveFilter.Active;
    private List<PersonRow> _rows = new();

    private bool HasFilter => !string.IsNullOrWhiteSpace(_search) || _classification is not null || _recency is not null
        || _archive != ArchiveFilter.Active;

    protected override async Task OnInitializedAsync()
    {
        // restore the view from the URL so back-navigation and shared links keep the filters
        ReadFilters(new Uri(Nav.Uri).Query);

        await LoadAsync();
    }

    private void ReadFilters(string query)
    {
        _search = QueryState.Read(query, "q") ?? string.Empty;
        _classification = QueryState.ReadEnum<Classification>(query, "einstufung");
        _recency = QueryState.ReadEnum<RecencyLevel>(query, "aktualitaet");
        _archive = QueryState.ReadEnum<ArchiveFilter>(query, "archiv") ?? ArchiveFilter.Active;
    }

    // a saved view, the palette or the menu landing on this list while it shows: the instance is reused
    private async Task ApplyViewAsync(string query)
    {
        var archive = _archive;
        ReadFilters(query);
        // the archive filter is the one that lives on the server
        if (_archive == archive)
        {
            return;
        }
        _load = true;
        try
        {
            await LoadAsync();
        }
        catch
        {
            // no endless spinner; the button tells the agent the reload failed
            _load = false;
            throw;
        }
    }

    // the archive filter is server-side, so switching it reloads rather than filtering in place
    private async Task LoadAsync()
    {
        // a view can land while a load still runs; only the newest may write the rows
        var generation = ++_loadGeneration;
        var user = (await AuthStateTask).User;
        var people = await PersonService.GetListAsync(ViewerScope.From(user), _archive);
        var settings = await Recency.GetSettingsAsync(nameof(Person));
        // one bundled query for the whole page, not one per row
        var trends = await Trends.GetSparklinesAsync(nameof(Person), people.Select(p => p.Id).ToList());
        var now = DateTime.UtcNow;
        if (generation != _loadGeneration)
        {
            return;
        }
        _rows = people.Select(p =>
        {
            var referenceUtc = p.ModifiedAt ?? p.CreatedAt;
            return new PersonRow
            {
                Id = p.Id,
                CaseNumber = p.CaseNumber,
                Name = p.Name,
                Aliases = string.Join(", ", p.Aliases.Select(a => a.AliasName)),
                LifeStatusRaw = p.LifeStatus,
                DeadUntil = p.DeadUntil,
                EffectiveLifeStatus = LifeStatusDisplay.Name(LifeStatusLogic.Effective(p.LifeStatus, p.DeadUntil, now)),
                Classification = p.Classification,
                ThreatScore = p.ThreatScore,
                ThreatConfidence = p.ThreatConfidence,
                Hazard = HazardLevelLogic.From(p.ThreatScore),
                Trend = trends.TryGetValue(p.Id, out var trend) ? trend : [],
                IsClassified = p.IsClassified,
                SecrecyLevel = p.SecrecyLevel,
                RefreshedUtc = referenceUtc,
                Refreshed = referenceUtc.ToLocalTime(),
                IsArchived = p.IsArchived,
                Level = RecencyAssessment.For(settings.AgingDisabled, p.AgingDisabled, p.IsArchived,
                    settings.WarningDays, settings.StaleDays, referenceUtc, now),
            };
        }).ToList();
        _load = false;
    }

    private bool Filter(PersonRow z)
    {
        if (_classification is { } c && z.Classification != c)
        {
            return false;
        }
        if (_recency is { } r && z.Level != r)
        {
            return false;
        }
        if (string.IsNullOrWhiteSpace(_search))
        {
            return true;
        }
        var s = _search.Trim();
        return z.Name.Contains(s, StringComparison.OrdinalIgnoreCase)
            || z.CaseNumber.Contains(s, StringComparison.OrdinalIgnoreCase)
            || z.Aliases.Contains(s, StringComparison.OrdinalIgnoreCase);
    }

    private Task SearchChangedAsync(string value)
    {
        _search = value ?? string.Empty;
        return PersistFiltersAsync();
    }

    private Task ClassificationSelectedAsync(Classification? value)
    {
        _classification = value;
        return PersistFiltersAsync();
    }

    private Task RecencySelectedAsync(RecencyLevel? value)
    {
        _recency = value;
        return PersistFiltersAsync();
    }

    private async Task ArchiveSelectedAsync(ArchiveFilter value)
    {
        _archive = value;
        await PersistFiltersAsync();
        _load = true;
        await LoadAsync();
    }

    private async Task ResetFiltersAsync()
    {
        _search = string.Empty;
        _classification = null;
        _recency = null;
        var reload = _archive != ArchiveFilter.Active;
        _archive = ArchiveFilter.Active;
        await PersistFiltersAsync();
        if (reload)
        {
            _load = true;
            await LoadAsync();
        }
    }

    /// <summary>The filters as query pairs: written to the address, and what a saved view keeps.</summary>
    private (string Name, string? Value)[] FilterState =>
    [
        ("q", _search),
        ("einstufung", _classification?.ToString()),
        ("aktualitaet", _recency?.ToString()),
        ("archiv", _archive == ArchiveFilter.Active ? null : _archive.ToString()),
    ];

    private Task PersistFiltersAsync() => QueryState.WriteAsync(JS, Nav, FilterState);

    private void Open(PersonRow z) => Nav.NavigateTo($"/personen/{z.Id}");

    private static Color DangerColour(HazardLevel s) => s switch
    {
        HazardLevel.Critical => Color.Error,
        HazardLevel.High => Color.Error,
        HazardLevel.Medium => Color.Warning,
        HazardLevel.Low => Color.Info,
        _ => Color.Default,
    };

    private async Task MergeAsync()
    {
        var targetId = await PersonMergeDialog.ShowAsync(DialogService);
        if (targetId is not null)
        {
            Nav.NavigateTo($"/personen/{targetId}");
        }
    }

    private sealed class PersonRow
    {
        public string Id { get; set; } = string.Empty;
        public string CaseNumber { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Aliases { get; set; } = string.Empty;
        public LifeStatus LifeStatusRaw { get; set; }
        public DateTime? DeadUntil { get; set; }
        public string EffectiveLifeStatus { get; set; } = string.Empty;
        public Classification Classification { get; set; }
        public int? ThreatScore { get; set; }
        public int? ThreatConfidence { get; set; }
        public HazardLevel Hazard { get; set; }
        public IReadOnlyList<int> Trend { get; set; } = [];
        public bool IsClassified { get; set; }
        public DocumentClassification SecrecyLevel { get; set; }
        public DateTime RefreshedUtc { get; set; }
        public DateTime Refreshed { get; set; }
        public RecencyLevel Level { get; set; }
        public bool IsArchived { get; set; }
    }
}
