@page "/personen/neu"
@page "/personen/{Id}/bearbeiten"
@inject IPersonService PersonService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(IsEdit ? "Akte bearbeiten" : "Neue Person") · FIB</PageTitle>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_input is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        Akte nicht gefunden oder nicht zugänglich.
    </MudAlert>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="@BackHref" aria-label="Zurück" />
        <MudIcon Icon="@(IsEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.PersonAdd)" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h4">@(IsEdit ? "Akte bearbeiten" : "Neue Person anlegen")</MudText>
    </MudStack>

    <MudForm @ref="_form">
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="_input.Name" Label="Name" Required="true" RequiredError="Name ist erforderlich"
                              Variant="Variant.Outlined" AutoFocus="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="LifeStatus" @bind-Value="_input.LifeStatus" Label="Lebensstatus" Variant="Variant.Outlined">
                    @foreach (var s in LifeStatusDisplay.All)
                    {
                        <MudSelectItem Value="s">@LifeStatusDisplay.Name(s)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MentionInput Text="@(_input.Description ?? string.Empty)" TextChanged="@(v => _input.Description = v)"
                              Label="Beschreibung" Lines="3" HelperText="@MentionInput.Hint"
                              DraftKey='@DraftKeys.In(DraftScope, "beschreibung")' />
            </MudItem>
            @if (!IsEdit)
            {
                <MudItem xs="12" md="6">
                    <MudSelect T="Classification" @bind-Value="_input.Classification" Label="Einstufung" Variant="Variant.Outlined">
                        @foreach (var e in ClassificationDisplay.All)
                        {
                            <MudSelectItem Value="e" Disabled="@(e == Classification.SecuredStateThreatening && !_mayHighest)">
                                @ClassificationDisplay.Name(e)
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            @if (_secrecyOptions.Count > 1)
            {
                <MudItem xs="12" md="6">
                    <MudSelect T="DocumentClassification" @bind-Value="_input.SecrecyLevel" Label="Verschluss-Stufe"
                               Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock"
                               HelperText="Bestimmt, wer die Akte sehen darf.">
                        @foreach (var o in _secrecyOptions)
                        {
                            <MudSelectItem T="DocumentClassification" Value="@o">@DocumentClassificationDisplay.Label(o)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
        </MudGrid>
        @if (IsEdit)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Hinweis: Die Einstufung wird in der Akte unter „Einstufung" geändert (mit Verlauf und Rang-Prüfung).
            </MudText>
        }

        <MudDivider Class="my-4" />
        <MudText Typo="Typo.h6" Class="mb-2">Steckbrief</MudText>
        <ProfileForm @key="_loadedId" Input="_input" />
    </MudForm>

    <MudStack Row="true" Spacing="2" Class="mt-4">
        @if (IsEdit)
        {
            <AuthorizeView Policy="@Policies.WriteAccess">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync" Disabled="_saves">Speichern</MudButton>
            </AuthorizeView>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync" Disabled="_saves">Anlegen</MudButton>
        }
        <MudButton Variant="Variant.Text" Href="@BackHref">Abbrechen</MudButton>
    </MudStack>
}

@code {
    [Parameter] public string? Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    // RouteView only supplies the matched template's route values, so a stale Id survives bearbeiten -> neu
    private bool IsEdit { get; set; }
    private string BackHref => IsEdit ? $"/personen/{Id}" : "/personen";

    private MudForm _form = default!;
    private PersonInput? _input;
    private ClaimsPrincipal _user = default!;

    // one scope for every text field of the page; dropped once the save went through
    private string DraftScope => IsEdit ? $"person:{Id}" : "person:neu";
    private bool _mayHighest;
    private bool _isLeadership;
    private bool _load = true;
    private bool _saves;
    private string? _loadedId;
    private IReadOnlyList<DocumentClassification> _secrecyOptions = Array.Empty<DocumentClassification>();

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _mayHighest = _user.MayHighestClassification();
        _isLeadership = _user.IsLeadership();
        _secrecyOptions = DocumentViewerScope.AssignableOptions(_user);
    }

    // both routes bind the same component, so Blazor reuses the instance across neu ↔ bearbeiten
    protected override async Task OnParametersSetAsync()
    {
        IsEdit = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0]
            .EndsWith("/bearbeiten", StringComparison.OrdinalIgnoreCase);
        var key = IsEdit ? Id ?? string.Empty : string.Empty;
        if (_loadedId == key)
        {
            return;
        }
        _loadedId = key;
        _load = true;
        _input = null;

        if (!IsEdit)
        {
            _input = new PersonInput();
            _load = false;
            return;
        }

        var p = await PersonService.GetDetailAsync(Id!, ViewerScope.From(_user));
        if (p is not null)
        {
            _input = new PersonInput
            {
                Name = p.Name,
                Description = p.Description,
                // Prefill effective status so a harmless edit doesn't start a new death window.
                LifeStatus = LifeStatusLogic.Effective(p.LifeStatus, p.DeadUntil, DateTime.UtcNow),
                Classification = p.Classification,
                SecrecyLevel = p.SecrecyLevel,
                Aliases = p.Aliases.Select(a => new AliasInput { AliasName = a.AliasName }).ToList(),
                PhoneNumbers = p.PhoneNumbers.Select(t => new PhoneInput { Number = t.Number, Designation = t.Designation }).ToList(),
                Vehicles = p.Vehicles.Select(f => new VehicleInput { Designation = f.Designation, LicensePlate = f.LicensePlate }).ToList(),
                Locations = p.Locations.Select(o => new LocationInput { Text = o.Text, Note = o.Note }).ToList(),
                Weapons = p.Weapons.Select(w => new WeaponInput { Text = w.Text }).ToList(),
            };
        }
        _load = false;
    }

    private async Task SaveAsync()
    {
        if (_input is null)
        {
            return;
        }
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _saves = true;
        try
        {
            if (IsEdit)
            {
                await PersonService.RefreshAsync(Id!, _input, _user);
                await TextDraft.DiscardScopeAsync(JS, _user.GetAgentId(), DraftScope);
                Snackbar.Add("Änderungen gespeichert.", Severity.Success);
                Nav.NavigateTo($"/personen/{Id}");
            }
            else
            {
                var numbers = _input.PhoneNumbers.Select(t => t.Number).Where(n => !string.IsNullOrWhiteSpace(n));
                var duplicates = await PersonService.FindDuplicatesAsync(_input.Name, numbers, _isLeadership);
                if (duplicates.Count > 0)
                {
                    var next = await DuplicateDialog.ShowAsync(DialogService, duplicates);
                    if (!next)
                    {
                        _saves = false;
                        return;
                    }
                }

                var person = await PersonService.CreateAsync(_input, _user);
                await TextDraft.DiscardScopeAsync(JS, _user.GetAgentId(), DraftScope);
                Snackbar.Add($"Akte {person.CaseNumber} angelegt.", Severity.Success);
                Nav.NavigateTo($"/personen/{person.Id}");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _saves = false;
        }
    }
}
