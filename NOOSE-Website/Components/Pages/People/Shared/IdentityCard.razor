@* Person identity card: mugshot and core data at a glance.
   Below 960px it shrinks to a compact head (noose-steckbrief-* in app.css): 64px picture beside the name, the markers
   in one wrapping row, the counts, and the rest behind "Details". The wrappers repeat MudStack's gap-3 column, so
   from 960px up the card renders as before. *@
@using NOOSE_Website.Models.Informants
@{
    var photo = Person.Photos.OrderByDescending(f => f.CreatedAt).FirstOrDefault();
}
<MudPaper Class="pa-4 noose-steckbrief" Elevation="2">
    <MudStack Spacing="3">
        <div class="d-flex flex-column gap-3 noose-steckbrief-kopf">
        @if (photo is not null)
        {
            <div class="noose-steckbrief-bild" @onclick="@(() => OpenLightboxAsync(photo))" style="cursor:pointer;">
                <MudImage Src="@($"/dateien/personen/foto/{photo.Id}")" Alt="@Person.Name"
                          Height="220" ObjectFit="ObjectFit.Cover" Class="rounded"
                          Style="@($"width:100%; object-position:{photo.FocalPointX}% {photo.FocalPointY}%")" />
            </div>
        }
        else
        {
            <MudStack AlignItems="AlignItems.Center" Class="py-4 noose-steckbrief-bild">
                <MudAvatar Color="Color.Primary" Rounded="true" Style="height:140px;width:140px;font-size:3rem;">
                    @Initials(Person.Name)
                </MudAvatar>
            </MudStack>
        }

        <div class="noose-steckbrief-name">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.h5">@Person.Name</MudText>
                @if (Person.IsClassified)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" Size="Size.Small" Title="@DocumentClassificationDisplay.Label(Person.SecrecyLevel)" />
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@DocumentClassificationDisplay.ChipLabel(Person.SecrecyLevel)</MudChip>
                }
                @if (_informant is not null)
                {
                    <MudTooltip Text="@($"Als Informant geführt · {InformantEnumDisplay.Status(_informant.Status)} · {_informant.CaseNumber}")">
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                                 Icon="@Icons.Material.Filled.VisibilityOff"
                                 Href="@($"/informanten/{_informant.InformantId}")">Informant</MudChip>
                    </MudTooltip>
                }
            </MudStack>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Person.CaseNumber</MudText>
        </div>
        </div>

        <MudStack Spacing="1" Class="noose-steckbrief-kennzeichen">
            <LifeStatusBadge Status="Person.LifeStatus" DeadUntil="Person.DeadUntil" />
            <ClassificationBadge Value="Person.Classification" />
        </MudStack>

        <div class="@RestClass">
        @if (Affiliations.Count > 0)
        {
            <div>
                <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mb-1">Zugehörigkeit</MudText>
                <MudStack Row="true" Spacing="1" Class="flex-wrap">
                    @foreach (var z in Affiliations)
                    {
                        <MudTooltip Text="@Title(z)">
                            <MudChip T="string" Size="Size.Small"
                                     Variant="@(z.IsLead ? Variant.Filled : Variant.Outlined)"
                                     Color="@(z.IsLead ? Color.Warning : Color.Default)"
                                     Icon="@TypeIcon(z.Type)" Href="@Route(z)">@z.Name</MudChip>
                        </MudTooltip>
                    }
                </MudStack>
            </div>
        }

        <MudDivider />

        <MudStack Spacing="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <RecencyIndicator Level="@(RecencyAssessment.NeverAges(Person.AgingDisabled, Person.IsArchived) ? RecencyLevel.Fresh : (RecencyLevel?)null)"
                                  RecordsType="@nameof(Person)" ReferenceDateUtc="@(Person.ModifiedAt ?? Person.CreatedAt)" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Zuletzt aktualisiert: @((Person.ModifiedAt ?? Person.CreatedAt).ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                </MudText>
            </MudStack>
            <AuthorizeView Policy="@Policies.Leadership">
                <MudSwitch T="bool" Value="Person.AgingDisabled" ValueChanged="ToggleAgingAsync"
                           Color="Color.Info" Size="Size.Small" Label="Veralterung deaktiviert" />
            </AuthorizeView>
        </MudStack>
        </div>
        <MudStack Row="true" Spacing="4" Class="flex-wrap">
            @foreach (var (value, label) in Metrics())
            {
                <MudStack Spacing="0" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6">@value</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@label</MudText>
                </MudStack>
            }
        </MudStack>
        <MudButton Variant="Variant.Text" Size="Size.Small" Class="noose-nur-schmal align-self-start"
                   EndIcon="@(_details ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                   OnClick="@(() => _details = !_details)" aria-expanded="@(_details ? "true" : "false")">
            @(_details ? "Weniger" : "Details")
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired] public Person Person { get; set; } = default!;

    [Parameter] public IReadOnlyList<PersonAffiliation> Affiliations { get; set; } = [];

    [Parameter] public ClaimsPrincipal? User { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    [Inject] private IRecencyService Recency { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private IInformantService Informants { get; set; } = default!;

    private InformantPersonMarker? _informant;

    // below 960px the affiliations, aging and recency lines start folded; the class does nothing from 960px up
    private bool _details;

    private string RestClass => _details
        ? "d-flex flex-column gap-3 noose-steckbrief-rest"
        : "d-flex flex-column gap-3 noose-steckbrief-rest noose-steckbrief-zu";
    private string _markerFor = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (User is null || Person.Id == _markerFor)
        {
            return;
        }
        _markerFor = Person.Id;
        _informant = await Informants.GetPersonMarkerAsync(Person.Id, User);
    }

    private async Task OpenLightboxAsync(PersonPhoto photo)
        => await ImageLightbox.ShowAsync(DialogService,
            new[] { new ImageLightbox.LightboxImage($"/dateien/personen/foto/{photo.Id}", Person.Name) });

    /// <summary>Toggle this record's aging exemption.</summary>
    private async Task ToggleAgingAsync(bool value)
    {
        if (User is null)
        {
            return;
        }
        try
        {
            await Recency.SetRecordExemptionAsync(nameof(Person), Person.Id, value, User);
            Snackbar.Add(value ? "Veralterung für diese Akte deaktiviert." : "Veralterung wieder aktiv.", Severity.Success);
            await Changed.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            StateHasChanged();
        }
    }

    private IEnumerable<(int Value, string Label)> Metrics()
    {
        yield return (Person.Photos.Count, "Fotos");
        yield return (Person.Aliases.Count, "Aliase");
        yield return (Person.PhoneNumbers.Count, "Telefon");
    }

    private static string Route(PersonAffiliation z)
        => z.Type == nameof(PersonGroup) ? $"/personengruppen/{z.Id}" : $"/fraktionen/{z.Id}";

    private static string TypeIcon(string type)
        => type == nameof(PersonGroup) ? Icons.Material.Filled.Diversity3 : Icons.Material.Filled.Groups;

    private static string Title(PersonAffiliation z)
    {
        var parts = new List<string> { z.Type == nameof(PersonGroup) ? "Gruppe" : "Fraktion" };
        if (z.IsLead)
        {
            parts.Add("Leitung");
        }
        if (!string.IsNullOrWhiteSpace(z.Role))
        {
            parts.Add(z.Role);
        }
        return string.Join(" · ", parts);
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var letters = parts.Take(2).Select(t => t[0]);
        return string.Concat(letters).ToUpperInvariant();
    }
}
