@* Merge a duplicate person record fully into another (leadership only); source goes to trash. *@
@inject IPersonService PersonService
@inject IPersonMergeService MergeService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined">
                Alle Inhalte der Quell-Akte (Doks, Observationen, Fotos, Steckbrief, Beziehungen,
                Verknüpfungen, Tags, Kommentare, Quellen, Mitgliedschaften, Verlauf) werden in die
                Ziel-Akte überführt. Die Quell-Akte wandert in den Papierkorb; ihr Name bleibt als
                Alias erhalten. Einstufung und Lebensstatus der Ziel-Akte bleiben unverändert.
            </MudAlert>

            <MudAutocomplete T="Person" Label="Quell-Akte (Duplikat, wird aufgelöst)" @bind-Value="_source"
                             SearchFunc="Search" ToStringFunc="@(p => Display(p))" Variant="Variant.Outlined"
                             Clearable="true" MinCharacters="1" AutoFocus="@(SourceId is null)" />
            <MudStack Row="true" Justify="Justify.Center">
                <MudTooltip Text="Quelle und Ziel tauschen">
                    <MudIconButton Icon="@Icons.Material.Filled.SwapVert" Size="Size.Small" OnClick="Swap"
                                   Disabled="@(_busy || (_source is null && _target is null))" />
                </MudTooltip>
            </MudStack>
            <MudAutocomplete T="Person" Label="Ziel-Akte (bleibt bestehen)" @bind-Value="_target"
                             SearchFunc="Search" ToStringFunc="@(p => Display(p))" Variant="Variant.Outlined"
                             Clearable="true" MinCharacters="1" />

            @if (_source is not null && _target is not null && _source.Id == _target.Id)
            {
                <MudAlert Severity="Severity.Error" Dense="true">Quelle und Ziel müssen unterschiedliche Akten sein.</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.CallMerge"
                   OnClick="MergeAsync" Disabled="@(!CanMerge)">
            @(_busy ? "Wird zusammengeführt…" : "Zusammenführen")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    /// <summary>Preselected duplicate, e.g. from the lead feed.</summary>
    [Parameter] public string? SourceId { get; set; }
    /// <summary>Preselected record that stays.</summary>
    [Parameter] public string? TargetId { get; set; }

    private Person? _source;
    private Person? _target;
    private bool _busy;

    private bool CanMerge
        => !_busy && _source is not null && _target is not null && _source.Id != _target.Id;

    private static string Display(Person? p) => p is null ? string.Empty : $"{p.Name} ({p.CaseNumber})";

    protected override async Task OnInitializedAsync()
    {
        if (SourceId is null && TargetId is null)
        {
            return;
        }
        var scope = ViewerScope.From((await AuthStateTask).User);
        _source = SourceId is null ? null : await PersonService.GetDetailAsync(SourceId, scope);
        _target = TargetId is null ? null : await PersonService.GetDetailAsync(TargetId, scope);
    }

    private void Swap() => (_source, _target) = (_target, _source);

    private async Task<IEnumerable<Person>> Search(string value, CancellationToken token)
    {
        var user = (await AuthStateTask).User;
        return await PersonService.SearchAsync(value, user.IsLeadership(), 15, token);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task MergeAsync()
    {
        if (!CanMerge)
        {
            return;
        }
        _busy = true;
        try
        {
            var user = (await AuthStateTask).User;
            await MergeService.MergeAsync(_source!.Id, _target!.Id, user);
            Snackbar.Add($"Akte „{_source.Name}“ wurde in „{_target.Name}“ überführt.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(_target.Id));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Opens the merge dialog, optionally prefilled; returns the target record id or <c>null</c>.</summary>
    public static async Task<string?> ShowAsync(IDialogService dialog, string? sourceId = null, string? targetId = null)
    {
        var parameters = new DialogParameters<PersonMergeDialog> { { x => x.SourceId, sourceId }, { x => x.TargetId, targetId } };
        var reference = await dialog.ShowAsync<PersonMergeDialog>("Akten zusammenführen", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        var result = await reference.Result;
        return result is { Canceled: false, Data: string mergedInto } ? mergedInto : null;
    }
}
