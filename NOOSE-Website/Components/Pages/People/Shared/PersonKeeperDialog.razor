@inject IAgentManagementService AgentService

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3" Style="min-width:380px;" Class="noose-min-breite-frei">
            <MudAutocomplete T="Agent" Label="Aktenführer" @bind-Value="_keeper"
                             SearchFunc="@SearchAgents" ToStringFunc="@(a => a is null ? string.Empty : a.Codename)"
                             Variant="Variant.Outlined" Clearable="true" CoerceText="false" CoerceValue="false"
                             ResetValueOnEmptyText="true" MinCharacters="0" Immediate="true"
                             Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.FolderShared"
                             HelperText="Hält die Akte aktuell. Leer = niemand.">
                <ItemTemplate Context="a">@Item(a)</ItemTemplate>
            </MudAutocomplete>
            <MudAutocomplete T="Agent" Label="Vertretung (optional)" @bind-Value="_deputy"
                             SearchFunc="@SearchAgents" ToStringFunc="@(a => a is null ? string.Empty : a.Codename)"
                             Variant="Variant.Outlined" Clearable="true" CoerceText="false" CoerceValue="false"
                             ResetValueOnEmptyText="true" MinCharacters="0" Immediate="true" Disabled="@(_keeper is null)"
                             Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.PeopleAlt"
                             HelperText="Springt ein, wenn der Aktenführer abwesend ist.">
                <ItemTemplate Context="a">@Item(a)</ItemTemplate>
            </MudAutocomplete>
            @if (_keeper is not null && _deputy is not null && _keeper.Id == _deputy.Id)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true">
                    Aktenführer und Vertretung müssen verschiedene Agents sein.
                </MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@(!Valid)">Speichern</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string? KeeperId { get; set; }
    [Parameter] public string? DeputyId { get; set; }
    [Parameter] public bool MayRealName { get; set; }

    private Agent? _keeper;
    private Agent? _deputy;
    private List<Agent> _all = new();

    private bool Valid => !(_keeper is not null && _deputy is not null && _keeper.Id == _deputy.Id);

    protected override async Task OnInitializedAsync()
    {
        _all = await AgentService.GetSelectableAsync();
        // a stored agent who is no longer selectable must round-trip, but stays out of the offer list
        _keeper = await ResolveAsync(KeeperId);
        _deputy = await ResolveAsync(DeputyId);
    }

    private async Task<Agent?> ResolveAsync(string? id)
        => string.IsNullOrEmpty(id) ? null : _all.FirstOrDefault(a => a.Id == id) ?? await AgentService.FindAsync(id);

    private Task<IEnumerable<Agent>> SearchAgents(string value, CancellationToken token)
    {
        var search = value.Trim();
        IEnumerable<Agent> hit = string.IsNullOrWhiteSpace(value)
            ? _all
            : _all.Where(a => a.Codename.Contains(search, StringComparison.OrdinalIgnoreCase)
                            || (MayRealName && (a.RealName ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase)));
        return Task.FromResult(hit);
    }

    private RenderFragment Item(Agent a) => __builder =>
    {
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Color="Color.Primary" />
            <MudText Typo="Typo.body2">@a.Codename</MudText>
            @if (MayRealName && !string.IsNullOrWhiteSpace(a.RealName))
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">(@a.RealName)</MudText>
            }
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@DivisionRules.RankName(a)</MudText>
        </MudStack>
    };

    private void Save()
    {
        if (!Valid)
        {
            return;
        }
        // a deputy without a keeper is dropped, as the service would refuse it
        MudDialog.Close(DialogResult.Ok((_keeper?.Id, _keeper is null ? null : _deputy?.Id)));
    }

    private void Cancel() => MudDialog.Cancel();

    /// <summary>Shows the dialog; returns keeper and deputy, or null on cancel.</summary>
    public static async Task<(string? Keeper, string? Deputy)?> ShowAsync(IDialogService dialog, string? keeperId,
        string? deputyId, bool mayRealName)
    {
        var parameters = new DialogParameters<PersonKeeperDialog>
        {
            { x => x.KeeperId, keeperId },
            { x => x.DeputyId, deputyId },
            { x => x.MayRealName, mayRealName },
        };
        var reference = await dialog.ShowAsync<PersonKeeperDialog>("Aktenführung", parameters);
        var result = await reference.Result;
        return result is { Canceled: false, Data: ValueTuple<string?, string?> pair } ? pair : null;
    }
}
