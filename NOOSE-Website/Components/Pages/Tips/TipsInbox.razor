@page "/hinweise"
@attribute [Authorize(Policy = Policies.InternalAgent)]

@* /hinweis (singular) is the public form; this is the internal desk and stays out of PublicRoutes *@

<PageTitle>Bürgerhinweise · FIB</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.TipsAndUpdates"
            Title="Bürgerhinweise"
            Subtitle="Meldungen aus der Bevölkerung: Eingang, Bearbeitung und Rückfragen." />

<RecordSectionRail>
    <RecordSection Group="Bearbeitung" Slug="eingang" Label="Eingang" Icon="@Icons.Material.Filled.Inbox">
        <TipsListPanel Scope="TipInboxScope.Eingang" />
    </RecordSection>
    <RecordSection Group="Bearbeitung" Slug="bearbeitung" Label="In Arbeit" Icon="@Icons.Material.Filled.HourglassTop">
        <TipsListPanel Scope="TipInboxScope.Bearbeitung" />
    </RecordSection>
    <RecordSection Group="Bearbeitung" Slug="erledigt" Label="Erledigt" Icon="@Icons.Material.Filled.DoneAll">
        <TipsListPanel Scope="TipInboxScope.Erledigt" />
    </RecordSection>
</RecordSectionRail>
