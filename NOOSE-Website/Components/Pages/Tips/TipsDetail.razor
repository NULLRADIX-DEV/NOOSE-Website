@page "/hinweise/{Id}"
@attribute [Authorize(Policy = Policies.InternalAgent)]
@inject ITipService Tips
@inject ITipTakeoverService Takeover
@inject IRewardService Reward
@inject IPersonService PersonService
@inject TipsBroadcaster Broadcaster
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>@(_tip?.CaseNumber ?? "Bürgerhinweis") · FIB</PageTitle>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_tip is null)
{
    <EmptyState Icon="@Icons.Material.Filled.SearchOff" Title="Hinweis nicht gefunden"
                Text="Der Hinweis existiert nicht oder wurde gelöscht." />
}
else
{
    <PageHeader Icon="@Icons.Material.Filled.TipsAndUpdates"
                Title="@($"Bürgerhinweis {_tip.CaseNumber}")"
                Subtitle="@($"Eingegangen am {_tip.CreatedAt.ToLocalTime():dd.MM.yyyy HH:mm}")"
                BackHref="/hinweise">
        <Actions>
            @if (_canWrite)
            {
                @if (_tip.HandlerId is null)
                {
                    <MudButton OnClick="AssignAsync" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AssignmentInd">Übernehmen</MudButton>
                }
                <MudMenu Label="Status setzen" Variant="Variant.Outlined" Color="Color.Default"
                         StartIcon="@Icons.Material.Filled.Flag">
                    @foreach (var target in TipRules.AllowedTargets(_tip.Status))
                    {
                        <MudMenuItem OnClick="@(() => SetStatusAsync(target))">@TipStatusDisplay.Name(target)</MudMenuItem>
                    }
                </MudMenu>
                <MudButton OnClick="DeleteAsync" Variant="Variant.Text" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete">Löschen</MudButton>
            }
        </Actions>
    </PageHeader>

    <MudGrid Spacing="4">
        <MudItem xs="12" md="6">
            <MudStack Spacing="4">
                <MudPaper Outlined="true" Class="pa-4">
                    <MudStack Spacing="3">
                        @if (_tip.WantedCaseNumber is not null)
                        {
                            @* above the chips and filled, not a grey line below them: a tip that belongs to a
                               notice was not recognisable as one at a glance *@
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true"
                                      Icon="@Icons.Material.Filled.PersonSearch">
                                Hinweis zur Ausschreibung <b>@_tip.WantedDisplayName</b> —
                                <MudLink Href="@($"/gesucht/{_tip.WantedCaseNumber}")" Target="_blank"
                                         Color="Color.Inherit"><b>@_tip.WantedCaseNumber</b></MudLink>
                            </MudAlert>
                        }

                        @if (_tip.Kind == TipKind.Ergreifung)
                        {
                            <MudAlert Severity="@(CaptureRules.IsUrgent(_tip.Kind, _tip.Handover)
                                          ? Severity.Error
                                          : Severity.Warning)"
                                      Variant="Variant.Filled"
                                      Icon="@TipKindDisplay.Icon(TipKind.Ergreifung)">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.subtitle2">
                                        @(_tip.Handover is { } state
                                            ? TipHandoverDisplay.Name(state)
                                            : TipKindDisplay.Name(TipKind.Ergreifung))
                                    </MudText>
                                    @if (!string.IsNullOrWhiteSpace(_tip.HandoverLocation))
                                    {
                                        <MudText Typo="Typo.body2">
                                            Ort: <b>@_tip.HandoverLocation</b>
                                        </MudText>
                                    }
                                    @* the notice keeps its single write path: this only says what is missing,
                                       it does not offer to flip it from here *@
                                    <MudText Typo="Typo.caption">
                                        Nach der Übergabe die Ausschreibung auf „gefasst" setzen — erst danach
                                        lässt sich das Kopfgeld auszahlen.
                                    </MudText>
                                </MudStack>
                            </MudAlert>
                        }

                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                            <MudChip T="string" Size="Size.Small" Color="@StatusColour(_tip.Status)">
                                @TipStatusDisplay.Name(_tip.Status)
                            </MudChip>
                            @if (_tip.Kind == TipKind.Ergreifung)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                                         Icon="@TipKindDisplay.Icon(TipKind.Ergreifung)">
                                    @TipKindDisplay.Name(TipKind.Ergreifung)
                                </MudChip>
                            }
                            @if (_tip.WantsAnonymity && !_tip.AnonymityResolved)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                         Icon="@Icons.Material.Filled.VisibilityOff">anonym</MudChip>
                            }
                            @* two variants rather than a null OnClick: EventCallback.Factory would be handed a
                               null delegate, and the chip would look clickable to a handler who may not pin *@
                            @if (MayPinNow)
                            {
                                <MudTooltip Text="@PriorityHint()">
                                    <MudChip T="string" Size="Size.Small"
                                             Variant="@(_tip.PriorityOverride is null ? Variant.Outlined : Variant.Filled)"
                                             Color="@(_tip.PriorityOverride is null ? Color.Default : Color.Info)"
                                             Icon="@Icons.Material.Filled.LowPriority"
                                             OnClick="PinPriorityAsync">
                                        Priorität @_tip.Priority@(_tip.PriorityOverride is null ? "" : " (manuell)")
                                    </MudChip>
                                </MudTooltip>
                            }
                            else
                            {
                                <MudTooltip Text="@PriorityHint()">
                                    <MudChip T="string" Size="Size.Small"
                                             Variant="@(_tip.PriorityOverride is null ? Variant.Outlined : Variant.Filled)"
                                             Color="@(_tip.PriorityOverride is null ? Color.Default : Color.Info)"
                                             Icon="@Icons.Material.Filled.LowPriority">
                                        Priorität @_tip.Priority@(_tip.PriorityOverride is null ? "" : " (manuell)")
                                    </MudChip>
                                </MudTooltip>
                            }
                            @if (MayPinNow && _tip.PriorityOverride is not null)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                           StartIcon="@Icons.Material.Filled.AutoFixHigh"
                                           OnClick="ResetPriorityAsync">automatisch</MudButton>
                            }
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                     Icon="@Icons.Material.Filled.Verified">@TipTrust.Label(_tip.TrustTier)</MudChip>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                Bearbeiter: @(string.IsNullOrWhiteSpace(_tip.HandlerCodename) ? "—" : _tip.HandlerCodename)
                            </MudText>
                        </MudStack>

                        @if (_tip.WantedCaseNumber is not null)
                        {
                            <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true"
                                      Icon="@Icons.Material.Filled.PersonSearch">
                                Bezug: <b>@_tip.WantedDisplayName</b> (@_tip.WantedCaseNumber)
                            </MudAlert>
                        }

                        @if (_rewards.Count > 0)
                        {
                            @* the paying agent is not named: the reward row carries them, the panel does not need to *@
                            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true"
                                      Icon="@Icons.Material.Filled.Redeem">
                                Belohnt: <b>@Money.Format(_rewards.Sum(r => r.Amount))</b> ·
                                Beleg @string.Join(", ", _rewards.Select(r => r.ReceiptNumber).Distinct())
                            </MudAlert>
                        }

                        <MudDivider />
                        <MudText Typo="Typo.body1" Style="white-space:pre-wrap;">@_tip.Text</MudText>

                        @if (_tip.HasAttachment)
                        {
                            <MudDivider />
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.subtitle2">Anhang</MudText>
                                <MudImage Src="@($"/dateien/hinweise/{_tip.Id}?inline=true")"
                                          Alt="Anhang" Fluid="true" Class="rounded" Style="max-width:100%;" />
                                <MudButton Href="@($"/dateien/hinweise/{_tip.Id}")" Target="_blank"
                                           Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Download">
                                    @(_tip.AttachmentName ?? "Herunterladen")
                                </MudButton>
                            </MudStack>
                        }
                    </MudStack>
                </MudPaper>

                <MudPaper Outlined="true" Class="pa-4">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">Hinweisgeber</MudText>
                        @if (_tip.CitizenName is not null)
                        {
                            <MudText Typo="Typo.body1">@_tip.CitizenName</MudText>
                            @if (_tip.CitizenConfirmedTips is { } confirmed)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    Bisher bestätigte Hinweise: @confirmed
                                </MudText>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                Der Hinweisgeber hat um Anonymität gebeten. Für eine Belohnung muss die Führungsebene
                                sie ausdrücklich aufheben.
                            </MudText>
                            <AuthorizeView Policy="@Policies.Leadership" Context="leadCtx">
                                <MudTextField @bind-Value="_reason" Label="Begründung der Auflösung" Lines="2"
                                              Variant="Variant.Outlined" />
                                <div>
                                    <MudButton OnClick="ResolveAsync" Disabled="_busy" Variant="Variant.Filled"
                                               Color="Color.Warning" StartIcon="@Icons.Material.Filled.LockOpen">
                                        Anonymität aufheben
                                    </MudButton>
                                </div>
                            </AuthorizeView>
                        }
                        @if (_tip.AnonymityResolved && _tip.AnonymityResolvedAt is { } resolvedAt)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                Anonymität aufgehoben am @resolvedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                @(_tip.AnonymityResolvedByCodename is null ? string.Empty : $" von {_tip.AnonymityResolvedByCodename}")
                            </MudText>
                        }
                    </MudStack>
                </MudPaper>

                @if (_canWrite)
                {
                    <MudPaper Outlined="true" Class="pa-4">
                        <MudStack Spacing="3">
                            <MudText Typo="Typo.h6">Übernahme</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                Aus dem Hinweis wird eine Akte. Jede Übernahme hinterlässt eine Verknüpfung, damit die
                                Herkunft an der Akte sichtbar bleibt — sie steht unten bei den verknüpften Akten.
                            </MudText>

                            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                                <MudTextField @bind-Value="_newPersonName" Label="Name der neuen Personenakte"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                              Style="min-width:240px;" />
                                <MudButton OnClick="ToNewPersonAsync" Disabled="_busy" Variant="Variant.Filled"
                                           Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd">
                                    Personenakte anlegen
                                </MudButton>
                                <MudButton OnClick="ToCaseAsync" Disabled="_busy" Variant="Variant.Outlined"
                                           Color="Color.Default" StartIcon="@Icons.Material.Filled.FolderOpen">
                                    Vorgang anlegen
                                </MudButton>
                            </MudStack>

                            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                                <MudTextField @bind-Value="_personSearch" Label="Bestehende Person suchen"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                              Style="min-width:240px;" />
                                <MudButton OnClick="SearchPeopleAsync" Disabled="_busy" Variant="Variant.Outlined"
                                           StartIcon="@Icons.Material.Filled.Search">Suchen</MudButton>
                            </MudStack>

                            @if (_people.Count > 0)
                            {
                                <MudList T="string" Dense="true">
                                    @foreach (var person in _people)
                                    {
                                        <MudListItem T="string">
                                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                                <MudText Typo="Typo.body2"><b>@person.Name</b></MudText>
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@person.CaseNumber</MudText>
                                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                                           StartIcon="@Icons.Material.Filled.Link"
                                                           OnClick="@(() => AttachPersonAsync(person.Id))">Verknüpfen</MudButton>
                                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                                           StartIcon="@Icons.Material.Filled.Visibility"
                                                           OnClick="@(() => ToObservationAsync(person.Id))">Als Observation</MudButton>
                                            </MudStack>
                                        </MudListItem>
                                    }
                                </MudList>
                            }
                        </MudStack>
                    </MudPaper>
                }

                @* every internal agent reads this, the read-only supervision included: the panel gates writing on
                   MayWrite() itself, and hiding the list from a reader would hide the origin of an existing file *@
                <MudPaper Outlined="true" Class="pa-4">
                    <RecordLinksPanel @ref="_links" EntityType="@nameof(Hinweis)" EntityId="@Id" User="@_user" />
                </MudPaper>

                @if (_duplicates.Count > 0)
                {
                    <MudPaper Outlined="true" Class="pa-4">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.h6">Dubletten (@(_duplicates.Count + 1))</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                Diese Meldungen beschreiben nach Textvergleich denselben Vorfall.
                            </MudText>
                            @foreach (var sibling in _duplicates)
                            {
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                    <MudLink Href="@($"/hinweise/{sibling.Id}")">@sibling.CaseNumber</MudLink>
                                    <MudChip T="string" Size="Size.Small" Color="@StatusColour(sibling.Status)">
                                        @TipStatusDisplay.Name(sibling.Status)
                                    </MudChip>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @sibling.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @sibling.Excerpt
                                    </MudText>
                                </MudStack>
                            }
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudStack Spacing="4">
                @* Closed, not folded into CanWrite: a finished tip takes no new message, but its own lines
                   stay correctable *@
                <TipMessagePanel TipId="@_tip.Id" User="_user" Audience="TipMessageAudience.Buerger"
                                 CaseNumber="@_tip.CaseNumber" CitizenName="@_tip.CitizenName"
                                 CanWrite="_canWrite" Closed="@TipRules.IsClosed(_tip.Status)" />
                <TipMessagePanel TipId="@_tip.Id" User="_user" Audience="TipMessageAudience.Intern"
                                 CanWrite="_canWrite" />
            </MudStack>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private ClaimsPrincipal _user = default!;
    private RecordLinksPanel? _links;
    private TipDetail? _tip;
    private IReadOnlyList<TipDuplicateRow> _duplicates = Array.Empty<TipDuplicateRow>();
    private List<Person> _people = new();
    private string _newPersonName = string.Empty;
    private string _personSearch = string.Empty;
    private string _reason = string.Empty;
    private bool _load = true;
    private bool _busy;
    private bool _canWrite;
    private IReadOnlyList<RewardRow> _rewards = [];
    private string? _loadedId;

    protected override void OnInitialized() => Broadcaster.Modified += OnModified;

    protected override async Task OnParametersSetAsync()
    {
        _user = (await AuthStateTask).User;
        _canWrite = _user.MayWrite();
        // pinning the inbox order is a leadership call, not every handler
        _mayPin = _user.IsLeadership() && _canWrite;
        if (_loadedId == Id)
        {
            return;
        }
        _loadedId = Id;
        await LoadAsync();
    }

    private bool _mayPin;

    /// <summary>Only while the tip still needs an order: a decided tip is never re-stamped, so releasing a pin
    /// there would leave the pinned number standing with nothing to recompute it.</summary>
    private bool MayPinNow => _mayPin && _tip is not null && !TipRules.IsClosed(_tip.Status);

    /// <summary>Why the number is what it is; the formula is not obvious from a bare figure.</summary>
    private string PriorityHint()
        => _tip?.PriorityOverride is not null
            ? "Von Hand gesetzt" + (string.IsNullOrWhiteSpace(_tip.PriorityOverrideReason)
                ? "." : $": {_tip.PriorityOverrideReason}")
            : "Errechnet aus Kopfgeld, Gefahrenstufe und Vertrauensstufe des Hinweisgebers.";

    private async Task PinPriorityAsync()
    {
        var entered = await PriorityDialog.ShowAsync(DialogService, _tip!.Priority, _tip.PriorityOverrideReason);
        if (entered is null)
        {
            return;
        }
        try
        {
            await Tips.SetPriorityAsync(Id, entered.Priority, entered.Reason, _user);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ResetPriorityAsync()
    {
        try
        {
            await Tips.SetPriorityAsync(Id, null, null, _user);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task LoadAsync()
    {
        _load = true;
        try
        {
            _tip = await Tips.GetAsync(Id, _user);
            _duplicates = _tip?.DuplicateGroupId is null
                ? Array.Empty<TipDuplicateRow>()
                : await Tips.GetDuplicatesAsync(Id, _user);
            _rewards = _tip is null
                ? Array.Empty<RewardRow>()
                : await Reward.GetForTipAsync(Id, _user);
            if (_tip is not null)
            {
                // opening it is what clears the inbox badge; the service ignores a repeat
                await Tips.MarkAgentReadAsync(Id, _user);
                // the takeover buttons write links the panel did not create, so it has to be told
                if (_links is not null)
                {
                    await _links.RefreshAsync();
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _tip = null;
        }
        finally
        {
            _load = false;
        }
    }

    private Task AssignAsync() => RunAsync(() => Tips.AssignSelfAsync(Id, _user));

    private Task ToNewPersonAsync() => RunAsync(async () =>
    {
        await Takeover.ToNewPersonAsync(Id, _newPersonName, _user);
        _newPersonName = string.Empty;
        Snackbar.Add("Personenakte angelegt und verknüpft.", Severity.Success);
    });

    private Task ToCaseAsync() => RunAsync(async () =>
    {
        await Takeover.ToCaseAsync(Id, null, _user);
        Snackbar.Add("Vorgang angelegt und verknüpft.", Severity.Success);
    });

    private Task AttachPersonAsync(string personId) => RunAsync(async () =>
    {
        await Takeover.AttachPersonAsync(Id, personId, _user);
        _people = new();
        _personSearch = string.Empty;
        Snackbar.Add("Mit der Personenakte verknüpft.", Severity.Success);
    });

    private Task ToObservationAsync(string personId) => RunAsync(async () =>
    {
        await Takeover.ToObservationAsync(Id, personId, _user);
        _people = new();
        _personSearch = string.Empty;
        Snackbar.Add("Als Observation erfasst und verknüpft.", Severity.Success);
    });

    private async Task SearchPeopleAsync()
    {
        if (string.IsNullOrWhiteSpace(_personSearch))
        {
            _people = new();
            return;
        }
        try
        {
            _people = await PersonService.SearchAsync(_personSearch, _user.IsLeadership());
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private Task SetStatusAsync(TipStatus status) => RunAsync(() => Tips.SetStatusAsync(Id, status, _user));

    private Task ResolveAsync() => RunAsync(() => Tips.ResolveAnonymityAsync(Id, _reason, _user));

    private async Task DeleteAsync()
    {
        _busy = true;
        try
        {
            await Tips.DeleteAsync(Id, _user);
            Snackbar.Add("Hinweis in den Papierkorb verschoben.", Severity.Success);
            Nav.NavigateTo("/hinweise");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnModified(string tipId, string caseNumber, TipMessageAudience? audience)
    {
        if (tipId != Id)
        {
            return;
        }
        InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
    }

    public void Dispose() => Broadcaster.Modified -= OnModified;

    private static Color StatusColour(TipStatus status) => status switch
    {
        TipStatus.Neu => Color.Info,
        TipStatus.InPruefung => Color.Primary,
        TipStatus.Rueckfrage => Color.Warning,
        TipStatus.Bestaetigt => Color.Success,
        TipStatus.FuehrteZurErgreifung => Color.Success,
        _ => Color.Default,
    };
}
