@using NOOSE_Website.Models.Navigation
@inject ITipService Tips
@inject TipsBroadcaster Broadcaster
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@implements IDisposable

<MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-4 noose-filterleiste">
    <MudTextField T="string" @bind-Value="_search" Label="Suche" Placeholder="Aktenzeichen oder Text"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search" DebounceInterval="300"
                  OnDebounceIntervalElapsed="ReloadAsync" Style="max-width:340px;" Class="noose-filter-feld" />
    @* phones: the switches fold behind "Filter (n)"; from 600px up the button is gone and they stand as before *@
    <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.FilterList"
               Class="noose-nur-handy" OnClick="@(() => _filtersOpen = !_filtersOpen)">Filter (@ActiveFilters)</MudButton>
    <MobileColumnPicker ListKey="hinweise" Columns="PhoneColumns" Defaults="PhoneDefaults"
                        VisibleChanged="@(v => _phoneColumns = v)" />
    <div class="@($"d-contents{(_filtersOpen ? "" : " noose-filter-zu")}")">
        <MudSwitch T="bool" @bind-Value="_onlyMine" Color="Color.Primary" Label="Nur meine"
                   @bind-Value:after="ReloadAsync" />
        <MudSwitch T="bool" @bind-Value="_collapse" Color="Color.Primary" Label="Dubletten zusammenfassen" />
        <MudSwitch T="bool" @bind-Value="_onlyCaptures" Color="Color.Error"
                   Label="Nur Ergreifungen" />
    </div>
</MudStack>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_rows.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Filled.TipsAndUpdates" Title="Keine Hinweise"
                Text="In dieser Ansicht liegt derzeit nichts vor." />
}
else
{
    <MudTable Items="Displayed" Hover="true" Dense="true" Style="cursor:pointer;" Breakpoint="Breakpoint.None"
              OnRowClick="@((TableRowClickEventArgs<TipRow> e) => Open(e.Item))">
        <HeaderContent>
            <MudTh Class="@Col("prio")">Prio</MudTh>
            <MudTh Class="@Col("aktenzeichen")">Aktenzeichen</MudTh>
            <MudTh Class="@Col("hinweisgeber")">Hinweisgeber</MudTh>
            <MudTh Class="@Col("bezug")">Bezug</MudTh>
            <MudTh Class="@Col("status")">Status</MudTh>
            <MudTh Class="@Col("bearbeiter")">Bearbeiter</MudTh>
            <MudTh Class="@Col("eingegangen")">Eingegangen</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Prio" Class="@Col("prio")">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                         Color="@PriorityColour(context.Priority)">@context.Priority</MudChip>
            </MudTd>
            <MudTd DataLabel="Aktenzeichen" Class="@Col("aktenzeichen")">
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    @context.CaseNumber
                    @if (context.Kind == TipKind.Ergreifung)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                                 Icon="@TipKindDisplay.Icon(TipKind.Ergreifung)">
                            @(context.Handover is { } state
                                ? TipHandoverDisplay.ShortName(state)
                                : TipKindDisplay.Name(TipKind.Ergreifung))
                        </MudChip>
                    }
                    @if (context.HasAttachment)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Small" Color="Color.Default" />
                    }
                    @if (context.AwaitingAnswer)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.MarkEmailUnread" Size="Size.Small" Color="Color.Warning" />
                    }
                    @if (context.DuplicateCount > 1)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                                 Icon="@Icons.Material.Filled.ContentCopy">Dublette ×@context.DuplicateCount</MudChip>
                    }
                    @if (context.WantedCaseNumber is not null)
                    {
                        @* a chip, not the plain text column: which tips belong to a notice is the first thing the
                           desk sorts by eye *@
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                                 Icon="@Icons.Material.Filled.PersonSearch">@context.WantedCaseNumber</MudChip>
                    }
                </MudStack>
            </MudTd>
            <MudTd DataLabel="Hinweisgeber" Class="@Col("hinweisgeber")">
                @if (context.IsAnonymous)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                             Icon="@Icons.Material.Filled.VisibilityOff">anonym</MudChip>
                }
                else
                {
                    @(context.CitizenName ?? "—")
                }
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                         Class="ml-1">@TipTrust.Label(context.TrustTier)</MudChip>
            </MudTd>
            <MudTd DataLabel="Bezug" Class="@Col("bezug")">@(context.WantedCaseNumber is null ? "—" : $"{context.WantedDisplayName} ({context.WantedCaseNumber})")</MudTd>
            <MudTd DataLabel="Status" Class="@Col("status")">
                <MudChip T="string" Size="Size.Small" Color="@StatusColour(context.Status)">
                    @TipStatusDisplay.Name(context.Status)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Bearbeiter" Class="@Col("bearbeiter")">@(string.IsNullOrWhiteSpace(context.HandlerCodename) ? "—" : context.HandlerCodename)</MudTd>
            <MudTd DataLabel="Eingegangen" Class="@Col("eingegangen")">@context.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Parameter]
    [EditorRequired]
    public TipInboxScope Scope { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private ClaimsPrincipal _user = default!;
    private IReadOnlyList<TipRow> _rows = Array.Empty<TipRow>();
    private string? _search;
    private bool _onlyMine;
    private bool _collapse;
    // client-side, on the rows already loaded: a second axis next to the status tabs, not a fourth tab
    private bool _onlyCaptures;
    private bool _load = true;
    private bool _filtersOpen;

    private int ActiveFilters => (_onlyMine ? 1 : 0) + (_collapse ? 1 : 0) + (_onlyCaptures ? 1 : 0);

    /// <summary>The table's columns for the phone column picker, in table order.</summary>
    private static readonly IReadOnlyList<(string Key, string Label)> PhoneColumns =
    [
        ("prio", "Prio"), ("aktenzeichen", "Aktenzeichen"), ("hinweisgeber", "Hinweisgeber"), ("bezug", "Bezug"),
        ("status", "Status"), ("bearbeiter", "Bearbeiter"), ("eingegangen", "Eingegangen"),
    ];

    /// <summary>What a phone shows until the agent chooses: the case number with its chips, and the status.</summary>
    private static readonly IReadOnlyList<string> PhoneDefaults = ["aktenzeichen", "status"];

    private IReadOnlySet<string> _phoneColumns = MobileColumnSet.Resolve(PhoneColumns.Select(c => c.Key).ToList(), PhoneDefaults, null);

    // below 600px only; from 600px up every column shows, as before
    private string Col(string key) => MobileColumnSet.ClassFor(_phoneColumns, key);

    // collapsing is client-side over the rows already fetched: the group is a display decision, and the service
    // order (priority, then age) already decides which row speaks for its group
    private IReadOnlyList<TipRow> Displayed
    {
        get
        {
            var rows = _onlyCaptures
                ? _rows.Where(r => r.Kind == TipKind.Ergreifung).ToList()
                : _rows;
            return _collapse
                ? rows.GroupBy(r => r.DuplicateGroupId ?? r.Id).Select(g => g.First()).ToList()
                : rows;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        Broadcaster.Modified += OnModified;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _load = true;
        try
        {
            _rows = await Tips.GetInboxAsync(Scope, _search, _onlyMine, _user);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _load = false;
        }
    }

    private void Open(TipRow? row)
    {
        if (row is not null)
        {
            Nav.NavigateTo($"/hinweise/{row.Id}");
        }
    }

    private void OnModified(string tipId, string caseNumber, TipMessageAudience? audience)
        => InvokeAsync(async () => { await ReloadAsync(); StateHasChanged(); });

    public void Dispose() => Broadcaster.Modified -= OnModified;

    private static Color PriorityColour(int priority) => priority switch
    {
        >= 45 => Color.Error,
        >= 20 => Color.Warning,
        >= 8 => Color.Primary,
        _ => Color.Default,
    };

    private static Color StatusColour(TipStatus status) => status switch
    {
        TipStatus.Neu => Color.Info,
        TipStatus.InPruefung => Color.Primary,
        TipStatus.Rueckfrage => Color.Warning,
        TipStatus.Bestaetigt => Color.Success,
        TipStatus.FuehrteZurErgreifung => Color.Success,
        TipStatus.Verworfen => Color.Default,
        _ => Color.Default,
    };
}
