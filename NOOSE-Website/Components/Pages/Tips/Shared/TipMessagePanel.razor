@inject ITipService Tips
@inject IPublicTemplateService Templates
@inject ICitizenAssistService Assist
@inject TipsBroadcaster Broadcaster
@inject ISnackbar Snackbar
@implements IDisposable

@* one component, two threads. The citizen-facing rows carry no author at all, so nothing has to be hidden here *@
<MudPaper Outlined="true" Class="pa-4">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@(IsInternal ? Icons.Material.Filled.Lock : Icons.Material.Filled.Forum)"
                     Color="@(IsInternal ? Color.Warning : Color.Primary)" Size="Size.Small" />
            <MudText Typo="Typo.h6">@(IsInternal ? "Interne Notizen" : "Schriftwechsel mit dem Hinweisgeber")</MudText>
        </MudStack>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            @(IsInternal
                ? "Nur für Agenten sichtbar."
                : "Der Hinweisgeber sieht diese Zeilen als Nachricht von „NOOSE“ — nie mit Codename.")
        </MudText>

        @if (_load)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_messages.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Noch keine Nachricht.</MudText>
        }
        else
        {
            <MudStack Spacing="2" Style="max-height:420px;overflow-y:auto;">
                @foreach (var message in _messages)
                {
                    <MudPaper Outlined="true" Class="pa-3"
                              Style="@(message.FromCitizen ? "margin-right:12%;" : "margin-left:12%;")">
                        <MudStack Spacing="1">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudText Typo="Typo.caption" Color="@(message.FromCitizen ? Color.Default : Color.Primary)">
                                    @Author(message) · @message.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </MudText>
                                @if (message.EditedAt is not null)
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">· bearbeitet</MudText>
                                }
                                @if (CanEdit(message))
                                {
                                    <MudTooltip Text="Bearbeiten">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                       Color="Color.Default" aria-label="Bearbeiten"
                                                       OnClick="@(() => BeginEdit(message))" />
                                    </MudTooltip>
                                }
                            </MudStack>
                            @if (_editingId == message.Id)
                            {
                                @* plain text on purpose: the citizen thread has no sanitizer, line breaks are the formatting *@
                                <MudTextField @bind-Value="_editText" Lines="3" Variant="Variant.Outlined"
                                              MaxLength="@TipRules.MaxMessageLength" AutoFocus="true"
                                              Label="@(IsInternal ? "Notiz" : "Nachricht an den Hinweisgeber")" />
                                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                                    <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                               OnClick="CancelEdit">Abbrechen</MudButton>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Check" OnClick="SaveEditAsync"
                                               Disabled="@(_editSaving || string.IsNullOrWhiteSpace(_editText))">
                                        Speichern
                                    </MudButton>
                                </MudStack>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Style="white-space:pre-wrap;">@message.Text</MudText>
                            }
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        }

        @* a closed tip takes no new message, but an old one of your own stays correctable *@
        @if (CanWrite && !Closed)
        {
            <TextDraft @ref="_replyDraft" DraftKey="@ComposerDraftKey" OnRestore="@(t => _draft = t)">
                <MudTextField @bind-Value="_draft" Label="@(IsInternal ? "Notiz" : "Nachricht an den Hinweisgeber")"
                              Lines="3" Variant="Variant.Outlined" MaxLength="@TipRules.MaxMessageLength" />
            </TextDraft>
            @if (_suggestCost is { } cost)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    NOOSEI-Entwurf: @cost.ToString("N0") Token
                    @if (_suggestQuota is { } quota)
                    {
                        <text> · Restkontingent: @quota.Remaining.ToString("N0")</text>
                    }
                </MudText>
            }
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudButton OnClick="SendAsync" Disabled="_busy" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Send">
                    @(IsInternal ? "Notiz speichern" : "Senden")
                </MudButton>
                @* same rule as the template menu: it fills the field, the agent sends *@
                @if (!IsInternal && Assist.IsAvailable)
                {
                    <MudButton OnClick="SuggestAsync" Disabled="_busy" Variant="Variant.Outlined"
                               Color="Color.Secondary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.AutoAwesome">NOOSEI-Entwurf</MudButton>
                }
                @* the template only fills the field; sending stays a deliberate act *@
                @if (_templates.Count > 0)
                {
                    <MudMenu Label="Vorlage" Variant="Variant.Outlined" Size="Size.Small"
                             EndIcon="@Icons.Material.Filled.ArrowDropDown">
                        @foreach (var template in _templates)
                        {
                            <MudMenuItem OnClick="@(() => Apply(template))">
                                @PublicTemplateKindDisplay.Name(template.Kind) · @template.Title
                            </MudMenuItem>
                        }
                    </MudMenu>
                }
            </MudStack>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    [EditorRequired]
    public string TipId { get; set; } = string.Empty;

    [Parameter]
    [EditorRequired]
    public ClaimsPrincipal User { get; set; } = default!;

    [Parameter]
    [EditorRequired]
    public TipMessageAudience Audience { get; set; }

    [Parameter]
    public bool CanWrite { get; set; }

    /// <summary>Closes the composer only; a handler still corrects his own lines on a finished tip.</summary>
    [Parameter]
    public bool Closed { get; set; }

    /// <summary>Fills the AKTENZEICHEN token of a picked template.</summary>
    [Parameter]
    public string? CaseNumber { get; set; }

    /// <summary>Fills the BUERGER token; null while the anonymity promise holds, and then the salutation falls back.</summary>
    [Parameter]
    public string? CitizenName { get; set; }

    private IReadOnlyList<TipMessageRow> _messages = Array.Empty<TipMessageRow>();
    private IReadOnlyList<PublicTemplateRow> _templates = Array.Empty<PublicTemplateRow>();
    private bool _templatesLoaded;
    private string _draft = string.Empty;
    private TextDraft? _replyDraft;

    // the internal note and the message to the tipster sit side by side: one draft each
    private string ComposerDraftKey => $"hinweis:{TipId}:{(IsInternal ? "notiz" : "nachricht")}";
    private long? _suggestCost;
    private LlmQuotaStatus? _suggestQuota;
    private bool _load = true;
    private bool _busy;
    private string? _loadedId;
    private string? _editingId;
    private string _editText = string.Empty;
    private bool _editSaving;

    private bool IsInternal => Audience == TipMessageAudience.Intern;

    protected override void OnInitialized() => Broadcaster.Modified += OnModified;

    protected override async Task OnParametersSetAsync()
    {
        // before the id guard: its own flag makes the load a one-shot anyway, and a reopened tip has to find
        // its templates without the guard skipping them for the life of the component
        await LoadTemplatesAsync();
        if (_loadedId == TipId)
        {
            return;
        }
        _loadedId = TipId;
        await LoadAsync();
    }

    private async Task LoadTemplatesAsync()
    {
        // tied to the composer that uses them, Closed included: a finished tip needs no template menu
        if (_templatesLoaded || IsInternal || !CanWrite || Closed)
        {
            return;
        }
        _templatesLoaded = true;
        // both kinds land in one menu: asking back and turning down are the same field
        try
        {
            var follow = await Templates.GetActiveAsync(PublicTemplateKind.HinweisRueckfrage);
            var refuse = await Templates.GetActiveAsync(PublicTemplateKind.HinweisAblehnung);
            _templates = follow.Concat(refuse).ToList();
        }
        catch { /* ignore */ }
    }

    private void Apply(PublicTemplateRow template)
        => _draft = PublicTemplateRenderer.Render(template.Text, new PublicTemplateContext(CitizenName, CaseNumber));

    private async Task LoadAsync()
    {
        _load = true;
        try
        {
            _messages = await Tips.GetMessagesAsync(TipId, Audience, User);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _load = false;
        }
    }

    /// <summary>Fills the composer with a NOOSEI draft; sending it stays the agent's own act.</summary>
    private async Task SuggestAsync()
    {
        _busy = true;
        // cleared first, so a refusal does not leave the previous run's quota standing as if current
        _suggestCost = null;
        _suggestQuota = null;
        try
        {
            var suggestion = await Assist.SuggestTipReplyAsync(TipId, User);
            _draft = suggestion.Text;
            _suggestCost = suggestion.QuotaTokens;
            _suggestQuota = suggestion.Quota;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SendAsync()
    {
        _busy = true;
        try
        {
            if (IsInternal)
            {
                await Tips.PostInternalNoteAsync(TipId, _draft, User);
            }
            else
            {
                await Tips.AskCitizenAsync(TipId, _draft, User);
            }
            if (_replyDraft is not null)
            {
                await _replyDraft.MarkSavedAsync();
            }
            _draft = string.Empty;
            // the cost line belongs to the draft that just left
            _suggestCost = null;
            _suggestQuota = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    // author only, and never the citizen's own line: leadership may delete a foreign line, never restate it
    private bool CanEdit(TipMessageRow message)
        => CanWrite && message.Mine && !message.FromCitizen && _editingId != message.Id;

    private void BeginEdit(TipMessageRow message)
    {
        _editingId = message.Id; // one edit at a time
        _editText = message.Text;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _editText = string.Empty;
    }

    private async Task SaveEditAsync()
    {
        if (_editSaving || _editingId is null || string.IsNullOrWhiteSpace(_editText))
        {
            return;
        }
        _editSaving = true;
        try
        {
            await Tips.EditMessageAsync(_editingId, _editText, User);
            CancelEdit();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _editSaving = false;
        }
    }

    // the projection is the gate: TipDetail.CitizenName stays null while the anonymity promise holds, so a name
    // here can only be one the leadership already resolved. Not conditional on the audience: this panel renders on
    // the handler's page only (the citizen area draws its own thread), and the citizen-facing audience is exactly
    // where the reported "Hinweisgeber" stood next to a name the desk already knew.
    private string Author(TipMessageRow message)
    {
        if (message.FromCitizen)
        {
            return CitizenName ?? "Hinweisgeber";
        }
        return IsInternal ? message.AuthorCodename ?? "NOOSE" : "NOOSE";
    }

    private void OnModified(string tipId, string caseNumber, TipMessageAudience? audience)
    {
        // a signal about the other thread is none of this panel's business; null concerns both
        if (tipId != TipId || (audience is { } only && only != Audience))
        {
            return;
        }
        InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
    }

    public void Dispose() => Broadcaster.Modified -= OnModified;
}
