@* compact head below 960px *@
<MudPaper Class="pa-4 noose-steckbrief" Elevation="2">
    <MudStack Spacing="3">
        <div class="d-flex flex-column gap-3 noose-steckbrief-kopf">
        <MudStack AlignItems="AlignItems.Center" Class="py-2 noose-steckbrief-bild">
            @if (!string.IsNullOrEmpty(TitleImagePhotoId))
            {
                <div @onclick="OpenLightboxAsync" style="cursor:pointer;">
                    <MudAvatar Rounded="true" Style="height:120px;width:120px;">
                        <MudImage Src="@RecordAvatar.Url(nameof(DrugRoute), TitleImagePhotoId)" Alt="Titelbild"
                                  ObjectFit="ObjectFit.Cover" Style="height:120px;width:120px;" />
                    </MudAvatar>
                </div>
            }
            else
            {
                <MudAvatar Color="Color.Primary" Rounded="true" Style="height:120px;width:120px;">
                    <MudIcon Icon="@Icons.Material.Filled.Route" Style="font-size:3rem;" />
                </MudAvatar>
            }
        </MudStack>

        <div class="noose-steckbrief-name">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="noose-steckbrief-kennzeichen">
                <MudText Typo="Typo.h5">@Route.Designation</MudText>
                @if (Route.IsClassified)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" Size="Size.Small" Title="@DocumentClassificationDisplay.Label(Route.SecrecyLevel)" />
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@DocumentClassificationDisplay.ChipLabel(Route.SecrecyLevel)</MudChip>
                }
            </MudStack>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Route.CaseNumber</MudText>
        </div>
        </div>

        <ClassificationBadge Value="Route.Classification" />

        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.subtitle2">Substanz</MudText>
            <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(Route.Substance) ? "—" : Route.Substance)</MudText>
        </MudStack>

        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.subtitle2">Fraktion</MudText>
            @if (Route.Faction is { } faction)
            {
                <MudLink Href="@($"/fraktionen/{faction.Id}")" Typo="Typo.body2">@faction.Name</MudLink>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@(Route.FactionId is null ? "unbekannt" : "nicht einsehbar")</MudText>
            }
        </MudStack>

        @if (StationCount is { } stations)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.subtitle2">Stationen</MudText>
                <MudText Typo="Typo.body2">@stations</MudText>
            </MudStack>
        }

        <div class="@RestClass">
        @if (PersonCount is { } people)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.subtitle2">Beteiligte Personen</MudText>
                <MudText Typo="Typo.body2">@people</MudText>
            </MudStack>
        }

        <MudDivider />

        <MudStack Spacing="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <RecencyIndicator Level="@(RecencyAssessment.NeverAges(Route.AgingDisabled, Route.IsArchived) ? RecencyLevel.Fresh : (RecencyLevel?)null)"
                                  RecordsType="@nameof(DrugRoute)" ReferenceDateUtc="@(Route.ModifiedAt ?? Route.CreatedAt)" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Zuletzt aktualisiert: @((Route.ModifiedAt ?? Route.CreatedAt).ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                </MudText>
            </MudStack>
            <AuthorizeView Policy="@Policies.LeadershipWrite">
                <MudSwitch T="bool" Value="Route.AgingDisabled" ValueChanged="ToggleAgingAsync"
                           Color="Color.Info" Size="Size.Small" Label="Veralterung deaktiviert" />
            </AuthorizeView>
        </MudStack>
        </div>
        <MudButton Variant="Variant.Text" Size="Size.Small" Class="noose-nur-schmal align-self-start"
                   EndIcon="@(_details ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                   OnClick="@(() => _details = !_details)" aria-expanded="@(_details ? "true" : "false")">
            @(_details ? "Weniger" : "Details")
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired] public DrugRoute Route { get; set; } = default!;
    [Parameter] public string? TitleImagePhotoId { get; set; }

    /// <summary>Null hides the line.</summary>
    [Parameter] public int? StationCount { get; set; }
    [Parameter] public int? PersonCount { get; set; }

    [Parameter] public ClaimsPrincipal? User { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    [Inject] private IRecencyService Recency { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;

    // folded below 960px
    private bool _details;

    private string RestClass => _details
        ? "d-flex flex-column gap-3 noose-steckbrief-rest"
        : "d-flex flex-column gap-3 noose-steckbrief-rest noose-steckbrief-zu";

    private async Task OpenLightboxAsync()
        => await ImageLightbox.ShowAsync(DialogService,
            new[] { new ImageLightbox.LightboxImage(RecordAvatar.Url(nameof(DrugRoute), TitleImagePhotoId)!, Route.Designation) });

    /// <summary>Toggle this record's aging exemption.</summary>
    private async Task ToggleAgingAsync(bool value)
    {
        if (User is null)
        {
            return;
        }
        try
        {
            await Recency.SetRecordExemptionAsync(nameof(DrugRoute), Route.Id, value, User);
            Snackbar.Add(value ? "Veralterung für diese Akte deaktiviert." : "Veralterung wieder aktiv.", Severity.Success);
            await Changed.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            StateHasChanged();
        }
    }
}
