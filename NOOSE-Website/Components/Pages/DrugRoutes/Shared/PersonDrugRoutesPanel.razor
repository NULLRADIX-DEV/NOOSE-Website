@* The drug routes a person is involved in, as links to their files; renders nothing without one. *@
@inject IDrugRouteService RouteService

@if (_routes.Count > 0)
{
    <MudDivider Class="my-4" />
    <MudStack Spacing="2">
        <MudText Typo="Typo.subtitle1">Drogenrouten (@_routes.Count)</MudText>
        @foreach (var r in _routes)
        {
            <MudPaper Class="pa-3" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="noose-eintrag noose-eintrag-titel">
                    <MudIcon Icon="@Icons.Material.Filled.Route" Color="Color.Primary" Size="Size.Small" />
                    <MudLink Href="@($"/drogenrouten/{r.Id}")" Typo="Typo.body2"><b>@r.Designation</b></MudLink>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@r.CaseNumber@(string.IsNullOrWhiteSpace(r.Substance) ? "" : $" · {r.Substance}")</MudText>
                    @if (r.IsArchived)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Archiviert</MudChip>
                    }
                    @if (r.IsRestricted)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Warning" />
                    }
                </MudStack>
            </MudPaper>
        }
    </MudStack>
}

@code {
    [Parameter, EditorRequired] public string PersonId { get; set; } = default!;
    [Parameter, EditorRequired] public ClaimsPrincipal User { get; set; } = default!;

    private List<DrugRoute> _routes = new();
    private string? _loadedId;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == PersonId)
        {
            return;
        }
        _loadedId = PersonId;
        _routes = await RouteService.GetForPersonAsync(PersonId, ViewerScope.From(User));
    }
}
