@* Clearing: books the whole on-hand of every ticked item down to zero. *@
@inject IEvidenceService Evidence
@inject ISnackbar Snackbar

@* a long form: full screen below 600px (noose-dialog-lang); the min-width gives way there too *@
<MudDialog Class="noose-dialog-lang">
    <DialogContent>
        <MudStack Spacing="3" Style="min-width:520px;" Class="noose-min-breite-frei">
            @if (_load)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_all.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                    Die Kammer ist bereits leer — kein Item hat einen Bestand ungleich 0.
                </MudAlert>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Von jedem angehakten Item wird der komplette Bestand auf 0 gebucht — als Herausnahme
                    auf das FIB. Der Haken an einer Kategorie hakt alle ihre Items an oder ab.
                    Die Items selbst bleiben im Katalog erhalten.
                </MudText>

                @if (_missingCategory is not null)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined">
                        In „@EvidenceCategories.Label(_missingCategory)“ hat kein Item einen Bestand ungleich 0 —
                        es ist nichts vorausgewählt.
                    </MudAlert>
                }

                @if (FixItems > 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined"
                              Icon="@Icons.Material.Filled.MoveToInbox">
                        @FixItems @(FixItems == 1 ? "angehaktes Item hat" : "angehakte Items haben") einen negativen Bestand.
                        Davon wird nichts entnommen — sie werden per Einlagerung auf 0 <b>korrigiert</b>.
                    </MudAlert>
                }

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudTextField T="string" Value="_filter" ValueChanged="FilterChanged" Immediate="true"
                                  DebounceInterval="200" Placeholder="Item filtern…"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                                  Class="flex-grow-1" Disabled="_busy" />
                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_busy"
                               StartIcon="@Icons.Material.Filled.DoneAll" OnClick="SelectAllVisible">Alle</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_busy"
                               StartIcon="@Icons.Material.Filled.CheckBoxOutlineBlank" OnClick="SelectNoneVisible">Keine</MudButton>
                </MudStack>

                @if (HasTextFilter)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        „Alle“, „Keine“ und die Kategorie-Haken wirken nur auf die @_visible.Count gefilterten Zeilen.
                    </MudText>
                }

                <MudPaper Class="pa-2" Outlined="true" Style="max-height:400px; overflow-y:auto;">
                    @if (_visible.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary pa-2">Kein Treffer.</MudText>
                    }
                    else
                    {
                        <MudStack Spacing="0">
                            @foreach (var group in _groups)
                            {
                                var rows = VisibleRows(group);
                                if (rows.Count == 0)
                                {
                                    continue;
                                }
                                var open = IsOpen(group);
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mt-1">
                                    <MudCheckBox T="bool?" TriState="true" Dense="true" Disabled="_busy"
                                                 Color="Color.Primary"
                                                 Value="@EvidenceClearingGroups.State(rows, _selected)"
                                                 ValueChanged="@(_ => ToggleGroup(rows))">
                                        <MudText Typo="Typo.subtitle2">@group.Label</MudText>
                                    </MudCheckBox>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">
                                        @GroupCount(group, rows)
                                    </MudChip>
                                    <MudSpacer />
                                    <MudIconButton Size="Size.Small" Disabled="@(_busy || HasTextFilter)"
                                                   aria-label="@($"„{group.Label}“ {(open ? "zuklappen" : "aufklappen")}")"
                                                   aria-expanded="@open"
                                                   Icon="@(open ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                   OnClick="@(() => ToggleOpen(group))" />
                                </MudStack>
                                @if (open)
                                {
                                    <div class="ml-6">
                                        @foreach (var row in rows)
                                        {
                                            <MudCheckBox T="bool" Dense="true" Disabled="_busy"
                                                         Color="@(row.OnHand < 0 ? Color.Warning : Color.Primary)"
                                                         Value="@_selected.Contains(row.Item.Id)"
                                                         ValueChanged="@(_ => Toggle(row.Item.Id))">
                                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                                    <MudText Typo="Typo.body2">@row.Item.Name</MudText>
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                             Color="@(row.OnHand < 0 ? Color.Error : Color.Success)">
                                                        Bestand: @row.OnHand
                                                    </MudChip>
                                                    @if (row.OnHand < 0)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning"
                                                                 Icon="@Icons.Material.Filled.MoveToInbox">
                                                            Korrektur +@(-row.OnHand)
                                                        </MudChip>
                                                    }
                                                </MudStack>
                                            </MudCheckBox>
                                        }
                                    </div>
                                }
                            }
                        </MudStack>
                    }
                </MudPaper>

                <MudDivider />

                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                             Icon="@Icons.Material.Filled.Outbox">
                        @TakeItems entnehmen · @TakePieces Stück
                    </MudChip>
                    @if (FixItems > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                                 Icon="@Icons.Material.Filled.MoveToInbox">
                            @FixItems korrigieren · +@FixPieces Stück
                        </MudChip>
                    }
                    <MudSpacer />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @_selected.Count von @_all.Count ausgewählt
                    </MudText>
                </MudStack>

                <MentionInput Text="@(_notes ?? string.Empty)" TextChanged="@(v => _notes = v)"
                              Label="Notiz (optional)" Lines="2" Disabled="_busy"
                              Placeholder="z. B. Abtransport durch den Dienstleister"
                              HelperText="@MentionInput.Hint" />

                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Die erzeugten Einträge stehen danach unter „Einträge“. Werden sie gelöscht, wird der
                    Bestand wieder gutgeschrieben.
                </MudText>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Abbrechen</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="ApplyAsync"
                   Disabled="@(_busy || _selected.Count == 0)"
                   StartIcon="@Icons.Material.Filled.Outbox">
            @(_busy ? "Wird gebucht…" : "Bestand auf 0 buchen")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public ClaimsPrincipal User { get; set; } = default!;

    /// <summary>Item ids ticked on open; null falls back to the category, then to everything.</summary>
    [Parameter] public IReadOnlyCollection<string>? PreselectedItemIds { get; set; }

    /// <summary>Category whose group starts ticked; null ticks everything.</summary>
    [Parameter] public string? InitialCategory { get; set; }

    private bool _load = true;
    private bool _busy;
    private string? _filter;
    private string? _notes;
    private string? _missingCategory;

    private List<EvidenceItemDisplay> _all = new();
    private List<EvidenceItemDisplay> _visible = new();
    private IReadOnlyList<EvidenceClearingGroup> _groups = Array.Empty<EvidenceClearingGroup>();
    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);
    private readonly HashSet<string> _visibleIds = new(StringComparer.Ordinal);
    private readonly HashSet<string> _collapsed = new(StringComparer.OrdinalIgnoreCase);

    private bool HasTextFilter => !string.IsNullOrWhiteSpace(_filter);

    private IEnumerable<EvidenceItemDisplay> Picked => _all.Where(r => _selected.Contains(r.Item.Id));
    private int TakeItems => Picked.Count(r => r.OnHand > 0);
    private int TakePieces => Picked.Where(r => r.OnHand > 0).Sum(r => r.OnHand);
    private int FixItems => Picked.Count(r => r.OnHand < 0);
    private int FixPieces => Picked.Where(r => r.OnHand < 0).Sum(r => -r.OnHand);

    protected override async Task OnInitializedAsync()
    {
        // read fresh: the tile grid may be minutes old and is search-filtered
        _all = (await Evidence.GetItemsAsync()).Where(r => r.OnHand != 0).ToList();
        _groups = EvidenceClearingGroups.Build(_all);

        Recompute();
        // an explicit pick may name zero-stock rows this dialog never loads, so keep _selected inside _all
        var preselect = (PreselectedItemIds ?? InitialScope().Select(r => r.Item.Id).ToList())
            .ToHashSet(StringComparer.Ordinal);
        foreach (var row in _all)
        {
            if (preselect.Contains(row.Item.Id))
            {
                _selected.Add(row.Item.Id);
            }
        }
        // an incoming category with nothing on hand would otherwise open a silently empty preselection
        if (PreselectedItemIds is null && InitialCategory is not null && _selected.Count == 0)
        {
            _missingCategory = InitialCategory;
        }
        _load = false;
    }

    /// <summary>Rows ticked on open when the caller named no items; a category narrows it to its own.</summary>
    private IEnumerable<EvidenceItemDisplay> InitialScope()
        => InitialCategory is null
            ? _all
            : _all.Where(r => EvidenceCategories.Matches(r.Item.Category, InitialCategory));

    private void FilterChanged(string? value)
    {
        _filter = value;
        Recompute();
    }

    private void Recompute()
    {
        IEnumerable<EvidenceItemDisplay> rows = _all;
        if (!string.IsNullOrWhiteSpace(_filter))
        {
            var needle = _filter.Trim();
            rows = rows.Where(r => r.Item.Name.Contains(needle, StringComparison.OrdinalIgnoreCase));
        }
        _visible = rows.ToList();
        _visibleIds.Clear();
        foreach (var row in _visible)
        {
            _visibleIds.Add(row.Item.Id);
        }
    }

    /// <summary>Rows of a group the text filter leaves standing; every group action works on these.</summary>
    private List<EvidenceItemDisplay> VisibleRows(EvidenceClearingGroup group)
        => group.Rows.Where(r => _visibleIds.Contains(r.Item.Id)).ToList();

    private string GroupCount(EvidenceClearingGroup group, List<EvidenceItemDisplay> rows)
        => rows.Count == group.Rows.Count ? $"{rows.Count}" : $"{rows.Count} von {group.Rows.Count}";

    // a filtered-out row must not hide inside a collapsed group
    private bool IsOpen(EvidenceClearingGroup group) => HasTextFilter || !_collapsed.Contains(group.Key);

    private void ToggleOpen(EvidenceClearingGroup group)
    {
        if (!_collapsed.Remove(group.Key))
        {
            _collapsed.Add(group.Key);
        }
    }

    /// <summary>Ticks a whole group, or unticks it when every visible row is already ticked.</summary>
    private void ToggleGroup(List<EvidenceItemDisplay> rows)
    {
        var clear = EvidenceClearingGroups.State(rows, _selected) is true;
        foreach (var row in rows)
        {
            if (clear)
            {
                _selected.Remove(row.Item.Id);
            }
            else
            {
                _selected.Add(row.Item.Id);
            }
        }
    }

    private void Toggle(string itemId)
    {
        if (!_selected.Remove(itemId))
        {
            _selected.Add(itemId);
        }
    }

    private void SelectAllVisible()
    {
        foreach (var row in _visible)
        {
            _selected.Add(row.Item.Id);
        }
    }

    private void SelectNoneVisible()
    {
        foreach (var row in _visible)
        {
            _selected.Remove(row.Item.Id);
        }
    }

    private async Task ApplyAsync()
    {
        if (_busy || _selected.Count == 0)
        {
            return;
        }
        _busy = true;
        try
        {
            // read the scope before booking; the tick state is what the message describes
            var scope = EvidenceClearingGroups.ScopeLabel(_groups, _selected);
            var result = await Evidence.ClearStockAsync(_selected.ToList(), _notes.TrimToNull(), User);
            // the caller must not name its own filter: the dialog's ticks may have moved since it opened
            MudDialog.Close(DialogResult.Ok(new Outcome(result, scope)));
        }
        catch (Exception ex)
        {
            // stay open so a long unticking session survives a failed booking
            Snackbar.Add(ex.Message, Severity.Error);
            _busy = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    /// <summary>Booking outcome plus a German label of what the ticks covered.</summary>
    public record Outcome(EvidenceClearingResult Result, string Scope);

    /// <summary>Opens the clearing dialog; returns the booking outcome or null if cancelled.</summary>
    public static async Task<Outcome?> ShowAsync(IDialogService dialog, ClaimsPrincipal user,
        IReadOnlyCollection<string>? preselectedItemIds = null, string? initialCategory = null)
    {
        var parameters = new DialogParameters<EvidenceClearingDialog>
        {
            { x => x.User, user },
            { x => x.PreselectedItemIds, preselectedItemIds },
            { x => x.InitialCategory, initialCategory },
        };
        var reference = await dialog.ShowAsync<EvidenceClearingDialog>("Kammer räumen", parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = true,
                BackdropClick = false,
            });
        var result = await reference.Result;
        return result is { Canceled: false, Data: Outcome outcome } ? outcome : null;
    }
}
