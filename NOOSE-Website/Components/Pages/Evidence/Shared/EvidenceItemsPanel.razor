@* Catalog of all evidence items with computed on-hand; searchable, with bulk clearing. *@
@inject IEvidenceService Evidence
@inject IProfileSuggestionService SuggestionService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MudStack Spacing="3">
    @* the menu only with the buttons it mirrors: three of them outside select mode, behind the same _mayClear *@
    <SectionHeader Title="Bestand" Wrap="Wrap.Wrap" ActionsMenu="@(_mayClear && !_selectMode ? ItemsMenu : null)">
        <Actions>
            @if (_mayClear)
            {
                @if (_selectMode)
                {
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Close"
                               OnClick="ExitSelect">Auswahl beenden</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@(_rows.Count == 0)"
                               StartIcon="@Icons.Material.Filled.Checklist" OnClick="EnterSelect">Auswählen</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                               Disabled="@(_rows.Count == 0 && !HasFilter)"
                               StartIcon="@Icons.Material.Filled.Outbox"
                               OnClick="@(() => ClearAsync(null))">
                        @ClearLabel
                    </MudButton>
                    <MudButton Href="/asservatenkammer/item/neu" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add">Neues Item</MudButton>
                }
            }
        </Actions>
    </SectionHeader>

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudTextField T="string" @bind-Value="_search" Immediate="true" DebounceInterval="300"
                      OnDebounceIntervalElapsed="@(_ => ReloadAsync())"
                      Placeholder="Item suchen…" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Clearable="true"
                      Class="flex-grow-1" />
        <MudSelect T="string" Value="_category" ValueChanged="CategoryChanged" Clearable="true" Dense="true"
                   Placeholder="Alle Kategorien" Style="min-width:200px;max-width:240px" Variant="Variant.Outlined"
                   ToStringFunc="@(c => c is null ? string.Empty : EvidenceCategories.Label(c))">
            @foreach (var c in _categories)
            {
                <MudSelectItem T="string" Value="@c">@c</MudSelectItem>
            }
            <MudSelectItem T="string" Value="@EvidenceCategories.None">Ohne Kategorie</MudSelectItem>
        </MudSelect>
        <MudSwitch T="bool" Value="_showZero" ValueChanged="ShowZeroChanged" Color="Color.Primary"
                   Label="Bestand 0 anzeigen" />
    </MudStack>

    @if (_load)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_rows.Count == 0)
    {
        @if (HasFilter)
        {
            <EmptyState Icon="@Icons.Material.Filled.Search" Title="Kein Treffer"
                        Text="@FilterMissText" />
        }
        else if (_zeroCount > 0)
        {
            <EmptyState Icon="@Icons.Material.Filled.Inventory2" Title="Kammer ist leer"
                        Text="@($"Alle {_zeroCount} Items stehen auf Bestand 0. Sie bleiben im Katalog und tauchen wieder auf, sobald etwas eingelagert wird.")">
                <Actions>
                    @if (_mayCreate)
                    {
                        <MudButton Href="/asservatenkammer/eintrag/neu" Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add">Neuer Eintrag</MudButton>
                    }
                </Actions>
            </EmptyState>
        }
        else
        {
            <EmptyState Icon="@Icons.Material.Filled.Inventory2" Title="Keine Items"
                        Text="Lege ein Item an oder erfasse einen Eintrag — neue Gegenstände werden automatisch als Item angelegt." />
        }
    }
    else
    {
        <div class="d-flex flex-wrap gap-3">
            @foreach (var r in _rows)
            {
                var picked = _selectMode && _picked.Contains(r.Item.Id);
                <MudPaper Elevation="2" Style="width:184px;cursor:pointer"
                          Class="@($"pa-2 asservat-kachel{(picked ? " asservat-kachel-gewaehlt" : string.Empty)}")"
                          role="@(_selectMode ? "checkbox" : "link")"
                          aria-checked="@(_selectMode ? (picked ? "true" : "false") : null)"
                          aria-label="@TileLabel(r)"
                          tabindex="0"
                          @onclick="@(() => ActivateTile(r))"
                          @onkeydown="@(e => TileKeyDown(e, r))">
                    @if (_selectMode)
                    {
                        <div class="asservat-kachel-haken">
                            <MudIcon Size="Size.Small" Color="@(picked ? Color.Primary : Color.Default)"
                                     Icon="@(picked ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)" />
                        </div>
                    }
                    @if (r.HasImage)
                    {
                        @* contain, not cover: these are item icons with their own margins, and cropping
                           them to fill the tile cuts the barrel off a rifle *@
                        <MudImage Src="@($"/dateien/asservate/{r.Item.Id}")" Alt="@r.Item.Name"
                                  Height="120" Width="168" ObjectFit="ObjectFit.Contain" Class="rounded" />
                    }
                    else
                    {
                        <div class="d-flex align-center justify-center rounded"
                             style="height:120px;width:168px;background:var(--mud-palette-background-gray)">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Large" Color="Color.Default" />
                        </div>
                    }
                    <MudText Typo="Typo.body2" Class="mt-1"
                             Style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@r.Item.Name</MudText>
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.NoWrap" AlignItems="AlignItems.Center"
                              Class="asservat-kachel-chips">
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(r.OnHand < 0 ? Color.Error : r.OnHand == 0 ? Color.Default : Color.Success)">
                            Bestand: @r.OnHand
                        </MudChip>
                        @if (!string.IsNullOrWhiteSpace(r.Item.Category))
                        {
                            @* full text on purpose: the chip ellipsises by width in CSS, so it shows
                               as much as fits instead of always cutting at a fixed character count *@
                            <MudTooltip Text="@r.Item.Category">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                    @r.Item.Category
                                </MudChip>
                            </MudTooltip>
                        }
                    </MudStack>
                </MudPaper>
            }
        </div>
    }

    @if (_selectMode && _mayClear)
    {
        <MudPaper Elevation="8" Class="asservat-aktionsleiste">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                <MudIcon Icon="@Icons.Material.Filled.Checklist" Color="Color.Primary" />
                <MudText Typo="Typo.body2">
                    <b>@_picked.Count</b> @(_picked.Count == 1 ? "Item" : "Items") · <b>@PickedPieces</b> Stück
                </MudText>
                @if (PickedNegatives > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">
                        @PickedNegatives negativ
                    </MudChip>
                }
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="PickAllVisible">Alle</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="PickNone">Keine</MudButton>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="@(_picked.Count == 0)"
                           StartIcon="@Icons.Material.Filled.Outbox"
                           OnClick="@(() => ClearAsync(_picked.ToList()))">Bestand auf 0</MudButton>
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;
    private bool _mayClear;

    private string ClearLabel => _category is null ? "Kammer räumen" : $"„{EvidenceCategories.Label(_category)}“ räumen";

    // the header's buttons as ⋮ entries below 600px; the clearing one last, after a line, as in every record menu
    private RenderFragment ItemsMenu => __builder =>
    {
        <MudMenuItem Icon="@Icons.Material.Filled.Add" Href="/asservatenkammer/item/neu">Neues Item</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.Checklist" Disabled="@(_rows.Count == 0)" OnClick="EnterSelect">Auswählen</MudMenuItem>
        <MudDivider Class="my-1" />
        <MudMenuItem Icon="@Icons.Material.Filled.Outbox" IconColor="Color.Warning" Disabled="@(_rows.Count == 0 && !HasFilter)"
                     OnClick="@(() => ClearAsync(null))">@ClearLabel</MudMenuItem>
    };
    private bool _mayCreate;
    private bool _selectMode;
    private bool _showZero;
    private string? _search;
    private string? _category;
    private int _zeroCount;
    private ClaimsPrincipal _user = default!;
    private List<EvidenceItemDisplay> _rows = new();
    private IReadOnlyList<string> _categories = Array.Empty<string>();

    private readonly HashSet<string> _picked = new(StringComparer.Ordinal);
    // stock of every row seen so far, so the counter survives a search that hides a picked tile
    private readonly Dictionary<string, int> _stockById = new(StringComparer.Ordinal);

    private int PickedPieces => _picked.Sum(id => Math.Abs(_stockById.GetValueOrDefault(id)));
    private int PickedNegatives => _picked.Count(id => _stockById.GetValueOrDefault(id) < 0);

    private bool HasFilter => !string.IsNullOrWhiteSpace(_search) || _category is not null;

    private string FilterMissText
    {
        get
        {
            var scope = _category switch
            {
                null => "Kein Item",
                var c when EvidenceCategories.IsNone(c) => "Kein Item ohne Kategorie",
                var c => $"Kein Item in der Kategorie „{c}“",
            };
            var miss = string.IsNullOrWhiteSpace(_search) ? $"{scope}." : $"{scope} passt zu „{_search}“.";
            // the hidden-zero switch is the likelier reason than an empty catalog, so name it
            return _zeroCount > 0 && !_showZero
                ? $"{miss} {_zeroCount} {(_zeroCount == 1 ? "Item steht" : "Items stehen")} auf Bestand 0 — mit „Bestand 0 anzeigen“ sichtbar."
                : miss;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _mayClear = _user.IsLeadership() && _user.MayWrite();
        _mayCreate = _user.MayWrite();
        _categories = await SuggestionService.GetAsync(SuggestionType.EvidenceCategory);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _load = true;
        StateHasChanged();
        var all = await Evidence.GetItemsAsync(_search, _category);
        // hide items with nothing on hand unless asked; negatives (data anomalies) stay visible in red
        _rows = _showZero ? all : all.Where(r => r.OnHand != 0).ToList();
        // an empty grid after a clearing is not an empty catalog — the empty state says which
        _zeroCount = all.Count(r => r.OnHand == 0);
        foreach (var r in _rows)
        {
            _stockById[r.Item.Id] = r.OnHand;
        }
        _load = false;
    }

    private async Task ShowZeroChanged(bool value)
    {
        _showZero = value;
        await ReloadAsync();
    }

    private async Task CategoryChanged(string? category)
    {
        _category = category;
        await ReloadAsync();
    }


    private void EnterSelect() => _selectMode = true;

    private void ExitSelect()
    {
        _selectMode = false;
        _picked.Clear();
    }

    private void ActivateTile(EvidenceItemDisplay r)
    {
        if (_selectMode)
        {
            TogglePick(r);
            return;
        }
        Nav.NavigateTo($"/asservatenkammer/item/{r.Item.Id}");
    }

    // keyboard parity for the tile click
    private void TileKeyDown(KeyboardEventArgs e, EvidenceItemDisplay r)
    {
        if (e.Key is "Enter" or " ")
        {
            ActivateTile(r);
        }
    }

    private void TogglePick(EvidenceItemDisplay r)
    {
        if (!_picked.Remove(r.Item.Id))
        {
            _picked.Add(r.Item.Id);
        }
    }

    private void PickAllVisible()
    {
        foreach (var r in _rows)
        {
            _picked.Add(r.Item.Id);
        }
    }

    private void PickNone() => _picked.Clear();

    private static string TileLabel(EvidenceItemDisplay r)
        => string.IsNullOrWhiteSpace(r.Item.Category)
            ? $"{r.Item.Name}, Bestand {r.OnHand}"
            : $"{r.Item.Name}, {r.Item.Category}, Bestand {r.OnHand}";

    private async Task ClearAsync(IReadOnlyCollection<string>? preselected)
    {
        // "Kammer räumen" inherits the active category as a preselection; an explicit pick must not be
        // narrowed by it, because _picked deliberately survives a filter change
        var outcome = await EvidenceClearingDialog.ShowAsync(DialogService, _user, preselected,
            preselected is null ? _category : null);
        if (outcome is null)
        {
            return;
        }
        var result = outcome.Result;
        _selectMode = false;
        _picked.Clear();
        await ReloadAsync();

        if (!result.Booked)
        {
            Snackbar.Add("Nichts zu räumen — die ausgewählten Items standen bereits auf 0.", Severity.Warning);
            return;
        }

        var parts = new List<string>();
        if (result.ClearedItems > 0)
        {
            parts.Add($"{result.ClearedItems} Items entnommen ({result.ClearedPieces} Stück)");
        }
        if (result.CorrectedItems > 0)
        {
            parts.Add($"{result.CorrectedItems} negative Bestände korrigiert (+{result.CorrectedPieces} Stück)");
        }
        if (result.SkippedItems > 0)
        {
            parts.Add($"{result.SkippedItems} übersprungen");
        }
        // scope comes from the dialog, not from this panel's filter — the two can disagree
        Snackbar.Add($"{outcome.Scope}: {string.Join(", ", parts)}.", Severity.Success);
    }
}
