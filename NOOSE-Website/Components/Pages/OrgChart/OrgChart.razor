@page "/organigramm"
@inject IOrgChartService OrgChartService
@inject IDecorationService Decorations

<PageTitle>Organigramm · FIB</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
        <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary" Size="Size.Large" Class="noose-mobil-aus" />
        <div>
            <MudText Typo="Typo.h5">Organigramm</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">FIB-Struktur: Board, Abteilungen, Administration Division und Taskforce-Besetzung.</MudText>
        </div>
    </MudStack>

    @if (_load)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_data is not null)
    {
        @if (!_data.HasAgents)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Keine aktiven Agenten erfasst.</MudText>
        }
        else
        {
            <div class="org">
                <div class="org-node org-root">F.I.B.</div>
                <div class="org-link"></div>
                @UnitPanel(_data.Board)
                <div class="org-link"></div>
                <div class="org-columns">
                    @foreach (var column in _data.Divisions)
                    {
                        @UnitPanel(column)
                    }
                </div>
            </div>
        }

        @if (_data.Administration.Count > 0)
        {
            <MudDivider />
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                    <MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Info" />
                    <MudText Typo="Typo.h6">Administration Division</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">· @_data.Administration.Count abteilungsübergreifend</MudText>
                </MudStack>
                <MudGrid Spacing="2">
                    @foreach (var a in _data.Administration)
                    {
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <AgentTile Agent="a" MayRealName="_mayRealName" Plaques="@PlaquesOf(a.Id)" />
                        </MudItem>
                    }
                </MudGrid>
            </MudStack>
        }

        <MudDivider />
        <MudStack Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Groups2" Color="Color.Primary" />
                <MudText Typo="Typo.h6">Taskforces</MudText>
            </MudStack>
            @if (_data.Taskforces.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@_taskforceEmptyText</MudText>
            }
            else
            {
                @foreach (var tf in _data.Taskforces)
                {
                    <MudPaper Class="pa-3" Elevation="1">
                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                                <MudLink Href="@($"/taskforces/{tf.Taskforce.Id}")" Typo="Typo.subtitle1"><b>@tf.Taskforce.Name</b></MudLink>
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">@tf.Taskforce.CaseNumber</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@TaskforceScopeDisplay.Name(tf.Taskforce.Scope)</MudChip>
                            </MudStack>
                            @if (tf.Members.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">Keine Mitglieder.</MudText>
                            }
                            else
                            {
                                <MudGrid Spacing="2">
                                    @foreach (var m in tf.Members)
                                    {
                                        <MudItem xs="12" sm="6" md="4" lg="3">
                                            <AgentTile Agent="m.Agent!" MayRealName="_mayRealName" Plaques="@PlaquesOf(m.AgentId)"
                                                         RoleText="@(TaskforceRoleDisplay.IsLead(m.Role) ? TaskforceRoleDisplay.Name(m.Role) : null)"
                                                         IsLead="@TaskforceRoleDisplay.IsLead(m.Role)" />
                                        </MudItem>
                                    }
                                </MudGrid>
                            }
                        </MudStack>
                    </MudPaper>
                }
            }
        </MudStack>
    }
</MudStack>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;
    private bool _mayRealName;
    private OrgChartData? _data;
    private IReadOnlyDictionary<string, IReadOnlyList<DecorationPlaqueView>> _plaques
        = new Dictionary<string, IReadOnlyList<DecorationPlaqueView>>();
    private string _taskforceEmptyText = "Keine genehmigten Taskforces vorhanden.";

    /// <summary>One column: title and seats against the soft limit, then the rank tiers with their agents.</summary>
    private RenderFragment<OrgChartColumn> UnitPanel => column =>
        @<section class="@(column.IsBoard ? "org-unit org-unit--board" : "org-unit")" aria-label="@column.Title">
            <header class="org-unit-head">
                <MudIcon Icon="@column.Icon" Color="@column.Colour" />
                <span class="org-unit-title">@column.Title</span>
                <span class="@(column.OverLimit ? "org-count org-count--over" : "org-count")" title="@SeatsTitle(column)">@column.Count / @column.Limit</span>
            </header>
            @if (column.Count == 0)
            {
                <p class="org-unit-empty">Keine Mitglieder.</p>
            }
            @foreach (var tier in column.Ranks)
            {
                <div class="org-tier">
                    <div class="org-node org-rank">@RankDisplay.Name(tier.Rank, column.Division)<span class="org-count">@tier.Agents.Count</span></div>
                    <ul class="org-cards">
                        @foreach (var a in tier.Agents)
                        {
                            <li>@Card(a)</li>
                        }
                    </ul>
                </div>
            }
        </section>;

    private RenderFragment<Agent> Card => a =>
        @<a class="org-card" href="@($"/personal/{a.Id}")">
            <span class="org-card-avatar">@Initials(a.Codename)</span>
            <span class="org-card-name">@(string.IsNullOrWhiteSpace(a.Codename) ? "Unbenannt" : a.Codename)</span>
            @if (_mayRealName && !string.IsNullOrWhiteSpace(a.RealName))
            {
                <span class="org-card-sub">@a.RealName</span>
            }
            @if (a.IsHRB)
            {
                <span class="org-card-badge">@DepartmentRules.ColumnLabel</span>
            }
            <DecorationStrip Plaques="@PlaquesOf(a.Id)" Max="3" Class="org-card-ehrenzeichen" />
        </a>;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateTask).User;
        _mayRealName = user.MayRealNameSee();
        _taskforceEmptyText = user.IsLeadership()
            ? "Keine genehmigten Taskforces vorhanden."
            : "Dir sind keine genehmigten Taskforces zugeteilt.";
        _data = await OrgChartService.GetAsync(user);
        try
        {
            var ids = _data.Agents.Select(a => a.Id)
                .Concat(_data.Taskforces.SelectMany(t => t.Members).Select(m => m.AgentId))
                .Distinct()
                .ToList();
            _plaques = await Decorations.GetPlaquesAsync(ids, user);
        }
        catch
        {
            /* best effort */
        }
        _load = false;
    }

    private IReadOnlyList<DecorationPlaqueView>? PlaquesOf(string agentId) => _plaques.GetValueOrDefault(agentId);

    private static string SeatsTitle(OrgChartColumn column)
        => column.OverLimit
            ? $"{column.Count} von {column.Limit} Plätzen besetzt, das weiche Limit ist überschritten"
            : $"{column.Count} von {column.Limit} Plätzen besetzt";

    private static string Initials(string? codename)
    {
        if (string.IsNullOrWhiteSpace(codename))
        {
            return "?";
        }
        var parts = codename.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return string.Concat(char.ToUpperInvariant(parts[0][0]), char.ToUpperInvariant(parts[1][0]));
        }
        var word = parts[0];
        return word.Length >= 2 ? word[..2].ToUpperInvariant() : word[..1].ToUpperInvariant();
    }
}
