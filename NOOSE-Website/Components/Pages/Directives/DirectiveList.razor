@page "/dienstanweisungen"
@attribute [Authorize(Policy = Policies.InternalAgent)]
@inject IDirectiveService DirectiveService
@using NOOSE_Website.Models.Navigation

<PageTitle>Dienstanweisungen · FIB</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.Rule"
            Title="Dienstanweisungen"
            Subtitle="Wie das FIB intern arbeitet – mit Nummer, Fassung und Kenntnisnahme">
    <Actions>
        <AuthorizeView Policy="@Policies.LeadershipWrite" Context="write">
            @* the policy lets a team lead with the admin flag through, the service does not *@
            @if (DirectiveRules.MayManage(write.User))
            {
                <MudButton Href="/dienstanweisungen/neu" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add">Neue Dienstanweisung</MudButton>
            }
        </AuthorizeView>
    </Actions>
</PageHeader>

<RecordSectionRail>
    <RecordSection Slug="geltend" Label="Geltend" Icon="@Icons.Material.Filled.Rule" Badge="@OpenCount">
        @Table(_standing, "Keine geltenden Dienstanweisungen",
            "Die Führung gibt sie über „Neue Dienstanweisung“ heraus.")
    </RecordSection>
    <RecordSection Slug="aufgehoben" Label="Aufgehoben" Icon="@Icons.Material.Filled.Block">
        @Table(_repealed, "Keine aufgehobenen Dienstanweisungen",
            "Eine aufgehobene Dienstanweisung bleibt hier lesbar, ihre Nummer wird nie neu vergeben.")
    </RecordSection>
    <AuthorizeView Policy="@Policies.LeadershipPage" Context="trash">
        <RecordSection Slug="papierkorb" Label="Papierkorb" Icon="@Icons.Material.Filled.Delete">
            <TrashPanel Kind="dienstanweisungen" />
        </RecordSection>
    </AuthorizeView>
</RecordSectionRail>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    /// <summary>Every column for the column picker, in table order.</summary>
    public static readonly IReadOnlyList<(string Key, string Label)> PhoneColumns =
    [
        ("nummer", "Nummer"), ("titel", "Titel"), ("sachgebiet", "Sachgebiet"), ("einstufung", "Einstufung"),
        ("fassung", "Fassung"), ("gueltigab", "Gültig ab"), ("status", "Status"),
    ];

    /// <summary>What a phone shows until the agent chooses.</summary>
    public static readonly IReadOnlyList<string> PhoneDefaults = ["nummer", "titel"];

    private ClaimsPrincipal _user = default!;
    private bool _load = true;
    private List<DirectiveRow> _standing = new();
    private List<DirectiveRow> _repealed = new();

    // defaults until the picker reports the stored choice, so even the first paint is narrow on a phone
    private IReadOnlySet<string> _phoneColumns = MobileColumnSet.Resolve(
        PhoneColumns.Select(c => c.Key).ToList(), PhoneDefaults, null);

    private string Col(string key) => MobileColumnSet.ClassFor(_phoneColumns, key);

    private int OpenCount => _standing.Count(r => r.MustAcknowledge);

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _standing = await DirectiveService.GetListAsync(_user, repealed: false);
        _repealed = await DirectiveService.GetListAsync(_user, repealed: true);
        _load = false;
    }

    private RenderFragment Table(IReadOnlyList<DirectiveRow> rows, string emptyTitle, string emptyText) => __builder =>
    {
        if (_load)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (rows.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Filled.Rule" Title="@emptyTitle" Text="@emptyText" />
        }
        else
        {
            <MobileColumnPicker ListKey="dienstanweisungen" Columns="PhoneColumns" Defaults="PhoneDefaults"
                                VisibleChanged="@(v => _phoneColumns = v)" />
            <MudTable Items="rows" T="DirectiveRow" Hover="true" Breakpoint="Breakpoint.None" Elevation="0" Dense="true">
                <HeaderContent>
                    <MudTh Class="@Col("nummer")">Nummer</MudTh>
                    <MudTh Class="@Col("titel")">Titel</MudTh>
                    <MudTh Class="@Col("sachgebiet")">Sachgebiet</MudTh>
                    <MudTh Class="@Col("einstufung")">Einstufung</MudTh>
                    <MudTh Class="@Col("fassung")">Fassung</MudTh>
                    <MudTh Class="@Col("gueltigab")">Gültig ab</MudTh>
                    <MudTh Class="@Col("status")">Status</MudTh>
                </HeaderContent>
                <RowTemplate Context="row">
                    <MudTd DataLabel="Nummer" Class="@Col("nummer")">
                        <MudLink Href="@($"/dienstanweisungen/{row.Id}")">@row.Label</MudLink>
                    </MudTd>
                    <MudTd DataLabel="Titel" Class="@Col("titel")">
                        <MudLink Href="@($"/dienstanweisungen/{row.Id}")">@row.Title</MudLink>
                    </MudTd>
                    <MudTd DataLabel="Sachgebiet" Class="@Col("sachgebiet")">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@(string.IsNullOrWhiteSpace(row.Subject) ? "—" : row.Subject)</MudText>
                    </MudTd>
                    <MudTd DataLabel="Einstufung" Class="@Col("einstufung")">
                        @if (row.Classification != DocumentClassification.None)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                                     Icon="@Icons.Material.Filled.Lock">@DocumentClassificationDisplay.ChipLabel(row.Classification)</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Fassung" Class="@Col("fassung")">@row.CurrentVersion</MudTd>
                    <MudTd DataLabel="Gültig ab" Class="@Col("gueltigab")">@row.ValidFrom.ToString("dd.MM.yyyy")</MudTd>
                    <MudTd DataLabel="Status" Class="@Col("status")">
                        @if (row.IsRepealed)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Aufgehoben@(row.RepealedAt is { } at ? $" am {at.ToLocalTime():dd.MM.yyyy}" : string.Empty)</MudText>
                        }
                        else
                        {
                            @if (row.MustAcknowledge)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">Zur Kenntnis nehmen</MudChip>
                            }
                            @if (row.ValidVersion is null || row.ValidVersion < row.CurrentVersion)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">gilt ab @row.ValidFrom.ToString("dd.MM.yyyy")</MudText>
                            }
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    };
}
