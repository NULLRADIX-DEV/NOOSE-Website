@* Print view of a service directive: the shown version, as plain text. *@
@page "/dienstanweisungen/{Id}/druck"
@attribute [Authorize(Policy = Policies.InternalAgent)]
@layout PrintLayout
@inject IDirectiveService DirectiveService
@inject IAccessLogService AccessLog

<PageTitle>@(_detail is null ? "Druckansicht" : $"Dienstanweisung {_detail.Row.Label}") · FIB</PageTitle>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_detail is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Diese Dienstanweisung existiert nicht (mehr) oder ist nicht sichtbar.</MudAlert>
}
else
{
    var z = _detail.Row;
    var shown = _detail.Versions.FirstOrDefault(v => v.Version == _detail.ShownVersion);
    <PrintFrame Title="@($"Dienstanweisung {z.Label}")" BackHref="@($"/dienstanweisungen/{Id}")" BackText="Zurück zur Dienstanweisung"
                PrintedBy="@_printBy" IsClassified="@(z.Classification != DocumentClassification.None)"
                Footer="FIB-interne Dienstanweisung · Weitergabe nur nach Freigabe durch die Führung.">
        <section>
            <table class="druck-felder">
                <tbody>
                    <tr><th>Nummer</th><td>@z.Label</td></tr>
                    <tr><th>Titel</th><td>@z.Title</td></tr>
                    @if (!string.IsNullOrWhiteSpace(z.Subject))
                    {
                        <tr><th>Sachgebiet</th><td>@z.Subject</td></tr>
                    }
                    <tr><th>Einstufung</th><td>@DocumentClassificationDisplay.Label(z.Classification)</td></tr>
                    <tr><th>Fassung</th><td>@_detail.ShownVersion</td></tr>
                    @if (shown is not null)
                    {
                        <tr><th>Gültig ab</th><td>@shown.ValidFrom.ToString("dd.MM.yyyy")</td></tr>
                        <tr><th>Änderungsnotiz</th><td>@shown.ChangeNote</td></tr>
                    }
                    @if (z.IsRepealed)
                    {
                        <tr>
                            <th>Aufgehoben</th>
                            <td>@(z.RepealedAt is { } repealedAt ? repealedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "—")@(string.IsNullOrWhiteSpace(_detail.RepealReason) ? string.Empty : $" · {_detail.RepealReason}")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <section>
            <h2>Text</h2>
            <RichHtml Html="@_detail.ShownHtml" Plain="true" />
        </section>
    </PrintFrame>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    /// <summary>The version to print; without it the valid one.</summary>
    [SupplyParameterFromQuery(Name = "fassung")] public int? Version { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;
    private string? _printBy;
    private DirectiveView? _detail;
    private string? _loadedId;
    private int? _loadedVersion;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id && _loadedVersion == Version)
        {
            return;
        }
        var firstOfId = _loadedId != Id;
        _loadedId = Id;
        _loadedVersion = Version;
        _load = true;

        var user = (await AuthStateTask).User;
        _printBy = user.GetCodename();
        _detail = await DirectiveService.GetDetailAsync(Id, Version, user);
        if (_detail is not null && firstOfId)
        {
            try
            {
                await AccessLog.LogViewAsync(nameof(Directive), Id);
            }
            catch
            {
                /* best effort */
            }
        }
        _load = false;
    }
}
