@page "/dienstanweisungen/neu"
@page "/dienstanweisungen/{Id}/neue-fassung"
@attribute [Authorize(Policy = Policies.LeadershipPage)]
@inject IDirectiveService DirectiveService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject ILogger<DirectiveEditor> Logger

<PageTitle>@(IsVersion ? "Neue Fassung" : "Neue Dienstanweisung") · FIB</PageTitle>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (IsVersion && _current is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        Dienstanweisung nicht gefunden oder nicht zugänglich.
        <MudButton Href="/dienstanweisungen" Variant="Variant.Text" Color="Color.Primary" Class="ml-2">Zu den Dienstanweisungen</MudButton>
    </MudAlert>
}
else if (IsVersion && _current!.Row.IsRepealed)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        Eine aufgehobene Dienstanweisung bekommt keine neue Fassung.
        <MudButton Href="@BackHref" Variant="Variant.Text" Color="Color.Primary" Class="ml-2">Zurück</MudButton>
    </MudAlert>
}
else
{
    <PageHeader Icon="@Icons.Material.Filled.Rule"
                Title="@(IsVersion ? $"Neue Fassung von {_current!.Row.Label}" : "Neue Dienstanweisung")"
                BackHref="@BackHref" />

    <MudPaper Class="pa-4" Elevation="2">
        <MudStack Spacing="3">
            <MudGrid>
                <MudItem xs="12" md="8">
                    <MudTextField @bind-Value="_title" Label="Titel" Variant="Variant.Outlined" Required="true"
                                  RequiredError="Bitte einen Titel angeben." AutoFocus="true" Immediate="true"
                                  MaxLength="DirectiveRules.MaxTitle" Counter="DirectiveRules.MaxTitle" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_subject" Label="Sachgebiet (optional)" Variant="Variant.Outlined" Immediate="true"
                                  MaxLength="DirectiveRules.MaxSubject" Counter="DirectiveRules.MaxSubject" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="DocumentClassification" @bind-Value="_classification" Label="Einstufung"
                               Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock"
                               HelperText="Bestimmt, wer die Dienstanweisung sehen darf und zur Kenntnis nehmen muss.">
                        @foreach (var option in _classificationOptions)
                        {
                            <MudSelectItem T="DocumentClassification" Value="@option">@DocumentClassificationDisplay.Label(option)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_validFrom" Label="Gültig ab" Variant="Variant.Outlined" DateFormat="dd.MM.yyyy"
                                   MinDate="_minDate" Required="true" RequiredError="Bitte ein Datum wählen."
                                   HelperText="Ab diesem Tag gilt die Fassung. Liegt er in der Zukunft, gilt bis dahin die vorige." />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_changeNote" Label="Änderungsnotiz" Variant="Variant.Outlined" Required="true"
                                  RequiredError="Bitte eine kurze Änderungsnotiz angeben." Immediate="true"
                                  MaxLength="DirectiveRules.MaxChangeNote" Counter="DirectiveRules.MaxChangeNote"
                                  HelperText="Eine Zeile: was ist neu oder anders?" />
                </MudItem>
            </MudGrid>

            @if (IsVersion)
            {
                <div>
                    <MudSwitch T="bool" @bind-Value="_requiresAcknowledgment" Color="Color.Primary" Label="Verlangt erneute Kenntnisnahme" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Für eine reine Schreibkorrektur ausschalten.</MudText>
                </div>
            }

            <RichTextEditor @ref="_editor" @key="_editorRevision" Value="@_html" DraftKey="@TextKey" MinHeight="420px" />

            <FormActions>
                <MudButton Href="@BackHref" Variant="Variant.Text" Color="Color.Default">Abbrechen</MudButton>
                <AuthorizeView Policy="@Policies.LeadershipWrite" Context="write">
                    @if (DirectiveRules.MayManage(write.User))
                    {
                        <MudButton OnClick="SaveAsync" Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save" Disabled="_saves">Speichern</MudButton>
                    }
                </AuthorizeView>
            </FormActions>
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter] public string? Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private RichTextEditor? _editor;
    private ClaimsPrincipal _user = default!;
    private bool _load = true;
    private bool _saves;
    private string? _loadedKey;
    private DirectiveView? _current;

    private string _title = string.Empty;
    private string? _subject;
    private DocumentClassification _classification;
    // the level the page opened with; loosening it asks for a reason
    private DocumentClassification _loadedClassification;
    private List<DocumentClassification> _classificationOptions = new();
    private DateTime? _validFrom;
    private DateTime? _minDate;
    private string _changeNote = string.Empty;
    private bool _requiresAcknowledgment = true;
    // the version the editor opened on; a newer one in the meantime refuses the save
    private int _expectedVersion;
    private string? _html;
    private int _editorRevision;

    private bool IsVersion => !string.IsNullOrEmpty(Id);

    private string TextKey => $"dienstanweisung:{(Id ?? "neu")}:text";

    private string BackHref => IsVersion ? $"/dienstanweisungen/{Id}" : "/dienstanweisungen";

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _classificationOptions = DocumentViewerScope.AssignableOptions(_user).ToList();
    }

    // both routes bind this component, so a switch between them reloads here
    protected override async Task OnParametersSetAsync()
    {
        var key = Id ?? "neu";
        if (_loadedKey == key)
        {
            return;
        }
        _loadedKey = key;
        _load = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var today = MeetingTime.Day(DateTime.UtcNow);
        _current = null;
        _title = string.Empty;
        _subject = null;
        _classification = DocumentClassification.None;
        _html = null;
        _minDate = null;
        _validFrom = today.ToDateTime(TimeOnly.MinValue);
        _changeNote = "Erstfassung";
        _requiresAcknowledgment = true;

        if (IsVersion)
        {
            // the newest version, not the valid one: it is what the new wording builds on
            var view = await DirectiveService.GetDetailAsync(Id!, null, _user);
            if (view is not null && view.ShownVersion != view.Row.CurrentVersion)
            {
                view = await DirectiveService.GetDetailAsync(Id!, view.Row.CurrentVersion, _user);
            }
            _current = view;
            if (view is not null)
            {
                var row = view.Row;
                _title = row.Title;
                _subject = row.Subject;
                _classification = row.Classification;
                _html = view.ShownHtml;
                _expectedVersion = row.CurrentVersion;
                // a version may not start before the one it replaces
                _minDate = row.ValidFrom.ToDateTime(TimeOnly.MinValue);
                _validFrom = (row.ValidFrom > today ? row.ValidFrom : today).ToDateTime(TimeOnly.MinValue);
                _changeNote = string.Empty;
            }
        }

        _loadedClassification = _classification;
        if (!_classificationOptions.Contains(_classification))
        {
            _classificationOptions.Add(_classification);
        }
        _editorRevision++;
        _load = false;
    }

    private async Task SaveAsync()
    {
        if (_saves)
        {
            return;
        }
        if (string.IsNullOrWhiteSpace(_title))
        {
            Snackbar.Add("Bitte einen Titel angeben.", Severity.Warning);
            return;
        }
        if (_validFrom is null)
        {
            Snackbar.Add("Bitte „Gültig ab“ wählen.", Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_changeNote))
        {
            Snackbar.Add("Bitte eine kurze Änderungsnotiz angeben.", Severity.Warning);
            return;
        }

        string? secrecyReason = null;
        if (IsVersion)
        {
            secrecyReason = await CriticalReasonPrompt.SecrecyAsync(DialogService, _loadedClassification, _classification);
            if (secrecyReason is null)
            {
                return;
            }
        }

        _saves = true;
        try
        {
            var html = _editor is null ? _html ?? string.Empty : await _editor.GetHtmlAsync();
            var validFrom = DateOnly.FromDateTime(_validFrom.Value);
            string id;
            if (IsVersion)
            {
                id = Id!;
                await DirectiveService.PublishVersionAsync(id, new DirectiveVersionInput(
                    _title, _subject, _classification, html, validFrom, _changeNote,
                    _requiresAcknowledgment, _expectedVersion, secrecyReason), _user);
            }
            else
            {
                id = await DirectiveService.CreateAsync(
                    new DirectiveInput(_title, _subject, _classification, html, validFrom, _changeNote), _user);
            }

            // stored from here on, so the browser drops the draft
            if (_editor is not null)
            {
                await _editor.MarkSavedAsync();
            }
            Snackbar.Add(IsVersion ? "Neue Fassung gespeichert." : "Dienstanweisung gespeichert.", Severity.Success);
            Nav.NavigateTo($"/dienstanweisungen/{id}");
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving a directive failed (directive={DirectiveId})", Id);
            Snackbar.Add("Das Speichern ist fehlgeschlagen. Der Entwurf bleibt erhalten.", Severity.Error);
        }
        finally
        {
            _saves = false;
        }
    }
}
