@page "/"
@layout PublicSiteLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using NOOSE_Website.Models.Public
@inject IPublicModuleService ModuleService
@inject IPublicSituationService Situation
@inject IPublicStatisticsService Statistics
@inject IPublicWantedService Wanted
@inject IPressReleaseService Press

<PageTitle>FIB · Federal Investigation Bureau</PageTitle>

<LinkPreview Title="Federal Investigation Bureau"
             Description="Das FIB bündelt die staatliche Gefahrenabwehr und Aufklärung an einer Stelle. Diese Seite ist der öffentliche Zugang zur Behörde." />

@* a plain block around the page, invisible in the layout: the anchor Landing.razor.css reaches into MudBlazor from *@
<div class="landing">
<MudStack Spacing="4">

    <MudPaper Elevation="4" Class="pa-4 pa-sm-8">
        <MudStack Spacing="5">
            <MudStack Row="true" Spacing="5" Wrap="Wrap.Wrap" AlignItems="AlignItems.Start">
                <MudStack Spacing="2" Style="flex:2 1 420px;">
                    <MudText Typo="Typo.overline" Color="Color.Primary">Federal Investigation Bureau</MudText>
                    <MudText Typo="Typo.h3" Style="font-weight:700;line-height:1.15;">Defending Our Nation. Securing the Future.</MudText>
                    <MudText Typo="Typo.body1" Class="mud-text-secondary" Style="max-width:640px;">
                        Das FIB bündelt die staatliche Gefahrenabwehr und Aufklärung an einer Stelle. Diese Seite ist der
                        öffentliche Zugang zur Behörde – mit Informationen für Interessierte und Bewerber. Der interne
                        Aktenbestand bleibt den Agenten vorbehalten.
                    </MudText>
                </MudStack>

                @if (_situation is not null)
                {
                    <MudPaper Outlined="true" Class="pa-5" Style="flex:1 1 260px;">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.overline" Class="mud-text-secondary">Gefahrenlage</MudText>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.Speed" Style="@PublicSituationLevelDisplay.TextStyle(_situation.Level)" Size="Size.Large" />
                                <MudText Typo="Typo.h5" Style="@(PublicSituationLevelDisplay.TextStyle(_situation.Level) + "font-weight:700;")">
                                    @PublicSituationLevelDisplay.Name(_situation.Level)
                                </MudText>
                            </MudStack>
                            @if (_situation.Since is { } since)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    seit @since.ToLocalTime().ToString("dd.MM.yyyy")
                                </MudText>
                            }
                            <MudButton Href="/lage" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.ArrowForward">Zur Einschätzung</MudButton>
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>

            @if (_numbers.HasAny)
            {
                <MudDivider />

                <MudStack Spacing="2">
                    <MudText Typo="Typo.overline" Class="mud-text-secondary">Zahlen der Behörde</MudText>
                    @* StatTile deliberately without Href: this page renders statically, so the tile's click handler
                       never runs and a tile that looks like a link would be a dead affordance *@
                    <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap">
                        @if (_numbers.OpenNotices is { } openNotices)
                        {
                            <div class="landing-kachel" style="flex:1 1 190px;">
                                <StatTile Icon="@Icons.Material.Filled.PersonSearch" Colour="Color.Primary"
                                          Label="Laufende Fahndungen" Value="@openNotices.ToString("N0")"
                                          Hint="Derzeit öffentlich ausgeschrieben." />
                            </div>
                        }
                        @if (_numbers.CapturedNotices is { } captured)
                        {
                            <div class="landing-kachel" style="flex:1 1 190px;">
                                <StatTile Icon="@Icons.Material.Filled.Inventory2" Colour="Color.Success"
                                          Label="Abgeschlossen" Value="@captured.ToString("N0")"
                                          Hint="Abgeschlossene Ausschreibungen seit Beginn." />
                            </div>
                        }
                        @if (_numbers.TipsReceived is { } tips)
                        {
                            @* the two sub-figures used to be tiles of their own; they are shares OF this number,
                               so they belong in its hint rather than in the same row as their own total *@
                            <div class="landing-kachel" style="flex:1 1 190px;">
                                <StatTile Icon="@Icons.Material.Filled.TipsAndUpdates" Colour="Color.Info"
                                          Label="Hinweise" Value="@tips.ToString("N0")"
                                          Hint="@TipsHint(tips)" />
                            </div>
                        }
                        @if (_numbers.RewardsPaid is { } paid)
                        {
                            <div class="landing-kachel" style="flex:1 1 190px;">
                                <StatTile Icon="@Icons.Material.Filled.Paid" Colour="Color.Warning"
                                          Label="Ausgezahlte Belohnungen" Value="@($"{paid.ToString("N0")} $")"
                                          Hint="Insgesamt an Hinweisgeber ausgezahlt." />
                            </div>
                        }
                    </MudStack>
                </MudStack>
            }
        </MudStack>
    </MudPaper>

    @if (_wanted.Count > 0)
    {
        <MudPaper Elevation="4" Class="pa-4 pa-sm-8">
            <MudStack Spacing="4">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.h5">Zuletzt ausgeschrieben</MudText>
                    <MudButton Href="/gesucht" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.PersonSearch">Alle Fahndungen</MudButton>
                </MudStack>

                @* a sideways strip on phones (Landing.razor.css): three cards stacked would fill two screens *@
                <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap" AlignItems="AlignItems.Stretch" Class="landing-streifen">
                    @foreach (var card in _wanted)
                    {
                        <MudPaper Outlined="true" Class="pa-0" Style="flex:1 1 240px;">
                            <MudLink Href="@($"/gesucht/{card.CaseNumber}")" Underline="Underline.None" Color="Color.Inherit">
                                @if (card.HasPhoto)
                                {
                                    <MudImage Src="@($"/gesucht/{card.CaseNumber}/foto")" Alt="@card.DisplayName"
                                              ObjectFit="ObjectFit.Cover" Width="100" Height="160" Fluid="true"
                                              Class="rounded-t" Style="width:100%;object-position:center 25%;" />
                                }
                                <MudStack Spacing="1" Class="pa-4">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                        @PublicWantedKindDisplay.Name(card.Kind)
                                    </MudChip>
                                    <MudText Typo="Typo.h6" Style="@NameStyle(card.Kind)">@card.DisplayName</MudText>
                                    @if (_bounties.TryGetValue(card.CaseNumber, out var bounty))
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Warning">
                                            @(bounty.IsCap ? "bis " : string.Empty)@bounty.Total.ToString("N0") $
                                        </MudText>
                                    }
                                </MudStack>
                            </MudLink>
                        </MudPaper>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>
    }

    @if (_press is not null || _tipsEnabled)
    {
        <MudStack Row="true" Spacing="4" Wrap="Wrap.Wrap" AlignItems="AlignItems.Stretch">
            @if (_press is not null)
            {
                <MudPaper Elevation="4" Class="pa-6" Style="flex:2 1 380px;">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.overline" Class="mud-text-secondary">Aktuelle Pressemitteilung</MudText>
                        <MudText Typo="Typo.h6">@_press.Title</MudText>
                        @if (_press.PublishedAt is { } pressDate)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @pressDate.ToLocalTime().ToString("dd.MM.yyyy")
                            </MudText>
                        }
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@_press.Teaser</MudText>
                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mt-2">
                            <MudButton Href="@($"/presse/{_press.CaseNumber}")" Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Feed">Mitteilung lesen</MudButton>
                            <MudButton Href="/presse" Variant="Variant.Text" Color="Color.Default">Alle Mitteilungen</MudButton>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            }

            @if (_tipsEnabled)
            {
                <MudPaper Elevation="4" Class="pa-6" Style="flex:1 1 300px;">
                    <MudStack Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.TipsAndUpdates" Color="Color.Primary" Size="Size.Large" />
                        <MudText Typo="Typo.h6">Etwas beobachtet?</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            Jeder Hinweis wird geprüft. Auf Wunsch bleibst du dabei anonym – für eine ausgesetzte
                            Belohnung ist allerdings ein Name nötig.
                        </MudText>
                        <MudButton Href="/hinweis" Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.ArrowForward" Class="mt-2">Hinweis geben</MudButton>
                    </MudStack>
                </MudPaper>
            }
        </MudStack>
    }

    <MudPaper Elevation="4" Class="pa-4 pa-sm-8">
        <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap" AlignItems="AlignItems.Stretch">
            @if (_careersEnabled)
            {
                <MudPaper Outlined="true" Class="pa-5" Style="flex:1 1 280px;">
                    <MudStack Spacing="2" Style="height:100%">
                        <MudIcon Icon="@Icons.Material.Filled.WorkOutline" Color="Color.Primary" Size="Size.Large" />
                        <MudText Typo="Typo.h6">Karriere beim FIB</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            Du möchtest Teil der Behörde werden? Informiere dich über das Auswahlverfahren und reiche deine
                            Bewerbung vertraulich über das Portal ein.
                        </MudText>
                        <MudButton Href="/karriere" Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.ArrowForward" Class="mt-auto">Zur Karriere-Seite</MudButton>
                    </MudStack>
                </MudPaper>
            }

            <MudPaper Outlined="true" Class="pa-5" Style="flex:1 1 280px;">
                <MudStack Spacing="2" Style="height:100%">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" Size="Size.Large" />
                    <MudText Typo="Typo.h6">Bürgerkonto</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Melde dich mit Discord an und gib Vor- und Nachnamen an, um Hinweise zu übermitteln und
                        ihren Stand zu verfolgen.
                    </MudText>
                    <AuthorizeView>
                        <Authorized Context="citizenCtx">
                            @* open to every account: an agent, partner or applicant has a civilian identity too *@
                            <MudButton Href="/buerger" Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Person" Class="mt-auto">Zum Bürgerbereich</MudButton>
                        </Authorized>
                        <NotAuthorized>
                            @if (_registrationEnabled)
                            {
                                <form method="post" action="/Account/PerformExternalLogin" class="mt-auto">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="returnUrl" value="/buerger" />
                                    <input type="hidden" name="source" value="buerger" />
                                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Login">Mit Discord anmelden</MudButton>
                                </form>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-auto">@_registrationOfflineText</MudText>
                            }
                        </NotAuthorized>
                    </AuthorizeView>
                </MudStack>
            </MudPaper>

            <AuthorizeView>
                <Authorized Context="agentCtx">
                    @* only for someone who actually has an inward area: for a citizen and for an anonymous
                       visitor this tile was a disabled button and nothing else *@
                    @if (!agentCtx.User.IsCitizen())
                    {
                        <MudPaper Outlined="true" Class="pa-5" Style="flex:1 1 280px;">
                            <MudStack Spacing="2" Style="height:100%">
                                <MudIcon Icon="@Icons.Material.Filled.Shield" Color="Color.Primary" Size="Size.Large" />
                                <MudText Typo="Typo.h6">Dienstzugang</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                    Weiter zu deinem eigenen Bereich.
                                </MudText>
                                @if (agentCtx.User.IsApplicant())
                                {
                                    <MudButton Href="/portal" Variant="Variant.Outlined" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Badge" Class="mt-auto">Zum Bewerber-Portal</MudButton>
                                }
                                else
                                {
                                    <MudButton Href="/dashboard" Variant="Variant.Outlined" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Login" Class="mt-auto">Zum Agent-Portal</MudButton>
                                }
                            </MudStack>
                        </MudPaper>
                    }
                </Authorized>
            </AuthorizeView>
        </MudStack>
    </MudPaper>

</MudStack>
</div>

@code {
    /// <summary>How many notices the start page shows before pointing at the board.</summary>
    private const int WantedPreview = 3;

    /// <summary>The two shares of the tip figure, in the tile they belong to instead of two tiles of their own.</summary>
    private string TipsHint(int received)
    {
        // not "über diese Seite": the figure carries the agency's record from before this site existed
        var parts = new List<string> { $"{received:N0} insgesamt eingegangen" };
        if (_numbers.TipsConfirmed is { } confirmed)
        {
            parts.Add($"{confirmed:N0} davon bestätigt");
        }
        if (_numbers.TipsLedToCapture is { } led)
        {
            parts.Add($"{led:N0} führten zu einer Festnahme");
        }
        return string.Join(", ", parts) + ".";
    }

    private bool _careersEnabled;
    private bool _registrationEnabled;
    private bool _tipsEnabled;
    private string _registrationOfflineText = "Neue Bürgerkonten können derzeit nicht angelegt werden.";

    private PublicSituationState? _situation;
    private PublicStatistics _numbers = PublicStatistics.Empty;
    private IReadOnlyList<PublicWantedCard> _wanted = [];
    private IReadOnlyDictionary<string, PublicBounty> _bounties = PublicWantedBoard.NoBounties;
    private PublicPressCard? _press;

    protected override async Task OnInitializedAsync()
    {
        // read per source rather than in one block: the start page has to come up when one of them is down, and a
        // single catch would blank every section because of the first failure
        // an unreadable switch board reads as "everything off", which is the safe direction and what the page did
        // before: nothing announces itself while the agency cannot say whether it is on
        var snapshot = await SafeAsync(() => ModuleService.GetAsync(), new PublicModuleSnapshot(false, []));
        _careersEnabled = snapshot.IsEnabled(PublicModules.Careers);
        _registrationEnabled = snapshot.IsEnabled(PublicModules.CitizenRegistration);
        _tipsEnabled = snapshot.IsEnabled(PublicModules.Tips);
        // an existing citizen keeps their access, so only the sign-up path reads the switch
        var offline = snapshot.Find(PublicModules.CitizenRegistration)?.OfflineText;
        if (!string.IsNullOrWhiteSpace(offline))
        {
            _registrationOfflineText = offline;
        }

        _situation = await SafeAsync<PublicSituationState?>(() => Situation.GetPublishedAsync(), null);

        _numbers = await SafeAsync(() => Statistics.GetPublishedAsync(), PublicStatistics.Empty);

        var board = await SafeAsync(() => Wanted.GetBoardAsync(), PublicWantedBoard.Empty);
        // already newest first, and the module switches are folded into the snapshot
        _wanted = board.Cards.Take(WantedPreview).ToList();
        _bounties = board.BountyByCaseNumber;

        var press = await SafeAsync(() => Press.GetPublishedAsync(), PublicPressSnapshot.Empty);
        _press = press.Cards.FirstOrDefault();
    }

    private static async Task<T> SafeAsync<T>(Func<Task<T>> read, T fallback)
    {
        try
        {
            return await read();
        }
        catch
        {
            /* best effort */
            return fallback;
        }
    }

    /// <summary>A licence plate reads as a plate, not as a name.</summary>
    private static string? NameStyle(PublicWantedKind kind)
        => WantedKinds.IsItem(kind) ? "font-family:monospace;letter-spacing:.08em;" : null;
}
