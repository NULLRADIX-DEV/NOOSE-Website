@page "/hinweis"
@page "/hinweis/gestellt"
@layout PublicSiteLayout
@attribute [AllowAnonymous]
@using NOOSE_Website.Models.Public
@using NOOSE_Website.Services.Public
@inject ITipService Tips
@inject IBuergerService BuergerService
@inject IPublicWantedService Wanted
@inject NavigationManager Nav
@inject ISnackbar Snackbar

@* interactive on purpose: this is a form. The wanted profile that links here stays static and only carries a link *@
@* two routes, one component: /hinweis is the observation, /hinweis/gestellt the capture report. The mode comes from
   the PATH, never from a query parameter - parsing an attacker-supplied enum on an [AllowAnonymous] page is an
   HTTP 500 waiting to happen (precedent ?vorschau=1, WarnhinweisColours) *@

<PageTitle>@(_capture ? "Person gestellt melden" : "Hinweis geben") · FIB</PageTitle>

<LinkPreview Title="@PreviewTitle" Description="@PreviewText" />

@* keyed: both routes bind the same component type, so Blazor reuses the instance and the gate - which decides in
   OnInitializedAsync - would keep answering for the module of the route we came from *@
<PublicModuleGate @key="_module" Module="@_module" Title="@(_capture ? "Person gestellt melden" : "Hinweis geben")">
<MudPaper Elevation="4" Class="pa-4 pa-sm-8">
    <MudStack Spacing="4">
        <MudStack Spacing="2">
            <MudText Typo="Typo.overline" Color="Color.Primary">
                @(_capture ? "Ergreifungsmeldung" : "Bürgerhinweis")
            </MudText>
            <MudText Typo="Typo.h4">@(_capture ? "Person gestellt melden" : "Beobachtung melden")</MudText>
            <MudText Typo="Typo.body1" Class="mud-text-secondary" Style="max-width:680px;">
                @if (_capture)
                {
                    @* the standing advice is not repeated here: this form is the way in for a handover that has
                       happened, and the caution belongs on the notice, not on the receipt *@
                    <text>
                        Hier meldest du, dass du eine gesuchte Person gestellt hast. Das FIB übernimmt ab hier —
                        halte sie nur so lange fest, wie es für dich sicher ist.
                    </text>
                }
                else
                {
                    <text>
                        Jeder Hinweis wird von einem Agenten gelesen und bewertet. Schätze das Risiko realistisch
                        ein und halte Abstand, wenn eine Person bewaffnet sein könnte.
                    </text>
                }
            </MudText>
        </MudStack>

        @if (_caseNumber is not null)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">
                <MudStack Spacing="2">
                    <div>
                        @(_capture ? "Deine Ergreifungsmeldung" : "Dein Hinweis") wurde unter dem Aktenzeichen
                        <b>@_caseNumber</b> aufgenommen.
                        @if (_capture)
                        {
                            <text>Ein Agent meldet sich im Schriftwechsel — lass die Seite offen.</text>
                        }
                    </div>
                    <div>
                        <MudButton Href="/buerger/hinweise" Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.TipsAndUpdates">Meine Hinweise</MudButton>
                    </div>
                </MudStack>
            </MudAlert>
        }
        else
        {
            <AuthorizeView>
                <NotAuthorized>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        Melde dich mit Discord an, um einen Hinweis zu übermitteln und seinen Stand zu verfolgen.
                    </MudAlert>
                    <div>
                        <form method="post" action="/Account/PerformExternalLogin">
                            <AntiforgeryToken />
                            <input type="hidden" name="returnUrl" value="@ReturnUrl()" />
                            <input type="hidden" name="source" value="buerger" />
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                                       Size="Size.Large" StartIcon="@Icons.Material.Filled.Login">
                                Mit Discord anmelden
                            </MudButton>
                        </form>
                    </div>
                </NotAuthorized>
                <Authorized Context="authCtx">
                    @if (!_ready)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    }
                    else if (_needsProfile)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                            Für eine Einreichung brauchen wir deinen Vor- und Nachnamen — ohne ihn lässt sich weder
                            eine Rückfrage noch eine Belohnung abwickeln.
                        </MudAlert>
                        <div>
                            <MudButton Href="/buerger/profil" Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Badge">Angaben ergänzen</MudButton>
                        </div>
                    }
                    else if (_blocked)
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                            Dieses Konto ist für Einreichungen gesperrt. Öffentliche Inhalte kannst du weiterhin einsehen.
                        </MudAlert>
                    }
                    else
                    {
                        @if (_reference is not null)
                        {
                            <MudAlert Severity="Severity.Normal" Variant="Variant.Filled" Dense="true"
                                      Icon="@Icons.Material.Filled.PersonSearch">
                                Bezug: <b>@_reference.DisplayName</b> (@_reference.CaseNumber)
                            </MudAlert>
                        }
                        else if (_capture)
                        {
                            @* no notice, nothing to report against: the way out is the board, not an empty form *@
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                                <MudStack Spacing="2">
                                    <div>
                                        Eine Ergreifungsmeldung braucht die Ausschreibung, um die es geht. Öffne die
                                        Person auf der Fahndungsliste und melde von dort.
                                    </div>
                                    <div>
                                        <MudButton Href="/gesucht" Variant="Variant.Filled" Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.PersonSearch">Zur Fahndung</MudButton>
                                    </div>
                                </MudStack>
                            </MudAlert>
                        }
                        else if (!string.IsNullOrWhiteSpace(Fahndung))
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                                Zu diesem Aktenzeichen läuft keine Ausschreibung. Dein Hinweis wird ohne Bezug aufgenommen.
                            </MudAlert>
                        }

                        @if (_capture && _reference is not null)
                        {
                            <MudRadioGroup T="TipHandover?" @bind-Value="_input.Handover">
                                @foreach (var state in TipHandoverDisplay.All)
                                {
                                    <MudRadio T="TipHandover?" Value="@((TipHandover?)state)" Color="Color.Primary">
                                        @TipHandoverDisplay.Name(state)
                                    </MudRadio>
                                }
                            </MudRadioGroup>
                            <MudTextField @bind-Value="_input.HandoverLocation"
                                          Label="@(_input.Handover is { } h
                                              ? TipHandoverDisplay.LocationLabel(h)
                                              : "Ort")"
                                          Variant="Variant.Outlined" Immediate="true"
                                          MaxLength="@CaptureRules.MaxLocationLength"
                                          Counter="@CaptureRules.MaxLocationLength"
                                          HelperText="Straße, Gebäude oder Wache — je genauer, desto schneller ist jemand da." />
                        }

                        <MudTextField @bind-Value="_input.Text"
                                      Label="@(_capture ? "Was ist passiert?" : "Deine Beobachtung")" Lines="8"
                                      Variant="Variant.Outlined" Immediate="true"
                                      MaxLength="@TipRules.MaxLength" Counter="@TipRules.MaxLength"
                                      HelperText="@($"Wann, wo, wer, was — mindestens {TipRules.MinLength} Zeichen.")" />

                        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            @* Accept mirrors the server allowlist and MaxFileSize the server cap: with image/*
                               a HEIC or SVG passed the dialog and was only refused after Send, and exceeding the
                               limit surfaced the framework's untranslated English message *@
                            <MudFileUpload T="IBrowserFile" FilesChanged="OnFileChanged"
                                           Accept="image/jpeg,image/png,image/webp,image/gif"
                                           MaxFileSize="@TipUploadLimit">
                                <CustomContent>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.AddAPhoto"
                                               OnClick="@context.OpenFilePickerAsync">Bild anhängen</MudButton>
                                </CustomContent>
                                <SelectedTemplate />
                            </MudFileUpload>
                            @if (_file is not null)
                            {
                                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined"
                                         OnClose="@(() => _file = null)">@_file.Name</MudChip>
                            }
                        </MudStack>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Optional: ein Bild (JPG, PNG, WEBP, GIF), maximal @(TipUploadLimit / (1024 * 1024)) MB.
                            @if (_capture)
                            {
                                <text>Du kannst @CaptureRules.PerDay Ergreifungsmeldungen in 24 Stunden abgeben.</text>
                            }
                            else if (_quota is { } quota)
                            {
                                <text>Du kannst @quota Hinweise in 24 Stunden einreichen.</text>
                            }
                        </MudText>

                        @if (_capture)
                        {
                            @* no anonymity switch at all: the service refuses it on this path, and offering a
                               choice that is then overruled reads as a broken promise *@
                            <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="max-width:680px;">
                                Diese Meldung ist nicht anonym — für die Übergabe und eine mögliche Belohnung müssen
                                wir wissen, mit wem wir es zu tun haben.
                            </MudText>
                        }
                        else
                        {
                            <MudCheckBox T="bool" @bind-Value="_input.WantsAnonymity" Color="Color.Primary"
                                         Label="Meinen Namen gegenüber den Bearbeitern nicht anzeigen" />
                            @if (_input.WantsAnonymity)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="max-width:680px;">
                                    Anonym heißt: die Bearbeiter sehen deinen Namen nicht. Für eine Belohnung muss die
                                    Führungsebene die Anonymität später ausdrücklich aufheben — ohne diesen Schritt ist
                                    keine Auszahlung möglich.
                                </MudText>
                            }
                        }

                        @if (!_capture || _reference is not null)
                        {
                            <div>
                                <MudButton OnClick="SubmitAsync" Disabled="_busy" Variant="Variant.Filled"
                                           Color="@(_capture ? Color.Error : Color.Primary)" Size="Size.Large"
                                           StartIcon="@Icons.Material.Filled.Send">
                                    @(_capture ? "Ergreifung melden" : "Hinweis absenden")
                                </MudButton>
                            </div>
                        }
                    }
                </Authorized>
            </AuthorizeView>
        }

        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            Falsche Angaben sind strafbar. Bei akuter Gefahr wähle den Notruf statt dieses Formulars.
        </MudText>
    </MudStack>
</MudPaper>
</PublicModuleGate>

@code {
    // bound as string: Blazor answers a value it cannot parse with HTTP 500, and anyone can append a query
    [Parameter]
    [SupplyParameterFromQuery(Name = "fahndung")]
    public string? Fahndung { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private readonly TipInput _input = new();
    private IBrowserFile? _file;
    private PublicWantedDetail? _reference;
    private ClaimsPrincipal _user = default!;
    private bool _ready;
    private bool _busy;
    private bool _blocked;
    private bool _needsProfile;
    // the REAL quota, which rises with the trust tier: TipRules.PerDay is only the tier-1 value
    private int? _quota;
    private string? _caseNumber;
    private string? _loadedReference;

    // read off the path, not off a query parameter: there is no user input to parse, so there is nothing to
    // reject and no 500 to trigger
    private bool _capture;
    private string _module = PublicModules.Tips;

    /// <summary>Headline of the preview card; the two routes are two different errands.</summary>
    private string PreviewTitle => _capture ? "Person gestellt melden" : "Beobachtung melden";

    /// <summary>Sentence of the preview card, in the words the page itself opens with.</summary>
    private string PreviewText => _capture
        ? "Hier meldest du, dass du eine gesuchte Person gestellt hast. Das FIB übernimmt ab hier."
        : "Jeder Hinweis wird von einem Agenten gelesen und bewertet.";

    protected override async Task OnParametersSetAsync()
    {
        // before anything else: the gate above is keyed on _module, and the header reads _capture
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        var query = path.IndexOf('?');
        // exact, not EndsWith: the route is known, and a looser match would answer for paths that do not exist
        _capture = string.Equals((query < 0 ? path : path[..query]).Trim('/'),
            "hinweis/gestellt", StringComparison.OrdinalIgnoreCase);
        _module = _capture ? PublicModules.CaptureReports : PublicModules.Tips;
        _input.Kind = _capture ? TipKind.Ergreifung : TipKind.Beobachtung;
        if (_capture)
        {
            // the switch is not rendered here; clearing it keeps the input honest when someone ticked it on the
            // observation route and then switched. The service refuses it either way
            _input.WantsAnonymity = false;
        }

        _user = (await AuthStateTask).User;
        if (_user.MayUseCitizenPortal() && !_ready)
        {
            try
            {
                var profile = await BuergerService.GetOwnAsync(_user);
                _needsProfile = profile is null
                    || string.IsNullOrWhiteSpace(profile.FirstName)
                    || string.IsNullOrWhiteSpace(profile.LastName);
                _blocked = profile?.IsBlocked ?? false;
                _quota = profile is null ? null : TipTrust.QuotaFor(profile.ConfirmedTips);
            }
            catch
            {
                /* best effort */
            }
            _ready = true;
        }

        // its own guard: navigating from one notice to another keeps the component instance
        if (_loadedReference != Fahndung)
        {
            _loadedReference = Fahndung;
            _input.WantedCaseNumber = string.IsNullOrWhiteSpace(Fahndung) ? null : Fahndung;
            try { _reference = await Wanted.GetByCaseNumberAsync(Fahndung); }
            catch { /* best effort */ _reference = null; }
        }
    }

    // refused at pick time, in German: OpenReadStream would otherwise throw the framework's English IOException
    // into the snackbar at submit time
    private void OnFileChanged(IBrowserFile? file)
    {
        if (file is not null && file.Size > TipUploadLimit)
        {
            Snackbar.Add($"Das Bild ist zu groß (maximal {TipUploadLimit / (1024 * 1024)} MB).", Severity.Warning);
            _file = null;
            return;
        }
        _file = file;
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        try
        {
            // an unresolvable reference must not cost the tip; it goes in without one
            if (_reference is null)
            {
                _input.WantedCaseNumber = null;
            }

            if (_file is null)
            {
                _caseNumber = await Tips.SubmitAsync(_input, null, null, null, _user);
            }
            else
            {
                await using var stream = _file.OpenReadStream(TipUploadLimit);
                _caseNumber = await Tips.SubmitAsync(_input, stream, _file.ContentType, _file.Name, _user, _file.Size);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    // the storage service owns the real limit; the browser stream needs a number before the service is reached
    private const long TipUploadLimit = 10 * 1024 * 1024;

    private string ReturnUrl()
    {
        var route = _capture ? "/hinweis/gestellt" : "/hinweis";
        return string.IsNullOrWhiteSpace(Fahndung)
            ? route
            : $"{route}?fahndung={Uri.EscapeDataString(Fahndung)}";
    }
}
