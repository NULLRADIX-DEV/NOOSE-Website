@page "/gefasst"
@layout PublicSiteLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using NOOSE_Website.Models.Public
@inject IPublicWantedService Wanted

<PageTitle>Gefasst · FIB</PageTitle>

<LinkPreview Title="Gefasst"
             Description="Abgeschlossene Ausschreibungen des Federal Investigation Bureau." />

<PublicModuleGate Module="@PublicModules.WantedArchive" Title="Gefasst">
<MudPaper Elevation="4" Class="pa-4 pa-sm-8">
    <MudStack Spacing="4">
        <div>
            <MudText Typo="Typo.h4">Gefasst</MudText>
            <MudText Typo="Typo.body1" Class="mud-text-secondary">
                Abgeschlossene Ausschreibungen. Der Vorwurf ist mit der Festnahme keine öffentliche Information
                mehr — hier steht nur noch, dass die Fahndung beendet ist.
            </MudText>
        </div>

        @if (_cards.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                Derzeit sind keine abgeschlossenen Ausschreibungen veröffentlicht.
            </MudAlert>
        }
        else
        {
            <MudGrid Spacing="3">
                @foreach (var card in _cards)
                {
                    <MudItem xs="12" sm="6" md="4">
                        @* deliberately no MudLink: /gesucht/{az} answers "not found" for a captured notice, so a
                           link would be a dead end that suggests a running search *@
                        <MudPaper Outlined="true" Class="pa-0" Style="height:100%;">
                            @if (card.HasPhoto)
                            {
                                <MudImage Src="@($"/gesucht/{card.CaseNumber}/foto")" Alt="@card.DisplayName"
                                          ObjectFit="ObjectFit.Cover" Width="100" Height="180" Fluid="true"
                                          Class="rounded-t" Style="width:100%;object-position:center 25%;filter:grayscale(1);" />
                            }
                            <MudStack Spacing="1" Class="pa-4">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Success">
                                        @DoneWord(card.Kind)
                                    </MudChip>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                        @PublicWantedKindDisplay.Name(card.Kind)
                                    </MudChip>
                                </MudStack>
                                <MudText Typo="Typo.h6" Style="@NameStyle(card.Kind)">@card.DisplayName</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                    @DoneWord(card.Kind) am @card.CapturedAt.ToLocalTime().ToString("dd.MM.yyyy")
                                </MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@card.CaseNumber</MudText>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }

        @if (_total > _cards.Count)
        {
            @* the cap is named rather than applied silently: a list that stops at a hundred otherwise reads as the
               whole record *@
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Angezeigt werden die @_cards.Count jüngsten von insgesamt @_total abgeschlossenen Ausschreibungen.
            </MudText>
        }

        <div>
            <MudButton Href="/gesucht" Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.PersonSearch">Laufende Fahndungen</MudButton>
        </div>
    </MudStack>
</MudPaper>
</PublicModuleGate>

@code {
    private IReadOnlyList<PublicWantedArchiveCard> _cards = [];
    private int _total;
    private bool _loaded;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded)
        {
            return;
        }
        _loaded = true;
        try
        {
            _cards = await Wanted.GetArchiveAsync();
            _total = await Wanted.GetCapturedTotalAsync();
        }
        catch
        {
            /* best effort */
        }
    }

    /// <summary>A vehicle is not caught; it is seized. The route and the heading keep the common word.</summary>
    private static string DoneWord(PublicWantedKind kind)
        => WantedKinds.IsItem(kind) ? "Sichergestellt" : "Gefasst";

    /// <summary>A licence plate reads as a plate, not as a name.</summary>
    private static string? NameStyle(PublicWantedKind kind)
        => WantedKinds.IsItem(kind) ? "font-family:monospace;letter-spacing:.08em;" : null;
}
