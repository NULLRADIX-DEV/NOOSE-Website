@page "/fuehrung"
@layout PublicSiteLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using NOOSE_Website.Models.Public
@inject IPublicLeadershipService Leadership

<PageTitle>Mitarbeiter · NOOSE</PageTitle>

<LinkPreview Title="Leitung und Mitarbeiter"
             Description="Die Behördenleitung mit Rang und Telefonnummer und alle Mitarbeiterinnen und Mitarbeiter des NOOSE mit Namen." />

<PublicModuleGate Module="@PublicModules.Leadership" Title="Mitarbeiter">
    <MudPaper Elevation="4" Class="pa-4 pa-sm-8">
        <MudStack Spacing="5">
            <MudStack Spacing="1">
                <MudText Typo="Typo.overline" Color="Color.Primary">National Office of Security Enforcement</MudText>
                <MudText Typo="Typo.h4">Leitung und Mitarbeiter</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="max-width:680px;">
                    Wer beim NOOSE Dienst tut, steht hier mit Namen. Die Behördenleitung erreichen Sie direkt
                    unter der angegebenen Telefonnummer.
                </MudText>
            </MudStack>

            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">Behördenleitung</MudText>
                @if (_roster.Leadership.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Filled.AccountTree" Title="Keine Angaben"
                                Text="Zur Behördenleitung liegen derzeit keine Angaben vor." />
                }
                else
                {
                    <MudStack Row="true" Spacing="4" Wrap="Wrap.Wrap" AlignItems="AlignItems.Stretch">
                        @foreach (var card in _roster.Leadership)
                        {
                            <MudPaper Outlined="true" Class="pa-5" Style="flex:1 1 240px;max-width:320px;">
                                <MudStack Spacing="2" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.h6" Align="Align.Center">@card.Name</MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                        @card.Title
                                    </MudChip>
                                    <MudText Typo="Typo.body2" Align="Align.Center">Tel.: @card.Phone</MudText>
                                </MudStack>
                            </MudPaper>
                        }
                    </MudStack>
                }
            </MudStack>

            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">Mitarbeiterinnen und Mitarbeiter</MudText>
                @if (_roster.Members.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Filled.Groups" Title="Keine Angaben"
                                Text="Derzeit sind keine weiteren Mitarbeiterinnen und Mitarbeiter eingetragen." />
                }
                else
                {
                    <ul class="mitarbeiterliste">
                        @foreach (var member in _roster.Members)
                        {
                            <li>@member.Name</li>
                        }
                    </ul>
                }
            </MudStack>
        </MudStack>
    </MudPaper>
</PublicModuleGate>

@code {
    private PublicRoster _roster = PublicRoster.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _roster = await Leadership.GetPublicAsync();
        }
        catch
        {
            /* best effort */
        }
    }
}
