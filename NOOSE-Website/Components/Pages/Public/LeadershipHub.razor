@page "/fuehrung"
@layout PublicSiteLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using NOOSE_Website.Models.Public
@inject IPublicLeadershipService Leadership

<PageTitle>Mitarbeiter · NOOSE</PageTitle>

<LinkPreview Title="Mitarbeiter"
             Description="Das Organigramm der Führung mit Rang und Telefonnummer und alle Mitarbeiterinnen und Mitarbeiter des NOOSE mit Namen." />

<PublicModuleGate Module="@PublicModules.Leadership" Title="Mitarbeiter">
    <MudPaper Elevation="4" Class="pa-4 pa-sm-8">
        <MudStack Spacing="5">
            <MudStack Spacing="1">
                <MudText Typo="Typo.overline" Color="Color.Primary">National Office of Security Enforcement</MudText>
                <MudText Typo="Typo.h4">Mitarbeiter</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="max-width:680px;">
                    Wer beim NOOSE Dienst tut, steht hier mit Namen. Die Führung erreichen Sie direkt unter der
                    angegebenen Telefonnummer.
                </MudText>
            </MudStack>

            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">Führung</MudText>
                @if (_roster.Leadership.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Filled.AccountTree" Title="Keine Angaben"
                                Text="Zur Führung liegen derzeit keine Angaben vor." />
                }
                else
                {
                    <div class="org-scroll">
                        <div class="org">
                            <div class="org-node org-root">N.O.O.S.E.</div>
                            @foreach (var tier in _roster.Leadership)
                            {
                                <div class="org-link"></div>
                                <div class="org-tier">
                                    <div class="org-node org-rank">@tier.Title</div>
                                    <ul class="org-leaves">
                                        @foreach (var card in tier.Cards)
                                        {
                                            <li>
                                                <div class="org-card">
                                                    @if (card.PhotoUrl is { } photo)
                                                    {
                                                        <img class="org-card-foto" src="@photo" alt="@card.Name" loading="lazy" />
                                                    }
                                                    else
                                                    {
                                                        <span class="org-card-avatar">@Initials(card.Name)</span>
                                                    }
                                                    <span class="org-card-name">@card.Name</span>
                                                    <span class="org-card-tel">Tel.: @card.Phone</span>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    </div>
                }
            </MudStack>

            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">Mitarbeiterinnen und Mitarbeiter</MudText>
                @if (_roster.Members.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Filled.Groups" Title="Keine Angaben"
                                Text="Derzeit sind keine weiteren Mitarbeiterinnen und Mitarbeiter eingetragen." />
                }
                else
                {
                    <ul class="mitarbeiterliste">
                        @foreach (var member in _roster.Members)
                        {
                            <li>@member.Name</li>
                        }
                    </ul>
                }
            </MudStack>
        </MudStack>
    </MudPaper>
</PublicModuleGate>

@code {
    private PublicRoster _roster = PublicRoster.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _roster = await Leadership.GetPublicAsync();
        }
        catch
        {
            /* best effort */
        }
    }

    /// <summary>Up to two letters of the name, shown when a card has no photo.</summary>
    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return string.Concat(char.ToUpperInvariant(parts[0][0]), char.ToUpperInvariant(parts[^1][0]));
        }
        return parts.Length == 1 ? parts[0][..1].ToUpperInvariant() : "?";
    }
}
