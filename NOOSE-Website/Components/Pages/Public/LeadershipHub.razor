@page "/fuehrung"
@layout PublicSiteLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using NOOSE_Website.Models.Public
@inject IPublicLeadershipService Leadership

<PageTitle>Führung · NOOSE</PageTitle>

<LinkPreview Title="Die Leitung der Behörde"
             Description="Wer das NOOSE führt, steht hier mit Namen. Alle weiteren Mitarbeiterinnen und Mitarbeiter bleiben aus Sicherheitsgründen unbenannt." />

<PublicModuleGate Module="@PublicModules.Leadership" Title="Führung">
    <MudPaper Elevation="4" Class="pa-4 pa-sm-8">
        <MudStack Spacing="4">
            <MudStack Spacing="1">
                <MudText Typo="Typo.overline" Color="Color.Primary">National Office of Security Enforcement</MudText>
                <MudText Typo="Typo.h4">Die Leitung der Behörde</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="max-width:680px;">
                    Wer das NOOSE führt, steht hier mit Namen. Alle weiteren Mitarbeiterinnen und Mitarbeiter
                    bleiben aus Sicherheitsgründen unbenannt.
                </MudText>
            </MudStack>

            @if (_cards.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Filled.AccountTree" Title="Noch nichts veröffentlicht"
                            Text="Zur Behördenleitung liegen derzeit keine freigegebenen Angaben vor." />
            }
            else
            {
                <MudStack Row="true" Spacing="4" Wrap="Wrap.Wrap" AlignItems="AlignItems.Stretch">
                    @foreach (var card in _cards)
                    {
                        <MudPaper Outlined="true" Class="pa-5" Style="flex:1 1 240px;max-width:300px;">
                            <MudStack Spacing="2" AlignItems="AlignItems.Center">
                                @if (card.HasPhoto)
                                {
                                    <MudImage Src="@($"/fuehrung/{card.Key}/foto")" Alt="@card.DisplayName"
                                              Width="128" Height="128" ObjectFit="ObjectFit.Cover" Class="rounded-circle" />
                                }
                                else
                                {
                                    <MudAvatar Color="Color.Primary" Style="height:128px;width:128px;font-size:2rem;">
                                        @Initials(card.DisplayName)
                                    </MudAvatar>
                                }
                                <MudText Typo="Typo.h6" Align="Align.Center">@card.DisplayName</MudText>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                    @card.Title
                                </MudChip>
                                @if (!string.IsNullOrWhiteSpace(card.RoleText))
                                {
                                    <MudText Typo="Typo.body2" Align="Align.Center" Class="mud-text-secondary">
                                        @card.RoleText
                                    </MudText>
                                }
                                @* static page: plain title attributes, no popover-based tooltip *@
                                @if (card.Decorations.Count > 0)
                                {
                                    <div class="ehrenzeichen-oeffentlich">
                                        @foreach (var d in card.Decorations)
                                        {
                                            <span class="ehrenzeichen-oeffentlich-eintrag" title="@d.Name">
                                                <span class="ehrenzeichen-plakette" aria-hidden="true"
                                                      style="--plakette-farbe:@DecorationTierDisplay.Hex(d.Tier);">
                                                    <MudIcon Icon="@DecorationSymbols.Find(d.Symbol).Icon" Size="Size.Small" />
                                                </span>
                                                <span>@d.Name</span>
                                            </span>
                                        }
                                    </div>
                                }
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            }
        </MudStack>
    </MudPaper>
</PublicModuleGate>

@code {
    private IReadOnlyList<PublicLeadershipCard> _cards = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _cards = await Leadership.GetPublicAsync();
        }
        catch
        {
            /* best effort */
        }
    }

    /// <summary>Up to two letters from the released name; the page has no other identity to fall back on.</summary>
    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return string.Concat(char.ToUpperInvariant(parts[0][0]), char.ToUpperInvariant(parts[1][0]));
        }
        return parts.Length == 1 && parts[0].Length > 0 ? parts[0][..1].ToUpperInvariant() : "?";
    }
}
