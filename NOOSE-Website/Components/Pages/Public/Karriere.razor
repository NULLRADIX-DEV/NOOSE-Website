@page "/karriere"
@layout PublicSiteLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using NOOSE_Website.Models.Recruiting
@inject ICareerRequirementsService Requirements

<PageTitle>Karriere · FIB</PageTitle>

<LinkPreview Title="Bewerbung beim Federal Investigation Bureau"
             Description="Das FIB rekrutiert ausgewählte Bewerber für den Dienst in der Criminal Investigation Division." />

<PublicModuleGate Module="@PublicModules.Careers" Title="Karriere">
<MudPaper Elevation="4" Class="pa-4 pa-sm-8">
    <MudStack Spacing="4">
        <MudText Typo="Typo.h4">Bewerbung beim Federal Investigation Bureau</MudText>
        <MudText Typo="Typo.body1" Class="mud-text-secondary">
            Das FIB rekrutiert ausgewählte Bewerber für den Dienst in der Criminal Investigation Division.
            Das Auswahlverfahren umfasst eine Sicherheitsüberprüfung, ggf. einen Eignungstest und ein
            persönliches Vorstellungsgespräch. Der gesamte Ablauf wird vertraulich über dieses Portal abgewickelt.
        </MudText>

        @if (_items.Count > 0)
        {
            <MudDivider />
            <MudStack Spacing="3">
                <MudText Typo="Typo.h6">Anforderungen</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Ohne diese Voraussetzungen wird eine Bewerbung nicht weiter geprüft.
                </MudText>

                <MudStack Spacing="3">
                    @foreach (var item in _items)
                    {
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Color="Color.Primary" Size="Size.Small"
                                     Style="margin-top:3px;flex:0 0 auto;" />
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body1">@item.Text</MudText>
                                @foreach (var alternative in item.Alternatives)
                                {
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Baseline">
                                        <MudText Typo="Typo.overline" Color="Color.Primary" Style="flex:0 0 auto;">ODER</MudText>
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@alternative</MudText>
                                    </MudStack>
                                }
                            </MudStack>
                        </MudStack>
                    }
                </MudStack>
            </MudStack>
            <MudDivider />
        }

        <AuthorizeView>
            <NotAuthorized>
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    Melde dich mit Discord an, um eine Bewerbung einzureichen und ihren Status zu verfolgen.
                </MudAlert>
                <div>
                    <form method="post" action="/Account/PerformExternalLogin">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="/portal" />
                        <input type="hidden" name="source" value="bewerbung" />
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                                   Size="Size.Large" StartIcon="@Icons.Material.Filled.Login">
                            Mit Discord bewerben
                        </MudButton>
                    </form>
                </div>
            </NotAuthorized>
            <Authorized Context="authCtx">
                @if (authCtx.User.IsApplicant())
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        Du bist angemeldet. Verwalte deine Bewerbung und die Kommunikation mit dem HRB im Bewerber-Portal.
                    </MudAlert>
                    <div>
                        <MudButton Href="/portal" Variant="Variant.Filled" Color="Color.Primary"
                                   Size="Size.Large" StartIcon="@Icons.Material.Filled.Badge">
                            Zum Bewerber-Portal
                        </MudButton>
                    </div>
                }
                else if (authCtx.User.IsCitizen())
                {
                    @* a citizen is not an applicant yet: the login callback promotes the account on the way in,
                       so this posts the same form the anonymous branch does *@
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        Du bist mit einem Bürgerkonto angemeldet. Du kannst dich damit direkt bewerben — dein
                        Bürgerkonto, deine Hinweise und Tickets bleiben erhalten.
                    </MudAlert>
                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                        <form method="post" action="/Account/PerformExternalLogin">
                            <AntiforgeryToken />
                            <input type="hidden" name="returnUrl" value="/portal" />
                            <input type="hidden" name="source" value="bewerbung" />
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                                       Size="Size.Large" StartIcon="@Icons.Material.Filled.Badge">
                                Jetzt bewerben
                            </MudButton>
                        </form>
                        <MudButton Href="/buerger" Variant="Variant.Outlined" Color="Color.Default"
                                   Size="Size.Large" StartIcon="@Icons.Material.Filled.Person">
                            Zum Bürgerbereich
                        </MudButton>
                    </MudStack>
                }
                else if (authCtx.User.MayApply())
                {
                    @* the applicant branch above already returned, so this is a partner: no re-login and no status
                       change, the application is a row of its own and the partner access stays as it is *@
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        Du bist mit einem Partnerkonto angemeldet. Du kannst dich damit bewerben — dein
                        Partnerzugang bleibt während des Verfahrens unverändert bestehen.
                    </MudAlert>
                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                        <MudButton Href="/portal" Variant="Variant.Filled" Color="Color.Primary"
                                   Size="Size.Large" StartIcon="@Icons.Material.Filled.Badge">
                            Jetzt bewerben
                        </MudButton>
                        <MudButton Href="/dashboard" Variant="Variant.Outlined" Color="Color.Default"
                                   Size="Size.Large" StartIcon="@Icons.Material.Filled.Shield">
                            Zum Agent-Portal
                        </MudButton>
                    </MudStack>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        Du bist als FIB-Agent angemeldet.
                    </MudAlert>
                    <div>
                        <MudButton Href="/dashboard" Variant="Variant.Filled" Color="Color.Primary"
                                   Size="Size.Large" StartIcon="@Icons.Material.Filled.Shield">
                            Zum Agent-Portal
                        </MudButton>
                    </div>
                }
            </Authorized>
        </AuthorizeView>

        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            Das Federal Investigation Bureau entspricht hohen Standards und der höchsten Stufe der
            Geheimhaltung. Sprich mit niemandem über dein Interesse oder den Stand des Auswahlverfahrens.
        </MudText>
    </MudStack>
</MudPaper>
</PublicModuleGate>

@code {
    private IReadOnlyList<CareerRequirement> _items = Array.Empty<CareerRequirement>();

    protected override async Task OnInitializedAsync()
        => _items = (await Requirements.GetAsync()).Items;
}
