@page "/gesucht/{CaseNumber}"
@layout PublicSiteLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using NOOSE_Website.Models.Public
@inject IPublicWantedService Wanted
@inject IPublicModuleService Modules
@inject IBuergerService Buerger

<PageTitle>@(_entry?.DisplayName ?? "Gesucht") · FIB</PageTitle>

@* One head block, and it carries both facts: noindex on the miss branch - the route answers 200 for
   every case number someone invents - and otherwise the card a shared link shows in a Discord
   channel. Hoisted out of the gate, which renders instead of the miss branch while the module is off. *@
<LinkPreview NoIndex="@(_entry is null)" Article="true"
             Title="@(_entry?.DisplayName ?? "Gesucht")"
             Description="@_entry?.ChargeHtml"
             Image="@PreviewPhoto" />

<PublicModuleGate Module="@PublicModules.Wanted" Title="Gesucht">
<MudPaper Elevation="4" Class="pa-4 pa-sm-8">
    @if (_entry is null)
    {
        @* /gesucht is indexable and this route answers 200 for any case number someone invents *@
        <MudStack Spacing="3" AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Default" />
            <MudText Typo="Typo.h6">Ausschreibung nicht gefunden</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Diese Ausschreibung ist nicht veröffentlicht oder wurde zurückgezogen.
            </MudText>
            <MudButton Href="/gesucht" Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.PersonSearch">Zur Fahndungsübersicht</MudButton>
        </MudStack>
    }
    else
    {
        <MudGrid Spacing="4">
            @if (_entry.HasPhoto)
            {
                <MudItem xs="12" sm="5" md="4">
                    <MudImage Src="@($"/gesucht/{_entry.CaseNumber}/foto")" Alt="@_entry.DisplayName"
                              Fluid="true" ObjectFit="ObjectFit.Cover" Class="rounded" Style="width:100%;" />
                </MudItem>
            }
            <MudItem xs="12" sm="@(_entry.HasPhoto ? 7 : 12)" md="@(_entry.HasPhoto ? 8 : 12)">
                <MudStack Spacing="3">
                    <div>
                        <MudText Typo="Typo.h4" Style="@NameStyle(_entry.Kind)">@_entry.DisplayName</MudText>
                        @if (!string.IsNullOrWhiteSpace(_entry.AliasText))
                        {
                            <MudText Typo="Typo.body1" Class="mud-text-secondary">
                                @(WantedKinds.IsItem(_entry.Kind) ? "auch" : "alias") @_entry.AliasText
                            </MudText>
                        }
                    </div>

                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                            @PublicWantedKindDisplay.Name(_entry.Kind)
                        </MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@LevelColour(_entry.HazardLevel)">
                            Gefahrenstufe: @HazardLevelLogic.Name(_entry.HazardLevel)
                        </MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@_entry.CaseNumber</MudChip>
                    </MudStack>

                    @if (_bounty is { } bounty)
                    {
                        @* the money is why a stranger reads this page at all, so it gets its own block and the
                           largest figure on it. Still the one number the outside may see - "bis" moves into the
                           label rather than shrinking the amount *@
                        <MudPaper Outlined="true" Class="pa-4"
                                  Style="border-color:var(--mud-palette-warning);background:var(--mud-palette-warning-hover);">
                            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.Paid" Color="Color.Warning" Size="Size.Large" />
                                <div>
                                    <MudText Typo="Typo.overline" Class="mud-text-secondary">
                                        @(bounty.IsCap ? "Belohnung bis zu" : "Belohnung")
                                    </MudText>
                                    <MudText Typo="Typo.h3" Color="Color.Warning"
                                             Style="font-weight:700;line-height:1.05;">
                                        @bounty.Total.ToString("N0") $
                                    </MudText>
                                </div>
                            </MudStack>
                        </MudPaper>
                    }

                    <WarnhinweisChips Hints="@_entry.Hints" />

                    @* stays even without curated warnings: it holds for every notice, so it stays generic - this
                       page carries vehicle and weapon notices too, and "armed" is what the curated chips above say.
                       Caution, not a ban: the report link below only works if the way there is open *@
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                        Vorsicht ist geboten. Beobachtungen und Ergreifungen bitte umgehend der nächsten
                        Dienststelle melden.
                    </MudAlert>

                    <MudDivider />

                    @* raw markup, not RichHtml: that component resolves @{Typ:GUID} mentions and would print internal record names outside *@
                    <div class="dokument-html">@((MarkupString)(_entry.ChargeHtml ?? string.Empty))</div>

                    @if (!string.IsNullOrWhiteSpace(_entry.LastArea) || !string.IsNullOrWhiteSpace(_entry.VehicleText))
                    {
                        <MudDivider />
                        <MudStack Spacing="1">
                            @if (!string.IsNullOrWhiteSpace(_entry.LastArea))
                            {
                                <MudText Typo="Typo.body2"><b>Zuletzt gesehen:</b> @_entry.LastArea</MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(_entry.VehicleText))
                            {
                                <MudText Typo="Typo.body2">
                                    <b>@(_entry.Kind == PublicWantedKind.Fahrzeug ? "Modell" : "Fahrzeug"):</b>
                                    @_entry.VehicleText
                                </MudText>
                            }
                        </MudStack>
                    }

                    @if (_entry.PublishedAt is { } published)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Ausgeschrieben am @published.ToLocalTime().ToString("dd.MM.yyyy")
                        </MudText>
                    }

                    @* one filled primary and two outlined: three flat labels in a row read as a tab bar, which is
                       exactly how they were reported *@
                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                        @if (_mayTip)
                        {
                            @* a link, not a dialog: this page is statically rendered and has no circuit *@
                            <MudButton Href="@($"/hinweis?fahndung={_entry.CaseNumber}")" Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.TipsAndUpdates">Hinweis geben</MudButton>
                        }
                        @if (_mayObject)
                        {
                            @* a link, not a dialog: this page is statically rendered and has no circuit. It leads
                               into the citizen area, which greets an anonymous visitor with the login instead of
                               bouncing them *@
                            <MudButton Href="@($"/buerger/einspruch?fahndung={_entry.CaseNumber}")"
                                       Variant="Variant.Outlined" Color="Color.Default"
                                       StartIcon="@Icons.Material.Filled.Balance">Einspruch erheben</MudButton>
                        }
                        else if (_objectionOffered)
                        {
                            @* greyed out with the reason rather than absent: the person it does concern has to be
                               able to see that the way exists. Written out, not a tooltip: this page renders
                               statically, so a MudTooltip would never open. *@
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="true"
                                       StartIcon="@Icons.Material.Filled.Balance">Einspruch erheben</MudButton>
                        }
                        @if (_mayPrint)
                        {
                            <MudButton Href="@($"/gesucht/{_entry.CaseNumber}/druck")" Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       StartIcon="@Icons.Material.Filled.Print">Poster drucken</MudButton>
                        }
                    </MudStack>

                    @if (_mayCapture)
                    {
                        @* deliberately a text link below the row, not a fourth equal button: see the note above
                           about three flat labels reading as a tab bar. A link, not a dialog - this page renders
                           statically and has no circuit *@
                        <MudText Typo="Typo.body2">
                            <MudLink Href="@($"/hinweis/gestellt?fahndung={_entry.CaseNumber}")"
                                     Color="Color.Error" Typo="Typo.body2">
                                Wer diese Person selbst stellt, meldet die Ergreifung hier →
                            </MudLink>
                        </MudText>
                    }

                    @if (!_mayObject && _objectionOffered)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @ObjectionRules.NotTheNamedPerson
                        </MudText>
                    }

                    <MudDivider Class="my-2" />
                    <div>
                        <MudButton Href="/gesucht" Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.ArrowBack">Zur Fahndungsübersicht</MudButton>
                    </div>
                </MudStack>
            </MudItem>
        </MudGrid>
    }
</MudPaper>
</PublicModuleGate>

@code {
    [Parameter]
    public string CaseNumber { get; set; } = string.Empty;

    private PublicWantedDetail? _entry;
    private PublicBounty? _bounty;
    private bool _mayPrint;
    private bool _mayTip;
    private bool _mayCapture;
    private bool _mayObject;
    private bool _objectionOffered;
    private string? _loadedKey;

    /// <summary>Picture of the preview card, or null for the agency mark.</summary>
    /// <remarks>
    /// The same anonymous endpoint the page itself shows. A notice without a photo deliberately falls back rather
    /// than sending an address that answers 404 - an unfurler that cannot fetch the picture drops the whole card.
    /// </remarks>
    private string? PreviewPhoto
        => _entry is { HasPhoto: true } entry ? $"/gesucht/{entry.CaseNumber}/foto" : null;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    // navigating from one case number to another stays on this route template, so Blazor reuses the instance and
    // OnInitializedAsync would not run again
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedKey == CaseNumber)
        {
            return;
        }
        _loadedKey = CaseNumber;
        try
        {
            _entry = await Wanted.GetByCaseNumberAsync(CaseNumber);
        }
        catch
        {
            /* best effort */
            _entry = null;
        }

        if (_entry is not null)
        {
            // its own try: a failure reading the switches must not blank the profile, it may only cost the buttons
            try
            {
                var snapshot = await Modules.GetAsync();
                _mayPrint = snapshot.IsEnabled(PublicModules.WantedPrint);
                _mayTip = snapshot.IsEnabled(PublicModules.Tips);
                // the switch and the kind: nobody apprehends a vehicle, a missing person or a witness appeal.
                // The service refuses either way; this only keeps the page honest
                _mayCapture = snapshot.IsEnabled(PublicModules.CaptureReports)
                    && CaptureRules.MayReport(_entry.Kind);
                // the switch alone is not enough any more: only the person a notice names may dispute it, and an
                // item notice names nobody. The service refuses either way; this only keeps the page honest.
                _objectionOffered = snapshot.IsEnabled(PublicModules.Objection)
                    && ObjectionRules.MayObject(_entry.Kind);
                _mayObject = _objectionOffered && await NamesViewerAsync();
            }
            catch { /* best effort */ }

            // and its own again: a failure over the money must not cost the wanted notice
            try { _bounty = await Wanted.GetBountyAsync(_entry.CaseNumber); }
            catch { /* best effort */ _bounty = null; }
        }

        if (_entry is not null)
        {
            // counted here and only here: the photo endpoint would count thumbnails rather than readers, and the
            // poster is opened from a profile that already counted
            try { await Wanted.CountViewAsync(_entry.CaseNumber); } catch { /* best effort */ }
        }
    }

    /// <summary>A licence plate reads as a plate, not as a name.</summary>
    /// <summary>True when the signed-in visitor carries the name this notice was published under.</summary>
    private async Task<bool> NamesViewerAsync()
    {
        if (AuthState is null || _entry is null)
        {
            return false;
        }
        try
        {
            var user = (await AuthState).User;
            if (user.Identity?.IsAuthenticated != true)
            {
                return false;
            }
            var profile = await Buerger.GetOwnAsync(user);
            return profile is not null
                && ObjectionRules.NamesCitizen(profile.FirstName, profile.LastName, _entry.DisplayName);
        }
        catch
        {
            /* best effort */
            return false;
        }
    }

    private static string? NameStyle(PublicWantedKind kind)
        => WantedKinds.IsItem(kind) ? "font-family:monospace;letter-spacing:.08em;" : null;

    private static Color LevelColour(HazardLevel level) => level switch
    {
        HazardLevel.Critical => Color.Error,
        HazardLevel.High => Color.Warning,
        HazardLevel.Medium => Color.Info,
        _ => Color.Default,
    };
}
