@page "/dashboard"
@using NOOSE_Website.Models.Dashboard
@using NOOSE_Website.Models.Timeline
@inject IDashboardService Dashboard
@inject IThreatTrendService Trends
@inject IGlobalChronikService Chronik
@inject IFollowupService FollowupService
@inject NavigationManager Nav
@inject IAuthorizationService Authorization
@using NOOSE_Website.Navigation
@inject IPartnerVisibilityPolicyService PartnerPolicy
@inject IPartnerAgencyProfileService PartnerProfiles
@inject IInvestigationService Investigations
@inject IWarrantService Warrants

<PageTitle>Dashboard · FIB</PageTitle>

<div class="dashboard-seite">
@* Own title row instead of PageHeader: the line under it is body1, PageHeader's is body2, and the desktop comparison
   holds this page pixel for pixel. Below 600px the large icon goes, as in PageHeader. *@
<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1 noose-kopf-umbruch">
    <MudIcon Icon="@Icons.Material.Filled.Shield" Color="Color.Primary" Size="Size.Large" Class="noose-mobil-aus" />
    <MudText Typo="Typo.h4">Lagezentrum</MudText>
</MudStack>
<MudText Typo="Typo.body1" Class="mud-text-secondary mb-6">
    <AuthorizeView>
        <Authorized Context="auth">Willkommen zurück, <b>@Codename(auth.User)</b>. </Authorized>
    </AuthorizeView>
    Überblick über den aktuellen Bestand und die jüngsten Aktivitäten im Dienst.
    @* policy, not _isPartner: that is still false on the first render *@
    <AuthorizeView Policy="@Policies.InternalAgent" Context="shift">
        <span>Was heute an dir hängt, zeigt <MudLink Href="@ShiftRules.Route">Meine Schicht</MudLink>.</span>
    </AuthorizeView>
</MudText>

@if (_isPartner)
{
    @if (_toSign.Count > 0)
    {
        <MudPaper Class="pa-6 mb-4" Elevation="2">
            <SectionHeader Title="Zu zeichnen" Icon="@Icons.Material.Filled.Draw" Class="mb-2" />
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                Anordnungen aus Ermittlungen, in denen Sie Staatsanwalt sind. Ihre Unterschrift genügt, damit sie gilt.
            </MudText>
            <WarrantTable Rows="_toSign" ShowPerson="true" />
        </MudPaper>
    }
    @if (_myInvestigations.Count > 0)
    {
        <MudPaper Class="pa-6 mb-4" Elevation="2">
            <SectionHeader Title="Meine Ermittlungen" Icon="@Icons.Material.Filled.Gavel" Class="mb-2" />
            <MudStack Spacing="1">
                @foreach (var inv in _myInvestigations.Take(8))
                {
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="noose-eintrag">
                        <MudLink Href="@($"/ermittlungen/{inv.Id}")">@inv.CaseNumber</MudLink>
                        <MudText Typo="Typo.body2">@inv.Title</MudText>
                        <InvestigationStatusChip Status="inv.Status" />
                    </MudStack>
                }
            </MudStack>
        </MudPaper>
    }
    <MudPaper Class="pa-6" Elevation="2">
        <SectionHeader Title="Partner-Zugang" Icon="@Icons.Material.Filled.Handshake" Class="mb-2" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Willkommen. Sie sehen die für Sie freigegebenen Akten und die Ermittlungen, an denen Sie beteiligt sind.
        </MudText>
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            @foreach (var entry in _partnerEntries)
            {
                <MudButton Href="@entry.Route" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@entry.Icon">@entry.Label</MudButton>
            }
        </MudStack>
    </MudPaper>
}
else
{
<MudGrid>
    <MudItem xs="6" sm="6" md="3">
        <StatTile Icon="@Icons.Material.Filled.Badge" Label="Personen-Akten" Value="@Number(k => k.People)"
                  Href="/personen" Hint="Alle für dich sichtbaren Personen-Akten" />
    </MudItem>
    <MudItem xs="6" sm="6" md="3">
        <StatTile Icon="@Icons.Material.Filled.Groups" Label="Organisationen" Value="@Number(k => k.FactionsAndGroups)"
                  Href="/fraktionen" Hint="Fraktionen und Personengruppen zusammen" />
    </MudItem>
    <MudItem xs="6" sm="6" md="3">
        <StatTile Icon="@Icons.Material.Filled.Radar" Label="Operationen" Value="@Number(k => k.Operations)"
                  Href="/operationen" Hint="Erfasste Einsätze" />
    </MudItem>
    <MudItem xs="6" sm="6" md="3">
        <StatTile Icon="@Icons.Material.Filled.FolderSpecial" Label="Offene Vorgänge" Value="@Number(k => k.OpenCases)"
                  Href="/vorgaenge" Hint="Sammelakten, die noch nicht abgeschlossen sind" />
    </MudItem>
    <MudItem xs="6" sm="6" md="3">
        <StatTile Icon="@Icons.Material.Filled.Inbox" Colour="Color.Warning" Label="Offene Anträge" Value="@Number(k => k.OpenRequests)"
                  Href="@(_mayShares ? "/admin/freigaben" : null)" Hint="Anträge und Registrierungen im Posteingang" />
    </MudItem>
    @* Classified count is itself classified; leadership-only tile. *@
    @if (_isLeadership)
    {
        <MudItem xs="6" sm="6" md="3">
            <StatTile Icon="@Icons.Material.Filled.Lock" Colour="Color.Error" Label="Verschlusssachen" Value="@Number(k => k.Classified)"
                      Hint="Als Verschlusssache eingestufte Akten" />
        </MudItem>
    }
    <MudItem xs="6" sm="6" md="3">
        <StatTile Icon="@Icons.Material.Filled.Timelapse" Colour="Color.Warning" Label="Veraltete Akten" Value="@Number(k => k.StaleRecords)"
                  Hint="Akten jenseits der Aktualitäts-Schwelle" />
    </MudItem>
    <MudItem xs="6" sm="6" md="3">
        <StatTile Icon="@Icons.Material.Filled.EventRepeat" Colour="Color.Info" Label="Fällige Wiedervorlagen"
                  Value="@(_load ? "…" : _myDue.Count.ToString())" Href="@FollowupPlanRules.Route"
                  Hint="Deine Wiedervorlagen, die heute oder früher fällig sind" />
    </MudItem>
</MudGrid>

@* inside the non-partner branch on purpose: onboarding is for in-house accounts *@
<OnboardingChecklist />
<RecentDecorationsCard />

<MudText Typo="Typo.h6" Class="mt-6 mb-2">Verteilungen</MudText>
@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_distributions is { } v)
{
    <MudGrid>
        <MudItem xs="12" md="6" Class="d-flex">
            <MudPaper Class="pa-4 flex-grow-1" Elevation="2">
                <MudGrid>
                    <MudItem xs="12" sm="6" Class="d-flex">
                        <DistributionChart Bare="true" Height="170px" Title="Fälle nach Einstufung" Segments="@v.CasesByClassification" Colours="_coloursClassification" />
                    </MudItem>
                    <MudItem xs="12" sm="6" Class="d-flex">
                        <DistributionChart Bare="true" Height="170px" Title="Maßnahme-Ausgänge" Segments="@v.MeasureOutcomes" Colours="_coloursOutcome" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6" Class="d-flex">
            <MudPaper Class="pa-4 flex-grow-1" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">Fraktionen nach Gefährdung</MudText>
                <HazardList Items="_factionsHazard" Trends="_factionTrends" EmptyText="Noch keine Fraktionen erfasst." />
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mt-1">
        <MudItem xs="12" md="6" Class="d-flex">
            <MudPaper Class="pa-4 flex-grow-1" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">Personen nach Gefährdung</MudText>
                <HazardList Items="_peopleHazard" Trends="_peopleTrends" EmptyText="Noch keine bewerteten Personen." />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6" Class="d-flex">
            <MudPaper Class="pa-4 flex-grow-1 d-flex flex-column" Elevation="2">
                <SectionHeader Title="Statistik & Auswertungen" Icon="@Icons.Material.Filled.QueryStats" Class="mb-2" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                    Verteilungen über Einstufung, Gefährdung, Lebensstatus, Maßnahmen und Vorgänge,
                    der 12-Monats-Verlauf und die gefährlichsten Akten – mit CSV- und Druck-Export.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.QueryStats"
                           Href="/statistik" Class="mt-auto align-self-start">Zur vollständigen Statistik</MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@if (!_load && _myDue.Count > 0)
{
    <MudPaper Class="pa-4 mt-6" Elevation="2">
        <SectionHeader Title="Meine fälligen Wiedervorlagen" Icon="@Icons.Material.Filled.EventRepeat" IconColour="Color.Info" Class="mb-3" />
        <MudList T="string" Dense="true">
            @foreach (var w in _myDue)
            {
                <MudListItem T="string" Icon="@Icons.Material.Filled.EventBusy" IconColor="Color.Error"
                             OnClick="@(() => OpenRecord(w.Href))" Style="@(w.Href is null ? null : "cursor:pointer;")">
                    <MudText Typo="Typo.body2"><b>@w.Display</b> · fällig @w.DueAt.ToLocalTime().ToString("dd.MM.yyyy")</MudText>
                    @if (!string.IsNullOrWhiteSpace(w.Note))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@w.Note</MudText>
                    }
                </MudListItem>
            }
        </MudList>
    </MudPaper>
}

@if (!_load && _distributions is { } va)
{
    @* Below 960px the three columns stand one under the other: no fixed 28rem height (Home.razor.css), five entries
       each; the rest behind "Alle anzeigen" or the link to the chronicle *@
    <MudGrid Class="mt-1">
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 dashboard-spalte" Elevation="2" Style="height:28rem;display:flex;flex-direction:column;">
                <SectionHeader Title="Aktualisierungsbedarf" Icon="@Icons.Material.Filled.Timelapse" IconColour="Color.Warning" Class="mb-1" />
                @if (_updateNeed.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Alles aktuell – kein Aktualisierungsbedarf.</MudText>
                }
                else
                {
                    <div class="dashboard-spalte-body">
                        <MudList T="string" Dense="true">
                            @foreach (var (a, i) in _updateNeed.Select((a, i) => (a, i)))
                            {
                                <MudListItem T="string" OnClick="@(() => OpenRecord(a.Href))" Style="cursor:pointer;"
                                             Class="@(i >= NarrowCap && !_allUpdateNeed ? "dashboard-mehr" : null)">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <RecencyIndicator Level="a.Level" ReferenceDateUtc="a.ReferenceUtc" />
                                        <div>
                                            <MudText Typo="Typo.body2"><b>@RecordTypeDisplay.Name(a.Type.ToString())</b> »@a.Name«</MudText>
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                @a.CaseNumber · zuletzt @a.ReferenceUtc.ToLocalTime().ToString("dd.MM.yyyy")
                                            </MudText>
                                        </div>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                        @if (_updateNeed.Count > NarrowCap && !_allUpdateNeed)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="noose-nur-schmal"
                                       OnClick="@(() => _allUpdateNeed = true)">Alle anzeigen (@_updateNeed.Count)</MudButton>
                        }
                        @if (_updateNeed.Count >= 30)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">… weitere vorhanden (älteste 30 angezeigt).</MudText>
                        }
                    </div>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 dashboard-spalte" Elevation="2" Style="height:28rem;display:flex;flex-direction:column;">
                <div class="dashboard-spalte-body d-flex flex-column justify-center">
                    <DistributionChart Bare="true" Height="240px" Title="Offene Anträge nach Art" Segments="@va.OpenRequestsByKind" Colours="_coloursRequests" />
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 dashboard-spalte" Elevation="2" Style="height:28rem;display:flex;flex-direction:column;">
                <SectionHeader Title="Letzte Änderungen" Icon="@Icons.Material.Filled.History" Class="mb-3">
                    <Actions>
                        <MudLink Href="/nachweis?tab=chronik" Typo="Typo.caption">Zur Chronik</MudLink>
                    </Actions>
                </SectionHeader>
                @if (_chronik.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Noch keine Änderungen erfasst.</MudText>
                }
                else
                {
                    <div class="dashboard-spalte-body">
                        <MudTimeline TimelinePosition="TimelinePosition.Start" Class="mt-2">
                            @foreach (var (x, i) in _chronik.Select((x, i) => (x, i)))
                            {
                                @* below 960px five; the rest is one tap away under "Zur Chronik" *@
                                <MudTimelineItem Color="@TimelineCategoryDisplay.Colour(x.Category)" Size="Size.Small"
                                                 Class="@(i >= NarrowCap ? "dashboard-mehr" : null)">
                                    <MudText Typo="Typo.body2">
                                        <b>@RecordTypeDisplay.Name(x.EntityType)</b>
                                        @if (x.RecordDeleted || string.IsNullOrEmpty(x.Href))
                                        {
                                            <span>»@x.Name«</span>
                                            @if (x.RecordDeleted)
                                            {
                                                <span class="mud-text-secondary"> (im Papierkorb)</span>
                                            }
                                        }
                                        else
                                        {
                                            <MudLink Href="@x.Href">»@x.Name«</MudLink>
                                        }
                                        <span class="mud-text-secondary"> · @x.Title</span>
                                    </MudText>
                                    @if (!string.IsNullOrWhiteSpace(x.Detail))
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@x.Detail</MudText>
                                    }
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @x.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @(x.ActorName ?? "System")
                                    </MudText>
                                </MudTimelineItem>
                            }
                        </MudTimeline>
                    </div>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}
}
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;

    // below 960px the three bottom columns show this many entries each
    private const int NarrowCap = 5;
    private bool _allUpdateNeed;
    private bool _isLeadership;
    private bool _isPartner;
    private IReadOnlyList<NavEntry> _partnerEntries = [];
    private bool _mayShares;
    private DashboardMetrics? _metrics;
    private DashboardDistributions? _distributions;
    private List<ChronikEvent> _chronik = new();
    private List<FollowupDashboardItem> _myDue = new();
    private List<DashboardStaleRecord> _updateNeed = new();
    private List<DashboardFactionHazard> _factionsHazard = new();
    private List<DashboardFactionHazard> _peopleHazard = new();
    private IReadOnlyDictionary<string, IReadOnlyList<int>> _factionTrends = new Dictionary<string, IReadOnlyList<int>>();
    private IReadOnlyDictionary<string, IReadOnlyList<int>> _peopleTrends = new Dictionary<string, IReadOnlyList<int>>();

    // Colour order must match the segment order in DashboardService
    private static readonly string[] _coloursClassification = { "#A8A29A", "#8C7757", "#D29922", "#F85149" };
    private static readonly string[] _coloursOutcome = { "#8C7757", "#3FB950", "#D29922", "#F85149" };
    private static readonly string[] _coloursRequests = { "#8C7757", "#3FB950", "#9A59CF", "#D29922", "#F85149" };

    private List<WarrantView> _toSign = new();
    private List<InvestigationListItem> _myInvestigations = new();

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateTask).User;
        _isPartner = user.IsPartner();
        if (_isPartner)
        {
            // partner-safe landing
            _partnerEntries = NavCatalog.PartnerRecordEntries(
                await PartnerPolicy.GetAllowedTypesAsync(user), await PartnerProfiles.GetFeaturesAsync(user));
            _toSign = await Warrants.GetToSignAsync(user);
            _myInvestigations = (await Investigations.GetListAsync(user)).Where(i => InvestigationDisplay.IsOpen(i.Status)).ToList();
            _load = false;
            return;
        }
        _isLeadership = user.IsLeadership();
        // same gate as the page itself, so the tile never links somewhere the viewer is refused
        _mayShares = (await Authorization.AuthorizeAsync(user, Policies.HighestClassificationPage)).Succeeded;
        var meId = user.GetAgentId(); // for taskforce-membership visibility of metrics/lists
        _metrics = await Dashboard.GetMetricsAsync(_isLeadership, meId);
        _distributions = await Dashboard.GetDistributionsAsync(_isLeadership, meId);
        // same feed the chronicle renders; wide window so a quiet week still fills the panel
        var chronik = await Chronik.GetEventsAsync(
            new ChronikQuery(DateTime.UtcNow.AddYears(-1), DateTime.UtcNow.AddMinutes(1), MinEvents: 20), user);
        _chronik = chronik.Events.Take(20).ToList();
        _myDue = await FollowupService.GetMyDueAsync(user);
        _updateNeed = await Dashboard.GetUpdateNeedAsync(_isLeadership, meId);
        _factionsHazard = await Dashboard.GetFactionsByHazardAsync(_isLeadership);
        _peopleHazard = await Dashboard.GetPeopleByHazardAsync(_isLeadership);
        // the tiles are already filtered for this viewer, so the curves follow their ids
        _factionTrends = await Trends.GetSparklinesAsync(nameof(Faction), _factionsHazard.Select(f => f.Id).ToList());
        _peopleTrends = await Trends.GetSparklinesAsync(nameof(Person), _peopleHazard.Select(p => p.Id).ToList());
        _load = false;
    }

    private void OpenRecord(string? href)
    {
        if (!string.IsNullOrEmpty(href))
        {
            Nav.NavigateTo(href);
        }
    }

    private string Number(Func<DashboardMetrics, int> selection)
        => _metrics is { } k ? selection(k).ToString() : "…";

    private static string Codename(System.Security.Claims.ClaimsPrincipal user)
    {
        var codename = user.GetCodename();
        return string.IsNullOrWhiteSpace(codename) ? "Unbenannter Agent" : codename;
    }

}
