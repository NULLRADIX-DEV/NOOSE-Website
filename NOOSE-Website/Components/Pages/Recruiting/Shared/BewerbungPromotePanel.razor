@inject IAgentManagementService AgentService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@if (User.IsLeadership())
{
    <MudPaper Elevation="2" Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-2">Zum Agent hochstufen</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            Stuft den Bewerber direkt zu einem aktiven FIB-Agent hoch. Der Bewerber-Zugang endet, der interne
            Zugang beginnt. Nur die Führung kann diese Aktion ausführen.
        </MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
            <MudSelect T="Rank" Value="_rank" ValueChanged="RankChanged" Label="Dienstgrad" Variant="Variant.Outlined"
                       Margin="Margin.Dense" Style="min-width:220px;">
                @foreach (var r in RankOptions)
                {
                    <MudSelectItem T="Rank" Value="@r">@RankDisplay.Name(r, _division)</MudSelectItem>
                }
            </MudSelect>
            <AuthorizeView Policy="@Policies.DivisionSetWrite" Context="abteilung">
                <MudTooltip Text="@DivisionRules.PickerHint(_rank)" Disabled="@(DivisionRules.PickerHint(_rank) is null)">
                    <MudSelect T="Division" @bind-Value="_division" Label="Abteilung" Variant="Variant.Outlined"
                               Margin="Margin.Dense" Style="min-width:120px;">
                        @foreach (var d in DivisionDisplay.All)
                        {
                            <MudSelectItem T="Division" Value="@d" Disabled="@(!DivisionRules.MayHold(d, _rank))">@DivisionDisplay.Short(d)</MudSelectItem>
                        }
                    </MudSelect>
                </MudTooltip>
            </AuthorizeView>
            <MudTooltip Text="@DepartmentRules.Hint" Disabled="DepartmentsOpen">
                <MudCheckBox T="bool" @bind-Value="_hrb" Label="@DepartmentRules.ColumnLabel" Disabled="@(!DepartmentsOpen)" />
            </MudTooltip>
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.MilitaryTech"
                       OnClick="PromoteAsync" Disabled="_busy">Hochstufen</MudButton>
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter, EditorRequired] public string ApplicantUserId { get; set; } = default!;
    [Parameter, EditorRequired] public ClaimsPrincipal User { get; set; } = default!;
    [Parameter] public string? ApplicantName { get; set; }
    [Parameter] public EventCallback OnPromoted { get; set; }

    private PromotionStanding _standing;
    private bool _mayPickDivision;
    private Rank _rank = Rank.Trainee;
    private Division _division = Division.Cid;
    private bool _hrb;
    private bool _busy;

    protected override void OnInitialized()
    {
        _standing = PromotionStanding.Of(User);
        _mayPickDivision = User.MayWrite() && User.MayDivisionSet();
        // no picker: own division or CID
        _division = _mayPickDivision ? Division.Cid : PromotionRules.ReleaseDivision(_standing);
        _rank = RankOptions.FirstOrDefault(Rank.Trainee);
    }

    /// <summary>Ranks the viewer may hand out as a first release.</summary>
    private IEnumerable<Rank> RankOptions
        => PromotionRules.AssignableRanks(_standing, _division, null)
            .Where(r => _mayPickDivision || DivisionRules.MayHold(_division, r));

    /// <summary>Mirrors DepartmentRules.MayHold; ticking a box the service refuses fails only on save.</summary>
    private bool DepartmentsOpen => DepartmentRules.MayHold(_rank);

    private void RankChanged(Rank rank)
    {
        _rank = rank;
        if (!DepartmentsOpen)
        {
            _hrb = false;
        }
        if (!DivisionRules.MayHold(_division, _rank))
        {
            _division = Division.Cid;
        }
    }

    private async Task PromoteAsync()
    {
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Bewerber hochstufen?",
            $"{ApplicantName ?? "Der Bewerber"} wird als {RankDisplay.Name(_rank, _division)} freigeschaltet und wird ein aktiver FIB-Agent.",
            "Hochstufen");
        if (!ok)
        {
            return;
        }
        _busy = true;
        try
        {
            if (await DivisionLimitConfirm.RunAsync(DialogService, confirm =>
                    AgentService.PromoteApplicantToAgentAsync(ApplicantUserId, _rank, _division, _hrb, confirm, User)))
            {
                Snackbar.Add("Bewerber wurde zum Agent hochgestuft.", Severity.Success);
                await OnPromoted.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        _busy = false;
    }
}
