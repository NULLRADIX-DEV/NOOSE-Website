@implements IDisposable
@inject IBewerbungTestService TestService
@inject BewerbungBroadcaster Broadcaster
@inject ISnackbar Snackbar

<MudPaper Elevation="2" Class="pa-4">
    <MudText Typo="Typo.h6" Class="mb-2">Eignungstests</MudText>

    @if (_first)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        @if (_assignments.Count == 0 && !_canWrite)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Kein Test zugewiesen.</MudText>
        }

        @foreach (var assignment in _assignments)
        {
            <BewerbungTestAttemptCard @key="assignment.Id" Assignment="assignment" Version="_version"
                                      User="User" CanWrite="_canWrite" />
        }

        @if (_canWrite)
        {
            @if (_assignments.Count > 0)
            {
                <MudDivider Class="my-3" />
            }
            @if (Assignable.Count > 0)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudSelect T="string" @bind-Value="_selectedTestId"
                               Label="@(_assignments.Count == 0 ? "Test auswählen" : "Weiteren Test zuweisen")"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Class="noose-breite-frei" Style="min-width:240px;">
                        @foreach (var t in Assignable)
                        {
                            <MudSelectItem T="string" Value="@t.Id">@t.Title@(t.TimeLimitMinutes is int m ? $" · {m} Min" : "")</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AssignmentInd"
                               OnClick="AssignAsync" Disabled="@(_busy || string.IsNullOrEmpty(_selectedTestId))">Zuweisen</MudButton>
                </MudStack>
            }
            else if (_tests.Count == 0)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Noch keine aktiven Tests vorhanden. Lege unter „Bewerbungs-Tests“ einen Test an.
                </MudText>
            }
        }
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public string BewerbungId { get; set; } = default!;
    [Parameter, EditorRequired] public ClaimsPrincipal User { get; set; } = default!;

    private bool _first = true;
    private bool _busy;
    private bool _canWrite;
    private string? _selectedTestId;
    private List<BewerbungTest> _tests = new();
    private List<BewerbungTestAssignment> _assignments = new();
    // bumped on every reload so the cards re-read their evaluation
    private int _version;

    /// <summary>Active applicant tests this application does not hold yet; each test goes out only once.</summary>
    private List<BewerbungTest> Assignable => _tests
        .Where(t => _assignments.All(a => a.TestId != t.Id))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        _canWrite = User.MayWrite();
        Broadcaster.Modified += OnModified;
        await LoadAsync();
    }

    // no spinner on a refresh: swapping the list for a progress bar collapsed the page height, and the browser
    // scrolled back to the top on every grading click
    private async Task LoadAsync()
    {
        _assignments = await TestService.GetAssignmentsAsync(BewerbungId, User);
        var all = await TestService.GetTestsAsync(User);
        // an internal-only test cannot go to an applicant; the service refuses it as well
        _tests = all.Where(x => x.IsActive && TestUsageDisplay.ForApplicants(x.Usage)).ToList();
        if (_selectedTestId is not null && Assignable.All(t => t.Id != _selectedTestId))
        {
            _selectedTestId = null;
        }
        _version++;
        _first = false;
    }

    private async Task AssignAsync()
    {
        if (string.IsNullOrEmpty(_selectedTestId))
        {
            return;
        }
        _busy = true;
        try
        {
            await TestService.AssignAsync(BewerbungId, _selectedTestId, User);
            _selectedTestId = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnModified(string id)
    {
        if (id != BewerbungId)
        {
            return;
        }
        _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
    }

    public void Dispose() => Broadcaster.Modified -= OnModified;
}
