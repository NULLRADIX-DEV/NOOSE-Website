@using NOOSE_Website.Models.Navigation
@inject IBewerbungService BewerbungService
@inject IBewerbungTestService TestService
@inject BewerbungBroadcaster Broadcaster
@inject NavigationManager Nav
@implements IDisposable


@* the Sperren button is gone: it is a sibling section of this panel now *@
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Übersicht über alle Bewerber. Offene und abgeschlossene Verfahren – inklusive Tests, interner Threads und
    der Kommunikation mit dem Bewerber – bleiben hier einsehbar.
</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.h3" Style="color: var(--mud-palette-error); font-weight: 700;">
        @RejectionRate.ToString("P2")
    </MudText>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <div>
            <MudText Typo="Typo.overline" Class="mud-text-secondary">Ablehnungsquote</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                @RejectedCount von @TotalCount Bewerbungen abgelehnt
            </MudText>
        </div>
    </MudStack>
</MudPaper>

@* no URL sync here: TabUrlState's "tab" would collide with the section rail *@
<MudTabs Elevation="0" Rounded="true" Class="mb-2" @bind-ActivePanelIndex="_tab">
    @foreach (var tab in ApplicationOverview.Tabs)
    {
        <MudTabPanel Text="@($"{ApplicationOverview.TabName(tab)} ({InTab(tab).Count()})")" />
    }
</MudTabs>

<div class="d-flex flex-wrap gap-3 mb-3">
    <MudTextField T="string" @bind-Value="_search" Immediate="true" DebounceInterval="200" Clearable="true"
                  Placeholder="Suche nach Name, Aktenzeichen, Bearbeiter oder Arbeitgeber" Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Style="flex: 1 1 260px; min-width: 0;" Class="noose-filter-feld" />
    <MudSelect T="ApplicationStreamFilter" @bind-Value="_stream" Label="Stream" Variant="Variant.Outlined"
               Margin="Margin.Dense" Dense="true" Style="flex: 0 1 220px; min-width: 0;" Class="noose-filter-feld">
        @foreach (var f in Enum.GetValues<ApplicationStreamFilter>())
        {
            <MudSelectItem T="ApplicationStreamFilter" Value="f">@ApplicationOverview.StreamFilterName(f)</MudSelectItem>
        }
    </MudSelect>
</div>
<MobileColumnPicker ListKey="bewerbungen" Columns="PhoneColumns" Defaults="PhoneDefaults"
                    VisibleChanged="@(v => _phoneColumns = v)" />

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (Current.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        @(string.IsNullOrWhiteSpace(_search) && _stream == ApplicationStreamFilter.Alle ? "Keine Bewerbungen in dieser Ansicht." : "Keine Bewerbung passt zur Suche.")
    </MudAlert>
}
else
{
    <MudTable Items="Current" Hover="true" Dense="true" OnRowClick="@((TableRowClickEventArgs<Bewerbung> e) => Open(e.Item))"
              Breakpoint="Breakpoint.None" Style="cursor:pointer;">
        <HeaderContent>
            <MudTh Class="@Col("aktenzeichen")">Aktenzeichen</MudTh>
            <MudTh Class="@Col("name")">Name</MudTh>
            <MudTh Class="@Col("status")">Status</MudTh>
            <MudTh Class="@Col("test")">Test</MudTh>
            <MudTh Class="@Col("bearbeiter")">Bearbeiter</MudTh>
            <MudTh Class="@Col("eingereicht")">Eingereicht</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Aktenzeichen" Class="@Col("aktenzeichen")">@context.CaseNumber</MudTd>
            <MudTd DataLabel="Name" Class="@Col("name")">
                @context.Name
                @if (context.StreamConsent is { } stream)
                {
                    <MudTooltip Text="@(stream ? "Darf gestreamt werden" : "Darf nicht gestreamt werden")">
                        <MudIcon Icon="@(stream ? Icons.Material.Filled.Videocam : Icons.Material.Filled.VideocamOff)"
                                 Size="Size.Small" Color="@(stream ? Color.Success : Color.Error)" Class="ml-1" Style="vertical-align: middle;" />
                    </MudTooltip>
                }
            </MudTd>
            <MudTd DataLabel="Status" Class="@Col("status")">
                <MudChip T="string" Size="Size.Small" Color="BewerbungStatusDisplay.ChipColor(context.Status)">
                    @BewerbungStatusDisplay.Name(context.Status)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Test" Class="@Col("test")">
                @{ var attempt = _tests.GetValueOrDefault(context.Id); }
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                         Color="ApplicationOverview.TestColor(ApplicationOverview.TestStage(attempt, _now))">
                    @ApplicationOverview.TestLabel(attempt, _now)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Bearbeiter" Class="@Col("bearbeiter")">@(string.IsNullOrWhiteSpace(context.AssignedAgentName) ? "—" : context.AssignedAgentName)</MudTd>
            <MudTd DataLabel="Eingereicht" Class="@Col("eingereicht")">@context.SubmittedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private ClaimsPrincipal _user = default!;
    private bool _load = true;
    private int _tab;
    private List<Bewerbung> _all = new();
    private Dictionary<string, BewerbungTestAssignment> _tests = new();
    private DateTime _now = DateTime.UtcNow;

    private string? _search;

    private static readonly IReadOnlyList<(string Key, string Label)> PhoneColumns =
    [
        ("aktenzeichen", "Aktenzeichen"), ("name", "Name"), ("status", "Status"), ("test", "Test"),
        ("bearbeiter", "Bearbeiter"), ("eingereicht", "Eingereicht"),
    ];

    // the tab already names the step, so a phone shows the test first
    private static readonly IReadOnlyList<string> PhoneDefaults = ["name", "test"];

    private IReadOnlySet<string> _phoneColumns = MobileColumnSet.Resolve(PhoneColumns.Select(c => c.Key).ToList(), PhoneDefaults, null);

    private string Col(string key) => MobileColumnSet.ClassFor(_phoneColumns, key);
    private ApplicationStreamFilter _stream;

    private List<Bewerbung> Current
        => BewerbungSearch.Filter(InTab(ApplicationOverview.Tabs[_tab]).ToList(), _search);

    private IEnumerable<Bewerbung> InTab(ApplicationListTab tab)
        => _all.Where(b => ApplicationOverview.MatchesStream(_stream, b.StreamConsent)
            && ApplicationOverview.InTab(tab, b.Status, _tests.GetValueOrDefault(b.Id), _now));

    private int RejectedCount => _all.Count(b => b.Status == BewerbungStatus.Abgelehnt);
    private int TotalCount => _all.Count;
    private double RejectionRate => TotalCount > 0 ? (double)RejectedCount / TotalCount : 0d;

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        Broadcaster.Modified += OnModified;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _load = true;
        _all = await BewerbungService.ListAsync(_user);
        _tests = await TestService.GetAssignmentsByApplicationAsync(_user);
        _now = DateTime.UtcNow;
        _load = false;
    }

    private void Open(Bewerbung? b)
    {
        if (b is not null)
        {
            Nav.NavigateTo($"/bewerbungen/{b.Id}");
        }
    }

    private void OnModified(string bewerbungId)
        => _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    public void Dispose() => Broadcaster.Modified -= OnModified;
}
