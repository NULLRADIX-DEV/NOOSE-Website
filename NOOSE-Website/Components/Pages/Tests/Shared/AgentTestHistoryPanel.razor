@* Internal tests of one agent, for the personnel file; HRB and leadership only, the caller gates. *@
@inject IAgentTestService AgentTests

@if (_rows is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_rows.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">Keine internen Tests zugewiesen.</MudText>
}
else
{
    @* a table on phones too: assignment date and result are hidden below 600px *@
    <MudTable Items="_rows" Dense="true" Hover="true" Breakpoint="Breakpoint.None">
        <HeaderContent>
            <MudTh>Test</MudTh><MudTh Class="noose-mobil-aus">Zugewiesen</MudTh><MudTh>Stand</MudTh><MudTh Class="noose-mobil-aus">Ergebnis</MudTh><MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Test">@context.TestTitle</MudTd>
            <MudTd DataLabel="Zugewiesen" Class="noose-mobil-aus">@context.AssignedAt.ToLocalTime().ToString("dd.MM.yyyy")</MudTd>
            <MudTd DataLabel="Stand"><AgentTestStateChip Row="context" Now="_now" /></MudTd>
            <MudTd DataLabel="Ergebnis" Class="noose-mobil-aus">
                @if (context.State == AgentTestState.Korrigiert)
                {
                    @($"{context.Points} / {context.MaxPoints} ({context.Percent} %)")
                    @if (context.Passed is true)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Class="ml-1" />
                    }
                    else if (context.Passed is false)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" Class="ml-1" />
                    }
                }
                else
                {
                    @("—")
                }
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small"
                               Href="@($"/tests/korrektur/{context.AssignmentId}")" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Parameter, EditorRequired] public string AgentId { get; set; } = default!;

    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private List<AgentTestRow>? _rows;
    private DateTime _now = DateTime.UtcNow;
    private string? _loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        // the personnel file re-renders this panel with every change elsewhere on the page
        if (AgentId == _loadedFor)
        {
            return;
        }
        _loadedFor = AgentId;
        var user = (await AuthStateTask).User;
        _now = DateTime.UtcNow;
        _rows = await AgentTests.GetForAgentAsync(AgentId, user);
    }
}
