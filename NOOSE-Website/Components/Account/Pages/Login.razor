@page "/Account/Login"
@layout AccountLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Anmeldung · FIB</PageTitle>

<MudPaper Elevation="4" Class="pa-8" Style="max-width:420px;width:100%;">
    <MudStack AlignItems="AlignItems.Center" Spacing="4">
        <MudImage Src="FibIcon.png" Alt="Wappen des FIB" Width="84" Height="84" />
        <MudStack AlignItems="AlignItems.Center" Spacing="0">
            <MudText Typo="Typo.h5" Style="font-weight:700;letter-spacing:.12em;">F.I.B.</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Federal Investigation Bureau</MudText>
        </MudStack>

        @if (!string.IsNullOrEmpty(Error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Style="width:100%;">
                @Error
            </MudAlert>
        }

        <MudText Typo="Typo.body2" Align="Align.Center" Class="mud-text-secondary">
            Anmeldung ausschließlich über Discord. Neue Konten müssen vor der ersten Nutzung
            von der Führung freigegeben werden.
        </MudText>

        <form method="post" action="/Account/PerformExternalLogin" style="width:100%;">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                       Size="Size.Large" FullWidth="true" StartIcon="@Icons.Material.Filled.Login">
                Mit Discord anmelden
            </MudButton>
        </form>

        @* Mandatory legal links, reachable before login. *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
            <MudLink Href="@LegalData.ImprintUrl" Target="_blank" rel="noopener noreferrer"
                     Typo="Typo.caption" Color="Color.Default">Impressum</MudLink>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">·</MudText>
            <MudLink Href="/datenschutz" Typo="Typo.caption" Color="Color.Default">Datenschutz</MudLink>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">·</MudText>
            <MudLink Href="/nutzungsbedingungen" Typo="Typo.caption" Color="Color.Default">Nutzungsbedingungen</MudLink>
        </MudStack>
    </MudStack>
</MudPaper>

@code {
    [SupplyParameterFromQuery(Name = "fehler")]
    private string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }
}
