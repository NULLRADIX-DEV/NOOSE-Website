@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject ISystemSettingService SettingService
@inject IPartnerVisibilityPolicyService PartnerPolicy
@inject IPartnerAgencyProfileService PartnerProfiles
@inject INavPreferencesService NavPrefs
@inject IAgentManagementService AgentService
@inject IDialogService DialogService

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="2">
        @* One button per width: only the desktop one remembers the drawer state. Below 960px the drawer starts
           closed and closes after a tap on an entry (MudBlazor's responsive drawer does both), so a phone must not
           overwrite the state the desktop restores. *@
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" aria-label="Navigation umschalten" Class="noose-schmal-aus" />
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawerNarrow" aria-label="Navigation umschalten" Class="noose-nur-schmal" />
        @* logo + wordmark are the only way back to the public home *@
        <MudLink Href="/" Underline="Underline.None" Color="Color.Inherit" Class="d-flex align-center mr-3" title="Zur Startseite">
            <MudImage Src="@(_configuration?.HasLogo == true ? "/system/logo" : "FibIcon.png")" Alt="Wappen des FIB" Height="36" Class="mr-3" />
            <MudText Typo="Typo.h6" Class="noose-mobil-aus" Style="font-weight:700;letter-spacing:.12em;">F.I.B.</MudText>
        </MudLink>
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-none d-md-flex">
            Federal Investigation Bureau
        </MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized Context="auth">
                @* phones: 4px between the buttons instead of 12px (noose-appbar-aktionen in app.css) *@
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="noose-appbar-aktionen">
                    @* Quick-add new records from the topbar; on phones it sits in the avatar menu below. *@
                    <AuthorizeView Policy="@Policies.WriteAccess" Context="schreib">
                        <MudTooltip Text="Schnellerfassung – neue Akte anlegen" RootClass="noose-mobil-aus">
                            <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Color="Color.Inherit"
                                           OnClick="QuickAddAsync" aria-label="Schnellerfassung" />
                        </MudTooltip>
                    </AuthorizeView>
                    @* firearm-use quick report, shown to in-house writers only *@
                    <FirearmUseButton Class="noose-mobil-aus" />
                    <MudTextField T="string" @bind-Value="_search" Placeholder="Suchen…" Immediate="true"
                                  Margin="Margin.Dense" Variant="Variant.Outlined"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  OnKeyDown="SearchKeyDown" Class="d-none d-md-flex mt-0" Style="max-width:240px;" />
                    @* Small screens have no search field and no Ctrl+K, so open the palette here. *@
                    <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Inherit" OnClick="OpenPaletteAsync"
                                   Class="d-flex d-md-none" aria-label="Suchen und springen" title="Suchen und springen" />
                    <NotificationBell User="auth.User" />
                    <MudLink Href="/profil" Underline="Underline.None" Color="Color.Inherit"
                             Class="d-flex align-center noose-mobil-aus" title="Mein Profil">
                        <MudStack Spacing="0" AlignItems="AlignItems.End" Class="d-none d-sm-flex mr-3">
                            <MudText Typo="Typo.body2" Style="line-height:1.2;">@DisplayName(auth.User)</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="line-height:1.2;">
                                @RankRow(auth.User)
                            </MudText>
                        </MudStack>
                        @AvatarOf(auth.User)
                    </MudLink>
                    <form method="post" action="/Account/Logout" class="noose-mobil-aus" onsubmit="if (window.nooseEntwuerfeLoeschen) { window.nooseEntwuerfeLoeschen(); }">
                        <AntiforgeryToken />
                        <MudIconButton ButtonType="ButtonType.Submit" Icon="@Icons.Material.Filled.Logout"
                                       Color="Color.Inherit" aria-label="Abmelden" title="Abmelden" />
                    </form>
                    @* Phones: profile, quick add, firearm use and logout behind the avatar, each behind the same
                       permission check as its app-bar button above. *@
                    <MudMenu Class="noose-nur-handy" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <ActivatorContent>
                            <MudIconButton OnClick="@context.ToggleAsync" Class="pa-0" aria-label="Profilmenü" title="Profilmenü">
                                @AvatarOf(auth.User)
                            </MudIconButton>
                        </ActivatorContent>
                        <ChildContent>
                            <div class="px-4 py-2">
                                <MudText Typo="Typo.body2" Style="line-height:1.2;">@DisplayName(auth.User)</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="line-height:1.2;">
                                    @RankRow(auth.User)
                                </MudText>
                            </div>
                            <MudDivider />
                            <MudMenuItem Icon="@Icons.Material.Filled.Person" Href="/profil">Mein Profil</MudMenuItem>
                            <AuthorizeView Policy="@Policies.WriteAccess" Context="schreibMenue">
                                <MudMenuItem Icon="@Icons.Material.Filled.AddCircle" OnClick="QuickAddAsync">Schnellerfassung</MudMenuItem>
                            </AuthorizeView>
                            <FirearmUseButton AsMenuItem="true" />
                            <MudDivider />
                            <form method="post" action="/Account/Logout" onsubmit="if (window.nooseEntwuerfeLoeschen) { window.nooseEntwuerfeLoeschen(); }">
                                <AntiforgeryToken />
                                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Inherit"
                                           FullWidth="true" StartIcon="@Icons.Material.Filled.Logout"
                                           Class="justify-start px-4 py-2">Abmelden</MudButton>
                            </form>
                        </ChildContent>
                    </MudMenu>
                </MudStack>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    @* wide enough for the 64px area rail plus the entry panel; capped so it fits small phones *@
    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always"
               Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md"
               Width="300px" Class="noose-drawer" Style="max-width:88vw;">
        @* signed in is not enough: a citizen on an internal URL lands here, and most sections only shut out partners *@
        <AuthorizeView Policy="@Policies.ActiveAgent">
            <Authorized>
                <NavMenu />
            </Authorized>
        </AuthorizeView>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="px-3 px-sm-4 py-3 py-md-6">
            @* first thing under the app bar: a call-in outranks every notice *@
            <EmergencyAlarmBanner />
            <AuthorizeView Policy="@Policies.OnlyReadMode" Context="ro">
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                    Nur-Lese-Modus (Aufsicht): Sie können alle Inhalte einsehen, aber keine Änderungen speichern.
                </MudAlert>
            </AuthorizeView>

            @if (_isDemo)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4 no-print">
                    Demo-Modus: schreibgeschützte Vorschau mit Beispieldaten. Änderungen sind nicht möglich.
                </MudAlert>
            }

            @* Announcement banner, maintained by leadership/admins under /einstellungen?tab=system. *@
            @if (!string.IsNullOrWhiteSpace(_configuration?.BannerText))
            {
                <MudAlert Severity="@BannerSeverity" Dense="true" Class="mb-4 no-print">@_configuration!.BannerText</MudAlert>
            }

            @if (_configuration?.MaintenanceModeActive == true && _isAdmin)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4 no-print">
                    Wartungsmodus aktiv – normale Agenten sehen derzeit nur die Wartungsseite.
                    Deaktivieren unter <MudLink Href="/einstellungen?tab=system" Color="Color.Inherit"><b>System</b></MudLink>.
                </MudAlert>
            }

            @* Maintenance mode: blocks content for everyone except admins. *@
            @if (_configuration?.MaintenanceModeActive == true && !_isAdmin)
            {
                <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="pa-12">
                    <MudIcon Icon="@Icons.Material.Filled.Construction" Color="Color.Warning" Style="font-size:4rem;" />
                    <MudText Typo="Typo.h5">Wartungsmodus</MudText>
                    <MudText Typo="Typo.body1" Class="mud-text-secondary" Style="max-width:480px;text-align:center;">
                        @(_configuration!.MaintenanceModeText ?? "Das System wird gerade gewartet. Bitte versuche es in Kürze erneut.")
                    </MudText>
                </MudStack>
            }
            else if (PartnerBlocked(CurrentPath))
            {
                @* partner read access: released areas only *@
                <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="pa-12">
                    <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" Style="font-size:4rem;" />
                    <MudText Typo="Typo.h5">Kein Zugriff</MudText>
                    <MudText Typo="Typo.body1" Class="mud-text-secondary" Style="max-width:480px;text-align:center;">
                        Dieser Bereich ist für Partnerbehörden nicht freigegeben. Sie sehen ausschließlich die für Ihre
                        Behörde freigegebenen Akten.
                    </MudText>
                    <MudButton Href="/dashboard" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Home">Zur Startseite</MudButton>
                </MudStack>
            }
            else
            {
                <NavBreadcrumbs />
                @* once after an update: what changed since the last visit; not over the maintenance page *@
                <ChangelogNewsPrompt />
                @* someone presents live: a notice with a way in, for whoever may watch *@
                <LivePresentationBanner />
                @* safety net: a single page error must not kill the whole circuit *@
                <ErrorBoundary @key="CurrentPath">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent>
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="my-4">
                            Ein unerwarteter Fehler ist aufgetreten – die Aktion wurde abgebrochen.
                            <MudLink Href="@($"/{CurrentPath}")" Color="Color.Inherit"><b>Seite neu laden</b></MudLink>
                        </MudAlert>
                    </ErrorContent>
                </ErrorBoundary>
            }
        </MudContainer>

        @* Legal footer, reachable from anywhere. *@
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="px-3 px-sm-4 pb-4 no-print">
            <MudDivider Class="mb-2" />
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
                <MudLink Href="@LegalData.ImprintUrl" Target="_blank" rel="noopener noreferrer"
                         Typo="Typo.caption" Color="Color.Default">Impressum</MudLink>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">·</MudText>
                <MudLink Href="/datenschutz" Typo="Typo.caption" Color="Color.Default">Datenschutz</MudLink>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">·</MudText>
                <MudLink Href="/nutzungsbedingungen" Typo="Typo.caption" Color="Color.Default">Nutzungsbedingungen</MudLink>
            </MudStack>
        </MudContainer>
    </MudMainContent>

    @* Command palette (Ctrl+K) and the keyboard shortcuts, only for active agents. *@
    <AuthorizeView Policy="@Policies.ActiveAgent">
        <Authorized Context="cp">
            <CommandPalette @ref="_palette" />
            <KeyboardShortcuts />
            <RecentsTracker />
            <PresenceStamp />
        </Authorized>
    </AuthorizeView>
</MudLayout>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool _drawerOpen = true;
    private string? _agentId;
    private string _search = string.Empty;
    private SystemConfiguration? _configuration;
    private MudTheme _theme = NooseTheme.Theme;
    private bool _isAdmin;
    private bool _isPartner;
    private bool _isDemo;
    private IReadOnlySet<string>? _allowedPartnerTypes;
    private PartnerFeature _partnerFeatures;
    private string? _avatarUrl;

    // re-evaluated each render
    private string CurrentPath => Nav.ToBaseRelativePath(Nav.Uri);

    protected override async Task OnInitializedAsync()
    {
        _configuration = await SettingService.GetAsync();
        _theme = NooseTheme.WithColours(_configuration.ThemePrimary, _configuration.ThemeSecondary, _configuration.ThemeTertiary);

        if (AuthStateTask is not null)
        {
            var user = (await AuthStateTask).User;
            _isAdmin = user.IsAdmin();
            _isDemo = user.IsDemo();
            _isPartner = user.IsPartner();
            if (_isPartner)
            {
                _allowedPartnerTypes = await PartnerPolicy.GetAllowedTypesAsync(user);
                _partnerFeatures = await PartnerProfiles.GetFeaturesAsync(user);
            }

            // remembered drawer state (read at prerender → no post-hydration flicker)
            _agentId = user.GetAgentId();
            if (!string.IsNullOrEmpty(_agentId))
            {
                _drawerOpen = (await NavPrefs.GetAsync(_agentId)).DrawerOpen;
                // read once per circuit; a fresh picture shows after the next reload
                try { _avatarUrl = AgentAvatar.Url((await AgentService.FindAsync(_agentId))?.AvatarFileName); }
                catch { /* best effort */ }
            }
        }
    }

    private string? _partnerGatePath;

    // releases granted mid-session
    protected override async Task OnParametersSetAsync()
    {
        if (!_isPartner || AuthStateTask is null || _partnerGatePath == CurrentPath)
        {
            return;
        }
        var first = _partnerGatePath is null;
        _partnerGatePath = CurrentPath;
        if (first)
        {
            return;
        }
        var user = (await AuthStateTask).User;
        _allowedPartnerTypes = await PartnerPolicy.GetAllowedTypesAsync(user);
        _partnerFeatures = await PartnerProfiles.GetFeaturesAsync(user);
    }

    // partner gate: allowlisted route AND (not a record type OR the rank may access that type)
    private bool PartnerBlocked(string path)
    {
        if (!_isPartner)
        {
            return false;
        }
        if (!PartnerRoutes.IsAllowed(path, _partnerFeatures))
        {
            return true;
        }
        // documents enforce their own per-record visibility at the page layer
        if (PartnerTabCatalog.IsTypeGateExempt(path))
        {
            return false;
        }
        var typeKey = PartnerTabCatalog.TypeKeyForPath(path);
        return typeKey is not null && _allowedPartnerTypes is not null && !_allowedPartnerTypes.Contains(typeKey);
    }

    private Severity BannerSeverity => _configuration?.BannerLevel switch
    {
        BannerLevels.Warning => Severity.Warning,
        BannerLevels.Error => Severity.Error,
        _ => Severity.Info,
    };

    private Task QuickAddAsync() => QuickAddDialog.ShowAsync(DialogService);

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
        if (!string.IsNullOrEmpty(_agentId))
        {
            // remember preference (fire-and-forget)
            _ = NavPrefs.SetDrawerOpenAsync(_agentId, _drawerOpen);
        }
    }

    // below 960px: open or close for this visit only, NavPreferences.DrawerOpen belongs to the desktop
    private void ToggleDrawerNarrow() => _drawerOpen = !_drawerOpen;

    // the same avatar in the app bar (tablet and desktop) and on the phone's profile menu button
    private RenderFragment AvatarOf(System.Security.Claims.ClaimsPrincipal user) => __builder =>
    {
        if (_avatarUrl is not null)
        {
            <MudAvatar Size="Size.Medium">
                <MudImage Src="@_avatarUrl" Alt="Mein Profilbild" />
            </MudAvatar>
        }
        else
        {
            <MudAvatar Color="Color.Primary" Size="Size.Medium">@Initial(DisplayName(user))</MudAvatar>
        }
    };

    private CommandPalette? _palette;

    private Task OpenPaletteAsync() => _palette?.Open() ?? Task.CompletedTask;

    private void SearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_search))
        {
            Nav.NavigateTo($"/suche?q={Uri.EscapeDataString(_search.Trim())}");
        }
    }

    private static string Initial(string? name)
        => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();

    private static string DisplayName(System.Security.Claims.ClaimsPrincipal user)
    {
        var codename = user.GetCodename();
        return string.IsNullOrWhiteSpace(codename) ? "Unbenannter Agent" : codename;
    }

    private static string RankRow(System.Security.Claims.ClaimsPrincipal user)
    {
        var parts = new List<string>();
        var badgeNumber = user.GetBadgeNumber();
        if (!string.IsNullOrWhiteSpace(badgeNumber)) parts.Add($"Nr. {badgeNumber}");
        var rank = user.GetRank();
        var unit = DivisionRules.Of(rank, user.GetDivision(), user.IsTRU());
        parts.Add(RankDisplay.Name(rank, unit.Home));
        if (!unit.IsNone) parts.Add(DivisionRules.Label(unit));
        if (user.IsHRB()) parts.Add(DepartmentRules.ColumnLabel);
        if (user.IsAdmin()) parts.Add("Admin");
        return string.Join(" · ", parts);
    }
}
