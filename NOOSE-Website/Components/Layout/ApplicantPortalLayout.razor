@inherits LayoutComponentBase
@inject IBewerbungService BewerbungService

@* Shell for the authenticated applicant portal; same header and same tab bar as the public site. *@
<MudThemeProvider Theme="NooseTheme.Theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div style="min-height:100vh;background:var(--mud-palette-background,#1C1C1C);padding:24px 16px;">
    <div style="max-width:960px;margin:0 auto;">
        <PublicHeader HomeHref="/" Subtitle="Bewerber-Portal" DisplayName="@_displayName" />

        <MudDivider Class="mb-2" />
        <PublicNav />

        <div class="mt-4">
            @Body
        </div>

        <LegalFooter />
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private string? _displayName;

    protected override async Task OnInitializedAsync()
    {
        // prefer the name the applicant entered over the Discord username
        try
        {
            if (AuthState is not null)
            {
                var user = (await AuthState).User;
                _displayName = (await BewerbungService.GetOwnAsync(user))?.Name;
            }
        }
        catch { /* best effort */ }
    }
}
