@* Two-column drawer: an icon rail of areas on the left, the entries of the selected area on the right. *@
@implements IDisposable
@using NOOSE_Website.Navigation
@using NOOSE_Website.Models.Navigation
@using NOOSE_Website.Components.Common.Navigation
@inject INavPreferencesService NavPrefs
@inject IDialogService DialogService
@inject NavigationManager Nav

<div class="noose-nav">
    <nav class="noose-nav-rail" aria-label="Bereiche" @onkeydown="RailKeyDownAsync">
        @foreach (var entry in TopEntries)
        {
            <MudTooltip Text="@entry.Label" Placement="Placement.Right">
                <MudIconButton Icon="@entry.Icon" Href="@entry.Route"
                               Color="@(IsCurrent(entry) ? Color.Primary : Color.Default)"
                               aria-label="@entry.Label"
                               aria-current="@(IsCurrent(entry) ? "page" : null)" />
            </MudTooltip>
        }

        @* saved views share the favorites panel, so either one is reason enough for the button *@
        @if (_prefs.Favorites.Count > 0 || VisibleViews.Any())
        {
            <MudTooltip Text="Favoriten" Placement="Placement.Right">
                <MudIconButton Icon="@Icons.Material.Filled.Star"
                               Color="@(_favoritesOpen ? Color.Primary : Color.Default)"
                               Class="@(_favoritesOpen ? "noose-nav-rail-active" : null)"
                               OnClick="ShowFavoritesAsync" aria-label="Favoriten" />
            </MudTooltip>
        }

        <MudDivider Class="my-1" />

        @for (var i = 0; i < _areas.Count; i++)
        {
            var area = _areas[i];
            var index = i;
            <MudTooltip Text="@NavAreaCatalog.Name(area)" Placement="Placement.Right">
                <MudIconButton @ref="_railButtons[index]"
                               Icon="@NavAreaCatalog.Icon(area)"
                               Color="@(IsSelected(area) ? Color.Primary : Color.Default)"
                               Class="@(IsSelected(area) ? "noose-nav-rail-active" : null)"
                               OnClick="@(() => SelectAreaAsync(area))"
                               aria-label="@NavAreaCatalog.Name(area)"
                               aria-selected="@(IsSelected(area) ? "true" : "false")"
                               aria-controls="noose-nav-panel"
                               tabindex="@(IsSelected(area) ? 0 : -1)" />
            </MudTooltip>
        }
    </nav>

    <div class="noose-nav-panel" id="noose-nav-panel" role="region" aria-label="@PanelCaption">
        <div class="d-flex align-center px-3 py-2">
            <MudText Typo="Typo.overline" Class="mud-text-secondary">@PanelCaption</MudText>
            <MudSpacer />
            <MudTooltip Text="Navigation anpassen">
                <MudIconButton Icon="@Icons.Material.Filled.Tune" Size="Size.Small"
                               OnClick="OpenCustomizeAsync" aria-label="Navigation anpassen" />
            </MudTooltip>
        </div>

        <AuthorizeView Policy="@Policies.InternalAgent" Context="filterBox">
            <div class="px-3 pb-2">
                <MudTextField T="string" Value="_filter" ValueChanged="FilterChanged" Immediate="true" Clearable="true"
                              Placeholder="Menü durchsuchen…" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.FilterList"
                              aria-label="Menü durchsuchen" />
            </div>
        </AuthorizeView>

        @* the MudNavMenu wrapper is load-bearing: MudBlazor scopes the active-link colour to it *@
        <MudNavMenu Color="Color.Primary" Bordered="true">
            @if (_favoritesOpen && !Filtering)
            {
                @foreach (var fav in _prefs.Favorites)
                {
                    @Favorite(fav)
                }
                @if (VisibleViews.Any())
                {
                    <MudText Typo="Typo.caption" Class="px-4 pt-3 pb-1 mud-text-secondary">Meine Ansichten</MudText>
                    @foreach (var view in VisibleViews)
                    {
                        @* no active highlight: NavLink ignores the query, so every view of a list would light up at once *@
                        <MudNavLink Href="@view.Route" Match="NavLinkMatch.All" ActiveClass="" Icon="@view.Icon">@view.Label</MudNavLink>
                    }
                }
            }
            else
            {
                @foreach (var group in PanelGroups())
                {
                    @if (group.Caption is { } caption)
                    {
                        <MudText Typo="Typo.caption" Class="px-4 pt-2 pb-1 mud-text-secondary">@caption</MudText>
                    }
                    @foreach (var entry in group.Entries)
                    {
                        @NavLink(entry)
                    }
                }
                @if (Filtering && PanelGroups().Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="px-4 py-3 mud-text-secondary">Keine Treffer für „@_filter".</MudText>
                }
            }
        </MudNavMenu>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;
    [Inject] private IAuthorizationService Authorization { get; set; } = default!;
    [Inject] private IAgentManagementService AgentService { get; set; } = default!;
    [Inject] private ITaskforceService TaskforceService { get; set; } = default!;
    [Inject] private IPersonnelFileService PersonnelFileService { get; set; } = default!;
    [Inject] private IRequestService RequestService { get; set; } = default!;
    [Inject] private NOOSE_Website.Services.Public.IPublicWantedService PublicWanted { get; set; } = default!;
    [Inject] private NOOSE_Website.Services.Public.IBountyService Bounty { get; set; } = default!;
    [Inject] private IAnnouncementService BoardService { get; set; } = default!;
    [Inject] private SharesBroadcaster SharesBroadcaster { get; set; } = default!;
    [Inject] private AcknowledgmentBroadcaster AcknowledgmentBroadcaster { get; set; } = default!;
    [Inject] private FinancingBroadcaster FinancingBroadcaster { get; set; } = default!;
    [Inject] private TipsBroadcaster TipsBroadcaster { get; set; } = default!;
    [Inject] private IFinancingService FinancingService { get; set; } = default!;
    [Inject] private NOOSE_Website.Services.Public.ITipService TipService { get; set; } = default!;
    [Inject] private IPartnerVisibilityPolicyService PartnerPolicy { get; set; } = default!;
    [Inject] private IPartnerAgencyProfileService PartnerProfiles { get; set; } = default!;
    [Inject] private Microsoft.Extensions.Logging.ILogger<NavMenu> Logger { get; set; } = default!;

    private ClaimsPrincipal? _user;
    private string? _agentId;
    private NavPreferences _prefs = new();
    private int _openShares;
    private int _openAcknowledgments;
    private int _openFinancing;
    private int _openTips;
    private IReadOnlySet<string>? _allowedPartnerTypes;
    private IReadOnlyList<NavEntry> _partnerEntries = [];
    private string? _filter;

    // snapshot per policy, taken once per circuit: a rank change rotates the security stamp and forces re-login
    private readonly Dictionary<string, bool> _policyOk = new(StringComparer.Ordinal);
    private List<NavArea> _areas = [];
    private MudIconButton?[] _railButtons = [];
    private NavArea? _area;
    private bool _favoritesOpen;

    private bool Filtering => !string.IsNullOrWhiteSpace(_filter);

    private bool IsSelected(NavArea area) => !_favoritesOpen && _area == area;

    private string PanelCaption => Filtering
        ? "Treffer"
        : _favoritesOpen ? "Favoriten"
        : _area is { } a ? NavAreaCatalog.Name(a).ToUpperInvariant()
        : "Navigation";

    // dashboard and search stay reachable from every area; partners also keep their profile here
    private IReadOnlyList<NavEntry> TopEntries => _user?.IsPartner() == true
        ? [.. NavCatalog.Section(NavSection.Primary), .. Filtered("profil")]
        : NavCatalog.Section(NavSection.Primary).ToList();

    private IEnumerable<NavEntry> Filtered(string key)
        => NavCatalog.ByKey(key) is { } e ? [e] : [];

    private IReadOnlyList<NavEntry> VisibleEntries(NavArea area)
        => area == NavArea.Partner
            ? _partnerEntries
            : NavPersonalization.Apply(
                NavAreaCatalog.Entries(area).Where(e => _policyOk.GetValueOrDefault(NavSectionPolicy.For(e.Section))),
                _prefs).ToList();

    private sealed record PanelGroup(string? Caption, IReadOnlyList<NavEntry> Entries);

    // no filter: just the selected area. filtering: every area the viewer may see, captioned.
    private IReadOnlyList<PanelGroup> PanelGroups()
    {
        if (!Filtering)
        {
            return _area is { } a ? [new PanelGroup(null, VisibleEntries(a))] : [];
        }

        var needle = _filter!.Trim();
        var groups = new List<PanelGroup>();
        foreach (var area in _areas)
        {
            var hits = VisibleEntries(area)
                .Where(e => e.Label.Contains(needle, StringComparison.OrdinalIgnoreCase)
                         || (e.Description?.Contains(needle, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();
            if (hits.Count > 0)
            {
                groups.Add(new PanelGroup(NavAreaCatalog.Name(area).ToUpperInvariant(), hits));
            }
        }
        return groups;
    }

    private bool IsCurrent(NavEntry entry)
        => NavCatalog.ByRoute(Nav.ToBaseRelativePath(Nav.Uri))?.Key == entry.Key;

    private RenderFragment NavLink(NavEntry entry) =>@<MudNavLink Href="@entry.Route" Match="@entry.Match" Icon="@entry.Icon"
                                                                  title="@entry.Description"
                                                                  aria-current="@(IsCurrent(entry) ? "page" : null)">
        @entry.Label
        @if (entry.BadgeKey == "acknowledgments" && _openAcknowledgments > 0)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Class="ml-2">@_openAcknowledgments</MudChip>
        }
        @if (entry.BadgeKey == "shares" && _openShares > 0)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Class="ml-2">@_openShares</MudChip>
        }
        @if (entry.BadgeKey == "financing" && _openFinancing > 0)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Class="ml-2">@_openFinancing</MudChip>
        }
        @if (entry.BadgeKey == "tips" && _openTips > 0)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Class="ml-2">@_openTips</MudChip>
        }
    </MudNavLink>;

    // page favorites gate by their section policy; partner page favorites gate by allowed types; records re-check on click
    private RenderFragment Favorite(NavFavorite fav) => __builder =>
    {
        var key = fav.Key ?? string.Empty;

        // a favorite on a page that V1.5 merged away follows it to its new home
        if (fav.Kind == "page" && NavCatalog.ByKey(key) is null && LegacyRoutes.AliasKey(key) is { } alias)
        {
            key = alias;
        }

        if (fav.Kind == "page" && NavCatalog.ByKey(key) is { } e)
        {
            <AuthorizeView Policy="@NavSectionPolicy.For(e.Section)" Context="favCtx">
                <MudNavLink Href="@e.Route" Match="NavLinkMatch.Prefix" Icon="@e.Icon">@e.Label</MudNavLink>
            </AuthorizeView>
        }
        else if (fav.Kind == "page" && _user?.IsPartner() == true && PartnerTypeAllowed(fav.Key))
        {
            <MudNavLink Href="@fav.Route" Match="NavLinkMatch.Prefix" Icon="@fav.Icon">@fav.Label</MudNavLink>
        }
        else if (fav.Kind == "record")
        {
            <MudNavLink Href="@fav.Route" Match="NavLinkMatch.Prefix" Icon="@fav.Icon">@fav.Label</MudNavLink>
        }
    };

    // filtered before counting, so the rail button and the heading never stand over a list with nothing in it;
    // the same per-circuit policy snapshot gates the drawer's own entries
    private IEnumerable<SavedView> VisibleViews => _prefs.SavedViews.Where(ViewAllowed);

    // a view gates like the list it opens; partners reach a list only through a record type released to their rank
    private bool ViewAllowed(SavedView view)
        => _user?.IsPartner() == true
            ? PartnerViewAllowed(view.Route)
            : NavCatalog.ByRoute(view.Route) is { } e && _policyOk.GetValueOrDefault(NavSectionPolicy.For(e.Section));

    private bool PartnerViewAllowed(string route)
    {
        var path = SavedViewRules.PathOf(route);
        return PartnerTabCatalog.All.Any(t =>
            string.Equals("/" + t.RoutePrefix, path, StringComparison.OrdinalIgnoreCase)
            && PartnerTypeAllowed("partner." + t.TypeKey));
    }

    // partner page favorite "partner.<Type>" still within the rank's allowed set
    private bool PartnerTypeAllowed(string? key)
    {
        if (key is null || !key.StartsWith("partner.", StringComparison.Ordinal))
        {
            return false;
        }
        var typeKey = key["partner.".Length..];
        return _allowedPartnerTypes is null || _allowedPartnerTypes.Contains(typeKey);
    }

    private Task OpenCustomizeAsync() => NavCustomizeDialog.ShowAsync(DialogService);

    private void FilterChanged(string? value)
    {
        _filter = value;
        StateHasChanged();
    }

    // switching areas is not navigation; it only swaps what the panel lists
    private async Task SelectAreaAsync(NavArea area)
    {
        _favoritesOpen = false;
        _area = area;
        if (!string.IsNullOrEmpty(_agentId))
        {
            await NavPrefs.SetLastAreaAsync(_agentId, area.ToString());
        }
    }

    private Task ShowFavoritesAsync()
    {
        _favoritesOpen = true;
        return Task.CompletedTask;
    }

    // roving focus over the rail; the handler sits on the nav so it never steals keys from the filter field
    private async Task RailKeyDownAsync(KeyboardEventArgs e)
    {
        if (_areas.Count == 0)
        {
            return;
        }
        var current = _area is { } a ? Math.Max(0, _areas.IndexOf(a)) : 0;
        var next = e.Key switch
        {
            "ArrowDown" or "ArrowRight" => (current + 1) % _areas.Count,
            "ArrowUp" or "ArrowLeft" => (current - 1 + _areas.Count) % _areas.Count,
            "Home" => 0,
            "End" => _areas.Count - 1,
            _ => -1,
        };
        if (next < 0)
        {
            return;
        }
        await SelectAreaAsync(_areas[next]);
        if (_railButtons.Length > next && _railButtons[next] is { } button)
        {
            await button.FocusAsync();
        }
    }

    // the area holding the current route wins over the remembered one
    private void SyncActiveArea()
    {
        var entry = NavCatalog.ByRoute(Nav.ToBaseRelativePath(Nav.Uri));
        if (entry is not null && entry.Area != NavArea.Primary && _areas.Contains(entry.Area))
        {
            _favoritesOpen = false;
            _area = entry.Area;
            return;
        }
        if (_area is null || !_areas.Contains(_area.Value))
        {
            _area = _areas.Count > 0 ? _areas[0] : null;
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => _ = InvokeAsync(() =>
        {
            SyncActiveArea();
            StateHasChanged();
        });

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _agentId = _user.GetAgentId();
        NavPrefs.Changed += OnPrefsChanged;
        Nav.LocationChanged += OnLocationChanged;
        if (!string.IsNullOrEmpty(_agentId))
        {
            _prefs = await NavPrefs.GetAsync(_agentId);
        }
        await BuildAreasAsync();

        // partners: skip the leadership badge queries entirely
        if (_user?.IsPartner() == true)
        {
            return;
        }

        // prerender is a static snapshot: subscribing would leak a dead handler onto the singletons
        if (RendererInfo.IsInteractive)
        {
            SharesBroadcaster.Modified += OnSharesModified;
            AcknowledgmentBroadcaster.Modified += OnAcknowledgmentModified;
            FinancingBroadcaster.Modified += OnFinancingModified;
            TipsBroadcaster.Modified += OnTipsModified;
        }
        await LoadSharesAsync();
        await LoadAcknowledgmentsAsync();
        await LoadFinancingAsync();
        await LoadTipsAsync();
    }

    // partners get one runtime area; internal agents get the areas holding at least one permitted entry
    private async Task BuildAreasAsync()
    {
        if (_user is null)
        {
            return;
        }

        if (_user.IsPartner())
        {
            _allowedPartnerTypes = await PartnerPolicy.GetAllowedTypesAsync(_user);
            _partnerEntries = NavPersonalization.Apply(
                NavCatalog.PartnerRecordEntries(_allowedPartnerTypes, await PartnerProfiles.GetFeaturesAsync(_user)), _prefs).ToList();
            _areas = _partnerEntries.Count > 0 ? [NavArea.Partner] : [];
        }
        else
        {
            foreach (var policy in NavAreaCatalog.DistinctPolicies)
            {
                _policyOk[policy] = (await Authorization.AuthorizeAsync(_user, policy)).Succeeded;
            }
            _areas = NavAreaCatalog.Areas.Where(a => VisibleEntries(a).Count > 0).ToList();
        }

        _railButtons = new MudIconButton?[_areas.Count];
        if (Enum.TryParse<NavArea>(_prefs.LastArea, out var remembered) && _areas.Contains(remembered))
        {
            _area = remembered;
        }
        SyncActiveArea();
    }

    // reload personalized menu after the customizer saved (same circuit)
    private void OnPrefsChanged()
        => _ = InvokeAsync(async () =>
        {
            if (!string.IsNullOrEmpty(_agentId))
            {
                _prefs = await NavPrefs.GetAsync(_agentId);
                await BuildAreasAsync();
                StateHasChanged();
            }
        });

    // decorative badge: a DB error here must not tear the prerender or the circuit
    private async Task LoadAcknowledgmentsAsync()
    {
        if (_user is null)
        {
            return;
        }
        try
        {
            _openAcknowledgments = await BoardService.GetOpenAcknowledgmentsCountAsync(_user);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Quittierungs-Badge konnte nicht geladen werden.");
        }
    }

    // sums open inbox items (same sources as the shares page); sets the value fresh each call
    private async Task LoadSharesAsync()
    {
        if (_user is null)
        {
            return;
        }
        try
        {
            var open = 0;

            // classification-upgrade requests are decided from Senior Special Agent up
            if (_user.MayHighestClassification())
            {
                open += await RequestService.GetOpenCountAsync(_user.IsLeadership());
                // added here rather than inside GetOpenCountAsync: the dashboard reads that one unconditionally for
                // every agent and labels the number "Hochstufung"
                open += await PublicWanted.GetPendingRequestCountAsync();
                open += await Bounty.GetPendingRequestCountAsync();
            }

            // registrations, name changes, profile pictures, taskforce and promotion requests are leadership-only
            if (_user.IsLeadership())
            {
                open += (await AgentService.GetPendingAsync()).Count
                    + (await AgentService.GetPendingNameChangesAsync()).Count
                    + (await AgentService.GetPendingAvatarsAsync()).Count
                    + (await TaskforceService.GetRequestedAsync()).Count
                    + (await PersonnelFileService.GetOpenPromotionRequestsAsync()).Count;
            }
            _openShares = open;
        }
        catch (Exception ex)
        {
            /* best effort */
            Logger.LogWarning(ex, "Freigaben-Badge konnte nicht geladen werden.");
        }
    }

    // decorative badge: the entry is visible to every agent, but only deciders get a count
    private async Task LoadFinancingAsync()
    {
        if (_user is null || !_user.IsLeadership())
        {
            _openFinancing = 0;
            return;
        }
        try
        {
            _openFinancing = await FinancingService.GetOpenCountAsync();
        }
        catch (Exception ex)
        {
            /* best effort */
            Logger.LogWarning(ex, "Finanzierungs-Badge konnte nicht geladen werden.");
        }
    }

    // every internal agent works the tip inbox, so every internal agent gets the count
    private async Task LoadTipsAsync()
    {
        if (_user is null || !_user.IsInternalAgent())
        {
            _openTips = 0;
            return;
        }
        try
        {
            _openTips = await TipService.GetOpenCountAsync();
        }
        catch (Exception ex)
        {
            /* best effort */
            Logger.LogWarning(ex, "Hinweis-Badge konnte nicht geladen werden.");
        }
    }

    // a handler must never throw back into the broadcaster's invocation chain, or the live
    // subscribers later in the chain are skipped and the triggering page catches the fault
    private void OnSharesModified()
    {
        try
        {
            _ = InvokeAsync(async () =>
            {
                await LoadSharesAsync();
                StateHasChanged();
            });
        }
        catch (InvalidOperationException) { /* circuit gone */ }
    }

    // the count was only ever read while the drawer was being built, so it stood still for the whole session
    private void OnTipsModified(string tipId, string caseNumber, TipMessageAudience? audience)
    {
        try
        {
            _ = InvokeAsync(async () =>
            {
                await LoadTipsAsync();
                StateHasChanged();
            });
        }
        catch (InvalidOperationException) { /* circuit gone */ }
    }

    private void OnFinancingModified()
    {
        try
        {
            _ = InvokeAsync(async () =>
            {
                await LoadFinancingAsync();
                StateHasChanged();
            });
        }
        catch (InvalidOperationException) { /* circuit gone */ }
    }

    // only react to this agent's own acknowledgment signal
    private void OnAcknowledgmentModified(string agentId)
    {
        if (agentId != _user?.GetAgentId())
        {
            return;
        }
        try
        {
            _ = InvokeAsync(async () =>
            {
                await LoadAcknowledgmentsAsync();
                StateHasChanged();
            });
        }
        catch (InvalidOperationException) { /* circuit gone */ }
    }

    public void Dispose()
    {
        NavPrefs.Changed -= OnPrefsChanged;
        Nav.LocationChanged -= OnLocationChanged;
        SharesBroadcaster.Modified -= OnSharesModified;
        AcknowledgmentBroadcaster.Modified -= OnAcknowledgmentModified;
        FinancingBroadcaster.Modified -= OnFinancingModified;
        TipsBroadcaster.Modified -= OnTipsModified;
    }
}
