@* One labelled column: start link, favorites, then one collapsible group per area the viewer may see. *@
@implements IDisposable
@using NOOSE_Website.Navigation
@using NOOSE_Website.Models.Navigation
@using NOOSE_Website.Components.Common.Navigation
@inject INavPreferencesService NavPrefs
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject NavBadgeState Badges

<nav class="noose-nav" aria-label="Hauptnavigation">
    @* the MudNavMenu wrappers are load-bearing: MudBlazor scopes the active-link colour to them *@
    <MudNavMenu Color="Color.Primary" Bordered="true" Class="pt-2">
        @foreach (var entry in TopEntries)
        {
            @NavLink(entry)
        }
    </MudNavMenu>

    <AuthorizeView Policy="@Policies.InternalAgent" Context="filterBox">
        <div class="px-3 pt-2 pb-1">
            <MudTextField T="string" Value="_filter" ValueChanged="FilterChanged" Immediate="true" Clearable="true"
                          Placeholder="Menü durchsuchen…" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.FilterList"
                          aria-label="Menü durchsuchen" />
        </div>
    </AuthorizeView>

    @if (Filtering)
    {
        var hits = FilterHits();
        <MudNavMenu Color="Color.Primary" Bordered="true">
            @foreach (var (caption, entries) in hits)
            {
                <MudText Typo="Typo.caption" Class="px-4 pt-2 pb-1 mud-text-secondary">@caption</MudText>
                @foreach (var entry in entries)
                {
                    @NavLink(entry)
                }
            }
        </MudNavMenu>
        @if (hits.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="px-4 py-3 mud-text-secondary">Keine Treffer für „@_filter". Strg+K durchsucht auch Akten.</MudText>
        }
    }
    else
    {
        @if (_prefs.Favorites.Count > 0 || VisibleViews.Any())
        {
            @* the agent picked these, so they never fold away *@
            <MudText Typo="Typo.overline" Class="d-block px-4 pt-2 mud-text-secondary">Favoriten</MudText>
            <MudNavMenu Color="Color.Primary" Bordered="true">
                @foreach (var fav in _prefs.Favorites)
                {
                    @Favorite(fav)
                }
                @if (VisibleViews.Any())
                {
                    <MudText Typo="Typo.caption" Class="px-4 pt-2 pb-1 mud-text-secondary">Meine Ansichten</MudText>
                    @foreach (var view in VisibleViews)
                    {
                        @* no active highlight: NavLink ignores the query, so every view of a list would light up at once *@
                        <MudNavLink Href="@view.Route" Match="NavLinkMatch.All" ActiveClass="" Icon="@view.Icon">@view.Label</MudNavLink>
                    }
                }
            </MudNavMenu>
            <MudDivider Class="my-2" />
        }

        @foreach (var area in _areas)
        {
            var key = area.ToString();
            var entries = VisibleEntries(area);
            var open = IsOpen(key);
            var badge = open ? null : GroupBadge(entries);
            @GroupHeader(key, NavAreaCatalog.Name(area), NavAreaCatalog.Icon(area), badge?.Count ?? 0, badge?.Key, NavAreaCatalog.HubRoute(area))
            @if (open)
            {
                <MudNavMenu Color="Color.Primary" Bordered="true" id="@GroupId(key)">
                    @foreach (var group in Captioned(entries))
                    {
                        @if (group.Caption is { } caption)
                        {
                            <MudText Typo="Typo.caption" Class="px-4 pt-2 pb-1 mud-text-secondary">@caption</MudText>
                        }
                        @foreach (var entry in group.Entries)
                        {
                            @NavLink(entry)
                        }
                    }
                </MudNavMenu>
            }
        }
    }

    <div class="noose-nav-footer">
        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Tune"
                   OnClick="OpenCustomizeAsync" Class="mud-text-secondary">Navigation anpassen</MudButton>
    </div>
</nav>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;
    [Inject] private IAuthorizationService Authorization { get; set; } = default!;
    [Inject] private IPartnerVisibilityPolicyService PartnerPolicy { get; set; } = default!;
    [Inject] private IPartnerAgencyProfileService PartnerProfiles { get; set; } = default!;

    private ClaimsPrincipal? _user;
    private string? _agentId;
    private NavPreferences _prefs = new();
    private IReadOnlySet<string>? _allowedPartnerTypes;
    private IReadOnlyList<NavEntry> _partnerEntries = [];
    private string? _filter;

    // snapshot per policy, taken once per circuit: a rank change rotates the security stamp and forces re-login
    private readonly Dictionary<string, bool> _policyOk = new(StringComparer.Ordinal);
    private List<NavArea> _areas = [];

    // open for this visit: remembered groups plus every group a visited page belongs to
    private readonly HashSet<string> _open = new(StringComparer.Ordinal);

    private bool Filtering => !string.IsNullOrWhiteSpace(_filter);

    // the Primary section is open to every account; anything else up here keeps its own gate
    private IReadOnlyList<NavEntry> TopEntries
        => NavAreaCatalog.ListedEntries(NavArea.Primary)
            .Where(e => e.Section == NavSection.Primary || Allowed(e))
            .ToList();

    private bool Allowed(NavEntry e) => _policyOk.GetValueOrDefault(NavSectionPolicy.For(e.Section));

    private IReadOnlyList<NavEntry> VisibleEntries(NavArea area)
        => area == NavArea.Partner
            ? _partnerEntries
            : NavPersonalization.Apply(
                NavAreaCatalog.WithoutTwins(NavAreaCatalog.ListedEntries(area).Where(Allowed), Allowed),
                _prefs).ToList();

    private bool IsOpen(string group) => _open.Contains(group);

    private static string GroupId(string group) => "noose-nav-" + group.ToLowerInvariant();

    // the name opens the group's overview, the arrow only folds; partners have no overview, so their header only folds
    private RenderFragment GroupHeader(string group, string label, string icon, int count, string? badgeKey, string? hubRoute) => __builder =>
    {
        var open = IsOpen(group);
        var chevron = open ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore;
        if (hubRoute is null)
        {
            <button type="button" class="noose-nav-group noose-nav-group-knopf" aria-expanded="@(open ? "true" : "false")"
                    aria-controls="@GroupId(group)" @onclick="@(() => ToggleAsync(group))">
                <MudIcon Icon="@icon" Size="Size.Small" Class="mr-3" />
                <span class="noose-nav-group-name">@label</span>
                <NavBadgeChip BadgeKey="@badgeKey" Count="count" />
                <MudIcon Icon="@chevron" Size="Size.Small" Class="ml-auto" />
            </button>
        }
        else
        {
            var current = IsCurrentRoute(hubRoute);
            <div class="noose-nav-group">
                <a href="@hubRoute" class="@(current ? "noose-nav-group-link aktiv" : "noose-nav-group-link")"
                   aria-current="@(current ? "page" : null)" title="@($"Übersicht {label}")">
                    <MudIcon Icon="@icon" Size="Size.Small" Class="mr-3" />
                    <span class="noose-nav-group-name">@label</span>
                    <NavBadgeChip BadgeKey="@badgeKey" Count="count" />
                </a>
                <button type="button" class="noose-nav-group-toggle" aria-expanded="@(open ? "true" : "false")"
                        aria-controls="@GroupId(group)" aria-label="@($"{label} auf- oder zuklappen")"
                        @onclick="@(() => ToggleAsync(group))">
                    <MudIcon Icon="@chevron" Size="Size.Small" />
                </button>
            </div>
        }
    };

    private bool IsCurrentRoute(string route)
        => string.Equals("/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/'), route, StringComparison.OrdinalIgnoreCase);

    private sealed record GroupBadgeSum(string Key, int Count);

    // a closed group sums its entries; the colour follows the most urgent one
    private GroupBadgeSum? GroupBadge(IEnumerable<NavEntry> entries)
    {
        var counted = entries.Select(e => (e.BadgeKey, Count: Badges.Count(e.BadgeKey))).Where(x => x.Count > 0).ToList();
        if (counted.Count == 0)
        {
            return null;
        }
        var urgent = counted.OrderBy(x => NavBadgeChip.ColorOf(x.BadgeKey) switch
        {
            Color.Error => 0,
            Color.Warning => 1,
            _ => 2,
        }).First().BadgeKey!;
        return new GroupBadgeSum(urgent, counted.Sum(x => x.Count));
    }

    private sealed record PanelGroup(string? Caption, List<NavEntry> Entries);

    // entries with a group get its caption above each run of them; ungrouped areas stay one plain list
    private static IReadOnlyList<PanelGroup> Captioned(IReadOnlyList<NavEntry> entries)
    {
        var groups = new List<PanelGroup>();
        foreach (var entry in entries)
        {
            if (groups.Count > 0 && groups[^1].Caption == entry.Group)
            {
                groups[^1].Entries.Add(entry);
            }
            else
            {
                groups.Add(new PanelGroup(entry.Group, [entry]));
            }
        }
        return groups;
    }

    // every area the viewer may see, the app bar menus included, so "Handbuch" is found here too
    private IReadOnlyList<(string Caption, List<NavEntry> Entries)> FilterHits()
    {
        var needle = _filter!.Trim();
        var areas = _user?.IsPartner() == true ? _areas : [.. _areas, .. NavAreaCatalog.MenuAreas];
        var result = new List<(string, List<NavEntry>)>();
        foreach (var area in areas)
        {
            var hits = VisibleEntries(area)
                .Where(e => e.Label.Contains(needle, StringComparison.OrdinalIgnoreCase)
                         || (e.Description?.Contains(needle, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();
            if (hits.Count > 0)
            {
                result.Add((NavAreaCatalog.Name(area).ToUpperInvariant(), hits));
            }
        }
        return result;
    }

    private bool IsCurrent(NavEntry entry)
        => NavCatalog.ByRoute(Nav.ToBaseRelativePath(Nav.Uri))?.Key == entry.Key;

    private RenderFragment NavLink(NavEntry entry) =>@<MudNavLink Href="@entry.Route" Match="@entry.Match" Icon="@entry.Icon"
                                                                  title="@entry.Description"
                                                                  aria-current="@(IsCurrent(entry) ? "page" : null)">
        @entry.Label
        <NavBadgeChip BadgeKey="@entry.BadgeKey" Count="@Badges.Count(entry.BadgeKey)" />
    </MudNavLink>;

    // page favorites gate by their section policy; partner page favorites gate by allowed types; records re-check on click
    private RenderFragment Favorite(NavFavorite fav) => __builder =>
    {
        var key = fav.Key ?? string.Empty;

        // a favorite on a page that V1.5 merged away follows it to its new home
        if (fav.Kind == "page" && NavCatalog.ByKey(key) is null && LegacyRoutes.AliasKey(key) is { } alias)
        {
            key = alias;
        }

        if (fav.Kind == "page" && NavCatalog.ByKey(key) is { } e)
        {
            <AuthorizeView Policy="@NavSectionPolicy.For(e.Section)" Context="favCtx">
                <MudNavLink Href="@e.Route" Match="NavLinkMatch.Prefix" Icon="@e.Icon">@e.Label</MudNavLink>
            </AuthorizeView>
        }
        else if (fav.Kind == "page" && _user?.IsPartner() == true && PartnerTypeAllowed(fav.Key))
        {
            <MudNavLink Href="@fav.Route" Match="NavLinkMatch.Prefix" Icon="@fav.Icon">@fav.Label</MudNavLink>
        }
        else if (fav.Kind == "record")
        {
            <MudNavLink Href="@fav.Route" Match="NavLinkMatch.Prefix" Icon="@fav.Icon">@fav.Label</MudNavLink>
        }
    };

    // filtered before counting, so the group never stands over a list with nothing in it
    private IEnumerable<SavedView> VisibleViews => _prefs.SavedViews.Where(ViewAllowed);

    // a view gates like the list it opens; partners reach a list only through a record type released to their rank
    private bool ViewAllowed(SavedView view)
        => _user?.IsPartner() == true
            ? PartnerViewAllowed(view.Route)
            : NavCatalog.ByRoute(view.Route) is { } e && Allowed(e);

    private bool PartnerViewAllowed(string route)
    {
        var path = SavedViewRules.PathOf(route);
        return PartnerTabCatalog.All.Any(t =>
            string.Equals("/" + t.RoutePrefix, path, StringComparison.OrdinalIgnoreCase)
            && PartnerTypeAllowed("partner." + t.TypeKey));
    }

    // partner page favorite "partner.<Type>" still within the rank's allowed set
    private bool PartnerTypeAllowed(string? key)
    {
        if (key is null || !key.StartsWith("partner.", StringComparison.Ordinal))
        {
            return false;
        }
        var typeKey = key["partner.".Length..];
        return _allowedPartnerTypes is null || _allowedPartnerTypes.Contains(typeKey);
    }

    private Task OpenCustomizeAsync() => NavCustomizeDialog.ShowAsync(DialogService);

    private void FilterChanged(string? value)
    {
        _filter = value;
        StateHasChanged();
    }

    // folding is not navigation; it only shows or hides the entries
    private async Task ToggleAsync(string group)
    {
        var open = !_open.Remove(group);
        if (open)
        {
            _open.Add(group);
        }
        if (!string.IsNullOrEmpty(_agentId))
        {
            await NavPrefs.SetGroupOpenAsync(_agentId, group, open);
        }
    }

    // the group holding the current page opens, without being remembered beyond this visit
    private void OpenCurrentGroup()
    {
        var entry = NavCatalog.ByRoute(Nav.ToBaseRelativePath(Nav.Uri));
        if (_user?.IsPartner() == true)
        {
            _open.Add(NavArea.Partner.ToString());
        }
        else if (entry is not null && _areas.Contains(entry.Area))
        {
            _open.Add(entry.Area.ToString());
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => _ = InvokeAsync(() =>
        {
            OpenCurrentGroup();
            StateHasChanged();
        });

    private void OnBadgesChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _agentId = _user.GetAgentId();
        NavPrefs.Changed += OnPrefsChanged;
        Nav.LocationChanged += OnLocationChanged;
        Badges.Changed += OnBadgesChanged;
        if (!string.IsNullOrEmpty(_agentId))
        {
            _prefs = await NavPrefs.GetAsync(_agentId);
        }
        foreach (var area in Enum.GetValues<NavArea>())
        {
            if (_prefs.CollapsedGroups.Contains(NavPreferences.OpenGroupToken(area.ToString())))
            {
                _open.Add(area.ToString());
            }
        }
        await BuildAreasAsync();
        OpenCurrentGroup();

        // prerender is a static snapshot: subscribing there would only hold a dead scope
        await Badges.InitializeAsync(_user, RendererInfo.IsInteractive);
    }

    // partners get one runtime area; internal agents get the areas holding at least one permitted entry
    private async Task BuildAreasAsync()
    {
        if (_user is null)
        {
            return;
        }

        if (_user.IsPartner())
        {
            _allowedPartnerTypes = await PartnerPolicy.GetAllowedTypesAsync(_user);
            _partnerEntries = NavPersonalization.Apply(
                NavCatalog.PartnerRecordEntries(_allowedPartnerTypes, await PartnerProfiles.GetFeaturesAsync(_user)), _prefs).ToList();
            _areas = _partnerEntries.Count > 0 ? [NavArea.Partner] : [];
        }
        else
        {
            foreach (var policy in NavAreaCatalog.DistinctPolicies)
            {
                _policyOk[policy] = (await Authorization.AuthorizeAsync(_user, policy)).Succeeded;
            }
            _areas = NavAreaCatalog.Areas.Where(a => VisibleEntries(a).Count > 0).ToList();
        }
    }

    // reload personalized menu after the customizer saved (same circuit)
    private void OnPrefsChanged()
        => _ = InvokeAsync(async () =>
        {
            if (!string.IsNullOrEmpty(_agentId))
            {
                _prefs = await NavPrefs.GetAsync(_agentId);
                await BuildAreasAsync();
                StateHasChanged();
            }
        });

    public void Dispose()
    {
        NavPrefs.Changed -= OnPrefsChanged;
        Nav.LocationChanged -= OnLocationChanged;
        Badges.Changed -= OnBadgesChanged;
    }
}
