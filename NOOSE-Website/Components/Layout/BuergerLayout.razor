@inherits LayoutComponentBase
@inject IBuergerService BuergerService
@inject NavigationManager Nav

@* Shell for the authenticated citizen area; same header and same tab bar as the public site. *@
<MudThemeProvider Theme="NooseTheme.Theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="oeffentlich-rahmen" style="min-height:100vh;background:var(--mud-palette-background,#1C1C1C);padding:24px 16px;">
    <div style="max-width:960px;margin:0 auto;">
        <PublicHeader HomeHref="/" Subtitle="Bürgerbereich" DisplayName="@_displayName">
            <Actions>
                @if (_returnHref is not null)
                {
                    <MudButton Href="@_returnHref" Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.ArrowBack">@_returnLabel</MudButton>
                }
            </Actions>
        </PublicHeader>

        <MudDivider Class="mb-2" />
        @* the same two rows as on the public site: a citizen is never stranded and never loses the way out *@
        <PublicNav />

        <div class="mt-4">
            @Body
        </div>

        <LegalFooter />
    </div>
</div>

@code {
    // Profile enforcement lives here, not in the pages: every citizen page inherits this shell, so a new page
    // cannot forget the gate and accept a submission from a nameless account.
    private const string ProfileRoute = "/buerger/profil";

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private string? _displayName;
    private string? _returnHref;
    private string _returnLabel = string.Empty;
    private bool _mustComplete;

    // OnParametersSet, not OnInitialized: the layout instance survives navigation between citizen pages, so an
    // incomplete profile has to be re-checked on each of them instead of once per shell.
    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is null)
        {
            return;
        }

        BuergerProfil? profile;
        try
        {
            var user = (await AuthState).User;
            if (!user.MayUseCitizenPortal())
            {
                return;
            }

            // an agent or partner keeps a way back to their own area; an applicant already has the portal tab
            if (!user.IsCitizen() && !user.IsApplicant())
            {
                _returnHref = "/dashboard";
                _returnLabel = "Interner Bereich";
            }
            // only a citizen is pushed into the form: for everyone else the area is readable without a civilian
            // identity, and whoever wants to submit is sent to it from the ticket page or the tip form
            _mustComplete = user.IsCitizen();
            profile = await BuergerService.GetOwnAsync(user);
        }
        catch
        {
            /* best effort */
            return;
        }

        _displayName = profile is null ? null : $"{profile.FirstName} {profile.LastName}".Trim();

        // outside the try on purpose: during static rendering NavigateTo signals the redirect by throwing,
        // and catching that would swallow it
        var incomplete = profile is null
            || string.IsNullOrWhiteSpace(profile.FirstName)
            || string.IsNullOrWhiteSpace(profile.LastName);
        if (_mustComplete && incomplete && !OnProfilePage())
        {
            Nav.NavigateTo(ProfileRoute);
        }
    }

    private bool OnProfilePage()
        => CurrentPath().Equals(ProfileRoute, StringComparison.OrdinalIgnoreCase);

    private string CurrentPath()
        => "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Split('#')[0].TrimEnd('/');
}
