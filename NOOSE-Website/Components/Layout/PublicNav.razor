@implements IDisposable
@inject NavigationManager Nav
@inject IPublicModuleService ModuleService

@* Two rows: the public modules, and — for a signed-in visitor — their own area. Both come from a catalog.
   Below 600px both rows fold behind a menu button with the current area beside it (noose-nur-handy). It is a native
   <details>: the start page and most outward pages render statically and have no circuit to open a MudMenu.
   The key changes with every navigation, so an interactive shell that survives it shows the menu folded again. *@
<details class="noose-nur-handy oeffentlich-menue" @key="_navigations">
    <summary>
        <MudIcon Icon="@Icons.Material.Filled.Menu" />
        <AuthorizeView>
            <Authorized Context="labelCtx">
                <span class="oeffentlich-menue-aktuell">@CurrentLabel(CitizenNav.For(labelCtx.User))</span>
            </Authorized>
            <NotAuthorized>
                <span class="oeffentlich-menue-aktuell">@CurrentLabel([])</span>
            </NotAuthorized>
        </AuthorizeView>
        <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Class="oeffentlich-menue-pfeil" />
    </summary>
    <nav class="oeffentlich-menue-liste" aria-label="Bereiche">
        @foreach (var tab in _tabs)
        {
            var active = IsActive(tab.Href);
            <MudButton Href="@tab.Href" FullWidth="true" Class="justify-start"
                       Variant="@(active ? Variant.Filled : Variant.Text)"
                       Color="@(active ? Color.Primary : Color.Default)"
                       StartIcon="@tab.Icon">
                @tab.Label
            </MudButton>
        }
        @* the same rule as the personal row below: never rendered for an anonymous visitor *@
        <AuthorizeView>
            <Authorized Context="menuCtx">
                @{
                    var mineInMenu = CitizenNav.For(menuCtx.User);
                }
                @if (mineInMenu.Count > 0)
                {
                    <MudText Typo="Typo.overline" Class="mud-text-secondary oeffentlich-menue-titel">Mein Bereich</MudText>
                    @foreach (var entry in mineInMenu)
                    {
                        var active = IsActive(entry.Href);
                        <MudButton Href="@entry.Href" FullWidth="true" Class="justify-start"
                                   Variant="@(active ? Variant.Filled : Variant.Text)"
                                   Color="@(active ? Color.Secondary : Color.Default)"
                                   StartIcon="@entry.Icon">
                            @entry.Label
                        </MudButton>
                    }
                }
            </Authorized>
        </AuthorizeView>
    </nav>
</details>

<MudStack Spacing="1" Class="noose-mobil-aus">
    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        @{
            var previousGroup = StartGroup;
        }
        @foreach (var tab in _tabs)
        {
            @if (tab.Group != previousGroup)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary mx-1">·</MudText>
            }
            var active = IsActive(tab.Href);
            <MudButton Href="@tab.Href"
                       Variant="@(active ? Variant.Filled : Variant.Text)"
                       Color="@(active ? Color.Primary : Color.Default)"
                       StartIcon="@tab.Icon"
                       Size="Size.Small">
                @tab.Label
            </MudButton>
            previousGroup = tab.Group;
        }
    </MudStack>

    @* the personal row is never rendered for an anonymous visitor: these routes are private and carry no switch *@
    <AuthorizeView>
        <Authorized Context="authCtx">
            @{
                var mine = CitizenNav.For(authCtx.User);
            }
            @if (mine.Count > 0)
            {
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.overline" Class="mud-text-secondary mr-1">Mein Bereich</MudText>
                    @foreach (var entry in mine)
                    {
                        var active = IsActive(entry.Href);
                        <MudButton Href="@entry.Href"
                                   Variant="@(active ? Variant.Filled : Variant.Text)"
                                   Color="@(active ? Color.Secondary : Color.Default)"
                                   StartIcon="@entry.Icon"
                                   Size="Size.Small">
                            @entry.Label
                        </MudButton>
                    }
                </MudStack>
            }
        </Authorized>
    </AuthorizeView>
</MudStack>

@code {
    // Start is not a module: it has no switch, so it carries a group of its own and always renders first.
    private const int StartGroup = -1;

    private sealed record Tab(string Label, string Href, string Icon, int Group);

    private readonly List<Tab> _tabs =
    [
        new("Start", "/", Icons.Material.Filled.Home, StartGroup),
    ];

    protected override async Task OnInitializedAsync()
    {
        // the shell survives navigation, so the active tab only follows the URL via re-render
        Nav.LocationChanged += OnLocationChanged;
        try
        {
            foreach (var entry in await ModuleService.NavEntriesAsync())
            {
                _tabs.Add(new Tab(entry.Label, entry.NavRoute!, entry.Icon, (int)entry.Group));
            }
        }
        catch
        {
            /* best effort */
        }
    }

    // bumped on every navigation: the phone menu is keyed on it and comes back folded
    private int _navigations;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => _ = InvokeAsync(() =>
        {
            _navigations++;
            StateHasChanged();
        });

    /// <summary>The area the phone menu button names: the lit tab or personal entry, else just "Menü".</summary>
    private string CurrentLabel(IReadOnlyList<CitizenNavEntry> mine)
        => _tabs.FirstOrDefault(t => IsActive(t.Href))?.Label
           ?? mine.FirstOrDefault(e => IsActive(e.Href))?.Label
           ?? "Menü";

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    // case-insensitive, like PublicRoutes.Matches: a typed /Gesucht highlighted nothing. And a module's sibling
    // page keeps the tab lit by matching on the nav route's FIRST segment, so /gefahr/personen no longer leaves
    // the whole bar unmarked.
    private bool IsActive(string href)
    {
        var rel = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Split('#')[0].Trim('/');
        var path = rel.Length == 0 ? "/" : "/" + rel;
        if (href == "/")
        {
            return path == "/";
        }
        // the personal routes are nested under /buerger, so they match on the whole path, not on the first segment
        if (href.StartsWith("/buerger", StringComparison.Ordinal) || href == "/portal")
        {
            return path.Equals(href, StringComparison.OrdinalIgnoreCase)
                || (href != "/buerger" && path.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase));
        }
        var root = href.IndexOf('/', 1) is var cut && cut > 0 ? href[..cut] : href;
        return path.Equals(root, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(root + "/", StringComparison.OrdinalIgnoreCase);
    }
}
