@inherits LayoutComponentBase

@* Public shell (career page, invite, applicant portal); no nav/drawer, no maintenance wall, no auth chrome. *@
<MudThemeProvider Theme="NooseTheme.Theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div style="min-height:100vh;background:#0E1116;padding:32px 16px;">
    @* 860px like the citizen and applicant shells: 880 was a third width for no reason *@
    <div style="max-width:860px;margin:0 auto;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
            @* the wordmark is the only way out of an invite link, as in the other shells *@
            <MudLink Href="/" Underline="Underline.None" Color="Color.Inherit">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudImage Src="FibIcon.png" Alt="Wappen des FIB" Height="40" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6" Style="font-weight:700;letter-spacing:.12em;line-height:1.1;">F.I.B.</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Federal Investigation Bureau</MudText>
                    </MudStack>
                </MudStack>
            </MudLink>
        </MudStack>

        @Body

        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2" Class="mt-6">
            <MudLink Href="@LegalData.ImprintUrl" Target="_blank" rel="noopener noreferrer"
                     Typo="Typo.caption" Color="Color.Default">Impressum</MudLink>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">·</MudText>
            <MudLink Href="/datenschutz" Typo="Typo.caption" Color="Color.Default">Datenschutz</MudLink>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">·</MudText>
            <MudLink Href="/nutzungsbedingungen" Typo="Typo.caption" Color="Color.Default">Nutzungsbedingungen</MudLink>
        </MudStack>
    </div>
</div>

@code {
    // no [Authorize]/[AllowAnonymous] here on purpose; each page controls its own visibility
}
