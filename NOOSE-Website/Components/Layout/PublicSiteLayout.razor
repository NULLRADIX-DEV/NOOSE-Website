@inherits LayoutComponentBase
@inject IPublicModuleService ModuleService

@* Public site shell (landing, career, every outward page); one header and one tab bar with the citizen shells. *@
<MudThemeProvider Theme="NooseTheme.Theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div style="min-height:100vh;background:#0E1116;padding:24px 16px;">
    <div style="max-width:960px;margin:0 auto;">
        <PublicHeader HomeHref="/" Subtitle="Federal Investigation Bureau">
            <AnonymousActions>
                @* secret agency: the public never gets a usable agent login, only a dead notice *@
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" Disabled="true">Kein Zugriff</MudButton>
            </AnonymousActions>
        </PublicHeader>

        <MudDivider Class="mb-2" />
        <PublicNav />

        @if (_killSwitchActive)
        {
            @* the internal maintenance mode deliberately does not reach out here; this is its public counterpart *@
            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Class="mt-4">
                Der öffentliche Bereich ist derzeit abgeschaltet. Bitte versuche es später erneut.
            </MudAlert>
        }

        <div class="mt-4">
            @Body
        </div>

        <LegalFooter />
    </div>
</div>

@code {
    private bool _killSwitchActive;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _killSwitchActive = (await ModuleService.GetAsync()).KillSwitchActive;
        }
        catch
        {
            /* best effort */
        }
    }
}
